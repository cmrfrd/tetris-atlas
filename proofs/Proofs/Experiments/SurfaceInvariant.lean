    not_isLost_of_isSpreadBoundedRWSkyline hsb⟩

/-- **A concrete floor-pocket band realizes the L descent.** The L-shelf companion to
`isSpreadBoundedRWSkyline_O_descent_lands_of_pocketBand` and the T witness: take the band whose
off-well columns all sit at the ceiling `floor + spread` except the level triple `(c, c+1, c+2)`
seated at the `floor`. That is a genuine `IsSpreadBoundedRWSkyline cfg spread` board carrying a
width-three floor pocket, so the L valley-then-well descent atom
(`isSpreadBoundedRWSkyline_L_valley_then_vertI_well_of_isSpreadBounded`) fires — needing a
two-deep band (`2 ≤ spread`, the L riser room) — and lands a spread-`spread` band four rows
lower. The fourth concrete `pocket band ⟹ descent` witness with no abstract surface variable,
extending the seed family (`O`, horizontal-I, `T`) the general pocket-existence argument (#66)
specializes. -/
theorem isSpreadBoundedRWSkyline_L_descent_lands_of_pocketBand
    {cfg : GameConfig} {spread floor w c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (hw : w < cfg.cols) (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2)
    (hfloor : 4 ≤ floor) (hspread : 2 ≤ spread)
    (hslack : floor + spread ≤ cfg.rows) :
    IsSpreadBoundedRWSkyline cfg spread
      (Placement.applyStep cfg
        (Placement.applyStep cfg
          (skyline cfg
            (fun j => if j = w then 0 else
              if j = c ∨ j = c + 1 ∨ j = c + 2 then floor else floor + spread))
          { piece := Piece.L, rot := 0, col := c })
        { piece := Piece.I, rot := 1, col := w }) := by
  set h : ℕ → ℕ :=
    (fun j => if j = w then 0 else
      if j = c ∨ j = c + 1 ∨ j = c + 2 then floor else floor + spread) with hh
  have hw0 : h w = 0 := by rw [hh]; simp
  have hcval : h c = floor := by
    have hcw : ¬ (c = w) := Ne.symm hwc
    simp [hh, hcw]
  have hc1val : h (c + 1) = floor := by
    have hc1w : ¬ (c + 1 = w) := Ne.symm hwc1
    simp [hh, hc1w]
  have hc2val : h (c + 2) = floor := by
    have hc2w : ¬ (c + 2 = w) := Ne.symm hwc2
    simp [hh, hc2w]
  have heq1 : h (c + 1) = h c := by rw [hc1val, hcval]
  have heq2 : h (c + 2) = h c := by rw [hc2val, hcval]
  have hband : ∀ j < cfg.cols, j ≠ w → floor ≤ h j ∧ h j ≤ floor + spread := by
    intro j hj hjw
    rw [hh]
    simp only [if_neg hjw]
    by_cases hpocket : j = c ∨ j = c + 1 ∨ j = c + 2
    · rw [if_pos hpocket]; omega
    · rw [if_neg hpocket]; omega
  exact isSpreadBoundedRWSkyline_L_valley_then_vertI_well_of_isSpreadBounded
    hc hc1 hc2 hw hwc hwc1 hwc2 hw0 heq1 heq2 hcval hfloor hspread hband hslack

/-- **A floor pocket for the L descent always EXISTS on a wide-enough board.** Pigeonhole
companion to `isSpreadBoundedRWSkyline_L_descent_lands_of_pocketBand`, mirroring the O,
horizontal-I, and T `_descent_exists_pocketBand` witnesses: given only the reserved-well
column `w` and a board at least six wide (`6 ≤ cfg.cols`, the L shelf needing a width-three
level triple), there is SOME pocket origin `c` with the whole triple `(c, c+1, c+2)` disjoint
from `w`. Pick `c = 3` when `w < 3` (triple `3,4,5`, all clear of `w`) and `c = 0` when
