    rcases Nat.lt_or_ge w 3 with hlt | hge
    · exact ⟨3, by omega, by omega, by omega, by omega⟩
    · exact ⟨0, by omega, by omega, by omega, by omega⟩
  have hc : c < cfg.cols := by omega
  have hc1 : c + 1 < cfg.cols := by omega
  exact ⟨c, isSpreadBoundedRWSkyline_L_descent_lands_of_pocketBand
    hc hc1 hc2 hw hwc hwc1 hwc2 hfloor hspread hslack⟩

/-- **Favorable descent atom, J-shelf: a valley-laid J plus a well-clearing vertical I
descends the floor four rows at ZERO spread cost.** The J member of the valley-then-well
descent family, completing all five flat-shelf pieces (O, horizI, T, L, J). Laid
