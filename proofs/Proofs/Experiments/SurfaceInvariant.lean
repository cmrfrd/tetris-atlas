admits a zero spread-cost valley fit, so every non-S/Z, non-clearing piece can be
absorbed into a floor pocket without widening the band. -/
theorem isSpreadBoundedRWSkyline_J_valley_of_isSpreadBounded {cfg : GameConfig} {spread : ℕ}
    {h : ℕ → ℕ} {floor w c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (hw : w < cfg.cols) (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2)
    (hw0 : h w = 0)
    (heq1 : h (c + 1) = h c) (heq2 : h (c + 2) = h c)
    (hcfloor : h c = floor) (hspread : 2 ≤ spread)
    (hband : ∀ j < cfg.cols, j ≠ w → floor ≤ h j ∧ h j ≤ floor + spread)
    (hslack : floor + spread ≤ cfg.rows) :
    IsSpreadBoundedRWSkyline cfg spread
