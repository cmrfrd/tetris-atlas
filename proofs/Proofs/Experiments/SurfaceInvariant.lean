theorem colHeight_applyStep_O_skyline_preserves_notch {cfg : GameConfig} {h : ℕ → ℕ}
    {c w nc : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (heq : h c = h (c + 1))
    (hw : w < cfg.cols) (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hw0 : h w = 0)
