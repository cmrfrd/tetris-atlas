      (by omega) heq1 heq2 heq3 (by decide) (by omega) (by omega) (by omega) (by omega) hw0,
      hsite0]
  refine ⟨Function.update (Function.update (Function.update
      (Function.update h pc (base + 1)) (pc + 1) (base + 1)) (pc + 2) (base + 1))
      (pc + 3) (base + 1), 0, pc + 4, rfl, by decide, ?_, ?_, ?_,
    by omega, by omega, by omega, by omega, by omega, ?_, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne (show (0:ℕ) ≠ pc + 3 by omega),
        Function.update_of_ne (show (0:ℕ) ≠ pc + 2 by omega),
        Function.update_of_ne (show (0:ℕ) ≠ pc + 1 by omega),
