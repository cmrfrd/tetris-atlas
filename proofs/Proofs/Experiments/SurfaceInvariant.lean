    reservoirSpreadCarrier (((T.draw Piece.I).draw Piece.S).draw Piece.Z)
      (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard
            (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
            { piece := Piece.I, rot := 1, col := 0 })
