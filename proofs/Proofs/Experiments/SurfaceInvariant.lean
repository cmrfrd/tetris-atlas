/-- **J closure on a flat shelf.** Left column rises by `2`, the two right by `1`. -/
theorem place_J_skyline {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (heq1 : h (c + 1) = h c) (heq2 : h (c + 2) = h c) :
    Placement.place (skyline cfg h) { piece := Piece.J, rot := 0, col := c }
      = skyline cfg (Function.update (Function.update (Function.update h c (h c + 2))
          (c + 1) (h c + 1)) (c + 2) (h c + 1)) := by
  ext ⟨j, r⟩
  simp only [Placement.place_eq_union_dropped, Finset.mem_union,
             mem_dropped_J_skyline hc hc1 hc2 heq1 heq2, mem_skyline]
  by_cases hjc : j = c
  · rw [hjc, Function.update_of_ne (by omega : c ≠ c + 2),
        Function.update_of_ne (by omega : c ≠ c + 1), Function.update_self]
    omega
  · by_cases hjc1 : j = c + 1
    · rw [hjc1, Function.update_of_ne (by omega : c + 1 ≠ c + 2), Function.update_self]
      omega
    · by_cases hjc2 : j = c + 2
      · rw [hjc2, Function.update_self]
        omega
      · rw [Function.update_of_ne hjc2, Function.update_of_ne hjc1, Function.update_of_ne hjc]
        omega

/-- **A J placement raises every column by at most two.** The mirror of L: landing
flush on a flat three-wide shelf, the J lifts its left column by `2` and the two
right columns by `1`, worst-case growth `2`. The final `+2` debit entry for the
flush-fit pieces — with O, T, L (`+2`) and the horizontal-I (`+1`), every piece
that drops onto a level shelf now has a proven per-column height debit. Only the
staircase S/Z (which need a notch, not a flat shelf) lie outside this table. -/
theorem colHeight_place_J_skyline_le {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (heq1 : h (c + 1) = h c) (heq2 : h (c + 2) = h c)
    {j : ℕ} (hj : j < cfg.cols) :
    colHeight (Placement.place (skyline cfg h) { piece := Piece.J, rot := 0, col := c }) j
      ≤ h j + 2 := by
  rw [place_J_skyline hc hc1 hc2 heq1 heq2, colHeight_skyline hj]
  by_cases hjc : j = c
  · rw [hjc, Function.update_of_ne (by omega : c ≠ c + 2),
        Function.update_of_ne (by omega : c ≠ c + 1), Function.update_self]
  · by_cases hjc1 : j = c + 1
    · rw [hjc1, Function.update_of_ne (by omega : c + 1 ≠ c + 2), Function.update_self]
      omega
    · by_cases hjc2 : j = c + 2
      · rw [hjc2, Function.update_self]
        omega
      · rw [Function.update_of_ne hjc2, Function.update_of_ne hjc1, Function.update_of_ne hjc]
        omega

/-! ### Well-clear loop (the height-bounding engine)

The single most affirmative-supporting brick: dropping a **vertical I** into an
empty 1-wide well (`h w = 0`) whose neighbouring columns are all at least `4`
high fills the well to height `4`, making rows `0,1,2,3` complete across the
whole field. Those four rows clear, gravity drops every surviving cell by `4`,
and the result is the same skyline with the well still empty and every other
column lowered by exactly `4`. This is the mechanism that bounds stack height: a
reserved well lets the guaranteed-once-per-bag I cancel four rows of accumulated
material, returning the surface to a strictly lower profile. It specialises
`applyStep_vertI_skyline` at the clear amount `m = 4`. -/

/-- Vertical I into an empty well with all other columns `≥ 4` clears exactly
four lines: the well stays empty and every other column drops by `4`. -/
theorem applyStep_vertI_well {cfg : GameConfig} {h : ℕ → ℕ} {w : ℕ}
    (hw : w < cfg.cols) (hwell : h w = 0)
    (hothers : ∀ j, j < cfg.cols → j ≠ w → 4 ≤ h j) :
    Placement.applyStep cfg (skyline cfg h) { piece := Piece.I, rot := 1, col := w }
      = skyline cfg (fun j => if j = w then 0 else h j - 4) := by
  have hm : ∀ j < cfg.cols, (4:ℕ) ≤ Function.update h w (h w + 4) j := by
    intro j hj
    by_cases hjw : j = w
    · subst hjw; rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjw]; exact hothers j hj hjw
  have hm0 : ∃ j < cfg.cols, Function.update h w (h w + 4) j = 4 :=
    ⟨w, hw, by rw [Function.update_self]; omega⟩
  rw [applyStep_vertI_skyline hw hm hm0]
  congr 1
  funext j
  by_cases hjw : j = w
  · subst hjw; rw [Function.update_self, if_pos rfl]; omega
  · rw [Function.update_of_ne hjw, if_neg hjw]

/-- **The well-clear card law.** A vertical I dropped into an empty well whose
neighbours are all `≥ 4` reclaims exactly `4 · (cols − 1)` cells: the four full
rows it completes clear, dropping every non-well column by `4`. Written
additively (`result + reclaim = original`) so the height-bounding ledger never
touches `ℕ` subtraction. This is the conserved-quantity *engine*: paired with the
`+4`-per-placement law it shows the once-per-bag well clear can cancel the cell
growth from up to `cols − 1` ordinary placements, the heart of the potential
argument keeping the board in-field forever. -/
theorem card_applyStep_vertI_well {cfg : GameConfig} {h : ℕ → ℕ} {w : ℕ}
    (hw : w < cfg.cols) (hwell : h w = 0)
    (hothers : ∀ j, j < cfg.cols → j ≠ w → 4 ≤ h j) :
    (Placement.applyStep cfg (skyline cfg h) { piece := Piece.I, rot := 1, col := w }).card
      + 4 * (cfg.cols - 1) = (skyline cfg h).card := by
  rw [applyStep_vertI_well hw hwell hothers, card_skyline, card_skyline]
  have hw' : w ∈ Finset.range cfg.cols := Finset.mem_range.mpr hw
  rw [← Finset.add_sum_erase (Finset.range cfg.cols)
        (fun j => if j = w then 0 else h j - 4) hw',
      ← Finset.add_sum_erase (Finset.range cfg.cols) h hw']
  simp only [if_true, hwell, Nat.zero_add]
  have hg : ∑ j ∈ (Finset.range cfg.cols).erase w, (if j = w then 0 else h j - 4)
          = ∑ j ∈ (Finset.range cfg.cols).erase w, (h j - 4) := by
    refine Finset.sum_congr rfl ?_
    intro j hj
    rw [if_neg (Finset.ne_of_mem_erase hj)]
  have hcard_erase : ((Finset.range cfg.cols).erase w).card = cfg.cols - 1 := by
    rw [Finset.card_erase_of_mem hw', Finset.card_range]
  have hconst : (4:ℕ) * (cfg.cols - 1) = ∑ _j ∈ (Finset.range cfg.cols).erase w, 4 := by
    rw [Finset.sum_const, hcard_erase, smul_eq_mul, Nat.mul_comm]
  rw [hg, hconst, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl ?_
  intro j hj
  have hjw : j ≠ w := Finset.ne_of_mem_erase hj
  have hjc : j < cfg.cols := Finset.mem_range.mp (Finset.mem_of_mem_erase hj)
  have := hothers j hjc hjw
  omega

/-- **The well clear strictly lowers the cell count.** On any field at least two
columns wide, the reserved-well vertical-I clear reclaims `4·(cols−1) ≥ 4` cells,
so the filled-cell total strictly decreases. This is the *descent* half of the
packing potential: ordinary placements each add `4` (`card_place_vertI_skyline`
and its per-piece siblings), while a single well clear repays `4·(cols−1)` of that
growth at once — the mechanism that stops the cell total, and hence the stack
height, from running away. The strict inequality is exactly the well-foundedness
ingredient a termination/potential argument consumes. -/
theorem card_applyStep_vertI_well_lt {cfg : GameConfig} {h : ℕ → ℕ} {w : ℕ}
    (hcols : 2 ≤ cfg.cols) (hw : w < cfg.cols) (hwell : h w = 0)
    (hothers : ∀ j, j < cfg.cols → j ≠ w → 4 ≤ h j) :
    (Placement.applyStep cfg (skyline cfg h) { piece := Piece.I, rot := 1, col := w }).card
      < (skyline cfg h).card := by
  have hledger := card_applyStep_vertI_well hw hwell hothers
  omega

/-- **The well clear manufactures four rows of headroom.** After a reserved-well
vertical-I clear, every real column sits at height `≤ cfg.rows − 4`: the well
returns to `0` and each (capped) neighbour drops by exactly `4`. This is the
*height* face of the descent law — `card_applyStep_vertI_well_lt` counts cells,
this bounds the surface — and it is what couples the well clear to the loss
predicate (`colHeight ≤ cfg.rows`): immediately after a clear the board carries
four full rows of slack before any column can threaten the ceiling, the budget a
following bag of placements is then free to spend. -/
theorem colHeight_applyStep_vertI_well_le {cfg : GameConfig} {h : ℕ → ℕ} {w : ℕ}
    (hw : w < cfg.cols) (hwell : h w = 0)
    (hothers : ∀ j, j < cfg.cols → j ≠ w → 4 ≤ h j)
    (hbound : ∀ j, j < cfg.cols → h j ≤ cfg.rows)
    {j : ℕ} (hj : j < cfg.cols) :
    colHeight (Placement.applyStep cfg (skyline cfg h)
        { piece := Piece.I, rot := 1, col := w }) j ≤ cfg.rows - 4 := by
  rw [applyStep_vertI_well hw hwell hothers, colHeight_skyline hj]
  by_cases hjw : j = w
  · rw [if_pos hjw]; exact Nat.zero_le _
  · rw [if_neg hjw]; exact Nat.sub_le_sub_right (hbound j hj) 4

/-! ### Placement validity (the in-bounds obligation)

`Placement.Valid cfg pl` is the pure column-bound `∀ cell ∈ pl.shapeUp,
pl.col + cell.1 < cfg.cols`. Each skyline brick's drop profile spans a known
column window, so its validity reduces to the single tightest column bound the
corresponding `place_*` lemma already assumes. These discharge the `pl.Valid`
conjunct of every bag-indexed `hstep` obligation. -/

/-- The vertical I (single column) is valid as soon as its column is in range. -/
theorem valid_vertI {cfg : GameConfig} {c : ℕ} (hc : c < cfg.cols) :
    ({ piece := Piece.I, rot := 1, col := c } : Placement).Valid cfg := by
  intro cell hcell
  rw [shapeUp_vertI] at hcell
  simp only [Finset.mem_insert, Finset.mem_singleton] at hcell
  rcases hcell with rfl | rfl | rfl | rfl <;> dsimp only <;> omega

/-- The horizontal I spans `c … c+3`; valid once `c + 3 < cfg.cols`. -/
theorem valid_horizI {cfg : GameConfig} {c : ℕ} (hc3 : c + 3 < cfg.cols) :
    ({ piece := Piece.I, rot := 0, col := c } : Placement).Valid cfg := by
  intro cell hcell
  rw [shapeUp_horizI] at hcell
  simp only [Finset.mem_insert, Finset.mem_singleton] at hcell
  rcases hcell with rfl | rfl | rfl | rfl <;> dsimp only <;> omega

/-- The O spans `c, c+1`; valid once `c + 1 < cfg.cols`. -/
theorem valid_O {cfg : GameConfig} {c : ℕ} (hc1 : c + 1 < cfg.cols) :
    ({ piece := Piece.O, rot := 0, col := c } : Placement).Valid cfg := by
  intro cell hcell
  rw [shapeUp_O] at hcell
  simp only [Finset.mem_insert, Finset.mem_singleton] at hcell
  rcases hcell with rfl | rfl | rfl | rfl <;> dsimp only <;> omega

/-- The S spans `c … c+2`; valid once `c + 2 < cfg.cols`. -/
theorem valid_S {cfg : GameConfig} {c : ℕ} (hc2 : c + 2 < cfg.cols) :
    ({ piece := Piece.S, rot := 0, col := c } : Placement).Valid cfg := by
  intro cell hcell
  rw [shapeUp_S] at hcell
  simp only [Finset.mem_insert, Finset.mem_singleton] at hcell
  rcases hcell with rfl | rfl | rfl | rfl <;> dsimp only <;> omega

/-- The Z spans `c … c+2`; valid once `c + 2 < cfg.cols`. -/
theorem valid_Z {cfg : GameConfig} {c : ℕ} (hc2 : c + 2 < cfg.cols) :
