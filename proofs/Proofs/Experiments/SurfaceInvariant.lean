/-- **Unified flat-piece wide-pocket self-regeneration dispatcher.** The single lemma that closes
the geometric fill half over *every* flat (non-staircase) piece at once: on a band whose only
assumed flat region is a width-eight pocket at columns `pc .. pc + 7` (all pinned at `base`), for
ANY `p` among the five flat shapes `O, I, T, L, J` there is a placement of `p` whose post-move
board is again `IsLevelPocketBandAt standard 2 base`. The width-eight pocket is the common
denominator: the horizontal-`I` consumes all eight (footprint four, riser `+1`), `T`, `L`, `J`
consume seven (footprint three), and `O` consumes six (footprint two), so each piece's own
wide-pocket arc fires off the appropriate prefix of the eight flat sites, leaving a width-four (or
wider) pocket regenerated from the residual. This consolidates the five single-piece arcs
(`isLevelPocketBandAt_{O,horizI,T,L,J}_lands_widePocket`) into one piece-quantified edge — the
flat-phase landing menu the bag closure dispatches on when the adversary plays a non-staircase
piece, with the floor held fixed so the reservoir ledger spends zero. The placement's `Valid`
certificate and the two staircase pieces (`S`, `Z`, which need a notch rather than a flat pocket)
are handled by sibling edges; this brick is the all-flat-piece geometric core. -/
theorem isLevelPocketBandAt_flatPiece_lands_widePocket {base pc : ℕ} {h : ℕ → ℕ} {p : Piece}
    (hp : p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J)
    (hslack : base + 2 ≤ GameConfig.standard.rows)
    (hw0 : h 0 = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ 0 → base ≤ h j ∧ h j ≤ base + 2)
    (hpc : 1 ≤ pc) (hpc7 : pc + 7 < GameConfig.standard.cols)
    (hsite0 : h pc = base) (hsite1 : h (pc + 1) = base) (hsite2 : h (pc + 2) = base)
    (hsite3 : h (pc + 3) = base) (hsite4 : h (pc + 4) = base) (hsite5 : h (pc + 5) = base)
    (hsite6 : h (pc + 6) = base) (hsite7 : h (pc + 7) = base) :
    ∃ pl : Placement, pl.piece = p ∧
      Board.IsLevelPocketBandAt GameConfig.standard 2 base
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard h) pl) := by
  rcases hp with rfl | rfl | rfl | rfl | rfl
  · exact ⟨{ piece := Piece.O, rot := 0, col := pc }, rfl,
      isLevelPocketBandAt_O_lands_widePocket hslack hw0 hband hpc (by omega)
        hsite0 hsite1 hsite2 hsite3 hsite4 hsite5⟩
  · exact ⟨{ piece := Piece.I, rot := 0, col := pc }, rfl,
      isLevelPocketBandAt_horizI_lands_widePocket hslack hw0 hband hpc hpc7
        hsite0 hsite1 hsite2 hsite3 hsite4 hsite5 hsite6 hsite7⟩
  · exact ⟨{ piece := Piece.T, rot := 2, col := pc }, rfl,
      isLevelPocketBandAt_T_lands_widePocket hslack hw0 hband hpc (by omega)
        hsite0 hsite1 hsite2 hsite3 hsite4 hsite5 hsite6⟩
  · exact ⟨{ piece := Piece.L, rot := 0, col := pc }, rfl,
      isLevelPocketBandAt_L_lands_widePocket hslack hw0 hband hpc (by omega)
        hsite0 hsite1 hsite2 hsite3 hsite4 hsite5 hsite6⟩
  · exact ⟨{ piece := Piece.J, rot := 0, col := pc }, rfl,
      isLevelPocketBandAt_J_lands_widePocket hslack hw0 hband hpc (by omega)
        hsite0 hsite1 hsite2 hsite3 hsite4 hsite5 hsite6⟩

/-- **Validity-carrying wide-pocket flat dispatcher.** Strengthens
`isLevelPocketBandAt_flatPiece_lands_widePocket` by also exposing `pl.Valid standard` in the
existential, so the witness can feed `reservoirCarrier_fill_step` (whose fill obligation requires
placement validity). For each flat piece `p ∈ {O, I, T, L, J}` landing on the width-eight run at
columns `pc .. pc + 7`, validity is `valid_O` / `valid_horizI` / `valid_T` / `valid_L` / `valid_J`
(needing `pc + 1`, `pc + 3`, `pc + 2`, `pc + 2`, `pc + 2 < cols` respectively, all implied by
`pc + 7 < cols`). The geometric landing (post-move board still `IsLevelPocketBandAt standard 2 base`
at the same floor) is unchanged from the un-validated dispatcher. Flat-piece counterpart of
`isLevelPocketBandAt_valley_hosts_SZ_valid`. -/
theorem isLevelPocketBandAt_flatPiece_lands_widePocket_valid {base pc : ℕ} {h : ℕ → ℕ} {p : Piece}
    (hp : p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J)
    (hslack : base + 2 ≤ GameConfig.standard.rows)
    (hw0 : h 0 = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ 0 → base ≤ h j ∧ h j ≤ base + 2)
    (hpc : 1 ≤ pc) (hpc7 : pc + 7 < GameConfig.standard.cols)
    (hsite0 : h pc = base) (hsite1 : h (pc + 1) = base) (hsite2 : h (pc + 2) = base)
    (hsite3 : h (pc + 3) = base) (hsite4 : h (pc + 4) = base) (hsite5 : h (pc + 5) = base)
    (hsite6 : h (pc + 6) = base) (hsite7 : h (pc + 7) = base) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      Board.IsLevelPocketBandAt GameConfig.standard 2 base
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard h) pl) := by
  rcases hp with rfl | rfl | rfl | rfl | rfl
  · exact ⟨{ piece := Piece.O, rot := 0, col := pc }, rfl, valid_O (by omega),
      isLevelPocketBandAt_O_lands_widePocket hslack hw0 hband hpc (by omega)
        hsite0 hsite1 hsite2 hsite3 hsite4 hsite5⟩
  · exact ⟨{ piece := Piece.I, rot := 0, col := pc }, rfl, valid_horizI (by omega),
      isLevelPocketBandAt_horizI_lands_widePocket hslack hw0 hband hpc hpc7
        hsite0 hsite1 hsite2 hsite3 hsite4 hsite5 hsite6 hsite7⟩
  · exact ⟨{ piece := Piece.T, rot := 2, col := pc }, rfl, valid_T (by omega),
      isLevelPocketBandAt_T_lands_widePocket hslack hw0 hband hpc (by omega)
        hsite0 hsite1 hsite2 hsite3 hsite4 hsite5 hsite6⟩
  · exact ⟨{ piece := Piece.L, rot := 0, col := pc }, rfl, valid_L (by omega),
      isLevelPocketBandAt_L_lands_widePocket hslack hw0 hband hpc (by omega)
        hsite0 hsite1 hsite2 hsite3 hsite4 hsite5 hsite6⟩
  · exact ⟨{ piece := Piece.J, rot := 0, col := pc }, rfl, valid_J (by omega),
      isLevelPocketBandAt_J_lands_widePocket hslack hw0 hband hpc (by omega)
        hsite0 hsite1 hsite2 hsite3 hsite4 hsite5 hsite6⟩

/-- **Self-regenerating notch S fill (staircase region).** The `S` (rotation 0) sibling of the
wide-pocket self-regen menu, on the *notched* input shape the staircase piece needs: a band whose
only assumed structured region is a width-seven run at columns `pc .. pc + 6` with a single bump —
columns `pc, pc + 1` at `base`, column `pc + 2` at `base + 1`, and columns `pc + 3 .. pc + 6` flat
at `base`. Dropping the flat-and-up `S` at the left of that run fills the staircase
`(pc, pc + 1, pc + 2) = (base, base, base + 1)` into the tower `(base + 1, base + 2, base + 2)`,
subsuming the bump (column `pc + 2` is overwritten) and keeping every raised column inside the
spread-two band, while the remaining four columns `pc + 3 .. pc + 6` stay flat at `base`. The
post-move board is again `IsLevelPocketBandAt standard 2 base` with the width-four pocket
regenerated at columns `pc + 3 .. pc + 6`. The `At`-indexed, arbitrary-`base`, arbitrary-`pc`
generalization of `isLevelPocketBand_S_notched_standard`; floor is fixed (`floor' = base`), so it
slots into `reservoirCarrier_fill_step` at zero ledger cost and discharges the `#89` site-existence
obligation for the staircase input shape. Only the mirror `Z` notch remains to complete the
per-piece geometric menu over all seven pieces. -/
theorem isLevelPocketBandAt_S_lands_notch {base pc : ℕ} {h : ℕ → ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows)
    (hw0 : h 0 = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ 0 → base ≤ h j ∧ h j ≤ base + 2)
    (hpc : 1 ≤ pc) (hpc6 : pc + 6 < GameConfig.standard.cols)
    (hsite0 : h pc = base) (hsite1 : h (pc + 1) = base) (hsite2 : h (pc + 2) = base + 1)
    (hsite3 : h (pc + 3) = base) (hsite4 : h (pc + 4) = base) (hsite5 : h (pc + 5) = base)
    (hsite6 : h (pc + 6) = base) :
    IsLevelPocketBandAt GameConfig.standard 2 base
      (Placement.applyStep GameConfig.standard (skyline GameConfig.standard h)
        { piece := Piece.S, rot := 0, col := pc }) := by
  have heq : h pc = h (pc + 1) := by rw [hsite0, hsite1]
  have hstep : h (pc + 2) = h pc + 1 := by rw [hsite2, hsite0]
  rw [applyStep_S_skyline_noclear (c := pc) (w := 0) (by omega) (by omega) (by omega)
      heq hstep (by decide) (by omega) (by omega) (by omega) hw0, hsite0]
  refine ⟨Function.update (Function.update (Function.update h pc (base + 1))
      (pc + 1) (base + 2)) (pc + 2) (base + 2), 0, pc + 3, rfl, by decide, ?_, ?_, ?_,
    by omega, by omega, by omega, by omega, by omega, ?_, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne (show (0:ℕ) ≠ pc + 2 by omega),
        Function.update_of_ne (show (0:ℕ) ≠ pc + 1 by omega),
        Function.update_of_ne (show (0:ℕ) ≠ pc by omega)]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (pc + 2) with rfl | hjne2
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjne2]
      rcases eq_or_ne j (pc + 1) with rfl | hjne1
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hjne1]
        rcases eq_or_ne j pc with rfl | hjne0
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hjne0]; exact hband j hj hjw
  · exact hslack
  · rw [Function.update_of_ne (show (pc + 3:ℕ) ≠ pc + 2 by omega),
        Function.update_of_ne (show (pc + 3:ℕ) ≠ pc + 1 by omega),
        Function.update_of_ne (show (pc + 3:ℕ) ≠ pc by omega)]; exact hsite3
  · rw [Function.update_of_ne (show (pc + 4:ℕ) ≠ pc + 2 by omega),
        Function.update_of_ne (show (pc + 4:ℕ) ≠ pc + 1 by omega),
        Function.update_of_ne (show (pc + 4:ℕ) ≠ pc by omega)]; exact hsite4
  · rw [Function.update_of_ne (show (pc + 5:ℕ) ≠ pc + 2 by omega),
        Function.update_of_ne (show (pc + 5:ℕ) ≠ pc + 1 by omega),
        Function.update_of_ne (show (pc + 5:ℕ) ≠ pc by omega)]; exact hsite5
  · rw [Function.update_of_ne (show (pc + 6:ℕ) ≠ pc + 2 by omega),
        Function.update_of_ne (show (pc + 6:ℕ) ≠ pc + 1 by omega),
        Function.update_of_ne (show (pc + 6:ℕ) ≠ pc by omega)]; exact hsite6

/-- **Self-regenerating notch Z fill (mirror staircase region).** The `Z` (rotation 0) mirror of
`isLevelPocketBandAt_S_lands_notch`, completing the per-piece geometric menu over all seven pieces:
on a band whose only assumed structured region is a width-seven run at columns `pc .. pc + 6` with a
single LEFT bump — column `pc` at `base + 1`, columns `pc + 1, pc + 2` at `base`, and columns
`pc + 3 .. pc + 6` flat at `base` — dropping the down-and-flat `Z` at the left fills the mirror
staircase `(pc, pc + 1, pc + 2) = (base + 1, base, base)` into the tower
`(base + 2, base + 2, base + 1)`, keeping every raised column inside the spread-two band, while the
remaining four columns `pc + 3 .. pc + 6` stay flat at `base`. The post-move board is again
`IsLevelPocketBandAt standard 2 base` with the width-four pocket regenerated at columns
`pc + 3 .. pc + 6`. The `At`-indexed, arbitrary-`base`, arbitrary-`pc` generalization of
`isLevelPocketBand_Z_notched_standard`; floor is fixed (`floor' = base`), so it slots into
`reservoirCarrier_fill_step` at zero ledger cost and discharges the `#89` site-existence obligation
for the mirror-staircase input shape. With both `S` and `Z` notch arcs the full seven-piece
geometric fill menu is complete: every piece has a self-regenerating landing. -/
theorem isLevelPocketBandAt_Z_lands_notch {base pc : ℕ} {h : ℕ → ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows)
    (hw0 : h 0 = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ 0 → base ≤ h j ∧ h j ≤ base + 2)
    (hpc : 1 ≤ pc) (hpc6 : pc + 6 < GameConfig.standard.cols)
    (hsite0 : h pc = base + 1) (hsite1 : h (pc + 1) = base) (hsite2 : h (pc + 2) = base)
    (hsite3 : h (pc + 3) = base) (hsite4 : h (pc + 4) = base) (hsite5 : h (pc + 5) = base)
    (hsite6 : h (pc + 6) = base) :
    IsLevelPocketBandAt GameConfig.standard 2 base
      (Placement.applyStep GameConfig.standard (skyline GameConfig.standard h)
        { piece := Piece.Z, rot := 0, col := pc }) := by
  have heq : h (pc + 1) = h (pc + 2) := by rw [hsite1, hsite2]
  have hstep : h pc = h (pc + 1) + 1 := by rw [hsite0, hsite1]
  rw [applyStep_Z_skyline_noclear (c := pc) (w := 0) (by omega) (by omega) (by omega)
      heq hstep (by decide) (by omega) (by omega) (by omega) hw0, hsite1]
  refine ⟨Function.update (Function.update (Function.update h pc (base + 2))
      (pc + 1) (base + 2)) (pc + 2) (base + 1), 0, pc + 3, rfl, by decide, ?_, ?_, ?_,
    by omega, by omega, by omega, by omega, by omega, ?_, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne (show (0:ℕ) ≠ pc + 2 by omega),
        Function.update_of_ne (show (0:ℕ) ≠ pc + 1 by omega),
        Function.update_of_ne (show (0:ℕ) ≠ pc by omega)]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (pc + 2) with rfl | hjne2
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjne2]
      rcases eq_or_ne j (pc + 1) with rfl | hjne1
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hjne1]
        rcases eq_or_ne j pc with rfl | hjne0
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hjne0]; exact hband j hj hjw
  · exact hslack
  · rw [Function.update_of_ne (show (pc + 3:ℕ) ≠ pc + 2 by omega),
        Function.update_of_ne (show (pc + 3:ℕ) ≠ pc + 1 by omega),
        Function.update_of_ne (show (pc + 3:ℕ) ≠ pc by omega)]; exact hsite3
  · rw [Function.update_of_ne (show (pc + 4:ℕ) ≠ pc + 2 by omega),
        Function.update_of_ne (show (pc + 4:ℕ) ≠ pc + 1 by omega),
        Function.update_of_ne (show (pc + 4:ℕ) ≠ pc by omega)]; exact hsite4
  · rw [Function.update_of_ne (show (pc + 5:ℕ) ≠ pc + 2 by omega),
        Function.update_of_ne (show (pc + 5:ℕ) ≠ pc + 1 by omega),
        Function.update_of_ne (show (pc + 5:ℕ) ≠ pc by omega)]; exact hsite5
  · rw [Function.update_of_ne (show (pc + 6:ℕ) ≠ pc + 2 by omega),
        Function.update_of_ne (show (pc + 6:ℕ) ≠ pc + 1 by omega),
        Function.update_of_ne (show (pc + 6:ℕ) ≠ pc by omega)]; exact hsite6

/-- **Shared-valley S landing (budget-dodging twin site, part 1).** The key lemma that dodges the
column-budget obstruction (`#90`, `#151`): a single width-four *valley*
`(h vc, h(vc+1), h(vc+2), h(vc+3)) = (base + 1, base, base, base + 1)` hosts BOTH staircase pieces
at once — `Z` at its left lip and `S` at its right lip — so the two notches that separately cost
`3 + 3 = 6` columns collapse into one shared width-four feature. This part lands the `S` at column
`vc + 1`, where the valley's right half `(vc+1, vc+2, vc+3) = (base, base, base + 1)` is exactly the
ascending notch `S` needs; the no-clear placement fills it to `(base + 1, base + 2, base + 2)`,
leaving the valley's left lip (`vc`) and a disjoint flat pocket at columns `pc .. pc + 3` (strictly
right of the valley, `vc + 3 < pc`) untouched. The result is `IsLevelPocketBandAt standard 2 base`
with the surviving flat pocket as its width-four floor run. Together with the `Z` twin
(`isLevelPocketBandAt_Z_lands_valley`) this shows one valley plus one flat pocket — total
`1 + 4 + 4 = 9 ≤ 10` columns with the well — hosts all seven pieces, the configuration the naive
disjoint-notch budget bound forbids. -/
theorem isLevelPocketBandAt_S_lands_valley {base vc pc : ℕ} {h : ℕ → ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows)
    (hw0 : h 0 = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ 0 → base ≤ h j ∧ h j ≤ base + 2)
    (hvc : 1 ≤ vc) (hord : vc + 3 < pc) (hpc3 : pc + 3 < GameConfig.standard.cols)
    (hv0 : h vc = base + 1) (hv1 : h (vc + 1) = base) (hv2 : h (vc + 2) = base)
    (hv3 : h (vc + 3) = base + 1)
    (hp0 : h pc = base) (hp1 : h (pc + 1) = base) (hp2 : h (pc + 2) = base)
    (hp3 : h (pc + 3) = base) :
    IsLevelPocketBandAt GameConfig.standard 2 base
      (Placement.applyStep GameConfig.standard (skyline GameConfig.standard h)
        { piece := Piece.S, rot := 0, col := vc + 1 }) := by
  have heq : h (vc + 1) = h (vc + 1 + 1) := by rw [hv1]; rw [show vc + 1 + 1 = vc + 2 by omega, hv2]
  have hstep : h (vc + 1 + 2) = h (vc + 1) + 1 := by
    rw [show vc + 1 + 2 = vc + 3 by omega, hv3, hv1]
  rw [applyStep_S_skyline_noclear (c := vc + 1) (w := 0) (by omega) (by omega) (by omega)
      heq hstep (by decide) (by omega) (by omega) (by omega) hw0, hv1]
  refine ⟨Function.update (Function.update (Function.update h (vc + 1) (base + 1))
      (vc + 1 + 1) (base + 2)) (vc + 1 + 2) (base + 2), 0, pc, rfl, by decide, ?_, ?_, ?_,
    by omega, by omega, by omega, by omega, by omega, ?_, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne (show (0:ℕ) ≠ vc + 1 + 2 by omega),
        Function.update_of_ne (show (0:ℕ) ≠ vc + 1 + 1 by omega),
        Function.update_of_ne (show (0:ℕ) ≠ vc + 1 by omega)]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (vc + 1 + 2) with rfl | hjne2
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjne2]
      rcases eq_or_ne j (vc + 1 + 1) with rfl | hjne1
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hjne1]
        rcases eq_or_ne j (vc + 1) with rfl | hjne0
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hjne0]; exact hband j hj hjw
  · exact hslack
  · rw [Function.update_of_ne (show (pc:ℕ) ≠ vc + 1 + 2 by omega),
        Function.update_of_ne (show (pc:ℕ) ≠ vc + 1 + 1 by omega),
        Function.update_of_ne (show (pc:ℕ) ≠ vc + 1 by omega)]; exact hp0
  · rw [Function.update_of_ne (show (pc + 1:ℕ) ≠ vc + 1 + 2 by omega),
        Function.update_of_ne (show (pc + 1:ℕ) ≠ vc + 1 + 1 by omega),
        Function.update_of_ne (show (pc + 1:ℕ) ≠ vc + 1 by omega)]; exact hp1
  · rw [Function.update_of_ne (show (pc + 2:ℕ) ≠ vc + 1 + 2 by omega),
        Function.update_of_ne (show (pc + 2:ℕ) ≠ vc + 1 + 1 by omega),
        Function.update_of_ne (show (pc + 2:ℕ) ≠ vc + 1 by omega)]; exact hp2
  · rw [Function.update_of_ne (show (pc + 3:ℕ) ≠ vc + 1 + 2 by omega),
        Function.update_of_ne (show (pc + 3:ℕ) ≠ vc + 1 + 1 by omega),
        Function.update_of_ne (show (pc + 3:ℕ) ≠ vc + 1 by omega)]; exact hp3

/-- **Shared-valley Z landing (budget-dodging twin site, part 2).** The mirror of
`isLevelPocketBandAt_S_lands_valley`: the same width-four valley
`(h vc, h(vc+1), h(vc+2), h(vc+3)) = (base + 1, base, base, base + 1)` hosts `Z` at its LEFT lip,
column `vc`, where `(vc, vc+1, vc+2) = (base + 1, base, base)` is exactly the descending mirror
notch `Z` needs; the no-clear placement fills it to `(base + 2, base + 2, base + 1)`, leaving the
valley's right lip (`vc + 3`) and the disjoint flat pocket at columns `pc .. pc + 3` (`vc + 3 < pc`)
untouched. The result is `IsLevelPocketBandAt standard 2 base` with the surviving flat pocket as its
floor run. With the `S` twin this completes the shared-valley site: one width-four valley absorbs
EITHER staircase piece while the flat pocket independently absorbs the five flat pieces, so a single
spread-two board of width `1 + 4 + 4 = 9` columns plus headroom hosts every one of the seven pieces
— the all-seven landing the disjoint-notch budget bound (`#90`, `#151`) ruled out, recovered by
sharing one feature between `S` and `Z`. -/
theorem isLevelPocketBandAt_Z_lands_valley {base vc pc : ℕ} {h : ℕ → ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows)
    (hw0 : h 0 = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ 0 → base ≤ h j ∧ h j ≤ base + 2)
    (hvc : 1 ≤ vc) (hord : vc + 3 < pc) (hpc3 : pc + 3 < GameConfig.standard.cols)
    (hv0 : h vc = base + 1) (hv1 : h (vc + 1) = base) (hv2 : h (vc + 2) = base)
    (hv3 : h (vc + 3) = base + 1)
    (hp0 : h pc = base) (hp1 : h (pc + 1) = base) (hp2 : h (pc + 2) = base)
    (hp3 : h (pc + 3) = base) :
    IsLevelPocketBandAt GameConfig.standard 2 base
      (Placement.applyStep GameConfig.standard (skyline GameConfig.standard h)
        { piece := Piece.Z, rot := 0, col := vc }) := by
  have heq : h (vc + 1) = h (vc + 2) := by rw [hv1, hv2]
  have hstep : h vc = h (vc + 1) + 1 := by rw [hv0, hv1]
  rw [applyStep_Z_skyline_noclear (c := vc) (w := 0) (by omega) (by omega) (by omega)
      heq hstep (by decide) (by omega) (by omega) (by omega) hw0, hv1]
  refine ⟨Function.update (Function.update (Function.update h vc (base + 2))
      (vc + 1) (base + 2)) (vc + 2) (base + 1), 0, pc, rfl, by decide, ?_, ?_, ?_,
    by omega, by omega, by omega, by omega, by omega, ?_, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne (show (0:ℕ) ≠ vc + 2 by omega),
        Function.update_of_ne (show (0:ℕ) ≠ vc + 1 by omega),
        Function.update_of_ne (show (0:ℕ) ≠ vc by omega)]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (vc + 2) with rfl | hjne2
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjne2]
      rcases eq_or_ne j (vc + 1) with rfl | hjne1
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hjne1]
        rcases eq_or_ne j vc with rfl | hjne0
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hjne0]; exact hband j hj hjw
  · exact hslack
  · rw [Function.update_of_ne (show (pc:ℕ) ≠ vc + 2 by omega),
        Function.update_of_ne (show (pc:ℕ) ≠ vc + 1 by omega),
        Function.update_of_ne (show (pc:ℕ) ≠ vc by omega)]; exact hp0
  · rw [Function.update_of_ne (show (pc + 1:ℕ) ≠ vc + 2 by omega),
        Function.update_of_ne (show (pc + 1:ℕ) ≠ vc + 1 by omega),
        Function.update_of_ne (show (pc + 1:ℕ) ≠ vc by omega)]; exact hp1
  · rw [Function.update_of_ne (show (pc + 2:ℕ) ≠ vc + 2 by omega),
        Function.update_of_ne (show (pc + 2:ℕ) ≠ vc + 1 by omega),
        Function.update_of_ne (show (pc + 2:ℕ) ≠ vc by omega)]; exact hp2
  · rw [Function.update_of_ne (show (pc + 3:ℕ) ≠ vc + 2 by omega),
        Function.update_of_ne (show (pc + 3:ℕ) ≠ vc + 1 by omega),
        Function.update_of_ne (show (pc + 3:ℕ) ≠ vc by omega)]; exact hp3

/-- **Shared-valley staircase dispatcher (S and Z twin site).** Bundles the two shared-valley
landings (`isLevelPocketBandAt_S_lands_valley`, `isLevelPocketBandAt_Z_lands_valley`) into the
`∃ pl, pl.piece = p ∧ …` shape the bag-indexed `hstep` consumes: on a spread-two band carrying one
width-four valley at `vc .. vc + 3` and a disjoint flat pocket at `pc .. pc + 3` (`vc + 3 < pc`),
EITHER staircase piece `p ∈ {S, Z}` has a valid no-clear placement keeping the board an
`IsLevelPocketBandAt standard 2 base`. The `S` seats at the valley's ascending right lip (`vc + 1`),
the `Z` at its descending left lip (`vc`); both leave the flat pocket as the surviving floor run.
This is the staircase half of the all-seven-on-one-board landing menu: paired with the flat-pocket
dispatcher (`isLevelPocketBandAt_flatPiece_lands_widePocket`) it gives, for every one of the seven
pieces, a self-regenerating landing on a single width-nine spread-two surface — the configuration
the disjoint-notch budget bound forbids, recovered by letting `S` and `Z` share one valley. -/
theorem isLevelPocketBandAt_valley_hosts_SZ {base vc pc : ℕ} {h : ℕ → ℕ} {p : Piece}
    (hp : p = Piece.S ∨ p = Piece.Z)
    (hslack : base + 2 ≤ GameConfig.standard.rows)
    (hw0 : h 0 = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ 0 → base ≤ h j ∧ h j ≤ base + 2)
    (hvc : 1 ≤ vc) (hord : vc + 3 < pc) (hpc3 : pc + 3 < GameConfig.standard.cols)
    (hv0 : h vc = base + 1) (hv1 : h (vc + 1) = base) (hv2 : h (vc + 2) = base)
    (hv3 : h (vc + 3) = base + 1)
    (hp0 : h pc = base) (hp1 : h (pc + 1) = base) (hp2 : h (pc + 2) = base)
    (hp3 : h (pc + 3) = base) :
    ∃ pl : Placement, pl.piece = p ∧
      Board.IsLevelPocketBandAt GameConfig.standard 2 base
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard h) pl) := by
  rcases hp with rfl | rfl
  · exact ⟨{ piece := Piece.S, rot := 0, col := vc + 1 }, rfl,
      isLevelPocketBandAt_S_lands_valley hslack hw0 hband hvc hord hpc3
        hv0 hv1 hv2 hv3 hp0 hp1 hp2 hp3⟩
  · exact ⟨{ piece := Piece.Z, rot := 0, col := vc }, rfl,
      isLevelPocketBandAt_Z_lands_valley hslack hw0 hband hvc hord hpc3
        hv0 hv1 hv2 hv3 hp0 hp1 hp2 hp3⟩

/-- **Validity-carrying valley dispatcher (S or Z).** Strengthens
`isLevelPocketBandAt_valley_hosts_SZ` by also exposing `pl.Valid standard` in the existential,
so the witness can feed `reservoirCarrier_fill_step`, whose fill obligation is
`∃ pl, pl.piece = p ∧ pl.Valid standard ∧ IsLevelPocketBandAt standard 2 base (applyStep … pl)`.
Validity is `valid_S` / `valid_Z` (each needs `c + 2 < cols`): the `S` lands at `vc + 1` so
`vc + 1 + 2 = vc + 3 < cols` by `hord`, `hpc3`; the `Z` lands at `vc` so `vc + 2 < cols` likewise. -/
theorem isLevelPocketBandAt_valley_hosts_SZ_valid {base vc pc : ℕ} {h : ℕ → ℕ} {p : Piece}
    (hp : p = Piece.S ∨ p = Piece.Z)
    (hslack : base + 2 ≤ GameConfig.standard.rows)
    (hw0 : h 0 = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ 0 → base ≤ h j ∧ h j ≤ base + 2)
    (hvc : 1 ≤ vc) (hord : vc + 3 < pc) (hpc3 : pc + 3 < GameConfig.standard.cols)
    (hv0 : h vc = base + 1) (hv1 : h (vc + 1) = base) (hv2 : h (vc + 2) = base)
    (hv3 : h (vc + 3) = base + 1)
    (hp0 : h pc = base) (hp1 : h (pc + 1) = base) (hp2 : h (pc + 2) = base)
    (hp3 : h (pc + 3) = base) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      Board.IsLevelPocketBandAt GameConfig.standard 2 base
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard h) pl) := by
  rcases hp with rfl | rfl
  · exact ⟨{ piece := Piece.S, rot := 0, col := vc + 1 }, rfl, valid_S (by omega),
      isLevelPocketBandAt_S_lands_valley hslack hw0 hband hvc hord hpc3
        hv0 hv1 hv2 hv3 hp0 hp1 hp2 hp3⟩
  · exact ⟨{ piece := Piece.Z, rot := 0, col := vc }, rfl, valid_Z (by omega),
      isLevelPocketBandAt_Z_lands_valley hslack hw0 hband hvc hord hpc3
        hv0 hv1 hv2 hv3 hp0 hp1 hp2 hp3⟩

/-- **Pocket regeneration (S on a standard notched top).** The first staircase sibling of
the flat-shelf pocket-regeneration menu (`isLevelPocketBand_{O,horizI,T,L,J}_flatTop_standard`):
a plain flat top cannot host an `S`, but the standard *notched* top — reserved well at column
`0`, a single bump at column `3` (`base + 1`), every other column at `base` — gives `S` exactly
the up-step it needs. Seated at column `1` the no-clear `{S, 0, 1}` placement fills the
staircase `(1, 2, 3) = (base, base, base+1)` into the tower `(base+1, base+2, base+2)`,
*subsuming* the bump (column 3 is overwritten), and leaves columns 4 through 9 flat at `base`.
The result is a `IsLevelPocketBand` of spread `2` with floor `base`, well `0`, and a width-4
floor pocket at columns 4, 5, 6, 7 — so the staircase piece, like the five flat-shelf pieces,
absorbs into the surface and *regenerates* a pocket rather than collapsing the band. The two
cells of headroom (`base + 2 ≤ 20`) cap the tower; only the mirror `Z` notch remains to complete
the per-piece pocket-regeneration menu over all seven pieces. -/
theorem isLevelPocketBand_S_notched_standard {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) :
    IsLevelPocketBand GameConfig.standard 2
      (Placement.applyStep GameConfig.standard
        (skyline GameConfig.standard
          (fun j => if j = 0 then 0 else if j = 3 then base + 1 else base))
        { piece := Piece.S, rot := 0, col := 1 }) := by
  set h : ℕ → ℕ := fun j => if j = 0 then 0 else if j = 3 then base + 1 else base with hh
  have hb1 : h 1 = base := by rw [hh]; simp
  have hb2 : h (1 + 1) = base := by rw [hh]; simp
  have hnotch : h (1 + 2) = base + 1 := by rw [hh]; simp
  have hw0 : h 0 = 0 := by rw [hh]; simp
  have heq : h 1 = h (1 + 1) := by rw [hb2, hb1]
  have hstep : h (1 + 2) = h 1 + 1 := by rw [hnotch, hb1]
  rw [applyStep_S_skyline_noclear (c := 1) (w := 0) (by decide) (by decide) (by decide)
      heq hstep (by decide) (by decide) (by decide) (by decide) hw0, hb1]
  refine ⟨Function.update (Function.update (Function.update h 1 (base + 1)) (1 + 1) (base + 2))
      (1 + 2) (base + 2), base, 0, 4, rfl, by decide, ?_, ?_, ?_, by decide, by decide,
    by decide, by decide, by decide, ?_, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne (show (0:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (0:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (0:ℕ) ≠ 1 by decide)]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (1 + 2) with rfl | hj2
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hj2]
      rcases eq_or_ne j (1 + 1) with rfl | hj1
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hj1]
        rcases eq_or_ne j 1 with rfl | hj0
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hj0]
          have hj3 : j ≠ 3 := by omega
          have hjb : h j = base := by rw [hh]; simp only [if_neg hjw, if_neg hj3]
          rw [hjb]; omega
  · exact hslack
  · rw [Function.update_of_ne (show (4:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (4:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (4:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (5:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (5:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (5:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (6:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (6:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (6:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (7:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (7:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (7:ℕ) ≠ 1 by decide), hh]; simp

/-- **Floor-exposing S fill on a standard notched top.** The floor-exposing analogue of
`isLevelPocketBand_S_notched_standard`. On the standard notched top (well at column 0, a unit
bump at column 3 at `base + 1`, every other column at `base`), the no-clear S at column 1 fills
the staircase `(1, 2, 3) = (base, base, base+1)` into the tower `(base+1, base+2, base+2)`,
subsumes the bump, and leaves columns 4 through 9 flat at `base`, landing in a
`IsLevelPocketBandAt standard 2 base` band at the STATICALLY KNOWN floor `base`, with the
width-4 pocket at columns `4, 5, 6, 7`. The proof is identical to the hidden-floor version with
the `base` floor witness dropped. The first staircase member of the floor-exposing per-piece
fill menu. -/
theorem isLevelPocketBandAt_S_notched_standard {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) :
    IsLevelPocketBandAt GameConfig.standard 2 base
      (Placement.applyStep GameConfig.standard
        (skyline GameConfig.standard
          (fun j => if j = 0 then 0 else if j = 3 then base + 1 else base))
        { piece := Piece.S, rot := 0, col := 1 }) := by
  set h : ℕ → ℕ := fun j => if j = 0 then 0 else if j = 3 then base + 1 else base with hh
  have hb1 : h 1 = base := by rw [hh]; simp
  have hb2 : h (1 + 1) = base := by rw [hh]; simp
  have hnotch : h (1 + 2) = base + 1 := by rw [hh]; simp
  have hw0 : h 0 = 0 := by rw [hh]; simp
  have heq : h 1 = h (1 + 1) := by rw [hb2, hb1]
  have hstep : h (1 + 2) = h 1 + 1 := by rw [hnotch, hb1]
  rw [applyStep_S_skyline_noclear (c := 1) (w := 0) (by decide) (by decide) (by decide)
      heq hstep (by decide) (by decide) (by decide) (by decide) hw0, hb1]
  refine ⟨Function.update (Function.update (Function.update h 1 (base + 1)) (1 + 1) (base + 2))
      (1 + 2) (base + 2), 0, 4, rfl, by decide, ?_, ?_, ?_, by decide, by decide,
    by decide, by decide, by decide, ?_, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne (show (0:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (0:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (0:ℕ) ≠ 1 by decide)]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (1 + 2) with rfl | hj2
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hj2]
      rcases eq_or_ne j (1 + 1) with rfl | hj1
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hj1]
        rcases eq_or_ne j 1 with rfl | hj0
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hj0]
          have hj3 : j ≠ 3 := by omega
          have hjb : h j = base := by rw [hh]; simp only [if_neg hjw, if_neg hj3]
          rw [hjb]; omega
  · exact hslack
  · rw [Function.update_of_ne (show (4:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (4:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (4:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (5:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (5:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (5:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (6:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (6:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (6:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (7:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (7:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (7:ℕ) ≠ 1 by decide), hh]; simp

/-- **Z pocket-regeneration on a landing-column notch (mirror of the S brick).** The
mirror of `isLevelPocketBand_S_notched_standard`. Z cannot seat on a flat top, but on a
notched surface with the unit bump at the landing column `1` (input
`if j = 0 then 0 else if j = 1 then base + 1 else base`) the Z at col 1 subsumes the bump:
cols 1 and 2 rise to `base + 2`, col 3 to `base + 1`, and cols 4 through 9 stay flat at
`base`, giving a width-4 pocket at cols 4 through 7 (floor `base`, spread 2) with the
reserved well preserved at col 0. Completes the all-7 per-piece pocket-regeneration menu. -/
theorem isLevelPocketBand_Z_notched_standard {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) :
    IsLevelPocketBand GameConfig.standard 2
      (Placement.applyStep GameConfig.standard
        (skyline GameConfig.standard
          (fun j => if j = 0 then 0 else if j = 1 then base + 1 else base))
        { piece := Piece.Z, rot := 0, col := 1 }) := by
  set h : ℕ → ℕ := fun j => if j = 0 then 0 else if j = 1 then base + 1 else base with hh
  have hbump : h 1 = base + 1 := by rw [hh]; simp
  have hb2 : h (1 + 1) = base := by rw [hh]; simp
  have hb3 : h (1 + 2) = base := by rw [hh]; simp
  have hw0 : h 0 = 0 := by rw [hh]; simp
  have heq : h (1 + 1) = h (1 + 2) := by rw [hb2, hb3]
  have hstep : h 1 = h (1 + 1) + 1 := by rw [hbump, hb2]
  rw [applyStep_Z_skyline_noclear (c := 1) (w := 0) (by decide) (by decide) (by decide)
      heq hstep (by decide) (by decide) (by decide) (by decide) hw0, hb2]
  refine ⟨Function.update (Function.update (Function.update h 1 (base + 2)) (1 + 1) (base + 2))
      (1 + 2) (base + 1), base, 0, 4, rfl, by decide, ?_, ?_, ?_, by decide, by decide,
    by decide, by decide, by decide, ?_, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne (show (0:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (0:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (0:ℕ) ≠ 1 by decide)]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (1 + 2) with rfl | hj2
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hj2]
      rcases eq_or_ne j (1 + 1) with rfl | hj1
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hj1]
        rcases eq_or_ne j 1 with rfl | hj0
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hj0]
          have hjb : h j = base := by rw [hh]; simp only [if_neg hjw, if_neg hj0]
          rw [hjb]; omega
  · exact hslack
  · rw [Function.update_of_ne (show (4:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (4:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (4:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (5:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (5:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (5:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (6:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (6:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (6:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (7:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (7:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (7:ℕ) ≠ 1 by decide), hh]; simp

/-- **Floor-exposing Z fill on a standard notched top (mirror of the S brick).** The
floor-exposing analogue of `isLevelPocketBand_Z_notched_standard`. On the standard notched top
with the unit bump at the landing column `1` (input `if j = 0 then 0 else if j = 1 then base + 1
else base`), the no-clear Z at column 1 subsumes the bump: columns `1, 2` rise to `base + 2`,
column `3` to `base + 1`, and columns `4` through `9` stay flat at `base`, landing in a
`IsLevelPocketBandAt standard 2 base` band at the STATICALLY KNOWN floor `base`, with the
width-4 pocket at columns `4, 5, 6, 7`. The proof is identical to the hidden-floor version with
the `base` floor witness dropped. With the S notch fill this completes the floor-exposing all-7
per-piece fill menu. -/
theorem isLevelPocketBandAt_Z_notched_standard {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) :
    IsLevelPocketBandAt GameConfig.standard 2 base
      (Placement.applyStep GameConfig.standard
        (skyline GameConfig.standard
          (fun j => if j = 0 then 0 else if j = 1 then base + 1 else base))
        { piece := Piece.Z, rot := 0, col := 1 }) := by
  set h : ℕ → ℕ := fun j => if j = 0 then 0 else if j = 1 then base + 1 else base with hh
  have hbump : h 1 = base + 1 := by rw [hh]; simp
  have hb2 : h (1 + 1) = base := by rw [hh]; simp
  have hb3 : h (1 + 2) = base := by rw [hh]; simp
  have hw0 : h 0 = 0 := by rw [hh]; simp
  have heq : h (1 + 1) = h (1 + 2) := by rw [hb2, hb3]
  have hstep : h 1 = h (1 + 1) + 1 := by rw [hbump, hb2]
  rw [applyStep_Z_skyline_noclear (c := 1) (w := 0) (by decide) (by decide) (by decide)
      heq hstep (by decide) (by decide) (by decide) (by decide) hw0, hb2]
  refine ⟨Function.update (Function.update (Function.update h 1 (base + 2)) (1 + 1) (base + 2))
      (1 + 2) (base + 1), 0, 4, rfl, by decide, ?_, ?_, ?_, by decide, by decide,
    by decide, by decide, by decide, ?_, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne (show (0:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (0:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (0:ℕ) ≠ 1 by decide)]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (1 + 2) with rfl | hj2
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hj2]
      rcases eq_or_ne j (1 + 1) with rfl | hj1
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hj1]
        rcases eq_or_ne j 1 with rfl | hj0
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hj0]
          have hjb : h j = base := by rw [hh]; simp only [if_neg hjw, if_neg hj0]
          rw [hjb]; omega
  · exact hslack
  · rw [Function.update_of_ne (show (4:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (4:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (4:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (5:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (5:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (5:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (6:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (6:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (6:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (7:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (7:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (7:ℕ) ≠ 1 by decide), hh]; simp

/-- **All-7 floor-exposing canonical pocket regeneration (uniform per-piece existence).** The
floor-exposing twin of `isLevelPocketBand_canonical_lands_all7`: for EVERY piece `p` there
exists a canonical input surface `s` and a VALID placement `pl` of `p` such that dropping `p`
on `skyline s` lands back in a spread-2 level pocket band whose floor is EXPLICITLY `base`
(`IsLevelPocketBandAt` pins the floor as a parameter, where `IsLevelPocketBand` hides it under
an existential). The five flat-shelf pieces `{O, I, T, L, J}` regenerate from the standard flat
top (`isLevelPocketBandAt_flatShelf_lands_standard`); the two staircase pieces seat on their
tailored notch — `S` on the col-3 bump (`isLevelPocketBandAt_S_notched_standard`), `Z` on the
col-1 bump (`isLevelPocketBandAt_Z_notched_standard`). Exposing the floor is what lets a
phase-indexed σ chain these landings: the next piece's input surface is built at the SAME `base`
the previous landing exposed, so the floor is threaded explicitly through the dispatch rather
than re-existentialised each step. This is the floor-tracked `∃ surface` brick the bag-phase
strategy consumes to answer the drawn piece while keeping the band's floor pinned. -/
theorem isLevelPocketBandAt_canonical_lands_all7 {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (p : Piece) :
    ∃ (s : ℕ → ℕ) (pl : Placement), pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      IsLevelPocketBandAt GameConfig.standard 2 base
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) := by
  cases p with
  | O =>
      obtain ⟨pl, hpiece, hvalid, hband⟩ :=
        isLevelPocketBandAt_flatShelf_lands_standard hslack (Or.inl rfl)
      exact ⟨_, pl, hpiece, hvalid, hband⟩
  | I =>
      obtain ⟨pl, hpiece, hvalid, hband⟩ :=
        isLevelPocketBandAt_flatShelf_lands_standard hslack
          (Or.inr (Or.inr (Or.inr (Or.inr rfl))))
      exact ⟨_, pl, hpiece, hvalid, hband⟩
  | S =>
      exact ⟨_, { piece := Piece.S, rot := 0, col := 1 }, rfl, by decide,
        isLevelPocketBandAt_S_notched_standard hslack⟩
  | Z =>
      exact ⟨_, { piece := Piece.Z, rot := 0, col := 1 }, rfl, by decide,
        isLevelPocketBandAt_Z_notched_standard hslack⟩
  | T =>
      obtain ⟨pl, hpiece, hvalid, hband⟩ :=
        isLevelPocketBandAt_flatShelf_lands_standard hslack (Or.inr (Or.inl rfl))
      exact ⟨_, pl, hpiece, hvalid, hband⟩
  | L =>
      obtain ⟨pl, hpiece, hvalid, hband⟩ :=
        isLevelPocketBandAt_flatShelf_lands_standard hslack
          (Or.inr (Or.inr (Or.inl rfl)))
      exact ⟨_, pl, hpiece, hvalid, hband⟩
  | J =>
      obtain ⟨pl, hpiece, hvalid, hband⟩ :=
        isLevelPocketBandAt_flatShelf_lands_standard hslack
          (Or.inr (Or.inr (Or.inr (Or.inl rfl))))
      exact ⟨_, pl, hpiece, hvalid, hband⟩

/-- **The canonical dispatch is a band-to-band edge: BOTH endpoints are pocket bands.** The
input-side strengthening of `isLevelPocketBandAt_canonical_lands_all7`: for EVERY piece `p` the
canonical surface `s` the dispatcher drops `p` onto is itself a spread-2 level pocket band at floor
`base`, in addition to the landing board being one. For the five flat-shelf pieces the input is the
flat shelf, already a spread-2 band by `isLevelPocketBandAt_flatShelf_input`. For `S` and `Z` the
input is the notched shelf, a spread-1 band by `isLevelPocketBandAt_{S,Z}notch_input`, lifted to
spread 2 by `isLevelPocketBandAt_mono_spread`. With both endpoints certified band members, the
canonical dispatch is now a genuine transition edge of the multi-shape carrier: standing on a
canonical band member, any drawn piece has a valid placement back into a band member. This is the
first real `hP_step` brick for the disjunctive surface carrier. -/
theorem isLevelPocketBandAt_canonical_input_isBand {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (p : Piece) :
    ∃ (s : ℕ → ℕ) (pl : Placement), pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      IsLevelPocketBandAt GameConfig.standard 2 base (skyline GameConfig.standard s) ∧
      IsLevelPocketBandAt GameConfig.standard 2 base
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) := by
  cases p with
  | O =>
      obtain ⟨pl, hpiece, hvalid, hband⟩ :=
        isLevelPocketBandAt_flatShelf_lands_standard hslack (Or.inl rfl)
      exact ⟨_, pl, hpiece, hvalid, isLevelPocketBandAt_flatShelf_input hslack, hband⟩
  | I =>
      obtain ⟨pl, hpiece, hvalid, hband⟩ :=
        isLevelPocketBandAt_flatShelf_lands_standard hslack
          (Or.inr (Or.inr (Or.inr (Or.inr rfl))))
      exact ⟨_, pl, hpiece, hvalid, isLevelPocketBandAt_flatShelf_input hslack, hband⟩
  | S =>
      exact ⟨_, { piece := Piece.S, rot := 0, col := 1 }, rfl, by decide,
        isLevelPocketBandAt_mono_spread (isLevelPocketBandAt_Snotch_input (by omega))
          (by omega) hslack,
        isLevelPocketBandAt_S_notched_standard hslack⟩
  | Z =>
      exact ⟨_, { piece := Piece.Z, rot := 0, col := 1 }, rfl, by decide,
        isLevelPocketBandAt_mono_spread (isLevelPocketBandAt_Znotch_input (by omega))
          (by omega) hslack,
        isLevelPocketBandAt_Z_notched_standard hslack⟩
  | T =>
      obtain ⟨pl, hpiece, hvalid, hband⟩ :=
        isLevelPocketBandAt_flatShelf_lands_standard hslack (Or.inr (Or.inl rfl))
      exact ⟨_, pl, hpiece, hvalid, isLevelPocketBandAt_flatShelf_input hslack, hband⟩
  | L =>
      obtain ⟨pl, hpiece, hvalid, hband⟩ :=
        isLevelPocketBandAt_flatShelf_lands_standard hslack
          (Or.inr (Or.inr (Or.inl rfl)))
      exact ⟨_, pl, hpiece, hvalid, isLevelPocketBandAt_flatShelf_input hslack, hband⟩
  | J =>
      obtain ⟨pl, hpiece, hvalid, hband⟩ :=
        isLevelPocketBandAt_flatShelf_lands_standard hslack
          (Or.inr (Or.inr (Or.inr (Or.inl rfl))))
      exact ⟨_, pl, hpiece, hvalid, isLevelPocketBandAt_flatShelf_input hslack, hband⟩

/-- **Carrier-level canonical step edge.** The carrier-vocabulary lift of
`isLevelPocketBandAt_canonical_input_isBand` (the ABMX band→band edge): for every piece `p` there
is a canonical surface `s` and a VALID placement `pl` such that BOTH the input surface
`skyline s` and the landing board `applyStep (skyline s) pl` are pocket-band carrier members
(`IsPocketBandCarrier`). This is the closest thing yet to the carrier's per-piece `hP_step`
self-edge: from a canonical-input carrier member, whatever piece is drawn there is a valid placement
landing back in the carrier. The hidden floor/spread are repackaged into `IsPocketBandCarrier`'s
existential at spread `2`, floor `base`. What it does NOT yet give (the open #66 content) is the edge
from an *arbitrary* carrier member — the landing here is a 2-bump spread-2 band, not itself a
canonical input — so a single application does not yet chain to a second piece without the per-bag
drain (`isLevelPocketBandAt_fill_then_drain`/`vertI_descends`) re-flattening toward a canonical
shape. -/
theorem isPocketBandCarrier_canonical_step {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (p : Piece) :
    ∃ (s : ℕ → ℕ) (pl : Placement), pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      IsPocketBandCarrier (skyline GameConfig.standard s) ∧
      IsPocketBandCarrier
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) := by
  obtain ⟨s, pl, hpiece, hvalid, hin, hout⟩ := isLevelPocketBandAt_canonical_input_isBand hslack p
  exact ⟨s, pl, hpiece, hvalid, ⟨2, base, hin⟩, ⟨2, base, hout⟩⟩

/-- **Spread-pinned canonical step edge** (the budgeted-vocabulary lift of
`isPocketBandCarrier_canonical_step`). Where the bare-carrier version forgets the spread under a
second existential, this one keeps the budget visible: for every piece `p` there is a canonical
surface `s` and a VALID placement `pl` such that BOTH the input surface `skyline s` and the landing
board `applyStep (skyline s) pl` are spread-`2` bounded carrier members
(`IsBoundedPocketBandCarrier 2`). Both endpoints of `isLevelPocketBandAt_canonical_input_isBand` are
spread-2 bands at the SAME floor `base`, so each repackages directly into the budgeted carrier's
single floor existential at the pinned spread `2` (`⟨base, hin⟩` / `⟨base, hout⟩`). This is the
budgeted analogue of the carrier's per-piece fill self-edge — it certifies that the canonical answer
to any drawn piece never spends more than the fixed budget-2 headroom, the invariant a bag-indexed
σ reads `spread` off. What it does NOT yet give (the open #66 content) is the edge from an ARBITRARY
budgeted member — the landing here is a 2-bump spread-2 band, not itself a canonical input, so a
single application does not chain to a second piece without the per-bag drain re-flattening toward a
canonical shape and restoring the budget. -/
theorem isBoundedPocketBandCarrier_canonical_step {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (p : Piece) :
    ∃ (s : ℕ → ℕ) (pl : Placement), pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      IsBoundedPocketBandCarrier 2 (skyline GameConfig.standard s) ∧
      IsBoundedPocketBandCarrier 2
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) := by
  obtain ⟨s, pl, hpiece, hvalid, hin, hout⟩ := isLevelPocketBandAt_canonical_input_isBand hslack p
  exact ⟨s, pl, hpiece, hvalid, ⟨base, hin⟩, ⟨base, hout⟩⟩

/-- **Carrier-level I regulator (drain edge).** From any floor-exposing level pocket band whose
floor is at least 4, the vertical I-drop into the reserved well lands in a board that is still a
pocket-band carrier (its floor having dropped by 4). This is the drain half of the per-bag cycle:
it lifts `isLevelPocketBandAt_vertI_descends` from the floor-pinned band vocabulary up to the
floor-forgetting `IsPocketBandCarrier`, so the regulator step composes with the cheap carrier
faces (`isPocketBandCarrier_not_isLost`, `isPocketBandCarrier_wf`) without re-exposing the floor
index. Dual to the fill edge `isPocketBandCarrier_canonical_step`. -/
theorem isPocketBandCarrier_of_vertI_descends {spread floor : ℕ} {b : Board}
    (hband : IsLevelPocketBandAt GameConfig.standard spread floor b) (hfloor : 4 ≤ floor) :
    ∃ pl : Placement, pl.piece = Piece.I ∧ pl.Valid GameConfig.standard ∧
      IsPocketBandCarrier (Placement.applyStep GameConfig.standard b pl) := by
  obtain ⟨pl, hpiece, hvalid, hband'⟩ := isLevelPocketBandAt_vertI_descends hband hfloor
  exact ⟨pl, hpiece, hvalid, ⟨spread, floor - 4, hband'⟩⟩

/-- **Carrier-level place-then-drain transition edge (the per-bag half-cycle, carrier vocabulary).**
Composes the canonical fill edge `isLevelPocketBandAt_canonical_input_isBand` with the I-regulator
drain edge `isPocketBandCarrier_of_vertI_descends` into a single two-placement transition that keeps
the pocket-band carrier. From a canonical input surface at floor `base` with `4 ≤ base`, for EVERY
drawn piece `p` there is a valid placement `pl` of `p` followed by a valid vertical-`I` placement
`plI` such that BOTH the input surface and the post-drain board are pocket-band carrier members. The
fill drops `p` onto its canonical surface, landing in a spread-2 band at the SAME floor `base` (floor
exposed, hence immediately ready for the drain); the drain then drops the well `I`, clearing four
rows and lowering the floor by four. This is the genuine transition edge the multi-shape carrier
rides: a piece answer paired with the height-regulating well clear that offsets its raise, so the
carrier is preserved across the answer-and-regulate pair rather than only across a single canonical
fill. The remaining open content (#66) is the edge from an ARBITRARY carrier member rather than a
canonical input, plus the bag-order bookkeeping that interleaves the single per-bag `I` among the
seven draws. -/
theorem isPocketBandCarrier_canonical_step_drain {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (hfloor : 4 ≤ base) (p : Piece) :
    ∃ (s : ℕ → ℕ) (pl plI : Placement),
      pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      plI.piece = Piece.I ∧ plI.Valid GameConfig.standard ∧
      IsPocketBandCarrier (skyline GameConfig.standard s) ∧
      IsPocketBandCarrier
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) plI) := by
  obtain ⟨s, pl, hpiece, hvalid, hin, hout⟩ := isLevelPocketBandAt_canonical_input_isBand hslack p
  obtain ⟨plI, hpieceI, hvalidI, hdrain⟩ := isPocketBandCarrier_of_vertI_descends hout hfloor
  exact ⟨s, pl, plI, hpiece, hvalid, hpieceI, hvalidI, ⟨2, base, hin⟩, hdrain⟩

/-- **Spread-pinned place-then-drain half-cycle** (the budgeted-vocabulary lift of
`isPocketBandCarrier_canonical_step_drain`). The answer-and-regulate pair stated entirely in the
fixed budget-`2` carrier: from a canonical input surface at floor `base` with `4 ≤ base`, for EVERY
drawn piece `p` there is a valid placement `pl` of `p` followed by a valid well-`I` placement `plI`
such that BOTH the input surface `skyline s` and the post-drain board are spread-`2` bounded carrier
members (`IsBoundedPocketBandCarrier 2`). The fill drops `p` onto its canonical surface, landing in a
spread-2 band at the SAME floor `base` (so the input repackages directly as `⟨base, hin⟩`); the drain
`isBoundedPocketBandCarrier_of_vertI_descends` then drops the well `I`, lowering the floor by four
while HOLDING THE SPREAD BUDGET FIXED at 2 — the budgeted refinement of the bare drain, which would
have forgotten the spread. Where the per-piece fill self-edge `isBoundedPocketBandCarrier_canonical_step`
proves the answer never overspends the budget, this pairs that answer with the height-regulating well
clear that offsets its raise, so the WHOLE answer-and-regulate transition is closed in budget-2
vocabulary, not just the fill. This is the net-flat per-bag edge the phase-indexed `hstep` rides — a
piece answer fused to its drain, budget preserved across the pair. The remaining open content (#66) is
unchanged: the edge from an ARBITRARY budgeted member rather than a canonical input, plus the bag-order
bookkeeping interleaving the single per-bag `I` among the seven draws. -/
theorem isBoundedPocketBandCarrier_canonical_step_drain {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (hfloor : 4 ≤ base) (p : Piece) :
    ∃ (s : ℕ → ℕ) (pl plI : Placement),
      pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      plI.piece = Piece.I ∧ plI.Valid GameConfig.standard ∧
      IsBoundedPocketBandCarrier 2 (skyline GameConfig.standard s) ∧
      IsBoundedPocketBandCarrier 2
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) plI) := by
  obtain ⟨s, pl, hpiece, hvalid, hin, hout⟩ := isLevelPocketBandAt_canonical_input_isBand hslack p
  obtain ⟨plI, hpieceI, hvalidI, hdrain, _⟩ :=
    isBoundedPocketBandCarrier_of_vertI_descends hout hfloor
  exact ⟨s, pl, plI, hpiece, hvalid, hpieceI, hvalidI, ⟨base, hin⟩, hdrain⟩

/-- **Fully-certified spread-pinned place-then-drain half-cycle (budgeted membership AND survival,
one brick).** The budgeted-vocabulary fusion mirroring `isLevelPocketBandAt_canonical_step_drain_floor_safe`:
where that brick exposes the floor ledger on the band vocabulary, this one states everything in the
fixed budget-`2` carrier and adds the post-fill board's membership that the bare
`isBoundedPocketBandCarrier_canonical_step_drain` omits. For EVERY drawn piece `p` (with `4 ≤ base`)
there is a canonical input surface `skyline s` and a valid placement `pl` of `p` followed by a valid
well-`I` placement `plI` such that ALL THREE boards the half-cycle passes through — the input surface,
the post-fill landing, and the post-drain board — are spread-`2` bounded carrier members
(`IsBoundedPocketBandCarrier 2`), AND each of the three is certified `¬ Board.isLost`. The two
canonical endpoints are spread-2 bands at floor `base` (so each repackages as `⟨base, ·⟩`); the drain
`isBoundedPocketBandCarrier_of_vertI_descends` holds the budget fixed while lowering the floor and
hands back the post-drain board's survival directly. This is the maximal single-piece-plus-regulator
certificate in budgeted vocabulary — the carrier-membership a σ-invariant threads forward AND the
top-out-free obligation it discharges, in the SAME witness, for the whole answer-and-regulate pair.
The remaining open content (#66) is unchanged: the edge from an ARBITRARY budgeted member rather than a
canonical input, plus the bag-order interleaving of the single per-bag `I` among the seven draws. -/
theorem isBoundedPocketBandCarrier_canonical_step_drain_safe {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (hfloor : 4 ≤ base) (p : Piece) :
    ∃ (s : ℕ → ℕ) (pl plI : Placement),
      pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      plI.piece = Piece.I ∧ plI.Valid GameConfig.standard ∧
      IsBoundedPocketBandCarrier 2 (skyline GameConfig.standard s) ∧
      IsBoundedPocketBandCarrier 2
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ∧
      IsBoundedPocketBandCarrier 2
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) plI) ∧
      ¬ Board.isLost GameConfig.standard (skyline GameConfig.standard s) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) plI) := by
  obtain ⟨s, pl, hpiece, hvalid, hin, hout⟩ := isLevelPocketBandAt_canonical_input_isBand hslack p
  obtain ⟨plI, hpieceI, hvalidI, hdrain, hdrainsafe⟩ :=
    isBoundedPocketBandCarrier_of_vertI_descends hout hfloor
  exact ⟨s, pl, plI, hpiece, hvalid, hpieceI, hvalidI,
    ⟨base, hin⟩, ⟨base, hout⟩, hdrain,
    isBoundedPocketBandCarrier_not_isLost ⟨base, hin⟩,
    isBoundedPocketBandCarrier_not_isLost ⟨base, hout⟩,
    hdrainsafe⟩

/-- **Survival face of the carrier place-then-drain transition.** The `not_isLost` strengthening
of `isPocketBandCarrier_canonical_step_drain`: the same two-placement answer-and-regulate edge, but
now certifying that EVERY board the transition passes through is alive — the input surface
`skyline s`, the post-fill board after dropping `p`, AND the post-drain board after the well `I`.
All three are pocket-band carrier members (the first two at floor `base`, the last at floor
`base - 4`), and `isPocketBandCarrier_not_isLost` reads non-loss off each carrier witness directly.
This is the per-bag half-cycle's full survival certificate: a phase-indexed σ that answers a drawn
piece by this canonical fill and regulates with the well drain never stands on, lands on, or drains
into a lost board. The remaining open content (#66) is unchanged — the edge from an ARBITRARY
carrier member rather than a canonical input, and the bag-order interleaving of the single per-bag
`I`. -/
theorem isPocketBandCarrier_canonical_step_drain_not_isLost {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (hfloor : 4 ≤ base) (p : Piece) :
    ∃ (s : ℕ → ℕ) (pl plI : Placement),
      pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      plI.piece = Piece.I ∧ plI.Valid GameConfig.standard ∧
      ¬ Board.isLost GameConfig.standard (skyline GameConfig.standard s) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) plI) := by
  obtain ⟨s, pl, hpiece, hvalid, hin, hout⟩ := isLevelPocketBandAt_canonical_input_isBand hslack p
  obtain ⟨plI, hpieceI, hvalidI, hdrain⟩ := isPocketBandCarrier_of_vertI_descends hout hfloor
  exact ⟨s, pl, plI, hpiece, hvalid, hpieceI, hvalidI,
    isPocketBandCarrier_not_isLost ⟨2, base, hin⟩,
    isPocketBandCarrier_not_isLost ⟨2, base, hout⟩,
    isPocketBandCarrier_not_isLost hdrain⟩

/-- **Floor-tracked place-then-drain half-cycle (the explicit −4 height ledger).** The floor-EXPOSING
refinement of `isPocketBandCarrier_canonical_step_drain`: the same two-placement answer-and-regulate
transition, but stated on the floor-pinned band `IsLevelPocketBandAt std 2 ·` rather than the
floor-forgetting `IsPocketBandCarrier`, so the height bookkeeping is visible. From a canonical input
surface that is a spread-2 band at floor `base` (with `4 ≤ base`), for EVERY drawn piece `p` there is
a valid placement `pl` of `p` followed by a valid well-`I` placement `plI` such that the input surface
is a spread-2 band at floor `base` and the post-drain board is a spread-2 band at floor `base - 4`.
The fill raises onto a spread-2 band at the SAME floor `base` (floor exposed, ready to drain); the
drain `isLevelPocketBandAt_vertI_descends` then clears four rows, PRESERVING the spread at 2 and
LOWERING the floor by exactly four. Where the carrier version hides the floor inside an existential,
this version exhibits it: one answer-and-regulate half-cycle is a net `base ↦ base - 4` drop of the
exposed floor at fixed spread 2. That explicit ledger is the multi-bag height accounting a
phase-indexed σ rides — it is what lets a drain be SCHEDULED to offset the cumulative raise of the
preceding fills, the bookkeeping the floor-forgetting carrier edge cannot express. The remaining open
content (#66) is unchanged — the edge from an ARBITRARY band member rather than a canonical input,
and the bag-order interleaving of the single per-bag `I` among the seven draws. -/
theorem isLevelPocketBandAt_canonical_step_drain_floor {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (hfloor : 4 ≤ base) (p : Piece) :
    ∃ (s : ℕ → ℕ) (pl plI : Placement),
      pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      plI.piece = Piece.I ∧ plI.Valid GameConfig.standard ∧
      IsLevelPocketBandAt GameConfig.standard 2 base (skyline GameConfig.standard s) ∧
      IsLevelPocketBandAt GameConfig.standard 2 (base - 4)
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) plI) := by
  obtain ⟨s, pl, hpiece, hvalid, hin, hout⟩ := isLevelPocketBandAt_canonical_input_isBand hslack p
  obtain ⟨plI, hpieceI, hvalidI, hdrain⟩ := isLevelPocketBandAt_vertI_descends hout hfloor
  exact ⟨s, pl, plI, hpiece, hvalid, hpieceI, hvalidI, hin, hdrain⟩

/-- **Fully-certified floor-tracked place-then-drain half-cycle (ledger AND survival, one brick).**
The fusion of `isLevelPocketBandAt_canonical_step_drain_floor` (the explicit `base ↦ base - 4` floor
ledger) with the three-board survival of `isPocketBandCarrier_canonical_step_drain_not_isLost`,
stated on the floor-pinned band so a single witness carries everything a single-step σ-invariant
discharge consumes. For EVERY drawn piece `p` (with `4 ≤ base`) there is a canonical input surface
`skyline s` and a valid placement `pl` of `p` followed by a valid well-`I` placement `plI` such that
(i) the input surface is a spread-2 band at floor `base`, (ii) the post-drain board is a spread-2
band at floor `base - 4`, AND (iii) all three boards the half-cycle passes through — the input
surface, the post-fill landing, and the post-drain board — are certified `¬ Board.isLost`. The two
band endpoints supply both the `hP_height`/`hP_valid`-style ledger (floor and spread are pinned, so
every column height is read off `floor + spread`) and the survival obligation (each band is not lost
via `isLevelPocketBandAt_not_isLost`), in the SAME witness. This is the maximal single-piece-plus-
regulator certificate the surface-invariant machinery hands a phase-indexed σ: the answer to the
drawn piece, the height-regulating well clear that offsets it, the resulting `−4` floor drop, and the
guarantee that nothing in between is a top-out. The remaining open content (#66) is unchanged — the
edge from an ARBITRARY band member rather than a canonical input, and the bag-order interleaving of
the single per-bag `I` among the seven draws. -/
theorem isLevelPocketBandAt_canonical_step_drain_floor_safe {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (hfloor : 4 ≤ base) (p : Piece) :
    ∃ (s : ℕ → ℕ) (pl plI : Placement),
      pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      plI.piece = Piece.I ∧ plI.Valid GameConfig.standard ∧
      IsLevelPocketBandAt GameConfig.standard 2 base (skyline GameConfig.standard s) ∧
      IsLevelPocketBandAt GameConfig.standard 2 (base - 4)
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) plI) ∧
      ¬ Board.isLost GameConfig.standard (skyline GameConfig.standard s) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) plI) := by
  obtain ⟨s, pl, hpiece, hvalid, hin, hout⟩ := isLevelPocketBandAt_canonical_input_isBand hslack p
  obtain ⟨plI, hpieceI, hvalidI, hdrain⟩ := isLevelPocketBandAt_vertI_descends hout hfloor
  exact ⟨s, pl, plI, hpiece, hvalid, hpieceI, hvalidI, hin, hdrain,
    isLevelPocketBandAt_not_isLost hin,
    isLevelPocketBandAt_not_isLost hout,
    isLevelPocketBandAt_not_isLost hdrain⟩

/-- **Floor-exposing survival face of the all-7 canonical pocket regeneration.** The `not_isLost`
strengthening of `isLevelPocketBandAt_canonical_lands_all7`: for EVERY piece `p` the canonical
surface `s` and VALID placement `pl` land back in a spread-2 level pocket band whose floor is
EXPLICITLY `base`, AND that landing board is certified *not lost*. The survival conjunct is read
off the band by first forgetting the explicit floor back into an existential
(`isLevelPocketBand_of_isLevelPocketBandAt`), then forgetting the pocket to a spread-2
reserved-well skyline (`isSpreadBoundedRWSkyline_of_isLevelPocketBand`), whose ceiling cap rules
out a top-out (`not_isLost_of_isSpreadBoundedRWSkyline`). The output band stays floor-pinned even
though the survival proof routes through the floor-hiding chain — so this is the floor-tracked
*answer-and-survive* certificate a phase-indexed σ consumes: whatever piece the adversary draws,
the player has a canonical surface from which that piece both rebuilds the pocket at the SAME
`base` AND keeps the game alive. -/
theorem isLevelPocketBandAt_canonical_lands_all7_not_isLost {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (p : Piece) :
    ∃ (s : ℕ → ℕ) (pl : Placement), pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      IsLevelPocketBandAt GameConfig.standard 2 base
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) := by
  obtain ⟨s, pl, hpiece, hvalid, hband⟩ := isLevelPocketBandAt_canonical_lands_all7 hslack p
  exact ⟨s, pl, hpiece, hvalid, hband,
    not_isLost_of_isSpreadBoundedRWSkyline
      (isSpreadBoundedRWSkyline_of_isLevelPocketBand
        (isLevelPocketBand_of_isLevelPocketBandAt hband))⟩

/-- **Floor-exposing input survival of the all-7 canonical pocket regeneration.** The companion
to `isLevelPocketBandAt_canonical_lands_all7_not_isLost` that certifies the *other* endpoint of
the fill: not only is the LANDING board un-lost, the INPUT surface `skyline s` the player drops
onto is itself never lost. Each canonical profile is height-bounded — the flat shelf tops out at
`base`, the `S` and `Z` notches at `base + 1` — and `base + 2 ≤ rows` keeps even the notch bump
inside the field, so `not_isLost_skyline` discharges the input non-loss directly from the profile
cap. This closes the start-surface gap flagged for `isLevelPocketBandAt_fill_then_drain`: with both
the input surface and the landing certified un-lost, EVERY board the bag-phase passes through
(input, post-fill, and every drain prefix) is now known alive, so a phase-indexed σ may answer any
drawn piece from a surface it is also safe to stand on. -/
theorem isLevelPocketBandAt_canonical_input_not_isLost {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (p : Piece) :
    ∃ (s : ℕ → ℕ) (pl : Placement), pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      IsLevelPocketBandAt GameConfig.standard 2 base
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ∧
      ¬ Board.isLost GameConfig.standard (skyline GameConfig.standard s) := by
  have hflat : ∀ j, j < GameConfig.standard.cols →
      (if j = 0 then 0 else base) ≤ GameConfig.standard.rows := by
    intro j _; split_ifs <;> omega
  have hS : ∀ j, j < GameConfig.standard.cols →
      (if j = 0 then 0 else if j = 3 then base + 1 else base) ≤ GameConfig.standard.rows := by
    intro j _; split_ifs <;> omega
  have hZ : ∀ j, j < GameConfig.standard.cols →
      (if j = 0 then 0 else if j = 1 then base + 1 else base) ≤ GameConfig.standard.rows := by
    intro j _; split_ifs <;> omega
  cases p with
  | O =>
      obtain ⟨pl, hpiece, hvalid, hband⟩ :=
        isLevelPocketBandAt_flatShelf_lands_standard hslack (Or.inl rfl)
      exact ⟨_, pl, hpiece, hvalid, hband, not_isLost_skyline hflat⟩
  | I =>
      obtain ⟨pl, hpiece, hvalid, hband⟩ :=
        isLevelPocketBandAt_flatShelf_lands_standard hslack
          (Or.inr (Or.inr (Or.inr (Or.inr rfl))))
      exact ⟨_, pl, hpiece, hvalid, hband, not_isLost_skyline hflat⟩
  | S =>
      exact ⟨_, { piece := Piece.S, rot := 0, col := 1 }, rfl, by decide,
        isLevelPocketBandAt_S_notched_standard hslack, not_isLost_skyline hS⟩
  | Z =>
      exact ⟨_, { piece := Piece.Z, rot := 0, col := 1 }, rfl, by decide,
        isLevelPocketBandAt_Z_notched_standard hslack, not_isLost_skyline hZ⟩
  | T =>
      obtain ⟨pl, hpiece, hvalid, hband⟩ :=
        isLevelPocketBandAt_flatShelf_lands_standard hslack (Or.inr (Or.inl rfl))
      exact ⟨_, pl, hpiece, hvalid, hband, not_isLost_skyline hflat⟩
  | L =>
      obtain ⟨pl, hpiece, hvalid, hband⟩ :=
        isLevelPocketBandAt_flatShelf_lands_standard hslack
          (Or.inr (Or.inr (Or.inl rfl)))
      exact ⟨_, pl, hpiece, hvalid, hband, not_isLost_skyline hflat⟩
  | J =>
      obtain ⟨pl, hpiece, hvalid, hband⟩ :=
        isLevelPocketBandAt_flatShelf_lands_standard hslack
          (Or.inr (Or.inr (Or.inr (Or.inl rfl))))
      exact ⟨_, pl, hpiece, hvalid, hband, not_isLost_skyline hflat⟩

/-- **Answer-and-reset: absorb the drawn piece, then run the I-regulator back down to the
floor-residue, surviving throughout.** The first lemma that threads a non-I fill straight INTO
the floor-down drain on the floor-exposing carrier — the bag-phase half-cycle in one statement.
For EVERY piece `p` there is a canonical input surface `s`, a VALID placement `pl` of `p` that
regenerates a spread-2 pocket band at floor `base` (`isLevelPocketBandAt_canonical_lands_all7`),
and a list of valid `I`-placements that drains that band down to the floor-residue `base % 4`
(`isLevelPocketBandAt_vertI_drain_safe`). No `4 ≤ base` is required: when `base < 4` the drain is
the empty list and the residue is `base` itself. The non-loss bookkeeping is complete on both
phases — the post-fill board is certified un-lost, and every prefix of the drain is too — so a
strategy may answer the piece and run the entire reset blind to the intermediate boards. This is
the absorb-then-regulate brick a phase-indexed σ chains across a bag; what it does NOT yet supply
is the floor-RAISE that a closed cycle needs (the fills are floor-preserving, the drain
floor-lowering), the open core of #66. -/
theorem isLevelPocketBandAt_fill_then_drain {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (p : Piece) :
    ∃ (s : ℕ → ℕ) (pl : Placement) (ps : List Placement),
      pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      (∀ q ∈ ps, q.piece = Piece.I ∧ q.Valid GameConfig.standard) ∧
      IsLevelPocketBandAt GameConfig.standard 2 (base % 4)
        (List.foldl (Placement.applyStep GameConfig.standard)
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ps) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ∧
      (∀ k, ¬ Board.isLost GameConfig.standard
        (List.foldl (Placement.applyStep GameConfig.standard)
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl)
          (ps.take k))) := by
  obtain ⟨s, pl, hpiece, hvalid, hband, hfillsafe⟩ :=
    isLevelPocketBandAt_canonical_lands_all7_not_isLost hslack p
  obtain ⟨ps, hall, hdrain, hsafe⟩ := isLevelPocketBandAt_vertI_drain_safe hband
  exact ⟨s, pl, ps, hpiece, hvalid, hall, hdrain, hfillsafe, hsafe⟩

/-- **Fully-certified answer-and-reset half-cycle (every board alive).** The gap-closed upgrade of
`isLevelPocketBandAt_fill_then_drain`: it threads the iter168 INPUT survival certificate
(`isLevelPocketBandAt_canonical_input_not_isLost`) alongside the post-fill and drain-prefix
certificates, so for EVERY piece `p` the entire bag-phase half-cycle — the input surface
`skyline s` the player stands on, the post-fill landing, and every prefix of the `I`-drain back to
the floor-residue `base % 4` — is certified `¬ isLost`. Nothing the adversary or the regulator
touches is ever a top-out. The post-fill non-loss is re-derived from the landing band through the
floor-hiding survival chain (`isSpreadBoundedRWSkyline_of_isLevelPocketBand` then
`not_isLost_of_isSpreadBoundedRWSkyline`); the drain prefixes come from
`isLevelPocketBandAt_vertI_drain_safe`. This is the complete absorb-then-regulate brick a
phase-indexed σ chains across a bag with NO blind boards; the one thing still missing for a closed
cycle is the floor-RAISE (fills are floor-preserving, the drain floor-lowering), the open core of
#66. -/
theorem isLevelPocketBandAt_fill_then_drain_full {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (p : Piece) :
    ∃ (s : ℕ → ℕ) (pl : Placement) (ps : List Placement),
      pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      (∀ q ∈ ps, q.piece = Piece.I ∧ q.Valid GameConfig.standard) ∧
      IsLevelPocketBandAt GameConfig.standard 2 (base % 4)
        (List.foldl (Placement.applyStep GameConfig.standard)
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ps) ∧
      ¬ Board.isLost GameConfig.standard (skyline GameConfig.standard s) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ∧
      (∀ k, ¬ Board.isLost GameConfig.standard
        (List.foldl (Placement.applyStep GameConfig.standard)
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl)
          (ps.take k))) := by
  obtain ⟨s, pl, hpiece, hvalid, hband, hinput⟩ :=
    isLevelPocketBandAt_canonical_input_not_isLost hslack p
  have hfillsafe : ¬ Board.isLost GameConfig.standard
      (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) :=
    not_isLost_of_isSpreadBoundedRWSkyline
      (isSpreadBoundedRWSkyline_of_isLevelPocketBand
        (isLevelPocketBand_of_isLevelPocketBandAt hband))
  obtain ⟨ps, hall, hdrain, hsafe⟩ := isLevelPocketBandAt_vertI_drain_safe hband
  exact ⟨s, pl, ps, hpiece, hvalid, hall, hdrain, hinput, hfillsafe, hsafe⟩

/-- **Height-collapse face of the fully-certified half-cycle (constant cap, base-independent).**
Annotates `isLevelPocketBandAt_fill_then_drain_full` with the explicit per-column height cap read
off the drained band: every column of the post-drain board sits at `colHeight ≤ base % 4 + 2`. The
point is the cap is a CONSTANT — at most `3 + 2 = 5` no matter how tall the input band `base` was
(`base % 4 ≤ 3`) — so the `I`-regulator provably collapses an arbitrarily tall pocket band down to
height `≤ 5`, the bounded-height mechanism a forever-strategy needs. Read off via
`colHeight_le_of_isLevelPocketBandAt` on the `base % 4` drain band; the survival certificates ride
along unchanged. This is the per-column height obligation a concrete σ discharges for
`tetrisSolvableValid_of_strategy`'s `hheight` on the drained endpoint: `base % 4 + 2 ≤ 5 ≤ rows`
holds outright, so the drained board never tops out. -/
theorem isLevelPocketBandAt_fill_then_drain_height {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (p : Piece) :
    ∃ (s : ℕ → ℕ) (pl : Placement) (ps : List Placement),
      pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      (∀ q ∈ ps, q.piece = Piece.I ∧ q.Valid GameConfig.standard) ∧
      IsLevelPocketBandAt GameConfig.standard 2 (base % 4)
        (List.foldl (Placement.applyStep GameConfig.standard)
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ps) ∧
      (∀ j, colHeight
        (List.foldl (Placement.applyStep GameConfig.standard)
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ps) j
          ≤ base % 4 + 2) ∧
      ¬ Board.isLost GameConfig.standard (skyline GameConfig.standard s) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ∧
      (∀ k, ¬ Board.isLost GameConfig.standard
        (List.foldl (Placement.applyStep GameConfig.standard)
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl)
          (ps.take k))) := by
  obtain ⟨s, pl, ps, hpiece, hvalid, hall, hdrain, hinput, hfillsafe, hsafe⟩ :=
    isLevelPocketBandAt_fill_then_drain_full hslack p
  exact ⟨s, pl, ps, hpiece, hvalid, hall, hdrain,
    fun j => colHeight_le_of_isLevelPocketBandAt hdrain j, hinput, hfillsafe, hsafe⟩

/-- **Carrier-vocabulary absorb-then-drain half-cycle endpoint.** The carrier lift of
`isLevelPocketBandAt_fill_then_drain`: for EVERY piece `p` there is a canonical input surface
`skyline s`, a VALID placement `pl` of `p`, and an `I`-drain sequence `ps` whose endpoint is an
`IsPocketBandCarrier` board — and every board the regulator touches (the post-fill landing and
each prefix of the drain) is certified `¬ isLost`. The floor index `base % 4` of the drained band
is forgotten into the carrier existential `⟨2, base % 4, hband⟩`, so the conclusion speaks the same
floor-agnostic vocabulary as the cheap carrier faces. This is the half-cycle a phase-indexed σ
chains across a bag: absorb the drawn piece, drain back to a carrier member, with no blind boards
in between. What it still does NOT give (open core of #66) is closure — the endpoint carrier is a
spread-2 band at floor `base % 4`, not necessarily a canonical-input shape, so the NEXT bag cannot
re-enter through `skyline s` without a floor-raising re-entry step. -/
theorem isPocketBandCarrier_fill_then_drain {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (p : Piece) :
    ∃ (s : ℕ → ℕ) (pl : Placement) (ps : List Placement),
      pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      (∀ q ∈ ps, q.piece = Piece.I ∧ q.Valid GameConfig.standard) ∧
      IsPocketBandCarrier
        (List.foldl (Placement.applyStep GameConfig.standard)
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ps) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ∧
      (∀ k, ¬ Board.isLost GameConfig.standard
        (List.foldl (Placement.applyStep GameConfig.standard)
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl)
          (ps.take k))) := by
  obtain ⟨s, pl, ps, hpiece, hvalid, hall, hband, hfillsafe, hsafe⟩ :=
    isLevelPocketBandAt_fill_then_drain hslack p
  exact ⟨s, pl, ps, hpiece, hvalid, hall, ⟨2, base % 4, hband⟩, hfillsafe, hsafe⟩

/-- **Constant-height carrier endpoint of the absorb-then-drain half-cycle.** The boundedness
strengthening of `isPocketBandCarrier_fill_then_drain`: the same carrier endpoint additionally
satisfies the CONSTANT per-column cap `colHeight ≤ 5`, independent of how tall the input band
`base` was. The cap is read off the drained spread-2 band at floor `base % 4`
(`colHeight ≤ base % 4 + 2`) together with `base % 4 < 4`, so `base % 4 + 2 ≤ 5` outright. This is
the bounded-height mechanism a forever-strategy needs in carrier vocabulary: whatever piece the
adversary draws and however tall the surface grew, the `I`-regulator collapses the drained endpoint
back under height 5, a fixed ceiling far below the 20-row top-out — and every intermediate board
(post-fill landing and each drain prefix) is certified `¬ isLost`. -/
theorem isPocketBandCarrier_fill_then_drain_bounded {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (p : Piece) :
    ∃ (s : ℕ → ℕ) (pl : Placement) (ps : List Placement),
      pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      (∀ q ∈ ps, q.piece = Piece.I ∧ q.Valid GameConfig.standard) ∧
      IsPocketBandCarrier
        (List.foldl (Placement.applyStep GameConfig.standard)
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ps) ∧
      (∀ j, colHeight
        (List.foldl (Placement.applyStep GameConfig.standard)
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ps) j ≤ 5) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ∧
      (∀ k, ¬ Board.isLost GameConfig.standard
        (List.foldl (Placement.applyStep GameConfig.standard)
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl)
          (ps.take k))) := by
  obtain ⟨s, pl, ps, hpiece, hvalid, hall, hband, hcap, _hinput, hfillsafe, hsafe⟩ :=
    isLevelPocketBandAt_fill_then_drain_height hslack p
  refine ⟨s, pl, ps, hpiece, hvalid, hall, ⟨2, base % 4, hband⟩, ?_, hfillsafe, hsafe⟩
  intro j
  have h4 : base % 4 < 4 := Nat.mod_lt _ (by norm_num)
  have hj := hcap j
  omega

/-- **Spread-bounded carrier endpoint of the absorb-then-drain half-cycle.** The spread-pinned
strengthening of `isPocketBandCarrier_fill_then_drain`: the same canonical-input surface, valid
placement of `p`, and `I`-drain land not merely in *some* pocket-band carrier but in the BUDGETED
carrier at spread exactly `2` — the drained band is a spread-2 level pocket band at floor `base % 4`
(`isLevelPocketBandAt_fill_then_drain`), so only the floor is forgotten (`⟨base % 4, hband⟩`) while the
spread stays pinned. This is the height-accounting fact the bag cycle turns on: a full bag's worth of
`+4` bumps would overflow the 20-row board (the column-budget obstruction), but the regulator's drain
collapses the surface back to a spread-2 band every half-cycle, so the spread NEVER accumulates. Via
`isPocketBandCarrier_of_isBoundedPocketBandCarrier` this refines `isPocketBandCarrier_fill_then_drain`,
and every intermediate board (the post-fill landing, each drain prefix) is still certified `¬ isLost`. -/
theorem isBoundedPocketBandCarrier_fill_then_drain {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (p : Piece) :
    ∃ (s : ℕ → ℕ) (pl : Placement) (ps : List Placement),
      pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      (∀ q ∈ ps, q.piece = Piece.I ∧ q.Valid GameConfig.standard) ∧
      IsBoundedPocketBandCarrier 2
        (List.foldl (Placement.applyStep GameConfig.standard)
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ps) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ∧
      (∀ k, ¬ Board.isLost GameConfig.standard
        (List.foldl (Placement.applyStep GameConfig.standard)
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl)
          (ps.take k))) := by
  obtain ⟨s, pl, ps, hpiece, hvalid, hall, hband, hfillsafe, hsafe⟩ :=
    isLevelPocketBandAt_fill_then_drain hslack p
  exact ⟨s, pl, ps, hpiece, hvalid, hall, ⟨base % 4, hband⟩, hfillsafe, hsafe⟩

/-- **Constant-height spread-bounded carrier endpoint of the half-cycle.** The fusion of the two
prior strengthenings: the absorb-then-drain endpoint is BOTH a budgeted carrier at spread exactly `2`
(`isBoundedPocketBandCarrier_fill_then_drain`) AND height-capped by the constant `5`
(`isPocketBandCarrier_fill_then_drain_bounded`), simultaneously, in one witness. The drained band is a
spread-2 level pocket band at floor `base % 4`, so the per-column cap reads `colHeight ≤ base % 4 + 2`,
and `base % 4 < 4` collapses it to the absolute `≤ 5` — independent of how tall the input `base` was.
This is the complete fixed-ceiling certificate the bag cycle needs in budgeted vocabulary: whatever
piece is drawn and however tall the surface grew, the `I`-regulator returns it to a spread-2 band whose
every column sits below height 5, a constant gap beneath the 20-row top-out, with every intermediate
board certified `¬ isLost`. The two pinned quantities — spread `2` and ceiling `5` — are exactly the
state a phase-indexed σ must re-establish at each bag boundary. -/
theorem isBoundedPocketBandCarrier_fill_then_drain_bounded {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (p : Piece) :
    ∃ (s : ℕ → ℕ) (pl : Placement) (ps : List Placement),
      pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      (∀ q ∈ ps, q.piece = Piece.I ∧ q.Valid GameConfig.standard) ∧
      IsBoundedPocketBandCarrier 2
        (List.foldl (Placement.applyStep GameConfig.standard)
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ps) ∧
      (∀ j, colHeight
        (List.foldl (Placement.applyStep GameConfig.standard)
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ps) j ≤ 5) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ∧
      (∀ k, ¬ Board.isLost GameConfig.standard
        (List.foldl (Placement.applyStep GameConfig.standard)
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl)
          (ps.take k))) := by
  obtain ⟨s, pl, ps, hpiece, hvalid, hall, hband, hcap, _hinput, hfillsafe, hsafe⟩ :=
    isLevelPocketBandAt_fill_then_drain_height hslack p
  refine ⟨s, pl, ps, hpiece, hvalid, hall, ⟨base % 4, hband⟩, ?_, hfillsafe, hsafe⟩
  intro j
  have h4 : base % 4 < 4 := Nat.mod_lt _ (by norm_num)
  have hj := hcap j
  omega

/-- **Scalar-potential constant-ceiling endpoint of the canonical half-cycle.** The single-scalar
companion to `isBoundedPocketBandCarrier_fill_then_drain_bounded`, and the canonical-input twin of
`isBoundedPocketBandCarrier_of_vertI_drain_maxColHeight` (which resets an arbitrary member). For every
piece `p`, the canonical absorb-then-drain half-cycle — answer `p` on a tailored canonical surface, then
run the `I`-regulator — lands in `IsBoundedPocketBandCarrier 2` with the *scalar potential*
`maxColHeight ≤ 5`, every drain placement a valid `I`, the post-fill board and every drain prefix
un-lost. Where the `_bounded` face states the post-cycle ceiling per column (`∀ j, colHeight ≤ 5`), this
collapses that family into the one supremum the potential route reads (`Finset.sup_le` over the
per-column `≤ 5`), feedable straight into `not_isLost_of_maxColHeight_le` with a constant gap of `15`
beneath the 20-row top-out — independent of how tall the input `base` was. This is the scalar fixed-ceiling
certificate a phase-indexed σ re-establishes at each bag boundary in single-scalar vocabulary: whatever
piece the bag draws, after the canonical answer-and-regulate the surface potential sits below `5`. -/
theorem isBoundedPocketBandCarrier_fill_then_drain_maxColHeight {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (p : Piece) :
    ∃ (s : ℕ → ℕ) (pl : Placement) (ps : List Placement),
      pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      (∀ q ∈ ps, q.piece = Piece.I ∧ q.Valid GameConfig.standard) ∧
      IsBoundedPocketBandCarrier 2
        (List.foldl (Placement.applyStep GameConfig.standard)
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ps) ∧
      maxColHeight GameConfig.standard
        (List.foldl (Placement.applyStep GameConfig.standard)
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ps) ≤ 5 ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ∧
      (∀ k, ¬ Board.isLost GameConfig.standard
        (List.foldl (Placement.applyStep GameConfig.standard)
          (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl)
          (ps.take k))) := by
  obtain ⟨s, pl, ps, hpiece, hvalid, hall, hband, hcap, hfillsafe, hsafe⟩ :=
    isBoundedPocketBandCarrier_fill_then_drain_bounded hslack p
  refine ⟨s, pl, ps, hpiece, hvalid, hall, hband, ?_, hfillsafe, hsafe⟩
  unfold maxColHeight
  apply Finset.sup_le
  intro j _
  exact hcap j

/-- **All-7 canonical pocket regeneration (uniform per-piece existence).** The consolidation
that closes the per-piece pocket-regeneration menu (ABLK through ABLR) into one uniform
statement: for EVERY piece `p` there exists a canonical input surface `s` and a VALID placement
`pl` of `p` such that dropping `p` on `skyline s` lands back in a spread-2 level pocket band.
The five flat-shelf pieces `{O, I, T, L, J}` regenerate from the standard flat top
(`isLevelPocketBand_flatShelf_lands_standard`); the two staircase pieces seat on their tailored
notch — `S` on the col-3 bump (`isLevelPocketBand_S_notched_standard`), `Z` on the col-1 bump
(`isLevelPocketBand_Z_notched_standard`). The surface is existentially bound BECAUSE it is
piece-dependent — no single fixed top hosts all seven, the precise obstruction the bag-phase
strategy is forced to track (a notch must be carried while `S`/`Z` are still owed). This is the
uniform `∃ surface` brick a phase-indexed σ consumes to answer the drawn piece: whatever the
adversary hands, the player has a canonical surface from which that piece rebuilds the pocket. -/
theorem isLevelPocketBand_canonical_lands_all7 {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (p : Piece) :
    ∃ (s : ℕ → ℕ) (pl : Placement), pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      IsLevelPocketBand GameConfig.standard 2
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) := by
  cases p with
  | O =>
      obtain ⟨pl, hpiece, hvalid, hband⟩ :=
        isLevelPocketBand_flatShelf_lands_standard hslack (Or.inl rfl)
      exact ⟨_, pl, hpiece, hvalid, hband⟩
  | I =>
      obtain ⟨pl, hpiece, hvalid, hband⟩ :=
        isLevelPocketBand_flatShelf_lands_standard hslack
          (Or.inr (Or.inr (Or.inr (Or.inr rfl))))
      exact ⟨_, pl, hpiece, hvalid, hband⟩
  | S =>
      exact ⟨_, { piece := Piece.S, rot := 0, col := 1 }, rfl, by decide,
        isLevelPocketBand_S_notched_standard hslack⟩
  | Z =>
      exact ⟨_, { piece := Piece.Z, rot := 0, col := 1 }, rfl, by decide,
        isLevelPocketBand_Z_notched_standard hslack⟩
  | T =>
      obtain ⟨pl, hpiece, hvalid, hband⟩ :=
        isLevelPocketBand_flatShelf_lands_standard hslack (Or.inr (Or.inl rfl))
      exact ⟨_, pl, hpiece, hvalid, hband⟩
  | L =>
      obtain ⟨pl, hpiece, hvalid, hband⟩ :=
        isLevelPocketBand_flatShelf_lands_standard hslack
          (Or.inr (Or.inr (Or.inl rfl)))
      exact ⟨_, pl, hpiece, hvalid, hband⟩
  | J =>
      obtain ⟨pl, hpiece, hvalid, hband⟩ :=
        isLevelPocketBand_flatShelf_lands_standard hslack
          (Or.inr (Or.inr (Or.inr (Or.inl rfl))))
      exact ⟨_, pl, hpiece, hvalid, hband⟩

/-- **Survival face of the all-7 canonical pocket regeneration.** The `not_isLost`
strengthening of `isLevelPocketBand_canonical_lands_all7`: for EVERY piece `p` the canonical
surface `s` and VALID placement `pl` not only land back in a spread-2 level pocket band, that
landing board is certified *not lost*. The survival conjunct is read straight off the band:
forgetting the pocket gives a spread-2 reserved-well skyline
(`isSpreadBoundedRWSkyline_of_isLevelPocketBand`), whose ceiling cap rules out a top-out
(`not_isLost_of_isSpreadBoundedRWSkyline`). This is the uniform *answer-and-survive* certificate
a strategy's per-move non-loss bookkeeping consumes: whatever piece the adversary draws, the
player has a canonical surface from which that piece both rebuilds the pocket AND keeps the game
alive — the survival face of the bag-phase σ's per-piece dispatch. -/
theorem isLevelPocketBand_canonical_lands_all7_not_isLost {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (p : Piece) :
    ∃ (s : ℕ → ℕ) (pl : Placement), pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      IsLevelPocketBand GameConfig.standard 2
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard s) pl) := by
  obtain ⟨s, pl, hpiece, hvalid, hband⟩ := isLevelPocketBand_canonical_lands_all7 hslack p
  exact ⟨s, pl, hpiece, hvalid, hband,
    not_isLost_of_isSpreadBoundedRWSkyline (isSpreadBoundedRWSkyline_of_isLevelPocketBand hband)⟩

/-- **Band-carrier landing-site existence: a flat top admits an O placement into a
spread-2 band.** The band-carrier analogue of `isFlatTopRWSkyline_O_lands`: instead of
forgetting down to a bare reserved well, it records the quantitative spread. With at least
four columns the disjoint pairs `{0,1}` and `{2,3}` cannot both contain the well `w`, so one
is a level non-well pair; dropping an O there (`isSpreadBoundedRWSkyline_O_of_isFlatTop`) lands
flush in the band `[base, base+2]`. This is the first existence lemma on the band track — it
discharges the `∃ pl` shape a band-phase hstep consumes for the O draw out of the flat
(spread-0) entry, the base case a well clear re-enters. -/
theorem isSpreadBoundedRWSkyline_O_lands_of_isFlatTop {cfg : GameConfig} {base w : ℕ}
    (hw : w < cfg.cols) (h4 : 4 ≤ cfg.cols) (hslack : base + 2 ≤ cfg.rows) :
    ∃ c, IsSpreadBoundedRWSkyline cfg 2
      (Placement.applyStep cfg (skyline cfg (fun j => if j = w then 0 else base))
        { piece := Piece.O, rot := 0, col := c }) := by
  obtain ⟨c, hc1, hwc, hwc1⟩ : ∃ c, c + 1 < cfg.cols ∧ w ≠ c ∧ w ≠ c + 1 := by
    rcases Nat.lt_or_ge w 2 with hlt | hge
    · exact ⟨2, by omega, by omega, by omega⟩
    · exact ⟨0, by omega, by omega, by omega⟩
  have hc : c < cfg.cols := by omega
  exact ⟨c, isSpreadBoundedRWSkyline_O_of_isFlatTop hc hc1 hw hwc hwc1 hslack⟩

/-- **General O closure for the band carrier: a no-clear O on a spread-`s` band
lands in a spread-`s+2` band.** This is the genuine inductive step generalising
`isSpreadBoundedRWSkyline_O_of_isFlatTop` away from the flat (spread-0) base case:
starting from any band `[floor, floor+spread]` off the reserved well, dropping an O
onto a level adjacent pair `(c, c+1)` (`heq : h c = h (c+1)`, the only way O
no-clears) raises both columns by two to `h c + 2 ≤ floor+spread+2`, while the
remaining columns stay in `[floor, floor+spread]`. The whole surface therefore sits
in `[floor, floor+(spread+2)]`, so the carrier absorbs the move with its spread
budget growing by exactly two. Companion to `isReservedWellSkyline_applyStep_O`,
but tracking the quantitative band width the reserved-well carrier discards. -/
theorem isSpreadBoundedRWSkyline_O_of_isSpreadBounded {cfg : GameConfig} {spread : ℕ}
    {h : ℕ → ℕ} {floor w c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols)
    (hw : w < cfg.cols) (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hw0 : h w = 0)
    (heq : h c = h (c + 1))
    (hband : ∀ j < cfg.cols, j ≠ w → floor ≤ h j ∧ h j ≤ floor + spread)
    (hslack : floor + spread + 2 ≤ cfg.rows) :
    IsSpreadBoundedRWSkyline cfg (spread + 2)
      (Placement.applyStep cfg (skyline cfg h)
        { piece := Piece.O, rot := 0, col := c }) := by
  obtain ⟨hclo, hchi⟩ := hband c hc (Ne.symm hwc)
  rw [applyStep_O_skyline_noclear hc hc1 heq hw hwc hwc1 hw0]
  refine ⟨Function.update (Function.update h c (h c + 2)) (c + 1) (h c + 2), floor, w,
    rfl, hw, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne hwc1, Function.update_of_ne hwc]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (c + 1) with rfl | hjc1'
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjc1']
      rcases eq_or_ne j c with rfl | hjc'
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hjc']
        obtain ⟨hjlo, hjhi⟩ := hband j hj hjw
        omega
  · omega

/-- **Spread-preserving valley fill: an O dropped into a floor-level pocket keeps the
band width fixed.** The brick that breaks the spread-growth obstruction. The generic
`isSpreadBoundedRWSkyline_O_of_isSpreadBounded` grows the band by `+2` per O because it
lets the landing pair rise *above* the band ceiling `floor+spread`. But when the level
pair `(c, c+1)` already sits at the band **floor** (`hcfloor : h c = floor`) and the band
is at least two deep (`hspread : 2 ≤ spread`), the O lands at `floor + 2 ≤ floor + spread`
— strictly *inside* the existing band — so the spread budget is unchanged. This is the
valley-filling move the obstruction analysis (6·`+2` placement growth vs. only the
`−4` well-clear floor drop) showed must exist for the band carrier to close: pieces
absorbed into pockets cost *zero* spread, so a surface that keeps its low columns filled
never widens. The quantitative converse of the `+2` O closure, and the first member of
the spread-*non-increasing* family the closure argument ultimately schedules. -/
theorem isSpreadBoundedRWSkyline_O_valley_of_isSpreadBounded {cfg : GameConfig} {spread : ℕ}
    {h : ℕ → ℕ} {floor w c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols)
    (hw : w < cfg.cols) (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hw0 : h w = 0)
    (heq : h c = h (c + 1)) (hcfloor : h c = floor) (hspread : 2 ≤ spread)
    (hband : ∀ j < cfg.cols, j ≠ w → floor ≤ h j ∧ h j ≤ floor + spread)
    (hslack : floor + spread ≤ cfg.rows) :
    IsSpreadBoundedRWSkyline cfg spread
      (Placement.applyStep cfg (skyline cfg h)
        { piece := Piece.O, rot := 0, col := c }) := by
  rw [applyStep_O_skyline_noclear hc hc1 heq hw hwc hwc1 hw0]
  refine ⟨Function.update (Function.update h c (h c + 2)) (c + 1) (h c + 2), floor, w,
    rfl, hw, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne hwc1, Function.update_of_ne hwc]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (c + 1) with rfl | hjc1'
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjc1']
      rcases eq_or_ne j c with rfl | hjc'
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hjc']
        obtain ⟨hjlo, hjhi⟩ := hband j hj hjw
        omega
  · exact hslack

/-- **Horizontal-I closure for the band carrier: a no-clear flat-quad I on a
spread-`s` band lands in a spread-`s+1` band.** The cheapest band-roughening move:
laid across four level adjacent non-well columns `(c, c+1, c+2, c+3)`
(`heqᵢ : h (c+i) = h c`), the horizontal-I raises each by exactly one to `h c + 1`,
so the worst case rises only to `floor + spread + 1`, while every other column stays
in `[floor, floor+spread]`. The spread budget therefore grows by just `1` — half the
`O` cost — making horizontal-I the band carrier's most economical filler. The 4-fold
analogue of `isSpreadBoundedRWSkyline_O_of_isSpreadBounded`. -/
theorem isSpreadBoundedRWSkyline_horizI_of_isSpreadBounded {cfg : GameConfig}
    {spread : ℕ} {h : ℕ → ℕ} {floor w c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (hc3 : c + 3 < cfg.cols)
    (hw : w < cfg.cols) (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2)
    (hwc3 : w ≠ c + 3) (hw0 : h w = 0)
    (heq1 : h (c + 1) = h c) (heq2 : h (c + 2) = h c) (heq3 : h (c + 3) = h c)
    (hband : ∀ j < cfg.cols, j ≠ w → floor ≤ h j ∧ h j ≤ floor + spread)
    (hslack : floor + spread + 1 ≤ cfg.rows) :
    IsSpreadBoundedRWSkyline cfg (spread + 1)
      (Placement.applyStep cfg (skyline cfg h)
        { piece := Piece.I, rot := 0, col := c }) := by
  obtain ⟨hclo, hchi⟩ := hband c hc (Ne.symm hwc)
  rw [applyStep_horizI_skyline_noclear hc hc1 hc2 hc3 heq1 heq2 heq3
    hw hwc hwc1 hwc2 hwc3 hw0]
  refine ⟨Function.update (Function.update (Function.update
      (Function.update h c (h c + 1)) (c + 1) (h c + 1)) (c + 2) (h c + 1))
      (c + 3) (h c + 1), floor, w, rfl, hw, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne hwc3, Function.update_of_ne hwc2,
        Function.update_of_ne hwc1, Function.update_of_ne hwc]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (c + 3) with rfl | hjc3'
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjc3']
      rcases eq_or_ne j (c + 2) with rfl | hjc2'
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hjc2']
        rcases eq_or_ne j (c + 1) with rfl | hjc1'
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hjc1']
          rcases eq_or_ne j c with rfl | hjc'
          · rw [Function.update_self]; omega
          · rw [Function.update_of_ne hjc']
            obtain ⟨hjlo, hjhi⟩ := hband j hj hjw
            omega
  · omega

/-- **Band-carrier landing-site existence: a flat top admits a horizontal-I placement
into a spread-1 band.** Disjoint-QUAD pigeonhole (the four-wide analogue of the
triple used for T, L, J): with `8 ≤ cfg.cols` a level four-shelf `(c, c+1, c+2, c+3)`
away from the reserved well always exists. Recognising the flat top as a spread-0
band, the general horizontal-I closure (`isSpreadBoundedRWSkyline_horizI_of_isSpreadBounded`)
raises all four columns by one, landing in `[base, base+1]` — so the existential
target is `IsSpreadBoundedRWSkyline cfg 1` (NOT 2), since a flat I grows the band by
only one. Fifth and final flat-shelf band-existence brick; S and Z still need the
notched entry. -/
theorem isSpreadBoundedRWSkyline_horizI_lands_of_isFlatTop {cfg : GameConfig} {base w : ℕ}
    (hw : w < cfg.cols) (h8 : 8 ≤ cfg.cols) (hslack : base + 1 ≤ cfg.rows) :
    ∃ c, IsSpreadBoundedRWSkyline cfg 1
      (Placement.applyStep cfg (skyline cfg (fun j => if j = w then 0 else base))
        { piece := Piece.I, rot := 0, col := c }) := by
  obtain ⟨c, hc3, hwc, hwc1, hwc2, hwc3⟩ :
      ∃ c, c + 3 < cfg.cols ∧ w ≠ c ∧ w ≠ c + 1 ∧ w ≠ c + 2 ∧ w ≠ c + 3 := by
    rcases Nat.lt_or_ge w 4 with hlt | hge
    · exact ⟨4, by omega, by omega, by omega, by omega, by omega⟩
    · exact ⟨0, by omega, by omega, by omega, by omega, by omega⟩
  have hc : c < cfg.cols := by omega
  have hc1 : c + 1 < cfg.cols := by omega
  have hc2 : c + 2 < cfg.cols := by omega
  set h : ℕ → ℕ := fun j => if j = w then 0 else base with hh
  have hw0 : h w = 0 := by rw [hh]; simp
  have hbase : h c = base := by rw [hh]; simp only [if_neg (Ne.symm hwc)]
  have hbase1 : h (c + 1) = base := by rw [hh]; simp only [if_neg (Ne.symm hwc1)]
  have hbase2 : h (c + 2) = base := by rw [hh]; simp only [if_neg (Ne.symm hwc2)]
  have hbase3 : h (c + 3) = base := by rw [hh]; simp only [if_neg (Ne.symm hwc3)]
  have heq1 : h (c + 1) = h c := by rw [hbase1, hbase]
  have heq2 : h (c + 2) = h c := by rw [hbase2, hbase]
  have heq3 : h (c + 3) = h c := by rw [hbase3, hbase]
  have hband : ∀ j < cfg.cols, j ≠ w → base ≤ h j ∧ h j ≤ base + 0 := by
    intro j hj hjw
    have hjb : h j = base := by rw [hh]; simp only [if_neg hjw]
    omega
  exact ⟨c, isSpreadBoundedRWSkyline_horizI_of_isSpreadBounded hc hc1 hc2 hc3 hw hwc hwc1 hwc2
    hwc3 hw0 heq1 heq2 heq3 hband (by omega)⟩

/-- **Spread-preserving valley fill, horizontal-I: a flat quad dropped into a
floor-level trench keeps the band width fixed.** The cheapest member of the
spread-*non-increasing* family (companion to `isSpreadBoundedRWSkyline_O_valley_of_isSpreadBounded`):
when the level quad `(c, c+1, c+2, c+3)` already sits at the band **floor**
(`hcfloor : h c = floor`) and the band is at least one deep (`hspread : 1 ≤ spread`),
the horizontal-I raises all four columns by one to `floor + 1 ≤ floor + spread` —
inside the existing band — so the spread budget is unchanged. Because horizI rises by
only `1` (vs. the O's `2`), it absorbs into a *unit*-deep trench, needing merely
`spread ≥ 1`. This is the four-wide pocket fit the scheduling argument reaches for
first: a single flat I refills a whole floor trench at zero spread cost, the band
analogue of laying a brick flush into a four-wide gap. -/
theorem isSpreadBoundedRWSkyline_horizI_valley_of_isSpreadBounded {cfg : GameConfig}
    {spread : ℕ} {h : ℕ → ℕ} {floor w c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (hc3 : c + 3 < cfg.cols)
    (hw : w < cfg.cols) (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2)
    (hwc3 : w ≠ c + 3) (hw0 : h w = 0)
    (heq1 : h (c + 1) = h c) (heq2 : h (c + 2) = h c) (heq3 : h (c + 3) = h c)
    (hcfloor : h c = floor) (hspread : 1 ≤ spread)
    (hband : ∀ j < cfg.cols, j ≠ w → floor ≤ h j ∧ h j ≤ floor + spread)
    (hslack : floor + spread ≤ cfg.rows) :
    IsSpreadBoundedRWSkyline cfg spread
      (Placement.applyStep cfg (skyline cfg h)
        { piece := Piece.I, rot := 0, col := c }) := by
  rw [applyStep_horizI_skyline_noclear hc hc1 hc2 hc3 heq1 heq2 heq3
    hw hwc hwc1 hwc2 hwc3 hw0]
  refine ⟨Function.update (Function.update (Function.update
      (Function.update h c (h c + 1)) (c + 1) (h c + 1)) (c + 2) (h c + 1))
      (c + 3) (h c + 1), floor, w, rfl, hw, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne hwc3, Function.update_of_ne hwc2,
        Function.update_of_ne hwc1, Function.update_of_ne hwc]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (c + 3) with rfl | hjc3'
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjc3']
      rcases eq_or_ne j (c + 2) with rfl | hjc2'
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hjc2']
        rcases eq_or_ne j (c + 1) with rfl | hjc1'
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hjc1']
          rcases eq_or_ne j c with rfl | hjc'
          · rw [Function.update_self]; omega
          · rw [Function.update_of_ne hjc']
            obtain ⟨hjlo, hjhi⟩ := hband j hj hjw
            omega
  · exact hslack

/-- **T closure for the band carrier: a no-clear flat-shelf T on a spread-`s` band
lands in a spread-`s+2` band.** Seated (rotation 2) on a level triple
`(c, c+1, c+2)` (`heq1, heq2`) off the reserved well, the T raises the flanks by one
and the centre bump by two (`+1, +2, +1`), so every touched column stays at or below
`h c + 2 ≤ floor + spread + 2`, while the rest hold their `[floor, floor+spread]`
band. The spread budget grows by two — the centre-bump cost. Flat-triple analogue of
`isSpreadBoundedRWSkyline_O_of_isSpreadBounded`, the first of the T/L/J shelf-fillers
on the band carrier. -/
theorem isSpreadBoundedRWSkyline_T_of_isSpreadBounded {cfg : GameConfig} {spread : ℕ}
    {h : ℕ → ℕ} {floor w c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (hw : w < cfg.cols) (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2)
    (hw0 : h w = 0)
    (heq1 : h (c + 1) = h c) (heq2 : h (c + 2) = h c)
    (hband : ∀ j < cfg.cols, j ≠ w → floor ≤ h j ∧ h j ≤ floor + spread)
    (hslack : floor + spread + 2 ≤ cfg.rows) :
    IsSpreadBoundedRWSkyline cfg (spread + 2)
      (Placement.applyStep cfg (skyline cfg h)
        { piece := Piece.T, rot := 2, col := c }) := by
  obtain ⟨hclo, hchi⟩ := hband c hc (Ne.symm hwc)
  rw [applyStep_T_skyline_noclear hc hc1 hc2 heq1 heq2 hw hwc hwc1 hwc2 hw0]
  refine ⟨Function.update (Function.update (Function.update h c (h c + 1))
      (c + 1) (h c + 2)) (c + 2) (h c + 1), floor, w, rfl, hw, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne hwc2, Function.update_of_ne hwc1,
        Function.update_of_ne hwc]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (c + 2) with rfl | hjc2'
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjc2']
      rcases eq_or_ne j (c + 1) with rfl | hjc1'
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hjc1']
        rcases eq_or_ne j c with rfl | hjc'
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hjc']
          obtain ⟨hjlo, hjhi⟩ := hband j hj hjw
          omega
  · omega

/-- **Band-carrier landing-site existence: a flat top admits a T placement into a
spread-2 band.** The T analogue of `isSpreadBoundedRWSkyline_O_lands_of_isFlatTop`, scaling the
disjoint-blocks pigeonhole from pairs to triples: with at least six columns the disjoint triples
`{0,1,2}` and `{3,4,5}` cannot both contain the well `w`, so one is a level three-shelf away from
`w`. Recognising the flat top as a spread-0 band, the general T closure
(`isSpreadBoundedRWSkyline_T_of_isSpreadBounded`) seats a T there into the band `[base, base+2]`.
Second existence brick on the band track. -/
theorem isSpreadBoundedRWSkyline_T_lands_of_isFlatTop {cfg : GameConfig} {base w : ℕ}
    (hw : w < cfg.cols) (h6 : 6 ≤ cfg.cols) (hslack : base + 2 ≤ cfg.rows) :
    ∃ c, IsSpreadBoundedRWSkyline cfg 2
      (Placement.applyStep cfg (skyline cfg (fun j => if j = w then 0 else base))
        { piece := Piece.T, rot := 2, col := c }) := by
  obtain ⟨c, hc2, hwc, hwc1, hwc2⟩ :
      ∃ c, c + 2 < cfg.cols ∧ w ≠ c ∧ w ≠ c + 1 ∧ w ≠ c + 2 := by
    rcases Nat.lt_or_ge w 3 with hlt | hge
    · exact ⟨3, by omega, by omega, by omega, by omega⟩
    · exact ⟨0, by omega, by omega, by omega, by omega⟩
  have hc : c < cfg.cols := by omega
  have hc1 : c + 1 < cfg.cols := by omega
  set h : ℕ → ℕ := fun j => if j = w then 0 else base with hh
  have hw0 : h w = 0 := by rw [hh]; simp
  have hbase : h c = base := by rw [hh]; simp only [if_neg (Ne.symm hwc)]
  have hbase1 : h (c + 1) = base := by rw [hh]; simp only [if_neg (Ne.symm hwc1)]
  have hbase2 : h (c + 2) = base := by rw [hh]; simp only [if_neg (Ne.symm hwc2)]
  have heq1 : h (c + 1) = h c := by rw [hbase1, hbase]
  have heq2 : h (c + 2) = h c := by rw [hbase2, hbase]
  have hband : ∀ j < cfg.cols, j ≠ w → base ≤ h j ∧ h j ≤ base + 0 := by
    intro j hj hjw
    have hjb : h j = base := by rw [hh]; simp only [if_neg hjw]
    omega
  exact ⟨c, isSpreadBoundedRWSkyline_T_of_isSpreadBounded hc hc1 hc2 hw hwc hwc1 hwc2 hw0
    heq1 heq2 hband (by omega)⟩

/-- **Spread-preserving valley fill, T-shelf: a seated T dropped onto a floor-level
triple keeps the band width fixed.** The T member of the spread-*non-increasing*
family (companion to the O- and horizontal-I valley fits): when the level triple
`(c, c+1, c+2)` sits at the band **floor** (`hcfloor : h c = floor`) and the band is at
least two deep (`hspread : 2 ≤ spread`), the seated T raises the flanks to `floor + 1`
and the centre bump to `floor + 2 ≤ floor + spread` — all inside the existing band — so
the spread budget is unchanged. The centre's `+2` is what forces `spread ≥ 2` (same depth
the O valley fit needs); the flanks ride for free at `+1`. A T thus refills a three-wide
floor shelf at zero spread cost, completing the unit- and double-depth pocket fits for
the three flat-shelf pieces that rise by at most two. -/
theorem isSpreadBoundedRWSkyline_T_valley_of_isSpreadBounded {cfg : GameConfig} {spread : ℕ}
    {h : ℕ → ℕ} {floor w c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (hw : w < cfg.cols) (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2)
    (hw0 : h w = 0)
    (heq1 : h (c + 1) = h c) (heq2 : h (c + 2) = h c)
    (hcfloor : h c = floor) (hspread : 2 ≤ spread)
    (hband : ∀ j < cfg.cols, j ≠ w → floor ≤ h j ∧ h j ≤ floor + spread)
    (hslack : floor + spread ≤ cfg.rows) :
    IsSpreadBoundedRWSkyline cfg spread
      (Placement.applyStep cfg (skyline cfg h)
        { piece := Piece.T, rot := 2, col := c }) := by
  rw [applyStep_T_skyline_noclear hc hc1 hc2 heq1 heq2 hw hwc hwc1 hwc2 hw0]
  refine ⟨Function.update (Function.update (Function.update h c (h c + 1))
      (c + 1) (h c + 2)) (c + 2) (h c + 1), floor, w, rfl, hw, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne hwc2, Function.update_of_ne hwc1,
        Function.update_of_ne hwc]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (c + 2) with rfl | hjc2'
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjc2']
      rcases eq_or_ne j (c + 1) with rfl | hjc1'
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hjc1']
        rcases eq_or_ne j c with rfl | hjc'
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hjc']
          obtain ⟨hjlo, hjhi⟩ := hband j hj hjw
