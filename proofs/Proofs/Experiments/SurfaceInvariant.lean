    intro j hj hjw
    have hjb : h j = base := by rw [hh]; simp only [if_neg hjw]
    omega
  exact ⟨c, isSpreadBoundedRWSkyline_L_of_isSpreadBounded hc hc1 hc2 hw hwc hwc1 hwc2 hw0
