import Proofs.SafeSet
import Proofs.Theorems.Holes
import Proofs.Theorems.PieceGeometry

/-!
# Surface invariant: the skyline abstraction (positive direction)

This file begins the **positive** programme — proving Tetris *is* solvable by
exhibiting a closed adversarial invariant — at the level of *surface profiles*.

The invariant-spec theorems (`tetrisSolvableValid_of_invariant`,
`tetrisSolvableValid_of_height_bounded_invariant` in `SafeSet.lean`) reduce
solvability to producing one closed set `S` of game states. The cell-counting
argument shows flat-stacking is exactly break-even (7·4 = 28 cells/bag must be
cleared as 2.8 lines/bag), so survival reduces to *never accumulating permanent
holes*. The natural state of a hole-free stack is its **skyline**: the board in
which each column `j` is filled solidly from row `0` up to row `h j − 1`.

This file builds that abstraction and the bridge lemmas any surface argument
needs:

* `skyline cfg h` — the solid board for a column-height profile `h`;
* `mem_skyline` — its membership characterisation;
* `colRows_skyline`, `colHeight_skyline` — a skyline's column geometry recovers
  the profile exactly (`colHeight (skyline h) j = h j` for `j < cols`);
* `holes_skyline` — a skyline is hole-free;
* `skyline_zero_eq_empty`, `init_board_eq_skyline` — `init` is the zero skyline;
* `not_isLost_skyline` — a height-bounded skyline is never lost.

The hard content (per-piece closure: placing a piece on a skyline yields another
skyline whose profile stays in the invariant) is built on top of this, piece by
piece.
-/

namespace Tetris
namespace Board

/-- The **skyline** board of a column-height profile `h`: across the first
`cfg.cols` columns, column `j` is filled solidly in rows `0 … h j − 1`. This is
the canonical hole-free board of a given surface profile. -/
def skyline (cfg : GameConfig) (h : ℕ → ℕ) : Board :=
  (Finset.range cfg.cols).biUnion
    (fun j => (Finset.range (h j)).image (fun r => (j, r)))

/-- Membership in a skyline: cell `(j, r)` is filled exactly when `j` is a real
column and `r` sits below the profile height there. -/
theorem mem_skyline (cfg : GameConfig) (h : ℕ → ℕ) (j r : ℕ) :
    (j, r) ∈ skyline cfg h ↔ j < cfg.cols ∧ r < h j := by
  unfold skyline
  simp only [Finset.mem_biUnion, Finset.mem_range, Finset.mem_image, Prod.mk.injEq]
  constructor
  · rintro ⟨i, hi, ρ, hρ, hij, hρr⟩
    subst hij; subst hρr; exact ⟨hi, hρ⟩
  · rintro ⟨hj, hr⟩
    exact ⟨j, hj, r, hr, rfl, rfl⟩

/-- Coordinate-form membership, convenient when the cell is not a literal pair. -/
theorem mem_skyline' (cfg : GameConfig) (h : ℕ → ℕ) (p : Coord) :
    p ∈ skyline cfg h ↔ p.1 < cfg.cols ∧ p.2 < h p.1 := by
  obtain ⟨j, r⟩ := p
  exact mem_skyline cfg h j r

/-- A real column of a skyline has exactly the profile's rows filled. -/
theorem colRows_skyline {cfg : GameConfig} {h : ℕ → ℕ} {j : ℕ} (hj : j < cfg.cols) :
    Board.colRows (skyline cfg h) j = Finset.range (h j) := by
  ext r
  unfold Board.colRows
  simp only [Finset.mem_image, Finset.mem_filter, Finset.mem_range]
  constructor
  · rintro ⟨p, ⟨hpmem, hpj⟩, hpr⟩
    have hmem2 := ((mem_skyline' cfg h p).mp hpmem).2
    rw [hpj, hpr] at hmem2
    exact hmem2
  · intro hr
    exact ⟨(j, r), ⟨(mem_skyline cfg h j r).mpr ⟨hj, hr⟩, rfl⟩, rfl⟩

/-- An out-of-range column of a skyline is empty. -/
theorem colRows_skyline_eq_empty {cfg : GameConfig} {h : ℕ → ℕ} {j : ℕ}
    (hj : cfg.cols ≤ j) : Board.colRows (skyline cfg h) j = ∅ := by
  ext r
  unfold Board.colRows
  simp only [Finset.mem_image, Finset.mem_filter, Finset.notMem_empty, iff_false, not_exists,
    not_and]
  rintro p ⟨hpmem, hpj⟩
  have hlt := ((mem_skyline' cfg h p).mp hpmem).1
  rw [hpj] at hlt
  omega

/-- The supremum identity behind a column's height: `range n` summed via `(·+1)`
recovers `n`. -/
private theorem sup_range_succ (n : ℕ) : (Finset.range n).sup (· + 1) = n := by
  cases n with
  | zero => simp
  | succ m =>
    refine le_antisymm (Finset.sup_le ?_) ?_
    · intro x hx
      rw [Finset.mem_range] at hx
      omega
    · exact Finset.le_sup (f := fun x => x + 1)
        (Finset.mem_range.mpr (Nat.lt_succ_self m))

/-- A skyline's column height recovers the profile exactly on real columns. -/
theorem colHeight_skyline {cfg : GameConfig} {h : ℕ → ℕ} {j : ℕ} (hj : j < cfg.cols) :
    Board.colHeight (skyline cfg h) j = h j := by
  unfold Board.colHeight
  rw [colRows_skyline hj]
  exact sup_range_succ (h j)

/-- A skyline's out-of-range columns have height `0`. -/
theorem colHeight_skyline_eq_zero {cfg : GameConfig} {h : ℕ → ℕ} {j : ℕ}
    (hj : cfg.cols ≤ j) : Board.colHeight (skyline cfg h) j = 0 := by
  unfold Board.colHeight
  rw [colRows_skyline_eq_empty hj]
  simp

/-- **Skyline congruence.** Two profiles that agree on every in-field column
`j < cfg.cols` produce the *same* board. A skyline only ever fills columns
below `cfg.cols`, so its out-of-field values are irrelevant; this lifts an
in-field profile equality (the post-clear reset of `foldl_clear_profile_eq_in_field`)
to a genuine board-level identity. -/
theorem skyline_congr {cfg : GameConfig} {g g' : ℕ → ℕ}
    (hcong : ∀ j, j < cfg.cols → g j = g' j) :
    skyline cfg g = skyline cfg g' := by
  ext p
  obtain ⟨j, r⟩ := p
  simp only [mem_skyline]
  constructor
  · rintro ⟨hj, hr⟩
    refine ⟨hj, ?_⟩
    rw [← hcong j hj]; exact hr
  · rintro ⟨hj, hr⟩
    refine ⟨hj, ?_⟩
    rw [hcong j hj]; exact hr

/-- The zero profile is the empty board. -/
theorem skyline_zero_eq_empty (cfg : GameConfig) :
    skyline cfg (fun _ => 0) = (∅ : Board) := by
  ext ⟨j, r⟩
  rw [mem_skyline]
  simp

/-- `init`'s board is the zero skyline, for any config. -/
theorem init_board_eq_skyline (cfg : GameConfig) :
    GameState.init.board = skyline cfg (fun _ => 0) := by
  rw [skyline_zero_eq_empty]
  rfl

/-- **A skyline is hole-free.** Every column's filled-cell count equals its
height (`range (h j)` has `h j` elements and the height is `h j`), so each
`colHoles` vanishes. This is what makes the skyline the canonical no-hole state:
the surface invariant lives entirely among skylines. -/
theorem holes_skyline (cfg : GameConfig) (h : ℕ → ℕ) :
    Board.holes cfg (skyline cfg h) = 0 := by
  rw [Board.holes_eq_zero_iff]
  intro j hj
  have hjc := Finset.mem_range.mp hj
  rw [Board.colHoles_eq_zero_iff, colRows_skyline hjc, colHeight_skyline hjc,
    Finset.card_range]

/-- **A skyline's filled-cell count is the sum of its column heights.** The
defining `biUnion` is over disjoint per-column blocks (distinct columns give
distinct first coordinates), and each block `(range (h j)).image (·, j)` has
exactly `h j` cells. This is the bridge from the geometric surface (`h`) to the
conserved quantity (cell count) — the foundation of every packing/pigeonhole
argument: a piece adds four cells, a line clear removes `cfg.cols`, and the total
governs whether a low landing column must exist. -/
theorem card_skyline {cfg : GameConfig} {h : ℕ → ℕ} :
    (skyline cfg h).card = ∑ j ∈ Finset.range cfg.cols, h j := by
  have hdisj : ∀ x ∈ Finset.range cfg.cols, ∀ y ∈ Finset.range cfg.cols, x ≠ y →
      Disjoint ((Finset.range (h x)).image (fun r => (x, r)))
        ((Finset.range (h y)).image (fun r => (y, r))) := by
    intro x _ y _ hxy
    rw [Finset.disjoint_left]
    rintro a ha hay
    rw [Finset.mem_image] at ha hay
    obtain ⟨r1, _, hr1⟩ := ha
    obtain ⟨r2, _, hr2⟩ := hay
    have hx1 : a.1 = x := by rw [← hr1]
    have hy1 : a.1 = y := by rw [← hr2]
    exact hxy (hx1.symm.trans hy1)
  unfold skyline
  rw [Finset.card_biUnion hdisj]
  refine Finset.sum_congr rfl ?_
  intro j _
  rw [Finset.card_image_of_injective _ (by intro a b hab; simpa using hab),
    Finset.card_range]

/-- **Averaging pigeonhole: a sum below `cols · k` forces a term below `k`.** If
the column heights over `range cols` sum to less than `cols * k`, some real column
has height `< k` — the minimum is at most the average. Proved by contradiction:
were every column `≥ k`, the sum would be `≥ cols * k`. The generic counting core
behind every "a low landing site exists" claim. -/
theorem exists_col_lt_of_sum_lt {cols k : ℕ} {h : ℕ → ℕ}
    (hsum : ∑ j ∈ Finset.range cols, h j < cols * k) :
    ∃ j < cols, h j < k := by
  by_contra hcon
  push_neg at hcon
  have hle : ∑ _j ∈ Finset.range cols, k ≤ ∑ j ∈ Finset.range cols, h j :=
    Finset.sum_le_sum (fun a ha => hcon a (Finset.mem_range.mp ha))
  rw [Finset.sum_const, Finset.card_range, smul_eq_mul] at hle
  omega

/-- **A skyline light enough has a short column.** Specialising the averaging
pigeonhole through `card_skyline`: if the board holds fewer than `cfg.cols * k`
filled cells, some real column has height `< k`. This is the packing brick that
lets a placement argument *select* a low landing column from a cell-count budget,
the bridge between the conserved cell total and the existence of safe headroom. -/
theorem exists_low_col_of_card_lt {cfg : GameConfig} {h : ℕ → ℕ} {k : ℕ}
    (hcard : (skyline cfg h).card < cfg.cols * k) :
    ∃ j < cfg.cols, h j < k := by
  rw [card_skyline] at hcard
  exact exists_col_lt_of_sum_lt hcard

/-- **The cell budget of an in-field skyline.** If every real column stays within
`cfg.rows`, the board holds at most `cfg.cols * cfg.rows` filled cells — the full
grid is the worst case. The conserved-quantity ceiling that bounds the potential:
combined with the `+4`-per-placement law, it pins how often line clears must fire
to keep the board in-field. -/
theorem card_skyline_le {cfg : GameConfig} {h : ℕ → ℕ}
    (hb : ∀ j < cfg.cols, h j ≤ cfg.rows) :
    (skyline cfg h).card ≤ cfg.cols * cfg.rows := by
  rw [card_skyline]
  calc ∑ j ∈ Finset.range cfg.cols, h j
      ≤ ∑ _j ∈ Finset.range cfg.cols, cfg.rows :=
        Finset.sum_le_sum (fun j hj => hb j (Finset.mem_range.mp hj))
    _ = cfg.cols * cfg.rows := by
        rw [Finset.sum_const, Finset.card_range, smul_eq_mul]

/-- A profile bounded by `cfg.rows` on real columns gives a skyline whose every
column height is `≤ cfg.rows` (out-of-range columns are empty). -/
theorem colHeight_skyline_le {cfg : GameConfig} {h : ℕ → ℕ}
    (hb : ∀ j < cfg.cols, h j ≤ cfg.rows) (j : ℕ) :
    Board.colHeight (skyline cfg h) j ≤ cfg.rows := by
  by_cases hj : j < cfg.cols
  · rw [colHeight_skyline hj]; exact hb j hj
  · rw [colHeight_skyline_eq_zero (Nat.le_of_not_lt hj)]; exact Nat.zero_le _

/-- **A height-bounded skyline is never lost.** Combines the skyline height
identity with `not_isLost_of_colHeight_le`: if the profile stays within the
field on every real column, no filled cell reaches row `cfg.rows`. This
discharges the `¬ lost` obligation for any skyline-based invariant. -/
theorem not_isLost_skyline {cfg : GameConfig} {h : ℕ → ℕ}
    (hb : ∀ j < cfg.cols, h j ≤ cfg.rows) :
    ¬ Board.isLost cfg (skyline cfg h) :=
  Board.not_isLost_of_colHeight_le (colHeight_skyline_le hb)

/-- **A constant-height block is never lost.** The flattest special case of
`not_isLost_skyline`: the uniform skyline at height `k ≤ cfg.rows` (every in-field
column filled to row `k`) sits inside the field. This is the topout-freedom of the
full bottom-`k` slab — exactly the pre-clear surface a well-clear momentarily passes
through (all columns level at the fill height) — so it certifies that the terminal
placement of a fill-then-clear cycle does not spill above the field whenever the
fill height stays within `cfg.rows`. -/
theorem not_isLost_skyline_const {cfg : GameConfig} {k : ℕ} (hk : k ≤ cfg.rows) :
    ¬ Board.isLost cfg (skyline cfg (fun _ => k)) :=
  not_isLost_skyline (fun _ _ => hk)

/-! ## Gravity on a skyline: line clears subtract the minimum profile

A skyline's full rows are exactly the contiguous bottom block — a row `r` is full
iff every real column rises above it, i.e. `r < h j` for all `j < cfg.cols`, which
(letting `m` be the minimum profile height over real columns) means `r < m`. So
clearing lines drops the whole stack by `m`: `clearLines (skyline h) = skyline
(h − m)`. This is the **height-bounding mechanism**: without it a bounded surface
invariant could never close, since a bare `place` only ever raises the profile.

The minimum is handled abstractly through two hypotheses — `hm` (it is a lower
bound on every real column) and `hm0` (it is achieved at some real column) — which
together pin `m` to the real-column minimum without needing `0 < cfg.cols`. -/

/-- A skyline's row `r` is full exactly when every real column rises above `r`. -/
theorem isFull_skyline {cfg : GameConfig} {h : ℕ → ℕ} {r : ℕ} :
    Board.isFull cfg (skyline cfg h) r ↔ ∀ j < cfg.cols, r < h j := by
  unfold Board.isFull
  constructor
  · intro hf j hj
    exact ((mem_skyline cfg h j r).mp (hf j (Finset.mem_range.mpr hj))).2
  · intro hf c hc
    exact (mem_skyline cfg h c r).mpr ⟨Finset.mem_range.mp hc, hf c (Finset.mem_range.mp hc)⟩

/-- With `m` the real-column minimum profile height, a skyline's full rows are
exactly rows `0 … m − 1`. -/
theorem isFull_skyline_iff_lt {cfg : GameConfig} {h : ℕ → ℕ} {m : ℕ}
    (hm : ∀ j < cfg.cols, m ≤ h j) (hm0 : ∃ j < cfg.cols, h j = m) (r : ℕ) :
    Board.isFull cfg (skyline cfg h) r ↔ r < m := by
  rw [isFull_skyline]
  constructor
  · intro hf; obtain ⟨j, hj, hjm⟩ := hm0; have := hf j hj; omega
  · intro hr j hj; have := hm j hj; omega

/-- The set of full rows of a skyline is `range m` (the contiguous bottom block). -/
theorem fullRows_skyline {cfg : GameConfig} {h : ℕ → ℕ} {m : ℕ}
    (hm : ∀ j < cfg.cols, m ≤ h j) (hm0 : ∃ j < cfg.cols, h j = m) :
    Board.fullRows cfg (skyline cfg h) = Finset.range m := by
  ext r
  unfold Board.fullRows
  rw [Finset.mem_filter, isFull_skyline_iff_lt hm hm0, Finset.mem_range]
  constructor
  · rintro ⟨_, hr⟩; exact hr
  · intro hr
    refine ⟨?_, hr⟩
    obtain ⟨j, hj, hjm⟩ := hm0
    exact Finset.mem_image.mpr ⟨(j, r), (mem_skyline cfg h j r).mpr ⟨hj, by omega⟩, rfl⟩

/-- Below row `r`, a skyline has `min m r` full rows cleared. -/
theorem clearedBelow_skyline {cfg : GameConfig} {h : ℕ → ℕ} {m : ℕ}
    (hm : ∀ j < cfg.cols, m ≤ h j) (hm0 : ∃ j < cfg.cols, h j = m) (r : ℕ) :
    Board.clearedBelow cfg (skyline cfg h) r = min m r := by
  unfold Board.clearedBelow
  rw [fullRows_skyline hm hm0]
  have : (Finset.range m).filter (· < r) = Finset.range (min m r) := by
    ext x; simp only [Finset.mem_filter, Finset.mem_range, lt_min_iff]
  rw [this, Finset.card_range]

/-- **Gravity on a skyline.** Clearing lines subtracts the minimum real-column
profile height `m` from every column: `clearLines (skyline h) = skyline (h − m)`.
This is the surface-invariant height-bounding step. -/
theorem clearLines_skyline {cfg : GameConfig} {h : ℕ → ℕ} {m : ℕ}
    (hm : ∀ j < cfg.cols, m ≤ h j) (hm0 : ∃ j < cfg.cols, h j = m) :
    Board.clearLines cfg (skyline cfg h) = skyline cfg (fun j => h j - m) := by
  unfold Board.clearLines
  ext ⟨j, r⟩
  rw [Finset.mem_image, mem_skyline]
  constructor
  · rintro ⟨⟨a, b⟩, hmem, heq⟩
    rw [Finset.mem_filter] at hmem
    obtain ⟨hab, hnf⟩ := hmem
    rw [mem_skyline] at hab
    rw [isFull_skyline_iff_lt hm hm0, not_lt] at hnf
    rw [clearedBelow_skyline hm hm0] at heq
    simp only [Prod.mk.injEq] at heq
    obtain ⟨ha, hb⟩ := heq
    rw [ha] at hab
    have hmj := hm j hab.1
    exact ⟨hab.1, by omega⟩
  · rintro ⟨hj, hr⟩
    have hmj := hm j hj
    refine ⟨(j, r + m), ?_, ?_⟩
    · rw [Finset.mem_filter, mem_skyline, isFull_skyline_iff_lt hm hm0]
      exact ⟨⟨hj, by omega⟩, by omega⟩
    · rw [clearedBelow_skyline hm hm0]
      simp only [Prod.mk.injEq, true_and]
      omega

/-- **Cell conservation under a uniform floor clear.** Clearing `m` full floor
rows from a skyline removes exactly `cfg.cols * m` cells: the surface drops by `m`
in every column (`clearLines_skyline`) and each column thereby contributes `m`
fewer cells (`card_skyline`). This is the conserved-quantity companion to the
geometric `clearLines_skyline`, pinning the exact cell debit of a gravity step. -/
theorem card_clearLines_skyline {cfg : GameConfig} {h : ℕ → ℕ} {m : ℕ}
    (hm : ∀ j < cfg.cols, m ≤ h j) (hm0 : ∃ j < cfg.cols, h j = m) :
    (Board.clearLines cfg (skyline cfg h)).card
      = (skyline cfg h).card - cfg.cols * m := by
  rw [clearLines_skyline hm hm0, card_skyline, card_skyline]
  have key : (∑ j ∈ Finset.range cfg.cols, (h j - m)) + cfg.cols * m
      = ∑ j ∈ Finset.range cfg.cols, h j := by
    have hconst : cfg.cols * m = ∑ _j ∈ Finset.range cfg.cols, m := by
      rw [Finset.sum_const, Finset.card_range, smul_eq_mul]
    rw [hconst, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro j hj
    exact Nat.sub_add_cancel (hm j (Finset.mem_range.mp hj))
  omega

/-- **Line clears never raise a column.** Every surviving cell is either filtered
out (its row was full) or shifted strictly *down* by the count of full rows below
it, so the post-clear height of any column is at most its pre-clear height. This
is the structural height-monotonicity fact underlying every per-bag height
bound — placements push heights up, clears only pull them back down — and unlike
the skyline-specialised `clearLines_skyline` it holds for *arbitrary* boards,
holes included. Proved cell-wise (no `decide`). -/
theorem colHeight_clearLines_le {cfg : GameConfig} (b : Board) (j : ℕ) :
    Board.colHeight (Board.clearLines cfg b) j ≤ Board.colHeight b j := by
  unfold Board.colHeight
  apply Finset.sup_le
  intro r hr
  unfold Board.colRows at hr
  rw [Finset.mem_image] at hr
  obtain ⟨c, hc, hcr⟩ := hr
  rw [Finset.mem_filter] at hc
  obtain ⟨hcmem, hcj⟩ := hc
  unfold Board.clearLines at hcmem
  rw [Finset.mem_image] at hcmem
  obtain ⟨p, hp, hpeq⟩ := hcmem
  rw [Finset.mem_filter] at hp
  obtain ⟨hpb, -⟩ := hp
  rw [← hpeq] at hcj hcr
  have hpj : p.1 = j := by simpa using hcj
  have hs_mem : p.2 ∈ Board.colRows b j := by
    unfold Board.colRows
    rw [Finset.mem_image]
    exact ⟨p, Finset.mem_filter.mpr ⟨hpb, hpj⟩, rfl⟩
  have hle : p.2 + 1 ≤ (Board.colRows b j).sup (· + 1) :=
    Finset.le_sup (f := (· + 1)) hs_mem
  have hrle : r = p.2 - Board.clearedBelow cfg b p.2 := by simpa using hcr.symm
  omega

/-- **Per-step height bound.** After hard-dropping a piece and clearing lines,
every column's height is at most the max of its pre-placement height and the
height contributed by the dropped piece alone. Composes `colHeight_clearLines_le`
(clears never raise a column) with `colHeight_union` (a union's height is the
pointwise max of the two heights), through `place = b ∪ dropped`. This is the
per-column engine behind any per-bag aggregate height bound: a single placement
can only push column `j` as high as whatever the piece itself reaches there. -/
theorem colHeight_applyStep_le_max {cfg : GameConfig} (b : Board) (pl : Placement)
    (j : ℕ) :
    colHeight (pl.applyStep cfg b) j ≤ max (colHeight b j) (colHeight (pl.dropped b) j) := by
  rw [Placement.applyStep_eq_clearLines_place]
  refine le_trans (Board.colHeight_clearLines_le (pl.place b) j) ?_
  rw [Placement.place_eq_union_dropped]
  exact le_of_eq (colHeight_union b (pl.dropped b) j)

/-- **A piece contributes no height to columns it never occupies.** If no cell of
the dropped piece lands in column `j` (every `shapeUp` cell offsets to a column
other than `j`), then the dropped piece has zero height there. The dropped piece
is the image of `shapeUp` under the drop translation, so a cell at column `j`
would force some `shapeUp` cell with `pl.col + cell.1 = j`, contradicting the
hypothesis. Combined with `colHeight_applyStep_le_max`, this gives the
"untouched columns never grow" fact that keeps a reserved well empty while the
other columns are packed. -/
theorem colHeight_dropped_eq_zero_of_not_col {b : Board} {pl : Placement} {j : ℕ}
    (h : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ j) :
    colHeight (pl.dropped b) j = 0 := by
  rw [colHeight_eq_zero_iff_forall_not_mem]
  intro r hmem
  rw [Placement.dropped_eq_image, Finset.mem_image] at hmem
  obtain ⟨cell, hcell, heq⟩ := hmem
  simp only [Prod.mk.injEq] at heq
  exact h cell hcell heq.1

/-- **Untouched columns never grow.** If the piece never occupies column `j`
(every `shapeUp` cell offsets away from `j`), then a full place-and-clear step
leaves column `j` no taller than before. Composes the per-step max bound
`colHeight_applyStep_le_max` with `colHeight_dropped_eq_zero_of_not_col` (the
piece adds zero height there), collapsing `max (colHeight b j) 0` to
`colHeight b j`. In particular a column at height `0` that the piece avoids stays
at height `0` — the invariant that keeps a reserved well open across an entire
bag of non-well placements. -/
theorem colHeight_applyStep_le_of_not_col {cfg : GameConfig} {b : Board}
    {pl : Placement} {j : ℕ} (h : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ j) :
    colHeight (pl.applyStep cfg b) j ≤ colHeight b j := by
  refine le_trans (colHeight_applyStep_le_max b pl j) ?_
  rw [colHeight_dropped_eq_zero_of_not_col h]
  exact max_le le_rfl (Nat.zero_le _)

/-- **A no-clear step never lowers a column (the height-floor engine).** When the
placed board completes no rows (`fullRows cfg (pl.place b) = ∅`), the line-clear
phase is the identity (`clearLines_eq_self_of_no_fullRows`), so `applyStep`
collapses to the bare placement — which only *adds* cells and hence never lowers a
column (`colHeight_le_place`). This is the lower-bound companion to
`colHeight_applyStep_le_of_not_col` (which bounds *untouched* columns from above):
together they pin a column's height across a no-clear step. The engine for
tracking a *notch/bump* through a non-staircase placement — a flat-shelf piece
landing in a window disjoint from the well keeps that well empty, so no row fills,
so the bump column `m` cannot drop below its pre-step `base + 1`. -/
theorem colHeight_le_applyStep_of_no_fullRows {cfg : GameConfig} {b : Board}
    {pl : Placement} (h : fullRows cfg (pl.place b) = ∅) (j : ℕ) :
    colHeight b j ≤ colHeight (pl.applyStep cfg b) j := by
  rw [Placement.applyStep_eq_clearLines_place, clearLines_eq_self_of_no_fullRows cfg h]
  exact colHeight_le_place b pl j

/-- **The unconditional structural step identity — parent of the no-clear bricks.**
Every `applyStep`, whether it clears rows or not, is `clearLines` applied to the
bare union `b ∪ pl.dropped b`: place drops the piece (union), then the clear phase
runs on the result. This is just the two definitional unfoldings
(`applyStep_eq_clearLines_place` ∘ `place_eq_union_dropped`) packaged as one named
brick, with the `clearLines` wrapper left *explicit* so the clear-active re-entry
(the I-in-well drop that clears `k` rows, #65) can compute its reset surface
directly. Specialising the wrapper to the identity when `fullRows = ∅` recovers
`applyStep_eq_union_dropped_of_no_fullRows`; here it stays general. -/
theorem applyStep_eq_clearLines_union_dropped {cfg : GameConfig} (b : Board)
    (pl : Placement) :
    pl.applyStep cfg b = clearLines cfg (b ∪ pl.dropped b) := by
  rw [Placement.applyStep_eq_clearLines_place, Placement.place_eq_union_dropped]

/-- **The exact post-board *set* of a no-clear placement — the structural
re-entry brick.** When the placed board completes no rows
(`fullRows cfg (pl.place b) = ∅`), the line-clear phase is the identity, so the
*whole post-board as a Finset* is literally `b ∪ pl.dropped b` — no gravity, no
column shift. This is the set-level companion to the height-level
`colHeight_applyStep_eq_max_of_no_fullRows` (which is exactly the `colHeight`
image of this identity): that lemma reads off per-column heights, this one pins
the exact cell-set. Re-entry arguments that must compute the precise resulting
board (which cells are filled, not just how tall each column is) consume this
directly. -/
theorem applyStep_eq_union_dropped_of_no_fullRows {cfg : GameConfig} {b : Board}
    {pl : Placement} (h : fullRows cfg (pl.place b) = ∅) :
    pl.applyStep cfg b = b ∪ pl.dropped b := by
  rw [Placement.applyStep_eq_clearLines_place, clearLines_eq_self_of_no_fullRows cfg h,
      Placement.place_eq_union_dropped]

/-- **A no-clear step only *adds* cells — set-level monotonicity.** Set-level twin
of the height floor `colHeight_le_applyStep_of_no_fullRows`: since the whole
post-board of a no-clear step is `b ∪ pl.dropped b`
(`applyStep_eq_union_dropped_of_no_fullRows`), the original board embeds into it,
so every cell present *before* the step is still present *after*. Until a line
clear actually fires, placement is purely additive at the cell level — exactly the
invariant a re-entry argument needs to certify that a packed cell survives across
the no-clear portion of a bag before the well-clear resets the surface. -/
theorem subset_applyStep_of_no_fullRows {cfg : GameConfig} {b : Board}
    {pl : Placement} (h : fullRows cfg (pl.place b) = ∅) :
    b ⊆ pl.applyStep cfg b := by
  rw [applyStep_eq_union_dropped_of_no_fullRows h]
  exact Finset.subset_union_left

/-- **The just-placed piece survives a no-clear step — the right-union twin of
`subset_applyStep_of_no_fullRows`.** Where ABFX certifies the *old* board embeds
into the post-step board, this certifies the *new* piece does: since a no-clear
step is exactly `b ∪ pl.dropped b`
(`applyStep_eq_union_dropped_of_no_fullRows`), every dropped cell is still filled
afterwards. Together the two subset halves give `b ∪ pl.dropped b ⊆ applyStep`
(an equality by ABFW, but each direction is independently useful for `card_le`/
monotonicity rewrites): across the no-clear portion of a bag, *both* the packed
surface and each freshly-dropped piece persist at the cell level — the persistence
ledger a re-entry argument tracks until the well-clear fires. -/
theorem dropped_subset_applyStep_of_no_fullRows {cfg : GameConfig} {b : Board}
    {pl : Placement} (h : fullRows cfg (pl.place b) = ∅) :
    pl.dropped b ⊆ pl.applyStep cfg b := by
  rw [applyStep_eq_union_dropped_of_no_fullRows h]
  exact Finset.subset_union_right

/-- **Cell-membership characterisation of a no-clear step.** The `↔` refinement of
the two subset bricks (`subset_applyStep_of_no_fullRows`,
`dropped_subset_applyStep_of_no_fullRows`): since a no-clear step is exactly
`b ∪ pl.dropped b` (`applyStep_eq_union_dropped_of_no_fullRows`), a cell `c` is
filled *after* the step iff it was filled before *or* it belongs to the dropped
piece — nothing else appears and nothing disappears. This is the decision
procedure a re-entry argument calls to settle whether a *named* cell is occupied
post-step (e.g. confirming a row is/ isn't completed), one step finer than the
height- and subset-level bricks. -/
theorem mem_applyStep_of_no_fullRows {cfg : GameConfig} {b : Board} {pl : Placement}
    (h : fullRows cfg (pl.place b) = ∅) {c : Coord} :
    c ∈ pl.applyStep cfg b ↔ c ∈ b ∨ c ∈ pl.dropped b := by
  rw [applyStep_eq_union_dropped_of_no_fullRows h, Finset.mem_union]

/-- **The exact post-step profile of a no-clear placement — the profile-tracking
engine.** When the placed board completes no rows (`fullRows cfg (pl.place b) = ∅`),
the line-clear phase is the identity, so `applyStep` is the bare placement
`b ∪ pl.dropped b`, whose height in every column is the pointwise max of the old
board and the dropped piece (`colHeight_union`). Thus the *whole* post-board
profile of a no-clear step is read off column-by-column as `old ⊔ piece`, with no
`Fin`/clear bookkeeping. This subsumes both one-sided bricks — the floor
(`colHeight_le_applyStep_of_no_fullRows`, the `≥ old` half) and the avoided-column
hold (`colHeight_applyStep_eq_of_not_col_of_no_fullRows`, the `piece = 0 ⇒ = old`
case) — and is the engine that yields the entire surface of a non-staircase
placement, the first real brick of a profile-tracking carrier closed under all
seven pieces. -/
theorem colHeight_applyStep_eq_max_of_no_fullRows {cfg : GameConfig} {b : Board}
    {pl : Placement} (h : fullRows cfg (pl.place b) = ∅) (j : ℕ) :
    colHeight (pl.applyStep cfg b) j
      = max (colHeight b j) (colHeight (pl.dropped b) j) := by
  rw [Placement.applyStep_eq_clearLines_place, clearLines_eq_self_of_no_fullRows cfg h,
      Placement.place_eq_union_dropped, colHeight_union b (pl.dropped b) j]

/-- **A no-clear step preserves a uniform column ceiling — the tight height-accounting
brick.** When the placed board completes no rows, the post-step height in every column
is exactly `max (old, piece)` (`colHeight_applyStep_eq_max_of_no_fullRows`), so if both
the board *and* the dropped piece already fit under a common ceiling `H`, the whole
post-board still fits under `H` — with *no* growth. This is the tight companion to the
loose `+4` transient ceiling (`colHeight_applyStep_le_of_colHeight_le`, the monotone
route to the per-bag `H + 4k` bound #74): there each piece may push the envelope up by
4, here a piece that lands *within* the existing envelope leaves the ceiling flat. That
no-growth preservation is exactly the height-accounting invariant a profile-tracking
carrier closed under all seven pieces (#72) must thread — a flat-top/notched skyline
stays flat-topped at the same height whenever the incoming piece is absorbed under the
current surface. -/
theorem colHeight_applyStep_le_of_no_fullRows {cfg : GameConfig} {b : Board}
    {pl : Placement} {H : ℕ} (h : fullRows cfg (pl.place b) = ∅)
    (hb : ∀ j, colHeight b j ≤ H) (hp : ∀ j, colHeight (pl.dropped b) j ≤ H) (j : ℕ) :
    colHeight (pl.applyStep cfg b) j ≤ H := by
  rw [colHeight_applyStep_eq_max_of_no_fullRows h]
  exact max_le (hb j) (hp j)

/-- **An avoided column is held *exactly* across a no-clear step.** Antisymmetric
pairing of the two one-sided bounds: a placement that never occupies column `j`
can only *lower* it (`colHeight_applyStep_le_of_not_col`, true even with clears),
while a step that clears nothing can only *raise* it
(`colHeight_le_applyStep_of_no_fullRows`); together the height is pinned unchanged.
This is the exact-preservation statement behind holding a notch/bump: a flat-shelf
piece that lands in a window disjoint from the bump column `m`, on a board where
the empty well blocks every row from filling, leaves `colHeight m` at precisely its
pre-step value — the bump neither grows nor drops, surviving the non-staircase
placement intact. -/
theorem colHeight_applyStep_eq_of_not_col_of_no_fullRows {cfg : GameConfig}
    {b : Board} {pl : Placement} {j : ℕ}
    (havoid : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ j)
    (hclear : fullRows cfg (pl.place b) = ∅) :
    colHeight (pl.applyStep cfg b) j = colHeight b j :=
  le_antisymm (colHeight_applyStep_le_of_not_col havoid)
    (colHeight_le_applyStep_of_no_fullRows hclear j)

/-- **An empty well blocks every line on *any* board — the general no-clear discharge.**
If column `w` of board `b` is empty (`colHeight b w = 0`, i.e. no filled cell sits in
that column), any placement that *avoids* `w` leaves the column empty in the placed
board: a cell `(w, r)` could only come from `b` (impossible — `r < colHeight b w = 0`
by `lt_colHeight`) or from the dropped piece (impossible — the piece never offsets into
`w`). One column missing in every row means no row is full, so `fullRows = ∅`. Unlike
the skyline-specialised companion (`fullRows_place_skyline_eq_empty_of_well`), this
holds for the *arbitrary* boards a bag passes through between skyline states, so it is
the discharge a tight ceiling-fold consumes at every step — the exact analogue of how
`colHeight_foldl_applyStep_le_of_not_col` carries well-preservation across non-skyline
intermediates. -/
theorem fullRows_place_eq_empty_of_well {cfg : GameConfig} {b : Board}
    {pl : Placement} {w : ℕ} (hw : w < cfg.cols) (hw0 : colHeight b w = 0)
    (havoid : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ w) :
    fullRows cfg (pl.place b) = ∅ := by
  have hnot : ∀ r, (w, r) ∉ pl.place b := by
    intro r hmem
    rw [Placement.place_eq_union_dropped, Finset.mem_union] at hmem
    rcases hmem with hb | hdrop
    · have hlt := lt_colHeight hb
      omega
    · rw [Placement.dropped_eq_image, Finset.mem_image] at hdrop
      obtain ⟨cell, hcell, heq⟩ := hdrop
      simp only [Prod.mk.injEq] at heq
      exact havoid cell hcell heq.1
  rw [Finset.eq_empty_iff_forall_notMem]
  intro r hr
  exact not_isFull_of_not_mem cfg hw (hnot r) (isFull_of_mem_fullRows hr)

/-- **An empty well blocks every line — the no-clear discharge.** On a skyline whose
well column `w` is empty (`h w = 0`), any placement that *avoids* `w` leaves that
column empty in the placed board: a cell `(w, r)` could only come from the skyline
(impossible, `r < h w = 0`) or from the dropped piece (impossible, the piece never
offsets into column `w`). With one column missing in every row, no row is full, so
`fullRows = ∅`. This is precisely the hypothesis the height-floor / exact-preservation
engines (`colHeight_le_applyStep_of_no_fullRows`,
`colHeight_applyStep_eq_of_not_col_of_no_fullRows`) consume — so a reserved-well or
notched placement that dodges the well discharges its `no-clear` obligation
mechanically, and the bump/notch is then held exactly across the step. -/
theorem fullRows_place_skyline_eq_empty_of_well {cfg : GameConfig} {h : ℕ → ℕ}
    {pl : Placement} {w : ℕ} (hw : w < cfg.cols) (hh0 : h w = 0)
    (havoid : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ w) :
    fullRows cfg (pl.place (skyline cfg h)) = ∅ :=
  fullRows_place_eq_empty_of_well hw (by rw [colHeight_skyline hw]; exact hh0) havoid

/-- **Exact bump-preservation on the empty-well skyline carrier — the payoff.**
Composing the no-clear discharge (`fullRows_place_skyline_eq_empty_of_well`) with
the exact column hold (`colHeight_applyStep_eq_of_not_col_of_no_fullRows`) and the
skyline profile readout (`colHeight_skyline`): on a skyline whose well `w` is empty,
any placement that dodges *both* the well `w` and a column `m` leaves `colHeight m`
at *exactly* its profile value `h m` after the whole place-and-clear step. Taking
`m` to be the notch's bump column (`h m = base + 1`), this is the precise statement
that a flat-shelf draw landing clear of the bump holds the notch intact at
`base + 1` — the column-tracking payoff the height-floor
(`colHeight_le_applyStep_of_no_fullRows`), ceiling (`colHeight_applyStep_le_of_not_col`)
and discharge bricks were built for. -/
theorem colHeight_applyStep_skyline_eq_of_avoid_well {cfg : GameConfig} {h : ℕ → ℕ}
    {pl : Placement} {w m : ℕ} (hw : w < cfg.cols) (hm : m < cfg.cols) (hh0 : h w = 0)
    (havoidw : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ w)
    (havoidm : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ m) :
    colHeight (pl.applyStep cfg (skyline cfg h)) m = h m := by
  rw [colHeight_applyStep_eq_of_not_col_of_no_fullRows havoidm
        (fullRows_place_skyline_eq_empty_of_well hw hh0 havoidw), colHeight_skyline hm]

/-- **Window preservation on the empty-well skyline carrier.** The multi-column
generalisation of `colHeight_applyStep_skyline_eq_of_avoid_well`: on a skyline
whose well `w` is empty, any placement that dodges the well *and* every column of
a target set `W` (all in-field) leaves the post-step height of each `m ∈ W` at
exactly its profile value `h m`. Folding the single-column hold across the set,
this is the re-entry primitive the window-coexistence problem (#72) consumes: a
piece routed clear of the flat-4, S-notch and Z-notch windows holds every one of
them intact, so the post-move surface re-presents the very shapes the next
adversary draw needs. It supplies the closure ingredient missing from
`isReservedWellSkyline_all7_hstep`, which lands in a reserved-well skyline but
does not by itself preserve the windows. -/
theorem colHeight_applyStep_skyline_eq_of_avoid_well_window {cfg : GameConfig}
    {h : ℕ → ℕ} {pl : Placement} {w : ℕ} {W : Finset ℕ}
    (hw : w < cfg.cols) (hh0 : h w = 0) (hW : ∀ m ∈ W, m < cfg.cols)
    (havoidw : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ w)
    (havoidW : ∀ m ∈ W, ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ m) :
    ∀ m ∈ W, colHeight (pl.applyStep cfg (skyline cfg h)) m = h m := by
  intro m hm
  exact colHeight_applyStep_skyline_eq_of_avoid_well hw (hW m hm) hh0 havoidw (havoidW m hm)

/-- **The flat-4 window survives a dodging move still flat — the re-entry shape brick.**
A flat-4 window is four consecutive in-field columns `d, d+1, d+2, d+3` that all sit at
the same height `h d` (the surface the O, T, L, J and horizontal I draws each need to
land cleanly). This folds the exact column hold
(`colHeight_applyStep_skyline_eq_of_avoid_well`) across all four window columns with the
flatness equalities `h (d+1) = h d`, `h (d+2) = h d`, `h (d+3) = h d`: on a skyline whose
well `w` is empty, any placement that dodges the well and every one of the four window
columns leaves all four post-step heights at *exactly* `h d`. So the window is not merely
height-preserved column by column (that is the general
`colHeight_applyStep_skyline_eq_of_avoid_well_window`) but preserved *as a flat shelf* —
the post-move surface re-presents the very flat-4 the next adversary draw consumes. This is
the first concrete shape-coexistence brick the window re-entry problem (#72) needs: it
discharges the flat-4 leg of the post-placement window-coexistence obligation, leaving the
S-notch and Z-notch legs as the natural follow-ons. -/
theorem colHeight_applyStep_skyline_flat4_of_avoid {cfg : GameConfig} {h : ℕ → ℕ}
    {pl : Placement} {w d : ℕ}
    (hw : w < cfg.cols) (hd3 : d + 3 < cfg.cols) (hh0 : h w = 0)
    (hflat1 : h (d + 1) = h d) (hflat2 : h (d + 2) = h d) (hflat3 : h (d + 3) = h d)
    (havoidw : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ w)
    (havoidd : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ d)
    (havoidd1 : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ d + 1)
    (havoidd2 : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ d + 2)
    (havoidd3 : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ d + 3) :
    colHeight (pl.applyStep cfg (skyline cfg h)) d = h d ∧
    colHeight (pl.applyStep cfg (skyline cfg h)) (d + 1) = h d ∧
    colHeight (pl.applyStep cfg (skyline cfg h)) (d + 2) = h d ∧
    colHeight (pl.applyStep cfg (skyline cfg h)) (d + 3) = h d := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact colHeight_applyStep_skyline_eq_of_avoid_well hw (by omega) hh0 havoidw havoidd
  · rw [colHeight_applyStep_skyline_eq_of_avoid_well hw (by omega) hh0 havoidw havoidd1]
    exact hflat1
  · rw [colHeight_applyStep_skyline_eq_of_avoid_well hw (by omega) hh0 havoidw havoidd2]
    exact hflat2
  · rw [colHeight_applyStep_skyline_eq_of_avoid_well hw (by omega) hh0 havoidw havoidd3]
    exact hflat3

/-- **The S and Z valley survives a dodging move still a valley — the re-entry notch brick.**
The S/Z analogue of `colHeight_applyStep_skyline_flat4_of_avoid`. A width-4 valley window is
four consecutive in-field columns `vc, vc+1, vc+2, vc+3` whose profile is the notched shape
`base+1, base, base, base+1` (the lipped trough an S or Z draw needs to seat into: S at the
right lip, Z at the left lip). This folds the exact column hold
(`colHeight_applyStep_skyline_eq_of_avoid_well`) across all four valley columns: on a skyline
whose well `w` is empty, any placement that dodges the well and every one of the four valley
columns leaves all four post-step heights at *exactly* their valley profile values. So the
valley is preserved as a valley — the post-move surface re-presents the very notch the next S
or Z draw consumes. This is the phase-preservation primitive a bag-phase-aware carrier (#72)
needs to keep the S and Z landing room alive while a *flat* piece is absorbed elsewhere: a
non-S, non-Z draw routed clear of the reserved valley cannot destroy the room S and Z are
still owed. Together with `colHeight_applyStep_skyline_flat4_of_avoid` (flat-4 leg) it
discharges both shape legs of the post-placement window-coexistence obligation. -/
theorem colHeight_applyStep_skyline_valley4_of_avoid {cfg : GameConfig} {h : ℕ → ℕ}
    {pl : Placement} {w vc base : ℕ}
    (hw : w < cfg.cols) (hvc3 : vc + 3 < cfg.cols) (hh0 : h w = 0)
    (hv0 : h vc = base + 1) (hv1 : h (vc + 1) = base) (hv2 : h (vc + 2) = base)
    (hv3 : h (vc + 3) = base + 1)
    (havoidw : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ w)
    (havoidv0 : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ vc)
    (havoidv1 : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ vc + 1)
    (havoidv2 : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ vc + 2)
    (havoidv3 : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ vc + 3) :
    colHeight (pl.applyStep cfg (skyline cfg h)) vc = base + 1 ∧
    colHeight (pl.applyStep cfg (skyline cfg h)) (vc + 1) = base ∧
    colHeight (pl.applyStep cfg (skyline cfg h)) (vc + 2) = base ∧
    colHeight (pl.applyStep cfg (skyline cfg h)) (vc + 3) = base + 1 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [colHeight_applyStep_skyline_eq_of_avoid_well hw (by omega) hh0 havoidw havoidv0]
    exact hv0
  · rw [colHeight_applyStep_skyline_eq_of_avoid_well hw (by omega) hh0 havoidw havoidv1]
    exact hv1
  · rw [colHeight_applyStep_skyline_eq_of_avoid_well hw (by omega) hh0 havoidw havoidv2]
    exact hv2
  · rw [colHeight_applyStep_skyline_eq_of_avoid_well hw (by omega) hh0 havoidw havoidv3]
    exact hv3

/-- **The S-notch window survives a dodging move with its staircase shape — the
second re-entry shape brick.** An S-notch (the staircase the horizontal S draw needs
to land hole-free) is three consecutive in-field columns `d, d+1, d+2` standing in the
profile `(k, k, k+1)`: the floor pair `h d = h (d+1) = k` and the single rising step
`h (d+2) = k + 1`. This folds the exact column hold
(`colHeight_applyStep_skyline_eq_of_avoid_well`) across the three window columns with
the notch equalities `h (d+1) = h d` and `h (d+2) = h d + 1`: on a skyline whose well
`w` is empty, any placement that dodges the well and all three window columns leaves the
post-step heights at exactly `h d, h d, h d + 1` — the S-notch is preserved *as a
staircase*, not merely height-by-height. So the post-move surface re-presents the very
S-notch the next adversary draw consumes. This is the second leg (after the flat-4
`colHeight_applyStep_skyline_flat4_of_avoid`) of the post-placement window-coexistence
obligation (#72), leaving the mirror Z-notch leg as the natural follow-on. -/
theorem colHeight_applyStep_skyline_Snotch_of_avoid {cfg : GameConfig} {h : ℕ → ℕ}
    {pl : Placement} {w d : ℕ}
    (hw : w < cfg.cols) (hd2 : d + 2 < cfg.cols) (hh0 : h w = 0)
    (hflat : h (d + 1) = h d) (hstep : h (d + 2) = h d + 1)
    (havoidw : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ w)
    (havoidd : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ d)
    (havoidd1 : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ d + 1)
    (havoidd2 : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ d + 2) :
    colHeight (pl.applyStep cfg (skyline cfg h)) d = h d ∧
    colHeight (pl.applyStep cfg (skyline cfg h)) (d + 1) = h d ∧
    colHeight (pl.applyStep cfg (skyline cfg h)) (d + 2) = h d + 1 := by
  refine ⟨?_, ?_, ?_⟩
  · exact colHeight_applyStep_skyline_eq_of_avoid_well hw (by omega) hh0 havoidw havoidd
  · rw [colHeight_applyStep_skyline_eq_of_avoid_well hw (by omega) hh0 havoidw havoidd1]
    exact hflat
  · rw [colHeight_applyStep_skyline_eq_of_avoid_well hw (by omega) hh0 havoidw havoidd2]
    exact hstep

/-- **The Z-notch window survives a dodging move with its mirror-staircase shape — the
third re-entry shape brick, completing the trio.** A Z-notch (the mirror staircase the
horizontal Z draw needs to land hole-free) is three consecutive in-field columns
`d, d+1, d+2` standing in the profile `(k+1, k, k)`: the lone high step
`h d = h (d+1) + 1` and the floor pair `h (d+2) = h (d+1) = k`. This folds the exact
column hold (`colHeight_applyStep_skyline_eq_of_avoid_well`) across the three window
columns with the mirror-notch equalities: on a skyline whose well `w` is empty, any
placement that dodges the well and all three window columns leaves the post-step heights
at exactly `h (d+1) + 1, h (d+1), h (d+1)` — the Z-notch is preserved *as a mirror
staircase*. So the post-move surface re-presents the very Z-notch the next adversary draw
consumes. Together with the flat-4 (`colHeight_applyStep_skyline_flat4_of_avoid`) and the
S-notch (`colHeight_applyStep_skyline_Snotch_of_avoid`) bricks this completes the
three-window shape-survival trio that #72's post-placement window-coexistence step
consumes: a piece routed clear of all three windows holds each one intact in its exact
landing shape, so the adversary's next O/T/L/J/I/S/Z draw still finds its home. -/
theorem colHeight_applyStep_skyline_Znotch_of_avoid {cfg : GameConfig} {h : ℕ → ℕ}
    {pl : Placement} {w d : ℕ}
    (hw : w < cfg.cols) (hd2 : d + 2 < cfg.cols) (hh0 : h w = 0)
    (hstep : h d = h (d + 1) + 1) (hflat : h (d + 2) = h (d + 1))
    (havoidw : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ w)
    (havoidd : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ d)
    (havoidd1 : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ d + 1)
    (havoidd2 : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ d + 2) :
    colHeight (pl.applyStep cfg (skyline cfg h)) d = h (d + 1) + 1 ∧
    colHeight (pl.applyStep cfg (skyline cfg h)) (d + 1) = h (d + 1) ∧
    colHeight (pl.applyStep cfg (skyline cfg h)) (d + 2) = h (d + 1) := by
  refine ⟨?_, ?_, ?_⟩
  · rw [colHeight_applyStep_skyline_eq_of_avoid_well hw (by omega) hh0 havoidw havoidd]
    exact hstep
  · exact colHeight_applyStep_skyline_eq_of_avoid_well hw (by omega) hh0 havoidw havoidd1
  · rw [colHeight_applyStep_skyline_eq_of_avoid_well hw (by omega) hh0 havoidw havoidd2]
    exact hflat

/-- **All three windows coexist after one dodging move — the trio payoff, packaged.**
The consolidation of the flat-4 (`colHeight_applyStep_skyline_flat4_of_avoid`), S-notch
(`colHeight_applyStep_skyline_Snotch_of_avoid`) and Z-notch
(`colHeight_applyStep_skyline_Znotch_of_avoid`) bricks into the single statement the
re-entry carrier step (#72) actually consumes. The protected columns — the empty well `w`,
the flat-4 window `f .. f+3`, the S-notch window `s .. s+2` and the Z-notch window
`z .. z+2` — are collected into one Finset `W`; the hypothesis is the single dodge
`∀ cell ∈ pl.shapeUp, pl.col + cell.1 ∉ W` (the placed piece touches no protected column),
plus the membership facts pinning each protected column into `W`. The conclusion is the
full window-coexistence: after the place-and-clear step the flat-4 is still flat at `h f`,
the S-notch is still the staircase `(h s, h s, h s + 1)`, and the Z-notch is still the
mirror staircase `(h (z+1) + 1, h (z+1), h (z+1))`. So a single piece routed clear of every
window holds all three shapes intact at once, and the post-move surface re-presents every
landing site the next adversary draw of O, T, L, J, I, S or Z needs. The inner `hav`
derives each per-column avoidance from the one Finset dodge, so callers supply just one
avoidance proof. This discharges the *shape* half of the re-entry obligation; the
*existence* half — that such a dodging landing site always exists for each piece without
unbounded height growth — remains the open content of #72. -/
theorem colHeight_applyStep_skyline_allwindows_of_avoid {cfg : GameConfig} {h : ℕ → ℕ}
    {pl : Placement} {w f s z : ℕ} {W : Finset ℕ}
    (hw : w < cfg.cols) (hf3 : f + 3 < cfg.cols) (hs2 : s + 2 < cfg.cols)
    (hz2 : z + 2 < cfg.cols) (hh0 : h w = 0)
    (hfflat1 : h (f + 1) = h f) (hfflat2 : h (f + 2) = h f) (hfflat3 : h (f + 3) = h f)
    (hsflat : h (s + 1) = h s) (hsstep : h (s + 2) = h s + 1)
    (hzstep : h z = h (z + 1) + 1) (hzflat : h (z + 2) = h (z + 1))
    (hwW : w ∈ W)
    (hfW : f ∈ W) (hf1W : f + 1 ∈ W) (hf2W : f + 2 ∈ W) (hf3W : f + 3 ∈ W)
    (hsW : s ∈ W) (hs1W : s + 1 ∈ W) (hs2W : s + 2 ∈ W)
    (hzW : z ∈ W) (hz1W : z + 1 ∈ W) (hz2W : z + 2 ∈ W)
    (havoid : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ∉ W) :
    (colHeight (pl.applyStep cfg (skyline cfg h)) f = h f ∧
     colHeight (pl.applyStep cfg (skyline cfg h)) (f + 1) = h f ∧
     colHeight (pl.applyStep cfg (skyline cfg h)) (f + 2) = h f ∧
     colHeight (pl.applyStep cfg (skyline cfg h)) (f + 3) = h f) ∧
    (colHeight (pl.applyStep cfg (skyline cfg h)) s = h s ∧
     colHeight (pl.applyStep cfg (skyline cfg h)) (s + 1) = h s ∧
     colHeight (pl.applyStep cfg (skyline cfg h)) (s + 2) = h s + 1) ∧
    (colHeight (pl.applyStep cfg (skyline cfg h)) z = h (z + 1) + 1 ∧
     colHeight (pl.applyStep cfg (skyline cfg h)) (z + 1) = h (z + 1) ∧
     colHeight (pl.applyStep cfg (skyline cfg h)) (z + 2) = h (z + 1)) := by
  have hav : ∀ a ∈ W, ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ a := by
    intro a ha cell hc heq
    exact havoid cell hc (by rw [heq]; exact ha)
  refine ⟨?_, ?_, ?_⟩
  · exact colHeight_applyStep_skyline_flat4_of_avoid hw hf3 hh0 hfflat1 hfflat2 hfflat3
      (hav w hwW) (hav f hfW) (hav (f + 1) hf1W) (hav (f + 2) hf2W) (hav (f + 3) hf3W)
  · exact colHeight_applyStep_skyline_Snotch_of_avoid hw hs2 hh0 hsflat hsstep
      (hav w hwW) (hav s hsW) (hav (s + 1) hs1W) (hav (s + 2) hs2W)
  · exact colHeight_applyStep_skyline_Znotch_of_avoid hw hz2 hh0 hzstep hzflat
      (hav w hwW) (hav z hzW) (hav (z + 1) hz1W) (hav (z + 2) hz2W)

/-- **Budget-feasible window coexistence: well, flat-4 pocket and shared S, Z valley all
survive one dodging move.** The 9-column-feasible redesign of
`colHeight_applyStep_skyline_allwindows_of_avoid`. That lemma protected four disjoint blocks —
the well (1 col), a flat-4 (4 cols), a separate S-notch (3 cols) and a separate Z-notch
(3 cols) — totalling `1 + 4 + 3 + 3 = 11` columns, which `four_disjoint_blocks_card_le` shows
cannot fit on the standard 10-wide board. Here the two 3-column staircase notches are replaced
by ONE shared width-4 valley `(base+1, base, base, base+1)` that hosts both S (right lip) and Z
(left lip), so the protected blocks are the well (1), the flat-4 (4) and the valley (4),
totalling `1 + 4 + 4 = 9 ≤ 10` — exactly the column budget the phase-conditional carrier
(`well_plus_notch_leaves_flat`) fits. The protected columns are collected into one Finset `W`;
from the single dodge `∀ cell ∈ pl.shapeUp, pl.col + cell.1 ∉ W` the post-move surface holds the
well empty, the flat-4 flat at `h f`, and the valley in its exact `(base+1, base, base, base+1)`
shape. So a single piece routed clear of every protected column re-presents, within 10 columns,
every landing site the next adversary draw of O, T, L, J, I, S or Z needs. This discharges the
shape half of the re-entry obligation (#72) in a column-feasible way; the existence half — that
such a dodging landing site always exists for each piece without unbounded height growth —
remains the open content of #66. -/
theorem colHeight_applyStep_skyline_wellPocketValley_of_avoid {cfg : GameConfig} {h : ℕ → ℕ}
    {pl : Placement} {w f v base : ℕ} {W : Finset ℕ}
    (hw : w < cfg.cols) (hf3 : f + 3 < cfg.cols) (hv3 : v + 3 < cfg.cols) (hh0 : h w = 0)
    (hfflat1 : h (f + 1) = h f) (hfflat2 : h (f + 2) = h f) (hfflat3 : h (f + 3) = h f)
    (hv0 : h v = base + 1) (hv1 : h (v + 1) = base) (hv2 : h (v + 2) = base)
    (hv3p : h (v + 3) = base + 1)
    (hwW : w ∈ W)
    (hfW : f ∈ W) (hf1W : f + 1 ∈ W) (hf2W : f + 2 ∈ W) (hf3W : f + 3 ∈ W)
    (hvW : v ∈ W) (hv1W : v + 1 ∈ W) (hv2W : v + 2 ∈ W) (hv3W : v + 3 ∈ W)
    (havoid : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ∉ W) :
    colHeight (pl.applyStep cfg (skyline cfg h)) w = 0 ∧
    (colHeight (pl.applyStep cfg (skyline cfg h)) f = h f ∧
     colHeight (pl.applyStep cfg (skyline cfg h)) (f + 1) = h f ∧
     colHeight (pl.applyStep cfg (skyline cfg h)) (f + 2) = h f ∧
     colHeight (pl.applyStep cfg (skyline cfg h)) (f + 3) = h f) ∧
    (colHeight (pl.applyStep cfg (skyline cfg h)) v = base + 1 ∧
     colHeight (pl.applyStep cfg (skyline cfg h)) (v + 1) = base ∧
     colHeight (pl.applyStep cfg (skyline cfg h)) (v + 2) = base ∧
     colHeight (pl.applyStep cfg (skyline cfg h)) (v + 3) = base + 1) := by
  have hav : ∀ a ∈ W, ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ a := by
    intro a ha cell hc heq
    exact havoid cell hc (by rw [heq]; exact ha)
  refine ⟨?_, ?_, ?_⟩
  · rw [colHeight_applyStep_skyline_eq_of_avoid_well hw hw hh0 (hav w hwW) (hav w hwW)]
    exact hh0
  · exact colHeight_applyStep_skyline_flat4_of_avoid hw hf3 hh0 hfflat1 hfflat2 hfflat3
      (hav w hwW) (hav f hfW) (hav (f + 1) hf1W) (hav (f + 2) hf2W) (hav (f + 3) hf3W)
  · exact colHeight_applyStep_skyline_valley4_of_avoid hw hv3 hh0 hv0 hv1 hv2 hv3p
      (hav w hwW) (hav v hvW) (hav (v + 1) hv1W) (hav (v + 2) hv2W) (hav (v + 3) hv3W)

/-- **Flat-ceiling preservation on the empty-well skyline carrier — the ceiling
payoff.** The `≤ H` analogue of `colHeight_applyStep_skyline_eq_of_avoid_well`:
composing the no-clear discharge (`fullRows_place_skyline_eq_empty_of_well`) with the
tight no-growth ceiling (`colHeight_applyStep_le_of_no_fullRows`), on a skyline whose
well `w` is empty, any placement that dodges `w` and whose dropped piece fits under a
ceiling `H` (`hp`) leaves *every* column under `H` after the whole place-and-clear
step — provided the surface already fit under `H` (`hb`). The well hypothesis
discharges `fullRows = ∅` mechanically, so the reserved-well carrier's flat ceiling is
maintained with no per-piece `decide`: as long as each bag's draw lands within the
current envelope and avoids the well, the skyline never tops out. This is the
height-bounded closure shape the profile-tracking carrier (#72) threads, the ceiling
companion to the exact bump-hold. -/
theorem colHeight_applyStep_skyline_le_of_avoid_well {cfg : GameConfig} {h : ℕ → ℕ}
    {pl : Placement} {w H : ℕ} (hw : w < cfg.cols) (hh0 : h w = 0)
    (havoidw : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ w)
    (hb : ∀ j, colHeight (skyline cfg h) j ≤ H)
    (hp : ∀ j, colHeight (pl.dropped (skyline cfg h)) j ≤ H) (j : ℕ) :
    colHeight (pl.applyStep cfg (skyline cfg h)) j ≤ H :=
  colHeight_applyStep_le_of_no_fullRows
    (fullRows_place_skyline_eq_empty_of_well hw hh0 havoidw) hb hp j

/-- **The notch bump is held at `base + 1` across an avoiding flat-shelf move.**
The carrier-level reading of `colHeight_applyStep_skyline_eq_of_avoid_well`: a
notched flat-top skyline (well `w` empty, lone bump at `m` of height `base + 1`)
keeps its bump *exactly* at `base + 1` after any placement that dodges both the well
and the bump column. This is the concrete invariant a bag's flat-shelf draws must
maintain while an `S`/`Z` debt is outstanding — the notch neither fills in nor
topples until the owed staircase piece arrives to consume it. -/
theorem colHeight_applyStep_notched_bump_eq {cfg : GameConfig} {base w m : ℕ}
    {pl : Placement} (hw : w < cfg.cols) (hm : m < cfg.cols) (hwm : w ≠ m)
    (havoidw : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ w)
    (havoidm : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ m) :
    colHeight (pl.applyStep cfg
        (skyline cfg (fun j => if j = w then 0 else if j = m then base + 1 else base))) m
      = base + 1 := by
  rw [colHeight_applyStep_skyline_eq_of_avoid_well hw hm (by simp) havoidw havoidm]
  simp [Ne.symm hwm]

/-- **Avoiding a column outside the footprint window.** If every cell of a
placement's shape sits at a column-offset `< bound` (a per-piece `decide` fact: `O`
spans 2, `T`/`L`/`J` span 3, a flat `I` spans 4), then the placement occupies only
columns `[pl.col, pl.col + bound)`, so it avoids any column `c` strictly left of
`pl.col` or at-or-right of `pl.col + bound`. The mechanical bridge that discharges
the `havoidw` / `havoidm` obligations of the bump-preservation lemmas
(`colHeight_applyStep_skyline_eq_of_avoid_well`, `colHeight_applyStep_notched_bump_eq`)
from a footprint window disjoint from the well and the bump. -/
theorem avoid_col_of_offset_lt {pl : Placement} {c bound : ℕ}
    (hoff : ∀ cell ∈ pl.shapeUp, cell.1 < bound)
    (hc : c < pl.col ∨ pl.col + bound ≤ c) :
    ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ c := by
  intro cell hcell
  have hb := hoff cell hcell
  omega

/-- **Avoiding a whole protected set outside the footprint window — the Finset lift.**
The set-valued generalisation of `avoid_col_of_offset_lt`: if every cell of a placement's
shape sits at a column-offset `< bound` (the per-piece footprint width fact: `O` spans 2,
`T`/`L`/`J` span 3, a flat `I` spans 4), then the placement occupies only columns
`[pl.col, pl.col + bound)`, so it avoids *every* column of a protected Finset `W` that
lies entirely outside that window (each `a ∈ W` is strictly left of `pl.col` or
at-or-right of `pl.col + bound`). This produces exactly the single dodge hypothesis
`∀ cell ∈ pl.shapeUp, pl.col + cell.1 ∉ W` that the consolidated window-coexistence lemma
`colHeight_applyStep_skyline_allwindows_of_avoid` consumes. So the existence half of the
re-entry obligation (#72) reduces to a packing fact: place each piece with its footprint
window `[pl.col, pl.col + bound)` landing inside a scratch band disjoint from the well and
the three windows, and all three windows survive for free. -/
theorem avoid_finset_of_offset_lt {pl : Placement} {W : Finset ℕ} {bound : ℕ}
    (hoff : ∀ cell ∈ pl.shapeUp, cell.1 < bound)
    (hW : ∀ a ∈ W, a < pl.col ∨ pl.col + bound ≤ a) :
    ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ∉ W := by
  intro cell hcell hmem
  have hb := hoff cell hcell
  rcases hW _ hmem with h | h <;> omega

/-- **A piece anchored inside a window-free band dodges the whole protected set — the
one-shot packing bridge.** Composes the band geometry with the Finset lift
`avoid_finset_of_offset_lt`. The ingredients a carrier step actually has on hand: the
per-piece footprint width `hoff` (`∀ cell ∈ pl.shapeUp, cell.1 < bound`), a scratch band
`[lo, hi]` that the entire protected set `W` lies outside (`hWout : ∀ a ∈ W, a < lo ∨
hi < a` — the well and all three windows sit clear of the band), and the anchor landing
inside the band so the footprint window `[pl.col, pl.col + bound)` fits within `[lo, hi]`
(`lo ≤ pl.col` and `pl.col + bound ≤ hi + 1`). The conclusion is the single dodge
`∀ cell ∈ pl.shapeUp, pl.col + cell.1 ∉ W` that
`colHeight_applyStep_skyline_allwindows_of_avoid` consumes. So once a piece is placed with
its footprint inside a window-free band, all three windows survive in their exact landing
shapes for free — this is the geometric heart of the existence half of the re-entry
obligation (#72), leaving only the packing fact that such a band always exists. -/
theorem avoid_finset_of_anchor_in_clear_band {pl : Placement} {W : Finset ℕ}
    {lo hi bound : ℕ}
    (hoff : ∀ cell ∈ pl.shapeUp, cell.1 < bound)
    (hWout : ∀ a ∈ W, a < lo ∨ hi < a)
    (hanchor_lo : lo ≤ pl.col)
    (hanchor_hi : pl.col + bound ≤ hi + 1) :
    ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ∉ W := by
  refine avoid_finset_of_offset_lt hoff ?_
  intro a ha
  rcases hWout a ha with h | h <;> omega

/-- **Four disjoint column blocks of widths 1, 4, 3, 3 need at least 11 columns — the
window-budget bound.** A purely combinatorial counting fact: any four pairwise-disjoint
Finsets `A, B, C, D` of cardinalities 1, 4, 3, 3 whose union lies inside `range cols`
force `11 ≤ cols`, because their disjoint union has card `1 + 4 + 3 + 3 = 11` and a subset
of `range cols` has card at most `cols`. Instantiated with `A` the empty well column, `B`
a flat-4 window, `C` an S-notch window and `D` a Z-notch window — the four landing sites a
single surface would need to present simultaneously to absorb every piece of the bag at one
fixed surface — this says such a surface needs `≥ 11` columns. On the standard `10`-wide
board that is impossible, so a carrier cannot present a well, a flat-4, an S-notch and a
Z-notch as four disjoint blocks at once. This formally retires the naive
three-simultaneous-disjoint-window surface carrier and forces the redesign toward windows
that share columns or are presented phase-conditionally per bag (the
`bagPhaseCarrier` model), or toward the explicit finite-cycle route. -/
theorem four_disjoint_blocks_card_le {cols : ℕ} {A B C D : Finset ℕ}
    (hA : A.card = 1) (hB : B.card = 4) (hC : C.card = 3) (hD : D.card = 3)
    (hAB : Disjoint A B) (hAC : Disjoint A C) (hAD : Disjoint A D)
    (hBC : Disjoint B C) (hBD : Disjoint B D) (hCD : Disjoint C D)
    (hsub : A ∪ B ∪ C ∪ D ⊆ Finset.range cols) :
    11 ≤ cols := by
  have e1 : (A ∪ B).card = A.card + B.card := Finset.card_union_of_disjoint hAB
  have e2 : ((A ∪ B) ∪ C).card = (A ∪ B).card + C.card :=
    Finset.card_union_of_disjoint (Finset.disjoint_union_left.mpr ⟨hAC, hBC⟩)
  have e3 : ((A ∪ B) ∪ C ∪ D).card = ((A ∪ B) ∪ C).card + D.card :=
    Finset.card_union_of_disjoint
      (Finset.disjoint_union_left.mpr ⟨Finset.disjoint_union_left.mpr ⟨hAD, hBD⟩, hCD⟩)
  have hle := Finset.card_le_card hsub
  rw [Finset.card_range] at hle
  omega

/-- **A well plus a single on-demand notch leaves `cols - 4` flat columns — the positive
budget for the phase-conditional carrier.** The constructive counterpoint to
`four_disjoint_blocks_card_le`: the redesign forced by that budget bound presents at most
two protected blocks at any one step — the empty well (`A`, card 1) and a single live notch
(`C`, card 3) for the next `S` or `Z`, not all three windows at once. Those two disjoint
blocks occupy exactly 4 columns, so on a board of width `cols` the flat shelf — the
complement `range cols \ (A ∪ C)` that absorbs every flat-compatible piece `O`, `I`, `T`,
`L`, `J` — has exactly `cols - 4` columns, and `4 ≤ cols`. On the standard 10-wide board
that leaves 6 flat columns, comfortably more than the width-4 footprint the widest flat
piece (`I`) needs. So where the naive three-disjoint-window carrier overflowed 10 columns,
the on-demand single-notch carrier fits with room to spare — formal confirmation that the
phase-conditional redesign is column-feasible. -/
theorem well_plus_notch_leaves_flat {cols : ℕ} {A C : Finset ℕ}
    (hA : A.card = 1) (hC : C.card = 3) (hAC : Disjoint A C)
    (hsub : A ∪ C ⊆ Finset.range cols) :
    4 ≤ cols ∧ (Finset.range cols \ (A ∪ C)).card = cols - 4 := by
  have huc : (A ∪ C).card = 4 := by rw [Finset.card_union_of_disjoint hAC, hA, hC]
  have hle := Finset.card_le_card hsub
  rw [Finset.card_range] at hle
  have hsd : (Finset.range cols \ (A ∪ C)).card = cols - 4 := by
    rw [Finset.card_sdiff, Finset.inter_eq_left.mpr hsub, Finset.card_range, huc]
  exact ⟨by omega, hsd⟩

/-- **A reserved well survives a single avoiding placement.** On a skyline whose
well column `w` is empty (`h w = 0`), hard-dropping any piece that avoids column
`w` keeps the well empty after clears. Specialises `colHeight_applyStep_le_of_not_col`
to the skyline carrier via `colHeight_skyline` and `Nat.le_zero`. This is the
single-step well-preservation fact; iterating it over a bag of avoiding
placements is what keeps a row from completing until the I-piece is dropped into
the well to trigger the scheduled clear. -/
theorem colHeight_applyStep_skyline_well_eq_zero {cfg : GameConfig} {h : ℕ → ℕ}
    {pl : Placement} {w : ℕ} (hw : w < cfg.cols) (hw0 : h w = 0)
    (havoid : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ w) :
    colHeight (pl.applyStep cfg (skyline cfg h)) w = 0 := by
  have hle := colHeight_applyStep_le_of_not_col (cfg := cfg) (b := skyline cfg h)
    (pl := pl) (j := w) havoid
  rw [colHeight_skyline hw, hw0] at hle
  exact Nat.le_zero.mp hle

/-- **A leftmost well survives any placement to its right.** On a skyline whose
well column `w` is empty, hard-dropping any piece whose anchor column `pl.col`
sits strictly right of the well (`w < pl.col`) keeps the well empty after clears.
Every occupied column is `pl.col + cell.1 ≥ pl.col > w`, so the placement
trivially avoids `w` (discharged by `omega`), and `colHeight_applyStep_skyline_well_eq_zero`
finishes. This is the piece-agnostic well-preservation step for the standard
reserved-well strategy where the well is the leftmost column and all packing
happens to its right. -/
theorem colHeight_applyStep_skyline_well_eq_zero_of_lt_col {cfg : GameConfig}
    {h : ℕ → ℕ} {pl : Placement} {w : ℕ} (hw : w < cfg.cols) (hw0 : h w = 0)
    (hlt : w < pl.col) :
    colHeight (pl.applyStep cfg (skyline cfg h)) w = 0 := by
  apply colHeight_applyStep_skyline_well_eq_zero hw hw0
  intro cell _
  omega

/-- **A reserved column survives an entire sequence of avoiding placements.** If
every placement in `pls` avoids column `j`, then folding the whole sequence of
place-and-clear steps leaves column `j` no taller than it started. This lifts the
single-step `colHeight_applyStep_le_of_not_col` to a full bag (or any list) by
list induction: the head step doesn't raise column `j` and the tail preserves the
bound. Unlike the skyline-specific well lemmas this holds for *arbitrary* boards,
so it survives the non-skyline intermediate states a bag passes through — exactly
what an over-a-bag reserved-well argument needs. -/
theorem colHeight_foldl_applyStep_le_of_not_col {cfg : GameConfig} (j : ℕ) :
    ∀ (pls : List Placement),
      (∀ pl ∈ pls, ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ j) →
      ∀ (b : Board),
        colHeight (pls.foldl (fun acc pl => pl.applyStep cfg acc) b) j ≤ colHeight b j := by
  intro pls
  induction pls with
  | nil => intro _ b; simp
  | cons pl rest ih =>
    intro h b
    simp only [List.foldl_cons]
    refine le_trans
      (ih (fun pl' hpl' => h pl' (List.mem_cons.mpr (Or.inr hpl'))) (pl.applyStep cfg b)) ?_
    exact colHeight_applyStep_le_of_not_col (h pl (List.mem_cons.mpr (Or.inl rfl)))

/-- **A skyline well stays empty across an entire bag.** Starting from a skyline
whose well column `w` is empty (`h w = 0`), playing any sequence `pls` of
placements that each avoid column `w` leaves the well empty after the whole
fold. Combines the over-a-bag bound `colHeight_foldl_applyStep_le_of_not_col`
with `colHeight_skyline` and `Nat.le_zero`. This is the bag-level
well-preservation guarantee — the well column never fills while the other
columns are being packed, so no row completes until an I-piece is dropped into
the well to trigger the scheduled clear. -/
theorem colHeight_foldl_applyStep_skyline_well_eq_zero {cfg : GameConfig} {h : ℕ → ℕ}
    {w : ℕ} (hw : w < cfg.cols) (hw0 : h w = 0) (pls : List Placement)
    (havoid : ∀ pl ∈ pls, ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ w) :
    colHeight (pls.foldl (fun acc pl => pl.applyStep cfg acc) (skyline cfg h)) w = 0 := by
  have hle := colHeight_foldl_applyStep_le_of_not_col (cfg := cfg) w pls havoid (skyline cfg h)
  rw [colHeight_skyline hw, hw0] at hle
  exact Nat.le_zero.mp hle

/-- **A well-empty fold never lowers any column — the fold-level height floor.** The
ascending companion to `colHeight_foldl_applyStep_le_of_not_col` (which caps an *avoided*
column from above): starting from a board whose reserved well `w` is empty
(`colHeight b w = 0`), folding any list of placements that each *avoid* `w` can only
*raise* every column `j`. Because the well is empty and each draw dodges it, no row ever
completes (`fullRows_place_eq_empty_of_well`), so every step is purely additive
(`colHeight_le_applyStep_of_no_fullRows`) — no line clear is ever triggered to pull a
column back down. The induction threads the well-emptiness invariant forward across the
fold: each step keeps `w` empty (`colHeight_applyStep_le_of_not_col`), so the next step's
no-clear discharge still fires. This is the monotonicity engine the tight per-prefix
survival of a reserved-well packing schedule needs: since the whole fold splits as
`take n ++ drop n` and the `drop n` tail still avoids the well, the prefix board embeds
height-wise into the full fold, so its surface peak is bounded by the *endpoint* surface
(here `base + 4` for the repack-raise) rather than the loose `+4` per-placement growth. -/
theorem colHeight_le_foldl_applyStep_of_well_empty {cfg : GameConfig} {w : ℕ}
    (hw : w < cfg.cols) (j : ℕ) :
    ∀ (pls : List Placement),
      (∀ pl ∈ pls, ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ w) →
      ∀ (b : Board), colHeight b w = 0 →
        colHeight b j ≤ colHeight (pls.foldl (fun acc pl => pl.applyStep cfg acc) b) j := by
  intro pls
  induction pls with
  | nil => intro _ b _; simp
  | cons pl rest ih =>
    intro havoid b hw0
    simp only [List.foldl_cons]
    have hpl_avoid : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ w :=
      havoid pl (List.mem_cons.mpr (Or.inl rfl))
    have hnoclear : fullRows cfg (pl.place b) = ∅ :=
      fullRows_place_eq_empty_of_well hw hw0 hpl_avoid
    have hstep : colHeight b j ≤ colHeight (pl.applyStep cfg b) j :=
      colHeight_le_applyStep_of_no_fullRows hnoclear j
    have hw0' : colHeight (pl.applyStep cfg b) w = 0 := by
      have hle := colHeight_applyStep_le_of_not_col (cfg := cfg) (b := b) (j := w) hpl_avoid
      omega
    have hrest := ih (fun pl' hpl' => havoid pl' (List.mem_cons.mpr (Or.inr hpl')))
      (pl.applyStep cfg b) hw0'
    exact le_trans hstep hrest

/-- A hard-dropped piece reaches at most its drop offset plus the height of the
piece's 4-tall bounding box. Every dropped cell sits at row `dropOffset + cell.2`
with `cell.2 ≤ 3`, so the resulting column height is bounded by `dropOffset + 4`.
The per-step height-accounting brick toward bounding non-well column growth. -/
theorem colHeight_dropped_le (b : Board) (pl : Placement) (j : ℕ) :
    colHeight (pl.dropped b) j ≤ pl.dropOffset b + 4 := by
  apply colHeight_le_of_forall_lt
  intro p hp
  rw [Placement.dropped_eq_image, Finset.mem_image] at hp
  obtain ⟨cell, hcell, hpeq⟩ := hp
  have hsup : pl.shapeUp.sup (·.2) ≤ 3 := Piece.shapeUp_sup_row_le_three pl.piece pl.rot
  have hcell2 : cell.2 ≤ 3 := le_trans (Finset.le_sup (f := (·.2)) hcell) hsup
  have hp2 : p.2 = pl.dropOffset b + cell.2 := by rw [← hpeq]
  omega

/-- The drop offset is bounded by the maximum column height among the columns
the piece occupies. Since `dropOffset = sup (colHeight (col+cell.1) - cell.2)`
and subtraction only lowers each term, the offset never exceeds the plain sup of
those column heights. Combined with `colHeight_dropped_le`, this bounds a
dropped piece's height by `(max occupied column height) + 4`. -/
theorem dropOffset_le_sup_colHeight (b : Board) (pl : Placement) :
    pl.dropOffset b ≤ pl.shapeUp.sup (fun cell => b.colHeight (pl.col + cell.1)) := by
  rw [Placement.dropOffset_eq_sup]
  apply Finset.sup_mono_fun
  intro cell _
  exact Nat.sub_le _ _

/-- **Per-step height ceiling.** On a board whose every column height is at most
`H`, hard-dropping any piece lands it at height at most `H + 4`: the drop offset
is bounded by the max occupied column height (`dropOffset_le_sup_colHeight`), and
the piece's bounding box adds at most `4` (`colHeight_dropped_le`). This is the
"each piece raises the profile by at most 4" brick toward the per-bag height
bound (#74). -/
theorem colHeight_dropped_le_of_colHeight_le {b : Board} {pl : Placement} {H : ℕ}
    (hH : ∀ j, colHeight b j ≤ H) (j : ℕ) :
    colHeight (pl.dropped b) j ≤ H + 4 := by
  refine le_trans (colHeight_dropped_le b pl j) (Nat.add_le_add_right ?_ 4)
  refine le_trans (dropOffset_le_sup_colHeight b pl) ?_
  exact Finset.sup_le (fun cell _ => hH (pl.col + cell.1))

/-- **Low-surface piece bound: the dropped piece fits under a ceiling already 4 above
the surface.** If every column of `b` sits at least `4` below `H`
(`∀ j, colHeight b j + 4 ≤ H`), then the hard-dropped piece reaches no higher than `H`
in any column — its bounding box adds at most `4` on top of the (≤ `H − 4`) surface
(`colHeight_dropped_le_of_colHeight_le`). The `hsurf` hypothesis forces `H ≥ 4` (column
heights are `≥ 0`), so `(H − 4) + 4 = H`. This is the bridge that discharges the
piece-bound obligation `hp` of the flat-ceiling carrier closure
(`colHeight_applyStep_skyline_le_of_avoid_well`) from a *pure surface condition*: keep
the skyline ≥ 4 below the ceiling and no draw can poke through it, no per-piece shape
reasoning required. -/
theorem colHeight_dropped_le_of_colHeight_add_le {b : Board} {pl : Placement} {H : ℕ}
    (hH : ∀ j, colHeight b j + 4 ≤ H) (j : ℕ) :
    colHeight (pl.dropped b) j ≤ H := by
  have hsub : ∀ k, colHeight b k ≤ H - 4 := fun k => by have := hH k; omega
  have hd := colHeight_dropped_le_of_colHeight_le (pl := pl) hsub j
  have h4 : 4 ≤ H := by have := hH j; omega
  omega

/-- **Surface-only flat-ceiling closure — the per-bag-foldable height brick.**
Collapsing both obligations of `colHeight_applyStep_skyline_le_of_avoid_well` into a
*single* surface condition: if a reserved-well skyline sits at least `4` below the
ceiling everywhere (`∀ j, colHeight (skyline cfg h) j + 4 ≤ H`), then any placement that
merely avoids the well leaves every column `≤ H` after the full step — no separate
piece-bound, no per-piece shape `decide`. The surface bound discharges the board-height
half directly (`colHeight ≤ colHeight + 4 ≤ H`) and the piece half through the
low-surface dropped bound (`colHeight_dropped_le_of_colHeight_add_le`): a piece can rise
at most `4` above a surface already `4` under `H`, so it cannot top out. This is the
clean height-bounded step for a reserved-well carrier — directly iterable over a whole
bag (every well-avoiding draw keeps the skyline `≤ H`), the tight, well-aware companion
to the loose per-bag `H + 4k` growth bound (`colHeight_foldl_applyStep_le`). -/
theorem colHeight_applyStep_skyline_le_of_avoid_well_of_surface {cfg : GameConfig}
    {h : ℕ → ℕ} {pl : Placement} {w H : ℕ} (hw : w < cfg.cols) (hh0 : h w = 0)
    (havoidw : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ w)
    (hsurf : ∀ j, colHeight (skyline cfg h) j + 4 ≤ H) (j : ℕ) :
    colHeight (pl.applyStep cfg (skyline cfg h)) j ≤ H :=
  colHeight_applyStep_skyline_le_of_avoid_well hw hh0 havoidw
    (fun k => le_trans (Nat.le_add_right _ 4) (hsurf k))
    (fun k => colHeight_dropped_le_of_colHeight_add_le (pl := pl) hsurf k) j

/-- **Surface-only flat-ceiling closure on *any* board with an empty well.** The
skyline-free generalisation of `colHeight_applyStep_skyline_le_of_avoid_well_of_surface`:
the carrier step needs only that the well column is empty (`colHeight b w = 0`), not that
the whole board is a literal `skyline cfg h`. Given a surface sitting at least `4` below
the ceiling everywhere (`∀ j, colHeight b j + 4 ≤ H`) and a placement that avoids the
well, the post-step board stays `≤ H` in every column. Built from the general no-clear
discharge (`fullRows_place_eq_empty_of_well`) feeding the tight no-growth ceiling
(`colHeight_applyStep_le_of_no_fullRows`), with the board half (`colHeight ≤ +4 ≤ H`) and
the piece half (`colHeight_dropped_le_of_colHeight_add_le`) discharged from the single
surface bound. This is the single-step tight ceiling that survives the *non-skyline*
intermediate boards a bag passes through — the height companion to the arbitrary-board
well-preservation step (`colHeight_applyStep_le_of_not_col`). NB this single step is
sound; the fixed-`H` *fold* still hits the margin-shrink wall (a no-clear step can lift
the surface from `H−4` to `H`), so a per-bag tight ceiling needs structural re-entry
(post-board = bounded skyline), the genuine #72 core. -/
theorem colHeight_applyStep_le_of_well_empty_of_surface {cfg : GameConfig} {b : Board}
    {pl : Placement} {w H : ℕ} (hw : w < cfg.cols) (hw0 : colHeight b w = 0)
    (havoidw : ∀ cell ∈ pl.shapeUp, pl.col + cell.1 ≠ w)
    (hsurf : ∀ j, colHeight b j + 4 ≤ H) (j : ℕ) :
    colHeight (pl.applyStep cfg b) j ≤ H :=
  colHeight_applyStep_le_of_no_fullRows
    (fullRows_place_eq_empty_of_well hw hw0 havoidw)
    (fun k => le_trans (Nat.le_add_right _ 4) (hsurf k))
    (fun k => colHeight_dropped_le_of_colHeight_add_le (pl := pl) hsurf k) j

/-- **Per-step height ceiling, lifted through `applyStep`.** A board whose every
column height is at most `H` still has every column height at most `H + 4` after
one full piece step (drop + line clear): line clears only lower the surviving
heights, so the post-step height is bounded by `max H (H+4) = H + 4` via
`colHeight_applyStep_le_max` and the dropped-piece ceiling
(`colHeight_dropped_le_of_colHeight_le`). The single-step inductive engine for
the per-bag aggregate height bound (#74). -/
theorem colHeight_applyStep_le_of_colHeight_le {cfg : GameConfig} {b : Board}
    {pl : Placement} {H : ℕ} (hH : ∀ j, colHeight b j ≤ H) (j : ℕ) :
    colHeight (pl.applyStep cfg b) j ≤ H + 4 := by
  refine le_trans (colHeight_applyStep_le_max b pl j) (max_le ?_ ?_)
  · exact le_trans (hH j) (Nat.le_add_right H 4)
  · exact colHeight_dropped_le_of_colHeight_le hH j

/-- **Per-bag aggregate height bound (#74).** Playing a list of `k` placements
from a board whose every column height is at most `H` leaves every column height
at most `H + 4 * k`: each piece raises the ceiling by at most `4`
(`colHeight_applyStep_le_of_colHeight_le`), so `k` pieces add at most `4 * k`. By
list induction, threading the growing bound `H + 4` into the tail. With `k = 7`
this caps a single 7-bag's growth at `H + 28`. -/
theorem colHeight_foldl_applyStep_le {cfg : GameConfig} (pls : List Placement) :
    ∀ {b : Board} {H : ℕ}, (∀ j, colHeight b j ≤ H) →
      ∀ j, colHeight (pls.foldl (fun acc pl => pl.applyStep cfg acc) b) j
        ≤ H + 4 * pls.length := by
  induction pls with
  | nil =>
    intro b H hH j
    simpa using hH j
  | cons pl rest ih =>
    intro b H hH j
    simp only [List.foldl_cons, List.length_cons]
    have hstep : ∀ j, colHeight (pl.applyStep cfg b) j ≤ H + 4 :=
      fun j => colHeight_applyStep_le_of_colHeight_le hH j
    have hrest := ih (b := pl.applyStep cfg b) (H := H + 4) hstep j
    omega

/-- **Height budget rules out loss over a whole bag.** If a board's columns all
sit at height at most `H` and the budget `H + 4 * k` (room for `k` pieces, each
adding at most `4`) still fits under `cfg.rows`, then no prefix-respecting play of
`k` placements tops out: the final board is not lost. Combines the per-bag height
bound (`colHeight_foldl_applyStep_le`) with `not_isLost_of_colHeight_le`. This is
the loss-freedom half of the bag-indexed survival invariant (#66). -/
theorem not_isLost_foldl_applyStep_of_colHeight_le {cfg : GameConfig} {b : Board}
    {H : ℕ} (hH : ∀ j, colHeight b j ≤ H) (pls : List Placement)
    (hcap : H + 4 * pls.length ≤ cfg.rows) :
    ¬ isLost cfg (pls.foldl (fun acc pl => pl.applyStep cfg acc) b) := by
  apply not_isLost_of_colHeight_le
  intro j
  exact le_trans (colHeight_foldl_applyStep_le pls hH j) hcap

/-- **Transient (every-prefix) loss-freedom over a bag.** Strengthens
`not_isLost_foldl_applyStep_of_colHeight_le` from the bag ENDPOINT to *every*
prefix: under the same `H + 4 * pls.length ≤ cfg.rows` budget, no `take n` prefix
of the placement list tops out. Survival is a transient property — the board must
be un-lost at each intermediate drop, not merely at the final one — so this is the
form a per-bag survival schedule actually consumes. Proof: a prefix is no longer
than the whole list (`length_take_le'`), so the same budget covers it, and the
endpoint lemma applied to `pls.take n` finishes. This is the loss-freedom companion
to the scalar transient bound `maxColHeight_foldl_take_applyStep_le` (#80). -/
theorem not_isLost_foldl_take_applyStep_of_colHeight_le {cfg : GameConfig} {b : Board}
    {H : ℕ} (hH : ∀ j, colHeight b j ≤ H) (pls : List Placement)
    (hcap : H + 4 * pls.length ≤ cfg.rows) (n : ℕ) :
    ¬ isLost cfg ((pls.take n).foldl (fun acc pl => pl.applyStep cfg acc) b) := by
  have hlen : (pls.take n).length ≤ pls.length := List.length_take_le' n pls
  exact not_isLost_foldl_applyStep_of_colHeight_le hH (pls.take n) (by omega)

/-- **Skyline survival entry point.** The carrier-shaped reading of
`not_isLost_foldl_take_applyStep_of_colHeight_le`: starting from *any* skyline whose
profile is bounded by `B` on real columns, if the headroom `B + 4 * pls.length` fits
under `cfg.rows`, then every prefix of any placement schedule stays un-lost. This is
the form a surface carrier closure quotes directly — its state is a skyline with
profile `≤ base`, so `B := base` and the per-bag loss-freedom obligation of
`WinningTo … piecesPerBag` is discharged for the whole bag at once (height schedule
permitting). Proof: a skyline's column height *is* its profile on real columns and
`0` off-field, so the profile bound lifts to a `colHeight` bound, then `take`-ABED. -/
theorem not_isLost_foldl_take_applyStep_skyline {cfg : GameConfig} {h : ℕ → ℕ} {B : ℕ}
    (hh : ∀ j < cfg.cols, h j ≤ B) (pls : List Placement)
    (hcap : B + 4 * pls.length ≤ cfg.rows) (n : ℕ) :
    ¬ isLost cfg
      ((pls.take n).foldl (fun acc pl => pl.applyStep cfg acc) (skyline cfg h)) := by
  have hH : ∀ j, colHeight (skyline cfg h) j ≤ B := by
    intro j
    by_cases hj : j < cfg.cols
    · rw [colHeight_skyline hj]; exact hh j hj
    · rw [colHeight_skyline_eq_zero (Nat.le_of_not_lt hj)]; exact Nat.zero_le _
  exact not_isLost_foldl_take_applyStep_of_colHeight_le hH pls hcap n

/-- **Bag-endpoint loss-freedom from a bounded skyline.** The endpoint companion to
`not_isLost_foldl_take_applyStep_skyline`: where that lemma certifies every *prefix* of a
placement schedule stays un-lost, this certifies the *final* folded board. Both share the
headroom budget `B + 4 * pls.length ≤ cfg.rows` — a skyline whose profile is `≤ B` on real
columns, played out by any list of placements that each raise the surface by at most four,
lands below `cfg.rows` after the whole fold. Proof: the skyline's column height is its
profile on real columns and `0` off-field, lifting the profile bound to a `colHeight ≤ B`
bound, then the general-board endpoint lemma (`not_isLost_foldl_applyStep_of_colHeight_le`)
discharges the fold. This is the bag-closing half a per-bag survival schedule quotes once
the prefix peaks are handled — the board the next bag (or a scheduled well-clear) inherits
is certified safe. -/
theorem not_isLost_foldl_applyStep_skyline {cfg : GameConfig} {h : ℕ → ℕ} {B : ℕ}
    (hh : ∀ j < cfg.cols, h j ≤ B) (pls : List Placement)
    (hcap : B + 4 * pls.length ≤ cfg.rows) :
    ¬ isLost cfg (pls.foldl (fun acc pl => pl.applyStep cfg acc) (skyline cfg h)) := by
  have hH : ∀ j, colHeight (skyline cfg h) j ≤ B := by
    intro j
    by_cases hj : j < cfg.cols
    · rw [colHeight_skyline hj]; exact hh j hj
    · rw [colHeight_skyline_eq_zero (Nat.le_of_not_lt hj)]; exact Nat.zero_le _
  exact not_isLost_foldl_applyStep_of_colHeight_le hH pls hcap

/-- **Clearing a fully-packed board resets it to empty.** If every filled cell of
`b` lies in a complete row, then line-clearing removes every cell: the surviving
filter (cells in non-full rows) is empty, so the gravity image is empty too. This
is the height-reset cornerstone — once play packs a slab of full rows, the clear
returns the board to height `0`, the only way to keep the per-bag height budget
(`not_isLost_foldl_applyStep_of_colHeight_le`) from running out over many bags. -/
theorem clearLines_eq_empty_of_forall_isFull {cfg : GameConfig} {b : Board}
    (h : ∀ p ∈ b, isFull cfg b p.2) :
    clearLines cfg b = ∅ := by
  unfold clearLines
  rw [Finset.image_eq_empty, Finset.filter_eq_empty_iff]
  intro p hp
  exact not_not.mpr (h p hp)

/-- **Height reset to zero.** The directly-usable corollary of
`clearLines_eq_empty_of_forall_isFull`: clearing a board whose every cell lies in
a full row drops every column to height `0`. This is the form a height-bounded
invariant `P` consumes to re-establish itself from scratch after a slab clear —
the board returns to the empty profile, so any `colHeight … ≤ H` precondition
holds again with room to spare. -/
theorem colHeight_clearLines_eq_zero_of_forall_isFull {cfg : GameConfig} {b : Board}
    (h : ∀ p ∈ b, isFull cfg b p.2) (j : ℕ) :
    colHeight (clearLines cfg b) j = 0 := by
  rw [clearLines_eq_empty_of_forall_isFull h]
  exact Tetris.Board.colHeight_empty j

/-- **The cell count resets to zero.** The cardinality face of the reset trio,
joining `colHeight_clearLines_eq_zero_of_forall_isFull` (here) and
`maxColHeight_clearLines_eq_zero_of_forall_isFull` (with the other potential
lemmas): clearing a board whose every cell lies in a full row wipes it to `∅`
(`clearLines_eq_empty_of_forall_isFull`), which holds no cells. This is the
area-ledger endpoint of a full-slab clear — the `card` the packing route tracks
(`card_foldl_applyStep_le`) collapses to `0`, so the area budget is fully refunded
the instant a packed slab clears. -/
theorem card_clearLines_eq_zero_of_forall_isFull {cfg : GameConfig} {b : Board}
    (h : ∀ p ∈ b, isFull cfg b p.2) :
    (clearLines cfg b).card = 0 := by
  rw [clearLines_eq_empty_of_forall_isFull h]
  exact Finset.card_empty

/-- **The wiping step.** If a placement fills `b` so that every cell of the placed
board `pl.place b` lies in a complete row, then the full piece step (drop + clear)
returns every column to height `0`. This is the I-into-the-well drop that
completes a slab and clears it: the line clear inside `applyStep` wipes the board
(`colHeight_clearLines_eq_zero_of_forall_isFull`). The single-step realisation of
the height reset that closes a reserved-well survival cycle. -/
theorem colHeight_applyStep_eq_zero_of_place_forall_isFull {cfg : GameConfig}
    {b : Board} {pl : Placement}
    (h : ∀ p ∈ pl.place b, isFull cfg (pl.place b) p.2) (j : ℕ) :
    colHeight (pl.applyStep cfg b) j = 0 := by
  rw [Placement.applyStep_eq_clearLines_place]
  exact colHeight_clearLines_eq_zero_of_forall_isFull h j

/-- **The full rectangle is a full slab.** Every cell of the complete grid
`range cfg.cols ×ˢ range h` lies in a complete row: each row `r < h` contains all
columns `c < cfg.cols`. This is the place-side achievability witness — the board
state right after an I-piece tops off a reserved well, with all nine packed
columns and the well filled to height `h` — that the wiping step
(`colHeight_applyStep_eq_zero_of_place_forall_isFull`) consumes to clear back to
the empty profile. -/
theorem full_grid_forall_isFull {cfg : GameConfig} (h : ℕ) :
    ∀ p ∈ Finset.range cfg.cols ×ˢ Finset.range h,
      isFull cfg (Finset.range cfg.cols ×ˢ Finset.range h) p.2 := by
  intro p hp
  simp only [Finset.mem_product, Finset.mem_range] at hp
  intro c hc
  simp only [Finset.mem_product, Finset.mem_range]
  exact ⟨Finset.mem_range.mp hc, hp.2⟩

/-- **The full rectangle is the constant skyline.** The complete grid
`range cfg.cols ×ˢ range h` is exactly `skyline cfg (fun _ => h)`: both contain
`(j, r)` precisely when `j < cfg.cols` and `r < h`. This bridge transports the
entire skyline toolkit (`colHeight_skyline` giving height `h` on real columns, the
bounded/reserved-well carriers) onto the full-grid clear machinery
(`full_grid_forall_isFull`, the wiping step), so "pack all columns to height `h`"
and "clear the full slab" speak the same representation. -/
theorem skyline_const_eq_full_grid {cfg : GameConfig} (h : ℕ) :
    skyline cfg (fun _ => h) = Finset.range cfg.cols ×ˢ Finset.range h := by
  ext ⟨j, r⟩
  rw [mem_skyline]
  simp only [Finset.mem_product, Finset.mem_range]

/-- **Column height of the full grid.** Every real column `j < cfg.cols` of the
complete grid `range cfg.cols ×ˢ range h` has height exactly `h`. A free corollary
of `skyline_const_eq_full_grid` (the grid is the constant skyline) composed with
`colHeight_skyline` (a skyline's height recovers its profile). This is the
height-accounting endpoint of the reset chain: after a full-slab clear the board
is empty (height `0`), and the full slab itself sits at uniform height `h`. -/
theorem colHeight_full_grid {cfg : GameConfig} {h : ℕ} {j : ℕ} (hj : j < cfg.cols) :
    Board.colHeight (Finset.range cfg.cols ×ˢ Finset.range h) j = h := by
  rw [← skyline_const_eq_full_grid]
  exact colHeight_skyline hj

/-! ## Per-piece closure: the vertical I piece

The first closure brick. The vertical I tetromino (`Piece.I` at rotation `1`)
occupies a single column, so hard-dropping it on a skyline never creates a hole
and simply raises that one column's profile by `4`. This is the cleanest closure
step — no flatness precondition is required — and it validates that the skyline
abstraction supports the kind of `place`-closure reasoning a surface invariant's
`hstep` obligation needs. -/

/-- The vertical I piece's drop profile is a single column of four cells. -/
theorem shapeUp_vertI (c : ℕ) :
    ({ piece := Piece.I, rot := 1, col := c } : Placement).shapeUp
      = {((0 : ℕ), (0 : ℕ)), (0, 1), (0, 2), (0, 3)} := by
  show Piece.shapeUp Piece.I 1 = _
  decide

/-- **Vertical-I hard-drop offset on a skyline.** Because the piece is one column
wide, its hard-drop offset is exactly the profile height of its target column. -/
theorem dropOffset_vertI_skyline {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) :
    Placement.dropOffset (skyline cfg h) { piece := Piece.I, rot := 1, col := c } = h c := by
  rw [Placement.dropOffset_eq_sup, shapeUp_vertI]
  simp only [Finset.sup_insert, Finset.sup_singleton, Nat.add_zero, Nat.sub_zero]
  rw [colHeight_skyline hc]
  omega

/-- **The cells dropped by a vertical I onto a skyline.** They land in the target
column `c`, stacked on top of its current profile height: rows `h c … h c + 3`. -/
theorem mem_dropped_vertI_skyline {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (j r : ℕ) :
    (j, r) ∈ Placement.dropped (skyline cfg h) { piece := Piece.I, rot := 1, col := c }
      ↔ j = c ∧ h c ≤ r ∧ r < h c + 4 := by
  rw [Placement.dropped_eq_image, dropOffset_vertI_skyline hc, shapeUp_vertI]
  simp only [Finset.mem_image, Finset.mem_insert, Finset.mem_singleton, Prod.mk.injEq]
  constructor
  · rintro ⟨a, ha, haj, har⟩
    rcases ha with rfl | rfl | rfl | rfl <;> dsimp only at haj har <;> omega
  · rintro ⟨hj, hge, hlt⟩
    refine ⟨(0, r - h c), ?_, ?_, ?_⟩
    · rcases (by omega : r - h c = 0 ∨ r - h c = 1 ∨ r - h c = 2 ∨ r - h c = 3) with
        h | h | h | h <;> rw [h] <;> simp
    · dsimp only; omega
    · dsimp only; omega

/-- **Vertical-I closure on a skyline.** Placing the vertical I piece on column
`c` of a skyline yields the skyline of the profile with column `c` raised by `4`,
every other column unchanged. The decisive content — that the result is *again a
skyline* (hence still hole-free) — holds with no flatness precondition because
the piece is one column wide. This is the prototype `place`-closure step a
surface invariant is built from. -/
theorem place_vertI_skyline {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ} (hc : c < cfg.cols) :
    Placement.place (skyline cfg h) { piece := Piece.I, rot := 1, col := c }
      = skyline cfg (Function.update h c (h c + 4)) := by
  ext ⟨j, r⟩
  simp only [Placement.place_eq_union_dropped, Finset.mem_union,
             mem_dropped_vertI_skyline hc, mem_skyline]
  by_cases hjc : j = c
  · subst hjc
    rw [Function.update_self]
    omega
  · rw [Function.update_of_ne hjc]
    constructor
    · rintro (hl | ⟨heq, _⟩)
      · exact hl
      · exact absurd heq hjc
    · exact fun hl => Or.inl hl

/-- **A no-clear vertical-I placement adds exactly four cells.** Hard-dropping the
vertical I on a real column raises that column's profile by `4` and leaves every
other column fixed (`place_vertI_skyline`), so the filled-cell count rises by
exactly `4` (`card_skyline` plus `Finset.sum_update_of_mem`). The cell-conservation
law for the simplest piece: every placement injects four cells, and only line
clears ever remove them — the quantitative engine behind the bag-level accounting
(28 cells per 7-bag must be balanced by clears). -/
theorem card_place_vertI_skyline {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) :
    (Placement.place (skyline cfg h) { piece := Piece.I, rot := 1, col := c }).card
      = (skyline cfg h).card + 4 := by
  have hc' : c ∈ Finset.range cfg.cols := Finset.mem_range.mpr hc
  rw [place_vertI_skyline hc, card_skyline, card_skyline,
    Finset.sum_update_of_mem hc', ← Finset.add_sum_erase (Finset.range cfg.cols) h hc',
    Finset.erase_eq]
  omega

/-- **Vertical-I full-move closure on a skyline.** Composing the hard-drop
(`place_vertI_skyline`) with gravity (`clearLines_skyline`): a complete move
(`applyStep` = drop then clear) of the vertical I on column `c` of a skyline
yields the skyline of the column-`c`-raised profile, dropped uniformly by the new
minimum profile height `m`. The result is *again a skyline* — exactly the closure
shape a surface invariant's `hstep` obligation needs, now for a full move rather
than a bare placement. `m` is supplied abstractly as the real-column minimum of
the raised profile via `hm` (lower bound) and `hm0` (achieved). -/
theorem applyStep_vertI_skyline {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ} (hc : c < cfg.cols)
    {m : ℕ}
    (hm : ∀ j < cfg.cols, m ≤ Function.update h c (h c + 4) j)
    (hm0 : ∃ j < cfg.cols, Function.update h c (h c + 4) j = m) :
    Placement.applyStep cfg (skyline cfg h) { piece := Piece.I, rot := 1, col := c }
      = skyline cfg (fun j => Function.update h c (h c + 4) j - m) := by
  rw [Placement.applyStep_eq_clearLines_place, place_vertI_skyline hc,
    clearLines_skyline hm hm0]

/-! ## Per-piece closure: the O piece

The O tetromino is a 2×2 block occupying columns `c, c+1`. Unlike the vertical I,
it spans two columns, so hard-dropping it cleanly (no hole) requires those two
columns to be **flat** — equal profile heights `h c = h (c+1)`. On a flat pair it
rests squarely, raising both columns by `2` and yielding another skyline. This is
the first closure brick that needs a flatness precondition, making explicit that a
surface invariant must track local flatness, not merely hole-freeness. -/

/-- The O piece's drop profile is the 2×2 block. -/
theorem shapeUp_O (c : ℕ) :
    ({ piece := Piece.O, rot := 0, col := c } : Placement).shapeUp
      = {((0 : ℕ), (0 : ℕ)), (0, 1), (1, 0), (1, 1)} := by
  show Piece.shapeUp Piece.O 0 = _
  decide

/-- **O hard-drop offset on a flat skyline.** When the two target columns share a
profile height, the drop offset is that common height. -/
theorem dropOffset_O_skyline {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (heq : h c = h (c + 1)) :
    Placement.dropOffset (skyline cfg h) { piece := Piece.O, rot := 0, col := c } = h c := by
  rw [Placement.dropOffset_eq_sup, shapeUp_O]
  simp only [Finset.sup_insert, Finset.sup_singleton, Nat.add_zero, Nat.sub_zero]
  rw [colHeight_skyline hc, colHeight_skyline hc1]
  omega

/-- **The cells dropped by an O onto a flat skyline.** They occupy columns `c` and
`c+1`, each stacked on the common profile height: rows `h c … h c + 1`. -/
theorem mem_dropped_O_skyline {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (heq : h c = h (c + 1)) (j r : ℕ) :
    (j, r) ∈ Placement.dropped (skyline cfg h) { piece := Piece.O, rot := 0, col := c }
      ↔ (j = c ∨ j = c + 1) ∧ h c ≤ r ∧ r < h c + 2 := by
  rw [Placement.dropped_eq_image, dropOffset_O_skyline hc hc1 heq, shapeUp_O]
  simp only [Finset.mem_image, Finset.mem_insert, Finset.mem_singleton, Prod.mk.injEq]
  constructor
  · rintro ⟨a, ha, haj, har⟩
    rcases ha with rfl | rfl | rfl | rfl <;> dsimp only at haj har <;> omega
  · rintro ⟨hj, hge, hlt⟩
    rcases hj with hj | hj
    · refine ⟨(0, r - h c), ?_, ?_, ?_⟩
      · rcases (by omega : r - h c = 0 ∨ r - h c = 1) with hh | hh <;> rw [hh] <;> simp
      · dsimp only; omega
      · dsimp only; omega
    · refine ⟨(1, r - h c), ?_, ?_, ?_⟩
      · rcases (by omega : r - h c = 0 ∨ r - h c = 1) with hh | hh <;> rw [hh] <;> simp
      · dsimp only; omega
      · dsimp only; omega

/-- **O closure on a flat skyline.** Placing the O piece on a flat column pair
`c, c+1` of a skyline yields the skyline of the profile with both columns raised by
`2`. The result is *again a skyline* (hole-free) precisely because of the flatness
precondition `h c = h (c+1)`; without it the piece bridges a step and traps a hole.
This is the prototype flatness-gated `place`-closure step. -/
theorem place_O_skyline {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (heq : h c = h (c + 1)) :
    Placement.place (skyline cfg h) { piece := Piece.O, rot := 0, col := c }
      = skyline cfg (Function.update (Function.update h c (h c + 2)) (c + 1) (h c + 2)) := by
  ext ⟨j, r⟩
  simp only [Placement.place_eq_union_dropped, Finset.mem_union,
             mem_dropped_O_skyline hc hc1 heq, mem_skyline]
  by_cases hjc : j = c
  · rw [hjc, Function.update_of_ne (by omega : c ≠ c + 1), Function.update_self]
    omega
  · by_cases hjc1 : j = c + 1
    · rw [hjc1, Function.update_self]
      omega
    · rw [Function.update_of_ne hjc1, Function.update_of_ne hjc]
      omega

/-- **An O placement raises every column by at most two.** On the flat shelf it
needs, the O lifts its two landing columns by exactly `2` and leaves all others
fixed, so no column's height grows by more than `2`. This is the *growth* counter
to the well clear's `−4` headroom (`colHeight_applyStep_vertI_well_le`): an
ordinary flat-shelf placement spends at most two of the four rows of slack a clear
manufactures, so a clear can absorb at least two such placements before the
surface returns to its pre-clear ceiling — the per-move debit in the height
ledger. (T, L, J, horizontal-I share this `≤ 2` bound; the vertical I, reserved
for the well, is the lone `+4` regulator.) -/
theorem colHeight_place_O_skyline_le {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (heq : h c = h (c + 1))
    {j : ℕ} (hj : j < cfg.cols) :
    colHeight (Placement.place (skyline cfg h) { piece := Piece.O, rot := 0, col := c }) j
      ≤ h j + 2 := by
  rw [place_O_skyline hc hc1 heq, colHeight_skyline hj]
  by_cases hjc : j = c
  · rw [hjc, Function.update_of_ne (by omega : c ≠ c + 1), Function.update_self]
  · by_cases hjc1 : j = c + 1
    · rw [hjc1, Function.update_self]; omega
    · rw [Function.update_of_ne hjc1, Function.update_of_ne hjc]; omega

/-! ### S-piece absorption (the staircase brick)

`S` (and its mirror `Z`) is the obstruction Burgiel exploits: on a *flat* surface
it always traps a hole. The positive content — the keystone any affirmative
invariant needs — is that on the right **staircase notch** it instead lands
flush. For `S` at rotation `0` the drop profile is
```
.##   row 1: cols c+1, c+2
##.   row 0: cols c,   c+1
```
so it sits hole-free exactly on the notch `h c = h (c+1)` with `h (c+2) = h c + 1`
(two level columns, then a single step up). The placement maps the profile
`(k, k, k+1) ↦ (k+1, k+2, k+2)` — four cells, no hole, still a skyline. This is
the brick that lets a surface invariant *absorb* the bag's forced `S`. -/

/-- The S piece (rotation 0) drop profile, bottom-up. -/
theorem shapeUp_S (c : ℕ) :
    ({ piece := Piece.S, rot := 0, col := c } : Placement).shapeUp
      = {((0 : ℕ), (0 : ℕ)), (1, 0), (1, 1), (2, 1)} := by
  show Piece.shapeUp Piece.S 0 = _
  decide

/-- **S hard-drop offset on its notch.** With the staircase notch
`h c = h (c+1)`, `h (c+2) = h c + 1`, the drop offset is the base height `h c`. -/
theorem dropOffset_S_skyline {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (heq : h c = h (c + 1)) (hstep : h (c + 2) = h c + 1) :
    Placement.dropOffset (skyline cfg h) { piece := Piece.S, rot := 0, col := c } = h c := by
  rw [Placement.dropOffset_eq_sup, shapeUp_S]
  simp only [Finset.sup_insert, Finset.sup_singleton, Nat.add_zero, Nat.sub_zero]
  rw [colHeight_skyline hc, colHeight_skyline hc1, colHeight_skyline hc2]
  omega

/-- **The cells dropped by an S onto its notch.** Column `c` gets row `h c`,
column `c+1` gets rows `h c` and `h c + 1`, column `c+2` gets row `h c + 1`. -/
theorem mem_dropped_S_skyline {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (heq : h c = h (c + 1)) (hstep : h (c + 2) = h c + 1) (j r : ℕ) :
    (j, r) ∈ Placement.dropped (skyline cfg h) { piece := Piece.S, rot := 0, col := c }
      ↔ (j = c ∧ r = h c) ∨ (j = c + 1 ∧ (r = h c ∨ r = h c + 1))
          ∨ (j = c + 2 ∧ r = h c + 1) := by
  rw [Placement.dropped_eq_image, dropOffset_S_skyline hc hc1 hc2 heq hstep, shapeUp_S]
  simp only [Finset.mem_image, Finset.mem_insert, Finset.mem_singleton, Prod.mk.injEq]
  constructor
  · rintro ⟨a, ha, haj, har⟩
    rcases ha with rfl | rfl | rfl | rfl <;> dsimp only at haj har <;> omega
  · rintro (⟨hj, hr⟩ | ⟨hj, hr⟩ | ⟨hj, hr⟩)
    · exact ⟨(0, 0), by simp, by dsimp only; omega, by dsimp only; omega⟩
    · rcases hr with hr | hr
      · exact ⟨(1, 0), by simp, by dsimp only; omega, by dsimp only; omega⟩
      · exact ⟨(1, 1), by simp, by dsimp only; omega, by dsimp only; omega⟩
    · exact ⟨(2, 1), by simp, by dsimp only; omega, by dsimp only; omega⟩

/-- **S closure on its notch.** Placing the S piece on the staircase notch
`h c = h (c+1)`, `h (c+2) = h c + 1` of a skyline yields the skyline of the
profile with `c ↦ h c + 1`, `c+1 ↦ h c + 2`, `c+2 ↦ h c + 2`. The result is
*again a skyline* (hole-free) precisely because of the notch precondition; on a
flat surface (`h (c+2) = h c`) the overhang would trap a hole. This is the
staircase-absorption brick. -/
theorem place_S_skyline {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (heq : h c = h (c + 1)) (hstep : h (c + 2) = h c + 1) :
    Placement.place (skyline cfg h) { piece := Piece.S, rot := 0, col := c }
      = skyline cfg (Function.update (Function.update (Function.update h c (h c + 1))
          (c + 1) (h c + 2)) (c + 2) (h c + 2)) := by
  ext ⟨j, r⟩
  simp only [Placement.place_eq_union_dropped, Finset.mem_union,
             mem_dropped_S_skyline hc hc1 hc2 heq hstep, mem_skyline]
  by_cases hjc : j = c
  · rw [hjc, Function.update_of_ne (by omega : c ≠ c + 2),
        Function.update_of_ne (by omega : c ≠ c + 1), Function.update_self]
    omega
  · by_cases hjc1 : j = c + 1
    · rw [hjc1, Function.update_of_ne (by omega : c + 1 ≠ c + 2), Function.update_self]
      omega
    · by_cases hjc2 : j = c + 2
      · rw [hjc2, Function.update_self]
        omega
      · rw [Function.update_of_ne hjc2, Function.update_of_ne hjc1, Function.update_of_ne hjc]
        omega

/-- **An S placement raises every column by at most two.** Even though the S needs
a staircase *notch* (`h c = h (c+1)`, `h (c+2) = h c + 1`) rather than a flat
shelf, its drop still lifts no column by more than `2`: `c ↦ +1`, `c+1 ↦ +2`, and
`c+2 ↦ +1` (relative to its own already-raised height). So the `≤ 2` per-column
debit extends to the first staircase piece — bringing six of the seven pieces
under the uniform height bound the bag-phase potential needs. -/
theorem colHeight_place_S_skyline_le {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (heq : h c = h (c + 1)) (hstep : h (c + 2) = h c + 1)
    {j : ℕ} (hj : j < cfg.cols) :
    colHeight (Placement.place (skyline cfg h) { piece := Piece.S, rot := 0, col := c }) j
      ≤ h j + 2 := by
  rw [place_S_skyline hc hc1 hc2 heq hstep, colHeight_skyline hj]
  by_cases hjc : j = c
  · rw [hjc, Function.update_of_ne (by omega : c ≠ c + 2),
        Function.update_of_ne (by omega : c ≠ c + 1), Function.update_self]
    omega
  · by_cases hjc1 : j = c + 1
    · rw [hjc1, Function.update_of_ne (by omega : c + 1 ≠ c + 2), Function.update_self]
      omega
    · by_cases hjc2 : j = c + 2
      · rw [hjc2, Function.update_self]
        omega
      · rw [Function.update_of_ne hjc2, Function.update_of_ne hjc1, Function.update_of_ne hjc]
        omega

/-! ### Z-piece absorption (the mirror staircase brick)

`Z` is the mirror of `S`. At rotation `0` its drop profile is
```
##.   row 1: cols c,   c+1
.##   row 0: cols c+1, c+2
```
so it lands flush on the *mirror* notch `h (c+1) = h (c+2)` with `h c = h (c+1) + 1`
(one high column, then two level). Writing `k = h (c+1)`, the placement maps the
profile `(k+1, k, k) ↦ (k+2, k+2, k+1)` — four cells, no hole, still a skyline.
Together with `place_S_skyline` this absorbs *both* of the bag's forced
hole-makers. -/

/-- The Z piece (rotation 0) drop profile, bottom-up. -/
theorem shapeUp_Z (c : ℕ) :
    ({ piece := Piece.Z, rot := 0, col := c } : Placement).shapeUp
      = {((0 : ℕ), (1 : ℕ)), (1, 0), (1, 1), (2, 0)} := by
  show Piece.shapeUp Piece.Z 0 = _
  decide

/-- **Z hard-drop offset on its mirror notch.** With `h (c+1) = h (c+2)` and
`h c = h (c+1) + 1`, the drop offset is the level height `h (c+1)`. -/
theorem dropOffset_Z_skyline {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (heq : h (c + 1) = h (c + 2)) (hstep : h c = h (c + 1) + 1) :
    Placement.dropOffset (skyline cfg h) { piece := Piece.Z, rot := 0, col := c }
      = h (c + 1) := by
  rw [Placement.dropOffset_eq_sup, shapeUp_Z]
  simp only [Finset.sup_insert, Finset.sup_singleton, Nat.add_zero, Nat.sub_zero]
  rw [colHeight_skyline hc, colHeight_skyline hc1, colHeight_skyline hc2]
  omega

/-- **The cells dropped by a Z onto its mirror notch.** Column `c` gets row
`h (c+1) + 1`, column `c+1` gets rows `h (c+1)` and `h (c+1) + 1`, column `c+2`
gets row `h (c+1)`. -/
theorem mem_dropped_Z_skyline {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (heq : h (c + 1) = h (c + 2)) (hstep : h c = h (c + 1) + 1) (j r : ℕ) :
    (j, r) ∈ Placement.dropped (skyline cfg h) { piece := Piece.Z, rot := 0, col := c }
      ↔ (j = c ∧ r = h (c + 1) + 1)
          ∨ (j = c + 1 ∧ (r = h (c + 1) ∨ r = h (c + 1) + 1))
          ∨ (j = c + 2 ∧ r = h (c + 1)) := by
  rw [Placement.dropped_eq_image, dropOffset_Z_skyline hc hc1 hc2 heq hstep, shapeUp_Z]
  simp only [Finset.mem_image, Finset.mem_insert, Finset.mem_singleton, Prod.mk.injEq]
  constructor
  · rintro ⟨a, ha, haj, har⟩
    rcases ha with rfl | rfl | rfl | rfl <;> dsimp only at haj har <;> omega
  · rintro (⟨hj, hr⟩ | ⟨hj, hr⟩ | ⟨hj, hr⟩)
    · exact ⟨(0, 1), by simp, by dsimp only; omega, by dsimp only; omega⟩
    · rcases hr with hr | hr
      · exact ⟨(1, 0), by simp, by dsimp only; omega, by dsimp only; omega⟩
      · exact ⟨(1, 1), by simp, by dsimp only; omega, by dsimp only; omega⟩
    · exact ⟨(2, 0), by simp, by dsimp only; omega, by dsimp only; omega⟩

/-- **Z closure on its mirror notch.** Placing the Z piece on the mirror notch
`h (c+1) = h (c+2)`, `h c = h (c+1) + 1` of a skyline yields the skyline of the
profile with `c ↦ h (c+1) + 2`, `c+1 ↦ h (c+1) + 2`, `c+2 ↦ h (c+1) + 1`. Again
*a skyline* (hole-free) precisely because of the notch precondition. The mirror
of `place_S_skyline`. -/
theorem place_Z_skyline {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (heq : h (c + 1) = h (c + 2)) (hstep : h c = h (c + 1) + 1) :
    Placement.place (skyline cfg h) { piece := Piece.Z, rot := 0, col := c }
      = skyline cfg (Function.update (Function.update (Function.update h c (h (c + 1) + 2))
          (c + 1) (h (c + 1) + 2)) (c + 2) (h (c + 1) + 1)) := by
  ext ⟨j, r⟩
  simp only [Placement.place_eq_union_dropped, Finset.mem_union,
             mem_dropped_Z_skyline hc hc1 hc2 heq hstep, mem_skyline]
  by_cases hjc : j = c
  · rw [hjc, Function.update_of_ne (by omega : c ≠ c + 2),
        Function.update_of_ne (by omega : c ≠ c + 1), Function.update_self]
    omega
  · by_cases hjc1 : j = c + 1
    · rw [hjc1, Function.update_of_ne (by omega : c + 1 ≠ c + 2), Function.update_self]
      omega
    · by_cases hjc2 : j = c + 2
      · rw [hjc2, Function.update_self]
        omega
      · rw [Function.update_of_ne hjc2, Function.update_of_ne hjc1, Function.update_of_ne hjc]
        omega

/-- **Z-piece raises every column height by at most 2.** The mirror of
`colHeight_place_S_skyline_le`: placing the Z on its notch lifts columns `c`,
`c+1` to `h (c+1) + 2` and `c+2` to `h (c+1) + 1`, each at most two above the
original profile height (using the notch relations `heq`, `hstep`). The Z-piece
entry of the per-piece height-debit table. -/
theorem colHeight_place_Z_skyline_le {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (heq : h (c + 1) = h (c + 2)) (hstep : h c = h (c + 1) + 1)
    {j : ℕ} (hj : j < cfg.cols) :
    colHeight (Placement.place (skyline cfg h) { piece := Piece.Z, rot := 0, col := c }) j
      ≤ h j + 2 := by
  rw [place_Z_skyline hc hc1 hc2 heq hstep, colHeight_skyline hj]
  by_cases hjc : j = c
  · rw [hjc, Function.update_of_ne (by omega : c ≠ c + 2),
        Function.update_of_ne (by omega : c ≠ c + 1), Function.update_self]
    omega
  · by_cases hjc1 : j = c + 1
    · rw [hjc1, Function.update_of_ne (by omega : c + 1 ≠ c + 2), Function.update_self]
    · by_cases hjc2 : j = c + 2
      · rw [hjc2, Function.update_self]
        omega
      · rw [Function.update_of_ne hjc2, Function.update_of_ne hjc1, Function.update_of_ne hjc]
        omega

/-! ### Horizontal-I absorption (the flat-4 packer)

The horizontal `I` (rotation `0`) is four cells in a row. On a *flat* four-column
stretch `h c = h (c+1) = h (c+2) = h (c+3)` it lands flush, raising each of the
four columns by one. This is the cheapest line-builder: it converts a flat
shelf into a one-higher flat shelf, the natural complement to the vertical `I`
that feeds a well. -/

/-- The horizontal I piece (rotation 0) drop profile, bottom-up: four cells in a row. -/
theorem shapeUp_horizI (c : ℕ) :
    ({ piece := Piece.I, rot := 0, col := c } : Placement).shapeUp
      = {((0 : ℕ), (0 : ℕ)), (1, 0), (2, 0), (3, 0)} := by
  show Piece.shapeUp Piece.I 0 = _
  decide

/-- **Horizontal-I hard-drop offset on a flat shelf.** When the four target
columns share a profile height, the drop offset is that common height. -/
theorem dropOffset_horizI_skyline {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (hc3 : c + 3 < cfg.cols)
    (heq1 : h (c + 1) = h c) (heq2 : h (c + 2) = h c) (heq3 : h (c + 3) = h c) :
    Placement.dropOffset (skyline cfg h) { piece := Piece.I, rot := 0, col := c } = h c := by
  rw [Placement.dropOffset_eq_sup, shapeUp_horizI]
  simp only [Finset.sup_insert, Finset.sup_singleton, Nat.add_zero, Nat.sub_zero]
  rw [colHeight_skyline hc, colHeight_skyline hc1, colHeight_skyline hc2,
    colHeight_skyline hc3]
  omega

/-- **The cells dropped by a horizontal I onto a flat shelf.** Columns `c … c+3`,
each at the common profile height `h c`. -/
theorem mem_dropped_horizI_skyline {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (hc3 : c + 3 < cfg.cols)
    (heq1 : h (c + 1) = h c) (heq2 : h (c + 2) = h c) (heq3 : h (c + 3) = h c) (j r : ℕ) :
    (j, r) ∈ Placement.dropped (skyline cfg h) { piece := Piece.I, rot := 0, col := c }
      ↔ (j = c ∨ j = c + 1 ∨ j = c + 2 ∨ j = c + 3) ∧ r = h c := by
  rw [Placement.dropped_eq_image, dropOffset_horizI_skyline hc hc1 hc2 hc3 heq1 heq2 heq3,
    shapeUp_horizI]
  simp only [Finset.mem_image, Finset.mem_insert, Finset.mem_singleton, Prod.mk.injEq]
  constructor
  · rintro ⟨a, ha, haj, har⟩
    rcases ha with rfl | rfl | rfl | rfl <;> dsimp only at haj har <;> omega
  · rintro ⟨hj, hr⟩
    rcases hj with hj | hj | hj | hj
    · exact ⟨(0, 0), by simp, by dsimp only; omega, by dsimp only; omega⟩
    · exact ⟨(1, 0), by simp, by dsimp only; omega, by dsimp only; omega⟩
    · exact ⟨(2, 0), by simp, by dsimp only; omega, by dsimp only; omega⟩
    · exact ⟨(3, 0), by simp, by dsimp only; omega, by dsimp only; omega⟩

/-- **Horizontal-I closure on a flat shelf.** Placing the horizontal I on a flat
four-column stretch of a skyline yields the skyline of the profile with each of
`c … c+3` raised by `1`. Hole-free precisely because of the flatness
precondition. -/
theorem place_horizI_skyline {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (hc3 : c + 3 < cfg.cols)
    (heq1 : h (c + 1) = h c) (heq2 : h (c + 2) = h c) (heq3 : h (c + 3) = h c) :
    Placement.place (skyline cfg h) { piece := Piece.I, rot := 0, col := c }
      = skyline cfg (Function.update (Function.update (Function.update
          (Function.update h c (h c + 1)) (c + 1) (h c + 1)) (c + 2) (h c + 1))
          (c + 3) (h c + 1)) := by
  ext ⟨j, r⟩
  simp only [Placement.place_eq_union_dropped, Finset.mem_union,
             mem_dropped_horizI_skyline hc hc1 hc2 hc3 heq1 heq2 heq3, mem_skyline]
  by_cases hjc : j = c
  · rw [hjc, Function.update_of_ne (by omega : c ≠ c + 3),
        Function.update_of_ne (by omega : c ≠ c + 2),
        Function.update_of_ne (by omega : c ≠ c + 1), Function.update_self]
    omega
  · by_cases hjc1 : j = c + 1
    · rw [hjc1, Function.update_of_ne (by omega : c + 1 ≠ c + 3),
          Function.update_of_ne (by omega : c + 1 ≠ c + 2), Function.update_self]
      omega
    · by_cases hjc2 : j = c + 2
      · rw [hjc2, Function.update_of_ne (by omega : c + 2 ≠ c + 3), Function.update_self]
        omega
      · by_cases hjc3 : j = c + 3
        · rw [hjc3, Function.update_self]
          omega
        · rw [Function.update_of_ne hjc3, Function.update_of_ne hjc2,
              Function.update_of_ne hjc1, Function.update_of_ne hjc]
          omega

/-- **A horizontal-I placement raises every column by at most one.** Lying flat
across four level columns, the bar lifts each of `c … c+3` by exactly `1` and
fixes the rest — the *cheapest* piece in the height ledger. Strictly tighter than
the O/T `≤ 2` debit (`colHeight_place_O_skyline_le`): a single well clear's four
rows of headroom (`colHeight_applyStep_vertI_well_le`) can absorb up to four
horizontal-I drops. The lone `+1` entry in the per-piece debit table. -/
theorem colHeight_place_horizI_skyline_le {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (hc3 : c + 3 < cfg.cols)
    (heq1 : h (c + 1) = h c) (heq2 : h (c + 2) = h c) (heq3 : h (c + 3) = h c)
    {j : ℕ} (hj : j < cfg.cols) :
    colHeight (Placement.place (skyline cfg h) { piece := Piece.I, rot := 0, col := c }) j
      ≤ h j + 1 := by
  rw [place_horizI_skyline hc hc1 hc2 hc3 heq1 heq2 heq3, colHeight_skyline hj]
  by_cases hjc : j = c
  · rw [hjc, Function.update_of_ne (by omega : c ≠ c + 3),
        Function.update_of_ne (by omega : c ≠ c + 2),
        Function.update_of_ne (by omega : c ≠ c + 1), Function.update_self]
  · by_cases hjc1 : j = c + 1
    · rw [hjc1, Function.update_of_ne (by omega : c + 1 ≠ c + 3),
          Function.update_of_ne (by omega : c + 1 ≠ c + 2), Function.update_self]
      omega
    · by_cases hjc2 : j = c + 2
      · rw [hjc2, Function.update_of_ne (by omega : c + 2 ≠ c + 3), Function.update_self]
        omega
      · by_cases hjc3 : j = c + 3
        · rw [hjc3, Function.update_self]
          omega
        · rw [Function.update_of_ne hjc3, Function.update_of_ne hjc2,
              Function.update_of_ne hjc1, Function.update_of_ne hjc]
          omega

/-! ### T-piece absorption (the flat-3 cap)

The `T` in its flat-bottom rotation (`rot 2`) is a three-wide base with a bump on
the middle column. On a flat three-column stretch it lands flush, raising the
middle column by `2` and the two flanks by `1`. Hole-free because the base row
sits squarely on the level shelf. -/

/-- The T piece (rotation 2) drop profile, bottom-up: flat 3-wide base with a
bump above the middle column. -/
theorem shapeUp_T (c : ℕ) :
    ({ piece := Piece.T, rot := 2, col := c } : Placement).shapeUp
      = {((0 : ℕ), (0 : ℕ)), (1, 0), (1, 1), (2, 0)} := by
  show Piece.shapeUp Piece.T 2 = _
  decide

/-- **T hard-drop offset on a flat shelf.** Three level columns ⇒ drop offset is
their common height. -/
theorem dropOffset_T_skyline {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (heq1 : h (c + 1) = h c) (heq2 : h (c + 2) = h c) :
    Placement.dropOffset (skyline cfg h) { piece := Piece.T, rot := 2, col := c } = h c := by
  rw [Placement.dropOffset_eq_sup, shapeUp_T]
  simp only [Finset.sup_insert, Finset.sup_singleton, Nat.add_zero, Nat.sub_zero]
  rw [colHeight_skyline hc, colHeight_skyline hc1, colHeight_skyline hc2]
  omega

/-- **The cells dropped by a flat-bottom T onto a level shelf.** -/
theorem mem_dropped_T_skyline {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (heq1 : h (c + 1) = h c) (heq2 : h (c + 2) = h c) (j r : ℕ) :
    (j, r) ∈ Placement.dropped (skyline cfg h) { piece := Piece.T, rot := 2, col := c }
      ↔ (j = c ∧ r = h c) ∨ (j = c + 1 ∧ (r = h c ∨ r = h c + 1))
          ∨ (j = c + 2 ∧ r = h c) := by
  rw [Placement.dropped_eq_image, dropOffset_T_skyline hc hc1 hc2 heq1 heq2, shapeUp_T]
  simp only [Finset.mem_image, Finset.mem_insert, Finset.mem_singleton, Prod.mk.injEq]
  constructor
  · rintro ⟨a, ha, haj, har⟩
    rcases ha with rfl | rfl | rfl | rfl <;> dsimp only at haj har <;> omega
  · rintro (⟨hj, hr⟩ | ⟨hj, hr⟩ | ⟨hj, hr⟩)
    · exact ⟨(0, 0), by simp, by dsimp only; omega, by dsimp only; omega⟩
    · rcases hr with hr | hr
      · exact ⟨(1, 0), by simp, by dsimp only; omega, by dsimp only; omega⟩
      · exact ⟨(1, 1), by simp, by dsimp only; omega, by dsimp only; omega⟩
    · exact ⟨(2, 0), by simp, by dsimp only; omega, by dsimp only; omega⟩

/-- **T closure on a flat shelf.** Middle column rises by `2`, flanks by `1`. -/
theorem place_T_skyline {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (heq1 : h (c + 1) = h c) (heq2 : h (c + 2) = h c) :
    Placement.place (skyline cfg h) { piece := Piece.T, rot := 2, col := c }
      = skyline cfg (Function.update (Function.update (Function.update h c (h c + 1))
          (c + 1) (h c + 2)) (c + 2) (h c + 1)) := by
  ext ⟨j, r⟩
  simp only [Placement.place_eq_union_dropped, Finset.mem_union,
             mem_dropped_T_skyline hc hc1 hc2 heq1 heq2, mem_skyline]
  by_cases hjc : j = c
  · rw [hjc, Function.update_of_ne (by omega : c ≠ c + 2),
        Function.update_of_ne (by omega : c ≠ c + 1), Function.update_self]
    omega
  · by_cases hjc1 : j = c + 1
    · rw [hjc1, Function.update_of_ne (by omega : c + 1 ≠ c + 2), Function.update_self]
      omega
    · by_cases hjc2 : j = c + 2
      · rw [hjc2, Function.update_self]
        omega
      · rw [Function.update_of_ne hjc2, Function.update_of_ne hjc1, Function.update_of_ne hjc]
        omega

/-- **A T placement raises every column by at most two.** Landing flush on a flat
three-wide shelf, the T lifts its middle column by `2` and the two flanks by `1`,
so the worst-case column growth is `2`. The `+2` debit entry for T, matching the O
(`colHeight_place_O_skyline_le`); together with the horizontal-I `+1`
(`colHeight_place_horizI_skyline_le`) this fills in the flat-shelf rows of the
per-piece height ledger the bag-phase potential reads off. -/
theorem colHeight_place_T_skyline_le {cfg : GameConfig} {h : ℕ → ℕ} {c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols) (hc2 : c + 2 < cfg.cols)
    (heq1 : h (c + 1) = h c) (heq2 : h (c + 2) = h c)
    {j : ℕ} (hj : j < cfg.cols) :
    colHeight (Placement.place (skyline cfg h) { piece := Piece.T, rot := 2, col := c }) j
      ≤ h j + 2 := by
  rw [place_T_skyline hc hc1 hc2 heq1 heq2, colHeight_skyline hj]
  by_cases hjc : j = c
  · rw [hjc, Function.update_of_ne (by omega : c ≠ c + 2),
        Function.update_of_ne (by omega : c ≠ c + 1), Function.update_self]
    omega
  · by_cases hjc1 : j = c + 1
    · rw [hjc1, Function.update_of_ne (by omega : c + 1 ≠ c + 2), Function.update_self]
      omega
    · by_cases hjc2 : j = c + 2
      · rw [hjc2, Function.update_self]
        omega
      · rw [Function.update_of_ne hjc2, Function.update_of_ne hjc1, Function.update_of_ne hjc]
        omega

