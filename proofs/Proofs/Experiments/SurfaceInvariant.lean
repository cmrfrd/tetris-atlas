/-- **Notched carrier hosts a J placement.** The last flat-triple port (the
`{J, 0, c}` fragment shares the T/L three-column flush-fit signature): with
`cfg.cols ≥ 9` a flat triple `(c, c+1, c+2)` clear of both the well `w` and the
bump `m` exists by the 2-hole/3-disjoint-triple pigeonhole, and the no-clear J
placement raises it to `(base+2, base+1, base+1)`, capped by `base + 2 ≤ cfg.rows`.
With this, six of the seven pieces land on the notched carrier — only the
horizontal I (a flat quad) remains. -/
theorem isNotchedFlatTopRWSkyline_J_lands {cfg : GameConfig} {base w m : ℕ}
    (hw : w < cfg.cols) (hm : m < cfg.cols) (h9 : 9 ≤ cfg.cols)
    (hslack : base + 2 ≤ cfg.rows) :
    ∃ c, IsReservedWellSkyline cfg
      (Placement.applyStep cfg
        (skyline cfg (fun j => if j = w then 0 else if j = m then base + 1 else base))
        { piece := Piece.J, rot := 0, col := c }) := by
  obtain ⟨c, hc2, hwc, hwc1, hwc2, hmc, hmc1, hmc2⟩ :
      ∃ c, c + 2 < cfg.cols ∧ w ≠ c ∧ w ≠ c + 1 ∧ w ≠ c + 2 ∧
        m ≠ c ∧ m ≠ c + 1 ∧ m ≠ c + 2 := by
    rcases Nat.lt_or_ge w 3 with hwA | hwA
    · rcases Nat.lt_or_ge m 6 with hmlt | hmge
      · exact ⟨6, by omega, by omega, by omega, by omega, by omega, by omega, by omega⟩
      · exact ⟨3, by omega, by omega, by omega, by omega, by omega, by omega, by omega⟩
    · rcases Nat.lt_or_ge w 6 with hwB | hwB
      · rcases Nat.lt_or_ge m 3 with hmlt | hmge
        · exact ⟨6, by omega, by omega, by omega, by omega, by omega, by omega, by omega⟩
        · exact ⟨0, by omega, by omega, by omega, by omega, by omega, by omega, by omega⟩
      · rcases Nat.lt_or_ge w 9 with hwC | hwC
        · rcases Nat.lt_or_ge m 3 with hmlt | hmge
          · exact ⟨3, by omega, by omega, by omega, by omega, by omega, by omega, by omega⟩
          · exact ⟨0, by omega, by omega, by omega, by omega, by omega, by omega, by omega⟩
        · rcases Nat.lt_or_ge m 3 with hmlt | hmge
          · exact ⟨3, by omega, by omega, by omega, by omega, by omega, by omega, by omega⟩
          · exact ⟨0, by omega, by omega, by omega, by omega, by omega, by omega, by omega⟩
  have hc : c < cfg.cols := by omega
  have hc1 : c + 1 < cfg.cols := by omega
  refine ⟨c, isReservedWellSkyline_applyStep_J hc hc1 hc2 ?_ ?_ hw hwc hwc1 hwc2 ?_ ?_ ?_⟩
  · show (if c + 1 = w then 0 else if c + 1 = m then base + 1 else base)
       = (if c = w then 0 else if c = m then base + 1 else base)
    rw [if_neg (by omega : ¬ c + 1 = w), if_neg (by omega : ¬ c + 1 = m),
        if_neg (by omega : ¬ c = w), if_neg (by omega : ¬ c = m)]
  · show (if c + 2 = w then 0 else if c + 2 = m then base + 1 else base)
       = (if c = w then 0 else if c = m then base + 1 else base)
    rw [if_neg (by omega : ¬ c + 2 = w), if_neg (by omega : ¬ c + 2 = m),
        if_neg (by omega : ¬ c = w), if_neg (by omega : ¬ c = m)]
  · show (if w = w then 0 else if w = m then base + 1 else base) = 0
    rw [if_pos rfl]
  · intro j hj
    show (if j = w then 0 else if j = m then base + 1 else base) ≤ cfg.rows
    split
    · exact Nat.zero_le _
    · split
      · omega
      · omega
  · show (if c = w then 0 else if c = m then base + 1 else base) + 2 ≤ cfg.rows
    rw [if_neg (by omega : ¬ c = w), if_neg (by omega : ¬ c = m)]
    exact hslack

/-- **Notched carrier hosts the I placement — via the well, not a flat quad.** The
horizontal I cannot sit flush on the notched carrier in general (the well and bump
can split the flat top into runs shorter than four), so the I-piece takes its
natural role: a *vertical* I dropped into the reserved well. With the flat top at
`base ≥ 4`, every non-well column is at least `4`, so rows `0,1,2,3` are complete
once the well fills — they clear, gravity drops every other column by `4`, and the
well stays empty. The result is again a reserved-well skyline (in fact the notched
carrier lowered by four). This is the height-regulating move that the reserved well
exists for, and it completes a landing lemma for all seven pieces. -/
theorem isNotchedFlatTopRWSkyline_vertI_lands {cfg : GameConfig} {base w m : ℕ}
    (hw : w < cfg.cols) (hbase : base + 1 ≤ cfg.rows) (hbase4 : 4 ≤ base) :
    IsReservedWellSkyline cfg
      (Placement.applyStep cfg
        (skyline cfg (fun j => if j = w then 0 else if j = m then base + 1 else base))
        { piece := Piece.I, rot := 1, col := w }) := by
  have hwell : (fun j => if j = w then 0 else if j = m then base + 1 else base) w = 0 := by
    show (if w = w then 0 else if w = m then base + 1 else base) = 0
    rw [if_pos rfl]
  have hothers : ∀ j, j < cfg.cols → j ≠ w →
      4 ≤ (fun j => if j = w then 0 else if j = m then base + 1 else base) j := by
    intro j hj hjw
    show 4 ≤ (if j = w then 0 else if j = m then base + 1 else base)
    rw [if_neg hjw]
    split <;> omega
  rw [applyStep_vertI_well hw hwell hothers]
  refine ⟨fun j => if j = w then 0 else (if j = w then 0 else if j = m then base + 1 else base) - 4,
    rfl, ?_, w, hw, ?_⟩
  · intro j hj
    show (if j = w then 0
          else (if j = w then 0 else if j = m then base + 1 else base) - 4) ≤ cfg.rows
    split
    · exact Nat.zero_le _
    · split <;> omega
  · show (if w = w then 0
          else (if w = w then 0 else if w = m then base + 1 else base) - 4) = 0
    rw [if_pos rfl]

/-- **The vertical-I well-clear *re-enters* the notched carrier.** Strengthening
`isNotchedFlatTopRWSkyline_vertI_lands`: the post-clear board is not merely a
reserved-well skyline but again a *notched* flat-top carrier, with the same well
`w` and bump `m`, lowered by exactly four (`base ↦ base - 4`). This is the first
genuine closure-direction lemma — the height-regulating I move maps the notched
carrier family into itself — and it is the quantitative height-decrease (`-4`)
that any bounded-height accounting over a bag will balance against the `+1/+2`
raises of the other pieces. -/
theorem isNotchedFlatTopRWSkyline_vertI_reenters {cfg : GameConfig} {base w m : ℕ}
    (hw : w < cfg.cols) (hm : m < cfg.cols) (hwm : w ≠ m)
    (hbase : base + 1 ≤ cfg.rows) (hbase4 : 4 ≤ base) :
    IsNotchedFlatTopRWSkyline cfg
      (Placement.applyStep cfg
        (skyline cfg (fun j => if j = w then 0 else if j = m then base + 1 else base))
        { piece := Piece.I, rot := 1, col := w }) := by
  have hwell : (fun j => if j = w then 0 else if j = m then base + 1 else base) w = 0 := by
    show (if w = w then 0 else if w = m then base + 1 else base) = 0
    rw [if_pos rfl]
  have hothers : ∀ j, j < cfg.cols → j ≠ w →
      4 ≤ (fun j => if j = w then 0 else if j = m then base + 1 else base) j := by
    intro j hj hjw
    show 4 ≤ (if j = w then 0 else if j = m then base + 1 else base)
    rw [if_neg hjw]
    split <;> omega
  rw [applyStep_vertI_well hw hwell hothers]
  refine ⟨base - 4, w, m, hw, hm, hwm, by omega, ?_⟩
  congr 1
  funext j
  by_cases hjw : j = w
  · subst hjw
    rw [if_pos rfl, if_pos rfl]
  · rw [if_neg hjw, if_neg hjw, if_neg hjw]
    by_cases hjm : j = m
    · subst hjm; rw [if_pos rfl, if_pos rfl]; omega
    · rw [if_neg hjm, if_neg hjm]

/-- **First fully-assembled `hstep` fragment (vertical I on the notched carrier).**
Packages the two halves the closure obligation needs into the exact existential
shape `tetrisSolvableValid_of_reservedWell_closed` consumes: a placement that
(1) plays the requested piece, (2) is `Valid`, and (3) lands back in the carrier.
For the vertical `I` dropped into the well, validity is just `w < cfg.cols` (the
piece is one column wide, so every shape cell has column offset `0`), and
membership is `isNotchedFlatTopRWSkyline_vertI_reenters` — the move maps the
notched family into itself, lowered by four. So on the notched carrier the `I`
branch of `hstep` is *closed outright*; the remaining six pieces only weaken the
conclusion to the bare reserved well (no notch rebuilt yet). -/
theorem isNotchedFlatTopRWSkyline_vertI_hstep {cfg : GameConfig} {base w m : ℕ}
    (hw : w < cfg.cols) (hm : m < cfg.cols) (hwm : w ≠ m)
    (hbase : base + 1 ≤ cfg.rows) (hbase4 : 4 ≤ base) :
    ∃ pl : Placement, pl.piece = Piece.I ∧ pl.Valid cfg ∧
      IsNotchedFlatTopRWSkyline cfg
        (Placement.applyStep cfg
          (skyline cfg (fun j => if j = w then 0 else if j = m then base + 1 else base)) pl) := by
  refine ⟨{ piece := Piece.I, rot := 1, col := w }, rfl, ?_,
    isNotchedFlatTopRWSkyline_vertI_reenters hw hm hwm hbase hbase4⟩
  intro cell hcell
  have h0 : ∀ c ∈ Piece.I.shapeUp 1, c.1 = 0 := by decide
  have hcz := h0 cell hcell
  show w + cell.1 < cfg.cols
  omega

/-- **Flat-top carrier re-enters itself under the vertical-I well-clear.** On a
flat-top reserved-well board at common height `base ≥ 4`, dropping a vertical `I`
into the empty well clears four lines and lowers every non-well column by four,
leaving a flat-top reserved-well board at height `base - 4` with the *same* well.
The flat-top analogue of `isNotchedFlatTopRWSkyline_vertI_reenters`: the `I` move
maps the flat-top family into itself, decreasing the common height by `4`. This is
the height-regulator brick on the simplest reserved-well surface — the only
cell-removing move, and the one that keeps a bounded invariant from drifting
upward under the +1/+2 raises the other pieces add. -/
theorem isFlatTopRWSkyline_vertI_reenters {cfg : GameConfig} {base w : ℕ}
    (hw : w < cfg.cols) (hbase : base ≤ cfg.rows) (hbase4 : 4 ≤ base) :
    IsFlatTopRWSkyline cfg
      (Placement.applyStep cfg
        (skyline cfg (fun j => if j = w then 0 else base))
        { piece := Piece.I, rot := 1, col := w }) := by
  have hwell : (fun j => if j = w then 0 else base) w = 0 := by
    show (if w = w then 0 else base) = 0
    rw [if_pos rfl]
  have hothers : ∀ j, j < cfg.cols → j ≠ w →
      4 ≤ (fun j => if j = w then 0 else base) j := by
    intro j hj hjw
    show 4 ≤ (if j = w then 0 else base)
    rw [if_neg hjw]
    exact hbase4
  rw [applyStep_vertI_well hw hwell hothers]
  refine ⟨base - 4, w, hw, by omega, ?_⟩
  congr 1
  funext j
  by_cases hjw : j = w
  · subst hjw
    rw [if_pos rfl, if_pos rfl]
  · rw [if_neg hjw, if_neg hjw, if_neg hjw]

/-- **Assembled `hstep` fragment: vertical I on the flat-top carrier.** The
flat-top analogue of `isNotchedFlatTopRWSkyline_vertI_hstep`: it packages the
height-regulating I move into the exact `∃ pl, piece ∧ Valid ∧ carrier` shape a
closure obligation consumes. Validity is just `w < cfg.cols` (the vertical `I` is
one column wide, every shape cell has column offset `0`), and re-entry is
`isFlatTopRWSkyline_vertI_reenters` — the move maps the flat-top family into
itself, lowered by four. So on the *flat* reserved-well surface (the phase a
bag-indexed carrier occupies once both `S` and `Z` are spent) the `I` branch of
`hstep` is closed outright, the only cell-removing move that offsets the other
pieces' upward raises. -/
theorem isFlatTopRWSkyline_vertI_hstep {cfg : GameConfig} {base w : ℕ}
    (hw : w < cfg.cols) (hbase : base ≤ cfg.rows) (hbase4 : 4 ≤ base) :
    ∃ pl : Placement, pl.piece = Piece.I ∧ pl.Valid cfg ∧
      IsFlatTopRWSkyline cfg
        (Placement.applyStep cfg
          (skyline cfg (fun j => if j = w then 0 else base)) pl) := by
  refine ⟨{ piece := Piece.I, rot := 1, col := w }, rfl, ?_,
    isFlatTopRWSkyline_vertI_reenters hw hbase hbase4⟩
  intro cell hcell
  have h0 : ∀ c ∈ Piece.I.shapeUp 1, c.1 = 0 := by decide
  have hcz := h0 cell hcell
  show w + cell.1 < cfg.cols
  omega

/-- **Assembled `hstep` fragment: vertical I on the spread-band carrier.** The
band-carrier analogue of `isFlatTopRWSkyline_vertI_hstep` and
`isNotchedFlatTopRWSkyline_vertI_hstep`: it packages the height-regulating vertical-I
well clear into the exact `∃ pl, piece ∧ Valid ∧ carrier` shape a closure obligation
consumes. Validity is just `w < cfg.cols` (the vertical `I` is one column wide, every
shape cell has column offset `0`), and re-entry is the band descent
`isSpreadBoundedRWSkyline_vertI_well_of_isSpreadBounded` — the move maps the spread-`s`
band into itself with the floor lowered by four and the spread preserved. So on the
widest reserved-well carrier the `I` branch of `hstep` is closed outright: the only
cell-removing move, the descent that offsets the other six pieces' `+1`/`+2` band
growth. -/
theorem isSpreadBoundedRWSkyline_vertI_hstep {cfg : GameConfig}
    {spread : ℕ} {h : ℕ → ℕ} {floor w : ℕ}
    (hw : w < cfg.cols) (hw0 : h w = 0) (hfloor : 4 ≤ floor)
    (hband : ∀ j < cfg.cols, j ≠ w → floor ≤ h j ∧ h j ≤ floor + spread)
    (hcap : floor + spread ≤ cfg.rows) :
    ∃ pl : Placement, pl.piece = Piece.I ∧ pl.Valid cfg ∧
      IsSpreadBoundedRWSkyline cfg spread
        (Placement.applyStep cfg (skyline cfg h) pl) := by
  refine ⟨{ piece := Piece.I, rot := 1, col := w }, rfl, ?_,
    isSpreadBoundedRWSkyline_vertI_well_of_isSpreadBounded hw hw0 hfloor hband hcap⟩
  intro cell hcell
  have h0 : ∀ c ∈ Piece.I.shapeUp 1, c.1 = 0 := by decide
  have hcz := h0 cell hcell
  show w + cell.1 < cfg.cols
  omega

end Board

/-- **Uniform validity from an interior landing column.** Every tetromino cell
sits in the 4-wide bounding box (`Piece.shapeUp_col_lt_four`), so a placement
whose leftmost column is at least four short of the right wall is in-bounds for
*any* piece and rotation at once — no case split. This is the single discharge
that supplies the `pl.Valid` half of every `hstep` obligation: the surface
lemmas already pin the landing column `c` to the field interior, so the same
bound `c + 3 < cfg.cols` certifies the placement valid regardless of which of
the seven pieces the adversary drew. -/
theorem Placement.valid_of_col_add_three_lt {cfg : GameConfig} {pl : Placement}
    (h : pl.col + 3 < cfg.cols) : pl.Valid cfg := by
  intro cell hcell
  have hlt := Piece.shapeUp_col_lt_four pl.piece pl.rot cell hcell
  omega

/-- **Record-eta bridge for the reduction `hstep` shape.** The bag-indexed
reduction phrases each move as `applyStep b { pl with piece := p }`, whereas the
per-piece dispatch fragments (`isReservedWellSkyline_*_hstep` and friends)
produce `applyStep b pl` under the side-condition `pl.piece = p`. Because that
side-condition makes `{ pl with piece := p }` *definitionally* `pl` (structure
eta), the two `applyStep` boards coincide, so any dispatch-shaped witness
transports verbatim into the reduction's obligation. This is the plumbing that
lets the `*_hstep` fragments discharge `tetrisSolvableValid_of_reservedWell_closed`. -/
theorem Placement.applyStep_with_piece_self {cfg : GameConfig} (b : Board)
    (pl : Placement) {p : Piece} (h : pl.piece = p) :
    Placement.applyStep cfg b { pl with piece := p } = Placement.applyStep cfg b pl := by
  subst h; rfl

/-- **Dispatch-to-reduction transport.** Lifts a dispatch-shaped placement
witness — `∃ pl, pl.piece = p ∧ pl.Valid cfg ∧ Q (applyStep b pl)`, the shape the
`*_hstep` fragments produce — into the reduction's `{ pl with piece := p }` shape
by rewriting through `applyStep_with_piece_self`. The carrier predicate `Q` is
arbitrary, so this single wrapper services every surface carrier
(`IsReservedWellSkyline`, `IsBoundedSkyline`, …) uniformly: a `*_hstep` fragment
feeds it directly to discharge a `*_closed` reduction's `hstep` obligation. -/
theorem exists_validPlacement_eta {cfg : GameConfig} {b : Board} {p : Piece}
    {Q : Board → Prop}
    (h : ∃ pl : Placement, pl.piece = p ∧ pl.Valid cfg ∧
          Q (Placement.applyStep cfg b pl)) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid cfg ∧
      Q (Placement.applyStep cfg b { pl with piece := p }) := by
  obtain ⟨pl, hpiece, hvalid, hQ⟩ := h
  refine ⟨pl, hpiece, hvalid, ?_⟩
  rw [Placement.applyStep_with_piece_self b pl hpiece]
  exact hQ

/-- **Standard notched surface, reduction-shaped.** The composition of the
standard all-7 dispatch (`Board.isNotchedFlatTopRWSkyline_all7_hstep_standard`)
with the record-eta transport (`exists_validPlacement_eta`): from the concrete
10-column notched surface (well at column 0, bump at column 3, common height
`base`), every one of the seven pieces admits a valid placement whose post-move
board — now written in the reduction's `{ pl with piece := p }` form — is again a
reserved-well skyline. This is the exact shape a discharge of
`tetrisSolvableValid_of_reservedWell_closed`'s `hstep` produces for this surface,
certifying the dispatch→transport pipeline end-to-end on the standard board. -/
theorem isNotchedFlatTopRWSkyline_all7_hstep_standard_reduction
    {base : ℕ} {p : Piece}
    (hbase : base + 2 ≤ GameConfig.standard.rows)
    (hp : p = Piece.O ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J ∨ p = Piece.I
          ∨ p = Piece.S ∨ p = Piece.Z) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      Board.IsReservedWellSkyline GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard
            (fun j => if j = 0 then 0 else if j = 3 then base + 1 else base))
          { pl with piece := p }) :=
  exists_validPlacement_eta
    (Board.isNotchedFlatTopRWSkyline_all7_hstep_standard hbase hp)

/-- **Rich standard reserved-well surface, reduction-shaped.** The bare-carrier twin of
`isNotchedFlatTopRWSkyline_all7_hstep_standard_reduction`: composing the rich-surface all-7
dispatch (`Board.isReservedWellSkyline_all7_hstep_standard`) with the record-eta transport
(`exists_validPlacement_eta`) rewrites each move into the bag-indexed reduction's
`{ pl with piece := p }` form. So on the concrete 10-column reserved-well surface
`fun j => if j = 0 then 0 else if j = 5 then base + 1 else if j = 8 then base + 1 else base`
(`base + 2 ≤ rows`), every one of the seven pieces admits a valid placement whose post-move
board — now in reduction position — is again a reserved-well skyline. This is the exact shape a
discharge of `tetrisSolvableValid_of_reservedWell_closed`'s `hstep` produces for this surface,
certifying the dispatch→transport pipeline end-to-end on the bare reserved-well carrier. -/
theorem isReservedWellSkyline_all7_hstep_standard_reduction
    {base : ℕ} {p : Piece}
    (hbase : base + 2 ≤ GameConfig.standard.rows)
    (hp : p = Piece.O ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J ∨ p = Piece.I
          ∨ p = Piece.S ∨ p = Piece.Z) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      Board.IsReservedWellSkyline GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard
            (fun j => if j = 0 then 0 else if j = 5 then base + 1 else if j = 8 then base + 1 else base))
          { pl with piece := p }) :=
  exists_validPlacement_eta
    (Board.isReservedWellSkyline_all7_hstep_standard hbase hp)

/-- **Flat-top well-clear, reduction-shaped.** The flat-top analogue of
`isNotchedFlatTopRWSkyline_all7_hstep_standard_reduction` for the vertical-`I`
well clear: composing the dispatch-shaped `Board.isFlatTopRWSkyline_vertI_hstep`
with the record-eta transport (`exists_validPlacement_eta`) rewrites the move into
the bag-indexed reduction's `{ pl with piece := p }` form. So on a flat-top
reserved-well board at common height `base ≥ 4`, the `I` branch of a
`tetrisSolvableValid_of_flatTop_closed` discharge is closed outright in exactly the
shape that reduction's `hstep` consumes — the height regulator that offsets the
other pieces' upward raises, now in reduction position. -/
theorem isFlatTopRWSkyline_vertI_hstep_reduction {cfg : GameConfig} {base w : ℕ}
    (hw : w < cfg.cols) (hbase : base ≤ cfg.rows) (hbase4 : 4 ≤ base) :
    ∃ pl : Placement, pl.piece = Piece.I ∧ pl.Valid cfg ∧
      Board.IsFlatTopRWSkyline cfg
        (Placement.applyStep cfg
          (Board.skyline cfg (fun j => if j = w then 0 else base))
          { pl with piece := Piece.I }) :=
  exists_validPlacement_eta
    (Board.isFlatTopRWSkyline_vertI_hstep hw hbase hbase4)

/-- **Bag bookkeeping: dropping S and Z leaves only flat-shelf pieces.** Once
neither S nor Z remains in the bag `T`, every drawable piece is one of the five
that a *flat* reserved-well top hosts with no notch (`O, T, L, J, I`). This is the
membership half of the phase split the bag-indexed carrier turns on: while S or Z
is still owed, the surface must keep a notch; the moment both are spent, a plain
flat shelf discharges the rest of the bag. -/
theorem mem_flatShelf_pieces_of_no_SZ {T : Bag} {p : Piece}
    (hp : p ∈ T) (hS : Piece.S ∉ T) (hZ : Piece.Z ∉ T) :
    p = Piece.O ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J ∨ p = Piece.I := by
  cases p
  · exact Or.inl rfl
  · exact Or.inr (Or.inr (Or.inr (Or.inr rfl)))
  · exact absurd hp hS
  · exact absurd hp hZ
  · exact Or.inr (Or.inl rfl)
  · exact Or.inr (Or.inr (Or.inl rfl))
  · exact Or.inr (Or.inr (Or.inr (Or.inl rfl)))

/-- **Flat-phase top-preserving fill.** The phase-aware assembly of the flat
top-preservation face: once the bag `T` owes neither `S` nor `Z`, every owed piece is one of the
five flats (`mem_flatShelf_pieces_of_no_SZ`), so an arbitrary spread-2 level pocket band member
absorbs the drawn piece `p ∈ T` into its guaranteed floor pocket as a valid, surviving placement
that keeps the band top at `floor + 2` (`maxColHeight standard b' ≤ floor + 2`, via
`Board.maxColHeight_le_flatFill_of_isLevelPocketBandAt`). This is the flat phase of the
bag-phase-aware closure: no notch is required, the pocket alone services every remaining draw. The
post-fill board lands in the pocket-less spread-2 band at the same floor, so chaining a second flat
fill needs the floor pocket regenerated (the drain's job), not this atom. -/
theorem maxColHeight_le_flatPhaseFill_of_isLevelPocketBandAt {floor : ℕ} {b : Board} {T : Bag}
    {p : Piece} (hb : Board.IsLevelPocketBandAt GameConfig.standard 2 floor b)
    (hp : p ∈ T) (hS : Piece.S ∉ T) (hZ : Piece.Z ∉ T) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard b pl) ∧
      Board.maxColHeight GameConfig.standard
        (Placement.applyStep GameConfig.standard b pl) ≤ floor + 2 := by
  have hp5 : p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J := by
    rcases mem_flatShelf_pieces_of_no_SZ hp hS hZ with h | h | h | h | h
    · exact Or.inl h
    · exact Or.inr (Or.inr (Or.inl h))
    · exact Or.inr (Or.inr (Or.inr (Or.inl h)))
    · exact Or.inr (Or.inr (Or.inr (Or.inr h)))
    · exact Or.inr (Or.inl h)
  exact Board.maxColHeight_le_flatFill_of_isLevelPocketBandAt hp5 hb

/-- **Drawing keeps every other owed piece available.** If `q` is in the bag and
`q ≠ p`, then `q` survives the draw of `p`: `q ∈ bag.draw p`. Either the draw
empties the bag and refills to `Bag.full` (which contains everything), or it just
erases `p`, leaving `q` (since `q ≠ p`) in place. This is the per-piece
persistence fact a bag-phase invariant turns on — when the adversary forces a
flat-shelf piece, the still-owed `S`/`Z` remain in `bag.draw p`, so the carrier's
"notch still required" obligation is carried forward to the next draw. Generalises
`Bag.mem_draw_full_of_ne` from the full bag to an arbitrary bag. -/
theorem Bag.mem_draw_of_mem_of_ne {bag : Bag} {p q : Piece}
    (hq : q ∈ bag) (hne : q ≠ p) : q ∈ bag.draw p := by
  unfold Bag.draw
  split
  · exact Finset.mem_univ q
  · exact Finset.mem_erase.mpr ⟨hne, hq⟩

/-- **Bag bookkeeping: a piece absent from the bag stays absent across a
non-refill draw.** When drawing `p` does not empty-and-refill the bag
(`bag.draw p ≠ Bag.full`), the draw merely erases `p` from a subset of the old
bag, so any piece `q` already missing stays missing. This is the
negative-membership companion to `Bag.mem_draw_of_mem_of_ne`: where that lemma
carries a *still-owed* `S`/`Z` forward, this one keeps an *already-spent* `S`/`Z`
spent — exactly the persistence the flat phase of a bag-indexed carrier needs to
stay inside the `mem_flatShelf_pieces_of_no_SZ` regime (no notch required) until
the bag actually refills. -/
theorem Bag.not_mem_draw_of_not_mem {bag : Bag} {p q : Piece}
    (hq : q ∉ bag) (hfull : bag.draw p ≠ Bag.full) : q ∉ bag.draw p := by
  rcases Bag.draw_subset_self_or_eq_full bag p with hsub | hrefill
  · exact fun hmem => hq (hsub hmem)
  · exact absurd hrefill hfull

/-- **Flat-phase transition dichotomy.** From a bag owing neither `S` nor `Z`,
drawing *any* piece `p` lands in one of exactly two phases: either the draw
empties-and-refills the bag (`T.draw p = Bag.full`, re-arming both staircase
pieces for the next bag) or it stays staircase-free
(`S ∉ T.draw p ∧ Z ∉ T.draw p`, the flat phase persists). This is the precise
case split a bag-indexed carrier's flat-phase `hstep` performs: combined with
`mem_flatShelf_pieces_of_no_SZ` (the drawn piece must be one of `O,T,L,J,I`), it
routes every flat-phase draw either back to the notch-required full bag or onward
in the no-notch flat phase — the two surface regimes a closure must service. -/
theorem Bag.draw_full_or_no_SZ_of_no_SZ {T : Bag} {p : Piece}
    (hS : Piece.S ∉ T) (hZ : Piece.Z ∉ T) :
    T.draw p = Bag.full ∨ (Piece.S ∉ T.draw p ∧ Piece.Z ∉ T.draw p) := by
  rcases eq_or_ne (T.draw p) Bag.full with hf | hf
  · exact Or.inl hf
  · exact Or.inr ⟨Bag.not_mem_draw_of_not_mem hS hf, Bag.not_mem_draw_of_not_mem hZ hf⟩

/-- **Notch-phase persistence under a non-staircase draw.** The notch-phase
companion to `Bag.draw_full_or_no_SZ_of_no_SZ`. When the bag still owes a
staircase piece (`S ∈ T ∨ Z ∈ T`) and the adversary draws anything *other* than
`S` or `Z`, the drawn piece cannot have been the staircase piece being tracked,
so it survives into `T.draw p` (`Bag.mem_draw_of_mem_of_ne`): the bag still owes
`S` or `Z` and the carrier must keep its notch. Together with the flat-phase
dichotomy and the refill re-arm, this closes the bag-phase transition table: the
*only* draw that can retire the notch obligation is one that spends the final
owed staircase piece. -/
theorem Bag.owes_staircase_of_draw_of_ne_SZ {T : Bag} {p : Piece}
    (hpS : p ≠ Piece.S) (hpZ : p ≠ Piece.Z)
    (h : Piece.S ∈ T ∨ Piece.Z ∈ T) :
    Piece.S ∈ T.draw p ∨ Piece.Z ∈ T.draw p := by
  rcases h with hS | hZ
  · exact Or.inl (Bag.mem_draw_of_mem_of_ne hS (Ne.symm hpS))
  · exact Or.inr (Bag.mem_draw_of_mem_of_ne hZ (Ne.symm hpZ))

/-- **Complete notch-phase transition.** From a bag owing a staircase piece,
every draw lands back in the notch phase (`S ∈ T.draw p ∨ Z ∈ T.draw p`) UNLESS
the draw both *was* a staircase piece and did *not* refill. Assembles the three
transition facts into the single case split a notch-phase carrier's `hstep`
performs: a non-staircase draw persists the obligation
(`owes_staircase_of_draw_of_ne_SZ`); a refilling draw re-arms both staircase
pieces (the full bag owns everything); and the sole residual exit is a non-refill
draw of `S`/`Z` that spends the final owed piece — exactly the move that hands
control to the flat phase. -/
theorem Bag.draw_owes_staircase_or_spent_SZ {T : Bag} {p : Piece}
    (h : Piece.S ∈ T ∨ Piece.Z ∈ T) :
    (Piece.S ∈ T.draw p ∨ Piece.Z ∈ T.draw p) ∨
      ((p = Piece.S ∨ p = Piece.Z) ∧ T.draw p ≠ Bag.full) := by
  by_cases hp : p = Piece.S ∨ p = Piece.Z
  · by_cases hf : T.draw p = Bag.full
    · left; rw [hf]; exact Or.inl (Bag.mem_full _)
    · right; exact ⟨hp, hf⟩
  · push_neg at hp
    exact Or.inl (Bag.owes_staircase_of_draw_of_ne_SZ hp.1 hp.2 h)

/-!
## Bag-granularity closure reduction (approach #1)

The single-step invariant interface (`tetrisSolvableValid_of_height_bounded_invariant`)
asks for a set `S : Set GameState` closed under one adversarial move. A surface
invariant, however, only "looks clean" at **bag boundaries** — mid-bag the
player may temporarily roughen the skyline before repairing it by the bag's
end. The reduction below re-keys the interface on the game's natural phase
counter, the **remaining bag** `T : Bag`, which records exactly which of the
seven pieces are still to be drawn before the next refill. An invariant becomes
a *family of board predicates indexed by bag-phase*, `P : Bag → Board → Prop`,
read as "board `b` is admissible while the bag still holds `T`". All three
proof obligations are then purely board-level; the bag carries the phase, so
per-piece closure already realises full per-bag bookkeeping.
-/

/-- **Bag-granularity closure reduction.** To certify `TetrisSolvableValid` it
suffices to give a bag-phase-indexed family of board predicates `P` such that:

* `hinit` — the empty board is admissible with a full bag (this is `init`);
* `hheight` — every admissible board is height-bounded (rules out loss for free);
* `hstep` — from any admissible `(T, b)` and any piece `p` still in the bag `T`,
  the player has a *valid* placement of `p` whose post-drop, post-line-clear
  board is admissible under the drawn bag `T.draw p`.

This is a faithful re-indexing of `tetrisSolvableValid_of_height_bounded_invariant`:
taking `S := {g | P g.bag g.board}`, the obligations match definitionally because
`adversarialStep` projects to `(applyStep b {pl with piece := p}, bag.draw p)`
and `init` projects to `(Board.empty, Bag.full)`. No enumeration; the bag
component of each state supplies the phase. -/
theorem tetrisSolvableValid_of_bag_indexed_invariant
    (P : Bag → Board → Prop)
    (hinit : P Bag.full Board.empty)
    (hheight : ∀ T b, P T b → ∀ j, Board.colHeight b j ≤ GameConfig.standard.rows)
    (hstep : ∀ T b, P T b → ∀ p, p ∈ T →
      ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
        P (T.draw p)
          (Placement.applyStep GameConfig.standard b { pl with piece := p })) :
    TetrisSolvableValid := by
  refine tetrisSolvableValid_of_height_bounded_invariant
    { g | P g.bag g.board } ?_ ?_ ?_
  · exact hinit
  · intro g hg j
    exact hheight g.bag g.board hg j
  · intro g hg p hp
    exact hstep g.bag g.board hg p hp

/-- **Atlas existence reduces to bounded-skyline closure.** Specialising the
bag-indexed reduction to the bounded-skyline carrier (ignoring the bag phase)
discharges the initial and height obligations outright — via
`Board.isBoundedSkyline_empty` and `Board.colHeight_le_of_isBoundedSkyline` — so
the entire `TetrisSolvableValid` verdict rests on a *single* closure hypothesis:
from any bounded skyline, every piece the adversary can draw admits a valid
placement whose post-move board is again a bounded skyline. This isolates the
genuine crux (surface closure under the 7-bag) as one explicit, self-contained
obligation; the seven `Board.applyStep_*_skyline_noclear` witnesses plus the
well-clear engine are precisely the material a discharge of `hstep` would compose. -/
theorem tetrisSolvableValid_of_boundedSkyline_closed
    (hstep : ∀ (T : Bag) (b : Board), Board.IsBoundedSkyline GameConfig.standard b →
      ∀ p, p ∈ T →
      ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
        Board.IsBoundedSkyline GameConfig.standard
          (Placement.applyStep GameConfig.standard b { pl with piece := p })) :
    TetrisSolvableValid :=
  tetrisSolvableValid_of_bag_indexed_invariant
    (fun _ b => Board.IsBoundedSkyline GameConfig.standard b)
    (Board.isBoundedSkyline_empty GameConfig.standard)
    (fun _ _ hb => Board.colHeight_le_of_isBoundedSkyline hb)
    hstep

/-- **Atlas existence reduces to reserved-well closure.** The reserved-well
refinement of the bounded-skyline reduction: `hinit` and `hheight` discharge
exactly as before (`isReservedWellSkyline_empty`,
`colHeight_le_of_isReservedWellSkyline`), leaving a single closure hypothesis
whose hypothesis *and* conclusion now carry a designated empty well. The extra
structure on the hypothesis side is what the seven `Board.applyStep_*_skyline_noclear`
witnesses consume — each needs a column the drop keeps empty to fire the no-clear
bridge — so this is the carrier against which a per-piece discharge of `hstep` is
actually assembled. -/
theorem tetrisSolvableValid_of_reservedWell_closed
    (hstep : ∀ (T : Bag) (b : Board), Board.IsReservedWellSkyline GameConfig.standard b →
      ∀ p, p ∈ T →
      ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
        Board.IsReservedWellSkyline GameConfig.standard
          (Placement.applyStep GameConfig.standard b { pl with piece := p })) :
    TetrisSolvableValid :=
  tetrisSolvableValid_of_bag_indexed_invariant
    (fun _ b => Board.IsReservedWellSkyline GameConfig.standard b)
    (Board.isReservedWellSkyline_empty GameConfig.standard)
    (fun _ _ hb => Board.colHeight_le_of_isReservedWellSkyline hb)
    hstep

/-- **Atlas existence reduces to flat-top closure.** The tightest of the surface
reductions: pinning the carrier to the *flat-top* reserved well (every non-well
column at one common height), `hinit` and `hheight` again discharge for free
(`isFlatTopRWSkyline_empty`, `colHeight_le_of_isFlatTopRWSkyline`), leaving a
single closure hypothesis whose hypothesis *and* conclusion both carry the flat
surface. This is the carrier the per-piece *landing* lemmas
(`isFlatTopRWSkyline_flatShelf_hstep` for the five flat pieces,
`isFlatTopRWSkyline_vertI_hstep` for the well clear) are stated against: on a flat
top the five flat-shelf pieces find a guaranteed landing site by pigeonhole with
no notch assumption, and the vertical I re-flattens four rows lower. The residual
obstruction this reduction makes explicit is that the flat-shelf landings exit to
a *general* reserved well (a placed piece roughens the top), so a discharge of
this `hstep` must re-flatten within the move — the genuine surface-closure crux. -/
theorem tetrisSolvableValid_of_flatTop_closed
    (hstep : ∀ (T : Bag) (b : Board), Board.IsFlatTopRWSkyline GameConfig.standard b →
      ∀ p, p ∈ T →
      ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
        Board.IsFlatTopRWSkyline GameConfig.standard
          (Placement.applyStep GameConfig.standard b { pl with piece := p })) :
    TetrisSolvableValid :=
  tetrisSolvableValid_of_bag_indexed_invariant
    (fun _ b => Board.IsFlatTopRWSkyline GameConfig.standard b)
    (Board.isFlatTopRWSkyline_empty GameConfig.standard)
    (fun _ _ hb => Board.colHeight_le_of_isFlatTopRWSkyline hb)
    hstep

/-- **Atlas existence reduces to spread-band closure.** The widest reserved-well
reduction: the carrier is fixed to a band of spread `spread` (every non-well column
within `[floor, floor + spread]`), the richer surface that **absorbs the roughening a
placement produces** where the flat-top carrier cannot (a flat-shelf piece lifts a
window by `1`/`2`, exiting the flat top but staying inside the band). `hinit` is the
empty board at this spread (`isSpreadBoundedRWSkyline_empty_of_le`, needing only
`spread ≤ rows`) and `hheight` is the band ceiling bound
(`colHeight_le_of_isSpreadBoundedRWSkyline`), so the whole `TetrisSolvableValid`
verdict again rests on a single closure hypothesis — now over the band carrier the
seven landing bricks (`isSpreadBoundedRWSkyline_{O,T,L,J,horizI,S,Z}_lands_*`) and the
spread-preserving well clear (`isSpreadBoundedRWSkyline_vertI_hstep`) are stated
against. The residual obstruction this reduction isolates: each placement may grow the
spread (`+1`/`+2`), and only the once-per-bag well clear lowers the floor, so a
discharge of this `hstep` must keep the spread pinned at `spread` across the whole
bag — the amortised potential crux. -/
theorem tetrisSolvableValid_of_spreadBand_closed {spread : ℕ}
    (hs : spread ≤ GameConfig.standard.rows)
    (hstep : ∀ (T : Bag) (b : Board),
        Board.IsSpreadBoundedRWSkyline GameConfig.standard spread b →
      ∀ p, p ∈ T →
      ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
        Board.IsSpreadBoundedRWSkyline GameConfig.standard spread
          (Placement.applyStep GameConfig.standard b { pl with piece := p })) :
    TetrisSolvableValid :=
  tetrisSolvableValid_of_bag_indexed_invariant
    (fun _ b => Board.IsSpreadBoundedRWSkyline GameConfig.standard spread b)
    (Board.isSpreadBoundedRWSkyline_empty_of_le GameConfig.standard hs)
    (fun _ _ hb => Board.colHeight_le_of_isSpreadBoundedRWSkyline hb)
    hstep

/-- **Atlas existence reduces to level-pocket-band closure.** The tightest of the
surface reductions: the carrier keeps the spread band of
`tetrisSolvableValid_of_spreadBand_closed` *and additionally* guarantees a width-four
level pocket (four consecutive non-well columns resting at the band floor) on every
admissible board. `hinit` is the empty board as a pocket band
(`isLevelPocketBand_empty`, needing `spread ≤ rows` and the standard `4 < cols`) and
`hheight` is the band ceiling bound (`colHeight_le_of_isLevelPocketBand`), so the
whole `TetrisSolvableValid` verdict again rests on a single closure hypothesis — now
over the exact carrier the per-piece landing bricks
(`isSpreadBoundedRWSkyline_lands_of_isLevelPocketBand` for the five flat-shelf pieces,
`isSpreadBoundedRWSkyline_SZ_valley_of_notch` for the staircases) and the
pocket-regeneration composite (`isLevelPocketBand_vertI_well_of_flat`) are stated
against: the guaranteed pocket is the landing site the flat-shelf pieces drop into,
and a vertical-I well clear re-flattens and re-exhibits one. The residual obstruction
this reduction isolates is the sharpest yet: a flat-shelf landing fills the pocket and
exits to a bare band (`isSpreadBoundedRWSkyline_lands_of_isLevelPocketBand` keeps the
band but drops the pocket), and only a re-flatten regenerates a pocket, so a discharge
of this `hstep` must re-flatten within the move — which for an *arbitrary* band is
false (an alternating band carries no pocket and admits no flushing piece). The true
discharge therefore routes through the reachability carrier
(`tetrisSolvableValid_of_strategy`), where the pocket is one the player has built
rather than one demanded of every shape. -/
theorem tetrisSolvableValid_of_levelPocketBand_closed {spread : ℕ}
    (hs : spread ≤ GameConfig.standard.rows)
    (hstep : ∀ (T : Bag) (b : Board),
        Board.IsLevelPocketBand GameConfig.standard spread b →
      ∀ p, p ∈ T →
      ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
        Board.IsLevelPocketBand GameConfig.standard spread
          (Placement.applyStep GameConfig.standard b { pl with piece := p })) :
    TetrisSolvableValid :=
  tetrisSolvableValid_of_bag_indexed_invariant
    (fun _ b => Board.IsLevelPocketBand GameConfig.standard spread b)
    (Board.isLevelPocketBand_empty GameConfig.standard hs (by decide))
    (fun _ _ hb => Board.colHeight_le_of_isLevelPocketBand hb)
    hstep

/-- **Reachability under a fixed strategy.** Given a strategy `σ` that, from the
current bag `T`, board `b`, and the adversary's drawn piece `p`, names the
placement to play, `ReachableUnder σ` is the set of `(bag, board)` states the
player actually visits starting from a full bag on the empty board. The `step`
constructor only ever extends a reachable state along `σ`'s own chosen placement,
so this carrier is closed under the adversary's draw *by construction* — exactly
the structural feature every surface-predicate carrier lacks. Those predicates
quantify over *all* boards meeting a shape constraint, so the adversary may hand
the player a board no honest play ever produces (e.g. an alternating spread-one
band admitting no flush landing); here, by contrast, every member is literally a
state `σ` reaches, so a per-piece response always exists. -/
inductive ReachableUnder (σ : Bag → Board → Piece → Placement) : Bag → Board → Prop
  | init : ReachableUnder σ Bag.full Board.empty
  | step {T : Bag} {b : Board} {p : Piece} :
      ReachableUnder σ T b → p ∈ T →
      ReachableUnder σ (T.draw p)
        (Placement.applyStep GameConfig.standard b { (σ T b p) with piece := p })

/-- **Reachable boards are well-formed.** A structural invariant of the
reachability carrier, prior to any height accounting: for *any* strategy `σ` that
names the demanded piece (`hpiece`) and only ever plays placements valid on the
boards it actually reaches (`hvalid`), every state `ReachableUnder σ T b` carries a
well-formed board. The induction is immediate — `init` is `Board.empty_wf`, and each
`step` folds one valid placement onto a well-formed board, preserved by
`Placement.applyStep_wf` after collapsing the played record `{ σ T b p with piece := p }`
back to `σ T b p` (`Placement.applyStep_with_piece_self`, valid because `hpiece`
already fixes the piece field). `Board.WF` is the standing side-condition every
column-height and line-clear lemma demands, so this is the gate a route-A `hheight`
proof passes through before it can read `colHeight` off a reachable board: where the
abstract reduction `tetrisSolvableValid_of_strategy` leaves `hheight` as the open
content, this supplies the well-formedness half of its inductive hypothesis for free,
uniformly over every strategy. -/
theorem wf_of_reachableUnder {σ : Bag → Board → Piece → Placement}
    (hpiece : ∀ T b p, (σ T b p).piece = p)
    (hvalid : ∀ T b, ReachableUnder σ T b → ∀ p, p ∈ T →
        (σ T b p).Valid GameConfig.standard)
    {T : Bag} {b : Board} (h : ReachableUnder σ T b) :
    Board.WF GameConfig.standard b := by
  induction h with
  | init => exact Board.empty_wf GameConfig.standard
  | @step T b p hr hp ih =>
      rw [Placement.applyStep_with_piece_self b (σ T b p) (hpiece T b p)]
      exact Placement.applyStep_wf ih (hvalid T b hr p hp)

/-- **Atlas existence reduces to a height-bounded valid strategy.** The decisive
re-keying of the bag-indexed reduction onto a *reachability* carrier. Where the
surface reductions above each rest on a closure hypothesis that is in fact
*false* — they quantify over all boards meeting a shape predicate, so an
adversary can present an unrecoverable surface no real game builds — this
reduction takes the carrier to be exactly the states a fixed strategy `σ` visits.
The `hstep` obligation then discharges *for free* via `ReachableUnder.step`: the
player simply plays `σ`'s placement, which lands back in the reachable set by the
very definition of reachability. What remains are the two genuinely true,
strategy-local obligations: `hpiece`/`hvalid` (σ names an in-bounds placement of
the demanded piece) and `hheight` (σ keeps every visited board height-bounded).
The second is the real content — but it is now stated correctly: the height bound
need only hold along states `σ` actually produces, never on adversary-injected
shapes. This is the carrier the surface-invariant machinery should feed, with the
landing lemmas supplying the inductive step of an `hheight` proof rather than an
impossible universal closure. -/
theorem tetrisSolvableValid_of_strategy
    (σ : Bag → Board → Piece → Placement)
    (hpiece : ∀ T b p, (σ T b p).piece = p)
    (hvalid : ∀ T b, ReachableUnder σ T b → ∀ p, p ∈ T →
        (σ T b p).Valid GameConfig.standard)
    (hheight : ∀ T b, ReachableUnder σ T b →
        ∀ j, Board.colHeight b j ≤ GameConfig.standard.rows) :
    TetrisSolvableValid :=
  tetrisSolvableValid_of_bag_indexed_invariant (ReachableUnder σ)
    ReachableUnder.init
    hheight
    (fun T b hb p hp =>
      ⟨σ T b p, hpiece T b p, hvalid T b hb p hp, ReachableUnder.step hb hp⟩)

/-- **Atlas existence from a single board invariant.** The fully packaged route-A
reduction: it pre-performs the reachability induction of
`tetrisSolvableValid_of_strategy`, so the entire `TetrisSolvableValid` verdict
rests on exhibiting a strategy `σ` together with a *board* predicate `I` that is

* satisfied by the empty board (`hI_init`),
* preserved by `σ`'s response to every drawable piece (`hI_step`),
* strong enough to force `σ`'s placement to be in-bounds (`hI_valid`), and
* strong enough to bound every column height (`hI_height`).

The reachability induction (`ReachableUnder σ T b → I b`) is discharged once, here,
so downstream work never re-derives it: it need only design `σ`, name `I`, and
prove these four self-contained facts about a *player-built* surface. This is the
correct home for the surface-invariant machinery — the landing and valley lemmas
become the proof of `hI_step`, applied only to boards `σ` actually produces. -/
theorem tetrisSolvableValid_of_strategy_invariant
    (σ : Bag → Board → Piece → Placement)
    (I : Board → Prop)
    (hpiece : ∀ T b p, (σ T b p).piece = p)
    (hI_init : I Board.empty)
    (hI_step : ∀ T b p, I b → p ∈ T →
        I (Placement.applyStep GameConfig.standard b { (σ T b p) with piece := p }))
    (hI_valid : ∀ T b p, I b → p ∈ T → (σ T b p).Valid GameConfig.standard)
    (hI_height : ∀ b, I b → ∀ j, Board.colHeight b j ≤ GameConfig.standard.rows) :
    TetrisSolvableValid := by
  have hreach : ∀ T b, ReachableUnder σ T b → I b := by
    intro T b h
    induction h with
    | init => exact hI_init
    | step hr hp ih => exact hI_step _ _ _ ih hp
  exact tetrisSolvableValid_of_strategy σ hpiece
    (fun T b hb p hp => hI_valid T b p (hreach T b hb) hp)
    (fun T b hb => hI_height b (hreach T b hb))

/-- **Atlas existence reduces to a pocket-band-carrier strategy.** The pocket-band specialisation
of `tetrisSolvableValid_of_strategy_invariant`: taking the player-built invariant `I` to be
`Board.IsPocketBandCarrier`, the two cheap obligations discharge outright — `hI_init` by
`Board.isPocketBandCarrier_empty` (the empty board is a carrier) and `hI_height` by
`Board.isPocketBandCarrier_height` (every carrier column sits at most `rows` high). The whole
`TetrisSolvableValid` verdict therefore rests on just the strategy-local content: a `σ` that names
the demanded piece (`hpiece`), keeps the pocket-band carrier across its response to every drawable
piece (`hstep`), and only ever plays in-bounds placements (`hvalid`). This isolates the genuine
open core (#66): the carrier is NOT closed under a single arbitrary piece, so a discharge of
`hstep` must route through a player-built σ that re-flattens at bag boundaries — exactly the
fill-then-drain regulator the carrier half-cycle lemmas certify
(`Board.isPocketBandCarrier_fill_then_drain_bounded`). -/
theorem tetrisSolvableValid_of_pocketBandCarrier_strategy
    (σ : Bag → Board → Piece → Placement)
    (hpiece : ∀ T b p, (σ T b p).piece = p)
    (hstep : ∀ T b p, Board.IsPocketBandCarrier b → p ∈ T →
        Board.IsPocketBandCarrier
          (Placement.applyStep GameConfig.standard b { (σ T b p) with piece := p }))
    (hvalid : ∀ T b p, Board.IsPocketBandCarrier b → p ∈ T →
        (σ T b p).Valid GameConfig.standard) :
    TetrisSolvableValid :=
  tetrisSolvableValid_of_strategy_invariant σ Board.IsPocketBandCarrier hpiece
    Board.isPocketBandCarrier_empty
    hstep
    hvalid
    (fun b hb => Board.isPocketBandCarrier_height hb)

/-- **Atlas existence from a spread-2 budgeted pocket-band-carrier strategy.** The spread-pinned
specialisation of `tetrisSolvableValid_of_pocketBandCarrier_strategy`: taking the player-built
invariant to be `Board.IsBoundedPocketBandCarrier 2` (the carrier whose every visited surface is a
level pocket band of spread at most `2` for some floor), the two cheap obligations discharge
outright — `hI_init` by `Board.isBoundedPocketBandCarrier_empty` (the empty board is a spread-2
carrier, as `2 ≤ rows`) and `hI_height` by `Board.isBoundedPocketBandCarrier_height` (every
budgeted-carrier column sits at most `rows` high). The whole `TetrisSolvableValid` verdict therefore
rests on the strategy-local content over the BUDGETED carrier: a `σ` that names the demanded piece
(`hpiece`), keeps the spread-2 pocket-band carrier across its response to every drawable piece
(`hstep`), and only plays in-bounds placements (`hvalid`). This is the budgeted-vocabulary front
door — strictly tighter than the bare-carrier `tetrisSolvableValid_of_pocketBandCarrier_strategy`,
since the `σ` must now hold the spread headroom fixed at `2`, exactly the discipline the
fill-then-drain regulator enforces by returning every surface to a spread-2 band
(`Board.isBoundedPocketBandCarrier_fill_then_drain_bounded`). -/
theorem tetrisSolvableValid_of_boundedPocketBandCarrier_strategy
    (σ : Bag → Board → Piece → Placement)
    (hpiece : ∀ T b p, (σ T b p).piece = p)
    (hstep : ∀ T b p, Board.IsBoundedPocketBandCarrier 2 b → p ∈ T →
        Board.IsBoundedPocketBandCarrier 2
          (Placement.applyStep GameConfig.standard b { (σ T b p) with piece := p }))
    (hvalid : ∀ T b p, Board.IsBoundedPocketBandCarrier 2 b → p ∈ T →
        (σ T b p).Valid GameConfig.standard) :
    TetrisSolvableValid :=
  tetrisSolvableValid_of_strategy_invariant σ (Board.IsBoundedPocketBandCarrier 2) hpiece
    (Board.isBoundedPocketBandCarrier_empty (by decide))
    hstep
    hvalid
    (fun b hb => Board.isBoundedPocketBandCarrier_height hb)

/-- **Bag-indexed strategy reduction (phase-aware).** The same route-A reduction as
`tetrisSolvableValid_of_strategy_invariant`, but the carried invariant `P : Bag → Board → Prop`
may depend on the *bag* as well as the board. This is the structural upgrade the atlas
crux demands: the admissible surface differs by bag phase (a notch must be carried while
`S`/`Z` are still owed, dropped once spent), so a board-only invariant cannot express it.

The proof is the same two-step bridge: `ReachableUnder σ T b → P T b` follows by induction
on the reachability derivation (`init` gives `hP_init`; `step` re-establishes `P` across the
σ-move via `hP_step`, threading the *drawn* bag `T.draw p`), after which the height and
validity obligations on reachable boards reduce to `hP_height` and `hP_valid`. The genuinely
hard content is now isolated entirely in `hP_step` — the phase-indexed surface closure a
concrete σ must satisfy at every move, including the bag-boundary re-flatten. -/
theorem tetrisSolvableValid_of_strategy_bagInvariant
    (σ : Bag → Board → Piece → Placement)
    (P : Bag → Board → Prop)
    (hpiece : ∀ T b p, (σ T b p).piece = p)
    (hP_init : P Bag.full Board.empty)
    (hP_step : ∀ T b p, P T b → p ∈ T →
        P (T.draw p) (Placement.applyStep GameConfig.standard b { (σ T b p) with piece := p }))
    (hP_valid : ∀ T b p, P T b → p ∈ T → (σ T b p).Valid GameConfig.standard)
    (hP_height : ∀ T b, P T b → ∀ j, Board.colHeight b j ≤ GameConfig.standard.rows) :
    TetrisSolvableValid := by
  have hreach : ∀ T b, ReachableUnder σ T b → P T b := by
    intro T b h
    induction h with
    | init => exact hP_init
    | step hr hp ih => exact hP_step _ _ _ ih hp
  exact tetrisSolvableValid_of_strategy σ hpiece
    (fun T b hb p hp => hP_valid T b p (hreach T b hb) hp)
    (fun T b hb => hP_height T b (hreach T b hb))

/-- **The phase-indexed surface carrier.** A board `b` is admissible while the
bag still holds `T` exactly when:

* its surface is always a flat-top *or* notched flat-top reserved-well skyline
  (height-bounded, hence never lost); and
* whenever the bag owes *no* staircase piece (`¬(S ∈ T ∨ Z ∈ T)`), the surface is
  specifically a plain flat top — once `S`/`Z` are both spent there is no need for
  (and the carrier forbids) a notch.

The notch is thus carried *exactly* while a staircase piece is still owed,
mirroring the bag-phase transition table (`Bag.draw_owes_staircase_or_spent_SZ`
for the notch phase, `Bag.draw_full_or_no_SZ_of_no_SZ` for the flat phase). The
first conjunct is a top-level invariant so the height obligation reads off
directly; the second conjunct is the phase constraint a future `hstep` discharge
must re-establish after each move. -/
def bagPhaseCarrier (T : Bag) (b : Board) : Prop :=
  (Board.IsFlatTopRWSkyline GameConfig.standard b ∨
      Board.IsNotchedFlatTopRWSkyline GameConfig.standard b) ∧
  (¬(Piece.S ∈ T ∨ Piece.Z ∈ T) → Board.IsFlatTopRWSkyline GameConfig.standard b)

/-- **`init` lands in the carrier** (the `hinit` obligation). The empty board with
a full bag is admissible: empty is a flat-top reserved-well skyline
(`isFlatTopRWSkyline_empty`), satisfying the first conjunct via the flat disjunct,
and the full bag owes both staircase pieces (`Bag.mem_full`), so the flat-phase
clause is vacuously true. -/
theorem bagPhaseCarrier_init : bagPhaseCarrier Bag.full Board.empty :=
  ⟨Or.inl (Board.isFlatTopRWSkyline_empty GameConfig.standard),
   fun h => absurd (Or.inl (Bag.mem_full Piece.S)) h⟩

/-- **The carrier is height-bounded** (the `hheight` obligation). Every admissible
board is a flat-top or notched flat-top skyline, so by
`Board.colHeight_le_of_isFlatTop_or_isNotched` every column height is ≤ `rows` —
loss is ruled out for free, in every bag phase. -/
theorem bagPhaseCarrier_height (T : Bag) (b : Board) (hP : bagPhaseCarrier T b)
    (j : ℕ) : Board.colHeight b j ≤ GameConfig.standard.rows :=
  Board.colHeight_le_of_isFlatTop_or_isNotched hP.1 j

/-- **The carrier projects onto a reserved-well skyline.** Both faces of the
first conjunct — flat-top and notched flat-top — forget to a reserved-well
skyline (`isReservedWellSkyline_of_isFlatTopRWSkyline`,
`isReservedWellSkyline_of_isNotchedFlatTopRWSkyline`). This is the structural
bridge a future `hstep` discharge opens with: the seven per-piece landing lemmas
(`isReservedWellSkyline_*_hstep`, `isReservedWellSkyline_flatShelf_hstep`, the
well clears) are all stated against an `IsReservedWellSkyline` hypothesis, so a
carrier step first projects the admissible board down to a reserved well, lands
the piece, then re-tightens the result back into a carrier face. -/
theorem bagPhaseCarrier_isReservedWell {T : Bag} {b : Board}
    (hP : bagPhaseCarrier T b) :
    Board.IsReservedWellSkyline GameConfig.standard b := by
  rcases hP.1 with hf | hn
  · exact Board.isReservedWellSkyline_of_isFlatTopRWSkyline hf
  · exact Board.isReservedWellSkyline_of_isNotchedFlatTopRWSkyline hn

/-- **The carrier projects onto a spread-bounded band skyline of spread ≤ 1.**
The unified surface form of `bagPhaseCarrier_isReservedWell`: every admissible
board is a band reserved-well skyline whose off-well columns span at most one row
(`IsSpreadBoundedRWSkyline standard s` with `s ≤ 1`). The flat-top face lands at
spread `0` (`isSpreadBoundedRWSkyline_of_isFlatTopRWSkyline`), the notched face at
spread `1` (`isSpreadBoundedRWSkyline_of_isNotchedFlatTopRWSkyline`), so the band
carrier is a *common generalisation* of both `bagPhaseCarrier` faces. This is the
single predicate a spread-bounded `hstep` discharge targets: rather than case-split
flat-top vs. notched on every move, a closure step reads the surface as one band of
spread ≤ 1, lands the piece, and re-tightens the spread back under `1`. -/
theorem bagPhaseCarrier_isSpreadBounded {T : Bag} {b : Board}
    (hP : bagPhaseCarrier T b) :
    ∃ s ≤ 1, Board.IsSpreadBoundedRWSkyline GameConfig.standard s b := by
  rcases hP.1 with hf | hn
  · exact ⟨0, Nat.zero_le 1, Board.isSpreadBoundedRWSkyline_of_isFlatTopRWSkyline hf⟩
  · exact ⟨1, le_refl 1, Board.isSpreadBoundedRWSkyline_of_isNotchedFlatTopRWSkyline hn⟩

/-- **The carrier's scalar-potential ceiling.** The `maxColHeight` face of
`bagPhaseCarrier_height`: an admissible board projects to a reserved-well skyline
(`bagPhaseCarrier_isReservedWell`), whose surface potential is capped by `rows`
(`maxColHeight_le_rows_of_isReservedWellSkyline`). Where `bagPhaseCarrier_height`
serves the per-column field bound, this serves the potential-route reasoning —
the `maxColHeight ≤ rows` invariant the per-piece `..._le_rows` bounds maintain
move-to-move — so an `hstep` discharge can read the carrier's height budget off a
single scalar without unfolding to columns. -/
theorem bagPhaseCarrier_maxColHeight_le {T : Bag} {b : Board}
    (hP : bagPhaseCarrier T b) :
    Board.maxColHeight GameConfig.standard b ≤ GameConfig.standard.rows :=
  Board.maxColHeight_le_rows_of_isReservedWellSkyline (bagPhaseCarrier_isReservedWell hP)

/-- **The carrier certifies non-loss outright.** The bridge from the carrier's
height budget to the canonical game-over predicate `Board.isLost`: every admissible
board has every column height at most `rows` (`bagPhaseCarrier_height`), and a
board whose columns are all capped by `rows` is not lost
(`Board.not_isLost_of_colHeight_le`). Where `bagPhaseCarrier_height` states the
budget as a column inequality, this restates it as the actual *survival* property
the affirmative atlas claim is about — no admissible board has spilled above the
visible field, so any play that stays inside the carrier never tops out. This is
the per-state safety certificate the closure ultimately accumulates into infinite
play. -/
theorem bagPhaseCarrier_not_isLost {T : Bag} {b : Board}
    (hP : bagPhaseCarrier T b) :
    ¬ Board.isLost GameConfig.standard b :=
  Board.not_isLost_of_colHeight_le (fun j => bagPhaseCarrier_height T b hP j)

/-- **The carrier certifies well-formedness.** The structural companion to
`bagPhaseCarrier_not_isLost`: an admissible board projects to a reserved-well skyline
(`bagPhaseCarrier_isReservedWell`), every filled cell of which sits in a real column,
so the board satisfies `Board.WF`. This is the well-formedness side-condition the atlas
reduction owes whenever it folds a valid placement onto a carrier board
(`Placement.applyStep_wf` and `foldl_applyStep_wf` both require a `WF` premise),
discharged uniformly from carrier membership alongside the non-loss certificate. -/
theorem bagPhaseCarrier_wf {T : Bag} {b : Board}
    (hP : bagPhaseCarrier T b) :
    Board.WF GameConfig.standard b :=
  Board.wf_of_isReservedWellSkyline (bagPhaseCarrier_isReservedWell hP)

/-- **The carrier's card budget.** Every admissible carrier board holds at most
`(cols - 1) * rows` filled cells. It projects to a reserved-well skyline
(`bagPhaseCarrier_isReservedWell`); the reserved well contributes `0` to the cell count
(`Finset.sum_erase` on the empty column), leaving the other `cols - 1` columns each capped
at `rows`. This is the static ceiling the per-bag card ledger
(`card_wellclear_after_foldl_le_card`) drifts beneath: the well-clear refunds
`4 * (cols - 1)` cells, exactly enough to absorb a capped bag's `+4`-per-piece growth, so a
board entering a bag under this budget exits under it. The *area* face of the carrier's
height guarantee — the potential the closure ultimately conserves — and strictly sharper
than the trivial whole-grid bound `cols * rows` because it banks the reserved well. -/
theorem bagPhaseCarrier_card_le {T : Bag} {b : Board}
    (hP : bagPhaseCarrier T b) :
    b.card ≤ (GameConfig.standard.cols - 1) * GameConfig.standard.rows :=
  Board.isReservedWellSkyline_card_le (bagPhaseCarrier_isReservedWell hP)

/-- **A flat top is admissible in *every* bag phase.** The universal injection from the
flat-top face into the headline carrier: a plain flat-top reserved-well board satisfies
`bagPhaseCarrier T b` for an arbitrary bag `T`, with no phase side-condition. It supplies
the first disjunct directly (`Or.inl`) and discharges the no-staircase clause vacuously
(the conclusion is exactly the hypothesis, `fun _ => h`). This is the structural reason a
well-clear that re-flattens is *unconditionally* safe — once the surface is flat the
phase no longer constrains it — and the reusable closing move for any `hstep` fragment
whose post-move board is flat (every `I` well-clear from the flat face). Generalises the
inline `⟨Or.inl _, fun _ => _⟩` the flat-top `I`-branch was using. -/
theorem bagPhaseCarrier_of_isFlatTopRWSkyline {T : Bag} {b : Board}
    (h : Board.IsFlatTopRWSkyline GameConfig.standard b) : bagPhaseCarrier T b :=
  ⟨Or.inl h, fun _ => h⟩

/-- **The empty board is admissible in *every* bag phase.** The phase-agnostic
generalisation of `bagPhaseCarrier_init`: `Board.empty` satisfies `bagPhaseCarrier T b`
for an *arbitrary* bag `T`, not just the full bag at game start. The empty board is a
flat-top reserved-well skyline (`Board.isFlatTopRWSkyline_empty`), and a flat top is
unconditionally admissible (`bagPhaseCarrier_of_isFlatTopRWSkyline`) — the no-staircase
clause is discharged vacuously by flatness, in any phase. This is the universal
safe-reset certificate: any strategy that can clear the board back to empty re-enters the
carrier no matter which pieces the bag still owes, so a full reset is always carrier-safe. -/
theorem bagPhaseCarrier_empty (T : Bag) : bagPhaseCarrier T Board.empty :=
  bagPhaseCarrier_of_isFlatTopRWSkyline (Board.isFlatTopRWSkyline_empty GameConfig.standard)

/-- **A notched top is admissible while a staircase piece is owed.** The
notched-face companion to `bagPhaseCarrier_of_isFlatTopRWSkyline`: a notched flat-top
reserved-well board satisfies `bagPhaseCarrier T b` *provided* the bag still owes an
`S` or a `Z` (`S ∈ T ∨ Z ∈ T`). It supplies the carrier's first disjunct via the notched
branch (`Or.inr`), and the still-owed staircase piece falsifies the no-staircase clause's
antecedent (`fun hno => absurd hSZ hno`). The phase hypothesis is exactly the carrier's
invariant "the notch is carried *only* while a staircase piece remains" — so this is the
reusable closing move for any `hstep` fragment whose post-move board is notched and whose
drawn piece keeps `S`/`Z` in the bag. Generalises the inline `⟨Or.inr _, …⟩` the notched
`I`-branch was using. -/
theorem bagPhaseCarrier_of_isNotchedFlatTopRWSkyline {T : Bag} {b : Board}
    (h : Board.IsNotchedFlatTopRWSkyline GameConfig.standard b)
    (hSZ : Piece.S ∈ T ∨ Piece.Z ∈ T) : bagPhaseCarrier T b :=
  ⟨Or.inr h, fun hno => absurd hSZ hno⟩

/-- **The standard notched surface is a carrier member while a staircase piece is owed.**
The carrier-vocabulary companion to `isNotchedFlatTopRWSkyline_standard_surface`: the very
board the all-seven dispatch (`isNotchedFlatTopRWSkyline_all7_hstep_standard`) steps *from* —
well at column `0`, single bump at column `3`, flat `base` elsewhere — sits in the headline
`bagPhaseCarrier T` for any bag `T` that still owes an `S` or a `Z`. It composes the concrete
notched-surface membership (`isNotchedFlatTopRWSkyline_standard_surface`, needing one cell of
headroom `base + 1 ≤ 20`) with the notched constructor
(`bagPhaseCarrier_of_isNotchedFlatTopRWSkyline`, consuming the still-owed staircase piece). This
is the *entry* certificate the notched phase of a closure quotes: it pins the abstract carrier
membership to the one concrete surface the seven-way landing dispatch is stated against, so a
notched-phase `hstep` can recognise its from-board as a carrier member with no re-derivation. -/
theorem bagPhaseCarrier_notched_standard_surface {T : Bag} {base : ℕ}
    (hbase : base + 1 ≤ GameConfig.standard.rows)
    (hSZ : Piece.S ∈ T ∨ Piece.Z ∈ T) :
    bagPhaseCarrier T
      (Board.skyline GameConfig.standard
        (fun j => if j = 0 then 0 else if j = 3 then base + 1 else base)) :=
  bagPhaseCarrier_of_isNotchedFlatTopRWSkyline
    (Board.isNotchedFlatTopRWSkyline_standard_surface hbase) hSZ

/-- **The standard flat surface is a carrier member in *every* phase.** The flat-top companion
to `bagPhaseCarrier_notched_standard_surface`: the concrete standard flat board — well at column
`0`, flat `base` everywhere else — sits in the headline `bagPhaseCarrier T` for an *arbitrary*
bag `T`, with no phase side-condition. It composes the concrete flat-surface membership
(`isFlatTopRWSkyline_standard_surface`, needing only `base ≤ 20`) with the unconditional flat
constructor (`bagPhaseCarrier_of_isFlatTopRWSkyline`). Where the notched companion must still owe
a staircase piece, the flat surface is admissible the moment it is flat — so this is the carrier
*entry* certificate for the flat phase the well-clear re-flattens into, the board a closure
returns to after each height-regulating `I` drop. -/
theorem bagPhaseCarrier_flatTop_standard_surface {T : Bag} {base : ℕ}
    (hbase : base ≤ GameConfig.standard.rows) :
    bagPhaseCarrier T
      (Board.skyline GameConfig.standard (fun j => if j = 0 then 0 else base)) :=
  bagPhaseCarrier_of_isFlatTopRWSkyline (Board.isFlatTopRWSkyline_standard_surface hbase)

/-- **Bag-boundary re-entry: every surface state is admissible at a refill.** The carrier's
first conjunct is exactly `IsFlatTopRWSkyline ∨ IsNotchedFlatTopRWSkyline`, so *whatever*
surface (flat or notched) a player ends a bag with becomes admissible the instant the bag
refills to `Bag.full`: a flat top is unconditionally admissible
(`bagPhaseCarrier_of_isFlatTopRWSkyline`), and a notched top is admissible because the full
bag owes both staircase pieces (`Bag.mem_full`), re-arming the notch obligation. This is the
clean *bag-boundary* certificate a per-bag closure turns on — the per-piece carrier need only
be re-established once per bag at the refill, and at that moment the phase side-condition is
automatically satisfied for both surface faces. It packages the two `bagPhaseCarrier_of_*`
constructors against the single bag `Bag.full` where every closure cycle restarts. -/
theorem bagPhaseCarrier_full_of_flatTop_or_notched {b : Board}
    (h : Board.IsFlatTopRWSkyline GameConfig.standard b ∨
        Board.IsNotchedFlatTopRWSkyline GameConfig.standard b) :
    bagPhaseCarrier Bag.full b := by
  rcases h with hf | hn
  · exact bagPhaseCarrier_of_isFlatTopRWSkyline hf
  · exact bagPhaseCarrier_of_isNotchedFlatTopRWSkyline hn (Or.inl (Bag.mem_full Piece.S))

/-- **At a bag refill the carrier *is* the surface predicate.** Characterises carrier membership
against the full bag: `bagPhaseCarrier Bag.full b` holds *exactly* when `b` is a flat-top or
notched flat-top reserved-well skyline — the phase side-condition vanishes entirely. The forward
direction is the first projection (`hP.1`); the backward direction is
`bagPhaseCarrier_full_of_flatTop_or_notched`. The phase clause is vacuous because the full bag
owes a staircase piece (`Bag.mem_full Piece.S` makes its antecedent `¬(S ∈ full ∨ Z ∈ full)`
false), so at every refill — where a per-bag closure cycle restarts — admissibility decouples
from the phase and reduces to a pure check on the surface shape. This is the clean fixed point a
bag-indexed closure returns to: prove the surface lands back in `flat ∨ notched` once per bag and
the phase bookkeeping inside the bag takes care of itself. -/
theorem bagPhaseCarrier_full_iff {b : Board} :
    bagPhaseCarrier Bag.full b ↔
      (Board.IsFlatTopRWSkyline GameConfig.standard b ∨
        Board.IsNotchedFlatTopRWSkyline GameConfig.standard b) :=
  ⟨fun hP => hP.1, bagPhaseCarrier_full_of_flatTop_or_notched⟩

/-- **In the spent-staircase (flat) phase the carrier *is* the flat top.** The flat-phase
companion to `bagPhaseCarrier_full_iff`: once the bag owes neither `S` nor `Z`
(`¬(S ∈ T ∨ Z ∈ T)`), `bagPhaseCarrier T b` holds *exactly* when `b` is a plain flat-top
reserved-well skyline — the notched disjunct is excluded. The forward direction reads the
flat-phase clause off the carrier (`hP.2 hno`); the backward direction is the unconditional
`bagPhaseCarrier_of_isFlatTopRWSkyline`. Where `bagPhaseCarrier_full_iff` pins the carrier at the
bag boundary (notch *permitted*), this pins it in the flat phase (notch *forbidden*): together
the two iffs characterise the carrier exactly in both phases where it is a pure surface predicate
— a refill admits either face, a spent-staircase bag admits only the flat face. This is the
invariant a flat-phase `hstep` must re-establish: a flat top stepped by a flat-shelf piece (the
only kind the bag can still hold, by `mem_flatShelf_pieces_of_no_SZ`) has to re-flatten to stay in
the carrier while no staircase piece is owed. -/
theorem bagPhaseCarrier_no_SZ_iff {T : Bag} {b : Board}
    (hno : ¬(Piece.S ∈ T ∨ Piece.Z ∈ T)) :
    bagPhaseCarrier T b ↔ Board.IsFlatTopRWSkyline GameConfig.standard b :=
  ⟨fun hP => hP.2 hno, fun h => bagPhaseCarrier_of_isFlatTopRWSkyline h⟩

/-- **First `hstep` fragment landing in the headline carrier (flat-top well clear).**
The carrier-level lift of `isFlatTopRWSkyline_vertI_hstep_reduction`: from a flat-top
reserved-well board at common height `base ≥ 4`, the vertical `I` well-clear lands a
valid placement whose post-move board is admissible *in the headline `bagPhaseCarrier`*
under the drawn bag `T.draw I` — for **every** bag phase `T`. The key is that the clear
re-flattens to a plain flat-top, and a flat-top board satisfies the carrier in any phase:
it supplies the first disjunct (`Or.inl`) and, being flat, also discharges the
no-staircase clause vacuously (`fun _ => hflat`). Unlike the earlier fragments — which
exit to an intermediate `IsFlatTopRWSkyline`/`IsReservedWellSkyline` — this one closes the
`I` branch of the carrier's own `hstep` outright, the height-regulator move that offsets
the other pieces' upward raises across a bag. -/
theorem bagPhaseCarrier_flatTop_vertI_hstep {T : Bag} {base w : ℕ}
    (hw : w < GameConfig.standard.cols) (hbase : base ≤ GameConfig.standard.rows)
    (hbase4 : 4 ≤ base) :
    ∃ pl : Placement, pl.piece = Piece.I ∧ pl.Valid GameConfig.standard ∧
      bagPhaseCarrier (T.draw Piece.I)
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (fun j => if j = w then 0 else base))
          { pl with piece := Piece.I }) := by
  obtain ⟨pl, hpiece, hvalid, hflat⟩ :=
    isFlatTopRWSkyline_vertI_hstep_reduction (cfg := GameConfig.standard) hw hbase hbase4
  exact ⟨pl, hpiece, hvalid, bagPhaseCarrier_of_isFlatTopRWSkyline hflat⟩

/-- **Notched-carrier `hstep` fragment (well clear, staircase still owed).** The
notched-phase companion to `bagPhaseCarrier_flatTop_vertI_hstep`. On a *notched*
flat-top reserved-well board (well `w`, bump `m`, common height `base ≥ 4`) with the
bag still owing a staircase piece (`S ∈ T ∨ Z ∈ T`), the vertical-`I` well-clear lands
a valid placement whose post-move board is admissible in the headline
`bagPhaseCarrier (T.draw I)`. Two facts combine: the clear re-enters the *notched*
family lowered by four (`Board.isNotchedFlatTopRWSkyline_vertI_hstep`, transported into
reduction shape by `exists_validPlacement_eta`), supplying the carrier's first disjunct
(`Or.inr`); and drawing `I`—which is neither `S` nor `Z`—keeps the owed staircase piece
in the bag (`Bag.owes_staircase_of_draw_of_ne_SZ`), so the no-staircase clause stays
vacuous. Thus the `I` branch of the carrier's `hstep` closes outright in the notch phase
too, the height-regulator that offsets the staircase pieces' raises while the notch is
still required. -/
theorem bagPhaseCarrier_notched_vertI_hstep {T : Bag} {base w m : ℕ}
    (hw : w < GameConfig.standard.cols) (hm : m < GameConfig.standard.cols) (hwm : w ≠ m)
    (hbase : base + 1 ≤ GameConfig.standard.rows) (hbase4 : 4 ≤ base)
    (hSZ : Piece.S ∈ T ∨ Piece.Z ∈ T) :
    ∃ pl : Placement, pl.piece = Piece.I ∧ pl.Valid GameConfig.standard ∧
      bagPhaseCarrier (T.draw Piece.I)
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard
            (fun j => if j = w then 0 else if j = m then base + 1 else base))
          { pl with piece := Piece.I }) := by
  obtain ⟨pl, hpiece, hvalid, hnotch⟩ :=
    exists_validPlacement_eta
      (Board.isNotchedFlatTopRWSkyline_vertI_hstep hw hm hwm hbase hbase4)
  refine ⟨pl, hpiece, hvalid, bagPhaseCarrier_of_isNotchedFlatTopRWSkyline hnotch ?_⟩
  have hstill : Piece.S ∈ T.draw Piece.I ∨ Piece.Z ∈ T.draw Piece.I :=
    Bag.owes_staircase_of_draw_of_ne_SZ (by decide) (by decide) hSZ
  exact hstill

/-- **Atlas existence reduces to two-phase-carrier closure (the tightest reduction).**
Instantiating `tetrisSolvableValid_of_bag_indexed_invariant` at the phase-indexed surface
carrier `bagPhaseCarrier` and discharging its two free obligations outright —
`bagPhaseCarrier_init` (empty board, full bag) and `bagPhaseCarrier_height` (every admissible
board is height-bounded, so never lost) — collapses the entire `TetrisSolvableValid` verdict
onto a *single* explicit hypothesis: from any admissible `(T, b)` and any piece `p` still owed
by the bag, the player has a valid placement of `p` whose post-move board is again admissible
under `T.draw p`. This is the exact crux the surface programme has been circling (`#66`): the
bag-transition table (`Bag.draw_full_or_no_SZ_of_no_SZ`, `Bag.draw_owes_staircase_or_spent_SZ`)
routes the phase, the `bagPhaseCarrier_of_*` constructors re-tighten each face, and the I-well
fragments (`bagPhaseCarrier_{flatTop,notched}_vertI_hstep`) already close the `I` branch in both
phases — so a full discharge of this `hstep` is *precisely* the remaining mathematical content
of the atlas-existence claim, with `hinit`/`hheight` permanently retired. -/
theorem tetrisSolvableValid_of_bagPhaseCarrier_closed
    (hstep : ∀ (T : Bag) (b : Board), bagPhaseCarrier T b → ∀ p, p ∈ T →
      ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
        bagPhaseCarrier (T.draw p)
          (Placement.applyStep GameConfig.standard b { pl with piece := p })) :
    TetrisSolvableValid :=
  tetrisSolvableValid_of_bag_indexed_invariant
    bagPhaseCarrier
    bagPhaseCarrier_init
    bagPhaseCarrier_height
    hstep

/-- **The bag-indexed reservoir carrier.** A `(bag, board)` pair is *reservoir-admissible*
when the board is a level pocket band of spread `2` for some exposed `floor`, AND that floor,
plus the number of pieces the bag still owes, plus one, stays under the row ceiling:
`floor + T.card + 1 ≤ rows`. The second conjunct is the **reservoir ledger** — a scalar
potential `floor + T.card` measuring how full the reservoir is. It reads `0 + 7 = 7` on the
empty board with a full bag, and is meant to be non-increasing across a flat non-I fill (each
placed piece spends one bag token, so `T.card` drops by one, while a flat repack lifts `floor`
by at most one) and to be reset by the guaranteed once-per-bag I-piece, which drains the well
and drops the floor. Pinning the spread to `2` keeps the band genuinely flat (only a two-row
ripple off the well), sidestepping the column-budget obstruction that forbids a single wide
surface from hosting all seven shapes; the bag phase is tracked by the ledger, not by a
widening spread. This is the reservoir refinement of `bagPhaseCarrier`: where that carrier
reads the bag phase off the S and Z notch, this one reads it off a height ledger keyed to the
bag clock `T.card`. The `init` and `height` faces below are immediate; the genuine remaining
content is the per-bag closure (the `hstep` crux `#66`) that the ledger exists to make
provable. -/
def reservoirCarrier (T : Bag) (b : Board) : Prop :=
  ∃ floor : ℕ,
    Board.IsLevelPocketBandAt GameConfig.standard 2 floor b ∧
    floor + T.card + 1 ≤ GameConfig.standard.rows

/-- **The reservoir carrier forgets to the spread-`2` bounded pocket-band carrier.** Dropping
the ledger conjunct leaves exactly an `IsBoundedPocketBandCarrier 2` witness — the floor the
reservoir tracks is the existential floor the bounded carrier hides. This is the bridge that
lets the reservoir reuse every spread-`2` band lemma already proven (height, not-lost, the
fill-then-drain half-cycle). -/
theorem reservoirCarrier_isBoundedPocketBandCarrier {T : Bag} {b : Board}
    (h : reservoirCarrier T b) : Board.IsBoundedPocketBandCarrier 2 b := by
  obtain ⟨floor, hband, _⟩ := h
  exact ⟨floor, hband⟩

/-- **`init` lands in the reservoir carrier** (the `hinit` obligation). The empty board is a
floor-`0` level pocket band at spread `2` (`isLevelPocketBandAt_empty`, needing only `2 ≤ rows`
and `4 < cols`), and the ledger reads `0 + 7 + 1 = 8 ≤ 20` on the full bag (`Bag.full_card`). -/
theorem reservoirCarrier_init : reservoirCarrier Bag.full Board.empty := by
  refine ⟨0, Board.isLevelPocketBandAt_empty GameConfig.standard (by decide) (by decide), ?_⟩
  rw [Bag.full_card]; decide

/-- **The reservoir carrier is height-bounded** (the `hheight` obligation). Forgetting to the
spread-`2` bounded pocket-band carrier and reading off its height cap bounds every column by
`rows`, so loss is ruled out for free in every bag phase. -/
theorem reservoirCarrier_height (T : Bag) (b : Board) (h : reservoirCarrier T b) (j : ℕ) :
    Board.colHeight b j ≤ GameConfig.standard.rows :=
  Board.isBoundedPocketBandCarrier_height (reservoirCarrier_isBoundedPocketBandCarrier h) j

/-- **Atlas existence reduces to reservoir-carrier closure.** Instantiating
`tetrisSolvableValid_of_bag_indexed_invariant` at the bag-indexed reservoir carrier and
discharging its initial and height obligations outright — `reservoirCarrier_init` (empty board,
full bag, ledger `8 ≤ 20`) and `reservoirCarrier_height` (every reservoir board is a spread-`2`
band, hence height-bounded, hence never lost) — collapses the whole `TetrisSolvableValid`
verdict onto a single explicit hypothesis: from any reservoir-admissible `(T, b)` and any piece
`p` the bag still owes, the player has a valid placement of `p` whose post-move board is again
reservoir-admissible under `T.draw p`. This is the reservoir-vocabulary form of the `#66` crux,
with the ledger now available to the discharger as the headroom budget that the once-per-bag
I-drain replenishes. -/
theorem tetrisSolvableValid_of_reservoirCarrier_closed
    (hstep : ∀ (T : Bag) (b : Board), reservoirCarrier T b → ∀ p, p ∈ T →
      ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
        reservoirCarrier (T.draw p)
          (Placement.applyStep GameConfig.standard b { pl with piece := p })) :
    TetrisSolvableValid :=
  tetrisSolvableValid_of_bag_indexed_invariant
    reservoirCarrier
    reservoirCarrier_init
    reservoirCarrier_height
    hstep

/-- **The reservoir's I-regulator drain edge** (the "a drain is always available" half of the
bag closure). On any reservoir board whose witnessed band floor is at least `4`, the reserved
well admits a vertical `I` that clears four rows and drops the floor to `floor - 4`
(`isLevelPocketBandAt_vertI_descends`), landing in the spread-`2` band at the lower floor. As
long as drawing the `I` does not refill the bag (`(T.draw I).card ≤ T.card`, i.e. the `I` is not
the bag's last owed piece), the reservoir ledger only improves — the floor drops by `4` while the
bag clock drops by one — so the post-drain board is again reservoir-admissible under `T.draw I`.
This is the once-per-bag regulator the surface route runs on: whatever the non-`I` pieces have
raised the band to, the guaranteed `I` brings the floor back down before the height limit is
reached. The excluded singleton-`I` case (where the draw refills the clock `1 ↦ 7`, adding `6`
against a floor drop of only `4`) is the bag-boundary content of the crux `#66`, handled by a
separate edge. -/
theorem reservoirCarrier_vertI_drain {T : Bag} {b : Board} {floor : ℕ}
    (hband : Board.IsLevelPocketBandAt GameConfig.standard 2 floor b)
    (hfloor : 4 ≤ floor)
    (hledger : floor + T.card + 1 ≤ GameConfig.standard.rows)
    (hcard : (T.draw Piece.I).card ≤ T.card) :
    ∃ plI : Placement, plI.piece = Piece.I ∧ plI.Valid GameConfig.standard ∧
      reservoirCarrier (T.draw Piece.I)
        (Placement.applyStep GameConfig.standard b plI) := by
  obtain ⟨plI, hpieceI, hvalidI, hdrain⟩ :=
    Board.isLevelPocketBandAt_vertI_descends hband hfloor
  exact ⟨plI, hpieceI, hvalidI, floor - 4, hdrain, by omega⟩

/-- **The reservoir drain edge, factored through the destination ledger.** Strict generalisation
of `reservoirCarrier_vertI_drain`: on any reservoir band at floor `floor ≥ 4`, the reserved well
admits the vertical `I` that drops the floor to `floor - 4`
(`isLevelPocketBandAt_vertI_descends`); the post-drain board re-enters `reservoirCarrier (T.draw I)`
as soon as the destination bag clock fits under the lowered floor,
`(floor - 4) + (T.draw I).card + 1 ≤ rows`. Stating the edge against the *destination* ledger
directly (rather than the source ledger plus a no-refill side condition) folds the refill and
non-refill cases into one brick: the non-refill case discharges the destination ledger from the
source ledger by monotonicity, while the bag-boundary refill case (`I` last, clock `1 ↦ 7`)
discharges it from a floor cap. -/
theorem reservoirCarrier_vertI_drain_ledger {T : Bag} {b : Board} {floor : ℕ}
    (hband : Board.IsLevelPocketBandAt GameConfig.standard 2 floor b)
    (hfloor : 4 ≤ floor)
    (hledger' : (floor - 4) + (T.draw Piece.I).card + 1 ≤ GameConfig.standard.rows) :
    ∃ plI : Placement, plI.piece = Piece.I ∧ plI.Valid GameConfig.standard ∧
      reservoirCarrier (T.draw Piece.I)
        (Placement.applyStep GameConfig.standard b plI) := by
  obtain ⟨plI, hpieceI, hvalidI, hdrain⟩ :=
    Board.isLevelPocketBandAt_vertI_descends hband hfloor
  exact ⟨plI, hpieceI, hvalidI, floor - 4, hdrain, hledger'⟩

/-- **The bag-boundary drain closes under a single floor cap.** The sharp resolution of the
spread-`2` ledger's bag-boundary gap (`#281`): whatever bag phase `T` we are in, and whether or
not drawing the `I` refills the clock, the `I`-drain re-enters `reservoirCarrier (T.draw I)`
provided the band floor sits at or below `rows - 4 = 16` when the `I` is played. The proof is pure
arithmetic on top of `reservoirCarrier_vertI_drain_ledger`: the drained floor is `floor - 4 ≤ 12`,
the destination clock is at most a full bag `(T.draw I).card ≤ 7` (`Bag.card_le_seven`), so the
destination ledger `(floor - 4) + (T.draw I).card + 1 ≤ 12 + 7 + 1 = 20` holds. This isolates the
entire once-per-bag closure obligation into the geometric task of keeping the floor `≤ 16` until
the guaranteed `I` arrives — the phase-shaped cap of `#281` candidate (2). -/
theorem reservoirCarrier_vertI_drain_cap {T : Bag} {b : Board} {floor : ℕ}
    (hband : Board.IsLevelPocketBandAt GameConfig.standard 2 floor b)
    (hfloor : 4 ≤ floor)
    (hcap : floor ≤ 16) :
    ∃ plI : Placement, plI.piece = Piece.I ∧ plI.Valid GameConfig.standard ∧
      reservoirCarrier (T.draw Piece.I)
        (Placement.applyStep GameConfig.standard b plI) := by
  apply reservoirCarrier_vertI_drain_ledger hband hfloor
  have h7 : (T.draw Piece.I).card ≤ 7 := Bag.card_le_seven _
  have hr : GameConfig.standard.rows = 20 := rfl
  omega

/-- **The reservoir's non-`I` absorption edge** (the "absorb the non-`I` pieces as they arrive"
half of the bag closure). Companion to the drain edges: where the `I` drops the floor, a non-`I`
piece *raises* it, and the reservoir ledger stays closed exactly when the rise is at most one
floor unit. Given the geometric fill witness — a valid placement of the drawn piece `p` landing
the post-move board in a spread-`2` level pocket band at floor `floor'` — together with the
floor-rise bound `floor' ≤ floor + 1` and a non-refill draw (`(T.draw p).card < T.card`, i.e. the
bag clock strictly ticks down, which holds for every non-final draw), the post-move board re-enters
`reservoirCarrier (T.draw p)`. The arithmetic is the dual of the drain: the bag clock buys exactly
one unit of headroom per draw (`floor + T.card + 1` is the ledger), so a unit floor rise is paid
for by the unit clock tick: `floor' + (T.draw p).card + 1 ≤ (floor + 1) + (T.card - 1) + 1 =
floor + T.card + 1 ≤ rows`. This reduces the entire non-`I` half of the per-piece `hstep` to the
single geometric obligation `floor' ≤ floor + 1` — that an arbitrary spread-`2` band member admits
a piece placement raising the floor by at most one (the `#89` content). -/
theorem reservoirCarrier_fill_step {T : Bag} {b : Board} {p : Piece} {floor floor' : ℕ}
    (hfill : ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      Board.IsLevelPocketBandAt GameConfig.standard 2 floor'
        (Placement.applyStep GameConfig.standard b { pl with piece := p }))
    (hrise : floor' ≤ floor + 1)
    (hledger : floor + T.card + 1 ≤ GameConfig.standard.rows)
    (hcard : (T.draw p).card < T.card) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard b { pl with piece := p }) := by
  obtain ⟨pl, hpiece, hvalid, hband'⟩ := hfill
  exact ⟨pl, hpiece, hvalid, floor', hband', by omega⟩

/-- **The non-`I` absorption edge under a single floor cap** (the bag-boundary face of the fill
edge, mirroring `reservoirCarrier_vertI_drain_cap`). When the drawn non-`I` piece is the bag's
last owed piece its draw refills the clock `1 ↦ 7`, so the non-refill ledger of
`reservoirCarrier_fill_step` no longer applies; instead, as with the drain, the closure collapses
to a single floor cap. Given the geometric fill witness landing the post-move board in a spread-`2`
level pocket band at floor `floor'`, the post-move board re-enters `reservoirCarrier (T.draw p)`
whenever `floor' ≤ rows - 8 = 12`, since the refilled clock is at most a full bag
(`(T.draw p).card ≤ 7`, `Bag.card_le_seven`) and `floor' + (T.draw p).card + 1 ≤ 12 + 7 + 1 = 20`.
Together with `reservoirCarrier_fill_step` this closes the non-`I` half of the `hstep` for every
bag phase: a unit floor rise suffices mid-bag, and the deeper cap `≤ 12` covers the refill
boundary — both reducing to the same geometric obligation of a controlled-rise landing band. -/
theorem reservoirCarrier_fill_step_cap {T : Bag} {b : Board} {p : Piece} {floor' : ℕ}
    (hfill : ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      Board.IsLevelPocketBandAt GameConfig.standard 2 floor'
        (Placement.applyStep GameConfig.standard b { pl with piece := p }))
    (hcap : floor' ≤ 12) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard b { pl with piece := p }) := by
  obtain ⟨pl, hpiece, hvalid, hband'⟩ := hfill
  refine ⟨pl, hpiece, hvalid, floor', hband', ?_⟩
  have h7 : (T.draw p).card ≤ 7 := Bag.card_le_seven _
  have hr : GameConfig.standard.rows = 20 := rfl
  omega

/-- **Reservoir membership from a band witness plus the ledger inequality.** The explicit-floor
constructor for `reservoirCarrier`: a spread-`2` level pocket band at floor `floor` together with
the scalar ledger bound `floor + T.card + 1 ≤ rows` is exactly reservoir-admissibility. This is
the brick every per-piece edge routes through — the geometric band edge supplies the post-move
band and floor, this lemma pairs it with the bag-clock arithmetic to land in the next carrier. -/
theorem reservoirCarrier_of_band_ledger {T : Bag} {b : Board} {floor : ℕ}
    (hband : Board.IsLevelPocketBandAt GameConfig.standard 2 floor b)
    (hledger : floor + T.card + 1 ≤ GameConfig.standard.rows) :
    reservoirCarrier T b :=
  ⟨floor, hband, hledger⟩

/-- **The empty board is reservoir-admissible against every bag.** Generalisation of
`reservoirCarrier_init` past the full bag: the empty board is a floor-`0` spread-`2` level pocket
band (`isLevelPocketBandAt_empty`), and the ledger `0 + T.card + 1 ≤ 20` holds for any bag, since
`T.card ≤ 7` (`Bag.card_le_seven`). This is the reset anchor — whenever the surface route drains
all the way back to the empty board, it re-enters the carrier no matter where in the bag cycle it
is. Mirrors `bagPhaseCarrier_empty`. -/
theorem reservoirCarrier_empty (T : Bag) : reservoirCarrier T Board.empty := by
  refine ⟨0, Board.isLevelPocketBandAt_empty GameConfig.standard (by decide) (by decide), ?_⟩
  have hr : GameConfig.standard.rows = 20 := rfl
  have h7 : T.card ≤ 7 := Bag.card_le_seven T
  omega

/-- **Canonical reset-surface fill closes the reservoir in place.** The bag-boundary fill
companion to `reservoirCarrier_vertI_drain_cap`: from the canonical reset surface the
all-seven dispatcher selects for the drawn piece `p` (the flat shelf for `O`, `I`, `T`, `L`,
`J`; the tailored notch for `S` and `Z`), there is a VALID placement of `p` whose post-move
board re-enters `reservoirCarrier (T.draw p)` at the SAME exposed floor `base`. Composes
`isLevelPocketBandAt_canonical_lands_all7` (every piece lands back in a spread-`2` level pocket
band at floor `base`) with `reservoirCarrier_of_band_ledger` (a band plus the ledger inequality
is reservoir-admissibility). Because the canonical landing keeps the floor pinned at `base`, the
fill spends zero floor units, so the only ledger obligation is the destination clock fitting
under the ceiling, `base + (T.draw p).card + 1 ≤ rows`. This is the zero-rise face of the non-`I`
fill half of the crux: at a fresh reset surface every drawn piece is absorbed without raising the
floor. What it does NOT yet give (the open `#66` content) is the fill from an ARBITRARY reservoir
band member, whose 2-bump landing is not itself a canonical reset surface, so the floor can rise
by one and the chain needs the once-per-bag drain to re-flatten toward a canonical shape. -/
theorem reservoirCarrier_canonical_fill_step {T : Bag} {base : ℕ} (p : Piece)
    (hslack : base + 2 ≤ GameConfig.standard.rows)
    (hledger : base + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ (s : ℕ → ℕ) (pl : Placement), pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard s)
          { pl with piece := p }) := by
  obtain ⟨s, pl, hpiece, hvalid, hband⟩ :=
    Board.isLevelPocketBandAt_canonical_lands_all7 hslack p
  refine ⟨s, pl, hpiece, hvalid, ?_⟩
  subst hpiece
  exact reservoirCarrier_of_band_ledger hband hledger

/-- **Arbitrary valley-band S/Z fill closes the reservoir in place.** The staircase analogue of
`reservoirCarrier_canonical_fill_step`, but from an ARBITRARY spread-`2` band member `skyline h`
carrying a width-four valley at `vc .. vc + 3` and a disjoint flat pocket at `pc .. pc + 3`
(`vc + 3 < pc`) rather than a constructed canonical surface. For either staircase piece
`p ∈ {S, Z}` the valley dispatcher (`isLevelPocketBandAt_valley_hosts_SZ_valid`) supplies a VALID
placement whose post-move board is again a spread-`2` level pocket band at the SAME floor `base`
(the `S` seats at the valley's right lip, the `Z` at its left, both leaving the flat pocket as the
surviving floor run). Pairing that zero-rise landing with the ledger inequality
`base + (T.draw p).card + 1 ≤ rows` (`reservoirCarrier_of_band_ledger`) re-enters
`reservoirCarrier (T.draw p)`. This is the staircase half of the arbitrary-member fill edge: unlike
the canonical version it does not get to pick the surface for the piece — `h` is given and the
valley must already be present — so it is the honest `#66`-shaped S/Z edge, reducing the staircase
absorption to the site-existence obligation that the carrier surface carries a shared valley. -/
theorem reservoirCarrier_valley_SZ_fill_step {T : Bag} {base vc pc : ℕ} {h : ℕ → ℕ} {p : Piece}
    (hp : p = Piece.S ∨ p = Piece.Z)
    (hslack : base + 2 ≤ GameConfig.standard.rows)
    (hw0 : h 0 = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ 0 → base ≤ h j ∧ h j ≤ base + 2)
    (hvc : 1 ≤ vc) (hord : vc + 3 < pc) (hpc3 : pc + 3 < GameConfig.standard.cols)
    (hv0 : h vc = base + 1) (hv1 : h (vc + 1) = base) (hv2 : h (vc + 2) = base)
    (hv3 : h (vc + 3) = base + 1)
    (hp0 : h pc = base) (hp1 : h (pc + 1) = base) (hp2 : h (pc + 2) = base)
    (hp3 : h (pc + 3) = base)
    (hledger : base + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
          { pl with piece := p }) := by
  obtain ⟨pl, hpiece, hvalid, hband'⟩ :=
    Board.isLevelPocketBandAt_valley_hosts_SZ_valid hp hslack hw0 hband hvc hord hpc3
      hv0 hv1 hv2 hv3 hp0 hp1 hp2 hp3
  refine ⟨pl, hpiece, hvalid, ?_⟩
  subst hpiece
  exact reservoirCarrier_of_band_ledger hband' hledger

/-- **Arbitrary wide-pocket-band flat fill closes the reservoir in place.** The flat-piece
companion to `reservoirCarrier_valley_SZ_fill_step`, completing the second half of the
arbitrary-member fill edge. From an ARBITRARY spread-`2` band member `skyline h` carrying a
width-eight flat run at columns `pc .. pc + 7`, each flat piece `p ∈ {O, I, T, L, J}` has a VALID
placement (`isLevelPocketBandAt_flatPiece_lands_widePocket_valid`) whose post-move board is again a
spread-`2` level pocket band at the SAME floor `base` (the width-eight run absorbs the piece and
regenerates a width-four pocket). Pairing that zero-rise landing with the ledger inequality
`base + (T.draw p).card + 1 ≤ rows` (`reservoirCarrier_of_band_ledger`) re-enters
`reservoirCarrier (T.draw p)`. Together with `reservoirCarrier_valley_SZ_fill_step` this gives the
arbitrary-member fill edge for all seven pieces: flats on a width-eight run, `S` and `Z` on a shared
width-four valley. The remaining `#66` gap is purely the site-existence obligation — that the
carrier surface simultaneously carries (in the right bag phase) the wide flat run or the shared
valley the incoming piece needs, which the ten-column budget forces to be bag-phase-aware. -/
theorem reservoirCarrier_widePocket_flat_fill_step {T : Bag} {base pc : ℕ} {h : ℕ → ℕ} {p : Piece}
    (hp : p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J)
    (hslack : base + 2 ≤ GameConfig.standard.rows)
    (hw0 : h 0 = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ 0 → base ≤ h j ∧ h j ≤ base + 2)
    (hpc : 1 ≤ pc) (hpc7 : pc + 7 < GameConfig.standard.cols)
    (hsite0 : h pc = base) (hsite1 : h (pc + 1) = base) (hsite2 : h (pc + 2) = base)
    (hsite3 : h (pc + 3) = base) (hsite4 : h (pc + 4) = base) (hsite5 : h (pc + 5) = base)
    (hsite6 : h (pc + 6) = base) (hsite7 : h (pc + 7) = base)
    (hledger : base + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
          { pl with piece := p }) := by
  obtain ⟨pl, hpiece, hvalid, hband'⟩ :=
    Board.isLevelPocketBandAt_flatPiece_lands_widePocket_valid hp hslack hw0 hband hpc hpc7
      hsite0 hsite1 hsite2 hsite3 hsite4 hsite5 hsite6 hsite7
  refine ⟨pl, hpiece, hvalid, ?_⟩
  subst hpiece
  exact reservoirCarrier_of_band_ledger hband' hledger

/-- **The non-regulator fill edge, reduced to one site-existence hypothesis.** Unifies the two
arbitrary-member non-`I` fill edges (`reservoirCarrier_widePocket_flat_fill_step` for the flats
`O, I, T, L, J`; `reservoirCarrier_valley_SZ_fill_step` for the staircases `S, Z`) behind a single
disjunctive `hsite` premise on the band `skyline h`: EITHER the drawn piece is a flat and `h`
carries a width-eight flat run at some `pc .. pc + 7`, OR it is a staircase and `h` carries a
width-four valley at some `vc .. vc + 3` together with a disjoint width-four flat pocket at
`pc .. pc + 3`. Given the spread-`2` band frame (`hw0`, `hband`, `hslack`) and the reservoir ledger
(`hledger`), either branch produces a VALID placement of `p` whose post-move board re-enters
`reservoirCarrier (T.draw p)` at the same floor `base`. This is the exact residue of the non-`I`
half of the `#66` crux: every non-regulator piece is absorbed PROVIDED its landing site is present
on the carrier surface. What remains open is purely `hsite` — that the bag-phase carrier guarantees,
for each piece the bag still owes, the site that piece needs — which the ten-column budget
(`well + width-8 run`, or `well + valley + pocket = 9`) forces to be bag-phase-aware rather than a
single fixed shape hosting all seven at once. -/
theorem reservoirCarrier_nonRegulator_fill_step {T : Bag} {base : ℕ} {h : ℕ → ℕ} {p : Piece}
    (hslack : base + 2 ≤ GameConfig.standard.rows)
    (hw0 : h 0 = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ 0 → base ≤ h j ∧ h j ≤ base + 2)
    (hledger : base + (T.draw p).card + 1 ≤ GameConfig.standard.rows)
    (hsite :
      ((p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J) ∧
        ∃ pc, 1 ≤ pc ∧ pc + 7 < GameConfig.standard.cols ∧
          h pc = base ∧ h (pc + 1) = base ∧ h (pc + 2) = base ∧ h (pc + 3) = base ∧
          h (pc + 4) = base ∧ h (pc + 5) = base ∧ h (pc + 6) = base ∧ h (pc + 7) = base) ∨
      ((p = Piece.S ∨ p = Piece.Z) ∧
        ∃ vc pc, 1 ≤ vc ∧ vc + 3 < pc ∧ pc + 3 < GameConfig.standard.cols ∧
          h vc = base + 1 ∧ h (vc + 1) = base ∧ h (vc + 2) = base ∧ h (vc + 3) = base + 1 ∧
          h pc = base ∧ h (pc + 1) = base ∧ h (pc + 2) = base ∧ h (pc + 3) = base)) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
          { pl with piece := p }) := by
  rcases hsite with
    ⟨hp, pc, hpc, hpc7, hs0, hs1, hs2, hs3, hs4, hs5, hs6, hs7⟩ |
    ⟨hp, vc, pc, hvc, hord, hpc3, hv0, hv1, hv2, hv3, hq0, hq1, hq2, hq3⟩
  · exact reservoirCarrier_widePocket_flat_fill_step hp hslack hw0 hband hpc hpc7
      hs0 hs1 hs2 hs3 hs4 hs5 hs6 hs7 hledger
  · exact reservoirCarrier_valley_SZ_fill_step hp hslack hw0 hband hvc hord hpc3
      hv0 hv1 hv2 hv3 hq0 hq1 hq2 hq3 hledger

/-- **The concrete flat-phase reservoir surface.** A reserved empty well at column `0` with
every working column `1 .. cols-1` flat at floor `base`. On the standard 10-wide board this is
the surface the reservoir presents when the bag owes no `S` or `Z`: cols `1 .. 9` form a flat
shelf at `base`, which contains the width-eight run (cols `1 .. 8`) every flat piece
`O, I, T, L, J` self-regenerates on. -/
def reservoirFlatSurface (base : ℕ) : ℕ → ℕ := fun j => if j = 0 then 0 else base

/-- **The flat-phase reservoir surface self-closes for every flat piece — concrete site
existence, flat branch.** A realizable witness for the existence half of `#66`/`#72`: the
concrete `reservoirFlatSurface base` (a reserved well at column `0`, flat shelf at `base`
everywhere else) is a spread-`2` level pocket band carrying a width-eight flat run at cols
`1 .. 8`, so by `reservoirCarrier_widePocket_flat_fill_step` every flat piece `p ∈ {O, I, T, L, J}`
has a VALID placement whose post-move board re-enters `reservoirCarrier (T.draw p)` at the same
floor `base`. This discharges the flat branch of the `hsite` obligation on an explicit carrier
surface, confirming the flat phase is non-vacuously realizable; the staircase `S` and `Z` phase
is the budget-tight companion (well plus valley plus pocket equals nine), built on its own
explicit surface. -/
theorem reservoirCarrier_flatPhase_hosts_flats {T : Bag} {base : ℕ} {p : Piece}
    (hp : p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J)
    (hslack : base + 2 ≤ GameConfig.standard.rows)
    (hledger : base + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirFlatSurface base)) { pl with piece := p }) :=
  reservoirCarrier_widePocket_flat_fill_step (pc := 1) hp hslack
    (by simp [reservoirFlatSurface])
    (by intro j _ hj0; simp only [reservoirFlatSurface]; split_ifs <;> omega)
    (by omega) (by decide)
    (by simp [reservoirFlatSurface]) (by simp [reservoirFlatSurface])
    (by simp [reservoirFlatSurface]) (by simp [reservoirFlatSurface])
    (by simp [reservoirFlatSurface]) (by simp [reservoirFlatSurface])
    (by simp [reservoirFlatSurface]) (by simp [reservoirFlatSurface])
    hledger

/-- **The concrete S and Z phase reservoir surface.** A reserved empty well at column `0`, a
shared width-4 valley `(base+1, base, base, base+1)` at columns `1 .. 4`, and a flat shelf at
floor `base` everywhere else. On the standard 10-wide board this is the surface the reservoir
presents when the bag still owes an `S` or a `Z`: the valley at cols `1 .. 4` seats both
staircases (S at the right lip, Z at the left lip), the flat run at cols `5 .. 8` carries the
flats, and the well at col `0` holds the once-per-bag drain — totalling `1 + 4 + 4 = 9 ≤ 10`,
the budget-tight layout `four_disjoint_blocks_card_le` forced. -/
def reservoirSZSurface (base : ℕ) : ℕ → ℕ :=
  fun j => if j = 0 then 0 else if j = 1 then base + 1 else if j = 4 then base + 1 else base

/-- **The S and Z phase reservoir surface hosts both staircases — concrete site existence,
staircase branch.** The budget-tight companion of `reservoirCarrier_flatPhase_hosts_flats`. The
concrete `reservoirSZSurface base` (a reserved well at column `0`, a shared width-4 valley at
columns `1 .. 4`, a flat shelf at `base` elsewhere) is a spread-`2` level pocket band whose valley
seats both `S` (right lip) and `Z` (left lip), so by `reservoirCarrier_valley_SZ_fill_step` each
staircase `p ∈ {S, Z}` has a VALID placement whose post-move board re-enters
`reservoirCarrier (T.draw p)` at the same floor `base`. Together with the flat-phase witness this
exhibits, on explicit carrier surfaces, the landing site every one of the seven pieces needs — the
existence half of the `#66`/`#72` crux is realizable in both bag phases, fitting the ten-column
budget the well plus valley plus pocket equals nine layout demands. -/
theorem reservoirCarrier_SZphase_hosts_SZ {T : Bag} {base : ℕ} {p : Piece}
    (hp : p = Piece.S ∨ p = Piece.Z)
    (hslack : base + 2 ≤ GameConfig.standard.rows)
    (hledger : base + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirSZSurface base)) { pl with piece := p }) :=
  reservoirCarrier_valley_SZ_fill_step (h := reservoirSZSurface base) (vc := 1) (pc := 5) hp hslack
    (by simp [reservoirSZSurface])
    (by intro j _ hj0; simp only [reservoirSZSurface]; split_ifs <;> omega)
    (by omega) (by omega) (by decide)
    (by simp [reservoirSZSurface]) (by simp [reservoirSZSurface])
    (by simp [reservoirSZSurface]) (by simp [reservoirSZSurface])
    (by simp [reservoirSZSurface]) (by simp [reservoirSZSurface])
    (by simp [reservoirSZSurface]) (by simp [reservoirSZSurface])
    hledger

/-- **The flat phase reservoir surface is itself a reservoir carrier member.** The input side
of `reservoirCarrier_flatPhase_hosts_flats`: the concrete `reservoirFlatSurface base` (reserved
well at column `0`, flat shelf at `base` elsewhere) is the `base`-floor spread-`2` level pocket
band `isLevelPocketBandAt_flatShelf_input` certifies, so pairing it with the reservoir ledger
`base + T.card + 1 ≤ rows` (`reservoirCarrier_of_band_ledger`) places the whole flat phase surface
inside `reservoirCarrier T`. This anchors the flat phase surface as a genuine carrier state — not
merely a launch pad from which flats self-close, but a board the carrier predicate already
admits — which is what a phase-routing closure step needs when it re-presents the flat surface to
the next owed flat. -/
theorem reservoirCarrier_flatSurface_mem {T : Bag} {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows)
    (hledger : base + T.card + 1 ≤ GameConfig.standard.rows) :
    reservoirCarrier T (Board.skyline GameConfig.standard (reservoirFlatSurface base)) := by
  have hband : Board.IsLevelPocketBandAt GameConfig.standard 2 base
      (Board.skyline GameConfig.standard (reservoirFlatSurface base)) :=
    Board.isLevelPocketBandAt_flatShelf_input hslack
  exact reservoirCarrier_of_band_ledger hband hledger

/-- **The S and Z phase reservoir surface is itself a reservoir carrier member.** The input side
of `reservoirCarrier_SZphase_hosts_SZ`: the concrete `reservoirSZSurface base` (reserved well at
column `0`, shared width-4 valley at columns `1 .. 4`, flat run at `base` elsewhere) is built into
a `base`-floor spread-`2` level pocket band by the smart constructor `isLevelPocketBandAt_skyline`,
reading the well at column `0` and the width-4 flat pocket at columns `5 .. 8` (the valley's
`base + 1` lips at columns `1` and `4` sit inside the spread-`2` band). Pairing that band with the
reservoir ledger (`reservoirCarrier_of_band_ledger`) places the whole staircase phase surface
inside `reservoirCarrier T`. Together with `reservoirCarrier_flatSurface_mem` this certifies that
BOTH bag-phase surfaces are carrier states, so a phase-routing closure may re-present either one as
a genuine carrier board rather than an external launch surface. -/
theorem reservoirCarrier_SZSurface_mem {T : Bag} {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows)
    (hledger : base + T.card + 1 ≤ GameConfig.standard.rows) :
    reservoirCarrier T (Board.skyline GameConfig.standard (reservoirSZSurface base)) := by
  have hband : Board.IsLevelPocketBandAt GameConfig.standard 2 base
      (Board.skyline GameConfig.standard (reservoirSZSurface base)) :=
    Board.isLevelPocketBandAt_skyline (spread := 2) (floor := base) (w := 0) (c := 5)
      (by decide) (by simp [reservoirSZSurface])
      (by intro j hj hj0; simp only [reservoirSZSurface]; split_ifs <;> omega)
      hslack (by decide) (by decide) (by decide) (by decide) (by decide)
      (by simp [reservoirSZSurface]) (by simp [reservoirSZSurface])
      (by simp [reservoirSZSurface]) (by simp [reservoirSZSurface])
  exact reservoirCarrier_of_band_ledger hband hledger

/-- **Both reset surfaces are carrier states, phase-routed by the owed staircase.** The weak
`reservoirCarrier` companion of iter311's `bandPhaseReservoirS_resetSurface`: consolidates
`reservoirCarrier_SZSurface_mem` and `reservoirCarrier_flatSurface_mem` behind the single phase
selector the bag closure actually dispatches on. When the bag still owes a staircase
(`Piece.S ∈ T ∨ Piece.Z ∈ T`) the reservoir presents `reservoirSZSurface base` (well plus shared
valley plus flat pocket); otherwise it presents `reservoirFlatSurface base` (well plus flat shelf).
Either way the surface is a `base`-floor reservoir carrier member under the ledger
`base + T.card + 1 ≤ rows`. This is the bag-boundary anchor for the weak carrier: whatever phase the
bag is in, the phase-correct reset surface is a genuine carrier board the once-per-bag drain can
target, mirroring the strong-carrier reset dispatcher one layer down. -/
theorem reservoirCarrier_resetSurface_mem {T : Bag} {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows)
    (hledger : base + T.card + 1 ≤ GameConfig.standard.rows) :
    reservoirCarrier T
      (Board.skyline GameConfig.standard
        (if Piece.S ∈ T ∨ Piece.Z ∈ T then reservoirSZSurface base
          else reservoirFlatSurface base)) := by
  by_cases h : Piece.S ∈ T ∨ Piece.Z ∈ T
  · rw [if_pos h]
    exact reservoirCarrier_SZSurface_mem hslack hledger
  · rw [if_neg h]
    exact reservoirCarrier_flatSurface_mem hslack hledger

/-- **Height cap of the flat reset surface.** The reserved-well flat shelf
`reservoirFlatSurface base` (well at column `0`, every other column pinned to `base`) never rises
above `base`: its skyline's `maxColHeight` is at most `base`. This is the height face of the flat
reset surface — the floor the once-per-bag drain targets when the bag owes no staircase — and feeds
the height-bound obligation of any per-bag carrier anchored on it. -/
theorem maxColHeight_reservoirFlatSurface (base : ℕ) :
    Board.maxColHeight GameConfig.standard
      (Board.skyline GameConfig.standard (reservoirFlatSurface base)) ≤ base := by
  apply Board.maxColHeight_skyline_le_of_forall
  intro j _
  simp only [reservoirFlatSurface]
  split_ifs <;> omega

/-- **Height cap of the SZ reset surface.** The shared-valley reset surface
`reservoirSZSurface base` (well at column `0`, the two valley lips at columns `1` and `4` raised to
`base + 1`, every other
working column at `base`) never rises above `base + 1`: its skyline's `maxColHeight` is at most
`base + 1`. The extra `+ 1` over `maxColHeight_reservoirFlatSurface` is exactly the valley-lip
overhead the staircase phase pays. This is the height face of the SZ reset surface — the floor the
once-per-bag drain targets when the bag still owes a staircase — and feeds the height-bound
obligation of any per-bag carrier anchored on it. -/
theorem maxColHeight_reservoirSZSurface (base : ℕ) :
    Board.maxColHeight GameConfig.standard
      (Board.skyline GameConfig.standard (reservoirSZSurface base)) ≤ base + 1 := by
  apply Board.maxColHeight_skyline_le_of_forall
  intro j _
  simp only [reservoirSZSurface]
  split_ifs <;> omega

/-- **`hheight` face of the flat reset surface.** The flat reset surface in the exact per-column
shape `tetrisSolvableValid_of_bag_indexed_invariant` demands of `hheight`: every column profile of
`Board.skyline (reservoirFlatSurface base)` is at most `rows`, for *every* `j` (including the
out-of-field columns, where the skyline profile is zero). Under the slack `base ≤ rows` this is the
bag-boundary height obligation a per-bag carrier discharges whenever the drained bag owes no
staircase and resets to the flat shelf. -/
theorem colHeight_reservoirFlatSurface_le {base : ℕ}
    (hbase : base ≤ GameConfig.standard.rows) (j : ℕ) :
    Board.colHeight (Board.skyline GameConfig.standard (reservoirFlatSurface base)) j
      ≤ GameConfig.standard.rows := by
  apply Board.colHeight_skyline_le
  intro k _
  simp only [reservoirFlatSurface]
  split_ifs <;> omega

/-- **`hheight` face of the SZ reset surface.** The staircase-phase companion of
`colHeight_reservoirFlatSurface_le`: every column profile of
`Board.skyline (reservoirSZSurface base)`
is at most `rows`, for every `j`. The valley lips cost one extra row, so the slack tightens to
`base + 1 ≤ rows`. This is the bag-boundary height obligation when the drained bag still owes a
staircase and resets to the shared-valley surface. -/
theorem colHeight_reservoirSZSurface_le {base : ℕ}
    (hbase : base + 1 ≤ GameConfig.standard.rows) (j : ℕ) :
    Board.colHeight (Board.skyline GameConfig.standard (reservoirSZSurface base)) j
      ≤ GameConfig.standard.rows := by
  apply Board.colHeight_skyline_le
  intro k _
  simp only [reservoirSZSurface]
  split_ifs <;> omega

/-- **`hheight` face of the phase-routed reset surface.** The single-ledger consolidation of the two
reset-surface height faces behind the same `if Piece.S ∈ T ∨ Piece.Z ∈ T` selector that
`reservoirCarrier_resetSurface_mem` dispatches on: whichever reset surface the drained bag presents
(shared valley if a staircase is owed, flat shelf otherwise), every column profile stays within the
field under the uniform slack `base + 1 ≤ rows`. This is the literal `hheight` obligation evaluated
at the bag boundary, ready to plug into any per-bag carrier whose reset board is this selector. -/
theorem colHeight_resetSurface_le {T : Bag} {base : ℕ}
    (hbase : base + 1 ≤ GameConfig.standard.rows) (j : ℕ) :
    Board.colHeight (Board.skyline GameConfig.standard
        (if Piece.S ∈ T ∨ Piece.Z ∈ T then reservoirSZSurface base
          else reservoirFlatSurface base)) j ≤ GameConfig.standard.rows := by
  by_cases h : Piece.S ∈ T ∨ Piece.Z ∈ T
  · rw [if_pos h]
    exact colHeight_reservoirSZSurface_le hbase j
  · rw [if_neg h]
    exact colHeight_reservoirFlatSurface_le (by omega) j

/-- **The double-valley reset surface.** The two-staircase companion of `reservoirSZSurface`: the
reserved empty well sits at column `0`, then TWO disjoint width-four valleys are carved into the
flat band, the first at columns `1, 2, 3, 4` and the second at columns `5, 6, 7, 8`, each with the
profile `(base + 1, base, base, base + 1)`; column `9` rests on the flat floor `base`. Two valleys
seat BOTH staircases of a bag at once, so the killer order `S` then `Z` (before the once-per-bag
drain) lands each staircase in its own fresh valley with no mid-bag valley regeneration. The two
valleys abut at the lip boundary `4 | 5` (each keeps its own lip column), so they occupy the eight
columns `1 .. 8`; with the well at column `0` the budget is `1 + 8 = 9 ≤ 10` working columns. -/
def reservoirDoubleSZSurface (base : ℕ) : ℕ → ℕ := fun j =>
  if j = 0 then 0
  else if j = 1 ∨ j = 4 ∨ j = 5 ∨ j = 8 then base + 1
  else base

/-- **Height cap of the double-valley reset surface.** Every column of the two-valley surface lives
in `[base, base + 1]` (the valley lips are the only `base + 1` columns and the well is `0`), so the
`maxColHeight` over the skyline is at most `base + 1`, exactly as for the single-valley
`reservoirSZSurface`. Adding a second valley costs no extra height. -/
theorem maxColHeight_reservoirDoubleSZSurface (base : ℕ) :
    Board.maxColHeight GameConfig.standard
      (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base)) ≤ base + 1 := by
  apply Board.maxColHeight_skyline_le_of_forall
  intro j _
  simp only [reservoirDoubleSZSurface]
  split_ifs <;> omega

/-- **`hheight` face of the double-valley reset surface.** Every column profile of
`Board.skyline (reservoirDoubleSZSurface base)` is at most `rows` under the same uniform slack
`base + 1 ≤ rows` as the single-valley surface. This is the bag-boundary height obligation when the
drained bag resets to the two-valley surface (the carrier shape for the two-staircase sub-problem,
where the adversary may owe both `S` and `Z` before the drain). -/
theorem colHeight_reservoirDoubleSZSurface_le {base : ℕ}
    (hbase : base + 1 ≤ GameConfig.standard.rows) (j : ℕ) :
    Board.colHeight (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base)) j
      ≤ GameConfig.standard.rows := by
  apply Board.colHeight_skyline_le
  intro k _
  simp only [reservoirDoubleSZSurface]
  split_ifs <;> omega

/-- **Reserved well of the double-valley surface is empty.** The profile value at column `0` is
`0`, the literal `hw0 : h 0 = 0` frame hypothesis every fill-step and band smart constructor
consumes. The double-valley surface keeps the once-per-bag drain column clear, exactly like the
single-valley `reservoirSZSurface`. -/
theorem reservoirDoubleSZSurface_well (base : ℕ) : reservoirDoubleSZSurface base 0 = 0 := by
  simp [reservoirDoubleSZSurface]

/-- **The double-valley surface is a spread-2 band off the well.** Every working column
(`j ≠ 0`) of `reservoirDoubleSZSurface base` lies in `[base, base + 2]` — in fact in
`[base, base + 1]`, the valley lips being the only `base + 1` columns — so it satisfies the literal
`hband` frame hypothesis the fill-step lemmas (`reservoirCarrier_valley_SZ_fill_step`,
`reservoirCarrier_widePocket_flat_fill_step`) demand. Paired with `reservoirDoubleSZSurface_well`
this packages the two frame premises (`hw0`, `hband`) of the absorption machinery for the
two-staircase surface, so a downstream landing lemma can seat `S` in the first valley and `Z` in the
second without re-deriving the band frame. -/
theorem reservoirDoubleSZSurface_band (base : ℕ) :
    ∀ j < GameConfig.standard.cols, j ≠ 0 →
      base ≤ reservoirDoubleSZSurface base j ∧ reservoirDoubleSZSurface base j ≤ base + 2 := by
  intro j _ hj0
  simp only [reservoirDoubleSZSurface]
  split_ifs <;> omega

/-- **The double-valley reset surface is a FLOOR-PINNED spread-2 band.** Packages the entry surface
of the two-staircase sub-cycle into the same `IsSpreadBoundedRWSkylineAt standard 2 base` vocabulary
as its post-SZ exit (`reservoirDoubleSZSurface_afterSZ_spreadBandAt`), composing the two already
proven frame faces: `reservoirDoubleSZSurface_well` (column `0` drained) supplies the reserved well,
and `reservoirDoubleSZSurface_band` (every working column in `[base, base + 2]`) supplies the band.
With both ends of the S/Z sub-cycle now recorded at the SAME floor `base` in the floor-tracked
ledger, the two disjoint staircases are accounted as a closed spread-2 excursion: enter at floor
`base`, seat `S` and `Z`, exit still floor-pinned at `base` — the once-per-bag I-drain then carries
that floor across to the next bag. -/
theorem reservoirDoubleSZSurface_spreadBandAt (base : ℕ)
    (hbase : base + 2 ≤ GameConfig.standard.rows) :
    Board.IsSpreadBoundedRWSkylineAt GameConfig.standard 2 base
      (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base)) :=
  Board.isSpreadBoundedRWSkylineAt_skyline (w := 0) (by decide)
    (reservoirDoubleSZSurface_well base) (reservoirDoubleSZSurface_band base) hbase

/-- **A flat O seats on the lip-shelf without touching either valley.** The double-valley
surface keeps its columns `4` and `5` both at `base + 1`, an adjacent level width-two shelf — a
landing pad for a flat `O`. Placing `{O, rot 0, col 4}` writes `+2` into columns `4, 5` (lifting
them to `base + 3`) and leaves every other column untouched, so both valley floors survive: the
valley1 cells `2, 3` and the valley2 cells `6, 7` all stay at exactly `base`. This is the
geometric escape for the hardest interleave, a flat piece arriving before both owed staircases
are placed: rather than consuming a valley the flat parks on the lip-shelf, and the two pristine
notches stay available for the still owed `S` and `Z`. The well at column `0` keeps the move
clear-free, so the heights add without any row filling. -/
theorem reservoirDoubleSZSurface_O_lipShelf_preserves_valleys (base : ℕ) :
    Board.colHeight (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.O, rot := 0, col := 4 }) 2 = base ∧
    Board.colHeight (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.O, rot := 0, col := 4 }) 3 = base ∧
    Board.colHeight (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.O, rot := 0, col := 4 }) 6 = base ∧
    Board.colHeight (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.O, rot := 0, col := 4 }) 7 = base := by
  rw [Board.applyStep_O_skyline_noclear (c := 4) (w := 0) (by decide) (by decide)
      (by simp [reservoirDoubleSZSurface]) (by decide) (by decide) (by decide)
      (reservoirDoubleSZSurface_well base)]
  refine ⟨?_, ?_, ?_, ?_⟩ <;>
    rw [Board.colHeight_skyline (by decide)] <;>
    simp [Function.update_apply, reservoirDoubleSZSurface]

/-- **The lip-shelf O leaves a spread-three reserved-well band — re-entry into the carrier.**
After the flat `O` parks on the double-valley surface's adjacent lip-shelf (columns `4, 5`, lifting
them to `base + 3`), the board is still a reserved-well skyline at floor `base`: the well at column
`0` stays empty, and every off-well column lives in `[base, base + 3]` (valley floors at `base`,
the outer lips at `base + 1`, the two filled shelf columns at `base + 3`). The spread widens from
two to three — the one unit of slack the lip-shelf fill spends — so the post-`O` board re-enters
`IsSpreadBoundedRWSkylineAt` at spread `3`, ready to feed the reservoir ledger with one extra unit
of height booked against the bag budget. This is the bridge that turns the geometric
valley-preservation fact into reservoir vocabulary the drain and ledger lemmas already speak. -/
theorem reservoirDoubleSZSurface_O_lipShelf_spreadBandAt (base : ℕ)
    (hslack : base + 3 ≤ GameConfig.standard.rows) :
    Board.IsSpreadBoundedRWSkylineAt GameConfig.standard 3 base
      (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.O, rot := 0, col := 4 }) := by
  rw [Board.applyStep_O_skyline_noclear (c := 4) (w := 0) (by decide) (by decide)
      (by simp [reservoirDoubleSZSurface]) (by decide) (by decide) (by decide)
      (reservoirDoubleSZSurface_well base)]
  refine Board.isSpreadBoundedRWSkylineAt_skyline (w := 0) (floor := base)
    (by decide) ?_ ?_ hslack
  · simp [Function.update_apply, reservoirDoubleSZSurface]
  · intro j hj hj0
    simp only [Function.update_apply]
    split_ifs with h5 h4
    · have h4v : reservoirDoubleSZSurface base 4 = base + 1 := by simp [reservoirDoubleSZSurface]
      omega
    · have h4v : reservoirDoubleSZSurface base 4 = base + 1 := by simp [reservoirDoubleSZSurface]
      omega
    · obtain ⟨hlo, hhi⟩ := reservoirDoubleSZSurface_band base j hj hj0
      omega

/-- **First staircase lands, second valley survives — the two-staircase payoff.** Placing `S` in
the FIRST valley of the double-valley surface (the valley1 S-landing `{S, rot 0, col 2}`, which
fills columns `2, 3, 4` at the right lip) leaves the SECOND valley at columns `5, 6, 7, 8` in its
original notch profile `(base + 1, base, base, base + 1)`. The S move dodges the well (column `0`)
and every column of valley2 (`5 .. 8`), so the valley-preservation primitive
`colHeight_applyStep_skyline_valley4_of_avoid` holds all four heights at their pre-move values. This
is the exact reason two DISJOINT valleys defeat the killer `S`-then-`Z` order: after `S` consumes
valley1 to a tower, `Z` still finds a pristine valley2 to seat into, with no mid-bag valley
regeneration required. The mirror (a first `Z` in valley1 preserving valley2, or either staircase in
valley2 preserving valley1) follows by the same avoidance. -/
theorem reservoirDoubleSZSurface_S_valley1_preserves_valley2 (base : ℕ) :
    Board.colHeight (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.S, rot := 0, col := 2 }) 5 = base + 1 ∧
    Board.colHeight (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.S, rot := 0, col := 2 }) 6 = base ∧
    Board.colHeight (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.S, rot := 0, col := 2 }) 7 = base ∧
    Board.colHeight (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.S, rot := 0, col := 2 }) 8 = base + 1 :=
  Board.colHeight_applyStep_skyline_valley4_of_avoid (w := 0) (vc := 5) (base := base)
    (by decide) (by decide) (reservoirDoubleSZSurface_well base)
    (by simp [reservoirDoubleSZSurface]) (by simp [reservoirDoubleSZSurface])
    (by simp [reservoirDoubleSZSurface]) (by simp [reservoirDoubleSZSurface])
    (by decide) (by decide) (by decide) (by decide) (by decide)

/-- **Reserved well survives the first staircase landing.** The frame companion of
`reservoirDoubleSZSurface_S_valley1_preserves_valley2`: the valley1 `S` move `{S, rot 0, col 2}`
dodges column `0`, so the reserved well stays empty (`colHeight … 0 = 0`) on the post-move board.
Paired with the valley2-survival payoff this certifies that the board after the first staircase
still carries the two structural features a follow-on `Z` needs — an empty well and a pristine
valley2 — so the second staircase can seat into valley2 with the same frame the landing lemmas
demand, and the once-per-bag `I` still has its drain column. -/
theorem reservoirDoubleSZSurface_S_valley1_preserves_well (base : ℕ) :
    Board.colHeight (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.S, rot := 0, col := 2 }) 0 = 0 := by
  rw [Board.colHeight_applyStep_skyline_eq_of_avoid_well (w := 0) (m := 0)
      (by decide) (by decide) (reservoirDoubleSZSurface_well base) (by decide) (by decide),
    reservoirDoubleSZSurface_well]

/-- **First staircase `Z` lands, valley1 survives — the order-mirror of the two-staircase payoff.**
The every-order companion of `reservoirDoubleSZSurface_S_valley1_preserves_valley2`: when the
adversary opens the bag with `Z` instead of `S`, seating it in the SECOND valley
(`{Z, rot 0, col 5}`, the mirror notch) leaves the FIRST valley at columns `1, 2, 3, 4` in its
original notch profile `(base + 1, base, base, base + 1)`. The `Z` move dodges the well (column `0`)
and every column of valley1 (`1 .. 4`), so the valley-preservation primitive
`colHeight_applyStep_skyline_valley4_of_avoid` holds all four heights at their pre-move values. This
is the reason two DISJOINT valleys defeat the reversed `Z`-then-`S` order just as they defeat
`S`-then-`Z`: after `Z` consumes valley2, the still-owed `S` finds a pristine valley1 — lips
intact at `base + 1`, floor at `base` — to seat into, with no mid-bag valley regeneration required.
Together with the proven `S`-first lemma this establishes that EITHER staircase may arrive first
into EITHER valley while preserving the other, the order-independence the adversarial bag demands. -/
theorem reservoirDoubleSZSurface_Z_valley2_preserves_valley1 (base : ℕ) :
    Board.colHeight (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.Z, rot := 0, col := 5 }) 1 = base + 1 ∧
    Board.colHeight (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.Z, rot := 0, col := 5 }) 2 = base ∧
    Board.colHeight (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.Z, rot := 0, col := 5 }) 3 = base ∧
    Board.colHeight (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.Z, rot := 0, col := 5 }) 4 = base + 1 :=
  Board.colHeight_applyStep_skyline_valley4_of_avoid (w := 0) (vc := 1) (base := base)
    (by decide) (by decide) (reservoirDoubleSZSurface_well base)
    (by simp [reservoirDoubleSZSurface]) (by simp [reservoirDoubleSZSurface])
    (by simp [reservoirDoubleSZSurface]) (by simp [reservoirDoubleSZSurface])
    (by decide) (by decide) (by decide) (by decide) (by decide)

/-- **Reserved well survives the first staircase `Z` landing — the order-mirror frame companion.**
The `Z`-first analogue of `reservoirDoubleSZSurface_S_valley1_preserves_well`: the valley2 `Z` move
`{Z, rot 0, col 5}` dodges column `0`, so the reserved well stays empty (`colHeight … 0 = 0`) on the
post-move board. Paired with `reservoirDoubleSZSurface_Z_valley2_preserves_valley1` this certifies
that opening the bag with `Z` leaves BOTH structural features a follow-on `S` needs — an empty well
and a pristine valley1 — so the second staircase can seat into valley1 with the same frame the
landing lemmas demand, and the once-per-bag `I` still has its drain column. -/
theorem reservoirDoubleSZSurface_Z_valley2_preserves_well (base : ℕ) :
    Board.colHeight (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.Z, rot := 0, col := 5 }) 0 = 0 := by
  rw [Board.colHeight_applyStep_skyline_eq_of_avoid_well (w := 0) (m := 0)
      (by decide) (by decide) (reservoirDoubleSZSurface_well base) (by decide) (by decide),
    reservoirDoubleSZSurface_well]

/-- **The post-S board stays a spread-2 band off the well.** After the valley1 `S` move
`{S, rot 0, col 2}` (a valid S-notch placement on the right lip of valley1 — `h 2 = h 3 = base`,
`h 4 = base + 1` — rewritten to a skyline by `applyStep_S_skyline_noclear`), every working column
still lies in `[base, base + 2]`: the S fills valley1 to `(base + 1, base + 1, base + 2, base + 2)`
at columns `1, 2, 3, 4`, valley2 and the flat tail are untouched, and nothing exceeds `base + 2`. So
the board after the first staircase still satisfies the `hband` frame hypothesis the second
staircase's landing lemma demands — completing, with the preserved well (empty) and the preserved
valley2 (intact) lemmas, the full frame for seating `Z` into valley2 of the post-S board. -/
theorem reservoirDoubleSZSurface_afterS_band (base : ℕ) :
    ∀ j < GameConfig.standard.cols, j ≠ 0 →
      base ≤ Board.colHeight (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.S, rot := 0, col := 2 }) j ∧
      Board.colHeight (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.S, rot := 0, col := 2 }) j ≤ base + 2 := by
  intro j hj hj0
  rw [Board.applyStep_S_skyline_noclear (c := 2) (w := 0) (by decide) (by decide) (by decide)
      (by simp [reservoirDoubleSZSurface]) (by simp [reservoirDoubleSZSurface])
      (by decide) (by decide) (by decide) (by decide) (reservoirDoubleSZSurface_well base),
    Board.colHeight_skyline hj]
  rcases eq_or_ne j 2 with rfl | h2
  · simp [reservoirDoubleSZSurface]
  rcases eq_or_ne j 3 with rfl | h3
  · simp [reservoirDoubleSZSurface]
  rcases eq_or_ne j 4 with rfl | h4
  · simp [reservoirDoubleSZSurface]
  simp only [Function.update_apply, reservoirDoubleSZSurface]
  split_ifs <;> omega

/-- **The single-`S` landing is a reserved-well spread-2 band.** The spread-band packaging of the
first-staircase board, the single-`S` companion of `reservoirDoubleSZSurface_afterSZ_spreadBandAt`
(both staircases). It bundles the two already proven colHeight faces of the valley1 `S` move
(`{S, rot 0, col 2}`) into the reusable carrier vocabulary:
`reservoirDoubleSZSurface_S_valley1_preserves_well` keeps column `0` drained, and
`reservoirDoubleSZSurface_afterS_band` holds every working column in `[base, base + 2]`, so the
post-`S` board is an `IsSpreadBoundedRWSkylineAt standard 2 base` witness. This is the carrier face
the adversary's `S`-first delivery hands back: whichever moment the `S` arrives, the surface it
leaves is a floor-pinned spread-2 band at the unchanged floor `base`, ready for the generic carrier
machinery (the still-pristine valley2 keeps the owed `Z` seatable, recorded separately by
`reservoirDoubleSZSurface_S_valley1_preserves_valley2`). -/
theorem reservoirDoubleSZSurface_afterS_spreadBandAt (base : ℕ)
    (hbase : base + 2 ≤ GameConfig.standard.rows) :
    Board.IsSpreadBoundedRWSkylineAt GameConfig.standard 2 base
      (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.S, rot := 0, col := 2 }) := by
  rw [Board.applyStep_S_skyline_noclear (c := 2) (w := 0) (by decide) (by decide) (by decide)
      (by simp [reservoirDoubleSZSurface]) (by simp [reservoirDoubleSZSurface])
      (by decide) (by decide) (by decide) (by decide) (reservoirDoubleSZSurface_well base)]
  apply Board.isSpreadBoundedRWSkylineAt_skyline (w := 0) (floor := base)
  · decide
  · simp [reservoirDoubleSZSurface]
  · intro j hj hj0
    rcases eq_or_ne j 2 with rfl | h2
    · simp [reservoirDoubleSZSurface]
    rcases eq_or_ne j 3 with rfl | h3
    · simp [reservoirDoubleSZSurface]
    rcases eq_or_ne j 4 with rfl | h4
    · simp [reservoirDoubleSZSurface]
    simp only [Function.update_apply, reservoirDoubleSZSurface]
    split_ifs <;> omega
  · exact hbase

/-- **The single-`Z` landing is a reserved-well spread-2 band.** The mirror of
`reservoirDoubleSZSurface_afterS_spreadBandAt`: when the adversary opens the bag with `Z` instead
of `S`, seating it in valley2 (`{Z, rot 0, col 5}`, the mirror notch where the surface offers
`h 5 = h 6 + 1` and `h 6 = h 7`) leaves a reserved-well spread-2 band at the unchanged floor `base`.
The `Z` writes `base + 2` into columns `5, 6` and `base + 1` into column `7`, dodges the well at
column `0`, and touches nothing in valley1 — so every working column stays in `[base, base + 2]` and
column `0` stays drained, giving an `IsSpreadBoundedRWSkylineAt standard 2 base` witness. This is the
`Z`-first carrier face symmetric to the `S`-first one, and (with valley1 still pristine for the owed
`S`) the entry the `Z`-first exit edge re-packages into the generic spread carrier. -/
theorem reservoirDoubleSZSurface_afterZ_spreadBandAt (base : ℕ)
    (hbase : base + 2 ≤ GameConfig.standard.rows) :
    Board.IsSpreadBoundedRWSkylineAt GameConfig.standard 2 base
      (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.Z, rot := 0, col := 5 }) := by
  rw [Board.applyStep_Z_skyline_noclear (c := 5) (w := 0) (by decide) (by decide) (by decide)
      (by simp [reservoirDoubleSZSurface]) (by simp [reservoirDoubleSZSurface])
      (by decide) (by decide) (by decide) (by decide) (reservoirDoubleSZSurface_well base)]
  apply Board.isSpreadBoundedRWSkylineAt_skyline (w := 0) (floor := base)
  · decide
  · simp [reservoirDoubleSZSurface]
  · intro j hj hj0
    rcases eq_or_ne j 5 with rfl | h5
    · simp [reservoirDoubleSZSurface]
    rcases eq_or_ne j 6 with rfl | h6
    · simp [reservoirDoubleSZSurface]
    rcases eq_or_ne j 7 with rfl | h7
    · simp [reservoirDoubleSZSurface]
    simp only [Function.update_apply, reservoirDoubleSZSurface]
    split_ifs <;> omega
  · exact hbase

/-- **Reserved well survives BOTH staircases.** The two-staircase analogue of
`reservoirDoubleSZSurface_S_valley1_preserves_well`: seating `S` in valley1 (`{S, rot 0, col 2}`)
and then `Z` in valley2 (`{Z, rot 0, col 5}`, the mirror notch on the left lip of valley2 where
`h 5 = h 6 + 1` and `h 6 = h 7`) leaves the reserved well at column `0` empty. The post-`S` board is
a skyline `g` (via `applyStep_S_skyline_noclear`), and the valley2 `Z` move dodges column `0`, so
`colHeight_applyStep_skyline_eq_of_avoid_well` pins the well height to `g 0 = 0`. With both
staircases of the bag seated into their own disjoint valley and the well still drained, the
once-per-bag `I` retains its reset column — the structural precondition for the bag-level drain. -/
theorem reservoirDoubleSZSurface_afterSZ_preserves_well (base : ℕ) :
    Board.colHeight (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.S, rot := 0, col := 2 })
        { piece := Piece.Z, rot := 0, col := 5 }) 0 = 0 := by
  rw [Board.applyStep_S_skyline_noclear (c := 2) (w := 0) (by decide) (by decide) (by decide)
      (by simp [reservoirDoubleSZSurface]) (by simp [reservoirDoubleSZSurface])
      (by decide) (by decide) (by decide) (by decide) (reservoirDoubleSZSurface_well base),
    Board.colHeight_applyStep_skyline_eq_of_avoid_well (w := 0) (m := 0)
      (by decide) (by decide) (by simp [reservoirDoubleSZSurface]) (by decide) (by decide)]
  simp [reservoirDoubleSZSurface]

/-- **Both staircases seated, board still a spread-2 band.** The height payoff of the two disjoint
valleys: after `S` lands in valley1 (`{S, rot 0, col 2}`) and `Z` lands in valley2
(`{Z, rot 0, col 5}`), every working column (`j ≠ 0`) of the resulting board still lies in
`[base, base + 2]`. The post-`S` board is a skyline `g` (via `applyStep_S_skyline_noclear`); on it
valley2 is intact (`g 5 = g 6 + 1`, `g 6 = g 7`), so the mirror `Z`-notch seats by
`applyStep_Z_skyline_noclear`, raising columns `5, 6, 7` to `(base + 2, base + 2, base + 1)` and
touching nothing else. Both staircases of the bag are now absorbed with the surface never exceeding
`base + 2` and no line cleared — so the adversarial `S`-then-`Z` order (both before the regulator
`I`) is height-safe, and the once-per-bag `I` can drain this band back to a reset surface. -/
theorem reservoirDoubleSZSurface_afterSZ_band (base : ℕ) :
    ∀ j < GameConfig.standard.cols, j ≠ 0 →
      base ≤ Board.colHeight (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard
            (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
            { piece := Piece.S, rot := 0, col := 2 })
          { piece := Piece.Z, rot := 0, col := 5 }) j ∧
      Board.colHeight (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard
            (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
            { piece := Piece.S, rot := 0, col := 2 })
          { piece := Piece.Z, rot := 0, col := 5 }) j ≤ base + 2 := by
  intro j hj hj0
  rw [Board.applyStep_S_skyline_noclear (c := 2) (w := 0) (by decide) (by decide) (by decide)
      (by simp [reservoirDoubleSZSurface]) (by simp [reservoirDoubleSZSurface])
      (by decide) (by decide) (by decide) (by decide) (reservoirDoubleSZSurface_well base),
    Board.applyStep_Z_skyline_noclear (c := 5) (w := 0) (by decide) (by decide) (by decide)
      (by simp [reservoirDoubleSZSurface]) (by simp [reservoirDoubleSZSurface])
      (by decide) (by decide) (by decide) (by decide) (by simp [reservoirDoubleSZSurface]),
    Board.colHeight_skyline hj]
  rcases eq_or_ne j 2 with rfl | h2
  · simp [reservoirDoubleSZSurface]
  rcases eq_or_ne j 3 with rfl | h3
  · simp [reservoirDoubleSZSurface]
  rcases eq_or_ne j 4 with rfl | h4
  · simp [reservoirDoubleSZSurface]
  rcases eq_or_ne j 5 with rfl | h5
  · simp [reservoirDoubleSZSurface]
  rcases eq_or_ne j 6 with rfl | h6
  · simp [reservoirDoubleSZSurface]
  rcases eq_or_ne j 7 with rfl | h7
  · simp [reservoirDoubleSZSurface]
  simp only [Function.update_apply, reservoirDoubleSZSurface]
  split_ifs <;> omega

/-- **The two staircases regenerate a width-4 flat shelf at `base + 2`.** The phase-transition
payoff: after `S` seats in valley1 (`{S, rot 0, col 2}`, lifting columns `2, 3, 4` to
`base + 1, base + 2, base + 2`) and `Z` seats in valley2 (`{Z, rot 0, col 5}`, lifting columns
`5, 6, 7` to `base + 2, base + 2, base + 1`), columns `3, 4, 5, 6` all sit at exactly `base + 2`,
a level width-4 pocket. This is the structural bridge from the staircase phase to the flat phase
WITHIN one bag: once both owed staircases are absorbed, the surface itself exposes the flat landing
strip the remaining flats (`O, T, L, J`) drop onto, so the double-valley surface need not also carry
a separate flat pocket (which the ten-column budget forbids alongside two valleys). -/
theorem reservoirDoubleSZSurface_afterSZ_flatShelf (base : ℕ) :
    Board.colHeight (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.S, rot := 0, col := 2 })
        { piece := Piece.Z, rot := 0, col := 5 }) 3 = base + 2 ∧
    Board.colHeight (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.S, rot := 0, col := 2 })
        { piece := Piece.Z, rot := 0, col := 5 }) 4 = base + 2 ∧
    Board.colHeight (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.S, rot := 0, col := 2 })
        { piece := Piece.Z, rot := 0, col := 5 }) 5 = base + 2 ∧
    Board.colHeight (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.S, rot := 0, col := 2 })
        { piece := Piece.Z, rot := 0, col := 5 }) 6 = base + 2 := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;>
  · rw [Board.applyStep_S_skyline_noclear (c := 2) (w := 0) (by decide) (by decide) (by decide)
        (by simp [reservoirDoubleSZSurface]) (by simp [reservoirDoubleSZSurface])
        (by decide) (by decide) (by decide) (by decide) (reservoirDoubleSZSurface_well base),
      Board.applyStep_Z_skyline_noclear (c := 5) (w := 0) (by decide) (by decide) (by decide)
        (by simp [reservoirDoubleSZSurface]) (by simp [reservoirDoubleSZSurface])
        (by decide) (by decide) (by decide) (by decide) (by simp [reservoirDoubleSZSurface]),
      Board.colHeight_skyline (by decide)]
    simp [reservoirDoubleSZSurface]

/-- **Post-SZ board is a reserved-well spread-2 band.** Packages the height payoff of the two
disjoint valleys into the reusable carrier vocabulary: after `S` seats in valley1 and `Z` seats in
valley2, the board is an `IsSpreadBoundedRWSkyline` witness at spread `2` with the reserved empty
well at column `0`. Both noclear lemmas expose the explicit post-SZ skyline `g`; the well stays
drained (`g 0 = 0`) and every working column lies in `[base, base + 2]`, so the generic spread-band
drain and reset machinery now attaches to the adversarial S-then-Z order. -/
theorem reservoirDoubleSZSurface_afterSZ_spreadBand (base : ℕ)
    (hbase : base + 2 ≤ GameConfig.standard.rows) :
    Board.IsSpreadBoundedRWSkyline GameConfig.standard 2
      (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.S, rot := 0, col := 2 })
        { piece := Piece.Z, rot := 0, col := 5 }) := by
  rw [Board.applyStep_S_skyline_noclear (c := 2) (w := 0) (by decide) (by decide) (by decide)
      (by simp [reservoirDoubleSZSurface]) (by simp [reservoirDoubleSZSurface])
      (by decide) (by decide) (by decide) (by decide) (reservoirDoubleSZSurface_well base),
    Board.applyStep_Z_skyline_noclear (c := 5) (w := 0) (by decide) (by decide) (by decide)
      (by simp [reservoirDoubleSZSurface]) (by simp [reservoirDoubleSZSurface])
      (by decide) (by decide) (by decide) (by decide) (by simp [reservoirDoubleSZSurface])]
  apply Board.isSpreadBoundedRWSkyline_skyline (w := 0) (floor := base)
  · decide
  · simp [reservoirDoubleSZSurface]
  · intro j hj hj0
    rcases eq_or_ne j 2 with rfl | h2
    · simp [reservoirDoubleSZSurface]
    rcases eq_or_ne j 3 with rfl | h3
    · simp [reservoirDoubleSZSurface]
    rcases eq_or_ne j 4 with rfl | h4
    · simp [reservoirDoubleSZSurface]
    rcases eq_or_ne j 5 with rfl | h5
    · simp [reservoirDoubleSZSurface]
    rcases eq_or_ne j 6 with rfl | h6
    · simp [reservoirDoubleSZSurface]
    rcases eq_or_ne j 7 with rfl | h7
    · simp [reservoirDoubleSZSurface]
    simp only [Function.update_apply, reservoirDoubleSZSurface]
    split_ifs <;> omega
  · exact hbase

/-- **Post-SZ board is a FLOOR-PINNED spread-2 band.** The floor-exposed refinement of
`reservoirDoubleSZSurface_afterSZ_spreadBand`: the same post-SZ surface, but recorded as an
`IsSpreadBoundedRWSkylineAt` witness with the floor `base` tracked as an explicit parameter rather
than hidden existentially. This is the exact output vocabulary every floor-tracked reservoir fill
arc lands in (`isSpreadBoundedRWSkylineAt_*_pocket_of_isLevelPocketBandAt`), so it is the bridge
that lets the double-valley two-staircase payoff feed back into the reservoir ledger, which accounts
for the floor across the once-per-bag I-drain. Both noclear lemmas expose the explicit post-SZ
skyline; the well stays drained and every working column lies in `[base, base + 2]`. -/
theorem reservoirDoubleSZSurface_afterSZ_spreadBandAt (base : ℕ)
    (hbase : base + 2 ≤ GameConfig.standard.rows) :
    Board.IsSpreadBoundedRWSkylineAt GameConfig.standard 2 base
      (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.S, rot := 0, col := 2 })
        { piece := Piece.Z, rot := 0, col := 5 }) := by
  rw [Board.applyStep_S_skyline_noclear (c := 2) (w := 0) (by decide) (by decide) (by decide)
      (by simp [reservoirDoubleSZSurface]) (by simp [reservoirDoubleSZSurface])
      (by decide) (by decide) (by decide) (by decide) (reservoirDoubleSZSurface_well base),
    Board.applyStep_Z_skyline_noclear (c := 5) (w := 0) (by decide) (by decide) (by decide)
      (by simp [reservoirDoubleSZSurface]) (by simp [reservoirDoubleSZSurface])
      (by decide) (by decide) (by decide) (by decide) (by simp [reservoirDoubleSZSurface])]
  apply Board.isSpreadBoundedRWSkylineAt_skyline (w := 0) (floor := base)
  · decide
  · simp [reservoirDoubleSZSurface]
  · intro j hj hj0
    rcases eq_or_ne j 2 with rfl | h2
    · simp [reservoirDoubleSZSurface]
    rcases eq_or_ne j 3 with rfl | h3
    · simp [reservoirDoubleSZSurface]
    rcases eq_or_ne j 4 with rfl | h4
    · simp [reservoirDoubleSZSurface]
    rcases eq_or_ne j 5 with rfl | h5
    · simp [reservoirDoubleSZSurface]
    rcases eq_or_ne j 6 with rfl | h6
    · simp [reservoirDoubleSZSurface]
    rcases eq_or_ne j 7 with rfl | h7
    · simp [reservoirDoubleSZSurface]
    simp only [Function.update_apply, reservoirDoubleSZSurface]
    split_ifs <;> omega
  · exact hbase

/-- **The post-SZ board has not topped out.** The survival payoff of the double-valley height
safety: since the board after `S` seats in valley1 and `Z` seats in valley2 is a reserved-well
spread-2 band (`reservoirDoubleSZSurface_afterSZ_spreadBand`), it keeps every cell under the
ceiling, so `Board.not_isLost_of_isSpreadBoundedRWSkyline` certifies no row spills out. This is the
"never tops out" verdict for the adversarial S-then-Z order, the loss-avoidance face the atlas
existence claim ultimately consumes. -/
theorem reservoirDoubleSZSurface_afterSZ_not_isLost (base : ℕ)
    (hbase : base + 2 ≤ GameConfig.standard.rows) :
    ¬ Board.isLost GameConfig.standard
      (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.S, rot := 0, col := 2 })
        { piece := Piece.Z, rot := 0, col := 5 }) :=
  Board.not_isLost_of_isSpreadBoundedRWSkyline
    (reservoirDoubleSZSurface_afterSZ_spreadBand base hbase)

/-- **Peak height after both staircases is at most `base + 2`.** The scalar height-ledger face of
the double-valley payoff: taking the supremum of the post-SZ column heights over the well bound
(`reservoirDoubleSZSurface_afterSZ_preserves_well`, column `0` drained to `0`) and the band bound
(`reservoirDoubleSZSurface_afterSZ_band`, every working column at most `base + 2`) caps the whole
surface at `base + 2`. This is the per-bag peak the height limit is checked against for the
adversarial S-then-Z order: two staircases lift the floor by exactly two, no more. -/
theorem reservoirDoubleSZSurface_afterSZ_maxColHeight_le (base : ℕ) :
    Board.maxColHeight GameConfig.standard
      (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.S, rot := 0, col := 2 })
        { piece := Piece.Z, rot := 0, col := 5 }) ≤ base + 2 := by
  unfold Board.maxColHeight
  apply Finset.sup_le
  intro j hj
  rw [Finset.mem_range] at hj
  rcases eq_or_ne j 0 with rfl | hj0
  · rw [reservoirDoubleSZSurface_afterSZ_preserves_well]; omega
  · exact (reservoirDoubleSZSurface_afterSZ_band base j hj hj0).2

/-- **The S-then-Z two-step is a legal, survivable transition.** Bundles the double-valley payoff
into one reusable certificate: from the reset surface `reservoirDoubleSZSurface base`, the strategy
may legally play `{S, rot 0, col 2}` then `{Z, rot 0, col 5}` (both placements valid by column fit),
and the resulting board is a reserved-well spread-2 band, has not topped out, and has peak height at
most `base + 2`. This is the transition atom for the adversarial order that draws both staircases
before the regulator I: two disjoint valleys host them with the floor lifting by exactly two. -/
theorem reservoirDoubleSZSurface_SZ_transition (base : ℕ)
    (hbase : base + 2 ≤ GameConfig.standard.rows) :
    ({ piece := Piece.S, rot := 0, col := 2 } : Placement).Valid GameConfig.standard ∧
    ({ piece := Piece.Z, rot := 0, col := 5 } : Placement).Valid GameConfig.standard ∧
    Board.IsSpreadBoundedRWSkyline GameConfig.standard 2
      (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.S, rot := 0, col := 2 })
        { piece := Piece.Z, rot := 0, col := 5 }) ∧
    ¬ Board.isLost GameConfig.standard
      (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.S, rot := 0, col := 2 })
        { piece := Piece.Z, rot := 0, col := 5 }) ∧
    Board.maxColHeight GameConfig.standard
      (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.S, rot := 0, col := 2 })
        { piece := Piece.Z, rot := 0, col := 5 }) ≤ base + 2 :=
  ⟨Board.valid_S (by decide), Board.valid_Z (by decide),
    reservoirDoubleSZSurface_afterSZ_spreadBand base hbase,
    reservoirDoubleSZSurface_afterSZ_not_isLost base hbase,
    reservoirDoubleSZSurface_afterSZ_maxColHeight_le base⟩

/-- **The two staircases commute on the double-valley surface.** Seating `S` in valley1
(`{S, rot 0, col 2}`, touching columns `2, 3, 4`) and `Z` in valley2 (`{Z, rot 0, col 5}`, touching
columns `5, 6, 7`) lands the same board in EITHER order: the two moves write to disjoint column sets
and neither clears a line, so the composed skyline updates commute (`Function.update_apply` on
disjoint indices). Concretely both orders rewrite (via `applyStep_S_skyline_noclear` and
`applyStep_Z_skyline_noclear`, whose valley premises survive the other staircase because the column
sets are disjoint) to one skyline of the doubly-updated height function. This neutralises the
adversary's choice of `S`-vs-`Z` order: any order-robust carrier that must survive both `S` then `Z`
and `Z` then `S` need only certify ONE of them, since this equality transports every face
(`afterSZ_spreadBand`, `afterSZ_not_isLost`, `afterSZ_maxColHeight_le`, and the two validities) onto
the swapped order for free. -/
theorem reservoirDoubleSZSurface_SZ_comm (base : ℕ) :
    Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.S, rot := 0, col := 2 })
        { piece := Piece.Z, rot := 0, col := 5 }
      = Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.Z, rot := 0, col := 5 })
        { piece := Piece.S, rot := 0, col := 2 } := by
  rw [Board.applyStep_S_skyline_noclear (c := 2) (w := 0) (by decide) (by decide) (by decide)
        (by simp [reservoirDoubleSZSurface]) (by simp [reservoirDoubleSZSurface])
        (by decide) (by decide) (by decide) (by decide) (reservoirDoubleSZSurface_well base),
      Board.applyStep_Z_skyline_noclear (c := 5) (w := 0) (by decide) (by decide) (by decide)
        (by simp [reservoirDoubleSZSurface]) (by simp [reservoirDoubleSZSurface])
        (by decide) (by decide) (by decide) (by decide) (by simp [reservoirDoubleSZSurface]),
      Board.applyStep_Z_skyline_noclear (c := 5) (w := 0) (by decide) (by decide) (by decide)
        (by simp [reservoirDoubleSZSurface]) (by simp [reservoirDoubleSZSurface])
        (by decide) (by decide) (by decide) (by decide) (reservoirDoubleSZSurface_well base),
      Board.applyStep_S_skyline_noclear (c := 2) (w := 0) (by decide) (by decide) (by decide)
        (by simp [reservoirDoubleSZSurface]) (by simp [reservoirDoubleSZSurface])
        (by decide) (by decide) (by decide) (by decide) (by simp [reservoirDoubleSZSurface])]
  congr 1
  funext j
  rcases eq_or_ne j 2 with rfl | h2
  · simp [reservoirDoubleSZSurface]
  rcases eq_or_ne j 3 with rfl | h3
  · simp [reservoirDoubleSZSurface]
  rcases eq_or_ne j 4 with rfl | h4
  · simp [reservoirDoubleSZSurface]
  rcases eq_or_ne j 5 with rfl | h5
  · simp [reservoirDoubleSZSurface]
  rcases eq_or_ne j 6 with rfl | h6
  · simp [reservoirDoubleSZSurface]
  rcases eq_or_ne j 7 with rfl | h7
  · simp [reservoirDoubleSZSurface]
  rw [Function.update_of_ne h7, Function.update_of_ne h6, Function.update_of_ne h5,
      Function.update_of_ne h4, Function.update_of_ne h3, Function.update_of_ne h2,
      Function.update_of_ne h4, Function.update_of_ne h3, Function.update_of_ne h2,
      Function.update_of_ne h7, Function.update_of_ne h6, Function.update_of_ne h5]

/-- **The Z-then-S two-step is equally legal and survivable.** The mirror of
`reservoirDoubleSZSurface_SZ_transition` for the opposite adversarial order: from the reset surface
`reservoirDoubleSZSurface base`, playing `{Z, rot 0, col 5}` then `{S, rot 0, col 2}` is valid and
lands in the SAME reserved-well spread-2 band, has not topped out, and peaks at height at most
`base + 2`. Proven for free by transporting every face of the S-then-Z certificate across the
commutation equality `reservoirDoubleSZSurface_SZ_comm`. Together the two transitions certify BOTH
orders the adversary can pick when it draws the bag's two staircases back to back, so a carrier need
only host one to survive either. -/
theorem reservoirDoubleSZSurface_ZS_transition (base : ℕ)
    (hbase : base + 2 ≤ GameConfig.standard.rows) :
    ({ piece := Piece.Z, rot := 0, col := 5 } : Placement).Valid GameConfig.standard ∧
    ({ piece := Piece.S, rot := 0, col := 2 } : Placement).Valid GameConfig.standard ∧
    Board.IsSpreadBoundedRWSkyline GameConfig.standard 2
      (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.Z, rot := 0, col := 5 })
        { piece := Piece.S, rot := 0, col := 2 }) ∧
    ¬ Board.isLost GameConfig.standard
      (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.Z, rot := 0, col := 5 })
        { piece := Piece.S, rot := 0, col := 2 }) ∧
    Board.maxColHeight GameConfig.standard
      (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.Z, rot := 0, col := 5 })
        { piece := Piece.S, rot := 0, col := 2 }) ≤ base + 2 := by
  rw [← reservoirDoubleSZSurface_SZ_comm base]
  obtain ⟨hS, hZ, hspread, hlost, hheight⟩ := reservoirDoubleSZSurface_SZ_transition base hbase
  exact ⟨hZ, hS, hspread, hlost, hheight⟩

/-- **The drain regenerates the double-valley reset surface, lowered by four.** The linchpin of the
period cycle. The two-valley surface has its reserved well at column `0` and every working column in
`[base, base + 1]`; once `4 ≤ base` every neighbour of the well is at least four high, so dropping
the vertical `I` into the well clears the bottom four (now-full) rows and gravity drops every other
column by exactly four (`Board.applyStep_vertI_well`). Crucially the *profile is preserved*: the
valleys, lips and pocket all sit at the top of the stack and ride down unchanged, so the post-drain
board is the very same `reservoirDoubleSZSurface` shape at floor `base - 4`. This is what lets the
once-per-bag `I` reset the bag-boundary shape to a strictly lower floor without disturbing the owed
S and Z valleys — the line clearing removes full rows from *beneath* the surface, never the notches
themselves. It is the multi-bag analogue of the flat-shelf `repack_raise_drain` cycle, but carrying
the staircase reservation through the reset, which the flat cycle could not. -/
theorem reservoirDoubleSZSurface_vertI_well_drain {base : ℕ} (hbase : 4 ≤ base) :
    Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.I, rot := 1, col := 0 }
      = Board.skyline GameConfig.standard (reservoirDoubleSZSurface (base - 4)) := by
  rw [Board.applyStep_vertI_well (cfg := GameConfig.standard)
    (h := reservoirDoubleSZSurface base) (w := 0)
    (by decide) (reservoirDoubleSZSurface_well base)
    (fun j _ hj0 => by simp only [reservoirDoubleSZSurface, if_neg hj0]; split <;> omega)]
  congr 1
  funext j
  simp only [reservoirDoubleSZSurface]
  by_cases hj0 : j = 0
  · simp [hj0]
  · simp only [if_neg hj0]
    split <;> omega

/-- **Survival face of the double-valley well drain.** Bundles the three facts a cycle step needs
about the once-per-bag vertical-I drain on the double-valley bag-boundary surface: the placement is
valid, it rewrites the surface to the same `reservoirDoubleSZSurface` profile lowered by `4`
(`reservoirDoubleSZSurface_vertI_well_drain`), and the lowered surface has not topped out. The
height bound `base + 1 ≤ rows` on the pre-drain surface carries to the post-drain surface for free
(natural subtraction only shrinks the floor), so `not_isLost_skyline` discharges survival from the
profile cap. This is the regenerator face: the drain returns a fresh double-valley shape at floor
`base - 4`, still owing the same `S` and `Z` valleys, ready to host the next bag. -/
theorem reservoirDoubleSZSurface_vertI_well_drain_safe {base : ℕ} (hbase : 4 ≤ base)
    (hrows : base + 1 ≤ GameConfig.standard.rows) :
    ({ piece := Piece.I, rot := 1, col := 0 } : Placement).Valid GameConfig.standard ∧
    Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.I, rot := 1, col := 0 }
      = Board.skyline GameConfig.standard (reservoirDoubleSZSurface (base - 4)) ∧
    ¬ Board.isLost GameConfig.standard
      (Board.skyline GameConfig.standard (reservoirDoubleSZSurface (base - 4))) :=
  ⟨Board.valid_vertI (by decide),
   reservoirDoubleSZSurface_vertI_well_drain hbase,
   Board.not_isLost_skyline (fun j _ => by
     simp only [reservoirDoubleSZSurface]; split_ifs <;> omega)⟩

/-- **The flat phase reservoir shape.** The bag-phase carrier's flat face as a self-contained
skyline predicate: a board that is a skyline `h` with a reserved empty well at column `0`, every
working column inside the spread-`2` band `[base, base + 2]`, and a width-eight flat run at some
columns `pc .. pc + 7` all pinned to the floor `base`. The width-eight run is the self-regenerating
landing strip every flat piece `O, I, T, L, J` absorbs on (a flat piece consumes four of the eight
and leaves a fresh width-four pocket). This is the shape the reservoir presents when the bag owes no
staircase; it forgets to a spread-`2` level pocket band (any four of the eight run columns are a
pocket), so it inherits the band height cap for free. -/
def IsFlatPhaseReservoirAt (base : ℕ) (b : Board) : Prop :=
  ∃ (h : ℕ → ℕ) (pc : ℕ),
    b = Board.skyline GameConfig.standard h ∧
    h 0 = 0 ∧
    (∀ j < GameConfig.standard.cols, j ≠ 0 → base ≤ h j ∧ h j ≤ base + 2) ∧
    base + 2 ≤ GameConfig.standard.rows ∧
    1 ≤ pc ∧ pc + 7 < GameConfig.standard.cols ∧
    h pc = base ∧ h (pc + 1) = base ∧ h (pc + 2) = base ∧ h (pc + 3) = base ∧
    h (pc + 4) = base ∧ h (pc + 5) = base ∧ h (pc + 6) = base ∧ h (pc + 7) = base

/-- **The S and Z phase reservoir shape.** The bag-phase carrier's staircase face as a
self-contained skyline predicate: a board that is a skyline `h` with a reserved empty well at column
`0`, every working column inside the spread-`2` band `[base, base + 2]`, a shared width-four valley
`(base + 1, base, base, base + 1)` at columns `vc .. vc + 3`, and a disjoint width-four flat pocket
at columns `pc .. pc + 3` (with `vc + 3 < pc`). The valley seats both staircases (`S` at the right
lip, `Z` at the left), the pocket carries the flats, and the well holds the once-per-bag drain,
totalling `well + valley + pocket = 1 + 4 + 4 = 9 ≤ 10` working columns. This is the shape the
reservoir presents while a staircase is still owed; it forgets to a spread-`2` level pocket band via
the flat pocket. -/
def IsSZPhaseReservoirAt (base : ℕ) (b : Board) : Prop :=
  ∃ (h : ℕ → ℕ) (vc pc : ℕ),
    b = Board.skyline GameConfig.standard h ∧
    h 0 = 0 ∧
    (∀ j < GameConfig.standard.cols, j ≠ 0 → base ≤ h j ∧ h j ≤ base + 2) ∧
    base + 2 ≤ GameConfig.standard.rows ∧
    1 ≤ vc ∧ vc + 3 < pc ∧ pc + 3 < GameConfig.standard.cols ∧
    h vc = base + 1 ∧ h (vc + 1) = base ∧ h (vc + 2) = base ∧ h (vc + 3) = base + 1 ∧
    h pc = base ∧ h (pc + 1) = base ∧ h (pc + 2) = base ∧ h (pc + 3) = base

/-- **The flat phase shape forgets to a spread-`2` level pocket band.** Reading the first four
columns of the width-eight run as the band's width-four pocket and column `0` as the reserved well
(disjoint since `pc ≥ 1`) repackages an `IsFlatPhaseReservoirAt base` board as an
`IsLevelPocketBandAt standard 2 base` board, transporting the band height cap onto the flat
phase. -/
theorem isLevelPocketBandAt_of_isFlatPhaseReservoirAt {base : ℕ} {b : Board}
    (hb : IsFlatPhaseReservoirAt base b) :
    Board.IsLevelPocketBandAt GameConfig.standard 2 base b := by
  obtain ⟨h, pc, rfl, hw0, hband, hslack, hpc1, hpc7, hs0, hs1, hs2, hs3, _, _, _, _⟩ := hb
  exact Board.isLevelPocketBandAt_skyline (w := 0) (c := pc)
    (by decide) hw0 hband hslack (by omega)
    (by omega) (by omega) (by omega) (by omega)
    hs0 hs1 hs2 hs3

/-- **The S and Z phase shape forgets to a spread-`2` level pocket band.** Reading the flat pocket
at `pc .. pc + 3` as the band's width-four pocket and column `0` as the reserved well (disjoint
since `pc > vc + 3 ≥ 4`) repackages an `IsSZPhaseReservoirAt base` board as an
`IsLevelPocketBandAt standard 2 base` board, transporting the band height cap onto the staircase
phase. -/
theorem isLevelPocketBandAt_of_isSZPhaseReservoirAt {base : ℕ} {b : Board}
    (hb : IsSZPhaseReservoirAt base b) :
    Board.IsLevelPocketBandAt GameConfig.standard 2 base b := by
  obtain ⟨h, vc, pc, rfl, hw0, hband, hslack, hvc1, hord, hpc3, _, _, _, _,
    hs0, hs1, hs2, hs3⟩ := hb
  exact Board.isLevelPocketBandAt_skyline (w := 0) (c := pc)
    (by decide) hw0 hband hslack hpc3
    (by omega) (by omega) (by omega) (by omega)
    hs0 hs1 hs2 hs3

/-- **The spread-parametrised flat phase reservoir shape.** Generalises `IsFlatPhaseReservoirAt`
from a hardcoded buffer of `2` to an arbitrary buffer `s`: a skyline `h` with a reserved empty well
at column `0`, every working column inside the band `[base, base + s]`, and a width-eight flat run
at columns `pc .. pc + 7` pinned to the floor `base`. The slack `s` is exactly the reservoir's
absorption capacity — the amount the non-I pieces may raise the working columns before the
once-per-bag I-drain resets them. Because the budget bound (six non-I pieces deposit twenty-four
cells over the nine working columns) forces some column to `base + 3` when the I is owed last, a
full-bag closure needs `s ≥ 3`, which the fixed `+2` shape cannot express; this parametric shape
can. -/
def IsFlatPhaseReservoirAtS (s base : ℕ) (b : Board) : Prop :=
  ∃ (h : ℕ → ℕ) (pc : ℕ),
    b = Board.skyline GameConfig.standard h ∧
    h 0 = 0 ∧
    (∀ j < GameConfig.standard.cols, j ≠ 0 → base ≤ h j ∧ h j ≤ base + s) ∧
    base + s ≤ GameConfig.standard.rows ∧
    1 ≤ pc ∧ pc + 7 < GameConfig.standard.cols ∧
    h pc = base ∧ h (pc + 1) = base ∧ h (pc + 2) = base ∧ h (pc + 3) = base ∧
    h (pc + 4) = base ∧ h (pc + 5) = base ∧ h (pc + 6) = base ∧ h (pc + 7) = base

/-- **The spread-`s` flat phase shape forgets to a spread-`s` level pocket band.** The parametric
analogue of `isLevelPocketBandAt_of_isFlatPhaseReservoirAt`: reading the first four columns of the
width-eight run as the band's width-four pocket and column `0` as the reserved well repackages an
`IsFlatPhaseReservoirAtS s base` board as an `IsLevelPocketBandAt standard s base` board, so the
band height cap `colHeight ≤ base + s` transports onto the parametric flat phase at every buffer. -/
theorem isLevelPocketBandAt_of_isFlatPhaseReservoirAtS {s base : ℕ} {b : Board}
    (hb : IsFlatPhaseReservoirAtS s base b) :
    Board.IsLevelPocketBandAt GameConfig.standard s base b := by
  obtain ⟨h, pc, rfl, hw0, hband, hslack, hpc1, hpc7, hs0, hs1, hs2, hs3, _, _, _, _⟩ := hb
  exact Board.isLevelPocketBandAt_skyline (w := 0) (c := pc)
    (by decide) hw0 hband hslack (by omega)
    (by omega) (by omega) (by omega) (by omega)
    hs0 hs1 hs2 hs3

/-- **The spread-`2` flat phase shape is the `s = 2` instance of the parametric shape.** Both
predicates are the same existential with the buffer specialised to `2`, so they are definitionally
interchangeable. This lets every spread-`2` flat-phase fact (init, hosting, refinement) be read as
the `s = 2` slice of the parametric family, and lets a future phase-indexed-spread carrier reuse
the existing concrete flat witnesses unchanged. -/
theorem isFlatPhaseReservoirAtS_two_iff {base : ℕ} {b : Board} :
    IsFlatPhaseReservoirAtS 2 base b ↔ IsFlatPhaseReservoirAt base b := Iff.rfl

/-- **The width-parametric flat run reservoir shape.** Generalises `IsFlatPhaseReservoirAtS` from a
hardcoded width-eight flat run to an arbitrary run width `w` (with `w ≥ 4` so a width-four pocket is
always exposed): a skyline `h` with a reserved empty well at column `0`, every working column inside
the band `[base, base + s]`, and a flat run of width `w` at columns `pc .. pc + w - 1` pinned to the
floor `base`. This is the shape the flat phase actually re-enters under: placing a flat consumes only
PART of the run (an O takes two columns, a T or L or J three, a horizontal I four), leaving a flat run
of width `w` minus the piece width at the SAME floor — so the carrier can present a SHRINKING run as
flats arrive, instead of demanding a fresh width-eight run the next fill cannot supply. The fixed
`IsFlatPhaseReservoirAtS` is the `w = 8` slice. The width budget `w ≥ Σ remaining flat widths` is what
the once-per-bag I-drain replenishes by clearing back to a full-width run. -/
def IsFlatRunReservoirAt (w s base : ℕ) (b : Board) : Prop :=
  ∃ (h : ℕ → ℕ) (pc : ℕ),
    b = Board.skyline GameConfig.standard h ∧
    h 0 = 0 ∧
    (∀ j < GameConfig.standard.cols, j ≠ 0 → base ≤ h j ∧ h j ≤ base + s) ∧
    base + s ≤ GameConfig.standard.rows ∧
    1 ≤ pc ∧ pc + w ≤ GameConfig.standard.cols ∧ 4 ≤ w ∧
    (∀ i < w, h (pc + i) = base)

/-- **The width-parametric flat run forgets to a spread-`s` level pocket band.** Reading the first
four columns of the width-`w` run (`w ≥ 4`) as the band's width-four pocket and column `0` as the
reserved well repackages an `IsFlatRunReservoirAt w s base` board as an `IsLevelPocketBandAt standard
s base` board, so every band height, survival, and fill face already proven for the level pocket band
transports onto the parametric flat run at every width. -/
theorem isLevelPocketBandAt_of_isFlatRunReservoirAt {w s base : ℕ} {b : Board}
    (hb : IsFlatRunReservoirAt w s base b) :
    Board.IsLevelPocketBandAt GameConfig.standard s base b := by
  obtain ⟨h, pc, rfl, hw0, hband, hslack, hpc1, hpcw, hw4, hrun⟩ := hb
  exact Board.isLevelPocketBandAt_skyline (w := 0) (c := pc)
    (by decide) hw0 hband hslack (by omega)
    (by omega) (by omega) (by omega) (by omega)
    (hrun 0 (by omega)) (hrun 1 (by omega)) (hrun 2 (by omega)) (hrun 3 (by omega))

/-- **A flat run may be read at any narrower width `≥ 4`.** The width field `w` only records how many
consecutive columns starting at the pocket `pc` are pinned to the floor `base`; nothing else in
`IsFlatRunReservoirAt` mentions `w`. So if a board carries a width-`w` run and `4 ≤ w' ≤ w`, the same
board carries the width-`w'` run on the same pocket: the `pc + w' ≤ cols` bound weakens from `pc + w ≤
cols`, and the run equation `h (pc + i) = base` for `i < w'` is a restriction of the one for `i < w`.
This monotonicity is the bookkeeping that lets a width-tracking flat carrier shrink its run as non-I
pieces consume columns and re-expand it on the once-per-bag I-drain; it is enabling infrastructure,
not the bag-phase closure — crux #66/#72 remain open and `TetrisSolvableValid` is NOT yet proven. -/
theorem isFlatRunReservoirAt_width_mono {w w' s base : ℕ} {b : Board}
    (hb : IsFlatRunReservoirAt w s base b) (hw'4 : 4 ≤ w') (hww' : w' ≤ w) :
    IsFlatRunReservoirAt w' s base b := by
  obtain ⟨h, pc, rfl, hw0, hband, hslack, hpc1, hpcw, hw4, hrun⟩ := hb
  exact ⟨h, pc, rfl, hw0, hband, hslack, hpc1, by omega, hw'4, fun i hi => hrun i (by omega)⟩

/-- **A single O reduces a flat run by exactly two columns at the same floor.** Dropping the O flush
across the leftmost two columns of the width-`w` run (`w ≥ 6`, so the surviving run stays `≥ 4`
wide) raises those two columns to `base + 2`. With spread `s ≥ 2` the lifted pair stays inside the
band `[base, base + s]`, the reserved well at column `0` is untouched, and columns `pc + 2 … pc + w
- 1` remain a flat run at `base`, now of width `w - 2`. So the placement is valid and the landing is
an `IsFlatRunReservoirAt (w - 2) s base` board: the flat phase re-enters at a shrinking width, one O
consuming two columns of run, until the once-per-bag I-drain replenishes the full width. -/
theorem isFlatRunReservoirAt_O_step {w s base : ℕ} {b : Board}
    (hb : IsFlatRunReservoirAt w s base b) (hw6 : 6 ≤ w) (hs2 : 2 ≤ s) :
    ∃ pl : Placement, pl.piece = Piece.O ∧ pl.Valid GameConfig.standard ∧
      IsFlatRunReservoirAt (w - 2) s base
        (Placement.applyStep GameConfig.standard b pl) := by
  obtain ⟨h, pc, rfl, hw0, hband, hslack, hpc1, hpcw, hw4, hrun⟩ := hb
  have e0 : h pc = base := by simpa using hrun 0 (by omega)
  have e1 : h (pc + 1) = base := hrun 1 (by omega)
  refine ⟨{ piece := Piece.O, rot := 0, col := pc }, rfl, Board.valid_O (by omega), ?_⟩
  have hO : Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
      { piece := Piece.O, rot := 0, col := pc }
      = Board.skyline GameConfig.standard
        (Function.update (Function.update h pc (h pc + 2)) (pc + 1) (h pc + 2)) :=
    Board.applyStep_O_skyline_noclear (w := 0) (by omega) (by omega) (by rw [e0, e1]) (by omega)
      (by omega) (by omega) hw0
  rw [hO]
  refine ⟨Function.update (Function.update h pc (h pc + 2)) (pc + 1) (h pc + 2), pc + 2,
    rfl, ?_, ?_, hslack, by omega, by omega, by omega, ?_⟩
  · rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega)]; exact hw0
  · intro j hj hj0
    rcases eq_or_ne j (pc + 1) with rfl | hjpc1
    · rw [Function.update_self, e0]; omega
    · rw [Function.update_of_ne hjpc1]
      rcases eq_or_ne j pc with rfl | hjpc
      · rw [Function.update_self, e0]; omega
      · rw [Function.update_of_ne hjpc]; exact hband j hj hj0
  · intro i hi
    rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega)]
    have hidx : pc + 2 + i = pc + (2 + i) := by omega
    rw [hidx]
    exact hrun (2 + i) (by omega)

/-- **A single horizontal I reduces a flat run by exactly four columns at the same floor.** The
cheapest filler: dropping the flat I across the leftmost four columns of the width-`w` run (`w ≥ 8`,
so the surviving run stays `≥ 4` wide) raises those four columns to `base + 1`. With spread `s ≥ 1`
the lifted quad stays inside the band `[base, base + s]`, the reserved well at column `0` is
untouched, and columns `pc + 4 … pc + w - 1` remain a flat run at `base`, now of width `w - 4`. So
the placement is valid and the landing is an `IsFlatRunReservoirAt (w - 4) s base` board — the
horizontal-I companion to `isFlatRunReservoirAt_O_step`, consuming four run columns per use. -/
theorem isFlatRunReservoirAt_horizI_step {w s base : ℕ} {b : Board}
    (hb : IsFlatRunReservoirAt w s base b) (hw8 : 8 ≤ w) (hs1 : 1 ≤ s) :
    ∃ pl : Placement, pl.piece = Piece.I ∧ pl.Valid GameConfig.standard ∧
      IsFlatRunReservoirAt (w - 4) s base
        (Placement.applyStep GameConfig.standard b pl) := by
  obtain ⟨h, pc, rfl, hw0, hband, hslack, hpc1, hpcw, hw4, hrun⟩ := hb
  have e0 : h pc = base := by simpa using hrun 0 (by omega)
  have e1 : h (pc + 1) = base := hrun 1 (by omega)
  have e2 : h (pc + 2) = base := hrun 2 (by omega)
  have e3 : h (pc + 3) = base := hrun 3 (by omega)
  refine ⟨{ piece := Piece.I, rot := 0, col := pc }, rfl, Board.valid_horizI (by omega), ?_⟩
  have hI : Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
      { piece := Piece.I, rot := 0, col := pc }
      = Board.skyline GameConfig.standard
        (Function.update (Function.update (Function.update
          (Function.update h pc (h pc + 1)) (pc + 1) (h pc + 1)) (pc + 2) (h pc + 1))
          (pc + 3) (h pc + 1)) :=
    Board.applyStep_horizI_skyline_noclear (w := 0) (by omega) (by omega) (by omega) (by omega)
      (by rw [e1, e0]) (by rw [e2, e0]) (by rw [e3, e0]) (by omega)
      (by omega) (by omega) (by omega) (by omega) hw0
  rw [hI]
  refine ⟨Function.update (Function.update (Function.update
    (Function.update h pc (h pc + 1)) (pc + 1) (h pc + 1)) (pc + 2) (h pc + 1)) (pc + 3) (h pc + 1),
    pc + 4, rfl, ?_, ?_, hslack, by omega, by omega, by omega, ?_⟩
  · rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega),
      Function.update_of_ne (by omega), Function.update_of_ne (by omega)]; exact hw0
  · intro j hj hj0
    rcases eq_or_ne j (pc + 3) with rfl | hj3
    · rw [Function.update_self, e0]; omega
    · rw [Function.update_of_ne hj3]
      rcases eq_or_ne j (pc + 2) with rfl | hj2
      · rw [Function.update_self, e0]; omega
      · rw [Function.update_of_ne hj2]
        rcases eq_or_ne j (pc + 1) with rfl | hj1
        · rw [Function.update_self, e0]; omega
        · rw [Function.update_of_ne hj1]
          rcases eq_or_ne j pc with rfl | hjpc
          · rw [Function.update_self, e0]; omega
          · rw [Function.update_of_ne hjpc]; exact hband j hj hj0
  · intro i hi
    rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega),
      Function.update_of_ne (by omega), Function.update_of_ne (by omega)]
    have hidx : pc + 4 + i = pc + (4 + i) := by omega
    rw [hidx]
    exact hrun (4 + i) (by omega)

/-- **A single T reduces a flat run by exactly three columns at the same floor.** Seating the T
podium (`rot 2`) on the leftmost three columns of the width-`w` run (`w ≥ 7`, so the surviving run
stays `≥ 4` wide) writes `base + 1, base + 2, base + 1` into columns `pc, pc + 1, pc + 2`. The
podium top reaches `base + 2`, so spread `s ≥ 2` keeps the whole footprint inside the band
`[base, base + s]`; the consumed columns are no longer mutually level but that is fine — only the
*remaining* run `pc + 3 … pc + w - 1` (width `w - 3`, at `base`) must stay flat, and it does. The
reserved well at column `0` is untouched, so the landing is an `IsFlatRunReservoirAt (w - 3) s base`
board. One of the three triple-column flat-run reducers (T, then L, J share the `w - 3` shape). -/
theorem isFlatRunReservoirAt_T_step {w s base : ℕ} {b : Board}
    (hb : IsFlatRunReservoirAt w s base b) (hw7 : 7 ≤ w) (hs2 : 2 ≤ s) :
    ∃ pl : Placement, pl.piece = Piece.T ∧ pl.Valid GameConfig.standard ∧
      IsFlatRunReservoirAt (w - 3) s base
        (Placement.applyStep GameConfig.standard b pl) := by
  obtain ⟨h, pc, rfl, hw0, hband, hslack, hpc1, hpcw, hw4, hrun⟩ := hb
  have e0 : h pc = base := by simpa using hrun 0 (by omega)
  have e1 : h (pc + 1) = base := hrun 1 (by omega)
  have e2 : h (pc + 2) = base := hrun 2 (by omega)
  refine ⟨{ piece := Piece.T, rot := 2, col := pc }, rfl, Board.valid_T (by omega), ?_⟩
  have hT : Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
      { piece := Piece.T, rot := 2, col := pc }
      = Board.skyline GameConfig.standard
        (Function.update (Function.update (Function.update h pc (h pc + 1))
          (pc + 1) (h pc + 2)) (pc + 2) (h pc + 1)) :=
    Board.applyStep_T_skyline_noclear (w := 0) (by omega) (by omega) (by omega)
      (by rw [e1, e0]) (by rw [e2, e0]) (by omega) (by omega) (by omega) (by omega) hw0
  rw [hT]
  refine ⟨Function.update (Function.update (Function.update h pc (h pc + 1))
    (pc + 1) (h pc + 2)) (pc + 2) (h pc + 1), pc + 3,
    rfl, ?_, ?_, hslack, by omega, by omega, by omega, ?_⟩
  · rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega),
      Function.update_of_ne (by omega)]; exact hw0
  · intro j hj hj0
    rcases eq_or_ne j (pc + 2) with rfl | hj2
    · rw [Function.update_self, e0]; omega
    · rw [Function.update_of_ne hj2]
      rcases eq_or_ne j (pc + 1) with rfl | hj1
      · rw [Function.update_self, e0]; omega
      · rw [Function.update_of_ne hj1]
        rcases eq_or_ne j pc with rfl | hjpc
        · rw [Function.update_self, e0]; omega
        · rw [Function.update_of_ne hjpc]; exact hband j hj hj0
  · intro i hi
    rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega),
      Function.update_of_ne (by omega)]
    have hidx : pc + 3 + i = pc + (3 + i) := by omega
    rw [hidx]
    exact hrun (3 + i) (by omega)

/-- **A single J reduces a flat run by exactly three columns at the same floor.** The J (`rot 0`)
seats on the leftmost three columns of the width-`w` run (`w ≥ 7`, so the surviving run stays `≥ 4`
wide) writing `base + 2, base + 1, base + 1` into columns `pc, pc + 1, pc + 2` — the mirror of the L
foot, with the stem rising to `base + 2` on the first column and the foot flat on the next two.
Spread `s ≥ 2` keeps the footprint inside the band `[base, base + s]`; only the *remaining* run
`pc + 3 … pc + w - 1` (width `w - 3`, at `base`) must stay flat, and it does. The reserved well at
column `0` is untouched, so the landing is an `IsFlatRunReservoirAt (w - 3) s base` board. This is
the fifth and final flat-run reducer (O, I, T, L, J), completing the non-staircase fill menu. -/
theorem isFlatRunReservoirAt_J_step {w s base : ℕ} {b : Board}
    (hb : IsFlatRunReservoirAt w s base b) (hw7 : 7 ≤ w) (hs2 : 2 ≤ s) :
    ∃ pl : Placement, pl.piece = Piece.J ∧ pl.Valid GameConfig.standard ∧
      IsFlatRunReservoirAt (w - 3) s base
        (Placement.applyStep GameConfig.standard b pl) := by
  obtain ⟨h, pc, rfl, hw0, hband, hslack, hpc1, hpcw, hw4, hrun⟩ := hb
  have e0 : h pc = base := by simpa using hrun 0 (by omega)
  have e1 : h (pc + 1) = base := hrun 1 (by omega)
  have e2 : h (pc + 2) = base := hrun 2 (by omega)
  refine ⟨{ piece := Piece.J, rot := 0, col := pc }, rfl, Board.valid_J (by omega), ?_⟩
  have hJ : Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
      { piece := Piece.J, rot := 0, col := pc }
      = Board.skyline GameConfig.standard
        (Function.update (Function.update (Function.update h pc (h pc + 2))
          (pc + 1) (h pc + 1)) (pc + 2) (h pc + 1)) :=
    Board.applyStep_J_skyline_noclear (w := 0) (by omega) (by omega) (by omega)
      (by rw [e1, e0]) (by rw [e2, e0]) (by omega) (by omega) (by omega) (by omega) hw0
  rw [hJ]
  refine ⟨Function.update (Function.update (Function.update h pc (h pc + 2))
    (pc + 1) (h pc + 1)) (pc + 2) (h pc + 1), pc + 3,
    rfl, ?_, ?_, hslack, by omega, by omega, by omega, ?_⟩
  · rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega),
      Function.update_of_ne (by omega)]; exact hw0
  · intro j hj hj0
    rcases eq_or_ne j (pc + 2) with rfl | hj2
    · rw [Function.update_self, e0]; omega
    · rw [Function.update_of_ne hj2]
      rcases eq_or_ne j (pc + 1) with rfl | hj1
      · rw [Function.update_self, e0]; omega
      · rw [Function.update_of_ne hj1]
        rcases eq_or_ne j pc with rfl | hjpc
        · rw [Function.update_self, e0]; omega
        · rw [Function.update_of_ne hjpc]; exact hband j hj hj0
  · intro i hi
    rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega),
      Function.update_of_ne (by omega)]
    have hidx : pc + 3 + i = pc + (3 + i) := by omega
    rw [hidx]
    exact hrun (3 + i) (by omega)

/-- **A single L reduces a flat run by exactly three columns at the same floor.** The L (`rot 0`)
seats on the leftmost three columns of the width-`w` run (`w ≥ 7`, so the surviving run stays `≥ 4`
wide) writing `base + 1, base + 1, base + 2` into columns `pc, pc + 1, pc + 2` — the foot lies flat
on the first two and the stem rises to `base + 2` on the third. Spread `s ≥ 2` keeps the footprint
inside the band `[base, base + s]`; only the *remaining* run `pc + 3 … pc + w - 1` (width `w - 3`, at
`base`) must stay flat, and it does. The reserved well at column `0` is untouched, so the landing is
an `IsFlatRunReservoirAt (w - 3) s base` board: the L companion to `isFlatRunReservoirAt_T_step`. -/
theorem isFlatRunReservoirAt_L_step {w s base : ℕ} {b : Board}
    (hb : IsFlatRunReservoirAt w s base b) (hw7 : 7 ≤ w) (hs2 : 2 ≤ s) :
    ∃ pl : Placement, pl.piece = Piece.L ∧ pl.Valid GameConfig.standard ∧
      IsFlatRunReservoirAt (w - 3) s base
        (Placement.applyStep GameConfig.standard b pl) := by
  obtain ⟨h, pc, rfl, hw0, hband, hslack, hpc1, hpcw, hw4, hrun⟩ := hb
  have e0 : h pc = base := by simpa using hrun 0 (by omega)
  have e1 : h (pc + 1) = base := hrun 1 (by omega)
  have e2 : h (pc + 2) = base := hrun 2 (by omega)
  refine ⟨{ piece := Piece.L, rot := 0, col := pc }, rfl, Board.valid_L (by omega), ?_⟩
  have hL : Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
      { piece := Piece.L, rot := 0, col := pc }
      = Board.skyline GameConfig.standard
        (Function.update (Function.update (Function.update h pc (h pc + 1))
          (pc + 1) (h pc + 1)) (pc + 2) (h pc + 2)) :=
    Board.applyStep_L_skyline_noclear (w := 0) (by omega) (by omega) (by omega)
      (by rw [e1, e0]) (by rw [e2, e0]) (by omega) (by omega) (by omega) (by omega) hw0
  rw [hL]
  refine ⟨Function.update (Function.update (Function.update h pc (h pc + 1))
    (pc + 1) (h pc + 1)) (pc + 2) (h pc + 2), pc + 3,
    rfl, ?_, ?_, hslack, by omega, by omega, by omega, ?_⟩
  · rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega),
      Function.update_of_ne (by omega)]; exact hw0
  · intro j hj hj0
    rcases eq_or_ne j (pc + 2) with rfl | hj2
    · rw [Function.update_self, e0]; omega
    · rw [Function.update_of_ne hj2]
      rcases eq_or_ne j (pc + 1) with rfl | hj1
      · rw [Function.update_self, e0]; omega
      · rw [Function.update_of_ne hj1]
        rcases eq_or_ne j pc with rfl | hjpc
        · rw [Function.update_self, e0]; omega
        · rw [Function.update_of_ne hjpc]; exact hband j hj hj0
  · intro i hi
    rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega),
      Function.update_of_ne (by omega)]
    have hidx : pc + 3 + i = pc + (3 + i) := by omega
    rw [hidx]
    exact hrun (3 + i) (by omega)

/-- **A flat run of width `≥ 8` hosts any non-staircase piece, shrinking by at most four columns.**
The unified flat-phase fill dispatcher bundling the five per-piece reducers (`isFlatRunReservoirAt_O_step`,
`_horizI_step`, `_T_step`, `_L_step`, `_J_step`): for any `p ∈ {O, I, T, L, J}` there is a valid
placement seating `p` flush on the left of the run, landing back in an `IsFlatRunReservoirAt w' s base`
board whose surviving run width `w'` satisfies `w - 4 ≤ w'` (`O → w - 2`, `I → w - 4`, `T, L, J →
w - 3`, all `≥ w - 4`). Uniformising the output to `∃ w' ≥ w - 4` lets a coarse width budget decrement
by at most four per non-staircase placement, independent of which non-staircase piece the adversary
draws. The two staircase pieces S, Z are excluded — they need a valley, handled by the S/Z phase. -/
theorem isFlatRunReservoirAt_nonStaircase_step {w s base : ℕ} {b : Board} {p : Piece}
    (hb : IsFlatRunReservoirAt w s base b) (hw8 : 8 ≤ w) (hs2 : 2 ≤ s)
    (hp : p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      ∃ w', w - 4 ≤ w' ∧ IsFlatRunReservoirAt w' s base
        (Placement.applyStep GameConfig.standard b pl) := by
  rcases hp with rfl | rfl | rfl | rfl | rfl
  · obtain ⟨pl, hpc, hv, hout⟩ := isFlatRunReservoirAt_O_step hb (by omega) hs2
    exact ⟨pl, hpc, hv, w - 2, by omega, hout⟩
  · obtain ⟨pl, hpc, hv, hout⟩ := isFlatRunReservoirAt_horizI_step hb hw8 (by omega)
    exact ⟨pl, hpc, hv, w - 4, by omega, hout⟩
  · obtain ⟨pl, hpc, hv, hout⟩ := isFlatRunReservoirAt_T_step hb (by omega) hs2
    exact ⟨pl, hpc, hv, w - 3, by omega, hout⟩
  · obtain ⟨pl, hpc, hv, hout⟩ := isFlatRunReservoirAt_L_step hb (by omega) hs2
    exact ⟨pl, hpc, hv, w - 3, by omega, hout⟩
  · obtain ⟨pl, hpc, hv, hout⟩ := isFlatRunReservoirAt_J_step hb (by omega) hs2
    exact ⟨pl, hpc, hv, w - 3, by omega, hout⟩

/-- **A flat phase shape is a width-eight flat run.** The bridge from the fixed-width phase shape
`IsFlatPhaseReservoirAtS s base` (well at column `0`, eight floor columns at `pc .. pc + 7`) to the
width-parametric run shape `IsFlatRunReservoirAt 8 s base`: the same skyline, well, band, and floor
witness it, and the eight individual floor equalities `h pc = base .. h (pc + 7) = base` package into
the uniform run predicate `∀ i < 8, h (pc + i) = base`. This is what makes the SHRINKING-run fill
machinery (`isFlatRunReservoirAt_nonStaircase_step`, decrementing the run width by at most four per
non-staircase placement) available to the flat phase shape — the mechanism that, unlike the fixed
width-eight phase shape, actually survives a fill. -/
theorem isFlatRunReservoirAt_of_isFlatPhaseReservoirAtS {s base : ℕ} {b : Board}
    (hb : IsFlatPhaseReservoirAtS s base b) :
    IsFlatRunReservoirAt 8 s base b := by
  obtain ⟨h, pc, rfl, hw0, hband, hslack, hpc1, hpc7, hs0, hs1, hs2, hs3, hs4, hs5, hs6, hs7⟩ := hb
  refine ⟨h, pc, rfl, hw0, hband, hslack, hpc1, by omega, by omega, ?_⟩
  intro i hi
  interval_cases i
  · simpa using hs0
  · exact hs1
  · exact hs2
  · exact hs3
  · exact hs4
  · exact hs5
  · exact hs6
  · exact hs7

/-- **A flat phase shape hosts any non-staircase piece, landing in a shrinking flat run.** The first
fill consequence of the run bridge: re-reading the width-eight flat phase shape as an
`IsFlatRunReservoirAt 8 s base` run (`isFlatRunReservoirAt_of_isFlatPhaseReservoirAtS`) and applying
the five-piece run reducer (`isFlatRunReservoirAt_nonStaircase_step`), every non-staircase piece
`p ∈ {O, I, T, L, J}` has a valid placement seating flush on the run, landing in an
`IsFlatRunReservoirAt w' s base` board with surviving width `w' ≥ 4`. This is the steady-state flat
fill the `flat_no_sz_edge` needs — the shrinking run is the post-fill shape a flat phase actually
re-enters, with the once-per-bag I-drain replenishing the run back to full width. Needs buffer
`s ≥ 2` (the O, T, L, J podiums reach `base + 2`). -/
theorem isFlatPhaseReservoirAtS_hosts_nonStaircase {s base : ℕ} {b : Board} {p : Piece}
    (hb : IsFlatPhaseReservoirAtS s base b) (hs2 : 2 ≤ s)
    (hp : p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      ∃ w', 4 ≤ w' ∧ IsFlatRunReservoirAt w' s base
        (Placement.applyStep GameConfig.standard b pl) := by
  have hrun : IsFlatRunReservoirAt 8 s base b := isFlatRunReservoirAt_of_isFlatPhaseReservoirAtS hb
  obtain ⟨pl, hpc, hv, w', hw', hout⟩ :=
    isFlatRunReservoirAt_nonStaircase_step hrun (by omega) hs2 hp
  exact ⟨pl, hpc, hv, w', by omega, hout⟩

/-- **A flat run reservoir forgets to a floor-pinned spread band.** The run shape's own forgetful
edge into the drain vocabulary: `isLevelPocketBandAt_of_isFlatRunReservoirAt` repackages an
`IsFlatRunReservoirAt w s base` board as a spread-`s` level pocket band, then
`isSpreadBoundedRWSkylineAt_of_isLevelPocketBandAt` forgets the pocket to the floor-pinned spread
band `IsSpreadBoundedRWSkylineAt s base` — the exact vocabulary the once-per-bag I-drain
(`isSpreadBoundedRWSkylineAt_vertI_well_descend`) and the spread-band carrier
`reservoirSpreadCarrier` speak. So a shrinking run, however many flats it has absorbed, can always
be handed to the regulator drain to reset, at zero spread or floor cost. -/
theorem isSpreadBoundedRWSkylineAt_of_isFlatRunReservoirAt {w s base : ℕ} {b : Board}
    (hb : IsFlatRunReservoirAt w s base b) :
    Board.IsSpreadBoundedRWSkylineAt GameConfig.standard s base b :=
  Board.isSpreadBoundedRWSkylineAt_of_isLevelPocketBandAt
    (isLevelPocketBandAt_of_isFlatRunReservoirAt hb)

/-- **A wide flat run is a flat phase shape.** The converse of
`isFlatRunReservoirAt_of_isFlatPhaseReservoirAtS`: any `IsFlatRunReservoirAt w s base` run of width
`w ≥ 8` contains a width-eight floor run at its left (`pc .. pc + 7`), so reading the first eight
columns as the phase shape's fixed run repackages it as an `IsFlatPhaseReservoirAtS s base` board.
This is the drain re-entry: once the once-per-bag I-drain regenerates a full-width (`≥ 8`) flat run,
this converse re-enters the flat phase shape, and `bandPhaseReservoirS_of_flat` re-enters the
phase-indexed carrier for the next bag. Together with the forward bridge, the width-eight run and the
flat phase shape are interchangeable. -/
theorem isFlatPhaseReservoirAtS_of_isFlatRunReservoirAt {w s base : ℕ} {b : Board}
    (hb : IsFlatRunReservoirAt w s base b) (hw8 : 8 ≤ w) :
    IsFlatPhaseReservoirAtS s base b := by
  obtain ⟨h, pc, rfl, hw0, hband, hslack, hpc1, hpcw, hw4, hrun⟩ := hb
  refine ⟨h, pc, rfl, hw0, hband, hslack, hpc1, by omega, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · simpa using hrun 0 (by omega)
  · exact hrun 1 (by omega)
  · exact hrun 2 (by omega)
  · exact hrun 3 (by omega)
  · exact hrun 4 (by omega)
  · exact hrun 5 (by omega)
  · exact hrun 6 (by omega)
  · exact hrun 7 (by omega)

/-- **The flat run's once-per-bag I-drain reset, width preserved.** The regulator edge of the
width-parametric run: from any `IsFlatRunReservoirAt w s base` run whose floor is at least four,
dropping the vertical `I` into the reserved empty well at column `0` clears four full rows
(`applyStep_vertI_well`), so every working column drops by exactly four while the well stays empty.
The width-`w` run that sat at floor `base` therefore lands at floor `base - 4` with its width
unchanged, and the band columns `[base, base + s]` descend to `[base - 4, (base - 4) + s]` — the
spread is preserved. So the post-drain board is again an `IsFlatRunReservoirAt w s (base - 4)` run.
This is the half-cycle complement to the shrinking fill reducers: where each non-`I` fill lowers the
run width at a fixed floor, the guaranteed `I` lowers the floor by four at a fixed width, draining the
buffer the fills consumed back down before the band can top out. Unlike the spread-band drain
(`reservoirSpreadCarrier_vertI_drain_cap`) this one stays inside the run vocabulary, so the run's own
shrinking-width ledger can be reset without leaving the flat-phase shape. -/
theorem isFlatRunReservoirAt_full_drain {w s base : ℕ} {b : Board}
    (hb : IsFlatRunReservoirAt w s base b) (hbase4 : 4 ≤ base) :
    IsFlatRunReservoirAt w s (base - 4)
      (Placement.applyStep GameConfig.standard b
        { piece := Piece.I, rot := 1, col := 0 }) := by
  obtain ⟨h, pc, rfl, hw0, hband, hslack, hpc1, hpcw, hw4, hrun⟩ := hb
  have hothers : ∀ j, j < GameConfig.standard.cols → j ≠ 0 → 4 ≤ h j :=
    fun j hj hj0 => le_trans hbase4 (hband j hj hj0).1
  rw [Board.applyStep_vertI_well (by decide) hw0 hothers]
  refine ⟨fun j => if j = 0 then 0 else h j - 4, pc, rfl, ?_, ?_, ?_, hpc1, hpcw, hw4, ?_⟩
  · simp
  · intro j hj hj0
    simp only [if_neg hj0]
    obtain ⟨hlo, hhi⟩ := hband j hj hj0
    omega
  · omega
  · intro i hi
    have hpci0 : pc + i ≠ 0 := by omega
    simp only [if_neg hpci0]
    rw [hrun i hi]

/-- **The per-piece fill-then-drain net half-cycle on the flat run.** Composes the two halves of the
bag cycle now available in the run vocabulary: one non-staircase fill
(`isFlatRunReservoirAt_nonStaircase_step`, which on a width-`w ≥ 8`, spread-`s ≥ 2` run drops the run
width by at most four while pinning the floor at `base`) followed by the guaranteed once-per-bag
well-`I` drain (`isFlatRunReservoirAt_full_drain`, which on a floor-`≥ 4` run lowers the floor by four
while preserving the width). The net effect of the pair is exactly the per-piece bag accounting: from
`IsFlatRunReservoirAt w s base` (`w ≥ 8`, `s ≥ 2`, `base ≥ 4`) any flat piece `p ∈ {O, I, T, L, J}`
admits a valid placement landing — after the drain — in `IsFlatRunReservoirAt w' s (base - 4)` with
`w - 4 ≤ w'`. The drain re-uses the post-fill floor `base` (the fill leaves the floor pinned, so it
stays `≥ 4`), so the two transitions chain without any extra side condition. This is the smallest unit
of the regulator-paced descent: each non-`I` piece spends at most four columns of run, and the
once-per-bag `I` buys back four rows of floor headroom — the ledger the bag-phase carrier must thread
so the band never tops out before the `I` arrives. -/
theorem isFlatRunReservoirAt_nonStaircase_fillDrain {w s base : ℕ} {b : Board} {p : Piece}
    (hb : IsFlatRunReservoirAt w s base b) (hw8 : 8 ≤ w) (hs2 : 2 ≤ s) (hbase4 : 4 ≤ base)
    (hp : p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J) :
    ∃ (pl : Placement) (w' : ℕ), pl.piece = p ∧ pl.Valid GameConfig.standard ∧ w - 4 ≤ w' ∧
      IsFlatRunReservoirAt w' s (base - 4)
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard b pl)
          { piece := Piece.I, rot := 1, col := 0 }) := by
  obtain ⟨pl, hpiece, hvalid, w', hw'bound, hfill⟩ :=
    isFlatRunReservoirAt_nonStaircase_step hb hw8 hs2 hp
  exact ⟨pl, w', hpiece, hvalid, hw'bound, isFlatRunReservoirAt_full_drain hfill hbase4⟩

/-- **The regulator self-map on the flat phase shape.** The once-per-bag well-`I` drain expressed
entirely in the flat-phase vocabulary the carrier `bandPhaseReservoirS` speaks, threading the
width-eight run interchange built in iter347 and iter350 around the width-preserving run drain
(`isFlatRunReservoirAt_full_drain`). A flat phase shape `IsFlatPhaseReservoirAtS s base` is a
width-eight run (`isFlatRunReservoirAt_of_isFlatPhaseReservoirAtS`); the well-`I` lowers its floor by
four while keeping the width at eight (`isFlatRunReservoirAt_full_drain`); and a width-eight run is a
flat phase shape again (`isFlatPhaseReservoirAtS_of_isFlatRunReservoirAt`). So on any flat phase shape
whose floor is at least four, dropping the vertical `I` into the reserved well at column `0` lands a
flat phase shape at floor `base - 4` with the same buffer `s`. This is exactly the `I`-piece transition
the carrier's flat edges owe: when the drawn piece is the bag's guaranteed `I`, the post-drain board is
a flat phase shape at a strictly lower floor, so the band drains back toward its reset surface without
ever leaving the flat phase. The fills shrink the run width at a fixed floor; this drain restores floor
headroom at the fixed width-eight — together they are the bag's rise-and-reset cycle in one vocabulary. -/
theorem isFlatPhaseReservoirAtS_full_drain {s base : ℕ} {b : Board}
    (hb : IsFlatPhaseReservoirAtS s base b) (hbase4 : 4 ≤ base) :
    IsFlatPhaseReservoirAtS s (base - 4)
      (Placement.applyStep GameConfig.standard b
        { piece := Piece.I, rot := 1, col := 0 }) :=
  isFlatPhaseReservoirAtS_of_isFlatRunReservoirAt
    (isFlatRunReservoirAt_full_drain
      (isFlatRunReservoirAt_of_isFlatPhaseReservoirAtS hb) hbase4)
    (by omega)

/-- **The spread-parametrised S and Z phase reservoir shape.** Generalises `IsSZPhaseReservoirAt`
from a hardcoded buffer of `2` to an arbitrary buffer `s`: a skyline `h` with a reserved empty well
at column `0`, every working column inside the band `[base, base + s]`, a shared width-four valley
`(base + 1, base, base, base + 1)` seating both staircases, and a disjoint width-four flat pocket
carrying the flats. The valley lips at `base + 1` require `s ≥ 1`. Like the flat parametric shape,
the slack `s` is the absorption capacity the reservoir holds while a staircase is still owed, so a
phase-indexed-spread carrier can present this shape at the buffer the current bag phase needs rather
than a fixed `+2`. -/
def IsSZPhaseReservoirAtS (s base : ℕ) (b : Board) : Prop :=
  ∃ (h : ℕ → ℕ) (vc pc : ℕ),
    b = Board.skyline GameConfig.standard h ∧
    h 0 = 0 ∧
    (∀ j < GameConfig.standard.cols, j ≠ 0 → base ≤ h j ∧ h j ≤ base + s) ∧
    base + s ≤ GameConfig.standard.rows ∧
    1 ≤ vc ∧ vc + 3 < pc ∧ pc + 3 < GameConfig.standard.cols ∧
    h vc = base + 1 ∧ h (vc + 1) = base ∧ h (vc + 2) = base ∧ h (vc + 3) = base + 1 ∧
    h pc = base ∧ h (pc + 1) = base ∧ h (pc + 2) = base ∧ h (pc + 3) = base

/-- **The spread-`s` S and Z phase shape forgets to a spread-`s` level pocket band.** The parametric
analogue of `isLevelPocketBandAt_of_isSZPhaseReservoirAt`: reading the flat pocket at `pc .. pc + 3`
as the band's width-four pocket and column `0` as the reserved well repackages an
`IsSZPhaseReservoirAtS s base` board as an `IsLevelPocketBandAt standard s base` board, so the band
height cap `colHeight ≤ base + s` transports onto the parametric staircase phase at every buffer. -/
theorem isLevelPocketBandAt_of_isSZPhaseReservoirAtS {s base : ℕ} {b : Board}
    (hb : IsSZPhaseReservoirAtS s base b) :
    Board.IsLevelPocketBandAt GameConfig.standard s base b := by
  obtain ⟨h, vc, pc, rfl, hw0, hband, hslack, hvc1, hord, hpc3, _, _, _, _,
    hs0, hs1, hs2, hs3⟩ := hb
  exact Board.isLevelPocketBandAt_skyline (w := 0) (c := pc)
    (by decide) hw0 hband hslack hpc3
    (by omega) (by omega) (by omega) (by omega)
    hs0 hs1 hs2 hs3

/-- **The regulator self-map on the S and Z phase shape.** The staircase-phase analogue of
`isFlatPhaseReservoirAtS_full_drain`: the once-per-bag well-`I` drain expressed in the S/Z phase
vocabulary. On any S/Z phase shape whose floor is at least four, dropping the vertical `I` into the
reserved empty well at column `0` clears four full rows (`Board.applyStep_vertI_well` — the valley
floor and pocket both sit at `base ≥ 4`, so the four rows below them are full off the well), and every
working column drops by four while the well stays empty. The band `[base, base + s]` descends to
`[base - 4, (base - 4) + s]`, the valley `(base + 1, base, base, base + 1)` descends to
`((base - 4) + 1, base - 4, base - 4, (base - 4) + 1)` — still a valley, its lips one above its floor —
and the flat pocket descends from `base` to `base - 4`. So the post-drain board is again an
`IsSZPhaseReservoirAtS s (base - 4)` shape: the staircase phase drains back toward its reset surface
without leaving the staircase phase, exactly as the flat phase does. Together with the flat self-map
this gives the carrier's guaranteed `I` its landing shape in *both* phases, the regulator transition
every one of the three carrier edges owes when the drawn piece is the bag's `I`. -/
theorem isSZPhaseReservoirAtS_full_drain {s base : ℕ} {b : Board}
    (hb : IsSZPhaseReservoirAtS s base b) (hbase4 : 4 ≤ base) :
    IsSZPhaseReservoirAtS s (base - 4)
      (Placement.applyStep GameConfig.standard b
        { piece := Piece.I, rot := 1, col := 0 }) := by
  obtain ⟨h, vc, pc, rfl, hw0, hband, hslack, hvc1, hord, hpc3,
    hv0, hv1, hv2, hv3, hs0, hs1, hs2, hs3⟩ := hb
  have hothers : ∀ j, j < GameConfig.standard.cols → j ≠ 0 → 4 ≤ h j :=
    fun j hj hj0 => le_trans hbase4 (hband j hj hj0).1
  rw [Board.applyStep_vertI_well (by decide) hw0 hothers]
  refine ⟨fun j => if j = 0 then 0 else h j - 4, vc, pc, rfl, ?_, ?_, ?_,
    hvc1, hord, hpc3, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · simp
  · intro j hj hj0
    simp only [if_neg hj0]
    obtain ⟨hlo, hhi⟩ := hband j hj hj0
    omega
  · omega
  · simp only [if_neg (show vc ≠ 0 by omega)]; omega
  · simp only [if_neg (show vc + 1 ≠ 0 by omega)]; omega
  · simp only [if_neg (show vc + 2 ≠ 0 by omega)]; omega
  · simp only [if_neg (show vc + 3 ≠ 0 by omega)]; omega
  · simp only [if_neg (show pc ≠ 0 by omega)]; omega
  · simp only [if_neg (show pc + 1 ≠ 0 by omega)]; omega
  · simp only [if_neg (show pc + 2 ≠ 0 by omega)]; omega
  · simp only [if_neg (show pc + 3 ≠ 0 by omega)]; omega

/-- **The spread-`2` S and Z phase shape is the `s = 2` instance of the parametric shape.** Both
predicates are the same existential with the buffer specialised to `2`, so they are definitionally
interchangeable, letting every spread-`2` staircase-phase fact be read as the `s = 2` slice of the
parametric family. -/
theorem isSZPhaseReservoirAtS_two_iff {base : ℕ} {b : Board} :
    IsSZPhaseReservoirAtS 2 base b ↔ IsSZPhaseReservoirAt base b := Iff.rfl

/-- **Flat phase buffer monotonicity.** Widening the buffer from `s` to any `s' ≥ s` (as long as
the wider band still fits, `base + s' ≤ rows`) preserves the flat phase shape: the same skyline,
well, and width-eight floor run witness it, and every working column stays inside `[base, base + s]
⊆ [base, base + s']`. This is the enabling move for a fill that raises the surface — the carrier
pre-widens its absorption buffer to cover the new column heights before re-presenting the shape,
mirroring `isLevelPocketBandAt_mono_spread` at the phase-shape level. -/
theorem isFlatPhaseReservoirAtS_mono_spread {s s' base : ℕ} {b : Board}
    (hb : IsFlatPhaseReservoirAtS s base b) (hss : s ≤ s')
    (hcap : base + s' ≤ GameConfig.standard.rows) :
    IsFlatPhaseReservoirAtS s' base b := by
  obtain ⟨h, pc, rfl, hw0, hband, _, hpc1, hpc7, hs0, hs1, hs2, hs3, hs4, hs5, hs6, hs7⟩ := hb
  exact ⟨h, pc, rfl, hw0,
    fun j hj hj0 => ⟨(hband j hj hj0).1, le_trans (hband j hj hj0).2 (by omega)⟩,
    hcap, hpc1, hpc7, hs0, hs1, hs2, hs3, hs4, hs5, hs6, hs7⟩

/-- **S and Z phase buffer monotonicity.** The staircase-phase analogue of
`isFlatPhaseReservoirAtS_mono_spread`: widening the buffer from `s` to `s' ≥ s` (with
`base + s' ≤ rows`) preserves the S/Z phase shape, since the valley lips at `base + 1` and the flat
pocket all stay inside the widened band `[base, base + s']`. Lets a fill raise the surface while a
staircase is still owed, re-presenting the valley shape at the enlarged buffer. -/
theorem isSZPhaseReservoirAtS_mono_spread {s s' base : ℕ} {b : Board}
    (hb : IsSZPhaseReservoirAtS s base b) (hss : s ≤ s')
    (hcap : base + s' ≤ GameConfig.standard.rows) :
    IsSZPhaseReservoirAtS s' base b := by
  obtain ⟨h, vc, pc, rfl, hw0, hband, _, hvc1, hord, hpc3, hv0, hv1, hv2, hv3,
    hp0, hp1, hp2, hp3⟩ := hb
  exact ⟨h, vc, pc, rfl, hw0,
    fun j hj hj0 => ⟨(hband j hj hj0).1, le_trans (hband j hj hj0).2 (by omega)⟩,
    hcap, hvc1, hord, hpc3, hv0, hv1, hv2, hv3, hp0, hp1, hp2, hp3⟩

/-- **The canonical flat reset surface is a flat phase shape** (the re-entry the I-drain targets).
The concrete `reservoirFlatSurface base` (reserved well at column `0`, flat shelf at floor `base`
everywhere else) is, on the standard board, an `IsFlatPhaseReservoirAtS s base` witness at the
width-eight run `pc = 1 .. 8`: the well reads `0`, every working column sits at `base` (inside
`[base, base + s]`), and columns `1 .. 8` are flat at `base`. Side condition: the band fits,
`base + s ≤ rows`. This lets every lemma whose endpoint is the flat reset shelf (notably the
once-per-bag I-drain back to a flat floor) re-enter `bandPhaseReservoirS` via
`bandPhaseReservoirS_of_flat`. -/
theorem isFlatPhaseReservoirAtS_reservoirFlatSurface {s base : ℕ}
    (hcap : base + s ≤ GameConfig.standard.rows) :
    IsFlatPhaseReservoirAtS s base
      (Board.skyline GameConfig.standard (reservoirFlatSurface base)) :=
  ⟨reservoirFlatSurface base, 1, rfl,
    by simp [reservoirFlatSurface],
    by intro j _ hj0; simp only [reservoirFlatSurface]; split_ifs <;> omega,
    hcap, by omega, by decide,
    by simp [reservoirFlatSurface], by simp [reservoirFlatSurface],
    by simp [reservoirFlatSurface], by simp [reservoirFlatSurface],
    by simp [reservoirFlatSurface], by simp [reservoirFlatSurface],
    by simp [reservoirFlatSurface], by simp [reservoirFlatSurface]⟩

/-- **The canonical S and Z reset surface is an S/Z phase shape** (the re-entry a valley reset
targets). The concrete `reservoirSZSurface base` (reserved well at column `0`, shared width-4
valley `(base+1, base, base, base+1)` at columns `1 .. 4`, flat shelf at `base` elsewhere) is, on
the standard board, an `IsSZPhaseReservoirAtS s base` witness at valley `vc = 1` and disjoint flat
pocket `pc = 5 .. 8`. The valley lips sit at `base + 1`, so the band needs one unit of buffer
(`1 ≤ s`) for them to fit inside `[base, base + s]`; with `base + s ≤ rows` the surface is a valid
S/Z phase shape. The staircase-phase counterpart of `isFlatPhaseReservoirAtS_reservoirFlatSurface`:
it lets any reset that re-establishes the shared valley re-enter `bandPhaseReservoirS` via
`bandPhaseReservoirS_of_SZ`. -/
theorem isSZPhaseReservoirAtS_reservoirSZSurface {s base : ℕ}
    (hs : 1 ≤ s) (hcap : base + s ≤ GameConfig.standard.rows) :
    IsSZPhaseReservoirAtS s base
      (Board.skyline GameConfig.standard (reservoirSZSurface base)) :=
  ⟨reservoirSZSurface base, 1, 5, rfl,
    by simp [reservoirSZSurface],
    by intro j _ hj0; simp only [reservoirSZSurface]; split_ifs <;> omega,
    hcap, by omega, by omega, by decide,
    by simp [reservoirSZSurface], by simp [reservoirSZSurface],
    by simp [reservoirSZSurface], by simp [reservoirSZSurface],
    by simp [reservoirSZSurface], by simp [reservoirSZSurface],
    by simp [reservoirSZSurface], by simp [reservoirSZSurface]⟩

/-- **The bag-phase-aware reservoir carrier.** The strong companion to `reservoirCarrier`: rather
than an arbitrary spread-`2` band at floor `base`, the board must be the SHAPED surface its bag
phase demands — a flat phase shape (`IsFlatPhaseReservoirAt`, well plus width-eight run) or a
staircase
phase shape (`IsSZPhaseReservoirAt`, well plus shared valley plus pocket), under the same reservoir
ledger `base + T.card + 1 ≤ rows` — AND, whenever the bag owes no staircase (`¬(S ∈ T ∨ Z ∈ T)`),
the board must specifically be the flat phase shape. The phase implication is exactly what dodges
the
ten-column budget obstruction (`well + flat-run + S-notch + Z-notch = 11 > 10`): the valley is
carried only while a staircase is still owed, so no single surface ever has to host all seven pieces
at once. This is the band-vocabulary mirror of `bagPhaseCarrier`, with the floor ledger making the
once-per-bag I-drain accountable. The `init` and `height` faces are immediate; the genuine remaining
content is the phase-routed `hstep` closure (`#66`). -/
def bandPhaseReservoir (T : Bag) (b : Board) : Prop :=
  ∃ base : ℕ,
    base + T.card + 1 ≤ GameConfig.standard.rows ∧
    (IsFlatPhaseReservoirAt base b ∨ IsSZPhaseReservoirAt base b) ∧
    (¬(Piece.S ∈ T ∨ Piece.Z ∈ T) → IsFlatPhaseReservoirAt base b)

/-- **The bag-phase carrier is height-bounded** (the `hheight` obligation). Either phase shape
forgets to a spread-`2` level pocket band at the same floor `base`
(`isLevelPocketBandAt_of_isFlatPhaseReservoirAt` / `isLevelPocketBandAt_of_isSZPhaseReservoirAt`),
which is an `IsBoundedPocketBandCarrier 2` witness whose height cap bounds every column by `rows`.
So loss is ruled out for free in every bag phase, exactly as for the weak reservoir carrier. -/
theorem bandPhaseReservoir_height (T : Bag) (b : Board) (hb : bandPhaseReservoir T b) (j : ℕ) :
    Board.colHeight b j ≤ GameConfig.standard.rows := by
  obtain ⟨base, _, hphase, _⟩ := hb
  have hband : Board.IsLevelPocketBandAt GameConfig.standard 2 base b := by
    rcases hphase with hf | hsz
    · exact isLevelPocketBandAt_of_isFlatPhaseReservoirAt hf
    · exact isLevelPocketBandAt_of_isSZPhaseReservoirAt hsz
  have hbpc : Board.IsBoundedPocketBandCarrier 2 b := ⟨base, hband⟩
  exact Board.isBoundedPocketBandCarrier_height hbpc j

/-- **`init` lands in the bag-phase carrier** (the `hinit` obligation). The empty board is the
floor-`0` flat phase shape: the zero skyline (`skyline_zero_eq_empty`) with a width-eight flat run
at columns `1 .. 8`, all heights `0`, well at column `0`, and slack `0 + 2 ≤ 20`. The full bag owes
both staircases (`Bag.mem_full`), so the flat-phase implication is non-vacuously satisfied by the
very same flat witness, and the ledger reads `0 + 7 + 1 = 8 ≤ 20` (`Bag.full_card`). Mirrors
`bagPhaseCarrier_init` in band vocabulary. -/
theorem bandPhaseReservoir_init : bandPhaseReservoir Bag.full Board.empty := by
  have hflat : IsFlatPhaseReservoirAt 0 Board.empty := by
    refine ⟨fun _ => 0, 1, (Board.skyline_zero_eq_empty GameConfig.standard).symm, rfl, ?_, ?_,
      ?_, ?_, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩
    · intro j _ _; simp
    · decide
    · decide
    · decide
  exact ⟨0, by rw [Bag.full_card]; decide, Or.inl hflat, fun _ => hflat⟩

/-- **The phase-indexed-spread bag-phase carrier.** The spread-parametric upgrade of
`bandPhaseReservoir`: rather than pinning the buffer at `2`, the carrier existentially holds a
buffer `s` and a floor `base` with the ledger `base + s + T.card + 1 ≤ rows`, presenting the
spread-`s` flat or staircase shape its bag phase demands. Existentially quantifying `s` lets the
buffer GROW as the bag drains (the adversary may withhold the I until six non-I pieces have raised
the working columns to `base + 3`, which the fixed `+2` shape cannot host), while the ledger keeps
`base + s` plus headroom for the `T.card` pieces still owed under the ceiling. The phase implication
`¬owes-S/Z → flat phase` is what dodges the ten-column budget obstruction: the valley is carried
only while a staircase is still owed. Mirrors `bandPhaseReservoir` at every buffer. -/
def bandPhaseReservoirS (T : Bag) (b : Board) : Prop :=
  ∃ (base s : ℕ),
    base + s + T.card + 1 ≤ GameConfig.standard.rows ∧
    (IsFlatPhaseReservoirAtS s base b ∨ IsSZPhaseReservoirAtS s base b) ∧
    (¬(Piece.S ∈ T ∨ Piece.Z ∈ T) → IsFlatPhaseReservoirAtS s base b)

/-- **The phase-indexed carrier is height-bounded** (the `hheight` obligation). Whatever buffer `s`
the witness holds, either phase shape forgets to a spread-`s` level pocket band at floor `base`
(`isLevelPocketBandAt_of_isFlatPhaseReservoirAtS` / `isLevelPocketBandAt_of_isSZPhaseReservoirAtS`),
an `IsBoundedPocketBandCarrier s` witness whose height cap bounds every column by `rows`. So loss is
ruled out for free at every buffer, exactly as for the fixed spread-`2` carrier. -/
theorem bandPhaseReservoirS_height (T : Bag) (b : Board) (hb : bandPhaseReservoirS T b) (j : ℕ) :
    Board.colHeight b j ≤ GameConfig.standard.rows := by
  obtain ⟨base, s, _, hphase, _⟩ := hb
  have hband : Board.IsLevelPocketBandAt GameConfig.standard s base b := by
    rcases hphase with hf | hsz
    · exact isLevelPocketBandAt_of_isFlatPhaseReservoirAtS hf
    · exact isLevelPocketBandAt_of_isSZPhaseReservoirAtS hsz
  have hbpc : Board.IsBoundedPocketBandCarrier s b := ⟨base, hband⟩
  exact Board.isBoundedPocketBandCarrier_height hbpc j

/-- **`init` lands in the phase-indexed carrier** (the `hinit` obligation). The empty board is the
floor-`0`, buffer-`0` flat phase shape: the zero skyline with a width-eight flat run at columns
`1 .. 8`, all heights `0`, well at column `0`, and slack `0 + 0 ≤ 20`. The full bag owes both
staircases so the flat-phase implication is non-vacuously satisfied by the same flat witness, and
the ledger reads `0 + 0 + 7 + 1 = 8 ≤ 20` (`Bag.full_card`). The empty board needs no buffer, so
`s = 0` suffices; subsequent fills will enlarge `s` as pieces accumulate. -/
theorem bandPhaseReservoirS_init : bandPhaseReservoirS Bag.full Board.empty := by
  have hflat : IsFlatPhaseReservoirAtS 0 0 Board.empty := by
    refine ⟨fun _ => 0, 1, (Board.skyline_zero_eq_empty GameConfig.standard).symm, rfl, ?_, ?_,
      ?_, ?_, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩
    · intro j _ _; simp
    · decide
    · decide
    · decide
  exact ⟨0, 0, by rw [Bag.full_card]; decide, Or.inl hflat, fun _ => hflat⟩

/-- **Smart constructor: a flat phase shape is always a carrier state.** A flat-phase reservoir at
buffer `s`, floor `base` satisfies the carrier unconditionally: the active disjunct is the flat one
(`Or.inl`), and the "no staircase owed implies flat" obligation is discharged by the very same flat
witness regardless of what `T` owes. The only side condition is the ledger
`base + s + T.card + 1 ≤ rows`. This is the introduction door every flat fill and the I-drain land
through. -/
theorem bandPhaseReservoirS_of_flat {T : Bag} {b : Board} {base s : ℕ}
    (hflat : IsFlatPhaseReservoirAtS s base b)
    (hledger : base + s + T.card + 1 ≤ GameConfig.standard.rows) :
    bandPhaseReservoirS T b :=
  ⟨base, s, hledger, Or.inl hflat, fun _ => hflat⟩

/-- **Smart constructor: an S/Z phase shape is a carrier state when a staircase is owed.** An
S/Z-phase reservoir at buffer `s`, floor `base` satisfies the carrier provided `S ∈ T ∨ Z ∈ T`: the
active disjunct is the S/Z one (`Or.inr`), and the "no staircase owed implies flat" obligation is
vacuous because the hypothesis contradicts `howes` (`absurd howes hno`). Side condition: the ledger
`base + s + T.card + 1 ≤ rows`. This is the introduction door the S/Z valley fill lands through,
carrying the reserved valley only while a staircase remains owed. -/
theorem bandPhaseReservoirS_of_SZ {T : Bag} {b : Board} {base s : ℕ}
    (hsz : IsSZPhaseReservoirAtS s base b)
    (howes : Piece.S ∈ T ∨ Piece.Z ∈ T)
    (hledger : base + s + T.card + 1 ≤ GameConfig.standard.rows) :
    bandPhaseReservoirS T b :=
  ⟨base, s, hledger, Or.inr hsz, fun hno => absurd howes hno⟩

/-- **The carrier's `I`-piece transition from a flat phase, non-emptying case.** The first concrete
fragment of the carrier closure: it discharges the `p = Piece.I` branch of both flat edges
(`flat_no_sz_edge` and `flat_owes_edge`) whenever the drawn `I` is *not* the bag's last piece. The
placement is the vertical `I` in the reserved well at column `0`; its landing is a flat phase shape at
floor `base - 4` (`isFlatPhaseReservoirAtS_full_drain`, valid because `base ≥ 4`), which re-enters the
carrier through `bandPhaseReservoirS_of_flat` — the flat disjunct serves both the `(flat ∨ SZ)` slot
and the `¬owes → flat` slot for free. The ledger closes cleanly: with at least two pieces in the bag
the draw simply decrements (`Bag.card_draw_of_ge_two`), so
`(base - 4) + s + (T.draw I).card + 1 = base + s + T.card - 4 ≤ rows`, comfortably under the ceiling.
The single remaining `I`-case obligation is the *emptying* draw — when the `I` is the bag's last piece
and the next bag refills to seven, the destination clock jumps by six while the floor only drops by
four, the genuine `+2` bag-boundary ledger gap that the spread `s` must be sized to absorb. -/
theorem bandPhaseReservoirS_flat_vertI_drain_step {T : Bag} {b : Board} {base s : ℕ}
    (hflat : IsFlatPhaseReservoirAtS s base b)
    (hI : Piece.I ∈ T) (hcard : 2 ≤ T.card) (hbase4 : 4 ≤ base)
    (hledger : base + s + T.card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = Piece.I ∧ pl.Valid GameConfig.standard ∧
      bandPhaseReservoirS (T.draw Piece.I)
        (Placement.applyStep GameConfig.standard b { pl with piece := Piece.I }) := by
  refine ⟨{ piece := Piece.I, rot := 1, col := 0 }, rfl, Board.valid_vertI (by decide), ?_⟩
  refine bandPhaseReservoirS_of_flat (isFlatPhaseReservoirAtS_full_drain hflat hbase4) ?_
  rw [Bag.card_draw_of_ge_two hI hcard]; omega

/-- **Carrier-level I-drain from the S/Z phase, non-emptying case** (the SZ-edge `p = I` branch).
Mirror of `bandPhaseReservoirS_flat_vertI_drain_step` for the staircase phase: the guaranteed
well-`I` regulator drops the floor by four (`isSZPhaseReservoirAtS_full_drain`, valid because
`base ≥ 4`), re-entering the carrier via `bandPhaseReservoirS_of_SZ`. Drawing the `I` is
non-emptying (`2 ≤ T.card`), so it merely erases `I` (`draw_eq_erase_of_card_ge_two`); the still-owed
staircase debt `S`/`Z` survives the erase (`S ≠ I`, `Z ≠ I`), keeping the S/Z disjunct legitimate.
The ledger closes cleanly: `(base - 4) + s + (T.card - 1) + 1 = base + s + T.card - 4 ≤ rows`. This
discharges the `p = I` branch of `sz_edge` in the non-emptying regime. -/
theorem bandPhaseReservoirS_SZ_vertI_drain_step {T : Bag} {b : Board} {base s : ℕ}
    (hsz : IsSZPhaseReservoirAtS s base b)
    (hI : Piece.I ∈ T) (howes : Piece.S ∈ T ∨ Piece.Z ∈ T)
    (hcard : 2 ≤ T.card) (hbase4 : 4 ≤ base)
    (hledger : base + s + T.card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = Piece.I ∧ pl.Valid GameConfig.standard ∧
      bandPhaseReservoirS (T.draw Piece.I)
        (Placement.applyStep GameConfig.standard b { pl with piece := Piece.I }) := by
  refine ⟨{ piece := Piece.I, rot := 1, col := 0 }, rfl, Board.valid_vertI (by decide), ?_⟩
  have howes' : Piece.S ∈ T.draw Piece.I ∨ Piece.Z ∈ T.draw Piece.I := by
    rw [Bag.draw_eq_erase_of_card_ge_two hI hcard]
    rcases howes with hS | hZ
    · exact Or.inl (Finset.mem_erase.mpr ⟨by decide, hS⟩)
    · exact Or.inr (Finset.mem_erase.mpr ⟨by decide, hZ⟩)
  refine bandPhaseReservoirS_of_SZ (isSZPhaseReservoirAtS_full_drain hsz hbase4) howes' ?_
  rw [Bag.card_draw_of_ge_two hI hcard]; omega

/-- **Carrier-level I-drain from the flat phase, the *emptying* case** (the bag-boundary companion to
`bandPhaseReservoirS_flat_vertI_drain_step`). When the drawn `I` is the bag's LAST piece, the draw
refills to seven (`T.draw Piece.I = Bag.full`). The well-`I` regulator still drops the floor by four
(`isFlatPhaseReservoirAtS_full_drain`, valid because `base ≥ 4`) and re-enters the carrier through
`bandPhaseReservoirS_of_flat` — but now against the refilled seven-piece bag, so the destination
ledger is `(base - 4) + s + 7 + 1 ≤ rows`, i.e. `base + s + 4 ≤ rows`. That is strictly TWO units
tighter than the singleton source ledger `base + s + 1 + 1 ≤ rows` (`T.card = 1`): the floor drops
by four while the bag clock jumps by six, the genuine `+2` bag-boundary gap the buffer `s` must be
sized to absorb. So the emptying drain closes precisely when the band carries that extra slack —
the concrete arithmetic face of the once-per-bag reset, completing the flat edge's `p = I` taxonomy
alongside the non-emptying step. -/
theorem bandPhaseReservoirS_flat_vertI_drain_emptying_step {T : Bag} {b : Board} {base s : ℕ}
    (hflat : IsFlatPhaseReservoirAtS s base b)
    (hempty : T.draw Piece.I = Bag.full)
    (hbase4 : 4 ≤ base)
    (hslack : base + s + 4 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = Piece.I ∧ pl.Valid GameConfig.standard ∧
      bandPhaseReservoirS (T.draw Piece.I)
        (Placement.applyStep GameConfig.standard b { pl with piece := Piece.I }) := by
  refine ⟨{ piece := Piece.I, rot := 1, col := 0 }, rfl, Board.valid_vertI (by decide), ?_⟩
  refine bandPhaseReservoirS_of_flat (isFlatPhaseReservoirAtS_full_drain hflat hbase4) ?_
  rw [hempty, Bag.full_card]; omega

/-- **The once-per-bag cycle re-enters the carrier at the flat reset surface** (the drain to flat
phase re-entry). Folding the full raise then drain cycle over the canonical flat reset surface
`reservoirFlatSurface base` returns, by the board fixed-point identity `foldl_cycle_eq_flatShelf`,
to that very same surface — which is a flat phase shape
(`isFlatPhaseReservoirAtS_reservoirFlatSurface`), so `bandPhaseReservoirS_of_flat` re-enters the
phase carrier for any remaining bag `T` under the ledger `base + s + T.card + 1 ≤ rows`.
This is the structural half of the re-entry gap: the I-drain endpoint is literally the canonical
surface (the flat shelf `fun j => if j = 0 then 0 else base` is definitionally
`reservoirFlatSurface base`), so the cycle is carrier-closed at the reset surface, with no height
accumulation across passes. -/
theorem bandPhaseReservoirS_foldl_cycle {T : Bag} {base s : ℕ}
    (hledger : base + s + T.card + 1 ≤ GameConfig.standard.rows) :
    bandPhaseReservoirS T
        (List.foldl (Placement.applyStep GameConfig.standard)
            (Board.skyline GameConfig.standard (reservoirFlatSurface base))
            ((((List.replicate 2 { piece := Piece.O, rot := 0, col := 1 } ++
                List.replicate 2 { piece := Piece.O, rot := 0, col := 3 } ++
                List.replicate 2 { piece := Piece.O, rot := 0, col := 5 }) ++
               (List.replicate 1 { piece := Piece.I, rot := 1, col := 7 } ++
                List.replicate 1 { piece := Piece.I, rot := 1, col := 8 } ++
                List.replicate 1 { piece := Piece.I, rot := 1, col := 9 })) ++
              [{ piece := Piece.I, rot := 1, col := 0 }] : List Placement))) := by
  have hfix : List.foldl (Placement.applyStep GameConfig.standard)
      (Board.skyline GameConfig.standard (reservoirFlatSurface base))
      ((((List.replicate 2 { piece := Piece.O, rot := 0, col := 1 } ++
          List.replicate 2 { piece := Piece.O, rot := 0, col := 3 } ++
          List.replicate 2 { piece := Piece.O, rot := 0, col := 5 }) ++
         (List.replicate 1 { piece := Piece.I, rot := 1, col := 7 } ++
          List.replicate 1 { piece := Piece.I, rot := 1, col := 8 } ++
          List.replicate 1 { piece := Piece.I, rot := 1, col := 9 })) ++
        [{ piece := Piece.I, rot := 1, col := 0 }] : List Placement))
      = Board.skyline GameConfig.standard (reservoirFlatSurface base) := by
    simpa only [reservoirFlatSurface] using Board.foldl_cycle_eq_flatShelf (base := base)
  rw [hfix]
  exact bandPhaseReservoirS_of_flat
    (isFlatPhaseReservoirAtS_reservoirFlatSurface (by omega)) hledger

/-- **The per-phase canonical reset surface re-enters the carrier.** At any bag phase `T`, the
canonical reset surface the regulator targets — the SZ valley surface `reservoirSZSurface base` when
a staircase is still owed (`S ∈ T ∨ Z ∈ T`), the flat surface `reservoirFlatSurface base` otherwise
— is a `bandPhaseReservoirS T` state, under buffer `1 ≤ s` and the ledger
`base + s + T.card + 1 ≤ rows`. Excluded middle on the owed status selects the matching iter309
bridge and smart constructor for that phase. This is the bag-boundary re-entry target: a strategy
that drains to (or re-establishes) the phase-correct reset surface lands back in the carrier for the
next phase, the companion to the cycle re-entry `bandPhaseReservoirS_foldl_cycle`. -/
theorem bandPhaseReservoirS_resetSurface {T : Bag} {base s : ℕ}
    (hs : 1 ≤ s)
    (hledger : base + s + T.card + 1 ≤ GameConfig.standard.rows) :
    bandPhaseReservoirS T
      (if Piece.S ∈ T ∨ Piece.Z ∈ T
        then Board.skyline GameConfig.standard (reservoirSZSurface base)
        else Board.skyline GameConfig.standard (reservoirFlatSurface base)) := by
  by_cases howes : Piece.S ∈ T ∨ Piece.Z ∈ T
  · rw [if_pos howes]
    exact bandPhaseReservoirS_of_SZ
      (isSZPhaseReservoirAtS_reservoirSZSurface hs (by omega)) howes hledger
  · rw [if_neg howes]
    exact bandPhaseReservoirS_of_flat
      (isFlatPhaseReservoirAtS_reservoirFlatSurface (by omega)) hledger

/-- **The strict phase-indexed carrier** — the steady-state target. Unlike the inclusive
`bandPhaseReservoirS` (whose phase disjunct allows a flat shape even while a staircase is owed),
the strict carrier pins the phase to the owed-staircase status by TWO implications:

* whenever `S ∈ T ∨ Z ∈ T`, the surface is the S/Z phase shape (shared valley present); and
* whenever neither is owed, the surface is the flat phase shape.

This is the carrier whose per-phase hstep edges are actually dischargeable in steady state: the
flat phase is reached only when no staircase is owed, so its hstep never has to host an `S`/`Z` on
a flat run (which would leave a hole) — and the S/Z phase carries the shared valley that hosts both
staircase pieces AND, alongside a 4-wide pocket and the reserved well, every flat piece and the
I-drain, all within the ten-column budget (`well 1 + valley 4 + pocket 4 = 9 ≤ 10`,
`isLevelPocketBandAt_valley_hosts_SZ_valid`). The empty board is NOT a strict-carrier state with a
full bag (it is flat but the full bag owes `S`/`Z`), so the strict carrier is the *reachable*
steady-state invariant, reached after the empty-board bootstrap establishes the first valley. -/
def bandPhaseReservoirSStrict (T : Bag) (b : Board) : Prop :=
  ∃ (base s : ℕ),
    base + s + T.card + 1 ≤ GameConfig.standard.rows ∧
    ((Piece.S ∈ T ∨ Piece.Z ∈ T) → IsSZPhaseReservoirAtS s base b) ∧
    (¬(Piece.S ∈ T ∨ Piece.Z ∈ T) → IsFlatPhaseReservoirAtS s base b)

/-- **The strict carrier refines the inclusive carrier.** Excluded middle on the owed-staircase
status selects exactly one implication of the strict witness, supplying the concrete phase shape
the inclusive carrier's disjunct needs (`Or.inr` when owed, `Or.inl` when not), while the inclusive
"no staircase owed implies flat" clause is the strict carrier's own flat implication verbatim. So
every strict-carrier board is an inclusive-carrier board, and all inclusive machinery (height face,
front door, hstep router) applies to the strict carrier for free. -/
theorem bandPhaseReservoirS_of_strict {T : Bag} {b : Board}
    (h : bandPhaseReservoirSStrict T b) : bandPhaseReservoirS T b := by
  obtain ⟨base, s, hledger, hsz, hflat⟩ := h
  refine ⟨base, s, hledger, ?_, hflat⟩
  by_cases howes : Piece.S ∈ T ∨ Piece.Z ∈ T
  · exact Or.inr (hsz howes)
  · exact Or.inl (hflat howes)

/-- **The strict carrier is height-bounded** (its `hheight` face), inherited through the refinement
`bandPhaseReservoirS_of_strict` and the inclusive carrier's height face. -/
theorem bandPhaseReservoirSStrict_height (T : Bag) (b : Board)
    (hb : bandPhaseReservoirSStrict T b) (j : ℕ) :
    Board.colHeight b j ≤ GameConfig.standard.rows :=
  bandPhaseReservoirS_height T b (bandPhaseReservoirS_of_strict hb) j

/-- **The bag-phase carrier refines the weak reservoir carrier** (strong to weak). Either phase
shape forgets to a spread-`2` level pocket band at the same floor `base`, and the bag-phase ledger
`base + T.card + 1 ≤ rows` is the weak carrier's ledger, so `reservoirCarrier_of_band_ledger`
packages the pair into a `reservoirCarrier T b`. This lets the strong carrier inherit every
drain and fill edge already proven for the weak reservoir carrier. -/
theorem reservoirCarrier_of_bandPhaseReservoir {T : Bag} {b : Board}
    (hb : bandPhaseReservoir T b) : reservoirCarrier T b := by
  obtain ⟨base, hledger, hphase, _⟩ := hb
  have hband : Board.IsLevelPocketBandAt GameConfig.standard 2 base b := by
    rcases hphase with hf | hsz
    · exact isLevelPocketBandAt_of_isFlatPhaseReservoirAt hf
    · exact isLevelPocketBandAt_of_isSZPhaseReservoirAt hsz
  exact reservoirCarrier_of_band_ledger hband hledger

/-- **Strong-carrier front door**: a single bag-phase closure step proves the atlas exists. Feeds
the bag-phase `init`/`height` faces and the supplied `hstep` into the bag-indexed reduction
`tetrisSolvableValid_of_bag_indexed_invariant`. The remaining genuine content (`#66`) is exactly
`hstep`: for every bag phase and every owed piece, produce a valid placement that lands back in a
bag-phase shape one piece further through the bag. -/
theorem tetrisSolvableValid_of_bandPhaseReservoir_closed
    (hstep : ∀ (T : Bag) (b : Board), bandPhaseReservoir T b → ∀ p, p ∈ T →
      ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
        bandPhaseReservoir (T.draw p)
          (Placement.applyStep GameConfig.standard b { pl with piece := p })) :
    TetrisSolvableValid :=
  tetrisSolvableValid_of_bag_indexed_invariant
    bandPhaseReservoir bandPhaseReservoir_init bandPhaseReservoir_height hstep

/-- **Phase-indexed-spread front door**: a single phase-indexed closure step proves the atlas
exists. The spread-parametric upgrade of `tetrisSolvableValid_of_bandPhaseReservoir_closed`: feeds
the `bandPhaseReservoirS` `init`/`height` faces and the supplied `hstep` into the bag-indexed
reduction. This is the primary route to the goal, because the carrier's existential buffer `s` is
what lets `hstep` succeed when the adversary withholds the I until six non-I pieces have raised the
working columns past `base + 2` — the fixed spread-`2` front door cannot express that intermediate
surface. The remaining genuine content (`#66`) is exactly this `hstep`: for every bag phase and
every owed piece, a valid placement landing back in a phase shape one piece further through the bag,
with the buffer enlarged to absorb the new piece and reset on the once-per-bag I-drain. -/
theorem tetrisSolvableValid_of_bandPhaseReservoirS_closed
    (hstep : ∀ (T : Bag) (b : Board), bandPhaseReservoirS T b → ∀ p, p ∈ T →
      ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
        bandPhaseReservoirS (T.draw p)
          (Placement.applyStep GameConfig.standard b { pl with piece := p })) :
    TetrisSolvableValid :=
  tetrisSolvableValid_of_bag_indexed_invariant
    bandPhaseReservoirS bandPhaseReservoirS_init bandPhaseReservoirS_height hstep

/-- **hstep router: the carrier closes if two per-phase edges hold.** This splits the monolithic
`hstep` obligation of `tetrisSolvableValid_of_bandPhaseReservoirS_closed` into two named edge
obligations, one per phase of the carrier witness:

* `flat_edge` — from a flat phase shape `IsFlatPhaseReservoirAtS s base b` (with the ledger), every
  owed piece `p` has a valid placement re-entering the carrier. This is the workhorse: it must host
  the five flat pieces by widening the buffer and host the I as the regulator drain.
* `sz_edge` — from an S/Z phase shape `IsSZPhaseReservoirAtS s base b`, *when a staircase is still
  owed* (`S ∈ T ∨ Z ∈ T`), every owed piece `p` has a valid placement re-entering the carrier. The
  owed hypothesis is what lets the witness legitimately carry the reserved valley.

The router discharges the carrier's three-part witness by case analysis: a flat disjunct routes to
`flat_edge`; an S/Z disjunct routes to `sz_edge` when a staircase is owed, otherwise the witness'
own "no staircase owed implies flat" clause (`hflat_imp`) hands back a flat shape that routes to
`flat_edge`. So the whole goal `TetrisSolvableValid` reduces to these two edges — the genuine
remaining content of `#66`, now cleanly separated by phase. -/
theorem tetrisSolvableValid_of_bandPhaseReservoirS_edges
    (flat_edge : ∀ (T : Bag) (b : Board) (base s : ℕ),
        IsFlatPhaseReservoirAtS s base b →
        base + s + T.card + 1 ≤ GameConfig.standard.rows →
        ∀ p, p ∈ T → ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
          bandPhaseReservoirS (T.draw p)
            (Placement.applyStep GameConfig.standard b { pl with piece := p }))
    (sz_edge : ∀ (T : Bag) (b : Board) (base s : ℕ),
        IsSZPhaseReservoirAtS s base b →
        (Piece.S ∈ T ∨ Piece.Z ∈ T) →
        base + s + T.card + 1 ≤ GameConfig.standard.rows →
        ∀ p, p ∈ T → ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
          bandPhaseReservoirS (T.draw p)
            (Placement.applyStep GameConfig.standard b { pl with piece := p })) :
    TetrisSolvableValid := by
  apply tetrisSolvableValid_of_bandPhaseReservoirS_closed
  intro T b hb p hp
  obtain ⟨base, s, hledger, hphase, hflat_imp⟩ := hb
  rcases hphase with hflat | hsz
  · exact flat_edge T b base s hflat hledger p hp
  · by_cases howes : Piece.S ∈ T ∨ Piece.Z ∈ T
    · exact sz_edge T b base s hsz howes hledger p hp
    · exact flat_edge T b base s (hflat_imp howes) hledger p hp

/-- **Flat-edge split: separate the hole-free flat fill from the bootstrap hole risk.** The
`flat_edge` of `tetrisSolvableValid_of_bandPhaseReservoirS_edges` must service a flat phase shape
under *any* bag — including a bag that still owes a staircase. Those two regimes have very different
geometry, so this router splits the single flat edge into the two edges it really is:

* `flat_no_sz_edge` — the **steady-state** flat fill: the bag owes no staircase
  (`¬(S ∈ T ∨ Z ∈ T)`), so every owed piece is one of the five flats
  (`mem_flatShelf_pieces_of_no_SZ`) and lands cleanly into the wide pocket. No `S` or `Z` is ever
  dropped onto a flat run (the one move that would punch a hole), so this edge is hole-free. This is
  the workhorse the once-per-bag drain keeps regenerating room for.
* `flat_owes_edge` — the **bootstrap** flat fill: a flat surface while the bag still owes `S`/`Z`
  (the empty board with a full bag is exactly this state). Here the adversary may draw the staircase
  piece onto a flat run, leaving a transient hole that a first-bag line clear must remove.
  Discharging this edge is the genuine open bootstrap obligation, isolated here away from the
  steady-state edges.

Routing the parent `flat_edge` to whichever sub-edge the owed-staircase status selects discharges
it, so `TetrisSolvableValid` now reduces to three edges: two hole-free (steady state) plus the
quarantined bootstrap. -/
theorem tetrisSolvableValid_of_bandPhaseReservoirS_edges_split
    (flat_no_sz_edge : ∀ (T : Bag) (b : Board) (base s : ℕ),
        IsFlatPhaseReservoirAtS s base b →
        ¬(Piece.S ∈ T ∨ Piece.Z ∈ T) →
        base + s + T.card + 1 ≤ GameConfig.standard.rows →
        ∀ p, p ∈ T → ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
          bandPhaseReservoirS (T.draw p)
            (Placement.applyStep GameConfig.standard b { pl with piece := p }))
    (flat_owes_edge : ∀ (T : Bag) (b : Board) (base s : ℕ),
        IsFlatPhaseReservoirAtS s base b →
        (Piece.S ∈ T ∨ Piece.Z ∈ T) →
        base + s + T.card + 1 ≤ GameConfig.standard.rows →
        ∀ p, p ∈ T → ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
          bandPhaseReservoirS (T.draw p)
            (Placement.applyStep GameConfig.standard b { pl with piece := p }))
    (sz_edge : ∀ (T : Bag) (b : Board) (base s : ℕ),
        IsSZPhaseReservoirAtS s base b →
        (Piece.S ∈ T ∨ Piece.Z ∈ T) →
        base + s + T.card + 1 ≤ GameConfig.standard.rows →
        ∀ p, p ∈ T → ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
          bandPhaseReservoirS (T.draw p)
            (Placement.applyStep GameConfig.standard b { pl with piece := p })) :
    TetrisSolvableValid := by
  apply tetrisSolvableValid_of_bandPhaseReservoirS_edges
  · intro T b base s hflat hledger p hp
    by_cases howes : Piece.S ∈ T ∨ Piece.Z ∈ T
    · exact flat_owes_edge T b base s hflat howes hledger p hp
    · exact flat_no_sz_edge T b base s hflat howes hledger p hp
  · exact sz_edge

/-- **The spread-band reservoir carrier.** The bag-phase-indexed carrier built on the floor-pinned
spread band `IsSpreadBoundedRWSkylineAt` rather than the pocket band `IsLevelPocketBandAt`. The two
ledger conjuncts mirror `reservoirCarrier`'s exactly — a band floor `base`, a spread `s`, and the
headroom budget `base + s + T.card + 1 ≤ rows` keyed to the bag clock — but the band requirement is
the *pocket-less* one: a floor-pinned band with a reserved empty well and no width-four pocket. This
is the exact shape a non-`I` fill *lands in* (the fill arcs consume the input pocket and emit a
floor-pinned spread band at the same floor), so unlike the phase-shape carriers — whose width-eight
run and valley-plus-pocket landing shapes no post-fill board retains — the spread-band carrier is
closed under its own fills. The `init` and `height` faces are immediate; the genuine remaining
content is the per-bag closure, where the gap shrinks from "regenerate a wide run or valley" to the
strictly local "a flat-`2` site exists for a flat and a valley site exists for a staircase", with the
once-per-bag I drain (`isSpreadBoundedRWSkyline_vertI_well_descend`) supplying the regulator. -/
def reservoirSpreadCarrier (T : Bag) (b : Board) : Prop :=
  ∃ base s : ℕ,
    Board.IsSpreadBoundedRWSkylineAt GameConfig.standard s base b ∧
    base + s + T.card + 1 ≤ GameConfig.standard.rows

/-- **`init` lands in the spread-band carrier** (the `hinit` obligation). The empty board is a
floor-`0` level pocket band at spread `2` (`isLevelPocketBandAt_empty`), which forgets to a
floor-pinned spread-`2` band (`isSpreadBoundedRWSkylineAt_of_isLevelPocketBandAt`); the ledger reads
`0 + 2 + 7 + 1 = 10 ≤ 20` on the full bag (`Bag.full_card`). -/
theorem reservoirSpreadCarrier_init : reservoirSpreadCarrier Bag.full Board.empty := by
  refine ⟨0, 2, Board.isSpreadBoundedRWSkylineAt_of_isLevelPocketBandAt
    (Board.isLevelPocketBandAt_empty GameConfig.standard (by decide) (by decide)), ?_⟩
  rw [Bag.full_card]; decide

/-- **The spread-band carrier is height-bounded** (the `hheight` obligation). The floor-pinned
band-top cap `colHeight_le_of_isSpreadBoundedRWSkylineAt` bounds every column by `base + s`, and the
ledger gives `base + s ≤ rows`, so loss is ruled out for free in every bag phase. -/
theorem reservoirSpreadCarrier_height (T : Bag) (b : Board) (h : reservoirSpreadCarrier T b)
    (j : ℕ) : Board.colHeight b j ≤ GameConfig.standard.rows := by
  obtain ⟨base, s, hband, hledger⟩ := h
  have hcol := Board.colHeight_le_of_isSpreadBoundedRWSkylineAt hband j
  omega

/-- **The phase carrier forgets to the spread-band carrier** (the spread-vocabulary mirror of
`reservoirCarrier_of_bandPhaseReservoir`). Every `bandPhaseReservoirS T b` board carries a concrete
bag-phase shape — a flat phase shape (well plus width-eight run) or an S/Z phase shape (well plus
shared valley plus pocket) — at some floor `base` and buffer `s`. Either shape forgets to a
spread-`s` level pocket band at the same floor (`isLevelPocketBandAt_of_isFlatPhaseReservoirAtS` /
`isLevelPocketBandAt_of_isSZPhaseReservoirAtS`), which in turn forgets its width-four pocket to a
floor-pinned spread band (`Board.isSpreadBoundedRWSkylineAt_of_isLevelPocketBandAt`). The two
carriers share the *identical* ledger `base + s + T.card + 1 ≤ rows`, so the headroom budget
transports verbatim. This is the structural bridge from the *site-guaranteeing* phase carrier (whose
shapes discharge the spread carrier's open `hsite`, but which no single fill preserves) to the
*closed-under-fill* spread carrier (which survives any fill landing in a band, but whose `hsite` a
bare band leaves open): a strategy can read its surface as either, taking the phase shape to land the
next owed piece and the bare spread band to certify height — so the phase carrier inherits every
spread-carrier height, drain, and survival face for free. -/
theorem reservoirSpreadCarrier_of_bandPhaseReservoirS {T : Bag} {b : Board}
    (hb : bandPhaseReservoirS T b) : reservoirSpreadCarrier T b := by
  obtain ⟨base, s, hledger, hphase, _⟩ := hb
  have hband : Board.IsLevelPocketBandAt GameConfig.standard s base b := by
    rcases hphase with hf | hsz
    · exact isLevelPocketBandAt_of_isFlatPhaseReservoirAtS hf
    · exact isLevelPocketBandAt_of_isSZPhaseReservoirAtS hsz
  exact ⟨base, s, Board.isSpreadBoundedRWSkylineAt_of_isLevelPocketBandAt hband, hledger⟩

/-- **Atlas existence reduces to spread-band-carrier closure.** Instantiating
`tetrisSolvableValid_of_bag_indexed_invariant` at the spread-band carrier and discharging its initial
and height obligations outright (`reservoirSpreadCarrier_init`, `reservoirSpreadCarrier_height`)
collapses the whole `TetrisSolvableValid` verdict onto a single closure hypothesis: from any
spread-band-admissible `(T, b)` and any owed piece `p`, the player has a valid placement of `p` whose
post-move board is again spread-band-admissible under `T.draw p`. Unlike the phase-shape edges this
carrier's landing shape is the very shape its fills emit, so the closure no longer demands an
un-regenerable wide run. -/
theorem tetrisSolvableValid_of_reservoirSpreadCarrier_closed
    (hstep : ∀ (T : Bag) (b : Board), reservoirSpreadCarrier T b → ∀ p, p ∈ T →
      ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
        reservoirSpreadCarrier (T.draw p)
          (Placement.applyStep GameConfig.standard b { pl with piece := p })) :
    TetrisSolvableValid :=
  tetrisSolvableValid_of_bag_indexed_invariant
    reservoirSpreadCarrier
    reservoirSpreadCarrier_init
    reservoirSpreadCarrier_height
    hstep

/-- **The spread-band carrier has not topped out** (the survival face). Every spread-band-admissible
board sits with every column under `rows` (`reservoirSpreadCarrier_height`), so it is not lost
(`not_isLost_of_colHeight_le`). This is the reusable transient-survival primitive a per-bag closure
quotes at every intermediate drop: the height ledger already certifies the endpoint is safe, and this
face turns that column bound into the `¬ isLost` verdict the survival schedule consumes. -/
theorem reservoirSpreadCarrier_not_isLost (T : Bag) (b : Board)
    (h : reservoirSpreadCarrier T b) :
    ¬ Board.isLost GameConfig.standard b :=
  Board.not_isLost_of_colHeight_le (reservoirSpreadCarrier_height T b h)

/-- **The spread-band carrier's `I`-branch: the once-per-bag drain.** The regulator half of the
`reservoirSpreadCarrier` closure, and the spread analogue of `reservoirCarrier_vertI_drain_cap`. On
any floor-pinned spread band whose floor is at least four and whose band top sits at `base + s ≤ 16`,
dropping the vertical `I` into the reserved empty well clears four full rows
(`isSpreadBoundedRWSkylineAt_vertI_well_descend`), lowering the floor to `base - 4` with the spread
unchanged, and re-enters `reservoirSpreadCarrier (T.draw Piece.I)`. The destination ledger holds for
free: the drained band top is `(base - 4) + s = base + s - 4 ≤ 12`, and the destination clock is at
most a full bag (`Bag.card_le_seven`), so `(base - 4) + s + (T.draw I).card + 1 ≤ 12 + 7 + 1 = 20`.
This discharges the entire `I` case of the carrier's per-bag closure, isolating the open content to
the non-`I` fills keeping the band top `≤ 16` until the guaranteed `I` arrives. -/
theorem reservoirSpreadCarrier_vertI_drain_cap {T : Bag} {b : Board} {base s : ℕ}
    (hband : Board.IsSpreadBoundedRWSkylineAt GameConfig.standard s base b)
    (hfloor : 4 ≤ base) (hcap : base + s ≤ 16) :
    ∃ plI : Placement, plI.piece = Piece.I ∧ plI.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw Piece.I)
        (Placement.applyStep GameConfig.standard b plI) := by
  obtain ⟨h, w, rfl, hw, hw0, hband', hslack⟩ := hband
  have hdrain := Board.isSpreadBoundedRWSkylineAt_vertI_well_descend hw hw0 hfloor hband' hslack
  have h7 : (T.draw Piece.I).card ≤ 7 := Bag.card_le_seven _
  have hr : GameConfig.standard.rows = 20 := rfl
  exact ⟨{ piece := Piece.I, rot := 1, col := w }, rfl, Board.valid_vertI hw,
    base - 4, s, hdrain, by omega⟩

/-- **The double-valley reset surface drains into the spread-band carrier.** Specialises the generic
`reservoirSpreadCarrier_vertI_drain_cap` to the concrete two-staircase bag-boundary surface
`reservoirDoubleSZSurface base`: the once-per-bag vertical `I` into the reserved well clears four
rows and lands the drained surface (`reservoirDoubleSZSurface_vertI_well_drain` gives the literal
profile `reservoirDoubleSZSurface (base - 4)`), which the floor-pinned band face
`reservoirDoubleSZSurface_spreadBandAt` repackages as an `IsSpreadBoundedRWSkylineAt standard 2
(base - 4)` member. With the destination ledger `(base - 4) + 2 + (T.draw I).card + 1 ≤ rows` this
re-enters `reservoirSpreadCarrier (T.draw Piece.I)`. This is the regenerator edge stated in the
carrier vocabulary the final reduction consumes: the drain hands a fresh spread-2 band at floor
`base - 4` to the next bag, with the double-valley profile preserved underneath for the staircases
still owed. -/
theorem reservoirDoubleSZSurface_vertI_drain_carrier {T : Bag} {base : ℕ}
    (hbase : 4 ≤ base)
    (hledger : (base - 4) + 2 + (T.draw Piece.I).card + 1 ≤ GameConfig.standard.rows) :
    ∃ plI : Placement, plI.piece = Piece.I ∧ plI.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw Piece.I)
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          plI) := by
  refine ⟨{ piece := Piece.I, rot := 1, col := 0 }, rfl, Board.valid_vertI (by decide), ?_⟩
  rw [reservoirDoubleSZSurface_vertI_well_drain hbase]
  exact ⟨base - 4, 2, reservoirDoubleSZSurface_spreadBandAt (base - 4) (by omega), hledger⟩

/-- **The two-staircase burst exits into the spread-band carrier.** The worst adversary order for the
double-valley surface — `S` immediately followed by `Z`, the order the two reserved valleys exist to
survive — seats `S` in valley1 (`{S, rot 0, col 2}`) and `Z` in valley2 (`{Z, rot 0, col 5}`), and
the post-burst board is a floor-pinned spread-2 band still at floor `base`
(`reservoirDoubleSZSurface_afterSZ_spreadBandAt`: the two staircases fill their disjoint valleys
without raising the floor or exceeding `base + 2`). With the destination ledger
`base + 2 + ((T.draw S).draw Z).card + 1 ≤ rows` this re-enters
`reservoirSpreadCarrier ((T.draw S).draw Z)`. This is the exit edge of the double-valley sub-shape:
once both owed staircases are discharged, the board hands back to the generic spread-band carrier (no
floor rise spent), where the remaining flats and the once-per-bag `I`-drain are handled by the
carrier machinery. It is the structural payoff of reserving two valleys — the killer `S`-then-`Z`
order leaves the carrier ledger exactly where it entered. -/
theorem reservoirDoubleSZSurface_SZ_burst_carrier {T : Bag} {base : ℕ}
    (hledger : base + 2 + ((T.draw Piece.S).draw Piece.Z).card + 1 ≤ GameConfig.standard.rows) :
    reservoirSpreadCarrier ((T.draw Piece.S).draw Piece.Z)
      (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.S, rot := 0, col := 2 })
        { piece := Piece.Z, rot := 0, col := 5 }) :=
  ⟨base, 2, reservoirDoubleSZSurface_afterSZ_spreadBandAt base (by omega), hledger⟩

/-- **The mirror `Z`-then-`S` burst also exits into the spread-band carrier.** The swapped adversary
order — `Z` first (`{Z, rot 0, col 5}` in valley2) then `S` (`{S, rot 0, col 2}` in valley1) — lands
the identical board as `S`-then-`Z` (`reservoirDoubleSZSurface_SZ_comm`: the two staircases write to
disjoint column sets and commute), so the same `afterSZ` spread-2 band face certifies it. With the
destination ledger this re-enters `reservoirSpreadCarrier ((T.draw Z).draw S)`. Together with
`reservoirDoubleSZSurface_SZ_burst_carrier` this discharges BOTH owed-staircase orders into the
carrier at floor `base`, neutralising the adversary's `S`-vs-`Z` ordering choice on the
two-staircase sub-shape: whichever staircase comes first, the board exits to the generic carrier
ledger unchanged. -/
theorem reservoirDoubleSZSurface_ZS_burst_carrier {T : Bag} {base : ℕ}
    (hledger : base + 2 + ((T.draw Piece.Z).draw Piece.S).card + 1 ≤ GameConfig.standard.rows) :
    reservoirSpreadCarrier ((T.draw Piece.Z).draw Piece.S)
      (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.Z, rot := 0, col := 5 })
        { piece := Piece.S, rot := 0, col := 2 }) := by
  rw [← reservoirDoubleSZSurface_SZ_comm base]
  exact ⟨base, 2, reservoirDoubleSZSurface_afterSZ_spreadBandAt base (by omega), hledger⟩

/-- **The lone first staircase exits into the spread carrier.** The single-`S` exit edge of the
double-valley surface, the one-staircase companion of `reservoirDoubleSZSurface_SZ_burst_carrier`
(both staircases at once). When the adversary opens the bag with `S`, seating it in valley1
(`{S, rot 0, col 2}`) leaves a reserved-well spread-2 band at the unchanged floor `base`
(`reservoirDoubleSZSurface_afterS_spreadBandAt`); pairing it with the destination ledger
`base + 2 + (T.draw S).card + 1 ≤ rows` re-enters `reservoirSpreadCarrier (T.draw S)` at zero floor
cost. Where the burst edge discharges both owed staircases together, this hands the bag back to the
generic carrier after just the first, with valley2 still pristine for the owed `Z` — the carrier's
own `reservoirSpreadCarrier_valley_SZ_fill_step` then seats it. Together with the burst and
`O`-interruption exits this rounds out the double-valley surface's first-move menu: `S` first, `Z`
first, both, or a flat `O`, every opening lands on a safe carrier member at the entry floor. -/
theorem reservoirDoubleSZSurface_S_carrier {T : Bag} {base : ℕ}
    (hledger : base + 2 + (T.draw Piece.S).card + 1 ≤ GameConfig.standard.rows) :
    reservoirSpreadCarrier (T.draw Piece.S)
      (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.S, rot := 0, col := 2 }) :=
  ⟨base, 2, reservoirDoubleSZSurface_afterS_spreadBandAt base (by omega), hledger⟩

/-- **The lone second staircase exits into the spread carrier.** The single-`Z` mirror of
`reservoirDoubleSZSurface_S_carrier`. When the adversary opens the bag with `Z`, seating it in
valley2 (`{Z, rot 0, col 5}`) leaves a reserved-well spread-2 band at the unchanged floor `base`
(`reservoirDoubleSZSurface_afterZ_spreadBandAt`); pairing it with the destination ledger
`base + 2 + (T.draw Z).card + 1 ≤ rows` re-enters `reservoirSpreadCarrier (T.draw Z)` at zero floor
cost, with valley1 still pristine for the owed `S`. With the `S`-first edge, the `SZ`/`ZS` bursts,
and the flat-`O` interruption, every opening move on the double-valley surface now lands on a safe
carrier member at the entry floor regardless of which of `S`, `Z`, or a flat the adversary plays
first. -/
theorem reservoirDoubleSZSurface_Z_carrier {T : Bag} {base : ℕ}
    (hledger : base + 2 + (T.draw Piece.Z).card + 1 ≤ GameConfig.standard.rows) :
    reservoirSpreadCarrier (T.draw Piece.Z)
      (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.Z, rot := 0, col := 5 }) :=
  ⟨base, 2, reservoirDoubleSZSurface_afterZ_spreadBandAt base (by omega), hledger⟩

/-- **The mid-bag flat-`O` interruption exits into the spread carrier.** The hardest interleave the
adversary can throw at the double-valley SZ phase is a flat piece arriving before the owed `S` and
`Z` staircases have both landed. The lip-shelf landing
(`reservoirDoubleSZSurface_O_lipShelf_spreadBandAt`) parks that flat `O` on columns `4, 5` without
touching either valley, leaving a spread-three reserved-well band at the same floor `base`. Packaged
in carrier vocabulary, the post-`O` board is a `reservoirSpreadCarrier (T.draw Piece.O)` member: the
ledger books the one extra unit of spread the shelf fill spent (`base + 3 + (T.draw O).card + 1 ≤
rows`), and the still-pristine valleys stay available for the staircases the burst lemmas already
discharge. This is the flat-interruption companion of `reservoirDoubleSZSurface_SZ_burst_carrier`:
between the two, the SZ phase survives any order of flat, `S`, and `Z` deliveries with the drain
still owed. -/
theorem reservoirDoubleSZSurface_O_lipShelf_carrier {T : Bag} {base : ℕ}
    (hledger : base + 3 + (T.draw Piece.O).card + 1 ≤ GameConfig.standard.rows) :
    reservoirSpreadCarrier (T.draw Piece.O)
      (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.O, rot := 0, col := 4 }) :=
  ⟨base, 3, reservoirDoubleSZSurface_O_lipShelf_spreadBandAt base (by omega), hledger⟩

/-- **The spread-band carrier's non-`I` absorption edge** (the "absorb the non-`I` pieces as they
arrive" half of the `reservoirSpreadCarrier` closure, and the spread analogue of
`reservoirCarrier_fill_step`). Where the `I` drops the floor, a non-`I` piece *raises* it; the
spread-band ledger stays closed exactly when the rise is at most one floor unit. Given the geometric
fill witness — a valid placement of the drawn piece `p` landing the post-move board in a floor-pinned
spread band `IsSpreadBoundedRWSkylineAt standard s base'` — together with the floor-rise bound
`base' ≤ base + 1` and a non-refill draw (`(T.draw p).card < T.card`, holding for every non-final
draw), the post-move board re-enters `reservoirSpreadCarrier (T.draw p)`. The arithmetic is the dual
of the drain: the bag clock buys exactly one unit of headroom per draw (`base + s + T.card + 1` is
the ledger), so a unit floor rise is paid for by the unit clock tick:
`base' + s + (T.draw p).card + 1 ≤ (base + 1) + s + (T.card - 1) + 1 = base + s + T.card + 1 ≤ rows`.
This reduces the entire non-`I` half of the per-piece closure to the single geometric obligation
that an arbitrary spread band member admits a placement raising the floor by at most one — the
floor-pocket fills (`isSpreadBoundedRWSkylineAt_O_pocket_of_isLevelPocketBandAt` and siblings) all
keep the floor pinned (`base' = base`), discharging `hrise` outright. -/
theorem reservoirSpreadCarrier_fill_step {T : Bag} {b : Board} {p : Piece} {base base' s : ℕ}
    (hfill : ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      Board.IsSpreadBoundedRWSkylineAt GameConfig.standard s base'
        (Placement.applyStep GameConfig.standard b { pl with piece := p }))
    (hrise : base' ≤ base + 1)
    (hledger : base + s + T.card + 1 ≤ GameConfig.standard.rows)
    (hcard : (T.draw p).card < T.card) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard b { pl with piece := p }) := by
  obtain ⟨pl, hpiece, hvalid, hband'⟩ := hfill
  exact ⟨pl, hpiece, hvalid, base', s, hband', by omega⟩

/-- **The spread-band carrier's unified band-top fill edge.** The band-top generalization of
`reservoirSpreadCarrier_fill_step`, which only books a floor rise at a *fixed* buffer `s`. The
spread-carrier ledger `base + s + T.card + 1 ≤ rows` constrains only the *band top* `base + s` (the
highest a working column may sit), so the accounting that keeps the carrier closed cares about how
far the band top moves, not whether it moved by raising the floor or by widening the buffer. This
edge makes that explicit: given a geometric fill witness landing the post-move board in a
floor-pinned spread band `IsSpreadBoundedRWSkylineAt standard s' base'` at ANY floor `base'` and ANY
buffer `s'`, the single hypothesis `base' + s' ≤ base + s + 1` (the band top rose by at most one)
together with the ledger and a non-refill draw (`(T.draw p).card < T.card`) re-enters
`reservoirSpreadCarrier (T.draw p)`. The arithmetic is the dual reading of the bag clock: each draw
ticks `T.card` down by one, buying exactly one unit of band-top headroom, so a unit band-top rise is
paid for by the unit clock tick —
`base' + s' + (T.draw p).card + 1 ≤ (base + s + 1) + (T.card - 1) + 1 = base + s + T.card + 1 ≤ rows`.
Setting `s' = s` recovers the floor-rise edge (`base' ≤ base + 1`); setting `base' = base, s' = s + 1`
gives its missing dual — the buffer *widens* by one at a pinned floor — which is exactly the slack a
stack of absorbing fills consumes as the non-`I` pieces of a bag arrive before the regulator `I`
drains them back down. -/
theorem reservoirSpreadCarrier_fill_step_bandtop {T : Bag} {b : Board} {p : Piece}
    {base base' s s' : ℕ}
    (hfill : ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      Board.IsSpreadBoundedRWSkylineAt GameConfig.standard s' base'
        (Placement.applyStep GameConfig.standard b { pl with piece := p }))
    (hbandtop : base' + s' ≤ base + s + 1)
    (hledger : base + s + T.card + 1 ≤ GameConfig.standard.rows)
    (hcard : (T.draw p).card < T.card) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard b { pl with piece := p }) := by
  obtain ⟨pl, hpiece, hvalid, hband'⟩ := hfill
  exact ⟨pl, hpiece, hvalid, base', s', hband', by omega⟩

/-- **The spread-band carrier's wide-pocket flat fill closes in place.** The concrete flat branch of
the `reservoirSpreadCarrier` non-`I` half, and the spread analogue of
`reservoirCarrier_widePocket_flat_fill_step`. From an ARBITRARY spread-`2` band member `skyline h`
carrying a width-eight flat run at columns `pc .. pc + 7`, each flat piece `p ∈ {O, I, T, L, J}` has
a VALID placement (`isLevelPocketBandAt_flatPiece_lands_widePocket_valid`) whose post-move board is
again a spread-`2` level pocket band at the SAME floor `base`. Forgetting that landing's width-four
pocket (`isSpreadBoundedRWSkylineAt_of_isLevelPocketBandAt`) gives a floor-pinned spread band at
floor `base`, spread `2`; pairing it with the spread-carrier ledger `base + 2 + (T.draw p).card +
1 ≤ rows` re-enters `reservoirSpreadCarrier (T.draw p)`. Because the floor is unchanged the fill
spends zero floor units, so the only ledger obligation is the destination clock fitting under the
ceiling. This is the flat half of the spread carrier's non-`I` closure; the open residue is purely
the site-existence obligation that the carrier surface presents the width-eight run, which the
ten-column budget forces to be bag-phase-aware. -/
theorem reservoirSpreadCarrier_widePocket_flat_fill_step {T : Bag} {base pc : ℕ} {h : ℕ → ℕ}
    {p : Piece}
    (hp : p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J)
    (hslack : base + 2 ≤ GameConfig.standard.rows)
    (hw0 : h 0 = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ 0 → base ≤ h j ∧ h j ≤ base + 2)
    (hpc : 1 ≤ pc) (hpc7 : pc + 7 < GameConfig.standard.cols)
    (hsite0 : h pc = base) (hsite1 : h (pc + 1) = base) (hsite2 : h (pc + 2) = base)
    (hsite3 : h (pc + 3) = base) (hsite4 : h (pc + 4) = base) (hsite5 : h (pc + 5) = base)
    (hsite6 : h (pc + 6) = base) (hsite7 : h (pc + 7) = base)
    (hledger : base + 2 + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
          { pl with piece := p }) := by
  obtain ⟨pl, hpiece, hvalid, hband'⟩ :=
    Board.isLevelPocketBandAt_flatPiece_lands_widePocket_valid hp hslack hw0 hband hpc hpc7
      hsite0 hsite1 hsite2 hsite3 hsite4 hsite5 hsite6 hsite7
  refine ⟨pl, hpiece, hvalid, ?_⟩
  subst hpiece
  exact ⟨base, 2, Board.isSpreadBoundedRWSkylineAt_of_isLevelPocketBandAt hband', hledger⟩

/-- **The spread-band carrier's shared-valley S/Z fill closes in place.** The concrete staircase
branch of the `reservoirSpreadCarrier` non-`I` half, and the spread analogue of
`reservoirCarrier_valley_SZ_fill_step`. From an ARBITRARY spread-`2` band member `skyline h` carrying
one width-four valley at `vc .. vc + 3` and a disjoint flat pocket at `pc .. pc + 3` (`vc + 3 < pc`),
either staircase piece `p ∈ {S, Z}` has a VALID placement
(`isLevelPocketBandAt_valley_hosts_SZ_valid`) whose post-move board is again a spread-`2` level
pocket band at the SAME floor `base` (the `S` seats at the valley's right lip, the `Z` at its left,
both leaving the flat pocket as the surviving floor run). Forgetting that landing's width-four pocket
(`isSpreadBoundedRWSkylineAt_of_isLevelPocketBandAt`) gives a floor-pinned spread band at floor
`base`, spread `2`; pairing it with the spread-carrier ledger
`base + 2 + (T.draw p).card + 1 ≤ rows` re-enters `reservoirSpreadCarrier (T.draw p)` at zero floor
cost. Together with `reservoirSpreadCarrier_widePocket_flat_fill_step` this gives the spread carrier's
non-`I` fill for all seven non-regulator pieces; the open residue is purely the site-existence
obligation that the carrier surface carries (in the right bag phase) the width-eight run or the shared
valley the incoming piece needs, which the ten-column budget forces to be bag-phase-aware. -/
theorem reservoirSpreadCarrier_valley_SZ_fill_step {T : Bag} {base vc pc : ℕ} {h : ℕ → ℕ}
    {p : Piece}
    (hp : p = Piece.S ∨ p = Piece.Z)
    (hslack : base + 2 ≤ GameConfig.standard.rows)
    (hw0 : h 0 = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ 0 → base ≤ h j ∧ h j ≤ base + 2)
    (hvc : 1 ≤ vc) (hord : vc + 3 < pc) (hpc3 : pc + 3 < GameConfig.standard.cols)
    (hv0 : h vc = base + 1) (hv1 : h (vc + 1) = base) (hv2 : h (vc + 2) = base)
    (hv3 : h (vc + 3) = base + 1)
    (hp0 : h pc = base) (hp1 : h (pc + 1) = base) (hp2 : h (pc + 2) = base)
    (hp3 : h (pc + 3) = base)
    (hledger : base + 2 + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
          { pl with piece := p }) := by
  obtain ⟨pl, hpiece, hvalid, hband'⟩ :=
    Board.isLevelPocketBandAt_valley_hosts_SZ_valid hp hslack hw0 hband hvc hord hpc3
      hv0 hv1 hv2 hv3 hp0 hp1 hp2 hp3
  refine ⟨pl, hpiece, hvalid, ?_⟩
  subst hpiece
  exact ⟨base, 2, Board.isSpreadBoundedRWSkylineAt_of_isLevelPocketBandAt hband', hledger⟩

/-- **The spread-band carrier's non-regulator fill edge, reduced to one site-existence hypothesis.**
The spread analogue of `reservoirCarrier_nonRegulator_fill_step`: unifies the two spread-carrier non-`I`
fill branches (`reservoirSpreadCarrier_widePocket_flat_fill_step` for the flats `O, I, T, L, J`;
`reservoirSpreadCarrier_valley_SZ_fill_step` for the staircases `S, Z`) behind a single disjunctive
`hsite` premise on the band `skyline h`: EITHER the drawn piece is a flat and `h` carries a
width-eight flat run at some `pc .. pc + 7`, OR it is a staircase and `h` carries a width-four valley
at some `vc .. vc + 3` together with a disjoint width-four flat pocket at `pc .. pc + 3`. Given the
spread-`2` band frame (`hw0`, `hband`, `hslack`) and the spread-carrier ledger (`hledger`), either
branch produces a VALID placement of `p` whose post-move board re-enters
`reservoirSpreadCarrier (T.draw p)` at the same floor `base`. This is the exact residue of the
non-`I` half of the per-bag closure on the closed spread-band vocabulary: every non-regulator piece
is absorbed PROVIDED its landing site is present on the carrier surface. What remains open is purely
`hsite` — that the bag-phase carrier guarantees, for each piece the bag still owes, the site that
piece needs — which the ten-column budget (`well + width-8 run`, or `well + valley + pocket = 9`)
forces to be bag-phase-aware rather than a single fixed shape hosting all seven at once. -/
theorem reservoirSpreadCarrier_nonRegulator_fill_step {T : Bag} {base : ℕ} {h : ℕ → ℕ} {p : Piece}
    (hslack : base + 2 ≤ GameConfig.standard.rows)
    (hw0 : h 0 = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ 0 → base ≤ h j ∧ h j ≤ base + 2)
    (hledger : base + 2 + (T.draw p).card + 1 ≤ GameConfig.standard.rows)
    (hsite :
      ((p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J) ∧
        ∃ pc, 1 ≤ pc ∧ pc + 7 < GameConfig.standard.cols ∧
          h pc = base ∧ h (pc + 1) = base ∧ h (pc + 2) = base ∧ h (pc + 3) = base ∧
          h (pc + 4) = base ∧ h (pc + 5) = base ∧ h (pc + 6) = base ∧ h (pc + 7) = base) ∨
      ((p = Piece.S ∨ p = Piece.Z) ∧
        ∃ vc pc, 1 ≤ vc ∧ vc + 3 < pc ∧ pc + 3 < GameConfig.standard.cols ∧
          h vc = base + 1 ∧ h (vc + 1) = base ∧ h (vc + 2) = base ∧ h (vc + 3) = base + 1 ∧
          h pc = base ∧ h (pc + 1) = base ∧ h (pc + 2) = base ∧ h (pc + 3) = base)) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
          { pl with piece := p }) := by
  rcases hsite with
    ⟨hp, pc, hpc, hpc7, hs0, hs1, hs2, hs3, hs4, hs5, hs6, hs7⟩ |
    ⟨hp, vc, pc, hvc, hord, hpc3, hv0, hv1, hv2, hv3, hq0, hq1, hq2, hq3⟩
  · exact reservoirSpreadCarrier_widePocket_flat_fill_step hp hslack hw0 hband hpc hpc7
      hs0 hs1 hs2 hs3 hs4 hs5 hs6 hs7 hledger
  · exact reservoirSpreadCarrier_valley_SZ_fill_step hp hslack hw0 hband hvc hord hpc3
      hv0 hv1 hv2 hv3 hq0 hq1 hq2 hq3 hledger

/-- **The flat phase shape discharges the spread carrier's flat fill site.** The bridge from the
phase vocabulary (which *guarantees* a width-eight flat run) to the spread-carrier non-`I` fill
(which *requires* one as its open `hsite`). An `IsFlatPhaseReservoirAtS 2 base` witness packs exactly
the spread-`2` band frame (well at `0`, every working column in `[base, base + 2]`, slack
`base + 2 ≤ rows`) together with the width-eight floor run at `pc .. pc + 7` that
`reservoirSpreadCarrier_widePocket_flat_fill_step` consumes; so any flat piece `p ∈ {O, I, T, L, J}`
has a valid placement re-entering `reservoirSpreadCarrier (T.draw p)` at the same floor `base`. This
is the structural payoff of the phase shape: where a bare spread band leaves the flat site open (a
spread-`2` band can alternate heights with no width-four run), the flat phase shape carries the site
by construction, so a strategy that re-presents the flat phase after each fill discharges the flat
half of the per-bag closure outright. The residue is purely re-presenting the phase shape, i.e. the
once-per-bag drain regenerating the full-width run the fills consume. -/
theorem reservoirSpreadCarrier_flatPhase_flat_fill_step {T : Bag} {base : ℕ} {b : Board} {p : Piece}
    (hphase : IsFlatPhaseReservoirAtS 2 base b)
    (hp : p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J)
    (hledger : base + 2 + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard b { pl with piece := p }) := by
  obtain ⟨h, pc, rfl, hw0, hband, hslack, hpc1, hpc7,
    hs0, hs1, hs2, hs3, hs4, hs5, hs6, hs7⟩ := hphase
  exact reservoirSpreadCarrier_widePocket_flat_fill_step hp hslack hw0 hband hpc1 hpc7
    hs0 hs1 hs2 hs3 hs4 hs5 hs6 hs7 hledger

/-- **The S/Z phase shape discharges the spread carrier's valley fill site.** The staircase
companion of `reservoirSpreadCarrier_flatPhase_flat_fill_step`, bridging the phase vocabulary (which
*guarantees* a width-four valley plus a disjoint flat pocket) to the spread-carrier non-`I` fill
(which *requires* one as its open `hsite`). An `IsSZPhaseReservoirAtS 2 base` witness packs exactly
the spread-`2` band frame (well at `0`, every working column in `[base, base + 2]`, slack
`base + 2 ≤ rows`) together with the valley at `vc .. vc + 3` (lips at `base + 1`, floor at `base`)
and the disjoint flat pocket at `pc .. pc + 3` that
`reservoirSpreadCarrier_valley_SZ_fill_step` consumes; so either staircase piece `p ∈ {S, Z}` has a
valid placement re-entering `reservoirSpreadCarrier (T.draw p)` at the same floor `base`. Together
with the flat bridge this discharges *both* halves of the open `hsite` from the two phase shapes:
the carrier closes for every owed piece provided the strategy re-presents the bag-phase-correct shape
(flat when no staircase is owed, valley when one is) — exactly the bag-phase-awareness the ten-column
budget forces. The residue is re-presenting the phase shape via the once-per-bag drain. -/
theorem reservoirSpreadCarrier_SZPhase_SZ_fill_step {T : Bag} {base : ℕ} {b : Board} {p : Piece}
    (hphase : IsSZPhaseReservoirAtS 2 base b)
    (hp : p = Piece.S ∨ p = Piece.Z)
    (hledger : base + 2 + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard b { pl with piece := p }) := by
  obtain ⟨h, vc, pc, rfl, hw0, hband, hslack, hvc1, hord, hpc3,
    hv0, hv1, hv2, hv3, hs0, hs1, hs2, hs3⟩ := hphase
  exact reservoirSpreadCarrier_valley_SZ_fill_step hp hslack hw0 hband hvc1 hord hpc3
    hv0 hv1 hv2 hv3 hs0 hs1 hs2 hs3 hledger

/-- **The floor-pinned all-7 valley menu lifts to a spread-carrier re-entry for EVERY piece.** The
carrier-vocabulary lift of `Board.isSpreadBoundedRWSkylineAt_all7_valley_of_pocket_Snotch_Znotch`:
given a spread-`2` band (well `w`, off-well columns in `[base, base + 2]`) that exposes a width-four
level pocket, an ascending `S`-notch, and a descending `Z`-notch — all sitting at the floor `base` —
WHATEVER piece `p` the adversary draws has a valid placement re-entering
`reservoirSpreadCarrier (T.draw p)` at the SAME floor `base`. This is the payoff of the pinned menu
over the existential one (task `#629`): because the landing floor is tracked as `base` (not merely
"some floor"), the carrier ledger `base + 2 + (T.draw p).card + 1 ≤ rows` transports verbatim — the
drawn bag is one piece smaller, so the ledger only gets easier. Unlike
`reservoirSpreadCarrier_nonRegulator_fill_step`, which handles only the five non-`I` fillers behind a
type-matched site and leaves `S`/`Z` to a separate valley site, this closes the carrier for ALL seven
pieces (including the regulator `I` and both staircases) from a SINGLE board carrying all three sites
at once.

Honesty: NOT the per-bag closure. It is still a from-surface step requiring the caller to SUPPLY the
pocket + `S`-notch + `Z`-notch sites at the floor; the genuine open work is regenerating those three
sites across the step (a fill consumes its site) and the all-orders per-bag drain accounting (crux
`#66`/`#72`). `TetrisSolvableValid` is NOT proven. No sorry. -/
theorem reservoirSpreadCarrier_all7Valley_step {T : Bag} {base : ℕ} {h : ℕ → ℕ} {p : Piece}
    {w c d e : ℕ}
    (hc : c < GameConfig.standard.cols) (hc1 : c + 1 < GameConfig.standard.cols)
    (hc2 : c + 2 < GameConfig.standard.cols) (hc3 : c + 3 < GameConfig.standard.cols)
    (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2) (hwc3 : w ≠ c + 3)
    (heq1 : h (c + 1) = h c) (heq2 : h (c + 2) = h c) (heq3 : h (c + 3) = h c)
    (hcfloor : h c = base)
    (hd : d < GameConfig.standard.cols) (hd1 : d + 1 < GameConfig.standard.cols)
    (hd2 : d + 2 < GameConfig.standard.cols)
    (hwd : w ≠ d) (hwd1 : w ≠ d + 1) (hwd2 : w ≠ d + 2)
    (hSnotch : h d = h (d + 1) ∧ h (d + 2) = h d + 1 ∧ h d = base)
    (he : e < GameConfig.standard.cols) (he1 : e + 1 < GameConfig.standard.cols)
    (he2 : e + 2 < GameConfig.standard.cols)
    (hwe : w ≠ e) (hwe1 : w ≠ e + 1) (hwe2 : w ≠ e + 2)
    (hZnotch : h (e + 1) = h (e + 2) ∧ h e = h (e + 1) + 1 ∧ h (e + 1) = base)
    (hw : w < GameConfig.standard.cols) (hw0 : h w = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ w → base ≤ h j ∧ h j ≤ base + 2)
    (hslack : base + 2 ≤ GameConfig.standard.rows)
    (hledger : base + 2 + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h) pl) := by
  obtain ⟨pl, hpiece, hvalid, hbandAt⟩ :=
    Board.isSpreadBoundedRWSkylineAt_all7_valley_of_pocket_Snotch_Znotch
      hc hc1 hc2 hc3 hwc hwc1 hwc2 hwc3 heq1 heq2 heq3 hcfloor
      hd hd1 hd2 hwd hwd1 hwd2 hSnotch he he1 he2 hwe hwe1 hwe2 hZnotch
      hw hw0 (le_refl 2) hband hslack p
  exact ⟨pl, hpiece, hvalid, base, 2, hbandAt, hledger⟩

/-- **A concrete floor-pinned rich surface** carrying all three landing motifs at once over the
width-ten board: a reserved empty well at column 0; a width-four flat pocket across columns 1 to 4;
a Z-notch at columns 5 to 7 (a `base+1` rise at column 5 over the flat 6,7); and an S-notch at
columns 6 to 8 (the flat 6,7 then a `base+1` rise at column 8). The Z and S notches SHARE the flat
columns 6,7 — the column-budget overlap that lets a single width-ten board host the well, the
pocket, and both notches at once (without overlap, well 1 plus pocket 4 plus two width-three
notches exceeds ten columns). This is the same profile already used by the `richStandard` surface
family. -/
def reservoirRichSurface (base : ℕ) : ℕ → ℕ := fun j =>
  if j = 0 then 0 else if j = 5 then base + 1 else if j = 8 then base + 1 else base

/-- **Floor-pinned all-7 carrier step on the concrete `reservoirRichSurface`.** Instantiates the
abstract three-site valley menu `reservoirSpreadCarrier_all7Valley_step` (iter607) at the concrete
floor-pinned board `Board.skyline GameConfig.standard (reservoirRichSurface base)`, with the pocket
front at `c = 1`, the S-notch at `d = 6`, the Z-notch at `e = 5`, and the well at `w = 0`. For ANY
drawn piece `p` (with the spread-2 slack and ledger room), this produces a valid placement landing
back inside `reservoirSpreadCarrier (T.draw p)` at spread 2, floor `base`. This closes the
*magnitude* gap flagged by iter603 (whose existential `IsSpreadBoundedRWSkyline 2` vocabulary
recovered only the EXISTENCE of a pinned floor, not its value): here the floor is the concrete
symbolic `base`, so the re-entered spread band carries its actual magnitude.
**Open residue (NOT closed here):** the conclusion lands in a bare `reservoirSpreadCarrier`, whose
board the next `hstep` invocation receives as an ARBITRARY carrier — so this does not by itself
discharge the front-door `hstep` obligation (which is handed an arbitrary carrier board, not this
concrete one). The genuine open work remains site regeneration across the step (a fill consumes its
landing site) and the all-orders per-bag drain accounting (crux `#66`, `#72`). `TetrisSolvableValid`
is NOT proven. -/
theorem reservoirSpreadCarrier_richSurface_all7_step {T : Bag} {base : ℕ} {p : Piece}
    (hslack : base + 2 ≤ GameConfig.standard.rows)
    (hledger : base + 2 + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirRichSurface base)) pl) := by
  apply reservoirSpreadCarrier_all7Valley_step (base := base) (c := 1) (d := 6) (e := 5) (w := 0)
  all_goals try assumption
  all_goals try decide
  all_goals try (intro j hj hj0; simp only [reservoirRichSurface] <;> split_ifs <;> omega)
  all_goals simp [reservoirRichSurface]

/-- **The concrete `reservoirRichSurface` is a spread-band carrier member.** The carrier-membership
companion to iter608's all-7 hosting step (`reservoirSpreadCarrier_richSurface_all7_step`): the same
rich reset surface that hosts every drawn piece is itself a `reservoirSpreadCarrier` board, at spread
`1` and floor `base` — its off-well columns sit in `[base, base+1]` (the two `base+1` notch columns
and the `base` floor elsewhere) and the well at column 0 is empty. So the rich surface is a valid
*reset state*: the drain target the once-per-bag I returns the stack to, and the start state from
which iter608's step fires. Proof: the floor-pinned smart constructor
`Board.isSpreadBoundedRWSkylineAt_skyline` at well `w = 0`, the band bound discharged by
`split_ifs <;> omega` over the four height cases, and the ledger inherited from the `T.card` slack.
**Open residue (NOT closed here):** this is reset-state membership, not a step — it hosts no piece
and does not discharge the front-door `hstep` (which is handed an arbitrary carrier board). Site
regeneration across a fill and the all-orders per-bag drain accounting (crux `#66`, `#72`) remain
open; `TetrisSolvableValid` is NOT proven. -/
theorem reservoirSpreadCarrier_richSurface_mem {T : Bag} {base : ℕ}
    (hledger : base + 1 + T.card + 1 ≤ GameConfig.standard.rows) :
    reservoirSpreadCarrier T (Board.skyline GameConfig.standard (reservoirRichSurface base)) := by
  refine ⟨base, 1, ?_, hledger⟩
  apply Board.isSpreadBoundedRWSkylineAt_skyline (w := 0)
  · decide
  · simp [reservoirRichSurface]
  · intro j hj hjw
    simp only [reservoirRichSurface]
    split_ifs <;> omega
  · omega

/-- **Site regeneration, step one: an `O` filler in the rich pocket keeps BOTH notches** (iter610).
The first concrete multi-piece site-regeneration brick on the iter608 reset surface
`reservoirRichSurface base`. Instantiating the abstract two-valley frame
`Board.applyStep_O_skyline_preserves_both_notches` (iter596) at the rich geometry — `O` at the pocket
front `col = 1`, the S-notch on columns `6,7,8`, the Z-notch on columns `5,6,7`, the reserved well at
`col = 0` — shows that after the flat `O` lands in the pocket, the post-`O` board still carries the
S-notch shape (`colHeight 6 = colHeight 7`, `colHeight 8 = colHeight 6 + 1`) and the Z-notch shape
(`colHeight 5 = colHeight 6 + 1`). So a filler arriving mid-bag does NOT destroy the reserved `S`/`Z`
landing spots: the same rich surface that hosts every single piece (iter608) keeps hosting the owed
staircases after one pocket fill. This is the concrete witness that the reset surface's landing menu
*regenerates* across an intervening filler — the property the bag-phase scheduler needs to chain
iter608's all-7 step across a whole bag.
**Open residue (NOT closed here):** this handles ONE `O` in the pocket and only certifies the notch
shapes survive; it does not yet re-establish full carrier membership after the fill, nor handle the
pocket filling up across many fillers (the spread growth), nor the all-orders per-bag drain accounting
(crux `#66`, `#72`). `TetrisSolvableValid` is NOT proven. -/
theorem reservoirRichSurface_O_pocket_preserves_both_notches {base : ℕ} :
    Board.colHeight (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirRichSurface base))
        { piece := Piece.O, rot := 0, col := 1 }) 6
      = Board.colHeight (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirRichSurface base))
        { piece := Piece.O, rot := 0, col := 1 }) 7 ∧
    Board.colHeight (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirRichSurface base))
        { piece := Piece.O, rot := 0, col := 1 }) 8
      = Board.colHeight (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirRichSurface base))
        { piece := Piece.O, rot := 0, col := 1 }) 6 + 1 ∧
    Board.colHeight (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirRichSurface base))
        { piece := Piece.O, rot := 0, col := 1 }) 5
      = Board.colHeight (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirRichSurface base))
        { piece := Piece.O, rot := 0, col := 1 }) 6 + 1 := by
  have key := Board.applyStep_O_skyline_preserves_both_notches
    (cfg := GameConfig.standard) (h := reservoirRichSurface base)
    (c := 1) (sc := 6) (zc := 5) (w := 0)
    (by decide) (by decide) (by simp [reservoirRichSurface]) (by decide) (by decide)
    (by decide) (by simp [reservoirRichSurface]) (by decide) (by decide) (by decide)
    (by simp [reservoirRichSurface]) (by simp [reservoirRichSurface]) (by decide) (by decide)
    (by decide) (by simp [reservoirRichSurface]) (by simp [reservoirRichSurface])
    (by decide) (by decide)
  exact ⟨key.1, key.2.1, key.2.2.2⟩

/-- **The phase-matched per-piece fill dispatcher into the spread carrier.** Unifies the two
phase bridges (`reservoirSpreadCarrier_flatPhase_flat_fill_step` and
`reservoirSpreadCarrier_SZPhase_SZ_fill_step`) behind one disjunctive `hsite` premise that pairs the
drawn piece with the phase shape matching its type: EITHER a flat piece `p ∈ {O, I, T, L, J}` together
with a flat phase shape `IsFlatPhaseReservoirAtS 2 base b`, OR a staircase `p ∈ {S, Z}` together with
a staircase phase shape `IsSZPhaseReservoirAtS 2 base b`. In either case the matched phase shape
carries the landing site that piece needs by construction, so it has a valid placement re-entering
`reservoirSpreadCarrier (T.draw p)` at the same floor `base`. This is the per-piece closure of the
spread carrier *when the surface is in the bag-phase-correct shape*: it reduces the entire non-`I`
half of the per-bag closure to maintaining the phase shape matching whatever the bag still owes — a
flat run when no staircase is owed, a valley when one is. The genuine residue is the OFF-phase case
(a flat drawn while a staircase is owed must land in the S/Z phase's width-four pocket, which the
ten-column budget forces rather than a second width-eight run) plus re-presenting the phase shape via
the once-per-bag drain. -/
theorem reservoirSpreadCarrier_phase_fill_step {T : Bag} {base : ℕ} {b : Board} {p : Piece}
    (hsite :
      ((p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J) ∧
        IsFlatPhaseReservoirAtS 2 base b) ∨
      ((p = Piece.S ∨ p = Piece.Z) ∧ IsSZPhaseReservoirAtS 2 base b))
    (hledger : base + 2 + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard b { pl with piece := p }) := by
  rcases hsite with ⟨hp, hflat⟩ | ⟨hp, hsz⟩
  · exact reservoirSpreadCarrier_flatPhase_flat_fill_step hflat hp hledger
  · exact reservoirSpreadCarrier_SZPhase_SZ_fill_step hsz hp hledger

/-- **Off-phase flat fill in the SZ phase.** A flat piece `p ∈ {O,I,T,L,J}` can arrive while the
board is in the SZ (staircase-owed) phase. The budget geometry (#90 and #151: well + valley +
second-wide-run = 11 > 10 columns) forbids carrying a width-8 flat run alongside the owed valley,
so the SZ phase only guarantees the width-4 pocket. This lemma routes the off-phase flat through
that pocket: the SZ phase forgets to `IsLevelPocketBandAt 2 base`, the flat-pocket fill arc lands
the piece floor-pinned at `base`, and the ledger re-enters the spread carrier. The landing surface
is a bare spread band (not a phase shape), so the next-piece site is the still-open residue. -/
theorem reservoirSpreadCarrier_SZPhase_flat_fill_step {T : Bag} {base : ℕ} {b : Board} {p : Piece}
    (hphase : IsSZPhaseReservoirAtS 2 base b)
    (hp : p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J)
    (hledger : base + 2 + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard b { pl with piece := p }) := by
  obtain ⟨pl, hpiece, hvalid, hband', _⟩ :=
    Board.isSpreadBoundedRWSkylineAt_flat_pocket_of_isLevelPocketBandAt hp
      (isLevelPocketBandAt_of_isSZPhaseReservoirAtS hphase)
  refine ⟨pl, hpiece, hvalid, ?_⟩
  subst hpiece
  exact ⟨base, 2, hband', hledger⟩

/-- **The SZ phase is the universal phase.** With a reserved well (1 col), an owed S and Z valley
(4 cols) and a flat pocket (4 cols), the SZ phase footprint is `1 + 4 + 4 = 9 ≤ 10` columns, so it
fits on the standard board and reserves a home for *every* piece simultaneously — sidestepping the
#90 and #151 column-budget obstruction that forbids one flat width-8 run from hosting S and Z. This
all-7 dispatcher routes each drawn piece to its reserved site: the five flats `{O,I,T,L,J}` flush
into the width-4 pocket (`reservoirSpreadCarrier_SZPhase_flat_fill_step`) and the two staircases
`{S,Z}` notch into the valley (`reservoirSpreadCarrier_SZPhase_SZ_fill_step`). Either way the draw
re-enters the spread carrier, establishing that the SZ phase absorbs an adversary's arbitrary next
piece. The landing surface is a bare spread band, so re-establishing the SZ phase for the *next*
piece (valley and pocket regeneration) is the residual open obligation, discharged by the drain. -/
theorem reservoirSpreadCarrier_SZPhase_fill_step {T : Bag} {base : ℕ} {b : Board} {p : Piece}
    (hphase : IsSZPhaseReservoirAtS 2 base b)
    (hledger : base + 2 + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard b { pl with piece := p }) := by
  cases p with
  | O => exact reservoirSpreadCarrier_SZPhase_flat_fill_step hphase (Or.inl rfl) hledger
  | I => exact reservoirSpreadCarrier_SZPhase_flat_fill_step hphase (Or.inr (Or.inl rfl)) hledger
  | S => exact reservoirSpreadCarrier_SZPhase_SZ_fill_step hphase (Or.inl rfl) hledger
  | Z => exact reservoirSpreadCarrier_SZPhase_SZ_fill_step hphase (Or.inr rfl) hledger
  | T =>
    exact reservoirSpreadCarrier_SZPhase_flat_fill_step hphase
      (Or.inr (Or.inr (Or.inl rfl))) hledger
  | L =>
    exact reservoirSpreadCarrier_SZPhase_flat_fill_step hphase
      (Or.inr (Or.inr (Or.inr (Or.inl rfl)))) hledger
  | J =>
    exact reservoirSpreadCarrier_SZPhase_flat_fill_step hphase
      (Or.inr (Or.inr (Or.inr (Or.inr rfl)))) hledger

/-- **The regulator drain from the SZ phase.** The complement of `reservoirSpreadCarrier_SZPhase_fill_step`:
where the fills *raise* the floor by absorbing the drawn piece into the valley or pocket, the drain
*lowers* it. The SZ phase forgets to a floor-pinned spread-`2` band
(`isLevelPocketBandAt_of_isSZPhaseReservoirAtS` then
`Board.isSpreadBoundedRWSkylineAt_of_isLevelPocketBandAt`), so once the floor has climbed to at least
four and the band top sits at `base + 2 ≤ 16`, the guaranteed `I` drops vertically into the reserved
well, clears four full rows and re-enters the spread carrier at floor `base - 4`
(`reservoirSpreadCarrier_vertI_drain_cap`). Together with the all-7 fill dispatcher this gives both
moves the SZ phase offers for an arriving piece — raise via fill, or, on the once-per-bag `I`, drain
back down — the two halves of the once-per-bag height regulator stated at the bag-boundary shape. -/
theorem reservoirSpreadCarrier_SZPhase_vertI_drain {T : Bag} {base : ℕ} {b : Board}
    (hphase : IsSZPhaseReservoirAtS 2 base b)
    (hfloor : 4 ≤ base) (hcap : base + 2 ≤ 16) :
    ∃ plI : Placement, plI.piece = Piece.I ∧ plI.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw Piece.I)
        (Placement.applyStep GameConfig.standard b plI) :=
  reservoirSpreadCarrier_vertI_drain_cap
    (Board.isSpreadBoundedRWSkylineAt_of_isLevelPocketBandAt
      (isLevelPocketBandAt_of_isSZPhaseReservoirAtS hphase))
    hfloor hcap

/-- **The regulated per-piece step from the S/Z phase.** The once-per-bag height regulator stated as
a single per-piece move: for the drawn piece `p` the player either *raises* or *drains*, whichever
keeps the band bounded, and either way re-enters the spread carrier under `T.draw p`. When `p` is the
bag's guaranteed `I` the player drops it vertically into the reserved well, clearing four rows and
lowering the floor to `base - 4` (`reservoirSpreadCarrier_SZPhase_vertI_drain`, needing floor
`4 ≤ base` and band top `base + 2 ≤ 16`); for any of the other six pieces the player seats it into its
reserved valley or pocket at the unchanged floor `base` (`reservoirSpreadCarrier_SZPhase_fill_step`).
This is the rise and reset the surface invariant turns on, packaged per piece: the six absorbing fills
raise the working columns inside the band while the seventh, the `I`, drains them back down — the
regulator that keeps the band off the ceiling until the drain arrives. The landing surface is a bare
spread band (the valley and pocket the fill consumed are not yet regenerated), so re-presenting the
phase shape for the next piece stays the residual obligation discharged across the bag. -/
theorem reservoirSpreadCarrier_SZPhase_regulated_step {T : Bag} {base : ℕ} {b : Board} {p : Piece}
    (hphase : IsSZPhaseReservoirAtS 2 base b)
    (hfloor : 4 ≤ base) (hcap : base + 2 ≤ 16)
    (hledger : base + 2 + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard b { pl with piece := p }) := by
  cases p with
  | I =>
    obtain ⟨plI, hpiece, hvalid, hcarrier⟩ :=
      reservoirSpreadCarrier_SZPhase_vertI_drain (T := T) hphase hfloor hcap
    refine ⟨plI, hpiece, hvalid, ?_⟩
    have heq : ({ plI with piece := Piece.I } : Placement) = plI := by rw [← hpiece]
    rw [heq]; exact hcarrier
  | O => exact reservoirSpreadCarrier_SZPhase_fill_step hphase hledger
  | S => exact reservoirSpreadCarrier_SZPhase_fill_step hphase hledger
  | Z => exact reservoirSpreadCarrier_SZPhase_fill_step hphase hledger
  | T => exact reservoirSpreadCarrier_SZPhase_fill_step hphase hledger
  | L => exact reservoirSpreadCarrier_SZPhase_fill_step hphase hledger
  | J => exact reservoirSpreadCarrier_SZPhase_fill_step hphase hledger

/-- **The regulated per-piece step from the flat phase.** The no-staircase-owed companion of
`reservoirSpreadCarrier_SZPhase_regulated_step`: the same rise-or-reset regulator, stated at the flat
phase shape `IsFlatPhaseReservoirAtS 2 base b`, which is the surface the bag re-enters once both
staircases have been drawn. For a flat piece `p ∈ {O, I, T, L, J}` the player either drains or fills.
When `p` is the guaranteed `I` the player drops it vertically into the reserved well, clearing four
rows and lowering the floor to `base - 4`: the flat phase forgets to a floor-pinned spread-`2` band
(`isLevelPocketBandAt_of_isFlatPhaseReservoirAtS` then
`Board.isSpreadBoundedRWSkylineAt_of_isLevelPocketBandAt`), so `reservoirSpreadCarrier_vertI_drain_cap`
applies under floor `4 ≤ base` and band top `base + 2 ≤ 16`. For any of the other four flats the player
seats it into the wide flat run at the unchanged floor `base`
(`reservoirSpreadCarrier_flatPhase_flat_fill_step`). Either branch re-enters the spread carrier under
`T.draw p`. Together with the S/Z regulated step this gives the regulator move at both phases of the
carrier — the once-per-bag `I` always drains, every other piece is absorbed — so whichever phase the
bag is in, the surface has a height-bounded response to the adversary's next piece. The landing surface
is a bare spread band, so re-presenting the phase shape for the next piece stays the residual obligation
discharged across the bag. -/
theorem reservoirSpreadCarrier_flatPhase_regulated_step {T : Bag} {base : ℕ} {b : Board} {p : Piece}
    (hphase : IsFlatPhaseReservoirAtS 2 base b)
    (hp : p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J)
    (hfloor : 4 ≤ base) (hcap : base + 2 ≤ 16)
    (hledger : base + 2 + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard b { pl with piece := p }) := by
  rcases hp with rfl | rfl | rfl | rfl | rfl
  · exact reservoirSpreadCarrier_flatPhase_flat_fill_step hphase (Or.inl rfl) hledger
  · obtain ⟨plI, hpiece, hvalid, hcarrier⟩ :=
      reservoirSpreadCarrier_vertI_drain_cap (T := T)
        (Board.isSpreadBoundedRWSkylineAt_of_isLevelPocketBandAt
          (isLevelPocketBandAt_of_isFlatPhaseReservoirAtS hphase))
        hfloor hcap
    refine ⟨plI, hpiece, hvalid, ?_⟩
    have heq : ({ plI with piece := Piece.I } : Placement) = plI := by rw [← hpiece]
    rw [heq]; exact hcarrier
  · exact reservoirSpreadCarrier_flatPhase_flat_fill_step hphase
      (Or.inr (Or.inr (Or.inl rfl))) hledger
  · exact reservoirSpreadCarrier_flatPhase_flat_fill_step hphase
      (Or.inr (Or.inr (Or.inr (Or.inl rfl)))) hledger
  · exact reservoirSpreadCarrier_flatPhase_flat_fill_step hphase
      (Or.inr (Or.inr (Or.inr (Or.inr rfl)))) hledger

/-- **The regulated per-piece step from either carrier phase.** The single regulator entry the bag
cycle quotes: it folds the two per-phase regulated steps
(`reservoirSpreadCarrier_flatPhase_regulated_step` and `reservoirSpreadCarrier_SZPhase_regulated_step`)
into one move keyed on the bag phase, so the caller no longer has to know which phase shape the surface
currently presents. From the phase disjunction `IsFlatPhaseReservoirAtS 2 base b ∨
IsSZPhaseReservoirAtS 2 base b`, with floor `4 ≤ base`, band top `base + 2 ≤ 16`, and the bag-clock
ledger, the player has a valid placement of the drawn piece `p` whose post-move board re-enters the
bare spread carrier under `T.draw p`. In the flat branch the hypothesis `hflat` supplies the
restriction that `p` is one of the five flats `{O, I, T, L, J}` exactly when the flat phase is live —
which is automatic in context, since both staircases have already been drawn by the time the bag
reaches the flat phase, so neither `S` nor `Z` is owed. In the S/Z branch all seven pieces are
absorbed directly. Either way the once-per-bag `I` drains the reserved well while every other piece is
seated at the unchanged floor, so whichever phase the bag is in the surface has a height-bounded
response to the adversary's next piece. The landing surface is a bare spread band, so re-presenting the
phase shape for the next piece stays the residual obligation discharged across the bag. -/
theorem reservoirSpreadCarrier_phase_regulated_step {T : Bag} {base : ℕ} {b : Board} {p : Piece}
    (hphase : IsFlatPhaseReservoirAtS 2 base b ∨ IsSZPhaseReservoirAtS 2 base b)
    (hflat : IsFlatPhaseReservoirAtS 2 base b →
      (p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J))
    (hfloor : 4 ≤ base) (hcap : base + 2 ≤ 16)
    (hledger : base + 2 + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard b { pl with piece := p }) := by
  rcases hphase with hflat' | hsz
  · exact reservoirSpreadCarrier_flatPhase_regulated_step hflat' (hflat hflat') hfloor hcap hledger
  · exact reservoirSpreadCarrier_SZPhase_regulated_step hsz hfloor hcap hledger

/-- **The regulated per-piece step from either phase, with its survival certificate.** The
survival-annotated form of `reservoirSpreadCarrier_phase_regulated_step`: the same regulator move,
but now the post-move board is additionally certified to have not topped out. The transition half is
exactly the phase regulated step (drain on the once-per-bag `I`, absorb every other piece), and the
survival half is read straight off the destination carrier membership by
`reservoirSpreadCarrier_not_isLost` — the spread band's floor-pinned top cap keeps every column under
`rows`, so the board the step lands on is never lost. This is the shape a per-bag survival schedule
consumes at every intermediate drop: it needs both that the step re-enters the carrier under
`T.draw p` AND that the intermediate board the adversary forced is safe, and this brick delivers the
pair in one move. Because the survival face is uniform across both phases and all seven pieces, the
schedule can thread it through any adversarial order without re-deriving safety per piece. -/
theorem reservoirSpreadCarrier_phase_regulated_step_safe {T : Bag} {base : ℕ} {b : Board} {p : Piece}
    (hphase : IsFlatPhaseReservoirAtS 2 base b ∨ IsSZPhaseReservoirAtS 2 base b)
    (hflat : IsFlatPhaseReservoirAtS 2 base b →
      (p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J))
    (hfloor : 4 ≤ base) (hcap : base + 2 ≤ 16)
    (hledger : base + 2 + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard b { pl with piece := p }) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard b { pl with piece := p }) := by
  obtain ⟨pl, hpiece, hvalid, hcarrier⟩ :=
    reservoirSpreadCarrier_phase_regulated_step hphase hflat hfloor hcap hledger
  exact ⟨pl, hpiece, hvalid, hcarrier, reservoirSpreadCarrier_not_isLost _ _ hcarrier⟩

/-- **The once-per-bag drain from the bare spread band, with its survival certificate.** The
drain-side companion of `reservoirSpreadCarrier_phase_regulated_step_safe`: where that brick certifies
the absorbing fills (and the off-the-phase regulated step) are safe, this one certifies the regulator
drain itself. On any floor-pinned spread band whose floor is at least four and whose top sits at
`base + s ≤ 16`, dropping the vertical `I` into the reserved empty well clears four full rows and
re-enters `reservoirSpreadCarrier (T.draw Piece.I)` (`reservoirSpreadCarrier_vertI_drain_cap`); the
destination carrier membership then certifies the drained board has not topped out
(`reservoirSpreadCarrier_not_isLost`). Together with the fill-safe step this gives the two moves a
per-bag survival schedule alternates between — absorb on the six non-regulator pieces, drain on the
guaranteed `I` — each delivering both the carrier re-entry under `T.draw p` and the `¬ isLost`
certificate the schedule threads through every adversarial order. Unlike the fill, the drain reads its
band directly off the bare carrier vocabulary, so it needs no phase shape to fire: the reserved well is
always present, so the regulator is always available once the floor has risen far enough to clear. -/
theorem reservoirSpreadCarrier_vertI_drain_cap_safe {T : Bag} {b : Board} {base s : ℕ}
    (hband : Board.IsSpreadBoundedRWSkylineAt GameConfig.standard s base b)
    (hfloor : 4 ≤ base) (hcap : base + s ≤ 16) :
    ∃ plI : Placement, plI.piece = Piece.I ∧ plI.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw Piece.I)
        (Placement.applyStep GameConfig.standard b plI) ∧
      ¬ Board.isLost GameConfig.standard (Placement.applyStep GameConfig.standard b plI) := by
  obtain ⟨plI, hpiece, hvalid, hcarrier⟩ :=
    reservoirSpreadCarrier_vertI_drain_cap (T := T) hband hfloor hcap
  exact ⟨plI, hpiece, hvalid, hcarrier, reservoirSpreadCarrier_not_isLost _ _ hcarrier⟩

/-- **The two-staircase burst exits into the carrier, with its survival certificate.** The survival
face of `reservoirDoubleSZSurface_SZ_burst_carrier`: on the killer adversary order — `S` immediately
followed by `Z`, the order the two reserved valleys exist to survive — the post-burst board not only
re-enters `reservoirSpreadCarrier ((T.draw S).draw Z)` at the unchanged floor `base`, it is also
certified to have not topped out. The carrier membership comes from the burst exit edge; the
`¬ isLost` verdict is read straight off it by `reservoirSpreadCarrier_not_isLost`, since the
spread-band top cap keeps every column under `rows`. This is the loss-avoidance verdict for the
worst-case two-staircase delivery: whichever moment the adversary forces the burst, the surface it
lands on is safe, so a per-bag survival schedule can quote this pair (carrier re-entry plus safety) to
neutralise the `S`-then-`Z` order without re-deriving either face. -/
theorem reservoirDoubleSZSurface_SZ_burst_carrier_safe {T : Bag} {base : ℕ}
    (hledger : base + 2 + ((T.draw Piece.S).draw Piece.Z).card + 1 ≤ GameConfig.standard.rows) :
    reservoirSpreadCarrier ((T.draw Piece.S).draw Piece.Z)
      (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.S, rot := 0, col := 2 })
        { piece := Piece.Z, rot := 0, col := 5 }) ∧
    ¬ Board.isLost GameConfig.standard
      (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
          { piece := Piece.S, rot := 0, col := 2 })
        { piece := Piece.Z, rot := 0, col := 5 }) := by
  have hcarrier := reservoirDoubleSZSurface_SZ_burst_carrier (T := T) (base := base) hledger
  exact ⟨hcarrier, reservoirSpreadCarrier_not_isLost _ _ hcarrier⟩

/-- **The mid-bag flat-`O` interruption exits safely into the carrier.** The survival face of
`reservoirDoubleSZSurface_O_lipShelf_carrier`, and the flat-interruption companion of
`reservoirDoubleSZSurface_SZ_burst_carrier_safe`: when the adversary slips a flat `O` in before the
owed staircases land, the lip-shelf landing parks it on the shared lips (columns `4, 5`) without
touching either valley, and the post-`O` board both re-enters `reservoirSpreadCarrier (T.draw O)` (at
the one extra unit of spread the shelf spent) AND is certified to have not topped out
(`reservoirSpreadCarrier_not_isLost`). Together with the burst-safe brick this survival-certifies the
double-valley phase's two response classes — absorb a flat on its lips, or discharge both owed
staircases into their valleys — so whichever of these the adversary forces while the drain is still
owed, the surface it lands on is a safe carrier member, and the schedule quotes the pair without
re-deriving safety. The valleys stay pristine under the `O`, so the staircase burst remains available
afterward. -/
theorem reservoirDoubleSZSurface_O_lipShelf_carrier_safe {T : Bag} {base : ℕ}
    (hledger : base + 3 + (T.draw Piece.O).card + 1 ≤ GameConfig.standard.rows) :
    reservoirSpreadCarrier (T.draw Piece.O)
      (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.O, rot := 0, col := 4 }) ∧
    ¬ Board.isLost GameConfig.standard
      (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.O, rot := 0, col := 4 }) := by
  have hcarrier := reservoirDoubleSZSurface_O_lipShelf_carrier (T := T) (base := base) hledger
  exact ⟨hcarrier, reservoirSpreadCarrier_not_isLost _ _ hcarrier⟩

/-- **The lone first staircase exits safely into the carrier.** The survival face of
`reservoirDoubleSZSurface_S_carrier`, the single-`S` companion of
`reservoirDoubleSZSurface_SZ_burst_carrier_safe`: when the adversary opens the bag with `S`, seating
it in valley1 (`{S, rot 0, col 2}`) not only re-enters `reservoirSpreadCarrier (T.draw S)` at the
unchanged floor `base`, the post-`S` board is certified to have not topped out
(`reservoirSpreadCarrier_not_isLost`). Together with the burst-safe and `O`-interruption-safe bricks
this survival-certifies the double-valley surface's first-move responses, so whichever opening the
adversary plays while the drain is still owed, the surface it lands on is a safe carrier member and
the schedule quotes the pair without re-deriving safety. Valley2 stays pristine for the owed `Z`. -/
theorem reservoirDoubleSZSurface_S_carrier_safe {T : Bag} {base : ℕ}
    (hledger : base + 2 + (T.draw Piece.S).card + 1 ≤ GameConfig.standard.rows) :
    reservoirSpreadCarrier (T.draw Piece.S)
      (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.S, rot := 0, col := 2 }) ∧
    ¬ Board.isLost GameConfig.standard
      (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.S, rot := 0, col := 2 }) := by
  have hcarrier := reservoirDoubleSZSurface_S_carrier (T := T) (base := base) hledger
  exact ⟨hcarrier, reservoirSpreadCarrier_not_isLost _ _ hcarrier⟩

/-- **The lone second staircase exits safely into the carrier.** The single-`Z` mirror of
`reservoirDoubleSZSurface_S_carrier_safe`: opening the bag with `Z` and seating it in valley2
(`{Z, rot 0, col 5}`) re-enters `reservoirSpreadCarrier (T.draw Z)` at the unchanged floor `base`
and the post-`Z` board is certified to have not topped out (`reservoirSpreadCarrier_not_isLost`),
with valley1 left pristine for the owed `S`. With the `S`-carrier-safe, burst-safe, and
`O`-interruption-safe bricks, every opening move on the double-valley surface now carries both the
carrier re-entry and the `¬ isLost` certificate the per-bag survival schedule threads through any
adversarial order. -/
theorem reservoirDoubleSZSurface_Z_carrier_safe {T : Bag} {base : ℕ}
    (hledger : base + 2 + (T.draw Piece.Z).card + 1 ≤ GameConfig.standard.rows) :
    reservoirSpreadCarrier (T.draw Piece.Z)
      (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.Z, rot := 0, col := 5 }) ∧
    ¬ Board.isLost GameConfig.standard
      (Placement.applyStep GameConfig.standard
        (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base))
        { piece := Piece.Z, rot := 0, col := 5 }) := by
  have hcarrier := reservoirDoubleSZSurface_Z_carrier (T := T) (base := base) hledger
  exact ⟨hcarrier, reservoirSpreadCarrier_not_isLost _ _ hcarrier⟩

/-- **The double-valley surface's first-move dispatcher over `{S, Z, O, I}`.** A single statement
bundling the four opening responses the two-valley reset surface can answer: the two staircases into
their reserved valleys (`reservoirDoubleSZSurface_S_carrier` / `_Z_carrier`), the flat `O` onto the
shared lip-shelf (`reservoirDoubleSZSurface_O_lipShelf_carrier`), and the once-per-bag `I` into the
reserved well (`reservoirDoubleSZSurface_vertI_drain_carrier`). For any opening piece
`p ∈ {S, Z, O, I}`, with floor at least four and the destination ledger
`base + 3 + (T.draw p).card + 1 ≤ rows` (the worst case being the lip-shelf `O`'s one extra spread
unit, which dominates the staircases and the lowered-floor drain), there is a valid placement of `p`
whose landing both re-enters `reservoirSpreadCarrier (T.draw p)` and is certified to have not topped
out. This is the shape a per-bag survival schedule consumes at the bag boundary: hand it the drawn
piece and it returns the move plus the carrier-and-safety pair, with no per-piece case analysis at
the call site. The owed flats `T`, `L`, `J` are exactly the openings this surface cannot host — the
genuine bag-phase obstruction left to the richer multi-shape carrier. -/
theorem reservoirDoubleSZSurface_firstMove_dispatch {T : Bag} {base : ℕ} {p : Piece}
    (hp : p = Piece.S ∨ p = Piece.Z ∨ p = Piece.O ∨ p = Piece.I)
    (hbase : 4 ≤ base)
    (hledger : base + 3 + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base)) pl) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirDoubleSZSurface base)) pl) := by
  rcases hp with rfl | rfl | rfl | rfl
  · have hc := reservoirDoubleSZSurface_S_carrier (T := T) (base := base) (by omega)
    exact ⟨{ piece := Piece.S, rot := 0, col := 2 }, rfl, Board.valid_S (by decide), hc,
      reservoirSpreadCarrier_not_isLost _ _ hc⟩
  · have hc := reservoirDoubleSZSurface_Z_carrier (T := T) (base := base) (by omega)
    exact ⟨{ piece := Piece.Z, rot := 0, col := 5 }, rfl, Board.valid_Z (by decide), hc,
      reservoirSpreadCarrier_not_isLost _ _ hc⟩
  · have hc := reservoirDoubleSZSurface_O_lipShelf_carrier (T := T) (base := base) (by omega)
    exact ⟨{ piece := Piece.O, rot := 0, col := 4 }, rfl, Board.valid_O (by decide), hc,
      reservoirSpreadCarrier_not_isLost _ _ hc⟩
  · obtain ⟨plI, hpiece, hvalid, hc⟩ :=
      reservoirDoubleSZSurface_vertI_drain_carrier (T := T) (base := base) hbase (by omega)
    exact ⟨plI, hpiece, hvalid, hc, reservoirSpreadCarrier_not_isLost _ _ hc⟩

/-- **The all-seven first move on the concrete S/Z phase surface.** The strictly stronger companion of
`reservoirDoubleSZSurface_firstMove_dispatch` (iter393): where the double-valley opening served only
the four pieces with a width-three landing site (`S`, `Z`, `O`, and the well-draining `I`), the
concrete S/Z phase surface `reservoirSZSurface` hosts every one of the seven pieces. It is the concrete
instance of `reservoirSpreadCarrier_SZPhase_regulated_step` at the realised surface: the surface is an
`IsSZPhaseReservoirAtS 2 base` member (`isSZPhaseReservoirAtS_reservoirSZSurface`, whose cap obligation
`base + 2 ≤ rows` is read off the carrier ledger), so for the drawn piece `p` the regulator either
drops the once-per-bag `I` into the reserved well — clearing four rows and draining the floor to
`base` minus four — or seats any of the other six pieces into its reserved valley or pocket at the
unchanged floor `base`, and either way re-enters the spread carrier under `T.draw p`. The survival
certificate is read straight off the destination membership by `reservoirSpreadCarrier_not_isLost`, so
the post-move board is additionally certified never to have topped out. This is the all-piece opening
the bag-level closure quotes for the S/Z phase: whatever the adversary draws first, the concrete
surface has a height-bounded, non-losing response. What stays open is the phase REGENERATION the next
piece needs — re-presenting the valley-and-pocket shape rather than the bare spread band the fill lands
on — which the ten-column budget forces to be bag-phase-aware. -/
theorem reservoirSZSurface_firstMove_dispatch {T : Bag} {base : ℕ} {p : Piece}
    (hfloor : 4 ≤ base) (hcap : base + 2 ≤ 16)
    (hledger : base + 2 + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirSZSurface base)) { pl with piece := p }) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirSZSurface base)) { pl with piece := p }) := by
  obtain ⟨pl, hpiece, hvalid, hc⟩ :=
    reservoirSpreadCarrier_SZPhase_regulated_step
      (isSZPhaseReservoirAtS_reservoirSZSurface (s := 2) (base := base) (by omega) (by omega))
      hfloor hcap hledger
  exact ⟨pl, hpiece, hvalid, hc, reservoirSpreadCarrier_not_isLost _ _ hc⟩

/-- **The five-flat first move on the concrete flat phase surface.** The flat-phase companion of
`reservoirSZSurface_firstMove_dispatch` (iter394): on the concrete flat reset surface
`reservoirFlatSurface` (reserved well at column `0`, a wide flat run at columns `1` through `9`, all at
floor `base`), each of the five flats `p ∈ {O, I, T, L, J}` has a valid opening that lands in the
spread carrier without topping out. It is the concrete instance of
`reservoirSpreadCarrier_flatPhase_regulated_step` at the realised surface: the surface is an
`IsFlatPhaseReservoirAtS 2 base` member (`isFlatPhaseReservoirAtS_reservoirFlatSurface`, whose cap
obligation `base + 2 ≤ rows` is read off the carrier ledger), so for the drawn flat `p` the regulator
either drops the once-per-bag `I` into the reserved well — clearing four rows and draining the floor to
`base` minus four — or seats any of the other four flats flush on the wide run at the unchanged floor
`base`, and either way re-enters the spread carrier under `T.draw p`. The survival certificate is read
straight off the destination membership by `reservoirSpreadCarrier_not_isLost`. Together with the S/Z
first move this gives the opening move at both concrete reset surfaces: the flat surface fields the
five flats the steady-state bag draws, the S/Z surface fields all seven while a staircase is still
owed. What stays open is the phase REGENERATION the next piece needs — re-presenting the flat run shape
rather than the bare spread band the fill lands on — which the ten-column budget forces to be
bag-phase-aware. -/
theorem reservoirFlatSurface_firstMove_dispatch {T : Bag} {base : ℕ} {p : Piece}
    (hp : p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J)
    (hfloor : 4 ≤ base) (hcap : base + 2 ≤ 16)
    (hledger : base + 2 + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirFlatSurface base)) { pl with piece := p }) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Board.skyline GameConfig.standard (reservoirFlatSurface base)) { pl with piece := p }) := by
  obtain ⟨pl, hpiece, hvalid, hc⟩ :=
    reservoirSpreadCarrier_flatPhase_regulated_step
      (isFlatPhaseReservoirAtS_reservoirFlatSurface (s := 2) (base := base) (by omega))
      hp hfloor hcap hledger
  exact ⟨pl, hpiece, hvalid, hc, reservoirSpreadCarrier_not_isLost _ _ hc⟩

/-- **The width-parametric flat run absorbs a flat into the spread carrier, at any run width.** The
flat half of the carrier closure, stated on the SHRINKING run rather than the fixed width-eight phase
shape: it is the generalisation of `reservoirSpreadCarrier_flatPhase_flat_fill_step` from
`IsFlatPhaseReservoirAtS` (run width pinned to eight) to `IsFlatRunReservoirAt w` at every width
`w ≥ 8`. The run width is the genuine bag-phase index — it counts how much landing room the bag has
spent — so the same fill edge must fire whatever width the run has shrunk to. From an
`IsFlatRunReservoirAt w s base` board with `w ≥ 8` and buffer `s ≥ 2`, the five-piece run reducer
(`isFlatRunReservoirAt_nonStaircase_step`) seats any flat `p ∈ {O, I, T, L, J}` flush on the run,
landing in a narrower run `IsFlatRunReservoirAt w' s base` at the SAME floor `base` and spread `s`
(the flat podiums reach at most `base + 2 ≤ base + s`); forgetting that run to its floor-pinned spread
band (`isSpreadBoundedRWSkylineAt_of_isFlatRunReservoirAt`) and pairing with the carrier ledger
re-enters `reservoirSpreadCarrier (T.draw p)`. Because the floor and spread are unchanged the fill
spends no ledger headroom beyond the one bag-clock tick the draw already books. What stays open is the
run REGENERATION the next bag needs — the once-per-bag drain replenishing the width the fills consume —
which the ten-column budget forces to be bag-phase-aware. -/
theorem reservoirSpreadCarrier_flatRun_fill_step {T : Bag} {w s base : ℕ} {b : Board} {p : Piece}
    (hb : IsFlatRunReservoirAt w s base b) (hw8 : 8 ≤ w) (hs2 : 2 ≤ s)
    (hp : p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J)
    (hledger : base + s + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard b pl) := by
  obtain ⟨pl, hpc, hv, w', hw', hout⟩ :=
    isFlatRunReservoirAt_nonStaircase_step hb hw8 hs2 hp
  exact ⟨pl, hpc, hv, base, s,
    isSpreadBoundedRWSkylineAt_of_isFlatRunReservoirAt hout, hledger⟩

/-- **The width-parametric flat run drains into the spread carrier — the regulator half.** The exact
complement of `reservoirSpreadCarrier_flatRun_fill_step` (iter377): where each non-`I` fill shrinks the
run width at a pinned floor, the once-per-bag well-`I` drops the floor by four at a fixed width, and
both edges land back in the front-door `reservoirSpreadCarrier`. From any `IsFlatRunReservoirAt w s base`
run whose floor is at least four, dropping the vertical `I` into the reserved empty well at column `0`
clears four full rows (`isFlatRunReservoirAt_full_drain`), descending the run to floor `base - 4` with
its width and spread unchanged; forgetting that drained run to its floor-pinned spread band
(`isSpreadBoundedRWSkylineAt_of_isFlatRunReservoirAt`) and pairing with the carrier ledger re-enters
`reservoirSpreadCarrier (T.draw Piece.I)`. The destination ledger is strictly easier than the source
one: the drained floor `base - 4` is four below `base`, so any headroom budget the pre-drain band met
the post-drain band meets with room to spare. Together with the fill edge this is the run's
rise-and-reset half-cycle expressed entirely at the carrier boundary in run vocabulary: the fills spend
run width raising the stack, this drain buys back four rows of floor, and neither leaves the spread-band
carrier the front-door closure threads. What stays open is still the bag-phase regeneration of the run
width the fills consume, which the ten-column budget forces to be owed-aware. -/
theorem reservoirSpreadCarrier_flatRun_drain_step {T : Bag} {w s base : ℕ} {b : Board}
    (hb : IsFlatRunReservoirAt w s base b) (hbase4 : 4 ≤ base)
    (hledger : (base - 4) + s + (T.draw Piece.I).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = Piece.I ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw Piece.I)
        (Placement.applyStep GameConfig.standard b pl) :=
  ⟨{ piece := Piece.I, rot := 1, col := 0 }, rfl,
    Board.valid_vertI (show (0 : ℕ) < GameConfig.standard.cols by decide),
    base - 4, s,
    isSpreadBoundedRWSkylineAt_of_isFlatRunReservoirAt
      (isFlatRunReservoirAt_full_drain hb hbase4),
    hledger⟩

/-- **The per-piece fill-then-drain net half-cycle lands in the spread carrier.** The carrier-boundary
lift of the run-level `isFlatRunReservoirAt_nonStaircase_fillDrain` (iter351), composing the two edges
of the previous two iterations into one net transition: from a width-`w ≥ 8`, spread-`s ≥ 2`,
floor-`≥ 4` flat run, seating any flat `p ∈ {O, I, T, L, J}` flush on the run and then dropping the
guaranteed well-`I` lands — after BOTH placements — in a narrower run at the lowered floor `base - 4`
(`isFlatRunReservoirAt_nonStaircase_fillDrain`), which forgets to its floor-pinned spread band
(`isSpreadBoundedRWSkylineAt_of_isFlatRunReservoirAt`) and re-enters
`reservoirSpreadCarrier ((T.draw p).draw Piece.I)` under the post-pair bag clock. This is the exact
per-piece bag accounting expressed at the front door: each non-`I` flat spends at most four columns of
run, and the once-per-bag `I` buys back four rows of floor, so the pair nets a strictly lower band that
still satisfies the carrier ledger (the drained floor `base - 4` is four below the source). It bundles
the fill half (`reservoirSpreadCarrier_flatRun_fill_step`, iter377) and the drain half
(`reservoirSpreadCarrier_flatRun_drain_step`, iter378) into the single rise-and-reset unit a bag-phase
closure iterates — the smallest two-move step that both absorbs a piece and resets the floor without
leaving the spread carrier. What stays open is the run-width REGENERATION the next bag needs, which the
ten-column budget forces to be bag-phase-aware. -/
theorem reservoirSpreadCarrier_flatRun_fillDrain_step {T : Bag} {w s base : ℕ} {b : Board} {p : Piece}
    (hb : IsFlatRunReservoirAt w s base b) (hw8 : 8 ≤ w) (hs2 : 2 ≤ s) (hbase4 : 4 ≤ base)
    (hp : p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J)
    (hledger : (base - 4) + s + ((T.draw p).draw Piece.I).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl plI : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      plI.piece = Piece.I ∧ plI.Valid GameConfig.standard ∧
      reservoirSpreadCarrier ((T.draw p).draw Piece.I)
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard b pl) plI) := by
  obtain ⟨pl, w', hpiece, hvalid, _, hdrain⟩ :=
    isFlatRunReservoirAt_nonStaircase_fillDrain hb hw8 hs2 hbase4 hp
  exact ⟨pl, { piece := Piece.I, rot := 1, col := 0 }, hpiece, hvalid, rfl,
    Board.valid_vertI (show (0 : ℕ) < GameConfig.standard.cols by decide),
    base - 4, s,
    isSpreadBoundedRWSkylineAt_of_isFlatRunReservoirAt hdrain, hledger⟩

/-- **A wide flat run absorbs two consecutive flats, spending at most eight columns.** The two-piece
chaining of the per-piece reducer `isFlatRunReservoirAt_nonStaircase_step`, making the linear width
budget explicit: the run width is the bag-phase reservoir of landing room, and each non-staircase flat
spends at most four of it. So a run of width `w ≥ 12` seats a first flat `p ∈ {O, I, T, L, J}` flush on
its left — landing in a run of width `w' ≥ w - 4 ≥ 8`, still wide enough for the reducer — and then a
second flat `q ∈ {O, I, T, L, J}` on the narrower run, landing in `IsFlatRunReservoirAt w'' s base` with
`w'' ≥ w' - 4 ≥ 4` at the SAME floor `base` and spread `s`. Both placements are valid and the well stays
reserved throughout. This is the "holding enough slack to absorb the non-`I` pieces as they arrive"
content stated concretely: a width-twelve run is the reservoir that survives two flats before the floor
must be reset, and the bound `8 ≤ w - 4` is exactly what lets the reducer fire a second time. Chaining
further flats simply demands a proportionally wider starting run (`4k + 4` columns buys `k` flats), the
linear ledger the once-per-bag `I` drain must out-pace — and the ten-column ceiling on that run width is
the precise origin of the bag-phase awareness `#66` forces. -/
theorem isFlatRunReservoirAt_two_nonStaircase {w s base : ℕ} {b : Board} {p q : Piece}
    (hb : IsFlatRunReservoirAt w s base b) (hw12 : 12 ≤ w) (hs2 : 2 ≤ s)
    (hp : p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J)
    (hq : q = Piece.O ∨ q = Piece.I ∨ q = Piece.T ∨ q = Piece.L ∨ q = Piece.J) :
    ∃ (pl₁ pl₂ : Placement) (w'' : ℕ), pl₁.piece = p ∧ pl₁.Valid GameConfig.standard ∧
      pl₂.piece = q ∧ pl₂.Valid GameConfig.standard ∧ 4 ≤ w'' ∧
      IsFlatRunReservoirAt w'' s base
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard b pl₁) pl₂) := by
  obtain ⟨pl₁, hp1, hv1, w', hw', hrun1⟩ :=
    isFlatRunReservoirAt_nonStaircase_step hb (by omega) hs2 hp
  obtain ⟨pl₂, hp2, hv2, w'', hw'', hrun2⟩ :=
    isFlatRunReservoirAt_nonStaircase_step hrun1 (by omega) hs2 hq
  exact ⟨pl₁, pl₂, w'', hp1, hv1, hp2, hv2, by omega, hrun2⟩

/-- **Iterated well-drain: `n` once-per-bag `I` drains lower the floor by exactly `4n`.** The
multi-bag floor-descent law, iterating the single-bag regulator `isFlatRunReservoirAt_full_drain`:
dropping the vertical `I` into the reserved well `n` times, on a flat run whose floor can afford the
total descent (`4 * n ≤ base`), lands in an `IsFlatRunReservoirAt w s (base - 4 * n)` run — width and
spread untouched, the floor lowered by four per drain. The proof is a clean induction on `n`: the empty
schedule is the identity, and each extra drain peels one `full_drain` off the front of the remaining
budget (`base - 4 * k - 4 = base - 4 * (k + 1)`). This is the formal content of "a drain is always
available before the limit is reached": however many bags the run has climbed through, as long as the
floor banked at least `4 * n` rows of headroom, the well can absorb `n` regulator clears and reset the
floor that far. It is the cumulative complement to the width budget `isFlatRunReservoirAt_two_nonStaircase`
(fills spend run width at a fixed floor; these drains spend floor at a fixed width), and the descent is
linear, so the multi-bag accounting is just the race between the two linear ledgers. -/
theorem isFlatRunReservoirAt_iter_drain {w s base : ℕ} {b : Board} (n : ℕ)
    (hb : IsFlatRunReservoirAt w s base b) (hbase : 4 * n ≤ base) :
    IsFlatRunReservoirAt w s (base - 4 * n)
      ((fun b' => Placement.applyStep GameConfig.standard b'
        { piece := Piece.I, rot := 1, col := 0 })^[n] b) := by
  revert hbase
  induction n with
  | zero => intro _; simpa using hb
  | succ k ih =>
    intro hbase
    simp only [Function.iterate_succ', Function.comp_apply]
    have hdrain := isFlatRunReservoirAt_full_drain (ih (by omega)) (by omega)
    have heq : base - 4 * k - 4 = base - 4 * (k + 1) := by omega
    rwa [heq] at hdrain

/-- **The empty board is the maximal flat run reservoir at floor zero — the run-vocabulary entry
point.** With the well reserved at column `0` and the floor pinned to `0`, the empty board reads as
an `IsFlatRunReservoirAt 9 2 0` board: a width-nine flat run across columns `1 .. 9` at height `0`,
spread `2`. Nine is the widest run the ten-column board can host once column `0` is banked for the
reserved well (`10` minus `1`), so this is the entry point every run-based carrier descends from. The
proof reuses the same witness skeleton as `isLevelPocketBandAt_empty`: the constant-zero skyline
`fun _ => 0` forgotten through `skyline_zero_eq_empty`, with run start `pc = 1`. Note the width-nine
run sits below the width-twelve threshold `isFlatRunReservoirAt_two_nonStaircase` needs to chain two
flats, which is the honest structural fact behind `#66`: the empty board's run can absorb one flat and
must then drain before refilling — the ten-column ceiling forbids a single fresh run wide enough to
host a whole bag at once, so bag-phase awareness is forced from the very first board. -/
theorem isFlatRunReservoirAt_empty :
    IsFlatRunReservoirAt 9 2 0 Board.empty := by
  refine ⟨fun _ => 0, 1, (Board.skyline_zero_eq_empty GameConfig.standard).symm, rfl,
    ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro j _ _; simp
  · decide
  · decide
  · decide
  · decide
  · intro i _; rfl

/-- **Arbitrary-order fill budget: a width-`(4n + 4)` run absorbs any `n` non-staircase pieces in any
order.** The adversarial-order complement to `isFlatRunReservoirAt_iter_drain` (which spent floor at a
fixed width); here the adversary hands an arbitrary length-`n` list `ps` of non-staircase pieces
(`O, I, T, L, J` in any order), and a run wide enough to bank four columns per piece plus a width-four
remainder (`4 * ps.length + 4 ≤ w`) seats every one of them: there is a list of valid placements `pls`
realising exactly that piece order (`pls.map (·.piece) = ps`), all valid, whose left-fold lands in an
`IsFlatRunReservoirAt w' s base` run of width `w' ≥ 4` at the SAME floor `base`. The proof is a clean
list induction threading the board and the shrinking width through `isFlatRunReservoirAt_nonStaircase_step`
(each step needs only `8 ≤ w`, which the budget `4 * (rest.length + 1) + 4 ≤ w` supplies, and drops the
run by at most four). This is the "holding enough slack to absorb the non-`I` pieces as they arrive"
content made order-independent: whatever order the adversary chooses the six non-`I` pieces, a run of
width `4 * 6 + 4 = 28` columns would host them — except the board is only ten wide, so the run caps at
nine and the once-per-bag `I` drain must regenerate the width between bags. The gap between the `28`
columns the budget wants and the `9` the board affords is exactly the bag-phase pressure `#66` names. -/
theorem isFlatRunReservoirAt_iter_nonStaircase {s base : ℕ} (hs2 : 2 ≤ s) :
    ∀ (ps : List Piece) (w : ℕ) (b : Board),
      IsFlatRunReservoirAt w s base b →
      4 * ps.length + 4 ≤ w →
      (∀ p ∈ ps, p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J) →
      ∃ (pls : List Placement) (w' : ℕ),
        pls.map (·.piece) = ps ∧
        (∀ pl ∈ pls, pl.Valid GameConfig.standard) ∧
        4 ≤ w' ∧
        IsFlatRunReservoirAt w' s base
          (pls.foldl (fun b' pl => Placement.applyStep GameConfig.standard b' pl) b) := by
  intro ps
  induction ps with
  | nil =>
    intro w b hb hbudget _
    refine ⟨[], w, rfl, ?_, ?_, ?_⟩
    · simp
    · simpa using hbudget
    · simpa using hb
  | cons p rest ih =>
    intro w b hb hbudget hps
    simp only [List.length_cons] at hbudget
    obtain ⟨pl, hpc, hv, w₁, hw₁, hout⟩ :=
      isFlatRunReservoirAt_nonStaircase_step hb (by omega) hs2 (hps p (by simp))
    obtain ⟨pls', w', hmap, hvalid, hw'4, hfold⟩ :=
      ih w₁ (Placement.applyStep GameConfig.standard b pl) hout (by omega)
        (fun q hq => hps q (List.mem_cons_of_mem p hq))
    refine ⟨pl :: pls', w', ?_, ?_, hw'4, ?_⟩
    · simp [hpc, hmap]
    · intro pl'' hpl''
      rcases List.mem_cons.mp hpl'' with rfl | hmem
      · exact hv
      · exact hvalid pl'' hmem
    · simpa [List.foldl_cons] using hfold

/-- **The worst-case bag cycle on the run: all fills first, then the once-per-bag drain.** Composing
the arbitrary-order fill budget (`isFlatRunReservoirAt_iter_nonStaircase`) with the width-preserving
well-`I` drain (`isFlatRunReservoirAt_full_drain`) realises the adversary's hardest single-bag order —
every non-staircase piece arriving before the regulator `I`. From a width-`(4n + 4)` run at floor
`base ≥ 4`, any length-`n` list `ps` of non-staircase pieces, in any order, is seated by a list of valid
placements that, followed by the vertical `I` dropped into the reserved well, returns to an
`IsFlatRunReservoirAt w' s (base - 4)` run (`w' ≥ 4`): the realised placement order is exactly
`ps ++ [I]`, the floor has dropped by the four rows the bag's guaranteed `I` clears, and the spread `s`
is untouched. This is the "use the once-per-bag I to drain back down and reset" content for the
all-fills-first phase, with the fills' linear width appetite `4 * n + 4` laid bare against the floor's
single four-row refund: at `n = 6` the order-independent budget asks for `28` columns of run that the
ten-wide board cannot supply, which is why the bag-phase carrier may not keep one fixed run but must let
the surface build within its band between drains. The drain re-uses the floor the fills leave pinned, so
the two halves chain with no extra side condition beyond `base ≥ 4`. -/
theorem isFlatRunReservoirAt_iter_nonStaircase_drain {s base w : ℕ} {b : Board} {ps : List Piece}
    (hb : IsFlatRunReservoirAt w s base b) (hs2 : 2 ≤ s) (hbase4 : 4 ≤ base)
    (hbudget : 4 * ps.length + 4 ≤ w)
    (hps : ∀ p ∈ ps, p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J) :
    ∃ (pls : List Placement) (w' : ℕ),
      pls.map (·.piece) = ps ++ [Piece.I] ∧
      (∀ pl ∈ pls, pl.Valid GameConfig.standard) ∧
      4 ≤ w' ∧
      IsFlatRunReservoirAt w' s (base - 4)
        (pls.foldl (fun b' pl => Placement.applyStep GameConfig.standard b' pl) b) := by
  obtain ⟨pls₀, w', hmap₀, hvalid₀, hw'4, hfold₀⟩ :=
    isFlatRunReservoirAt_iter_nonStaircase hs2 ps w b hb hbudget hps
  have hdrain := isFlatRunReservoirAt_full_drain hfold₀ hbase4
  refine ⟨pls₀ ++ [{ piece := Piece.I, rot := 1, col := 0 }], w', ?_, ?_, hw'4, ?_⟩
  · simp [List.map_append, hmap₀]
  · intro pl hpl
    rcases List.mem_append.mp hpl with hmem | hmem
    · exact hvalid₀ pl hmem
    · rw [List.mem_singleton.mp hmem]; exact Board.valid_vertI (by decide)
  · simp only [List.foldl_append, List.foldl_cons, List.foldl_nil]
    exact hdrain

/-- **The vertical-stacking O atom on a spread band.** The move the run-width track lacks. Every flat
fill proven so far seats its piece on the band FLOOR (the pocket and run arcs all require `h c = base`),
so each absorption spends a column of floor run and the order-independent budget climbs to `4 * 6 + 4 =
28` columns that the ten-wide board cannot supply (`isFlatRunReservoirAt_iter_nonStaircase_drain`). This
atom spends VERTICAL slack instead: from a floor-pinned spread band whose two adjacent off-well columns
`c, c + 1` share an arbitrary common height `f` anywhere inside the band (`base ≤ f` and the landed
height fits the cap, `f + 2 ≤ base + s`), dropping the `O` flush across them (`applyStep_O_skyline_noclear`,
a no-clear placement since the reserved well keeps every row short) raises both to `f + 2` and lands back
in `IsSpreadBoundedRWSkylineAt standard s base` at the SAME floor `base`. The floor and the well are
untouched; only the band's vertical headroom is spent. This is the second resource the goal's
`reservoir' surface offers — where the run reducer consumes width at a pinned floor, this consumes the
spread budget at a pinned floor, stacking a fresh layer on top of pieces already placed. It is the
spread-`≥ 3` enabler: a band with `s ≥ 3` can stack a non-`I` piece on a height-`base + 1` plateau
without breaching the cap, which is exactly the vertical room a full bag's six non-`I` pieces need before
the once-per-bag `I` drains. The geometric companion of `isSpreadBoundedRWSkylineAt_vertI_well_descend`
(the drain atom): both are pure band-to-band facts the per-bag schedule composes, one stacking up by two,
the other draining down by four. -/
theorem isSpreadBoundedRWSkylineAt_O_vstack {s base f : ℕ} {h : ℕ → ℕ} {w c : ℕ}
    (hw : w < GameConfig.standard.cols) (hw0 : h w = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ w → base ≤ h j ∧ h j ≤ base + s)
    (hcap : base + s ≤ GameConfig.standard.rows)
    (hc : c < GameConfig.standard.cols) (hc1 : c + 1 < GameConfig.standard.cols)
    (hwc : w ≠ c) (hwc1 : w ≠ c + 1)
    (hcf : h c = f) (hc1f : h (c + 1) = f)
    (hflo : base ≤ f) (hfhi : f + 2 ≤ base + s) :
    Board.IsSpreadBoundedRWSkylineAt GameConfig.standard s base
      (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
        { piece := Piece.O, rot := 0, col := c }) := by
  have hO := Board.applyStep_O_skyline_noclear hc hc1 (by rw [hcf, hc1f]) hw hwc hwc1 hw0
  rw [hO]
  refine Board.isSpreadBoundedRWSkylineAt_skyline (floor := base) (w := w) hw ?_ ?_ hcap
  · rw [Function.update_of_ne hwc1, Function.update_of_ne hwc]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (c + 1) with rfl | hjc1'
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjc1']
      rcases eq_or_ne j c with rfl | hjc'
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hjc']; exact hband j hj hjw

/-- **The vertical-stacking `O` atom, lifted to the spread-band carrier** (iter397). The exact
spread-vocabulary analogue of `reservoirSpreadCarrier_flatRun_fill_step`: where the run track spends
WIDTH at a pinned floor, this spends the SPREAD budget (vertical headroom) at a pinned floor. From any
floor-`base` spread-`s` skyline band with a reserved empty well at column `w` and a flat adjacent pair
of columns `c, c+1` both at height `f` with two rows of headroom (`f + 2 ≤ base + s`), dropping the `O`
onto that pair stacks it two rows higher (`isSpreadBoundedRWSkylineAt_O_vstack`) and the result is still
a floor-`base` spread-`s` band, so it re-enters `reservoirSpreadCarrier (T.draw Piece.O)` with the same
ledger. This is the move the run-width track structurally lacked: a `9`-wide band at spread `3` holds
`9 * 3 = 27 ≥ 24` cells, enough vertical room for the six non-`I` pieces of a bag without ever widening
the run, dodging the `4 * 6 + 4 = 28 > 9` width wall of `isFlatRunReservoirAt_iter_nonStaircase_drain`.
What stays open is the bag-phase availability of a flat pair under the spread cap, which the adversary's
piece order still gets to attack. -/
theorem reservoirSpreadCarrier_O_vstack_step {T : Bag} {s base f : ℕ} {h : ℕ → ℕ} {w c : ℕ}
    (hw : w < GameConfig.standard.cols) (hw0 : h w = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ w → base ≤ h j ∧ h j ≤ base + s)
    (hc : c < GameConfig.standard.cols) (hc1 : c + 1 < GameConfig.standard.cols)
    (hwc : w ≠ c) (hwc1 : w ≠ c + 1)
    (hcf : h c = f) (hc1f : h (c + 1) = f)
    (hflo : base ≤ f) (hfhi : f + 2 ≤ base + s)
    (hledger : base + s + (T.draw Piece.O).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = Piece.O ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw Piece.O)
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h) pl) := by
  refine ⟨{ piece := Piece.O, rot := 0, col := c }, rfl, Board.valid_O hc1, base, s, ?_, hledger⟩
  exact isSpreadBoundedRWSkylineAt_O_vstack hw hw0 hband (by omega) hc hc1 hwc hwc1 hcf hc1f hflo hfhi

/-- **The vertical-stacking `O` fill is always available on a flat band** (iter398). The existence
half of the vstack track: where `reservoirSpreadCarrier_O_vstack_step` (iter397) asks the caller to
exhibit a flat adjacent pair, this discharges that obligation outright for a band that is flat at
height `base` across every non-well column with the reserved empty well parked at column `0`. Columns
`1` and `2` are then a flat pair at `base` with two rows of headroom whenever the spread is at least
`2`, so the `O` drops onto them and the result re-enters `reservoirSpreadCarrier (T.draw Piece.O)`.
This is the spread-band counterpart of `isFlatRunReservoirAt_empty`: a fully flat reset surface always
offers the first `O` a landing site. The adversarial-order difficulty it does NOT yet settle is
regeneration — that a flat pair persists after the band is partly raised — which the bag-phase closure
must still supply for the remaining pieces. -/
theorem reservoirSpreadCarrier_flat_O_vstack_step {T : Bag} {s base : ℕ} {h : ℕ → ℕ}
    (hs : 2 ≤ s) (hw0 : h 0 = 0)
    (hflat : ∀ j, 0 < j → j < GameConfig.standard.cols → h j = base)
    (hledger : base + s + (T.draw Piece.O).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = Piece.O ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw Piece.O)
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h) pl) := by
  refine reservoirSpreadCarrier_O_vstack_step (w := 0) (c := 1) (f := base)
    (by decide) hw0 ?_ (by decide) (by decide) (by decide) (by decide)
    (hflat 1 (by decide) (by decide)) (hflat 2 (by decide) (by decide))
    (le_refl base) (by omega) hledger
  intro j hj hjw
  rw [hflat j (Nat.pos_of_ne_zero hjw) hj]; omega

/-- **Column-parametric flat-band `O` fill** (iter399). The same one-move availability as
`reservoirSpreadCarrier_flat_O_vstack_step` but with the landing column `c` a free parameter rather
than pinned to `1`: on a band flat at `base` with the reserved well at column `0`, any interior pair
`(c, c+1)` with `0 < c` and `c+1 < cols` hosts the vertical `O` and keeps the carrier. This is the
move the bag-phase strategy needs to fill a flat layer left to right — it picks the current fill-front
column instead of always stacking on columns `1` and `2`. Regeneration (that a flat pair survives in
the un-raised suffix after each fill) is still owed to the closure. -/
theorem reservoirSpreadCarrier_flat_O_vstack_step_at {T : Bag} {s base c : ℕ} {h : ℕ → ℕ}
    (hs : 2 ≤ s) (hw0 : h 0 = 0)
    (hflat : ∀ j, 0 < j → j < GameConfig.standard.cols → h j = base)
    (hc0 : 0 < c) (hc1 : c + 1 < GameConfig.standard.cols)
    (hledger : base + s + (T.draw Piece.O).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = Piece.O ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw Piece.O)
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h) pl) := by
  have hcols : c < GameConfig.standard.cols := by omega
  refine reservoirSpreadCarrier_O_vstack_step (w := 0) (c := c) (f := base)
    (by decide) hw0 ?_ hcols hc1 (by omega) (by omega)
    (hflat c hc0 hcols) (hflat (c + 1) (by omega) hc1)
    (le_refl base) (by omega) hledger
  intro j hj hjw
  rw [hflat j (Nat.pos_of_ne_zero hjw) hj]; omega

/-- **Flat-pair regeneration: a second `O` survives the first fill** (iter400). The first concrete
proof that a landing pair PERSISTS after a partial fill — the existence core of the adversarial-order
crux for the all-`O` sub-case. Starting from a band flat at `base` with the reserved well at column
`0`, the vertical `O` at columns `(1,2)` raises them to `base + 2` (`applyStep_O_skyline_noclear`) but
leaves columns `3, 4` untouched at `base`; since the whole post-fill band still lies in
`[base, base + 2] ⊆ [base, base + s]`, the GENERAL atom `reservoirSpreadCarrier_O_vstack_step`
(iter397) fires again at `(3,4)` and keeps the carrier. So two `O`s in a row stay bounded regardless,
because each consumes only vertical headroom over its own two columns and the flat suffix regenerates
the next pair. Generalizing this from `O` to all seven pieces under any order is the remaining closure
content. -/
theorem reservoirSpreadCarrier_flat_OO_regen {T : Bag} {s base : ℕ} {h : ℕ → ℕ}
    (hs : 2 ≤ s) (hw0 : h 0 = 0)
    (hflat : ∀ j, 0 < j → j < GameConfig.standard.cols → h j = base)
    (hledger : base + s + ((T.draw Piece.O).draw Piece.O).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl1 : Placement, pl1.piece = Piece.O ∧ pl1.Valid GameConfig.standard ∧
      ∃ pl2 : Placement, pl2.piece = Piece.O ∧ pl2.Valid GameConfig.standard ∧
        reservoirSpreadCarrier ((T.draw Piece.O).draw Piece.O)
          (Placement.applyStep GameConfig.standard
            (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h) pl1) pl2) := by
  refine ⟨{ piece := Piece.O, rot := 0, col := 1 }, rfl, Board.valid_O (by decide), ?_⟩
  have hO : Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
        { piece := Piece.O, rot := 0, col := 1 }
      = Board.skyline GameConfig.standard
          (Function.update (Function.update h 1 (h 1 + 2)) 2 (h 1 + 2)) :=
    Board.applyStep_O_skyline_noclear (w := 0) (by decide) (by decide)
      (by rw [hflat 1 (by decide) (by decide), hflat 2 (by decide) (by decide)])
      (by decide) (by decide) (by decide) hw0
  rw [hO]
  set h' := Function.update (Function.update h 1 (h 1 + 2)) 2 (h 1 + 2) with hh'
  have hval : ∀ j : ℕ, j ≠ 1 → j ≠ 2 → h' j = h j := by
    intro j hj1 hj2
    rw [hh', Function.update_of_ne hj2, Function.update_of_ne hj1]
  have h1v : h' 1 = base + 2 := by
    rw [hh', Function.update_of_ne (by decide : (1 : ℕ) ≠ 2), Function.update_self,
      hflat 1 (by decide) (by decide)]
  have h2v : h' 2 = base + 2 := by
    rw [hh', Function.update_self, hflat 1 (by decide) (by decide)]
  refine reservoirSpreadCarrier_O_vstack_step (T := T.draw Piece.O) (w := 0) (c := 3) (f := base)
    (by decide) ?_ ?_ (by decide) (by decide) (by decide) (by decide)
    ?_ ?_ (le_refl base) (by omega) hledger
  · rw [hval 0 (by decide) (by decide)]; exact hw0
  · intro j hj hj0
    rcases eq_or_ne j 1 with rfl | hj1
    · rw [h1v]; omega
    · rcases eq_or_ne j 2 with rfl | hj2
      · rw [h2v]; omega
      · rw [hval j hj1 hj2, hflat j (Nat.pos_of_ne_zero hj0) hj]; omega
  · rw [hval 3 (by decide) (by decide), hflat 3 (by decide) (by decide)]
  · rw [hval (3 + 1) (by decide) (by decide), hflat (3 + 1) (by decide) (by decide)]

/-- **The vertical-stacking `T` atom** (iter401). The `T` analogue of
`isSpreadBoundedRWSkylineAt_O_vstack` (iter396): the flat-bottom `T` (`rot := 2`) dropped onto a level
triple of columns `(c, c+1, c+2)` all at height `f` writes `+1, +2, +1`
(`applyStep_T_skyline_noclear`), so the three columns rise to `f+1, f+2, f+1` — a peak of `f+2`. As
long as the band sits in `[base, base+s]` with `f + 2 ≤ base + s` the result is again a floor-`base`
spread-`s` band with the reserved well at `w` untouched. This widens the spread-band fill menu from
`O` to `T`; the bump it leaves (a one-row crown over the middle column) is exactly what a flat layer
cannot tolerate, which is why the eventual closure must be bag-phase-aware rather than flat-only. -/
theorem isSpreadBoundedRWSkylineAt_T_vstack {s base f : ℕ} {h : ℕ → ℕ} {w c : ℕ}
    (hw : w < GameConfig.standard.cols) (hw0 : h w = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ w → base ≤ h j ∧ h j ≤ base + s)
    (hcap : base + s ≤ GameConfig.standard.rows)
    (hc : c < GameConfig.standard.cols) (hc1 : c + 1 < GameConfig.standard.cols)
    (hc2 : c + 2 < GameConfig.standard.cols)
    (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2)
    (hcf : h c = f) (hc1f : h (c + 1) = f) (hc2f : h (c + 2) = f)
    (hflo : base ≤ f) (hfhi : f + 2 ≤ base + s) :
    Board.IsSpreadBoundedRWSkylineAt GameConfig.standard s base
      (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
        { piece := Piece.T, rot := 2, col := c }) := by
  have hT := Board.applyStep_T_skyline_noclear hc hc1 hc2 (by rw [hc1f, hcf]) (by rw [hc2f, hcf])
    hw hwc hwc1 hwc2 hw0
  rw [hT]
  refine Board.isSpreadBoundedRWSkylineAt_skyline (floor := base) (w := w) hw ?_ ?_ hcap
  · rw [Function.update_of_ne hwc2, Function.update_of_ne hwc1, Function.update_of_ne hwc]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (c + 2) with rfl | hjc2'
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjc2']
      rcases eq_or_ne j (c + 1) with rfl | hjc1'
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hjc1']
        rcases eq_or_ne j c with rfl | hjc'
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hjc']; exact hband j hj hjw

/-- **The vertical-stacking `T` atom, lifted to the spread-band carrier** (iter401). The `T`
counterpart of `reservoirSpreadCarrier_O_vstack_step` (iter397): packages
`isSpreadBoundedRWSkylineAt_T_vstack` with `valid_T` and the carrier ledger so a single flat-bottom
`T` dropped on a level triple under the cap re-enters `reservoirSpreadCarrier (T.draw Piece.T)`. -/
theorem reservoirSpreadCarrier_T_vstack_step {T : Bag} {s base f : ℕ} {h : ℕ → ℕ} {w c : ℕ}
    (hw : w < GameConfig.standard.cols) (hw0 : h w = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ w → base ≤ h j ∧ h j ≤ base + s)
    (hc : c < GameConfig.standard.cols) (hc1 : c + 1 < GameConfig.standard.cols)
    (hc2 : c + 2 < GameConfig.standard.cols)
    (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2)
    (hcf : h c = f) (hc1f : h (c + 1) = f) (hc2f : h (c + 2) = f)
    (hflo : base ≤ f) (hfhi : f + 2 ≤ base + s)
    (hledger : base + s + (T.draw Piece.T).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = Piece.T ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw Piece.T)
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h) pl) := by
  refine ⟨{ piece := Piece.T, rot := 2, col := c }, rfl, Board.valid_T hc2, base, s, ?_, hledger⟩
  exact isSpreadBoundedRWSkylineAt_T_vstack hw hw0 hband (by omega) hc hc1 hc2 hwc hwc1 hwc2
    hcf hc1f hc2f hflo hfhi

/-- **The flat-bottom `T` fill is always available on a flat band** (iter401). The `T` counterpart of
`reservoirSpreadCarrier_flat_O_vstack_step` (iter398): on a band flat at `base` with the reserved well
at column `0`, columns `1, 2, 3` form a level triple, so the `T` drops on them and keeps the carrier
whenever the spread is at least `2`. The crown it leaves over column `2` means the post-fill band is no
longer flat — so unlike the all-`O` regeneration, chaining `T`s needs the bag-phase invariant. -/
theorem reservoirSpreadCarrier_flat_T_step {T : Bag} {s base : ℕ} {h : ℕ → ℕ}
    (hs : 2 ≤ s) (hw0 : h 0 = 0)
    (hflat : ∀ j, 0 < j → j < GameConfig.standard.cols → h j = base)
    (hledger : base + s + (T.draw Piece.T).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = Piece.T ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw Piece.T)
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h) pl) := by
  refine reservoirSpreadCarrier_T_vstack_step (w := 0) (c := 1) (f := base)
    (by decide) hw0 ?_ (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (hflat 1 (by decide) (by decide)) (hflat 2 (by decide) (by decide))
    (hflat 3 (by decide) (by decide)) (le_refl base) (by omega) hledger
  intro j hj hjw
  rw [hflat j (Nat.pos_of_ne_zero hjw) hj]; omega

/-- **The vertical-stacking `S` atom for the spread-band carrier** (iter402). The `S` analogue of
`isSpreadBoundedRWSkylineAt_T_vstack` (iter401). Unlike `O` and `T`, the no-clear `S` needs a
single-step staircase notch underneath it: columns `c, c+1, c+2` must read `f, f, f+1`
(`applyStep_S_skyline_noclear`). It writes `f+1, f+2, f+2`, so the peak rises to `f+2`. As long as
the band sits in `[base, base+s]` with `base ≤ f` and `f + 2 ≤ base + s`, the result is again a
floor-`base` spread-`s` band with the reserved well at `w` untouched. The notch precondition is the
reason `S` cannot be absorbed by a flat layer, and it is exactly the bag-phase obligation: a prior
piece must have carved the `+1` step before the `S` arrives. -/
theorem isSpreadBoundedRWSkylineAt_S_vstack {s base f : ℕ} {h : ℕ → ℕ} {w c : ℕ}
    (hw : w < GameConfig.standard.cols) (hw0 : h w = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ w → base ≤ h j ∧ h j ≤ base + s)
    (hcap : base + s ≤ GameConfig.standard.rows)
    (hc : c < GameConfig.standard.cols) (hc1 : c + 1 < GameConfig.standard.cols)
    (hc2 : c + 2 < GameConfig.standard.cols)
    (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2)
    (hcf : h c = f) (hc1f : h (c + 1) = f) (hc2f : h (c + 2) = f + 1)
    (hflo : base ≤ f) (hfhi : f + 2 ≤ base + s) :
    Board.IsSpreadBoundedRWSkylineAt GameConfig.standard s base
      (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
        { piece := Piece.S, rot := 0, col := c }) := by
  have hS := Board.applyStep_S_skyline_noclear hc hc1 hc2 (by rw [hcf, hc1f]) (by rw [hc2f, hcf])
    hw hwc hwc1 hwc2 hw0
  rw [hS]
  refine Board.isSpreadBoundedRWSkylineAt_skyline (floor := base) (w := w) hw ?_ ?_ hcap
  · rw [Function.update_of_ne hwc2, Function.update_of_ne hwc1, Function.update_of_ne hwc]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (c + 2) with rfl | hjc2'
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjc2']
      rcases eq_or_ne j (c + 1) with rfl | hjc1'
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hjc1']
        rcases eq_or_ne j c with rfl | hjc'
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hjc']; exact hband j hj hjw

/-- **The vertical-stacking `S` atom, lifted to the spread-band carrier** (iter402). The `S`
counterpart of `reservoirSpreadCarrier_T_vstack_step` (iter401): packages
`isSpreadBoundedRWSkylineAt_S_vstack` with `valid_S` and the carrier ledger so a single `S` dropped
on a floor staircase notch `(f, f, f+1)` under the cap re-enters `reservoirSpreadCarrier
(T.draw Piece.S)`. There is no flat-band companion here: an `S` cannot fall on a level triple, so its
fill site is supplied by the bag-phase invariant rather than a flat layer. -/
theorem reservoirSpreadCarrier_S_vstack_step {T : Bag} {s base f : ℕ} {h : ℕ → ℕ} {w c : ℕ}
    (hw : w < GameConfig.standard.cols) (hw0 : h w = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ w → base ≤ h j ∧ h j ≤ base + s)
    (hc : c < GameConfig.standard.cols) (hc1 : c + 1 < GameConfig.standard.cols)
    (hc2 : c + 2 < GameConfig.standard.cols)
    (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2)
    (hcf : h c = f) (hc1f : h (c + 1) = f) (hc2f : h (c + 2) = f + 1)
    (hflo : base ≤ f) (hfhi : f + 2 ≤ base + s)
    (hledger : base + s + (T.draw Piece.S).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = Piece.S ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw Piece.S)
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h) pl) := by
  refine ⟨{ piece := Piece.S, rot := 0, col := c }, rfl, Board.valid_S hc2, base, s, ?_, hledger⟩
  exact isSpreadBoundedRWSkylineAt_S_vstack hw hw0 hband (by omega) hc hc1 hc2 hwc hwc1 hwc2
    hcf hc1f hc2f hflo hfhi

/-- **The vertical-stacking `Z` atom for the spread-band carrier** (iter403). The mirror of
`isSpreadBoundedRWSkylineAt_S_vstack` (iter402). The no-clear `Z` needs the opposite single-step
staircase notch: columns `c, c+1, c+2` must read `f+1, f, f` (`applyStep_Z_skyline_noclear`). It
writes `f+2, f+2, f+1`, so the peak rises to `f+2`. As long as the band sits in `[base, base+s]`
with `base ≤ f` and `f + 2 ≤ base + s`, the result is again a floor-`base` spread-`s` band with the
reserved well at `w` untouched. With this the spread-band fill menu covers both staircase
hole-makers `S` and `Z`; only the `L`, `J`, horizontal-`I` flat absorbers and the well-`I` drain
remain before the all-7 closure. -/
theorem isSpreadBoundedRWSkylineAt_Z_vstack {s base f : ℕ} {h : ℕ → ℕ} {w c : ℕ}
    (hw : w < GameConfig.standard.cols) (hw0 : h w = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ w → base ≤ h j ∧ h j ≤ base + s)
    (hcap : base + s ≤ GameConfig.standard.rows)
    (hc : c < GameConfig.standard.cols) (hc1 : c + 1 < GameConfig.standard.cols)
    (hc2 : c + 2 < GameConfig.standard.cols)
    (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2)
    (hcf : h c = f + 1) (hc1f : h (c + 1) = f) (hc2f : h (c + 2) = f)
    (hflo : base ≤ f) (hfhi : f + 2 ≤ base + s) :
    Board.IsSpreadBoundedRWSkylineAt GameConfig.standard s base
      (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
        { piece := Piece.Z, rot := 0, col := c }) := by
  have hZ := Board.applyStep_Z_skyline_noclear hc hc1 hc2 (by rw [hc1f, hc2f]) (by rw [hcf, hc1f])
    hw hwc hwc1 hwc2 hw0
  rw [hZ]
  refine Board.isSpreadBoundedRWSkylineAt_skyline (floor := base) (w := w) hw ?_ ?_ hcap
  · rw [Function.update_of_ne hwc2, Function.update_of_ne hwc1, Function.update_of_ne hwc]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (c + 2) with rfl | hjc2'
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjc2']
      rcases eq_or_ne j (c + 1) with rfl | hjc1'
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hjc1']
        rcases eq_or_ne j c with rfl | hjc'
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hjc']; exact hband j hj hjw

/-- **The vertical-stacking `Z` atom, lifted to the spread-band carrier** (iter403). The `Z`
counterpart of `reservoirSpreadCarrier_S_vstack_step` (iter402): packages
`isSpreadBoundedRWSkylineAt_Z_vstack` with `valid_Z` and the carrier ledger so a single `Z` dropped
on a floor mirror notch `(f+1, f, f)` under the cap re-enters `reservoirSpreadCarrier
(T.draw Piece.Z)`. As with `S`, there is no flat-band companion: the mirror notch must be supplied by
the bag-phase invariant. -/
theorem reservoirSpreadCarrier_Z_vstack_step {T : Bag} {s base f : ℕ} {h : ℕ → ℕ} {w c : ℕ}
    (hw : w < GameConfig.standard.cols) (hw0 : h w = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ w → base ≤ h j ∧ h j ≤ base + s)
    (hc : c < GameConfig.standard.cols) (hc1 : c + 1 < GameConfig.standard.cols)
    (hc2 : c + 2 < GameConfig.standard.cols)
    (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2)
    (hcf : h c = f + 1) (hc1f : h (c + 1) = f) (hc2f : h (c + 2) = f)
    (hflo : base ≤ f) (hfhi : f + 2 ≤ base + s)
    (hledger : base + s + (T.draw Piece.Z).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = Piece.Z ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw Piece.Z)
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h) pl) := by
  refine ⟨{ piece := Piece.Z, rot := 0, col := c }, rfl, Board.valid_Z hc2, base, s, ?_, hledger⟩
  exact isSpreadBoundedRWSkylineAt_Z_vstack hw hw0 hband (by omega) hc hc1 hc2 hwc hwc1 hwc2
    hcf hc1f hc2f hflo hfhi

/-- **The vertical-stacking `L` atom for the spread-band carrier** (iter404). Like `O` and `T`, the
no-clear `L` lands on a level triple: columns `c, c+1, c+2` all read `f` (`heq1, heq2`). It writes
`f+1, f+1, f+2`, a peak of `f+2` (`applyStep_L_skyline_noclear`). As long as the band sits in
`[base, base+s]` with `base ≤ f` and `f + 2 ≤ base + s`, the result is again a floor-`base`
spread-`s` band with the reserved well at `w` untouched. The `L` analogue of
`isSpreadBoundedRWSkylineAt_T_vstack`; unlike the staircase `S` and `Z` atoms, the `L` reuses a flat
landing site, so it gets a flat-band companion below. -/
theorem isSpreadBoundedRWSkylineAt_L_vstack {s base f : ℕ} {h : ℕ → ℕ} {w c : ℕ}
    (hw : w < GameConfig.standard.cols) (hw0 : h w = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ w → base ≤ h j ∧ h j ≤ base + s)
    (hcap : base + s ≤ GameConfig.standard.rows)
    (hc : c < GameConfig.standard.cols) (hc1 : c + 1 < GameConfig.standard.cols)
    (hc2 : c + 2 < GameConfig.standard.cols)
    (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2)
    (hcf : h c = f) (hc1f : h (c + 1) = f) (hc2f : h (c + 2) = f)
    (hflo : base ≤ f) (hfhi : f + 2 ≤ base + s) :
    Board.IsSpreadBoundedRWSkylineAt GameConfig.standard s base
      (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
        { piece := Piece.L, rot := 0, col := c }) := by
  have hL := Board.applyStep_L_skyline_noclear hc hc1 hc2 (by rw [hc1f, hcf]) (by rw [hc2f, hcf])
    hw hwc hwc1 hwc2 hw0
  rw [hL]
  refine Board.isSpreadBoundedRWSkylineAt_skyline (floor := base) (w := w) hw ?_ ?_ hcap
  · rw [Function.update_of_ne hwc2, Function.update_of_ne hwc1, Function.update_of_ne hwc]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (c + 2) with rfl | hjc2'
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjc2']
      rcases eq_or_ne j (c + 1) with rfl | hjc1'
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hjc1']
        rcases eq_or_ne j c with rfl | hjc'
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hjc']; exact hband j hj hjw

/-- **The vertical-stacking `L` atom, lifted to the spread-band carrier** (iter404). The `L`
counterpart of `reservoirSpreadCarrier_T_vstack_step` (iter401): packages
`isSpreadBoundedRWSkylineAt_L_vstack` with `valid_L` and the carrier ledger so a single flat-bottom
`L` dropped on a level triple under the cap re-enters `reservoirSpreadCarrier (T.draw Piece.L)`. -/
theorem reservoirSpreadCarrier_L_vstack_step {T : Bag} {s base f : ℕ} {h : ℕ → ℕ} {w c : ℕ}
    (hw : w < GameConfig.standard.cols) (hw0 : h w = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ w → base ≤ h j ∧ h j ≤ base + s)
    (hc : c < GameConfig.standard.cols) (hc1 : c + 1 < GameConfig.standard.cols)
    (hc2 : c + 2 < GameConfig.standard.cols)
    (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2)
    (hcf : h c = f) (hc1f : h (c + 1) = f) (hc2f : h (c + 2) = f)
    (hflo : base ≤ f) (hfhi : f + 2 ≤ base + s)
    (hledger : base + s + (T.draw Piece.L).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = Piece.L ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw Piece.L)
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h) pl) := by
  refine ⟨{ piece := Piece.L, rot := 0, col := c }, rfl, Board.valid_L hc2, base, s, ?_, hledger⟩
  exact isSpreadBoundedRWSkylineAt_L_vstack hw hw0 hband (by omega) hc hc1 hc2 hwc hwc1 hwc2
    hcf hc1f hc2f hflo hfhi

/-- **The flat-bottom `L` fill is always available on a flat band** (iter404). The `L` counterpart of
`reservoirSpreadCarrier_flat_T_step` (iter401): on a band flat at `base` with the reserved well at
column `0`, columns `1, 2, 3` form a level triple, so the `L` drops on them and keeps the carrier
whenever the spread is at least `2`. Like `T`, the post-fill band is no longer flat, so chaining
flat-`L` fills still needs the bag-phase invariant. -/
theorem reservoirSpreadCarrier_flat_L_step {T : Bag} {s base : ℕ} {h : ℕ → ℕ}
    (hs : 2 ≤ s) (hw0 : h 0 = 0)
    (hflat : ∀ j, 0 < j → j < GameConfig.standard.cols → h j = base)
    (hledger : base + s + (T.draw Piece.L).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = Piece.L ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw Piece.L)
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h) pl) := by
  refine reservoirSpreadCarrier_L_vstack_step (w := 0) (c := 1) (f := base)
    (by decide) hw0 ?_ (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (hflat 1 (by decide) (by decide)) (hflat 2 (by decide) (by decide))
    (hflat 3 (by decide) (by decide)) (le_refl base) (by omega) hledger
  intro j hj hjw
  rw [hflat j (Nat.pos_of_ne_zero hjw) hj]; omega

/-- **The vertical-stacking `J` atom for the spread-band carrier** (iter405). The mirror of
`isSpreadBoundedRWSkylineAt_L_vstack` and the last of the flat-triple absorbers. The no-clear `J`
lands on a level triple (columns `c, c+1, c+2` all read `f`) and writes `f+2, f+1, f+1`, a peak of
`f+2` (`applyStep_J_skyline_noclear`). As long as the band sits in `[base, base+s]` with `base ≤ f`
and `f + 2 ≤ base + s`, the result is again a floor-`base` spread-`s` band with the reserved well at
`w` untouched. With this every non-`I` piece (`O, T, L, J` on a flat triple, `S, Z` on a staircase
notch) has a spread-band vstack atom; only the well-`I` drain remains for the bag-level closure. -/
theorem isSpreadBoundedRWSkylineAt_J_vstack {s base f : ℕ} {h : ℕ → ℕ} {w c : ℕ}
    (hw : w < GameConfig.standard.cols) (hw0 : h w = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ w → base ≤ h j ∧ h j ≤ base + s)
    (hcap : base + s ≤ GameConfig.standard.rows)
    (hc : c < GameConfig.standard.cols) (hc1 : c + 1 < GameConfig.standard.cols)
    (hc2 : c + 2 < GameConfig.standard.cols)
    (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2)
    (hcf : h c = f) (hc1f : h (c + 1) = f) (hc2f : h (c + 2) = f)
    (hflo : base ≤ f) (hfhi : f + 2 ≤ base + s) :
    Board.IsSpreadBoundedRWSkylineAt GameConfig.standard s base
      (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
        { piece := Piece.J, rot := 0, col := c }) := by
  have hJ := Board.applyStep_J_skyline_noclear hc hc1 hc2 (by rw [hc1f, hcf]) (by rw [hc2f, hcf])
    hw hwc hwc1 hwc2 hw0
  rw [hJ]
  refine Board.isSpreadBoundedRWSkylineAt_skyline (floor := base) (w := w) hw ?_ ?_ hcap
  · rw [Function.update_of_ne hwc2, Function.update_of_ne hwc1, Function.update_of_ne hwc]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (c + 2) with rfl | hjc2'
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjc2']
      rcases eq_or_ne j (c + 1) with rfl | hjc1'
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hjc1']
        rcases eq_or_ne j c with rfl | hjc'
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hjc']; exact hband j hj hjw

/-- **The vertical-stacking `J` atom, lifted to the spread-band carrier** (iter405). The `J`
counterpart of `reservoirSpreadCarrier_L_vstack_step` (iter404): packages
`isSpreadBoundedRWSkylineAt_J_vstack` with `valid_J` and the carrier ledger so a single flat-bottom
`J` dropped on a level triple under the cap re-enters `reservoirSpreadCarrier (T.draw Piece.J)`. -/
theorem reservoirSpreadCarrier_J_vstack_step {T : Bag} {s base f : ℕ} {h : ℕ → ℕ} {w c : ℕ}
    (hw : w < GameConfig.standard.cols) (hw0 : h w = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ w → base ≤ h j ∧ h j ≤ base + s)
    (hc : c < GameConfig.standard.cols) (hc1 : c + 1 < GameConfig.standard.cols)
    (hc2 : c + 2 < GameConfig.standard.cols)
    (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2)
    (hcf : h c = f) (hc1f : h (c + 1) = f) (hc2f : h (c + 2) = f)
    (hflo : base ≤ f) (hfhi : f + 2 ≤ base + s)
    (hledger : base + s + (T.draw Piece.J).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = Piece.J ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw Piece.J)
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h) pl) := by
  refine ⟨{ piece := Piece.J, rot := 0, col := c }, rfl, Board.valid_J hc2, base, s, ?_, hledger⟩
  exact isSpreadBoundedRWSkylineAt_J_vstack hw hw0 hband (by omega) hc hc1 hc2 hwc hwc1 hwc2
    hcf hc1f hc2f hflo hfhi

/-- **The flat-bottom `J` fill is always available on a flat band** (iter405). The `J` counterpart of
`reservoirSpreadCarrier_flat_L_step` (iter404): on a band flat at `base` with the reserved well at
column `0`, columns `1, 2, 3` form a level triple, so the `J` drops on them and keeps the carrier
whenever the spread is at least `2`. Completes the flat-band fill companions for the four flat-triple
pieces `O, T, L, J`. -/
theorem reservoirSpreadCarrier_flat_J_step {T : Bag} {s base : ℕ} {h : ℕ → ℕ}
    (hs : 2 ≤ s) (hw0 : h 0 = 0)
    (hflat : ∀ j, 0 < j → j < GameConfig.standard.cols → h j = base)
    (hledger : base + s + (T.draw Piece.J).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = Piece.J ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw Piece.J)
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h) pl) := by
  refine reservoirSpreadCarrier_J_vstack_step (w := 0) (c := 1) (f := base)
    (by decide) hw0 ?_ (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (hflat 1 (by decide) (by decide)) (hflat 2 (by decide) (by decide))
    (hflat 3 (by decide) (by decide)) (le_refl base) (by omega) hledger
  intro j hj hjw
  rw [hflat j (Nat.pos_of_ne_zero hjw) hj]; omega

/-- **The vertical-stacking horizontal-`I` atom for the spread-band carrier** (iter406). The cheapest
absorber: the no-clear horizontal `I` lands on a level quad (columns `c, c+1, c+2, c+3` all read `f`)
and writes `f+1` into each, a peak of only `f+1` (`applyStep_horizI_skyline_noclear`). As long as the
band sits in `[base, base+s]` with `base ≤ f` and `f + 2 ≤ base + s`, the result is again a
floor-`base` spread-`s` band with the reserved well at `w` untouched. This completes the per-piece
vstack absorber menu; note the horizontal `I` and the well-draining vertical `I` are the same bag
token, so a strategy that drains with the `I` cannot also fill with it. -/
theorem isSpreadBoundedRWSkylineAt_horizI_vstack {s base f : ℕ} {h : ℕ → ℕ} {w c : ℕ}
    (hw : w < GameConfig.standard.cols) (hw0 : h w = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ w → base ≤ h j ∧ h j ≤ base + s)
    (hcap : base + s ≤ GameConfig.standard.rows)
    (hc : c < GameConfig.standard.cols) (hc1 : c + 1 < GameConfig.standard.cols)
    (hc2 : c + 2 < GameConfig.standard.cols) (hc3 : c + 3 < GameConfig.standard.cols)
    (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2) (hwc3 : w ≠ c + 3)
    (hcf : h c = f) (hc1f : h (c + 1) = f) (hc2f : h (c + 2) = f) (hc3f : h (c + 3) = f)
    (hflo : base ≤ f) (hfhi : f + 2 ≤ base + s) :
    Board.IsSpreadBoundedRWSkylineAt GameConfig.standard s base
      (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
        { piece := Piece.I, rot := 0, col := c }) := by
  have hI := Board.applyStep_horizI_skyline_noclear hc hc1 hc2 hc3 (by rw [hc1f, hcf])
    (by rw [hc2f, hcf]) (by rw [hc3f, hcf]) hw hwc hwc1 hwc2 hwc3 hw0
  rw [hI]
  refine Board.isSpreadBoundedRWSkylineAt_skyline (floor := base) (w := w) hw ?_ ?_ hcap
  · rw [Function.update_of_ne hwc3, Function.update_of_ne hwc2, Function.update_of_ne hwc1,
      Function.update_of_ne hwc]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (c + 3) with rfl | hjc3'
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjc3']
      rcases eq_or_ne j (c + 2) with rfl | hjc2'
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hjc2']
        rcases eq_or_ne j (c + 1) with rfl | hjc1'
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hjc1']
          rcases eq_or_ne j c with rfl | hjc'
          · rw [Function.update_self]; omega
          · rw [Function.update_of_ne hjc']; exact hband j hj hjw

/-- **The vertical-stacking horizontal-`I` atom, lifted to the spread-band carrier** (iter406).
Packages `isSpreadBoundedRWSkylineAt_horizI_vstack` with `valid_horizI` and the carrier ledger so a
single flat-bottom horizontal `I` dropped on a level quad under the cap re-enters
`reservoirSpreadCarrier (T.draw Piece.I)`. -/
theorem reservoirSpreadCarrier_horizI_vstack_step {T : Bag} {s base f : ℕ} {h : ℕ → ℕ} {w c : ℕ}
    (hw : w < GameConfig.standard.cols) (hw0 : h w = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ w → base ≤ h j ∧ h j ≤ base + s)
    (hc : c < GameConfig.standard.cols) (hc1 : c + 1 < GameConfig.standard.cols)
    (hc2 : c + 2 < GameConfig.standard.cols) (hc3 : c + 3 < GameConfig.standard.cols)
    (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2) (hwc3 : w ≠ c + 3)
    (hcf : h c = f) (hc1f : h (c + 1) = f) (hc2f : h (c + 2) = f) (hc3f : h (c + 3) = f)
    (hflo : base ≤ f) (hfhi : f + 2 ≤ base + s)
    (hledger : base + s + (T.draw Piece.I).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = Piece.I ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw Piece.I)
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h) pl) := by
  refine ⟨{ piece := Piece.I, rot := 0, col := c }, rfl, Board.valid_horizI hc3, base, s, ?_, hledger⟩
  exact isSpreadBoundedRWSkylineAt_horizI_vstack hw hw0 hband (by omega) hc hc1 hc2 hc3
    hwc hwc1 hwc2 hwc3 hcf hc1f hc2f hc3f hflo hfhi

/-- **The flat-bottom horizontal-`I` fill is always available on a flat band** (iter406). On a band
flat at `base` with the reserved well at column `0`, columns `1, 2, 3, 4` form a level quad, so the
horizontal `I` drops on them and keeps the carrier whenever the spread is at least `2`. Unlike the
flat-triple pieces it raises the four columns uniformly by one, so it leaves a flat-topped block —
the only non-`I` placement that preserves a flat sub-band. -/
theorem reservoirSpreadCarrier_flat_horizI_step {T : Bag} {s base : ℕ} {h : ℕ → ℕ}
    (hs : 2 ≤ s) (hw0 : h 0 = 0)
    (hflat : ∀ j, 0 < j → j < GameConfig.standard.cols → h j = base)
    (hledger : base + s + (T.draw Piece.I).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = Piece.I ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw Piece.I)
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h) pl) := by
  refine reservoirSpreadCarrier_horizI_vstack_step (w := 0) (c := 1) (f := base)
    (by decide) hw0 ?_ (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide)
    (hflat 1 (by decide) (by decide)) (hflat 2 (by decide) (by decide))
    (hflat 3 (by decide) (by decide)) (hflat 4 (by decide) (by decide))
    (le_refl base) (by omega) hledger
  intro j hj hjw
  rw [hflat j (Nat.pos_of_ne_zero hjw) hj]; omega

/-- **A flat band hosts any non-staircase piece** (iter407). The piece-uniform consolidation of the
five flat-band fill steps: for every piece `p` other than the two staircase hole-makers `S` and `Z`,
a band flat at `base` with the reserved well at column `0` and spread at least `2` admits a valid
placement of `p` that re-enters `reservoirSpreadCarrier (T.draw p)`. The `S`/`Z` cases are discharged
as vacuous by `hpS`/`hpZ` — they alone need a staircase notch and so are supplied separately by the
bag-phase invariant. This is the flat-phase half of the eventual all-7 landing-site dispatcher. -/
theorem reservoirSpreadCarrier_flat_nonStaircase_step {T : Bag} {s base : ℕ} {h : ℕ → ℕ} {p : Piece}
    (hs : 2 ≤ s) (hw0 : h 0 = 0)
    (hflat : ∀ j, 0 < j → j < GameConfig.standard.cols → h j = base)
    (hpS : p ≠ Piece.S) (hpZ : p ≠ Piece.Z)
    (hledger : base + s + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h) pl) := by
  cases p with
  | O => exact reservoirSpreadCarrier_flat_O_vstack_step hs hw0 hflat hledger
  | I => exact reservoirSpreadCarrier_flat_horizI_step hs hw0 hflat hledger
  | S => exact absurd rfl hpS
  | Z => exact absurd rfl hpZ
  | T => exact reservoirSpreadCarrier_flat_T_step hs hw0 hflat hledger
  | L => exact reservoirSpreadCarrier_flat_L_step hs hw0 hflat hledger
  | J => exact reservoirSpreadCarrier_flat_J_step hs hw0 hflat hledger

/-- **The flat-front spread band: a flat layer caught mid fill** (iter408). The inductable shape
the adversarial-order closure actually needs, abstracting the ad-hoc regeneration of
`reservoirSpreadCarrier_flat_OO_regen` (iter400). A skyline `h` with the reserved empty well parked
at column `0`, every working column inside the band `[base, base + s]`, AND a flat run pinned to the
floor `base` on the entire suffix `[c, cols)`. The index `c` is the FILL FRONT: columns `1 .. c - 1`
may have been raised by pieces already placed (anywhere inside the band), while columns
`c .. cols - 1` are still the untouched flat shelf at `base`. A fresh reset surface is `c = 1`
(nothing placed yet, the whole shelf flat); a fully packed layer is `c = cols` (the suffix is empty,
no flat room left). Each non-`I` piece seated flush at the current front advances `c` by its width
while leaving the shelf to its right flat, so the front marches monotonically right across one layer
— the left-to-right packing the bag schedule performs, now expressed as a single predicate that
inducts over the front position. -/
def IsFlatFrontBandAt (c s base : ℕ) (b : Board) : Prop :=
  ∃ h : ℕ → ℕ,
    b = Board.skyline GameConfig.standard h ∧
    h 0 = 0 ∧
    (∀ j < GameConfig.standard.cols, j ≠ 0 → base ≤ h j ∧ h j ≤ base + s) ∧
    base + s ≤ GameConfig.standard.rows ∧
    (∀ j, c ≤ j → j < GameConfig.standard.cols → h j = base)

/-- **The flat-front band forgets to the floor-pinned spread band** (iter408). Dropping the
flat-shelf suffix conjunct leaves exactly the `IsSpreadBoundedRWSkylineAt standard s base` data —
reserved well at column `0`, every working column in `[base, base + s]`, slack `base + s ≤ rows`. So
every height and survival face proven for the spread band (notably
`colHeight_le_of_isSpreadBoundedRWSkylineAt`, the `rows` ceiling that rules out loss) transports onto
the flat-front band at every front position `c`, giving the new invariant its `hheight` obligation
for free. -/
theorem isSpreadBoundedRWSkylineAt_of_isFlatFrontBandAt {c s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt c s base b) :
    Board.IsSpreadBoundedRWSkylineAt GameConfig.standard s base b := by
  obtain ⟨h, rfl, hw0, hband, hcap, _⟩ := hb
  exact Board.isSpreadBoundedRWSkylineAt_skyline (w := 0) (by decide) hw0 hband hcap

/-- **The `O` advances the fill front by two** (iter408). The structural step the whole flat-front
induction turns on: seating the vertical `O` flush at the current front pair `(c, c + 1)` (`0 < c`,
so the reserved well at column `0` is left alone, and `c + 1 < cols`) raises those two columns to
`base + 2` (`applyStep_O_skyline_noclear`, a no-clear placement off the empty well). With spread
`s ≥ 2` the lifted pair stays inside the band `[base, base + s]`; the columns left of the front were
already in-band, and the shelf at `[c + 2, cols)` is untouched, so it stays flat at `base`. Hence the
landing is an `IsFlatFrontBandAt (c + 2) s base` board: the front has marched two columns right with
no extra hypothesis, the `O` companion of the per-piece front-advance menu the closure dispatches
over. This is `reservoirSpreadCarrier_flat_OO_regen` recast so the second `O` is just another
instance of the same step rather than a bespoke re-derivation. -/
theorem isFlatFrontBandAt_O_step {c s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt c s base b) (hs : 2 ≤ s)
    (hc0 : 0 < c) (hc1 : c + 1 < GameConfig.standard.cols) :
    IsFlatFrontBandAt (c + 2) s base
      (Placement.applyStep GameConfig.standard b { piece := Piece.O, rot := 0, col := c }) := by
  obtain ⟨h, rfl, hw0, hband, hcap, hflat⟩ := hb
  have hc : c < GameConfig.standard.cols := by omega
  have ec : h c = base := hflat c (le_refl c) hc
  have ec1 : h (c + 1) = base := hflat (c + 1) (by omega) hc1
  have hO := Board.applyStep_O_skyline_noclear (w := 0) hc hc1 (by rw [ec, ec1])
    (by decide) (by omega) (by omega) hw0
  rw [hO]
  refine ⟨Function.update (Function.update h c (h c + 2)) (c + 1) (h c + 2), rfl, ?_, ?_, hcap, ?_⟩
  · rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega)]; exact hw0
  · intro j hj hj0
    rcases eq_or_ne j (c + 1) with rfl | hjc1
    · rw [Function.update_self, ec]; omega
    · rw [Function.update_of_ne hjc1]
      rcases eq_or_ne j c with rfl | hjc
      · rw [Function.update_self, ec]; omega
      · rw [Function.update_of_ne hjc]; exact hband j hj hj0
  · intro j hjc2 hjcols
    rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega)]
    exact hflat j (by omega) hjcols

/-- **The horizontal `I` advances the fill front by four** (iter409). The cheapest layer-builder
and the bag's guaranteed regulator in its filling role: seating the flat `I` flush across the front
quad `(c, c + 1, c + 2, c + 3)` (`0 < c` keeps the reserved well at column `0` clear,
`c + 3 < cols`) raises those four columns by exactly one to `base + 1`
(`applyStep_horizI_skyline_noclear`, a no-clear placement off the empty well). With spread `s ≥ 1`
the lifted quad stays inside the band `[base, base + s]`; columns left of the front were already
in-band and the shelf `[c + 4, cols)` is untouched, so it stays flat at `base`. Hence the landing
is an `IsFlatFrontBandAt (c + 4) s base` board: the front has marched four columns right, the
widest single advance in the per-piece menu. Companion to `isFlatFrontBandAt_O_step`; the
front-advance step for the horizontal `I` when it is spent filling rather than draining. -/
theorem isFlatFrontBandAt_horizI_step {c s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt c s base b) (hs : 1 ≤ s)
    (hc0 : 0 < c) (hc3 : c + 3 < GameConfig.standard.cols) :
    IsFlatFrontBandAt (c + 4) s base
      (Placement.applyStep GameConfig.standard b { piece := Piece.I, rot := 0, col := c }) := by
  obtain ⟨h, rfl, hw0, hband, hcap, hflat⟩ := hb
  have hc : c < GameConfig.standard.cols := by omega
  have hc1 : c + 1 < GameConfig.standard.cols := by omega
  have hc2 : c + 2 < GameConfig.standard.cols := by omega
  have ec : h c = base := hflat c (le_refl c) hc
  have ec1 : h (c + 1) = base := hflat (c + 1) (by omega) hc1
  have ec2 : h (c + 2) = base := hflat (c + 2) (by omega) hc2
  have ec3 : h (c + 3) = base := hflat (c + 3) (by omega) hc3
  have hI := Board.applyStep_horizI_skyline_noclear (w := 0) hc hc1 hc2 hc3
    (ec1.trans ec.symm) (ec2.trans ec.symm) (ec3.trans ec.symm)
    (by decide) (by omega) (by omega) (by omega) (by omega) hw0
  rw [hI]
  refine ⟨Function.update (Function.update (Function.update
      (Function.update h c (h c + 1)) (c + 1) (h c + 1)) (c + 2) (h c + 1))
      (c + 3) (h c + 1), rfl, ?_, ?_, hcap, ?_⟩
  · rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega),
        Function.update_of_ne (by omega), Function.update_of_ne (by omega)]
    exact hw0
  · intro j hj hj0
    rcases eq_or_ne j (c + 3) with rfl | hjc3
    · rw [Function.update_self, ec]; omega
    · rw [Function.update_of_ne hjc3]
      rcases eq_or_ne j (c + 2) with rfl | hjc2
      · rw [Function.update_self, ec]; omega
      · rw [Function.update_of_ne hjc2]
        rcases eq_or_ne j (c + 1) with rfl | hjc1
        · rw [Function.update_self, ec]; omega
        · rw [Function.update_of_ne hjc1]
          rcases eq_or_ne j c with rfl | hjc
          · rw [Function.update_self, ec]; omega
          · rw [Function.update_of_ne hjc]; exact hband j hj hj0
  · intro j hjc4 hjcols
    rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega),
        Function.update_of_ne (by omega), Function.update_of_ne (by omega)]
    exact hflat j (by omega) hjcols

/-- **The `T` advances the fill front by three** (iter410). Seating the flat-bottomed `T`
(`rot := 2`) flush at the front triple `(c, c + 1, c + 2)` (`0 < c` spares the well,
`c + 2 < cols`) writes the debit profile `+1, +2, +1`, lifting the triple to peak `base + 2`
at the centre (`applyStep_T_skyline_noclear`, no-clear off the empty well). With spread `s ≥ 2`
the peak stays inside the band `[base, base + s]`, the columns left of the front were already
in-band, and the shelf `[c + 3, cols)` is untouched, so it stays flat at `base`. Hence the
landing is an `IsFlatFrontBandAt (c + 3) s base` board. One of the three flat-triple
front-advance steps (`T`, `L`, `J`), all marching the front by three with a `base + 2` peak. -/
theorem isFlatFrontBandAt_T_step {c s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt c s base b) (hs : 2 ≤ s)
    (hc0 : 0 < c) (hc2 : c + 2 < GameConfig.standard.cols) :
    IsFlatFrontBandAt (c + 3) s base
      (Placement.applyStep GameConfig.standard b { piece := Piece.T, rot := 2, col := c }) := by
  obtain ⟨h, rfl, hw0, hband, hcap, hflat⟩ := hb
  have hc : c < GameConfig.standard.cols := by omega
  have hc1 : c + 1 < GameConfig.standard.cols := by omega
  have ec : h c = base := hflat c (le_refl c) hc
  have ec1 : h (c + 1) = base := hflat (c + 1) (by omega) hc1
  have ec2 : h (c + 2) = base := hflat (c + 2) (by omega) hc2
  have hT := Board.applyStep_T_skyline_noclear (w := 0) hc hc1 hc2
    (ec1.trans ec.symm) (ec2.trans ec.symm)
    (by decide) (by omega) (by omega) (by omega) hw0
  rw [hT]
  refine ⟨Function.update (Function.update (Function.update h c (h c + 1))
      (c + 1) (h c + 2)) (c + 2) (h c + 1), rfl, ?_, ?_, hcap, ?_⟩
  · rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega),
        Function.update_of_ne (by omega)]
    exact hw0
  · intro j hj hj0
    rcases eq_or_ne j (c + 2) with rfl | hjc2
    · rw [Function.update_self, ec]; omega
    · rw [Function.update_of_ne hjc2]
      rcases eq_or_ne j (c + 1) with rfl | hjc1
      · rw [Function.update_self, ec]; omega
      · rw [Function.update_of_ne hjc1]
        rcases eq_or_ne j c with rfl | hjc
        · rw [Function.update_self, ec]; omega
        · rw [Function.update_of_ne hjc]; exact hband j hj hj0
  · intro j hjc3 hjcols
    rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega),
        Function.update_of_ne (by omega)]
    exact hflat j (by omega) hjcols

/-- **The `L` advances the fill front by three** (iter410). Mirror of the `T` step with the
debit profile `+1, +1, +2`: the flat `L` (`rot := 0`) flush at the front triple lifts the
right column to peak `base + 2` (`applyStep_L_skyline_noclear`). With `s ≥ 2` the peak stays
in band, and the shelf `[c + 3, cols)` stays flat at `base`, giving
`IsFlatFrontBandAt (c + 3) s base`. -/
theorem isFlatFrontBandAt_L_step {c s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt c s base b) (hs : 2 ≤ s)
    (hc0 : 0 < c) (hc2 : c + 2 < GameConfig.standard.cols) :
    IsFlatFrontBandAt (c + 3) s base
      (Placement.applyStep GameConfig.standard b { piece := Piece.L, rot := 0, col := c }) := by
  obtain ⟨h, rfl, hw0, hband, hcap, hflat⟩ := hb
  have hc : c < GameConfig.standard.cols := by omega
  have hc1 : c + 1 < GameConfig.standard.cols := by omega
  have ec : h c = base := hflat c (le_refl c) hc
  have ec1 : h (c + 1) = base := hflat (c + 1) (by omega) hc1
  have ec2 : h (c + 2) = base := hflat (c + 2) (by omega) hc2
  have hL := Board.applyStep_L_skyline_noclear (w := 0) hc hc1 hc2
    (ec1.trans ec.symm) (ec2.trans ec.symm)
    (by decide) (by omega) (by omega) (by omega) hw0
  rw [hL]
  refine ⟨Function.update (Function.update (Function.update h c (h c + 1))
      (c + 1) (h c + 1)) (c + 2) (h c + 2), rfl, ?_, ?_, hcap, ?_⟩
  · rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega),
        Function.update_of_ne (by omega)]
    exact hw0
  · intro j hj hj0
    rcases eq_or_ne j (c + 2) with rfl | hjc2
    · rw [Function.update_self, ec]; omega
    · rw [Function.update_of_ne hjc2]
      rcases eq_or_ne j (c + 1) with rfl | hjc1
      · rw [Function.update_self, ec]; omega
      · rw [Function.update_of_ne hjc1]
        rcases eq_or_ne j c with rfl | hjc
        · rw [Function.update_self, ec]; omega
        · rw [Function.update_of_ne hjc]; exact hband j hj hj0
  · intro j hjc3 hjcols
    rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega),
        Function.update_of_ne (by omega)]
    exact hflat j (by omega) hjcols

/-- **The `J` advances the fill front by three** (iter410). Mirror of the `L` step with the
debit profile `+2, +1, +1`: the flat `J` (`rot := 0`) flush at the front triple lifts the
left column to peak `base + 2` (`applyStep_J_skyline_noclear`). With `s ≥ 2` the peak stays
in band, and the shelf `[c + 3, cols)` stays flat at `base`, giving
`IsFlatFrontBandAt (c + 3) s base`. -/
theorem isFlatFrontBandAt_J_step {c s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt c s base b) (hs : 2 ≤ s)
    (hc0 : 0 < c) (hc2 : c + 2 < GameConfig.standard.cols) :
    IsFlatFrontBandAt (c + 3) s base
      (Placement.applyStep GameConfig.standard b { piece := Piece.J, rot := 0, col := c }) := by
  obtain ⟨h, rfl, hw0, hband, hcap, hflat⟩ := hb
  have hc : c < GameConfig.standard.cols := by omega
  have hc1 : c + 1 < GameConfig.standard.cols := by omega
  have ec : h c = base := hflat c (le_refl c) hc
  have ec1 : h (c + 1) = base := hflat (c + 1) (by omega) hc1
  have ec2 : h (c + 2) = base := hflat (c + 2) (by omega) hc2
  have hJ := Board.applyStep_J_skyline_noclear (w := 0) hc hc1 hc2
    (ec1.trans ec.symm) (ec2.trans ec.symm)
    (by decide) (by omega) (by omega) (by omega) hw0
  rw [hJ]
  refine ⟨Function.update (Function.update (Function.update h c (h c + 2))
      (c + 1) (h c + 1)) (c + 2) (h c + 1), rfl, ?_, ?_, hcap, ?_⟩
  · rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega),
        Function.update_of_ne (by omega)]
    exact hw0
  · intro j hj hj0
    rcases eq_or_ne j (c + 2) with rfl | hjc2
    · rw [Function.update_self, ec]; omega
    · rw [Function.update_of_ne hjc2]
      rcases eq_or_ne j (c + 1) with rfl | hjc1
      · rw [Function.update_self, ec]; omega
      · rw [Function.update_of_ne hjc1]
        rcases eq_or_ne j c with rfl | hjc
        · rw [Function.update_self, ec]; omega
        · rw [Function.update_of_ne hjc]; exact hband j hj hj0
  · intro j hjc3 hjcols
    rw [Function.update_of_ne (by omega), Function.update_of_ne (by omega),
        Function.update_of_ne (by omega)]
    exact hflat j (by omega) hjcols

/-- **The flat fillers `O`, `T`, `L`, `J` advance the fill front, validly** (iter411). The
piece-uniform bundle of the four flat front-advance steps — the menu the `flat_no_sz_edge`
dispatches over once the regulator `I` and the notch pieces `S`, `Z` are excluded. Given a flat
front at `c` with spread `s ≥ 2`, a reserved well (`0 < c`), and room for the widest filler
(`c + 2 < cols`), every non-`I` non-`S` non-`Z` piece has a hard-drop placement seated flush at
the front that is column-valid (`Board.valid_O` and the `T`, `L`, `J` companions) and lands in a
flat-front band one to three columns further right (`c < c' ≤ c + 3`). So the carrier closes
under the whole flat-filler half of the bag with a single existential, leaving only the regulator
drain and the `S`/`Z` notch to wire in. -/
theorem isFlatFrontBandAt_filler_step {c s base : ℕ} {b : Board} {p : Piece}
    (hb : IsFlatFrontBandAt c s base b) (hs : 2 ≤ s)
    (hc0 : 0 < c) (hpS : p ≠ Piece.S) (hpZ : p ≠ Piece.Z) (hpI : p ≠ Piece.I)
    (hroom : c + 2 < GameConfig.standard.cols) :
    ∃ (pl : Placement) (c' : ℕ),
      pl.piece = p ∧ pl.Valid GameConfig.standard ∧ c < c' ∧ c' ≤ c + 3 ∧
      IsFlatFrontBandAt c' s base (Placement.applyStep GameConfig.standard b pl) := by
  cases p with
  | O => exact ⟨{ piece := Piece.O, rot := 0, col := c }, c + 2, rfl,
           Board.valid_O (by omega), by omega, by omega,
           isFlatFrontBandAt_O_step hb hs hc0 (by omega)⟩
  | I => exact absurd rfl hpI
  | S => exact absurd rfl hpS
  | Z => exact absurd rfl hpZ
  | T => exact ⟨{ piece := Piece.T, rot := 2, col := c }, c + 3, rfl,
           Board.valid_T (by omega), by omega, by omega,
           isFlatFrontBandAt_T_step hb hs hc0 (by omega)⟩
  | L => exact ⟨{ piece := Piece.L, rot := 0, col := c }, c + 3, rfl,
           Board.valid_L (by omega), by omega, by omega,
           isFlatFrontBandAt_L_step hb hs hc0 (by omega)⟩
  | J => exact ⟨{ piece := Piece.J, rot := 0, col := c }, c + 3, rfl,
           Board.valid_J (by omega), by omega, by omega,
           isFlatFrontBandAt_J_step hb hs hc0 (by omega)⟩

/-- **The regulator `I` drains the flat-front band by four** (iter412). Wiring the once-per-bag
regulator onto the fill surface: as long as the band floor has built up to at least four
(`4 ≤ base`), dropping the vertical `I` into the reserved well at column `0` completes and clears
the bottom four rows — every non-well column sits at height `≥ base ≥ 4`, so those four rows are
full — and the whole surface settles four lower. The forgetful bridge
(`isSpreadBoundedRWSkylineAt_of_isFlatFrontBandAt`) discards the flat-shelf suffix, then the
spread-band drain (`isSpreadBoundedRWSkylineAt_vertI_well_descend`) fires unchanged, landing in a
spread band at floor `base - 4` with the same slack. This is the regulator half of the fill-and-
drain reset the bag closure pivots on; the non-`I` fillers raise the band, this single drain
lowers it. -/
theorem isSpreadBoundedRWSkylineAt_of_isFlatFrontBandAt_vertI_drain {c s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt c s base b) (hbase4 : 4 ≤ base) :
    Board.IsSpreadBoundedRWSkylineAt GameConfig.standard s (base - 4)
      (Placement.applyStep GameConfig.standard b { piece := Piece.I, rot := 1, col := 0 }) := by
  obtain ⟨h, rfl, hw0, hband, hcap, _⟩ := hb
  exact Board.isSpreadBoundedRWSkylineAt_vertI_well_descend (w := 0) (by decide) hw0 hbase4
    hband hcap

/-- **A flat shelf is a fresh fill front at `c = 1`** (iter413). The bootstrap end of the
flat-front induction: any board that is `skyline` of a profile with the reserved well empty
(`h 0 = 0`) and every working column level at `base` (`hflat`) is an `IsFlatFrontBandAt 1 s base`
for any spread `s` the ceiling admits (`base + s ≤ rows`). The whole shelf `[1, cols)` is flat, so
the fill front sits at the leftmost working column `c = 1` with nothing yet placed — the canonical
reset surface the once-per-bag drain settles onto, from which the filler menu marches the front
rightward across the next layer. -/
theorem isFlatFrontBandAt_flat {s base : ℕ} {h : ℕ → ℕ}
    (hw0 : h 0 = 0)
    (hflat : ∀ j, 1 ≤ j → j < GameConfig.standard.cols → h j = base)
    (hslack : base + s ≤ GameConfig.standard.rows) :
    IsFlatFrontBandAt 1 s base (Board.skyline GameConfig.standard h) := by
  refine ⟨h, rfl, hw0, ?_, hslack, hflat⟩
  intro j hj hj0
  have hjb : h j = base := hflat j (by omega) hj
  omega

/-- **The fresh fill front is a flat phase reservoir shape** (iter414). Closing the bootstrap into
the bag carrier: a flat-front band at `c = 1` has its whole working shelf `[1, cols)` level at
`base`, which on the standard ten-column board is nine flat columns — more than the width-eight run
`IsFlatPhaseReservoirAtS` asks for. Reading the run at `pc = 1` (columns `1 .. 8`, with
`1 + 7 < 10`) repackages the reset surface as an `IsFlatPhaseReservoirAtS s base` board, the flat
disjunct of `bandPhaseReservoirS`. Chained after `isFlatFrontBandAt_flat`, any flat reset surface
is therefore a bag-carrier member, so the flat-front fill induction lives inside the existing
phase-indexed carrier rather than beside it. -/
theorem isFlatPhaseReservoirAtS_of_isFlatFrontBandAt_one {s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt 1 s base b) :
    IsFlatPhaseReservoirAtS s base b := by
  obtain ⟨h, rfl, hw0, hband, hcap, hflat⟩ := hb
  refine ⟨h, 1, rfl, hw0, hband, hcap, by omega, by decide,
    ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  all_goals exact hflat _ (by omega) (by decide)

/-- **The flat-front band is a width-parametric flat run** (iter415). The front-position view
`IsFlatFrontBandAt c` and the run-width view `IsFlatRunReservoirAt w` are dual descriptions of the
SAME mid-fill surface: the flat shelf `[c, cols)` the front band carries IS a flat run at column
`pc = c` of width `w = cols - c`. So a front-band at front `c` with at least four shelf columns left
(`c + 4 ≤ cols`) is an `IsFlatRunReservoirAt (cols - c) s base` board at the same floor and buffer.
The well at column `0`, the band `[base, base + s]`, and the slack `base + s ≤ rows` transport
verbatim; only the flat-run conjunct needs the index shift `h (c + i) = base` for `i < cols - c`,
which is exactly the shelf condition `∀ j, c ≤ j → j < cols → h j = base` read at `j = c + i`. This
unifies the front-advance fill menu (`isFlatFrontBandAt_{O,horizI,T,L,J}_step`, which march `c`
rightward) with the width-reduction reducers (`isFlatRunReservoirAt_*_step`, which shrink `w`): the
two parallel developments are the same process, `c` increasing exactly as `w = cols - c` decreases.
Feeding a partially advanced front band into the run/carrier machinery at intermediate widths now
needs no fresh fill lemmas. -/
theorem isFlatRunReservoirAt_of_isFlatFrontBandAt {c s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt c s base b) (hc1 : 1 ≤ c)
    (hwidth : c + 4 ≤ GameConfig.standard.cols) :
    IsFlatRunReservoirAt (GameConfig.standard.cols - c) s base b := by
  obtain ⟨h, rfl, hw0, hband, hcap, hflat⟩ := hb
  refine ⟨h, c, rfl, hw0, hband, hcap, hc1, by omega, by omega, ?_⟩
  intro i hi
  exact hflat (c + i) (by omega) (by omega)

/-- **A flat reset surface, in front-band vocabulary, enters the carrier** (iter416). The carrier
re-entry door expressed in the `IsFlatFrontBandAt` language the iter408–415 fill development speaks.
A front band at front `c = 1` is the fully-flat reset surface (whole shelf `[1, cols)` pinned to
`base`); `isFlatPhaseReservoirAtS_of_isFlatFrontBandAt_one` reads it as the width-eight flat phase
shape, and `bandPhaseReservoirS_of_flat` then admits it into the bag-phase carrier under the single
ledger side condition `base + s + T.card + 1 ≤ rows`. This is the door the once-per-bag drain-and
reflatten cycle aims at: whenever a completed layer drains back to a level floor, re-establishing the
`c = 1` flat front re-enters `bandPhaseReservoirS` for whatever bag `T` is current. It composes the
two preceding bridges so the front-band machinery never has to mention `IsFlatPhaseReservoirAtS`
directly. -/
theorem bandPhaseReservoirS_of_isFlatFrontBandAt_one {T : Bag} {b : Board} {s base : ℕ}
    (hb : IsFlatFrontBandAt 1 s base b)
    (hledger : base + s + T.card + 1 ≤ GameConfig.standard.rows) :
    bandPhaseReservoirS T b :=
  bandPhaseReservoirS_of_flat (isFlatPhaseReservoirAtS_of_isFlatFrontBandAt_one hb) hledger

/-- **A flat filler closes the master spread carrier through the fill front** (iter417). The
flat-filler half of the `reservoirSpreadCarrier` closure, routed through the front-band advance
rather than the rigid width-eight phase shape. From a flat-front band at front `c` with spread
`s ≥ 2`, a reserved well (`0 < c`), and room for the widest filler (`c + 2 < cols`), each non-`I`
non-`S` non-`Z` piece `p` has a valid front-seated placement whose landing is again a flat-front
band one to three columns further right (`isFlatFrontBandAt_filler_step`). Forgetting that landing's
flat-shelf suffix (`isSpreadBoundedRWSkylineAt_of_isFlatFrontBandAt`) exposes a floor-pinned spread
band at the SAME floor `base` and SAME spread `s`; pairing it with the carrier ledger
`base + s + (T.draw p).card + 1 ≤ rows` re-enters `reservoirSpreadCarrier (T.draw p)` at zero floor
cost. So the master carrier — the one `tetrisSolvableValid_of_reservoirSpreadCarrier_closed` reduces
the whole atlas verdict to — closes under every flat filler whenever the surface is read as a
flat-front band with shelf room, with the carrier's spread held fixed (no spread growth, unlike the
generic `reservoirSpreadCarrier_fill_step`). The open residue is exactly the bag-phase scheduling:
the `S`/`Z` notch pieces (which need a valley, not the flat shelf), the once-per-bag `I` drain that
resets the front to `c = 1`, and the room precondition `c + 2 < cols` failing when the shelf is
spent — all the genuinely bag-order-dependent content. -/
theorem reservoirSpreadCarrier_flatFront_fill_step {T : Bag} {b : Board} {p : Piece}
    {c s base : ℕ}
    (hb : IsFlatFrontBandAt c s base b) (hs : 2 ≤ s)
    (hc0 : 0 < c) (hpS : p ≠ Piece.S) (hpZ : p ≠ Piece.Z) (hpI : p ≠ Piece.I)
    (hroom : c + 2 < GameConfig.standard.cols)
    (hledger : base + s + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard b { pl with piece := p }) := by
  obtain ⟨pl, c', hpiece, hvalid, _, _, hband'⟩ :=
    isFlatFrontBandAt_filler_step hb hs hc0 hpS hpZ hpI hroom
  refine ⟨pl, hpiece, hvalid, ?_⟩
  subst hpiece
  exact ⟨base, s, isSpreadBoundedRWSkylineAt_of_isFlatFrontBandAt hband', hledger⟩

/-- **The regulator `I` drains the flat reset surface to a lower flat reset surface** (iter418).
The shape-preserving strengthening of `isSpreadBoundedRWSkylineAt_of_isFlatFrontBandAt_vertI_drain`
at the fully-flat front `c = 1`. A flat-front band at front `1` has its whole working shelf `[1, cols)`
level at exactly `base` (the `c = 1` instance of the shelf conjunct), so when `4 ≤ base` every
working column is at least four high: dropping the vertical `I` into the reserved empty well at
column `0` completes the bottom four rows and clears them (`applyStep_vertI_well`), and every working
column drops by exactly four to `base - 4` with the well still empty. The result is therefore not
merely a spread band but again a *flat* reset surface — a flat-front band at front `1`, floor
`base - 4` (`isFlatFrontBandAt_flat`). This is the drain half of the once-per-bag reset cycle the
reservoir pivots on, recorded in the front-band vocabulary so it composes directly with the filler
front-advance menu: the non-`I` fillers raise the working shelf, this single drain returns the whole
surface to a lower flat reset surface from which the next layer is built. The genuine open content
remains the interleaving — that a full four-deep layer is actually present at the well before the
drain fires, which is the bag-phase packing obligation (#66 and #72), not this regulator atom. -/
theorem isFlatFrontBandAt_one_vertI_drain {s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt 1 s base b) (hbase4 : 4 ≤ base) :
    IsFlatFrontBandAt 1 s (base - 4)
      (Placement.applyStep GameConfig.standard b { piece := Piece.I, rot := 1, col := 0 }) := by
  obtain ⟨h, rfl, hw0, hband, hcap, hflat⟩ := hb
  have hothers : ∀ j, j < GameConfig.standard.cols → j ≠ 0 → 4 ≤ h j := by
    intro j hj hj0
    rw [hflat j (by omega) hj]
    exact hbase4
  rw [Board.applyStep_vertI_well (w := 0) (by decide) hw0 hothers]
  apply isFlatFrontBandAt_flat
  · show (if (0 : ℕ) = 0 then 0 else h 0 - 4) = 0
    rw [if_pos rfl]
  · intro j hj1 hjcols
    show (if j = 0 then 0 else h j - 4) = base - 4
    rw [if_neg (by omega), hflat j hj1 hjcols]
  · omega

/-- **The regulator drain re-enters the bag-phase carrier** (iter419). The once-per-bag `I` drain,
read all the way back into the phase-indexed carrier `bandPhaseReservoirS`. Compose the
shape-preserving drain (`isFlatFrontBandAt_one_vertI_drain`: a flat reset surface at front `1`, floor
`base`, with `4 ≤ base`, drops under the vertical-well `I` to a flat reset surface at front `1`, floor
`base - 4`) with the carrier re-entry door (`bandPhaseReservoirS_of_isFlatFrontBandAt_one`: any flat
front band at `1` is a phase-shape member once the ledger fits). The result is that the drain does not
merely land in a bare spread band but in the very phase carrier the bag closure schedules over: for
whatever bag `T'` is current after the `I` is spent, the drained surface is `bandPhaseReservoirS T'`
at the lowered floor `base - 4`, under the destination ledger `(base - 4) + s + T'.card + 1 ≤ rows`.
This is the regulator half of the reset cycle expressed as a carrier edge — complementing the flat
filler door (iter416, which re-enters the carrier after a fill) — so a strategy that holds a flat
reset surface can drain once per bag and stay inside the phase carrier rather than falling out to an
un-regenerable bare band. The genuine open residue is unchanged: that the four-deep layer is actually
present at the well when the drain fires, the bag-phase packing obligation (#66 and #72). -/
theorem bandPhaseReservoirS_of_isFlatFrontBandAt_one_vertI_drain {T' : Bag} {b : Board} {s base : ℕ}
    (hb : IsFlatFrontBandAt 1 s base b) (hbase4 : 4 ≤ base)
    (hledger : (base - 4) + s + T'.card + 1 ≤ GameConfig.standard.rows) :
    bandPhaseReservoirS T'
      (Placement.applyStep GameConfig.standard b { piece := Piece.I, rot := 1, col := 0 }) :=
  bandPhaseReservoirS_of_isFlatFrontBandAt_one
    (isFlatFrontBandAt_one_vertI_drain hb hbase4) hledger

/-- **A flat-front band at any front position is a master-carrier member** (iter420). The
front-position-agnostic re-entry door into the master carrier `reservoirSpreadCarrier` — the very
predicate `tetrisSolvableValid_of_reservoirSpreadCarrier_closed` reduces the whole atlas verdict to.
Where iter416 (`bandPhaseReservoirS_of_isFlatFrontBandAt_one`) admits only the fully-flat reset
surface (`c = 1`) into the phase-indexed carrier, this admits a flat-front band at *any* front `c`
straight into the spread-band master carrier: the forgetful bridge
(`isSpreadBoundedRWSkylineAt_of_isFlatFrontBandAt`) discards the flat-shelf suffix to expose the
floor-pinned spread band at floor `base`, spread `s`, and the carrier's ledger
`base + s + T.card + 1 ≤ rows` is supplied unchanged. So a strategy mid-fill — front marched part way
across the working shelf, bumps behind the front, flat ahead — reads its surface as a master-carrier
member for the current bag `T` without first draining back to a level reset surface. This is the
input-side membership the flat-front fill development (iter408–418) feeds into: any intermediate
front band certifies carrier membership directly, so the height and survival faces transport at every
front position. The open content is unchanged — the bag-phase closure that keeps a flat front (or
re-presents an S/Z valley) under every adversarial order (#66 and #72) — but this removes the
`c = 1`-only restriction on entering the master carrier. -/
theorem reservoirSpreadCarrier_of_isFlatFrontBandAt {T : Bag} {b : Board} {c s base : ℕ}
    (hb : IsFlatFrontBandAt c s base b)
    (hledger : base + s + T.card + 1 ≤ GameConfig.standard.rows) :
    reservoirSpreadCarrier T b :=
  ⟨base, s, isSpreadBoundedRWSkylineAt_of_isFlatFrontBandAt hb, hledger⟩

/-- **The horizontal `I` filler closes the master carrier through the fill front** (iter421). The
`I`-spent-filling companion of `reservoirSpreadCarrier_flatFront_fill_step` (iter417, which dispatches
the `O`, `T`, `L`, `J` fillers but excludes the regulator). When the floor has not yet built up enough
to drain, the bag's guaranteed `I` is spent filling rather than draining: seated flat across the front
quad `(c, c + 1, c + 2, c + 3)` (`0 < c` spares the reserved well, `c + 3 < cols`) it raises those
four columns by one and marches the front to `c + 4` (`isFlatFrontBandAt_horizI_step`), staying in the
flat-front band at the SAME floor `base` and SAME spread `s` (spread `s ≥ 1` suffices for a `+1`
filler). Forgetting the flat-shelf suffix through the new front-agnostic membership bridge
(`reservoirSpreadCarrier_of_isFlatFrontBandAt`, iter420) re-enters `reservoirSpreadCarrier (T.draw I)`
under the carrier ledger `base + s + (T.draw I).card + 1 ≤ rows`. Together with iter417 this closes the
master carrier under EVERY non-`S` non-`Z` piece as a flat filler with no spread growth — both the
flat fillers and the `I` in its filling role — leaving only the `S`/`Z` notch and the once-per-bag
drain (the genuinely bag-order-dependent content, #66 and #72) to schedule. -/
theorem reservoirSpreadCarrier_flatFront_horizI_fill_step {T : Bag} {b : Board} {c s base : ℕ}
    (hb : IsFlatFrontBandAt c s base b) (hs : 1 ≤ s)
    (hc0 : 0 < c) (hroom : c + 3 < GameConfig.standard.cols)
    (hledger : base + s + (T.draw Piece.I).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = Piece.I ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw Piece.I)
        (Placement.applyStep GameConfig.standard b { pl with piece := Piece.I }) := by
  refine ⟨{ piece := Piece.I, rot := 0, col := c }, rfl, Board.valid_horizI hroom, ?_⟩
  exact reservoirSpreadCarrier_of_isFlatFrontBandAt
    (isFlatFrontBandAt_horizI_step hb hs hc0 hroom) hledger

/-- **Every non-`S` non-`Z` piece is a flat filler that closes the master carrier** (iter422). The
single dispatcher unifying the flat-filler half (`reservoirSpreadCarrier_flatFront_fill_step`, iter417:
`O`, `T`, `L`, `J`) with the regulator-in-its-filling-role half
(`reservoirSpreadCarrier_flatFront_horizI_fill_step`, iter421: the horizontal `I`). On a flat-front
band at front `c` with spread `s ≥ 2`, a reserved well (`0 < c`), and room for the widest front-seated
quad (`c + 3 < cols`), every piece other than the two notch pieces `S` and `Z` has a valid front-seated
placement whose landing re-enters `reservoirSpreadCarrier (T.draw p)` at the SAME floor and SAME spread
under the carrier ledger. So the master carrier is closed under the entire non-notch alphabet
`{O, I, T, L, J}` as no-spread-growth flat fillers, reading the surface as a flat-front band. This is
the complete fill menu for the bag phase in which no `S`/`Z` is owed; what remains for the full
all-orders closure is exactly the two notch pieces (which require a valley rather than the flat shelf)
and the once-per-bag drain that resets the spent front — the genuinely bag-order-dependent content
(#66 and #72). -/
theorem reservoirSpreadCarrier_flatFront_nonSZ_fill_step {T : Bag} {b : Board} {p : Piece}
    {c s base : ℕ}
    (hb : IsFlatFrontBandAt c s base b) (hs : 2 ≤ s)
    (hc0 : 0 < c) (hpS : p ≠ Piece.S) (hpZ : p ≠ Piece.Z)
    (hroom : c + 3 < GameConfig.standard.cols)
    (hledger : base + s + (T.draw p).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      reservoirSpreadCarrier (T.draw p)
        (Placement.applyStep GameConfig.standard b { pl with piece := p }) := by
  rcases eq_or_ne p Piece.I with rfl | hpI
  · exact reservoirSpreadCarrier_flatFront_horizI_fill_step hb (by omega) hc0 hroom hledger
  · exact reservoirSpreadCarrier_flatFront_fill_step hb hs hc0 hpS hpZ hpI (by omega) hledger

/-- **Spread monotonicity for the flat-front band** (iter423). Widening the band tolerance leaves a
flat-front band a flat-front band: from `IsFlatFrontBandAt c s base b` and `s ≤ s'` with the wider
ceiling `base + s' ≤ rows`, the SAME profile `h` is an `IsFlatFrontBandAt c s' base` member — the well
stays empty, the flat shelf `[c, cols)` is untouched, and each working column already in `[base, base
+ s]` lies a fortiori in `[base, base + s']`. The structural counterpart of the level-pocket band's
spread monotonicity, needed to reconcile the fill menu's differing buffer demands: the flat-triple
fillers (`O`, `T`, `L`, `J`) need `s ≥ 2` for their `base + 2` peak while the horizontal `I` needs only
`s ≥ 1`, so a closure dispatching over the whole non-notch alphabet at one spread first normalises the
band to the common `s ≥ 2` via this widening. It spends ledger headroom (the wider `s'` raises the band
top), so the caller supplies the slack; nothing about the surface shape changes. -/
theorem isFlatFrontBandAt_mono {c s s' base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt c s base b) (hss : s ≤ s')
    (hcap : base + s' ≤ GameConfig.standard.rows) :
    IsFlatFrontBandAt c s' base b := by
  obtain ⟨h, rfl, hw0, hband, _, hflat⟩ := hb
  refine ⟨h, rfl, hw0, ?_, hcap, hflat⟩
  intro j hj hj0
  obtain ⟨hlo, hhi⟩ := hband j hj hj0
  exact ⟨hlo, by omega⟩

/-- **Front-position monotonicity for the flat-front band.** The front index `c` only records HOW FAR
the flat shelf reaches back: `IsFlatFrontBandAt c s base` asserts `h j = base` for every `c ≤ j <
cols`. So retracting the claim to a LATER front `c' ≥ c` is a pure weakening — the shelf `[c', cols)`
is a sub-interval of `[c, cols)`, every column of which is already pinned to `base`, while the well and
band conjuncts (which never mention `c`) carry over unchanged. This is the fill-front dual of
`isFlatRunReservoirAt_width_mono` (iter604): both discard a structural-extent claim to align two
partially-filled surfaces at a common front before composing their fills, the bookkeeping a bag-phase
schedule needs when independent fill segments end at different fronts. Enabling infrastructure, not the
closure — crux #66/#72 remain open and `TetrisSolvableValid` is NOT yet proven. -/
theorem isFlatFrontBandAt_front_mono {c c' s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt c s base b) (hcc' : c ≤ c') :
    IsFlatFrontBandAt c' s base b := by
  obtain ⟨h, rfl, hw0, hband, hcap, hflat⟩ := hb
  exact ⟨h, rfl, hw0, hband, hcap, fun j hj hjcols => hflat j (le_trans hcc' hj) hjcols⟩

/-- **Every non-`S` non-`Z` piece advances the fill front and stays a flat-front band** (iter480).
The chainable companion of `reservoirSpreadCarrier_flatFront_nonSZ_fill_step` (iter422): where that
dispatcher forgets each landing to the spread carrier, this one keeps the richer
`IsFlatFrontBandAt c'` structure, so consecutive fills compose. From a flat-front band at front `c`
with spread `s ≥ 2`, a reserved well (`0 < c`), and room for the widest front-seated quad
(`c + 3 < cols`), every piece other than the two notch pieces `S` and `Z` has a valid front-seated
placement whose landing is again a flat-front band one to four columns further right: the horizontal
`I` marches the front to `c + 4` (`isFlatFrontBandAt_horizI_step`), the flat triples `T`, `L`, `J`
to `c + 3` and the `O` to `c + 2` (`isFlatFrontBandAt_filler_step`). Returning the front band rather
than its forgetful image is what lets a whole layer be filled by chaining this step across the
non-notch alphabet before the once-per-bag drain resets the front to `c = 1`; the bag-phase
scheduler that orders those fills against the drain and the `S`/`Z` notch route is the open residue
(#66, #72). -/
theorem isFlatFrontBandAt_nonSZ_filler_step {c s base : ℕ} {b : Board} {p : Piece}
    (hb : IsFlatFrontBandAt c s base b) (hs : 2 ≤ s)
    (hc0 : 0 < c) (hpS : p ≠ Piece.S) (hpZ : p ≠ Piece.Z)
    (hroom : c + 3 < GameConfig.standard.cols) :
    ∃ (pl : Placement) (c' : ℕ),
      pl.piece = p ∧ pl.Valid GameConfig.standard ∧ c < c' ∧ c' ≤ c + 4 ∧
      IsFlatFrontBandAt c' s base (Placement.applyStep GameConfig.standard b pl) := by
  rcases eq_or_ne p Piece.I with rfl | hpI
  · exact ⟨{ piece := Piece.I, rot := 0, col := c }, c + 4, rfl,
      Board.valid_horizI hroom, by omega, by omega,
      isFlatFrontBandAt_horizI_step hb (by omega) hc0 hroom⟩
  · obtain ⟨pl, c', hpc, hval, hlo, hhi, hband⟩ :=
      isFlatFrontBandAt_filler_step hb hs hc0 hpS hpZ hpI (by omega)
    exact ⟨pl, c', hpc, hval, hlo, by omega, hband⟩

/-- **Two consecutive non-`S` non-`Z` fillers compose on the flat-front band** (iter481). The base
case of layer-filling by chaining `isFlatFrontBandAt_nonSZ_filler_step` (iter480): from a flat-front
band at front `c` with spread `s ≥ 2`, a reserved well (`0 < c`), and room for two front-seated quads
(`c + 7 < cols`), any two non-notch pieces `p` then `q` have valid front-seated placements whose
composite landing is again a flat-front band, with the front advanced to some `c'` in `(c, c + 8]`.
The second fill reuses the first landing's front band directly — the well stays at column `0`, the
new flat shelf opens at `c'`, and the spread `s` is held fixed — so no re-derivation is needed beyond
two applications of the single-step dispatcher. This is the inductive kernel the full layer-fill
rests on: the front marches monotonically right under each non-notch piece until the shelf is spent,
at which point the once-per-bag drain resets it. The bag-order scheduling against the `S`/`Z` notch
route and the drain is the open residue (#66, #72). -/
theorem isFlatFrontBandAt_nonSZ_filler_two_step {c s base : ℕ} {b : Board} {p q : Piece}
    (hb : IsFlatFrontBandAt c s base b) (hs : 2 ≤ s) (hc0 : 0 < c)
    (hpS : p ≠ Piece.S) (hpZ : p ≠ Piece.Z)
    (hqS : q ≠ Piece.S) (hqZ : q ≠ Piece.Z)
    (hroom : c + 7 < GameConfig.standard.cols) :
    ∃ (pl₁ pl₂ : Placement) (c' : ℕ),
      pl₁.piece = p ∧ pl₁.Valid GameConfig.standard ∧
      pl₂.piece = q ∧ pl₂.Valid GameConfig.standard ∧
      c < c' ∧ c' ≤ c + 8 ∧
      IsFlatFrontBandAt c' s base
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard b pl₁) pl₂) := by
  obtain ⟨pl₁, c₁, hp1, hv1, hlo1, hhi1, hb1⟩ :=
    isFlatFrontBandAt_nonSZ_filler_step hb hs hc0 hpS hpZ (by omega)
  obtain ⟨pl₂, c₂, hp2, hv2, hlo2, hhi2, hb2⟩ :=
    isFlatFrontBandAt_nonSZ_filler_step hb1 hs (by omega) hqS hqZ (by omega)
  exact ⟨pl₁, pl₂, c₂, hp1, hv1, hp2, hv2, by omega, by omega, hb2⟩

/-- **A whole run of non-`S` non-`Z` pieces fills into the flat-front band** (iter482). The full
layer-fill obtained by inducting `isFlatFrontBandAt_nonSZ_filler_step` (iter480) over an arbitrary
list of non-notch pieces — the absorb-a-run-of-non-`I`-pieces capability the bag closure needs
between the `S`/`Z` and drain events. Given a flat-front band at front `c` with spread `s ≥ 2`, a
reserved well (`0 < c`), a list `ps` of pieces none of which is `S` or `Z`, and enough shelf for the
whole run (`c + 4 * ps.length ≤ cols`, since each filler advances the front by at most four), there
is a matching list of valid placements — one per piece, in order (`List.Forall₂`) — whose composite
landing is again a flat-front band, with the front advanced monotonically to some `c'` in
`[c, c + 4 * ps.length]`. The room budget `c + 4 * ps.length ≤ cols` is exactly the loop invariant:
each step consumes at most four columns and the recursion re-establishes it for the shorter tail, so
no per-step room reasoning leaks to the caller. This converts the single-piece front advance into a
whole-bag-segment fill; the remaining bag-order content is scheduling this run against the `S`/`Z`
notch route and the once-per-bag drain (#66, #72). -/
theorem isFlatFrontBandAt_nonSZ_fill_list {s base : ℕ} :
    ∀ (ps : List Piece) {c : ℕ} {b : Board},
      IsFlatFrontBandAt c s base b → 2 ≤ s → 0 < c →
      (∀ p ∈ ps, p ≠ Piece.S ∧ p ≠ Piece.Z) →
      c + 4 * ps.length ≤ GameConfig.standard.cols →
      ∃ (pls : List Placement) (c' : ℕ),
        List.Forall₂ (fun pl p => pl.piece = p ∧ pl.Valid GameConfig.standard) pls ps ∧
        c ≤ c' ∧ c' ≤ c + 4 * ps.length ∧
        IsFlatFrontBandAt c' s base
          (pls.foldl (Placement.applyStep GameConfig.standard) b) := by
  intro ps
  induction ps with
  | nil => intro c b hb _ _ _ _; exact ⟨[], c, List.Forall₂.nil, le_refl c, by simp, hb⟩
  | cons p ps ih =>
    intro c b hb hs hc0 hmem hroom
    rw [List.length_cons] at hroom
    have hpSZ := hmem p List.mem_cons_self
    obtain ⟨pl, c₁, hp1, hv1, hlo1, hhi1, hb1⟩ :=
      isFlatFrontBandAt_nonSZ_filler_step hb hs hc0 hpSZ.1 hpSZ.2 (by omega)
    obtain ⟨pls, c', hforall, hlo', hhi', hbn⟩ :=
      ih hb1 hs (by omega) (fun q hq => hmem q (List.mem_cons_of_mem p hq)) (by omega)
    refine ⟨pl :: pls, c', List.Forall₂.cons ⟨hp1, hv1⟩ hforall, by omega, ?_, ?_⟩
    · rw [List.length_cons]; omega
    · rw [List.foldl_cons]; exact hbn

/-- **Absorb a whole non-`S` non-`Z` run, then drain with the regulator** (iter483). The
fill-and-drain half-cycle on the flat-front band, parameterized by an arbitrary run of fillers.
This chains the run-fill (`isFlatFrontBandAt_nonSZ_fill_list`, iter482) into the regulator drain
(`isSpreadBoundedRWSkylineAt_of_isFlatFrontBandAt_vertI_drain`, iter412): a list `ps` of non-notch
pieces marches the fill front rightward across one layer — each piece landing valid and in order
(`List.Forall₂`), the surface staying a flat-front band at the same floor `base` — and then, since
the floor has built to at least four (`4 ≤ base`), the once-per-bag vertical `I` dropped into the
reserved well at column `0` clears the bottom four rows so the whole surface settles into a spread
band at floor `base - 4`. The room budget `c + 4 * ps.length ≤ cols` keeps the run inside the
current layer. This packages a bag segment of fillers plus its regulator drain into one net
floor-lowering transition; balancing these drops against the layer-raising fills across a whole
adversarial bag, together with the `S`/`Z` notch route, is the remaining closure content (#66,
#72). -/
theorem isFlatFrontBandAt_nonSZ_fill_list_drain {c s base : ℕ} {b : Board} {ps : List Piece}
    (hb : IsFlatFrontBandAt c s base b) (hs : 2 ≤ s) (hc0 : 0 < c)
    (hmem : ∀ p ∈ ps, p ≠ Piece.S ∧ p ≠ Piece.Z)
    (hroom : c + 4 * ps.length ≤ GameConfig.standard.cols)
    (hbase4 : 4 ≤ base) :
    ∃ (pls : List Placement),
      List.Forall₂ (fun pl p => pl.piece = p ∧ pl.Valid GameConfig.standard) pls ps ∧
      Board.IsSpreadBoundedRWSkylineAt GameConfig.standard s (base - 4)
        (Placement.applyStep GameConfig.standard
          (pls.foldl (Placement.applyStep GameConfig.standard) b)
          { piece := Piece.I, rot := 1, col := 0 }) := by
  obtain ⟨pls, c', hforall, _, _, hbn⟩ :=
    isFlatFrontBandAt_nonSZ_fill_list ps hb hs hc0 hmem hroom
  exact ⟨pls, hforall, isSpreadBoundedRWSkylineAt_of_isFlatFrontBandAt_vertI_drain hbn hbase4⟩

/-- **The flat-front band has not topped out** (iter484). The survival face of the fill surface: at
every front position `c`, an `IsFlatFrontBandAt c s base b` board keeps every cell strictly under
the `rows` ceiling, so no row has spilled and the game is not lost. It composes the forgetful bridge
to the floor-pinned spread band (`isSpreadBoundedRWSkylineAt_of_isFlatFrontBandAt`, iter408), the
floor-forgetting bridge to the ordinary spread band (`isSpreadBoundedRWSkyline_of_isSpreadBoundedRWSkylineAt`),
and the spread-band non-loss certificate (`not_isLost_of_isSpreadBoundedRWSkyline`, which reads off
the reserved-well ceiling). This is the per-state half of the height-limit obligation — the surface
stays under the limit no matter how far the fill front has advanced across the layer — and it is the
endpoint certificate the run-fill (`isFlatFrontBandAt_nonSZ_fill_list`, iter482) lands in. Transient
survival at every intermediate placement of the run is a separate per-prefix obligation; this lemma
certifies the completed-run surface itself. -/
theorem isFlatFrontBandAt_not_isLost {c s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt c s base b) :
    ¬ Board.isLost GameConfig.standard b :=
  Board.not_isLost_of_isSpreadBoundedRWSkyline
    (Board.isSpreadBoundedRWSkyline_of_isSpreadBoundedRWSkylineAt
      (isSpreadBoundedRWSkylineAt_of_isFlatFrontBandAt hb))

/-- **The whole non-notch run survives at every prefix** (iter485). Strengthens the run-fill
(`isFlatFrontBandAt_nonSZ_fill_list`, iter482) with a transient survival certificate: not only does
the completed fold land in a flat-front band at the same floor `base`, but every prefix of the
placement list — the board after the first `k` of the run's pieces have dropped, for each `k` — is
itself not lost. Each prefix board is reached by folding the first `k` placements, and the proof
walks the same induction as iter482: at `k = 0` the starting band is safe by the per-state face
(`isFlatFrontBandAt_not_isLost`, iter484), and the cons step peels one placement with
`List.take_succ_cons` and `List.foldl_cons` so the tail's prefix survival (the induction
hypothesis on the post-placement band) discharges the remaining steps. This answers the
"under the height limit no matter the order" obligation at the granularity of every intermediate
placement, not just the run endpoint: as the adversary feeds its chosen run of fillers one at a
time, the surface never tops out at any point along the way. The order-independent height balance
across a whole bag — fills raising versus the once-per-bag drain lowering, together with the `S`
and `Z` notch route — is still the remaining closure content (#66, #72). -/
theorem isFlatFrontBandAt_nonSZ_fill_list_safe {s base : ℕ} :
    ∀ (ps : List Piece) {c : ℕ} {b : Board},
      IsFlatFrontBandAt c s base b → 2 ≤ s → 0 < c →
      (∀ p ∈ ps, p ≠ Piece.S ∧ p ≠ Piece.Z) →
      c + 4 * ps.length ≤ GameConfig.standard.cols →
      ∃ (pls : List Placement) (c' : ℕ),
        List.Forall₂ (fun pl p => pl.piece = p ∧ pl.Valid GameConfig.standard) pls ps ∧
        c ≤ c' ∧ c' ≤ c + 4 * ps.length ∧
        IsFlatFrontBandAt c' s base
          (pls.foldl (Placement.applyStep GameConfig.standard) b) ∧
        (∀ k, ¬ Board.isLost GameConfig.standard
          ((pls.take k).foldl (Placement.applyStep GameConfig.standard) b)) := by
  intro ps
  induction ps with
  | nil =>
    intro c b hb _ _ _ _
    refine ⟨[], c, List.Forall₂.nil, le_refl c, by simp, hb, ?_⟩
    intro k
    simp only [List.take_nil, List.foldl_nil]
    exact isFlatFrontBandAt_not_isLost hb
  | cons p ps ih =>
    intro c b hb hs hc0 hmem hroom
    rw [List.length_cons] at hroom
    have hpSZ := hmem p List.mem_cons_self
    obtain ⟨pl, c₁, hp1, hv1, hlo1, hhi1, hb1⟩ :=
      isFlatFrontBandAt_nonSZ_filler_step hb hs hc0 hpSZ.1 hpSZ.2 (by omega)
    obtain ⟨pls, c', hforall, hlo', hhi', hbn, hsafe⟩ :=
      ih hb1 hs (by omega) (fun q hq => hmem q (List.mem_cons_of_mem p hq)) (by omega)
    refine ⟨pl :: pls, c', List.Forall₂.cons ⟨hp1, hv1⟩ hforall, by omega, ?_, ?_, ?_⟩
    · rw [List.length_cons]; omega
    · rw [List.foldl_cons]; exact hbn
    · intro k
      cases k with
      | zero =>
        simp only [List.take_zero, List.foldl_nil]
        exact isFlatFrontBandAt_not_isLost hb
      | succ m =>
        simp only [List.take_succ_cons, List.foldl_cons]
        exact hsafe m

/-- **The full fill-then-drain half-cycle survives at every prefix** (iter486). Bundles the
per-prefix-safe run-fill (`isFlatFrontBandAt_nonSZ_fill_list_safe`, iter485) with the regulator
drain (`isSpreadBoundedRWSkylineAt_of_isFlatFrontBandAt_vertI_drain`, iter412) into one end-to-end
certified bag segment: the adversary's run of non-notch fillers `ps` marches the fill front across
the layer, and then the once-per-bag vertical `I` dropped into the reserved well clears four rows so
the surface settles into a spread band at floor `base - 4`. The new content is the third conjunct —
*every* prefix of the combined schedule `pls ++ [vertI-well]` folds to a board that has not topped
out. The proof splits each prefix length `k` with `List.take_append`: when `k` lands inside the
filler run the drain tail is empty and survival is iter485's per-prefix face; when `k` reaches past
the run the whole schedule has played, landing on the post-drain spread band whose reserved well
keeps it under the ceiling. This is the complete "absorb the pieces as they arrive, then drain back
down to reset, never topping out along the way" obligation for one run of fillers plus its drain —
exactly the reservoir half-cycle the goal describes. What it does not yet do is schedule the drain
against an adversarial *interleaving* of the bag (the `I` may arrive before the run completes) or
route the `S` and `Z` notch pieces; balancing the per-bag raise against the drain for every
permutation remains the open closure content (#66, #72). -/
theorem isFlatFrontBandAt_nonSZ_fill_list_drain_safe {c s base : ℕ} {b : Board} {ps : List Piece}
    (hb : IsFlatFrontBandAt c s base b) (hs : 2 ≤ s) (hc0 : 0 < c)
    (hmem : ∀ p ∈ ps, p ≠ Piece.S ∧ p ≠ Piece.Z)
    (hroom : c + 4 * ps.length ≤ GameConfig.standard.cols)
    (hbase4 : 4 ≤ base) :
    ∃ (pls : List Placement),
      List.Forall₂ (fun pl p => pl.piece = p ∧ pl.Valid GameConfig.standard) pls ps ∧
      Board.IsSpreadBoundedRWSkylineAt GameConfig.standard s (base - 4)
        (Placement.applyStep GameConfig.standard
          (pls.foldl (Placement.applyStep GameConfig.standard) b)
          { piece := Piece.I, rot := 1, col := 0 }) ∧
      (∀ k, ¬ Board.isLost GameConfig.standard
        (((pls ++ [({ piece := Piece.I, rot := 1, col := 0 } : Placement)]).take k).foldl
          (Placement.applyStep GameConfig.standard) b)) := by
  obtain ⟨pls, c', hforall, _, _, hbn, hsafe⟩ :=
    isFlatFrontBandAt_nonSZ_fill_list_safe ps hb hs hc0 hmem hroom
  have hdrain := isSpreadBoundedRWSkylineAt_of_isFlatFrontBandAt_vertI_drain hbn hbase4
  refine ⟨pls, hforall, hdrain, ?_⟩
  intro k
  rcases Nat.lt_or_ge k (pls.length + 1) with hk | hk
  · rw [List.take_append, Nat.sub_eq_zero_of_le (Nat.le_of_lt_succ hk), List.take_zero,
      List.append_nil]
    exact hsafe k
  · have hlen : (pls ++ [({ piece := Piece.I, rot := 1, col := 0 } : Placement)]).length ≤ k := by
      simp only [List.length_append, List.length_cons, List.length_nil]; omega
    rw [List.take_of_length_le hlen, List.foldl_append, List.foldl_cons, List.foldl_nil]
    exact Board.not_isLost_of_isSpreadBoundedRWSkyline
      (Board.isSpreadBoundedRWSkyline_of_isSpreadBoundedRWSkylineAt hdrain)

/-- **Tight height cap on the fill-then-drain endpoint** (iter487). The quantitative companion to
the survival face (`isFlatFrontBandAt_nonSZ_fill_list_drain_safe`, iter486): after the run of
non-notch fillers `ps` and the regulator drain, the resulting surface has every column capped at
`base - 4 + s` — the post-drain floor `base - 4` plus the band spread `s`. Reads the scalar cap
straight off the post-drain spread band (`isFlatFrontBandAt_nonSZ_fill_list_drain`, iter483) via
`maxColHeight_le_of_isSpreadBoundedRWSkylineAt`. This is the numeric "stays under the height limit"
ledger entry for one absorb-then-reset half-cycle: net of a whole filler run plus its single drain,
the stack sits four rows lower than the band ceiling it would otherwise reach, which is the slack
the once-per-bag regulator buys back. Carrying an explicit `maxColHeight` bound (rather than only
the `¬ isLost` ceiling) is what a bounded-carrier height accounting needs to chain half-cycles
without the bound drifting upward. It still says nothing about adversarial interleaving of the drain
or the `S`/`Z` notch route — the per-bag raise-versus-drain balance for every order (#66, #72) is the
open closure. -/
theorem isFlatFrontBandAt_nonSZ_fill_list_drain_height {c s base : ℕ} {b : Board} {ps : List Piece}
    (hb : IsFlatFrontBandAt c s base b) (hs : 2 ≤ s) (hc0 : 0 < c)
    (hmem : ∀ p ∈ ps, p ≠ Piece.S ∧ p ≠ Piece.Z)
    (hroom : c + 4 * ps.length ≤ GameConfig.standard.cols)
    (hbase4 : 4 ≤ base) :
    ∃ (pls : List Placement),
      List.Forall₂ (fun pl p => pl.piece = p ∧ pl.Valid GameConfig.standard) pls ps ∧
      Board.maxColHeight GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (pls.foldl (Placement.applyStep GameConfig.standard) b)
          { piece := Piece.I, rot := 1, col := 0 }) ≤ base - 4 + s := by
  obtain ⟨pls, hforall, hdrain⟩ :=
    isFlatFrontBandAt_nonSZ_fill_list_drain hb hs hc0 hmem hroom hbase4
  exact ⟨pls, hforall, Board.maxColHeight_le_of_isSpreadBoundedRWSkylineAt hdrain⟩

/-- **Bag-order split at the first I** (iter488). The first structural handle on the adversary
placing the regulator I anywhere in the bag: any piece order that contains an `I` decomposes at its
earliest `I` as `pre ++ Piece.I :: post`, with `pre` containing no `I`. This is the scheduling
skeleton the interleaving closure needs — `pre` is the run of fillers that arrive before the
regulator, the singled-out `I` is the drain, and `post` is whatever the adversary owes afterward.
Combined with the bag fact that a 7-bag holds exactly one `I`, `post` is also I-free, so an arbitrary
bag order is exactly one filler run, one drain, one filler run. The two filler runs are the input
shape consumed by the certified half-cycle lemmas (`isFlatFrontBandAt_nonSZ_fill_list_safe`, iter485;
`isFlatFrontBandAt_nonSZ_fill_list_drain_safe`, iter486). What this does NOT yet supply is the
geometric re-entry after a mid-bag drain (re-establishing a flat front band so the trailing `post`
run has somewhere to land), the S and Z notch routing, or the per-bag raise-versus-drain balance for
every order; those remain the open closure content (#66, #72). -/
theorem pieces_split_at_first_I : ∀ {ps : List Piece}, Piece.I ∈ ps →
    ∃ (pre post : List Piece), ps = pre ++ Piece.I :: post ∧ Piece.I ∉ pre := by
  intro ps
  induction ps with
  | nil => intro h; simp at h
  | cons a t ih =>
    intro h
    by_cases haI : a = Piece.I
    · exact ⟨[], t, by subst haI; rfl, by simp⟩
    · have hmem : Piece.I ∈ t := by
        rcases List.mem_cons.mp h with h1 | h1
        · exact absurd h1.symm haI
        · exact h1
      obtain ⟨pre, post, hsplit, hnotin⟩ := ih hmem
      refine ⟨a :: pre, post, ?_, ?_⟩
      · simp only [hsplit, List.cons_append]
      · intro hcon
        rcases List.mem_cons.mp hcon with h1 | h1
        · exact haI h1.symm
        · exact hnotin h1

/-- **Unique-I bag-order split** (iter489). Sharpens the earliest-I decomposition
(`pieces_split_at_first_I`, iter488) under the defining bag fact that a 7-bag contains exactly one
`I`: when `ps` has `count Piece.I = 1`, the split `pre ++ Piece.I :: post` carries NO `I` on either
side, so an adversarial bag order is exactly one filler run, one regulator drain, one filler run with
no stray regulator. This pins the scheduling shape the interleaving closure consumes: both `pre` and
`post` are I-free, hence (once their pieces are also known to avoid S and Z) eligible inputs for the
certified filler-run half-cycle lemmas (iter485, iter486). The remaining open content is geometric
rather than combinatorial: re-establishing a flat front band after the mid-bag drain so `post` has a
landing surface, plus the S and Z notch routing and the per-bag raise-versus-drain balance for every
order (#66, #72). -/
theorem pieces_split_at_unique_I {ps : List Piece} (h : ps.count Piece.I = 1) :
    ∃ (pre post : List Piece),
      ps = pre ++ Piece.I :: post ∧ Piece.I ∉ pre ∧ Piece.I ∉ post := by
  have hmem : Piece.I ∈ ps := by
    by_contra hcon
    have hz := List.count_eq_zero.mpr hcon
    omega
  obtain ⟨pre, post, hsplit, hnotin⟩ := pieces_split_at_first_I hmem
  refine ⟨pre, post, hsplit, hnotin, ?_⟩
  apply List.count_eq_zero.mp
  have hcpre : pre.count Piece.I = 0 := List.count_eq_zero.mpr hnotin
  have hc : ps.count Piece.I = pre.count Piece.I + (post.count Piece.I + 1) := by
    rw [hsplit, List.count_append, List.count_cons_self]
  omega

/-- **A drain is always available from a spread band with enough floor** (iter490). The drain-stable
face of the reservoir, stated in the closed spread-band vocabulary that survives a regulator `I`
rather than the flat-front vocabulary that does not. Any `IsSpreadBoundedRWSkylineAt cfg spread floor`
board with `4 ≤ floor` exposes its reserved empty well `w` (the existential column the band records at
height 0) and admits the vertical `I` dropped there: the well clears its four banked rows and the
surface settles into `IsSpreadBoundedRWSkylineAt cfg spread (floor - 4)` at the same spread, with `w`
still a legal in-bounds empty well. Unlike the flat-front band — whose filled region is bumpy in
`[base, base + s]` and is NOT re-flattened by a clear, so a mid-bag drain cannot re-bootstrap a flat
shelf — the spread band is closed under the drain, which is exactly why the bag closure for an
arbitrary order must be carried on the spread band: the regulator may arrive at any phase, and from
any spread member with floor at least four the drain fires and returns a spread member four rows
lower. This pins down the goal's "a drain is always available before the limit is reached" clause for
the spread carrier. It does not yet schedule the fillers between drains for every order, nor route the
S and Z notch pieces, nor close the per-bag floor balance (#66, #72). -/
theorem isSpreadBoundedRWSkylineAt_drain_available {cfg : GameConfig} {spread floor : ℕ} {b : Board}
    (hb : Board.IsSpreadBoundedRWSkylineAt cfg spread floor b) (hfloor4 : 4 ≤ floor) :
    ∃ w : ℕ, w < cfg.cols ∧ Board.colHeight b w = 0 ∧
      Board.IsSpreadBoundedRWSkylineAt cfg spread (floor - 4)
        (Placement.applyStep cfg b { piece := Piece.I, rot := 1, col := w }) := by
  obtain ⟨h, w, rfl, hw, hw0, hband, hslack⟩ := hb
  refine ⟨w, hw, ?_, ?_⟩
  · rw [Board.colHeight_skyline hw]; exact hw0
  · exact Board.isSpreadBoundedRWSkylineAt_vertI_well_descend hw hw0 hfloor4 hband hslack

/-- **The available drain also survives** (iter491). The survival-certificate companion to
`isSpreadBoundedRWSkylineAt_drain_available` (iter490): the spread band landed on after the regulator
`I` clears its four banked rows is itself a spread-bounded reserved well, so by
`not_isLost_of_isSpreadBoundedRWSkyline` it has not topped out. Bundling non-loss with the drain edge
is what the final reduction needs at the regulator step: every time the once-per-bag `I` fires it must
both keep the carrier invariant (the `floor - 4` spread band) and certify the board did not spill over
the ceiling in the process. This closes the regulator branch of the spread-carrier survival
obligation; the open content is still the filler scheduling between drains, the S and Z notch routing,
and the per-bag floor balance for every order (#66, #72). -/
theorem isSpreadBoundedRWSkylineAt_drain_available_safe {cfg : GameConfig} {spread floor : ℕ}
    {b : Board} (hb : Board.IsSpreadBoundedRWSkylineAt cfg spread floor b) (hfloor4 : 4 ≤ floor) :
    ∃ w : ℕ, w < cfg.cols ∧ Board.colHeight b w = 0 ∧
      Board.IsSpreadBoundedRWSkylineAt cfg spread (floor - 4)
        (Placement.applyStep cfg b { piece := Piece.I, rot := 1, col := w }) ∧
      ¬ Board.isLost cfg
        (Placement.applyStep cfg b { piece := Piece.I, rot := 1, col := w }) := by
  obtain ⟨w, hw, hw0, hdrain⟩ := isSpreadBoundedRWSkylineAt_drain_available hb hfloor4
  exact ⟨w, hw, hw0, hdrain,
    Board.not_isLost_of_isSpreadBoundedRWSkyline
      (Board.isSpreadBoundedRWSkyline_of_isSpreadBoundedRWSkylineAt hdrain)⟩

/-- **Every adversarial bag order decomposes around its unique regulator I** (iter492). The
bag-faithful specialization of `pieces_split_at_unique_I` (iter489): a real 7-bag order is a
permutation of the seven distinct pieces, so it contains exactly one `I`. Hence any `ps` with
`ps.Perm [O, I, S, Z, T, L, J]` splits canonically as `pre ++ I :: post` with the regulator `I`
absent from both `pre` and `post`. This is the combinatorial backbone of the all-orders closure the
goal demands: no matter how the adversary permutes the bag, the surface sees exactly one drain `I`,
flanked by two filler runs carrying only the six non-regulating pieces. The count fact comes for
free from `Perm.count_eq` against the canonical enumeration, where the canonical bag's `count I`
evaluates to `1` by `decide`. The remaining open content stays geometric, not combinatorial:
scheduling the two filler runs against the drain phase for every permutation, re-establishing a
fill-friendly landing surface after the mid-bag drain, routing the S and Z notch pieces, and the
per-bag raise versus drain height balance (#66, #72). -/
theorem bagOrder_split_at_unique_I {ps : List Piece}
    (h : ps.Perm [Piece.O, Piece.I, Piece.S, Piece.Z, Piece.T, Piece.L, Piece.J]) :
    ∃ (pre post : List Piece),
      ps = pre ++ Piece.I :: post ∧ Piece.I ∉ pre ∧ Piece.I ∉ post := by
  apply pieces_split_at_unique_I
  rw [h.count_eq Piece.I]
  decide

/-- **Every piece is owed exactly once in an adversarial bag order** (iter493). The full count
characterization underlying `bagOrder_split_at_unique_I` (iter492): since a real 7-bag order is a
permutation of the seven distinct pieces, EVERY piece — not just the regulator `I` — appears exactly
once. Hence `ps.count p = 1` for all `p`, proved uniformly from `Perm.count_eq` against the canonical
enumeration by case analysis on `p`. This is the multiset substrate for the bag-phase accounting the
goal demands: at any phase of the bag, the pieces still owed form a determined sub-multiset, each
owed exactly once, so the invariant can track which pieces are still owed as a plain subset of the
seven. In particular the two geometrically hard pieces `S` and `Z` each arrive exactly once per bag,
so a single S-notch and a single Z-notch routing suffices per bag (the column-budget content of #90,
#151). The remaining open content stays geometric: scheduling the filler runs around the drain for
every order, re-establishing a landing surface after the mid-bag drain, and the per-bag height
balance (#66, #72). -/
theorem bagOrder_count_eq_one {ps : List Piece}
    (h : ps.Perm [Piece.O, Piece.I, Piece.S, Piece.Z, Piece.T, Piece.L, Piece.J])
    (p : Piece) : ps.count p = 1 := by
  rw [h.count_eq p]
  cases p <;> decide

/-- **The two filler runs of a bag order together permute the six non-I pieces** (iter494).
Sharpening `bagOrder_split_at_unique_I` (iter492): after splitting an adversarial bag order at its
unique regulator `I` as `pre ++ I :: post`, the concatenation `pre ++ post` of the two I-free filler
runs is exactly a permutation of `[O, S, Z, T, L, J]` — the six non-regulating pieces, each owed
once. The proof moves the `I` to the head via `perm_middle`, transports across the bag permutation,
and cancels the shared head with `Perm.cons_inv`. This is the precise statement of what the fillers
owe between drains: whatever the adversary's order, the surface must absorb exactly one each of O, S,
Z, T, L, J across the two runs flanking the single drain. It pins the scheduling obligation to a
fixed multiset, isolating the genuine geometric question (#66, #72): can a bag-phase-aware reservoir
host that fixed six-piece multiset, split arbitrarily into a pre-drain run and a post-drain run, for
every interleaving the adversary picks? The height balance and the S, Z notch routing across the
mid-bag drain stay open. -/
theorem bagOrder_filler_perm {ps : List Piece}
    (h : ps.Perm [Piece.O, Piece.I, Piece.S, Piece.Z, Piece.T, Piece.L, Piece.J]) :
    ∃ (pre post : List Piece),
      ps = pre ++ Piece.I :: post ∧ Piece.I ∉ pre ∧ Piece.I ∉ post ∧
      (pre ++ post).Perm [Piece.O, Piece.S, Piece.Z, Piece.T, Piece.L, Piece.J] := by
  obtain ⟨pre, post, hsplit, hpre, hpost⟩ := bagOrder_split_at_unique_I h
  refine ⟨pre, post, hsplit, hpre, hpost, ?_⟩
  have hmid : (Piece.I :: (pre ++ post)).Perm (pre ++ Piece.I :: post) :=
    List.perm_middle.symm
  rw [← hsplit] at hmid
  have h2 := hmid.trans h
  have h3 : ([Piece.O, Piece.I, Piece.S, Piece.Z, Piece.T, Piece.L, Piece.J] : List Piece).Perm
      (Piece.I :: [Piece.O, Piece.S, Piece.Z, Piece.T, Piece.L, Piece.J]) := by decide
  exact (h2.trans h3).cons_inv

/-- **Each filler run owes at most one S and at most one Z** (iter495). The notch-budget corollary
of `bagOrder_filler_perm` (iter494): since `pre ++ post` permutes `[O, S, Z, T, L, J]`, the staircase
pieces S and Z each occur exactly once across the two runs, hence at most once in either run alone.
So whatever the adversary's order, neither the pre-drain run nor the post-drain run ever owes two S
pieces or two Z pieces. This is the structural escape from the column-budget obstruction (#90, #151:
a single fixed surface cannot host pocket + well + S-notch + Z-notch = 11 columns on a board only ten
wide): a phase-aware carrier need only ever carry ONE notch of each chirality at a time, dropped as
soon as that staircase piece is spent, because a single run never demands two of the same chirality
at once. The lemma bounds the notch-routing obligation; it does not yet schedule that routing
geometrically — re-establishing the landing surface across the mid-bag drain and the per-bag height
balance for every order remain the open content (#66, #72). -/
theorem bagOrder_split_run_notch_le {ps : List Piece}
    (h : ps.Perm [Piece.O, Piece.I, Piece.S, Piece.Z, Piece.T, Piece.L, Piece.J]) :
    ∃ (pre post : List Piece),
      ps = pre ++ Piece.I :: post ∧ Piece.I ∉ pre ∧ Piece.I ∉ post ∧
      pre.count Piece.S ≤ 1 ∧ post.count Piece.S ≤ 1 ∧
      pre.count Piece.Z ≤ 1 ∧ post.count Piece.Z ≤ 1 := by
  obtain ⟨pre, post, hsplit, hpre, hpost, hperm⟩ := bagOrder_filler_perm h
  have hS : pre.count Piece.S + post.count Piece.S = 1 := by
    have hc := hperm.count_eq Piece.S
    rw [List.count_append] at hc
    rw [hc]; decide
  have hZ : pre.count Piece.Z + post.count Piece.Z = 1 := by
    have hc := hperm.count_eq Piece.Z
    rw [List.count_append] at hc
    rw [hc]; decide
  exact ⟨pre, post, hsplit, hpre, hpost, by omega, by omega, by omega, by omega⟩

/-- **The regulator drain iterates `n` times on the drain-stable spread band** (iter496). The
`n`-fold closure of `isSpreadBoundedRWSkylineAt_drain_available` (iter490): a spread band whose floor
has banked at least `4 * n` rows admits `n` consecutive vertical-`I` drops, each into the empty well
the band exposes at that step, and lands in a spread band at the same spread with the floor lowered
by exactly `4 * n`. Each well column is recorded in order in a length-`n` list and is in bounds, so
the whole descent is a concrete sequence of valid regulator placements. Because the spread band —
unlike the bumpy flat-front band — is closed under the clear, the drain can fire again and again
without ever leaving the carrier vocabulary, which is exactly the multi-bag drain accounting the
five-bag super-cycle balance needs: the once-per-bag regulator, summed across several bags, lowers
the floor in steps of four while the carrier shape is preserved throughout. This pins the drain side
of the per-bag raise versus drain ledger; it does not schedule the fillers that re-raise the floor
between drains, nor route the S and Z notch pieces, nor close the all-orders balance (#66, #72). -/
theorem isSpreadBoundedRWSkylineAt_iter_drain {cfg : GameConfig} {spread : ℕ} :
    ∀ (n : ℕ) {floor : ℕ} {b : Board},
      Board.IsSpreadBoundedRWSkylineAt cfg spread floor b → 4 * n ≤ floor →
      ∃ ws : List ℕ,
        ws.length = n ∧ (∀ w ∈ ws, w < cfg.cols) ∧
        Board.IsSpreadBoundedRWSkylineAt cfg spread (floor - 4 * n)
          (ws.foldl (fun b' w =>
            Placement.applyStep cfg b' { piece := Piece.I, rot := 1, col := w }) b) := by
  intro n
  induction n with
  | zero =>
    intro floor b hb _
    exact ⟨[], rfl, by simp, by simpa using hb⟩
  | succ k ih =>
    intro floor b hb hle
    have hfloor4 : 4 ≤ floor := by omega
    obtain ⟨w, hw, hw0, hdrain⟩ := isSpreadBoundedRWSkylineAt_drain_available hb hfloor4
    have hle' : 4 * k ≤ floor - 4 := by omega
    obtain ⟨ws, hlen, hwmem, hband⟩ := ih hdrain hle'
    refine ⟨w :: ws, by rw [List.length_cons, hlen], ?_, ?_⟩
    · intro v hv
      rcases List.mem_cons.mp hv with rfl | hv'
      · exact hw
      · exact hwmem v hv'
    · have harith : floor - 4 * (k + 1) = floor - 4 - 4 * k := by omega
      rw [List.foldl_cons, harith]
      exact hband

/-- **The iterated regulator drain survives at every prefix** (iter497). The transient-survival
companion to `isSpreadBoundedRWSkylineAt_iter_drain` (iter496): not only does the `n`-fold descent
land in a spread band at floor lowered by `4 * n`, but the board after each of the first `k` drops,
for every `k`, has not topped out. Each prefix board is reached by folding the first `k` regulator
placements, and the proof walks the same induction as iter496: at `k = 0` the starting band is safe
by the spread-band non-loss certificate (`not_isLost_of_isSpreadBoundedRWSkyline`), and the cons step
peels one drain with `isSpreadBoundedRWSkylineAt_drain_available` (iter490) and reuses the tail
certificate for the rest. This is the survival half of the multi-bag drain accounting: every time the
once-per-bag `I` fires the surface must stay under the ceiling, and now that holds across an
arbitrary run of drains, not just the endpoint. The open content is unchanged: scheduling the
fillers that re-raise the floor between drains, routing the S and Z notch pieces, and closing the
per-bag raise versus drain balance for every adversarial order (#66, #72). -/
theorem isSpreadBoundedRWSkylineAt_iter_drain_safe {cfg : GameConfig} {spread : ℕ} :
    ∀ (n : ℕ) {floor : ℕ} {b : Board},
      Board.IsSpreadBoundedRWSkylineAt cfg spread floor b → 4 * n ≤ floor →
      ∃ ws : List ℕ,
        ws.length = n ∧ (∀ w ∈ ws, w < cfg.cols) ∧
        Board.IsSpreadBoundedRWSkylineAt cfg spread (floor - 4 * n)
          (ws.foldl (fun b' w =>
            Placement.applyStep cfg b' { piece := Piece.I, rot := 1, col := w }) b) ∧
        (∀ k, ¬ Board.isLost cfg
          ((ws.take k).foldl (fun b' w =>
            Placement.applyStep cfg b' { piece := Piece.I, rot := 1, col := w }) b)) := by
  intro n
  induction n with
  | zero =>
    intro floor b hb _
    refine ⟨[], rfl, by simp, by simpa using hb, ?_⟩
    intro k
    simp only [List.take_nil, List.foldl_nil]
    exact Board.not_isLost_of_isSpreadBoundedRWSkyline
      (Board.isSpreadBoundedRWSkyline_of_isSpreadBoundedRWSkylineAt hb)
  | succ k ih =>
    intro floor b hb hle
    have hfloor4 : 4 ≤ floor := by omega
    obtain ⟨w, hw, hw0, hdrain⟩ := isSpreadBoundedRWSkylineAt_drain_available hb hfloor4
    have hle' : 4 * k ≤ floor - 4 := by omega
    obtain ⟨ws, hlen, hwmem, hband, hsafe⟩ := ih hdrain hle'
    refine ⟨w :: ws, by rw [List.length_cons, hlen], ?_, ?_, ?_⟩
    · intro v hv
      rcases List.mem_cons.mp hv with rfl | hv'
      · exact hw
      · exact hwmem v hv'
    · have harith : floor - 4 * (k + 1) = floor - 4 - 4 * k := by omega
      rw [List.foldl_cons, harith]
      exact hband
    · intro j
      cases j with
      | zero =>
        simp only [List.take_zero, List.foldl_nil]
        exact Board.not_isLost_of_isSpreadBoundedRWSkyline
          (Board.isSpreadBoundedRWSkyline_of_isSpreadBoundedRWSkylineAt hb)
      | succ m =>
        simp only [List.take_succ_cons, List.foldl_cons]
        exact hsafe m

/-- Maximal regulator drain on the drain-stable spread band: from a spread member at
height `floor`, fire the once-per-bag vertical-I well drain `floor / 4` times to bring the
stack all the way down to the bounded reset floor `floor % 4` (which is `< 4`). This is the
goal's "drain back down to a reset surface": the residual floor is a bounded constant
independent of how high the stack had grown, and every intermediate prefix survives (no
`isLost`). Builds on `isSpreadBoundedRWSkylineAt_iter_drain_safe` with `n := floor / 4`;
`omega` discharges both the `4 * (floor / 4) ≤ floor` precondition and the
`floor - 4 * (floor / 4) = floor % 4` residual identity. -/
theorem isSpreadBoundedRWSkylineAt_maximal_drain {cfg : GameConfig} {spread floor : ℕ} {b : Board}
    (hb : Board.IsSpreadBoundedRWSkylineAt cfg spread floor b) :
    ∃ ws : List ℕ,
      ws.length = floor / 4 ∧ (∀ w ∈ ws, w < cfg.cols) ∧
      Board.IsSpreadBoundedRWSkylineAt cfg spread (floor % 4)
        (ws.foldl (fun b' w =>
          Placement.applyStep cfg b' { piece := Piece.I, rot := 1, col := w }) b) ∧
      (∀ k, ¬ Board.isLost cfg
        ((ws.take k).foldl (fun b' w =>
          Placement.applyStep cfg b' { piece := Piece.I, rot := 1, col := w }) b)) := by
  obtain ⟨ws, hlen, hwmem, hband, hsafe⟩ :=
    isSpreadBoundedRWSkylineAt_iter_drain_safe (floor / 4) hb (by omega)
  refine ⟨ws, hlen, hwmem, ?_, hsafe⟩
  have hmod : floor - 4 * (floor / 4) = floor % 4 := by omega
  rwa [hmod] at hband

/-- **Constant height cap on the maximal-drain reset surface** (iter499). Reading the band-top
cap `maxColHeight_le_of_isSpreadBoundedRWSkylineAt` off the `isSpreadBoundedRWSkylineAt_maximal_drain`
endpoint pins the drained skyline under `floor % 4 + spread`. Since `floor % 4 < 4` always, this is a
CONSTANT ceiling `< 4 + spread` independent of how high `floor` had grown — the concrete numeric face
of the goal's "drain back down to a reset surface": no matter how tall the stack got, the maximal
regulator drain returns it to a bounded reset band, and every intermediate prefix survives. This is the
height-ledger handle for chaining bag half-cycles; it still says nothing about the adversarial fill
order between drains or the S/Z notch route (#66, #72 remain the open closure). -/
theorem isSpreadBoundedRWSkylineAt_maximal_drain_height {cfg : GameConfig} {spread floor : ℕ}
    {b : Board} (hb : Board.IsSpreadBoundedRWSkylineAt cfg spread floor b) :
    ∃ ws : List ℕ,
      ws.length = floor / 4 ∧ (∀ w ∈ ws, w < cfg.cols) ∧
      Board.maxColHeight cfg
        (ws.foldl (fun b' w =>
          Placement.applyStep cfg b' { piece := Piece.I, rot := 1, col := w }) b) ≤ floor % 4 + spread ∧
      (∀ k, ¬ Board.isLost cfg
        ((ws.take k).foldl (fun b' w =>
          Placement.applyStep cfg b' { piece := Piece.I, rot := 1, col := w }) b)) := by
  obtain ⟨ws, hlen, hwmem, hband, hsafe⟩ := isSpreadBoundedRWSkylineAt_maximal_drain hb
  exact ⟨ws, hlen, hwmem, Board.maxColHeight_le_of_isSpreadBoundedRWSkylineAt hband, hsafe⟩

/-- **Bag-order filler runs sum to six pieces** (iter500). Refines the split at the unique I:
any bag order `ps` splits as `pre ++ I :: post` with `pre.length + post.length = 6`. Since the bag
has seven pieces and exactly one is the regulator I, at most six non-I fillers ever arrive before
the I (split arbitrarily by the adversary between the two runs). This is the quantitative core of
"a drain is always available before the limit is reached": the stack can rise by at most six piece
placements between consecutive regulator drains, so a constant slack above the reset band suffices to
stay under the height limit no matter where the adversary puts the I. It pairs with the per-run notch
bound `bagOrder_split_run_notch_le` (each run owes at most one S and one Z). The actual all-order
height balance and the S/Z notch routing under the column-budget obstruction (#66, #72) are still
open. -/
theorem bagOrder_split_run_total_len {ps : List Piece}
    (h : ps.Perm [Piece.O, Piece.I, Piece.S, Piece.Z, Piece.T, Piece.L, Piece.J]) :
    ∃ (pre post : List Piece),
      ps = pre ++ Piece.I :: post ∧ Piece.I ∉ pre ∧ Piece.I ∉ post ∧
      pre.length + post.length = 6 := by
  obtain ⟨pre, post, hsplit, hpre, hpost, _, _, _, _⟩ := bagOrder_split_run_notch_le h
  refine ⟨pre, post, hsplit, hpre, hpost, ?_⟩
  have hlen : ps.length = 7 := by simpa using h.length_eq
  rw [hsplit, List.length_append, List.length_cons] at hlen
  omega

/-- **Absolute constant height of the maximal-drain reset surface** (iter501). Collapses the
floor-relative cap `isSpreadBoundedRWSkylineAt_maximal_drain_height` to a constant: since `floor % 4`
is always `< 4`, the drained skyline sits at `maxColHeight ≤ 3 + spread` with NO dependence on `floor`
whatsoever. However tall the stack had grown, the maximal regulator drain returns it to a fixed-height
reset band capped by `3 + spread`, and every intermediate prefix survives. This is the sharpest form of
the goal's "drain back down to a reset surface": a universal ceiling for the post-drain surface,
exactly what a height-bounded bag invariant needs as its lower anchor. It still leaves the fill side and
the adversarial order open (#66, #72). -/
theorem isSpreadBoundedRWSkylineAt_maximal_drain_height_const {cfg : GameConfig} {spread floor : ℕ}
    {b : Board} (hb : Board.IsSpreadBoundedRWSkylineAt cfg spread floor b) :
    ∃ ws : List ℕ,
      ws.length = floor / 4 ∧ (∀ w ∈ ws, w < cfg.cols) ∧
      Board.maxColHeight cfg
        (ws.foldl (fun b' w =>
          Placement.applyStep cfg b' { piece := Piece.I, rot := 1, col := w }) b) ≤ 3 + spread ∧
      (∀ k, ¬ Board.isLost cfg
        ((ws.take k).foldl (fun b' w =>
          Placement.applyStep cfg b' { piece := Piece.I, rot := 1, col := w }) b)) := by
  obtain ⟨ws, hlen, hwmem, hheight, hsafe⟩ := isSpreadBoundedRWSkylineAt_maximal_drain_height hb
  exact ⟨ws, hlen, hwmem, by omega, hsafe⟩

/-- **Drain to a reset surface** (iter502). The reusable interface form of the maximal drain: from
any spread band at height `floor`, a safe regulator drain sequence lands in a spread band at SOME
`floor' < 4` — a bounded reset surface — hiding the modular `floor % 4` arithmetic behind a clean
existential. This is the canonical "drain back down to a reset surface" edge the bag cycle consumes:
no matter how tall the stack grew, the once-per-bag I regulator returns it to a reset band whose floor
is one of four bounded residues, and every intermediate prefix survives. It packages the endpoint as a
genuine carrier state ready to re-enter the fill phase; the fill side and adversarial-order closure
(#66, #72) remain the open work. -/
theorem isSpreadBoundedRWSkylineAt_drain_to_reset {cfg : GameConfig} {spread floor : ℕ}
    {b : Board} (hb : Board.IsSpreadBoundedRWSkylineAt cfg spread floor b) :
    ∃ (ws : List ℕ) (floor' : ℕ),
      floor' < 4 ∧ ws.length = floor / 4 ∧ (∀ w ∈ ws, w < cfg.cols) ∧
      Board.IsSpreadBoundedRWSkylineAt cfg spread floor'
        (ws.foldl (fun b' w =>
          Placement.applyStep cfg b' { piece := Piece.I, rot := 1, col := w }) b) ∧
      (∀ k, ¬ Board.isLost cfg
        ((ws.take k).foldl (fun b' w =>
          Placement.applyStep cfg b' { piece := Piece.I, rot := 1, col := w }) b)) := by
  obtain ⟨ws, hlen, hwmem, hband, hsafe⟩ := isSpreadBoundedRWSkylineAt_maximal_drain hb
  exact ⟨ws, floor % 4, by omega, hlen, hwmem, hband, hsafe⟩

/-- **Full bag multiset characterization** (iter503). Any bag order `ps` contains each of the seven
tetrominoes exactly once: `ps.count p = 1` for every `p`. This is the decidable foundation for the
bag-phase bookkeeping the goal calls for ("which pieces are still owed"): at any point mid-bag, the
owed pieces are exactly those not yet drawn, and this lemma pins the total budget — one O, one I, one
S, one Z, one T, one L, one J. In particular exactly one regulator I per bag (the drain) and exactly
one S and one Z (the two notch pieces) to route. Proved by `Perm.count_eq` against the canonical bag
followed by `decide`. The scheduling of these owed pieces onto a phase-aware surface for every order,
and the per-bag height balance, remain the open closure (#66, #72). -/
theorem bagOrder_count_each {ps : List Piece}
    (h : ps.Perm [Piece.O, Piece.I, Piece.S, Piece.Z, Piece.T, Piece.L, Piece.J]) :
    ps.count Piece.O = 1 ∧ ps.count Piece.I = 1 ∧ ps.count Piece.S = 1 ∧
    ps.count Piece.Z = 1 ∧ ps.count Piece.T = 1 ∧ ps.count Piece.L = 1 ∧
    ps.count Piece.J = 1 := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> · rw [h.count_eq]; decide

/-- **Every bag order contains all seven pieces** (iter504). For any bag order `ps` and any piece
`p`, `p ∈ ps`. This is the existence guarantee the whole reservoir construction leans on: in every
bag the regulator I is present (so a drain is always available within the bag) and both notch pieces
S and Z are present (so the staircase notches that host them must be offered). Together with
`bagOrder_count_each` (each piece exactly once) this fully pins the bag as the canonical 7-piece
multiset, the structural content of the 7-bag randomizer. Proved by transporting membership across the
permutation (`Perm.mem_iff`) and deciding membership in the canonical list. The adversary still chooses
the ORDER; closing the height invariant for every order remains open (#66, #72). -/
theorem bagOrder_mem_each {ps : List Piece}
    (h : ps.Perm [Piece.O, Piece.I, Piece.S, Piece.Z, Piece.T, Piece.L, Piece.J]) :
    ∀ p : Piece, p ∈ ps := by
  intro p
  rw [h.mem_iff]
  cases p <;> decide

/-- **Spread weakening of the floor-pinned band** (iter505). A band that fits within spread `spread`
also fits within any wider spread `spread' ≥ spread`, provided the wider band still respects the height
limit (`floor + spread' ≤ rows`). Widening only relaxes the per-column upper bound `h j ≤ floor +
spread`, so every column already inside the tight band stays inside the loose one; the only new
obligation is the height-limit cap, which is supplied as a hypothesis. This is the structural glue for
unifying sub-results proved at different spreads onto one common band width — useful when the flat fill
contributes one spread and the S/Z notch staircase contributes another, and the bag invariant must hold
them in a single carrier. It does not touch the per-bag height balance or the adversarial order
(#66, #72). -/
theorem isSpreadBoundedRWSkylineAt_spread_mono {cfg : GameConfig} {spread spread' floor : ℕ}
    {b : Board} (hb : Board.IsSpreadBoundedRWSkylineAt cfg spread floor b)
    (hle : spread ≤ spread') (hcap : floor + spread' ≤ cfg.rows) :
    Board.IsSpreadBoundedRWSkylineAt cfg spread' floor b := by
  obtain ⟨h, w, hbsky, hw, hw0, hband, _⟩ := hb
  refine ⟨h, w, hbsky, hw, hw0, ?_, hcap⟩
  intro j hj hjw
  obtain ⟨hlo, hhi⟩ := hband j hj hjw
  exact ⟨hlo, by omega⟩

/-- **The pure flat fillers of a bag order permute `[O, T, L, J]`** (iter506). The flat-core
refinement of `bagOrder_filler_perm` (iter494) and `bagOrder_split_run_notch_le` (iter495): after
splitting an adversarial bag order at its unique regulator `I` as `pre ++ I :: post`, the two filler
runs together permute the six non-`I` pieces (iter494); dropping the two staircase pieces `S` and `Z`
from that combined run leaves exactly a permutation of `[O, T, L, J]` — the four flat fillers that the
flat-front band absorbs WITHOUT any notch, directly via `isFlatFrontBandAt_nonSZ_filler_step` and the
certified `isFlatFrontBandAt_nonSZ_fill_list_*` half-cycle (iter482, iter485, iter486). The proof
transports the combined-run permutation across `List.Perm.filter` with the Bool guard that keeps every
piece except `S` and `Z`, and evaluates the canonical filtered list to `[O, T, L, J]` by `decide`.
This isolates the exact multiset the non-staircase fill-list lemmas consume: whatever the adversary's
order, the surface owes precisely one each of O, T, L, J as plain flat fillers, with the S and Z
routed separately through their manufactured notches (iter424, iter425). It is multiset accounting,
not scheduling — it does NOT interleave the flat fillers with the S and Z notch placements, re-establish
a landing surface across the mid-bag drain, or close the per-bag raise versus drain balance for every
order (#66, #72). -/
theorem bagOrder_filler_nonSZ_perm {ps : List Piece}
    (h : ps.Perm [Piece.O, Piece.I, Piece.S, Piece.Z, Piece.T, Piece.L, Piece.J]) :
    ∃ (pre post : List Piece),
      ps = pre ++ Piece.I :: post ∧ Piece.I ∉ pre ∧ Piece.I ∉ post ∧
      ((pre ++ post).filter
        (fun p => match p with | Piece.S => false | Piece.Z => false | _ => true)).Perm
        [Piece.O, Piece.T, Piece.L, Piece.J] := by
  obtain ⟨pre, post, hsplit, hpre, hpost, hperm⟩ := bagOrder_filler_perm h
  refine ⟨pre, post, hsplit, hpre, hpost, ?_⟩
  have hf := hperm.filter
    (fun p => match p with | Piece.S => false | Piece.Z => false | _ => true)
  have heq : ([Piece.O, Piece.S, Piece.Z, Piece.T, Piece.L, Piece.J].filter
      (fun p => match p with | Piece.S => false | Piece.Z => false | _ => true))
      = [Piece.O, Piece.T, Piece.L, Piece.J] := by decide
  rwa [heq] at hf

/-- **Pocket-preserving maximal drain: `n` vertical-`I` drops keep the level pocket band** (iter507).
The pocket-PRESERVING analogue of the pocket-less iterated drain `isSpreadBoundedRWSkylineAt_iter_drain`
(iter496). Each single step `isLevelPocketBandAt_vertI_descends` drops the regulator `I` into the
reserved well, lowering every column by 4 and landing back in `IsLevelPocketBandAt` at floor `floor - 4`
with the SAME width-4 pocket `c..c+3` intact (same `c`). Iterating `n` such drops while `4 * n ≤ floor`
yields a fold of `n` valid `I` placements whose result is the band at floor `floor - 4 * n`, still
carrying its pocket. Unlike the spread-band drain — which forgets the pocket and so cannot host a
subsequent flat filler — this chain keeps a guaranteed landing site available all the way down, which
is exactly what the reservoir needs to drain back to a low reset surface and still accept the next
bag's fillers. It is the descent half of the per-bag cycle stated on the pocket carrier; it does NOT
manufacture the rise phase, route the `S` and `Z` notches, or close the adversarial per-bag balance
(#66, #72). -/
theorem isLevelPocketBandAt_iter_vertI_descends {cfg : GameConfig} {spread : ℕ} :
    ∀ (n : ℕ) {floor : ℕ} {b : Board},
      Board.IsLevelPocketBandAt cfg spread floor b → 4 * n ≤ floor →
      ∃ pls : List Placement,
        pls.length = n ∧ (∀ pl ∈ pls, pl.piece = Piece.I ∧ pl.Valid cfg) ∧
        Board.IsLevelPocketBandAt cfg spread (floor - 4 * n)
          (pls.foldl (Placement.applyStep cfg) b) := by
  intro n
  induction n with
  | zero =>
    intro floor b hb _
    exact ⟨[], rfl, by simp, by simpa using hb⟩
  | succ k ih =>
    intro floor b hb hle
    have hfloor4 : 4 ≤ floor := by omega
    obtain ⟨pl, hpiece, hvalid, hdesc⟩ := Board.isLevelPocketBandAt_vertI_descends hb hfloor4
    have hle' : 4 * k ≤ floor - 4 := by omega
    obtain ⟨pls, hlen, hmem, hband⟩ := ih hdesc hle'
    refine ⟨pl :: pls, by rw [List.length_cons, hlen], ?_, ?_⟩
    · intro q hq
      rcases List.mem_cons.mp hq with rfl | hq'
      · exact ⟨hpiece, hvalid⟩
      · exact hmem q hq'
    · have harith : floor - 4 * (k + 1) = floor - 4 - 4 * k := by omega
      rw [List.foldl_cons, harith]
      exact hband

/-- **Pocket-preserving maximal drain to a bounded reset floor** (iter508). The pocket-PRESERVING
analogue of `isSpreadBoundedRWSkylineAt_maximal_drain` (iter498): from a level pocket band at height
`floor`, fire the once-per-bag vertical-`I` well drain `floor / 4` times to bring the stack all the
way down to the bounded reset floor `floor % 4` (which is `< 4`), KEEPING the width-4 pocket `c..c+3`
intact the whole way down. This is the goal's "drain back down to a reset surface", now on the carrier
that still offers a landing site: the residual floor is a bounded constant independent of how high the
stack had grown, AND the drained surface can immediately host the next bag's flat filler because its
pocket survived. Builds on the iterated pocket drain (iter507) with `n := floor / 4`; `omega`
discharges both the `4 * (floor / 4) ≤ floor` precondition and the `floor - 4 * (floor / 4) = floor % 4`
residual identity. It does NOT close the fill side, the S and Z notch routing, or the adversarial
per-bag balance (#66, #72). -/
theorem isLevelPocketBandAt_maximal_drain {cfg : GameConfig} {spread floor : ℕ} {b : Board}
    (hb : Board.IsLevelPocketBandAt cfg spread floor b) :
    ∃ pls : List Placement,
      pls.length = floor / 4 ∧ (∀ pl ∈ pls, pl.piece = Piece.I ∧ pl.Valid cfg) ∧
      Board.IsLevelPocketBandAt cfg spread (floor % 4)
        (pls.foldl (Placement.applyStep cfg) b) := by
  obtain ⟨pls, hlen, hmem, hband⟩ :=
    isLevelPocketBandAt_iter_vertI_descends (floor / 4) hb (by omega)
  refine ⟨pls, hlen, hmem, ?_⟩
  have hmod : floor - 4 * (floor / 4) = floor % 4 := by omega
  rwa [hmod] at hband

/-- **Height cap on the pocket-preserving maximal-drain reset surface** (iter509). The pocket-carrier
analogue of `isSpreadBoundedRWSkylineAt_maximal_drain_height` (iter499): reading the band-top cap
`maxColHeight_le_of_isLevelPocketBandAt` off the `isLevelPocketBandAt_maximal_drain` (iter508) endpoint
pins the drained skyline under `floor % 4 + spread`. Since `floor % 4 < 4` always, this is a CONSTANT
ceiling below `4 + spread` independent of how high `floor` had grown — the concrete numeric face of
"drain back down to a reset surface", now WITH the landing pocket still present so the surface can
immediately re-host the next bag's fill. This is the height-ledger lower anchor for chaining bag
half-cycles on a carrier that survives the drain AND keeps its pocket; it still says nothing about the
adversarial fill order or the S and Z notch route (#66, #72 remain the open closure). -/
theorem isLevelPocketBandAt_maximal_drain_height {cfg : GameConfig} {spread floor : ℕ}
    {b : Board} (hb : Board.IsLevelPocketBandAt cfg spread floor b) :
    ∃ pls : List Placement,
      pls.length = floor / 4 ∧ (∀ pl ∈ pls, pl.piece = Piece.I ∧ pl.Valid cfg) ∧
      Board.maxColHeight cfg (pls.foldl (Placement.applyStep cfg) b) ≤ floor % 4 + spread := by
  obtain ⟨pls, hlen, hmem, hband⟩ := isLevelPocketBandAt_maximal_drain hb
  exact ⟨pls, hlen, hmem, Board.maxColHeight_le_of_isLevelPocketBandAt hband⟩

/-- **Carrier-level reset: the maximal regulator drain returns any reservoir surface to a
fresh-bag reset state** (iter510). Lifts the pocket-preserving maximal drain (iter508) into the
`reservoirCarrier` vocabulary: from ANY level pocket band at spread `2` and arbitrary floor `floor`,
firing the reserved-well vertical-`I` drain `floor / 4` times lands in a level pocket band at the
bounded reset floor `floor % 4` (which is below `4`), and that surface re-enters
`reservoirCarrier Bag.full` — the carrier state for a fresh seven-piece bag — because the reset
ledger reads `floor % 4 + 7 + 1 < 4 + 8 = 12 ≤ 20`. This is the goal's "using the once-per-bag I to
drain back down and reset", stated at the carrier level: however high the non-`I` fills have driven
the surface, the guaranteed regulator drains it all the way back to a bag-ready reset, with the
landing pocket intact. It packages the drain endpoint as a genuine reservoir state; the complementary
fill side (raising the floor by at most one per non-`I` piece for every adversarial order, and the S
and Z notch routing) remains the open closure (#66, #72). -/
theorem reservoirCarrier_maximal_drain_reset {floor : ℕ} {b : Board}
    (hband : Board.IsLevelPocketBandAt GameConfig.standard 2 floor b) :
    ∃ pls : List Placement,
      pls.length = floor / 4 ∧
      (∀ pl ∈ pls, pl.piece = Piece.I ∧ pl.Valid GameConfig.standard) ∧
      reservoirCarrier Bag.full (pls.foldl (Placement.applyStep GameConfig.standard) b) := by
  obtain ⟨pls, hlen, hmem, hband'⟩ := isLevelPocketBandAt_maximal_drain hband
  refine ⟨pls, hlen, hmem, floor % 4, hband', ?_⟩
  rw [Bag.full_card]
  have hr : GameConfig.standard.rows = 20 := rfl
  omega

/-- **Survival face of the carrier-level maximal regulator drain to a fresh-bag reset** (iter552).
The every-prefix `¬ isLost` companion of `reservoirCarrier_maximal_drain_reset` (iter510): from any
spread-`2` level pocket band at arbitrary floor `floor`, firing the reserved-well vertical-`I` drain
`floor / 4` times not only lands in `reservoirCarrier Bag.full` — the carrier state for a fresh
seven-piece bag at the bounded reset floor `floor % 4` — it ALSO keeps every prefix of the drain
un-lost. The transition and reset ledger are exactly those of the unsafe reset, but routed through the
transient-survival iterated drain `isLevelPocketBandAt_vertI_iter_safe` at `n := floor / 4`: that
supplies the same length-`(floor / 4)` list of valid `I`-placements landing in the band at
`floor - 4 * (floor / 4) = floor % 4`, plus the per-prefix `¬ isLost` certificate, and the reset
ledger reads `floor % 4 + 7 + 1 < 4 + 8 = 12 ≤ 20` on the full bag (`Bag.full_card`). This is the
fully-certified "drain back down and reset" half of the per-bag cycle: a per-bag survival schedule may
run the whole inter-bag collapse blind to the intermediate boards, and this brick guarantees no
top-out at any clear AND that the surface re-enters a fresh-bag-ready reservoir state. It packages the
inter-bag reset as a survival certificate; the complementary fill side and the adversarial S and Z
notch routing remain the open closure (#66, #72). -/
theorem reservoirCarrier_maximal_drain_reset_safe {floor : ℕ} {b : Board}
    (hband : Board.IsLevelPocketBandAt GameConfig.standard 2 floor b) :
    ∃ pls : List Placement,
      pls.length = floor / 4 ∧
      (∀ pl ∈ pls, pl.piece = Piece.I ∧ pl.Valid GameConfig.standard) ∧
      reservoirCarrier Bag.full (pls.foldl (Placement.applyStep GameConfig.standard) b) ∧
      (∀ k, ¬ Board.isLost GameConfig.standard
        ((pls.take k).foldl (Placement.applyStep GameConfig.standard) b)) := by
  obtain ⟨pls, hlen, hmem, hband', hsafe⟩ :=
    Board.isLevelPocketBandAt_vertI_iter_safe (floor / 4) hband (by omega)
  have hmod : floor - 4 * (floor / 4) = floor % 4 := by omega
  rw [hmod] at hband'
  refine ⟨pls, hlen, hmem, ⟨floor % 4, hband', ?_⟩, hsafe⟩
  rw [Bag.full_card]
  have hr : GameConfig.standard.rows = 20 := rfl
  omega

/-- **Floor-hiding carrier form of the certified inter-bag reset drain** (iter553). The
arbitrary-member lift of `reservoirCarrier_maximal_drain_reset_safe` (iter552) into the
`IsBoundedPocketBandCarrier 2` vocabulary — the surface a bag-indexed strategy actually holds, since
it hides the exact floor behind an existential. From ANY spread-`2` bounded pocket-band carrier board,
whatever hidden floor it carries, the reserved-well vertical-`I` drain empties the stack all the way
down to a fresh-bag reset: the result re-enters `reservoirCarrier Bag.full` (the carrier state for a
full seven-piece bag) and every prefix of the drain is un-lost. The proof forgets the carrier to its
hidden floor (`obtain ⟨floor, hband⟩`) and hands that level band to the explicit-floor reset-safe,
dropping only the now-unstatable length face. This is the inter-bag transition a per-bag survival
schedule quotes at the bag boundary: it holds a bounded carrier (not an explicit floor), and this
brick certifies the regulator collapses it to a fresh-bag-ready reservoir without ever topping out.
The complementary fill side and the adversarial S and Z notch routing remain the open closure
(#66, #72). -/
theorem isBoundedPocketBandCarrier_maximal_drain_to_reservoir_safe {b : Board}
    (hb : Board.IsBoundedPocketBandCarrier 2 b) :
    ∃ pls : List Placement,
      (∀ pl ∈ pls, pl.piece = Piece.I ∧ pl.Valid GameConfig.standard) ∧
      reservoirCarrier Bag.full (pls.foldl (Placement.applyStep GameConfig.standard) b) ∧
      (∀ k, ¬ Board.isLost GameConfig.standard
        ((pls.take k).foldl (Placement.applyStep GameConfig.standard) b)) := by
  obtain ⟨floor, hband⟩ := hb
  obtain ⟨pls, _, hmem, hcarrier, hsafe⟩ :=
    reservoirCarrier_maximal_drain_reset_safe hband
  exact ⟨pls, hmem, hcarrier, hsafe⟩

/-- **A reset-floor level pocket band IS a full-bag spread carrier** (iter554). Bridges the
certified inter-bag reset endpoint into the spread-carrier vocabulary where the per-piece fill
edges live. The maximal drain lands the board in a level pocket band at floor `floor % 4 < 4`
(`reservoirCarrier_maximal_drain_reset`); this lemma takes that sharp `floor < 4` band and forgets
it to `reservoirSpreadCarrier Bag.full` via the pocket-to-spread forgetful edge
(`isSpreadBoundedRWSkylineAt_of_isLevelPocketBandAt`, spread preserved at `2`). The bridge is NOT
free in general — the spread-carrier ledger `floor + 2 + 7 + 1 ≤ 20` is `+2` stronger than the
level-band ledger `floor + 7 + 1 ≤ 20`, so it would fail for `floor ∈ {11, 12}` — but at the reset
`floor < 4` it holds with room to spare (`floor + 10 ≤ 13 ≤ 20`). This is the missing adapter that
lets the certified reset side (iter552/553) feed the spread-carrier front door
`tetrisSolvableValid_of_reservoirSpreadCarrier_closed`, where the open fill crux #66 must discharge
the per-bag closure. This does NOT prove `TetrisSolvableValid`: crux #66 (bag-level fill closure)
and #72 (richer carrier closed under all seven) remain open; no `sorry`. -/
theorem reservoirSpreadCarrier_full_of_isLevelPocketBandAt_reset {floor : ℕ} {b : Board}
    (hlt : floor < 4)
    (hband : Board.IsLevelPocketBandAt GameConfig.standard 2 floor b) :
    reservoirSpreadCarrier Bag.full b := by
  refine ⟨floor, 2, Board.isSpreadBoundedRWSkylineAt_of_isLevelPocketBandAt hband, ?_⟩
  rw [Bag.full_card]
  have hr : GameConfig.standard.rows = 20 := rfl
  omega

/-- **The owed `S`, paired behind its `L`, advances the fill front by three — staying in
flat-front-band vocabulary** (iter555). The notch-piece companion of the flat-filler front-advance
menu `isFlatFrontBandAt_filler_step` (iter411), which excludes `S` and `Z` because a bare flat shelf
cannot host them hole-free. Here the bag's `L` is spent first to re-dig the single-step `S`-notch at
the front triple `(c, c+1, c+2)`, then the owed `S` drops into it: the worked triple rises to
`(base+2, base+3, base+3)` (`colHeight_applyStep_LS_skyline_band_at` at level `f = base`), which with
spread `s ≥ 3` stays inside the band `[base, base + s]`; the reserved well at column `0` is untouched
(`0 < c`), and the shelf `[c+3, cols)` keeps its flat heights at `base`
(`colHeight_applyStep_LS_skyline_frame`). Hence the `L`-then-`S` pair lands an
`IsFlatFrontBandAt (c+3) s base` board — the front has marched three columns right exactly as a flat
triple-filler would, but with the owed `S` consumed.

This is the brick the layer-tiling fill needs to schedule the notch pieces WITHOUT dropping to the
generic spread band (unlike `reservoirSpreadCarrier_flat_LS_step`, iter518, which forgets the front
structure): the front-advance machinery now stays closed under the `L`-then-`S` pair, not only the
four strict flats `O, T, L, J`. Honest caveats unchanged: it bakes in the `L`-before-`S` order (the
all-orders adversary may draw the `S` first), and it is a two-piece edge, not the per-piece `hstep`.
The mirror `J`-then-`Z` pairing and the once-per-bag drain scheduling are the remaining bag-phase
content; crux #66 and #72 stay open and `TetrisSolvableValid` is NOT proven. -/
theorem isFlatFrontBandAt_LS_step {c s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt c s base b) (hs : 3 ≤ s)
    (hc0 : 0 < c) (hc2 : c + 2 < GameConfig.standard.cols) :
    IsFlatFrontBandAt (c + 3) s base
      (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard b { piece := Piece.L, rot := 0, col := c })
        { piece := Piece.S, rot := 0, col := c }) := by
  obtain ⟨h, rfl, hw0, hband, hcap, hflat⟩ := hb
  have hc : c < GameConfig.standard.cols := by omega
  have hc1 : c + 1 < GameConfig.standard.cols := by omega
  have ecc : h c = base := hflat c (le_refl c) hc
  have ec1 : h (c + 1) = base := hflat (c + 1) (by omega) hc1
  have ec2 : h (c + 2) = base := hflat (c + 2) (by omega) hc2
  obtain ⟨hLS, hLSeq, hLSw0⟩ :=
    Board.applyStep_LS_skyline_flat_well (w := 0) hc hc1 hc2
      (by rw [ec1, ecc]) (by rw [ec2, ecc]) (by decide) (by omega) (by omega) (by omega) hw0
  refine ⟨hLS, hLSeq, hLSw0, ?_, hcap, ?_⟩
  · intro j hj hj0
    have hbridge : hLS j = Board.colHeight (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
          { piece := Piece.L, rot := 0, col := c })
        { piece := Piece.S, rot := 0, col := c }) j := by
      rw [hLSeq, Board.colHeight_skyline hj]
    rw [hbridge]
    exact Board.colHeight_applyStep_LS_skyline_band_at (w := 0) hc hc1 hc2
      (by decide) (by omega) (by omega) (by omega) hw0 ecc ec1 ec2 hband
      (le_refl base) (by omega) j hj hj0
  · intro j hjc3 hjcols
    have hbridge : hLS j = Board.colHeight (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
          { piece := Piece.L, rot := 0, col := c })
        { piece := Piece.S, rot := 0, col := c }) j := by
      rw [hLSeq, Board.colHeight_skyline hjcols]
    rw [hbridge, Board.colHeight_applyStep_LS_skyline_frame (w := 0) hc hc1 hc2
      (by rw [ec1, ecc]) (by rw [ec2, ecc]) (by decide) (by omega) (by omega) (by omega) hw0
      hjcols (by omega) (by omega) (by omega)]
    exact hflat j (by omega) hjcols

/-- **The owed `Z`, paired behind its `J`, advances the fill front by three — staying in
flat-front-band vocabulary** (iter556). The mirror of `isFlatFrontBandAt_LS_step` (iter555) and the
second notch-piece companion of the flat-filler front-advance menu `isFlatFrontBandAt_filler_step`
(iter411), which excludes `S` and `Z` because a bare flat shelf cannot host them hole-free. Here the
bag's `J` is spent first to re-dig the single-step `Z`-notch at the front triple `(c, c+1, c+2)`, then
the owed `Z` drops into it: the worked triple rises to `(base+3, base+3, base+2)`
(`colHeight_applyStep_JZ_skyline_band_at` at level `f = base`), which with spread `s ≥ 3` stays inside
the band `[base, base + s]`; the reserved well at column `0` is untouched (`0 < c`), and the shelf
`[c+3, cols)` keeps its flat heights at `base` (`colHeight_applyStep_JZ_skyline_frame`). Hence the
`J`-then-`Z` pair lands an `IsFlatFrontBandAt (c+3) s base` board — the front has marched three columns
right exactly as a flat triple-filler would, but with the owed `Z` consumed.

Together with iter555 this closes the front-advance machinery under BOTH notch pairs, so a single bag's
`L, S, J, Z` are scheduled as two front-marching pairs (alongside the strict flats `O, T` via iter411)
without ever dropping to the generic spread band. Honest caveats unchanged: it bakes in the
`J`-before-`Z` order (the all-orders adversary may draw the `Z` first), and it is a two-piece edge, not
the per-piece `hstep`. The once-per-bag drain scheduling and the every-order balance are the remaining
bag-phase content; crux #66 and #72 stay open and `TetrisSolvableValid` is NOT proven. -/
theorem isFlatFrontBandAt_JZ_step {c s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt c s base b) (hs : 3 ≤ s)
    (hc0 : 0 < c) (hc2 : c + 2 < GameConfig.standard.cols) :
    IsFlatFrontBandAt (c + 3) s base
      (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard b { piece := Piece.J, rot := 0, col := c })
        { piece := Piece.Z, rot := 0, col := c }) := by
  obtain ⟨h, rfl, hw0, hband, hcap, hflat⟩ := hb
  have hc : c < GameConfig.standard.cols := by omega
  have hc1 : c + 1 < GameConfig.standard.cols := by omega
  have ecc : h c = base := hflat c (le_refl c) hc
  have ec1 : h (c + 1) = base := hflat (c + 1) (by omega) hc1
  have ec2 : h (c + 2) = base := hflat (c + 2) (by omega) hc2
  obtain ⟨hJZ, hJZeq, hJZw0⟩ :=
    Board.applyStep_JZ_skyline_flat_well (w := 0) hc hc1 hc2
      (by rw [ec1, ecc]) (by rw [ec2, ecc]) (by decide) (by omega) (by omega) (by omega) hw0
  refine ⟨hJZ, hJZeq, hJZw0, ?_, hcap, ?_⟩
  · intro j hj hj0
    have hbridge : hJZ j = Board.colHeight (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
          { piece := Piece.J, rot := 0, col := c })
        { piece := Piece.Z, rot := 0, col := c }) j := by
      rw [hJZeq, Board.colHeight_skyline hj]
    rw [hbridge]
    exact Board.colHeight_applyStep_JZ_skyline_band_at (w := 0) hc hc1 hc2
      (by decide) (by omega) (by omega) (by omega) hw0 ecc ec1 ec2 hband
      (le_refl base) (by omega) j hj hj0
  · intro j hjc3 hjcols
    have hbridge : hJZ j = Board.colHeight (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard (Board.skyline GameConfig.standard h)
          { piece := Piece.J, rot := 0, col := c })
        { piece := Piece.Z, rot := 0, col := c }) j := by
      rw [hJZeq, Board.colHeight_skyline hjcols]
    rw [hbridge, Board.colHeight_applyStep_JZ_skyline_frame (w := 0) hc hc1 hc2
      (by rw [ec1, ecc]) (by rw [ec2, ecc]) (by decide) (by omega) (by omega) (by omega) hw0
      hjcols (by omega) (by omega) (by omega)]
    exact hflat j (by omega) hjcols

/-- **Both notch pairs, scheduled back to back, march the fill front by six** (iter557). The first
composition of the two notch-pair front-steps `isFlatFrontBandAt_LS_step` (iter555) and
`isFlatFrontBandAt_JZ_step` (iter556): from a flat-front band at front `c`, spend the bag's `L`-then-`S`
at the front triple `(c, c+1, c+2)` to advance to front `c + 3`, then the bag's `J`-then-`Z` at the
next triple `(c+3, c+4, c+5)` to advance to front `c + 6` — landing an `IsFlatFrontBandAt (c+6) s base`
board. All four notch pieces `L, S, J, Z` of one bag are thus consumed in two adjacent triples while the
floor `base` stays pinned, the spread `s` is unchanged (each pair peaks at `base + 3 ≤ base + s` for
`s ≥ 3`), and the reserved well at column `0` is never touched. The room precondition `c + 5 < cols`
guarantees both triples sit strictly left of the wall.

This is the brick that schedules the four notch pieces as a block alongside the strict flats `O, T`
(`isFlatFrontBandAt_filler_step`, iter411) — together one bag's six non-`I` pieces march the front by
at most `4 × 3 = 12`, with the once-per-bag `I` left as the regulator drain. Honest caveats unchanged:
it bakes in the `L`-before-`S` and `J`-before-`Z` (and `LS`-before-`JZ`) order, so it covers the
favorable adversarial arrangements, not every order; the every-order balance and the bag-boundary drain
scheduling remain open. Crux #66 and #72 stay open and `TetrisSolvableValid` is NOT proven. -/
theorem isFlatFrontBandAt_LS_then_JZ {c s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt c s base b) (hs : 3 ≤ s)
    (hc0 : 0 < c) (hc5 : c + 5 < GameConfig.standard.cols) :
    IsFlatFrontBandAt (c + 6) s base
      (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard
            (Placement.applyStep GameConfig.standard b
              { piece := Piece.L, rot := 0, col := c })
            { piece := Piece.S, rot := 0, col := c })
          { piece := Piece.J, rot := 0, col := c + 3 })
        { piece := Piece.Z, rot := 0, col := c + 3 }) := by
  have h1 := isFlatFrontBandAt_LS_step hb hs hc0 (by omega)
  have h2 := isFlatFrontBandAt_JZ_step h1 hs (by omega) (by omega)
  exact h2

/-- **Both notch pairs in the reversed order also march the fill front by six** (iter576). The
adversarial-order sibling of `isFlatFrontBandAt_LS_then_JZ` (iter557): the bag may deliver its
`Z`-notch pair before its `S`-notch pair, so here the `J`-then-`Z` pair is spent first at the front
triple `(c, c+1, c+2)` to advance to front `c + 3`, and only then the `L`-then-`S` pair at the next
triple `(c+3, c+4, c+5)` to advance to front `c + 6` — again landing an `IsFlatFrontBandAt (c+6) s
base` board. It is the same two front-steps `isFlatFrontBandAt_JZ_step` (iter556) and
`isFlatFrontBandAt_LS_step` (iter555) composed in the opposite sequence, and because each pair is a
self-contained flat triple that pins the floor `base`, leaves the well at column `0` untouched, and
peaks at `base + 3 ≤ base + s` for `s ≥ 3`, the endpoint band is identical to iter557's regardless of
which notch pair the adversary draws first.

This retires one genuine dimension of the all-orders obstruction — the relative order of the two
notch PAIRS — by showing both arrangements land the same flat-front band, so the bag-level closure
need not assume the favorable `LS`-before-`JZ` arrangement. Honest caveats: it still bakes in the
`L`-before-`S` and `J`-before-`Z` order WITHIN each pair (the partner-before-notch routing the skyline
carrier needs to host an `S` or `Z` hole-free), and it is a four-piece block edge, not the per-piece
`hstep`; the within-pair reversal and the once-per-bag drain interleaving remain the open bag-phase
content. Crux #66 and #72 stay open and `TetrisSolvableValid` is NOT proven. -/
theorem isFlatFrontBandAt_JZ_then_LS {c s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt c s base b) (hs : 3 ≤ s)
    (hc0 : 0 < c) (hc5 : c + 5 < GameConfig.standard.cols) :
    IsFlatFrontBandAt (c + 6) s base
      (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard
            (Placement.applyStep GameConfig.standard b
              { piece := Piece.J, rot := 0, col := c })
            { piece := Piece.Z, rot := 0, col := c })
          { piece := Piece.L, rot := 0, col := c + 3 })
        { piece := Piece.S, rot := 0, col := c + 3 }) := by
  have h1 := isFlatFrontBandAt_JZ_step hb hs hc0 (by omega)
  have h2 := isFlatFrontBandAt_LS_step h1 hs (by omega) (by omega)
  exact h2

/-- **The reversed notch-pair order, then the regulator drain, also nets a four-row descent**
(iter577). The reversed-order analogue of `isFlatFrontBandAt_notchPairs_drain` (iter566), built on
the reversed pair-order block `isFlatFrontBandAt_JZ_then_LS` (iter576) instead of the favorable
`isFlatFrontBandAt_LS_then_JZ` (iter557). When the adversary delivers its `Z`-notch pair before its
`S`-notch pair, the strategy spends the bag's `J` to re-dig the single-step `Z`-notch and seats the
owed `Z` (front `c → c+3`), then spends the `L` for the `S`-notch and seats the owed `S`
(front `c+3 → c+6`), the surface staying a flat-front band at floor `base` throughout (iter576) — and
then, since the floor has built to at least four (`4 ≤ base`), drops the once-per-bag vertical `I` into
the reserved well at column `0`, clearing the bottom four rows and settling into a spread band at floor
`base - 4` (`isSpreadBoundedRWSkylineAt_of_isFlatFrontBandAt_vertI_drain`, iter412). Together with
iter566 the regulator drain now caps BOTH notch-pair orders at the same `base - 4` floor, so the
bag-phase ledger keeps its net-(-4) descent regardless of which notch pair the adversary draws first.
Honest caveats: it still bakes in the `L`-before-`S` and `J`-before-`Z` partner-before-notch order
WITHIN each pair, and drains the four notch pieces against their own once-per-bag `I` rather than
interleaving them with the flat fillers against one shared drain; the within-pair reversal and the
every-order raise-versus-drain balance are the bag-phase closure #66 and #72 still demand.
`TetrisSolvableValid` is NOT proven. -/
theorem isFlatFrontBandAt_JZ_then_LS_drain {c s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt c s base b) (hs : 3 ≤ s)
    (hc0 : 0 < c) (hc5 : c + 5 < GameConfig.standard.cols) (hbase4 : 4 ≤ base) :
    Board.IsSpreadBoundedRWSkylineAt GameConfig.standard s (base - 4)
      (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard
            (Placement.applyStep GameConfig.standard
              (Placement.applyStep GameConfig.standard b
                { piece := Piece.J, rot := 0, col := c })
              { piece := Piece.Z, rot := 0, col := c })
            { piece := Piece.L, rot := 0, col := c + 3 })
          { piece := Piece.S, rot := 0, col := c + 3 })
        { piece := Piece.I, rot := 1, col := 0 }) :=
  isSpreadBoundedRWSkylineAt_of_isFlatFrontBandAt_vertI_drain
    (isFlatFrontBandAt_JZ_then_LS hb hs hc0 hc5) hbase4

/-- **The reversed notch-pair drain caps the surface at `base - 4 + s`, the same height as the
favorable order** (iter579). The reversed-order mirror of `isFlatFrontBandAt_notchPairs_drain_height`
(iter568): reading the post-drain spread band of `isFlatFrontBandAt_JZ_then_LS_drain` (iter577)
through `Board.maxColHeight_le_of_isSpreadBoundedRWSkylineAt`, the maximum column height after the
adversary's reversed notch pairs (`J`-then-`Z`, then `L`-then-`S`) followed by the once-per-bag
vertical `I` drain is at most `base - 4 + s`. Together with iter568 the bag-phase height ledger now
records the SAME post-drain cap for BOTH notch-pair orders, so the all-orders height accounting can
quote a single `base - 4 + s` bound regardless of which notch pair the adversary draws first — one
more order-symmetry retired from the height side of the closure. Honest caveats unchanged from
iter577: this still bakes in `L`-before-`S` and `J`-before-`Z` WITHIN each pair, and drains the four
notch pieces against their own `I` rather than interleaving them with the flat fillers against one
shared drain; the within-pair reversal and the every-order raise-versus-drain balance remain the
bag-phase closure that cruxes #66 and #72 still demand. `TetrisSolvableValid` is NOT proven. -/
theorem isFlatFrontBandAt_JZ_then_LS_drain_height {c s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt c s base b) (hs : 3 ≤ s)
    (hc0 : 0 < c) (hc5 : c + 5 < GameConfig.standard.cols) (hbase4 : 4 ≤ base) :
    Board.maxColHeight GameConfig.standard
      (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard
            (Placement.applyStep GameConfig.standard
              (Placement.applyStep GameConfig.standard b
                { piece := Piece.J, rot := 0, col := c })
              { piece := Piece.Z, rot := 0, col := c })
            { piece := Piece.L, rot := 0, col := c + 3 })
          { piece := Piece.S, rot := 0, col := c + 3 })
        { piece := Piece.I, rot := 1, col := 0 }) ≤ base - 4 + s :=
  Board.maxColHeight_le_of_isSpreadBoundedRWSkylineAt
    (isFlatFrontBandAt_JZ_then_LS_drain hb hs hc0 hc5 hbase4)

/-- **The reversed notch-pair half-cycle also nets a four-row descent of the cap** (iter580). The
reversed-order mirror of `isFlatFrontBandAt_notchPairs_drain_netDescent` (iter569), a direct corollary
of the reversed-order drain height cap (iter579). The starting surface `IsFlatFrontBandAt c s base b`
lives under the band ceiling `base + s`; after the adversary delivers its notch pairs in the reversed
order (`J@c, Z@c, L@(c+3), S@(c+3)`) and the strategy drops the once-per-bag regulator `I` into the
reserved well, the drain endpoint is capped at `base - 4 + s` (iter579). Rearranged with `base ≥ 4`,
that says the endpoint max column height plus four is still at most the *starting* band ceiling
`base + s` — the reversed notch half-cycle, exactly like the favorable order (iter569), pulls the cap
strictly downward by the four rows the vertical `I` clears. Together with iter569 BOTH notch-pair
orders now bank the same four-row descent budget, so the bag-phase ledger sees a net-(-4) half-cycle
regardless of which notch pair the adversary draws first — the descent budget a bounded carrier needs
so chaining notch and filler half-cycles cannot let the cap drift upward across a bag. It still says
nothing about adversarial interleaving of the two halves against one shared drain, nor a notch drawn
before its paired filler; the every-order per-bag raise-versus-drain balance is the bag-phase closure
cruxes #66 and #72 still demand. `TetrisSolvableValid` is NOT proven. -/
theorem isFlatFrontBandAt_JZ_then_LS_drain_netDescent {c s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt c s base b) (hs : 3 ≤ s)
    (hc0 : 0 < c) (hc5 : c + 5 < GameConfig.standard.cols) (hbase4 : 4 ≤ base) :
    Board.maxColHeight GameConfig.standard
      (Placement.applyStep GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard
            (Placement.applyStep GameConfig.standard
              (Placement.applyStep GameConfig.standard b
                { piece := Piece.J, rot := 0, col := c })
              { piece := Piece.Z, rot := 0, col := c })
            { piece := Piece.L, rot := 0, col := c + 3 })
          { piece := Piece.S, rot := 0, col := c + 3 })
        { piece := Piece.I, rot := 1, col := 0 }) + 4 ≤ base + s := by
  have hcap := isFlatFrontBandAt_JZ_then_LS_drain_height hb hs hc0 hc5 hbase4
  omega

/-- **The owed `S`, paired behind its `L`, closes the master carrier at an arbitrary fill front**
(iter561). The flat-front-band, arbitrary-`c` lift of `reservoirSpreadCarrier_flat_LS_step` (iter518),
which routed the `L`-then-`S` notch pair only on the special level reset surface (front pinned at
`c = 1`, every working column flat at `base`). Here the same pairing runs at any fill front `c` the
strategy has marched to: from `IsFlatFrontBandAt c s base b` with spread `s ≥ 3`, a reserved well
(`0 < c`), and room for the front triple (`c + 2 < cols`), spend the bag's `L` flat across the front
triple `(c, c+1, c+2)` to re-dig the single-step `S`-notch, then seat the owed `S` into it; the worked
triple rises to `(base+1, base+1, base+2)` and the board lands an `IsFlatFrontBandAt (c+3) s base` band
(`isFlatFrontBandAt_LS_step`, iter555), which the front-agnostic membership bridge
(`reservoirSpreadCarrier_of_isFlatFrontBandAt`, iter420) forgets into `reservoirSpreadCarrier
((T.draw L).draw S)` under the two-draw carrier ledger `base + s + ((T.draw L).draw S).card + 1 ≤ rows`.

This is the notch-pair companion completing `reservoirSpreadCarrier_flatFront_nonSZ_fill_step`
(iter422): that dispatcher closed the master carrier under the whole non-notch alphabet `{O, I, T, L,
J}` at an arbitrary front, leaving exactly the two notch pieces unscheduled at general `c`; with this
step (and the `J`-then-`Z` mirror) the master carrier is closed under both notch pairs anywhere the
front has reached, not just at the `c = 1` reset surface. Honest caveats unchanged: it is a two-piece
edge, not the per-piece carrier `hstep`, and it bakes in the `L`-before-`S` order, so it covers the
favorable adversarial arrangement, not the case where the `S` is drawn before its paired `L`; the
every-order interleaving against the once-per-bag drain is the bag-phase closure #66 and #72 still
demand. `TetrisSolvableValid` is NOT proven. -/
theorem reservoirSpreadCarrier_flatFront_LS_step {T : Bag} {b : Board} {c s base : ℕ}
    (hb : IsFlatFrontBandAt c s base b) (hs : 3 ≤ s)
    (hc0 : 0 < c) (hc2 : c + 2 < GameConfig.standard.cols)
    (hledger : base + s + ((T.draw Piece.L).draw Piece.S).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl1 : Placement, pl1.piece = Piece.L ∧ pl1.Valid GameConfig.standard ∧
      ∃ pl2 : Placement, pl2.piece = Piece.S ∧ pl2.Valid GameConfig.standard ∧
        reservoirSpreadCarrier ((T.draw Piece.L).draw Piece.S)
          (Placement.applyStep GameConfig.standard
            (Placement.applyStep GameConfig.standard b
              { piece := Piece.L, rot := 0, col := c })
            { piece := Piece.S, rot := 0, col := c }) := by
  refine ⟨{ piece := Piece.L, rot := 0, col := c }, rfl, Board.valid_L hc2,
    { piece := Piece.S, rot := 0, col := c }, rfl, Board.valid_S hc2, ?_⟩
  exact reservoirSpreadCarrier_of_isFlatFrontBandAt
    (isFlatFrontBandAt_LS_step hb hs hc0 hc2) hledger

/-- **The owed `Z`, paired behind its `J`, closes the master carrier at an arbitrary fill front**
(iter562). The mirror of `reservoirSpreadCarrier_flatFront_LS_step` (iter561) for the other notch
piece, and the arbitrary-`c` lift of `reservoirSpreadCarrier_flat_JZ_step` (iter519, which routed the
`J`-then-`Z` pair only on the special level reset surface at front `c = 1`). From `IsFlatFrontBandAt c
s base b` with spread `s ≥ 3`, a reserved well (`0 < c`), and room for the front triple (`c + 2 <
cols`), spend the bag's `J` flat across the front triple `(c, c+1, c+2)` to re-dig the single-step
`Z`-notch, then seat the owed `Z` into it; the worked triple rises to `(base+3, base+3, base+2)` and
the board lands an `IsFlatFrontBandAt (c+3) s base` band (`isFlatFrontBandAt_JZ_step`, iter556), which
the front-agnostic membership bridge (`reservoirSpreadCarrier_of_isFlatFrontBandAt`, iter420) forgets
into `reservoirSpreadCarrier ((T.draw J).draw Z)` under the two-draw carrier ledger `base + s +
((T.draw J).draw Z).card + 1 ≤ rows`.

With iter561 this completes BOTH notch pairs in master-carrier vocabulary at an arbitrary fill front:
together with the non-notch dispatcher `reservoirSpreadCarrier_flatFront_nonSZ_fill_step` (iter422,
the alphabet `{O, I, T, L, J}`), every one of a bag's seven pieces now has a carrier-preserving
schedule reading the surface as a flat-front band — provided each notch piece is partnered behind its
hole-maker. Honest caveats unchanged: it is a two-piece edge, not the per-piece carrier `hstep`, and
it bakes in the `J`-before-`Z` order, so it does not settle the adversarial case where the `Z` is
drawn before its paired `J`; the every-order interleaving against the once-per-bag drain is the
bag-phase closure #66 and #72 still demand. `TetrisSolvableValid` is NOT proven. -/
theorem reservoirSpreadCarrier_flatFront_JZ_step {T : Bag} {b : Board} {c s base : ℕ}
    (hb : IsFlatFrontBandAt c s base b) (hs : 3 ≤ s)
    (hc0 : 0 < c) (hc2 : c + 2 < GameConfig.standard.cols)
    (hledger : base + s + ((T.draw Piece.J).draw Piece.Z).card + 1 ≤ GameConfig.standard.rows) :
    ∃ pl1 : Placement, pl1.piece = Piece.J ∧ pl1.Valid GameConfig.standard ∧
      ∃ pl2 : Placement, pl2.piece = Piece.Z ∧ pl2.Valid GameConfig.standard ∧
        reservoirSpreadCarrier ((T.draw Piece.J).draw Piece.Z)
          (Placement.applyStep GameConfig.standard
            (Placement.applyStep GameConfig.standard b
              { piece := Piece.J, rot := 0, col := c })
            { piece := Piece.Z, rot := 0, col := c }) := by
  refine ⟨{ piece := Piece.J, rot := 0, col := c }, rfl, Board.valid_J hc2,
    { piece := Piece.Z, rot := 0, col := c }, rfl, Board.valid_Z hc2, ?_⟩
  exact reservoirSpreadCarrier_of_isFlatFrontBandAt
    (isFlatFrontBandAt_JZ_step hb hs hc0 hc2) hledger

/-- **Both notch pairs, scheduled back to back, close the master carrier at an arbitrary fill front**
(iter563). The carrier-vocabulary consolidation of `reservoirSpreadCarrier_flatFront_LS_step` (iter561)
and `reservoirSpreadCarrier_flatFront_JZ_step` (iter562), standing to them exactly as the band-level
`isFlatFrontBandAt_LS_then_JZ` (iter557) stands to iter555/iter556. From `IsFlatFrontBandAt c s base b`
with spread `s ≥ 3`, a reserved well (`0 < c`), and room for both front triples (`c + 5 < cols`), spend
the bag's `L`-then-`S` at the front triple `(c, c+1, c+2)` and then its `J`-then-`Z` at the next triple
`(c+3, c+4, c+5)`: each pair re-digs its single-step notch and seats the owed staircase, marching the
fill front `c → c + 6` while the floor `base` stays pinned and the spread `s` is unchanged (every pair
peaks at `base + 3 ≤ base + s`). The endpoint band `IsFlatFrontBandAt (c+6) s base` is forgotten into
`reservoirSpreadCarrier ((((T.draw L).draw S).draw J).draw Z)` by the front-agnostic membership bridge
(`reservoirSpreadCarrier_of_isFlatFrontBandAt`, iter420) under the four-draw carrier ledger.

This is the single carrier edge a per-bag schedule quotes to consume all four notch pieces of a bag as
one block — alongside the strict flats `O, T` and the regulator `I` via the non-notch dispatcher
(`reservoirSpreadCarrier_flatFront_nonSZ_fill_step`, iter422) — so one bag's six non-`I` pieces march
the front by at most `4 × 3 = 12` before the once-per-bag `I` drains the floor back to a reset surface.
Honest caveats unchanged: it bakes in the favorable arrangement `L`-before-`S`, `J`-before-`Z`, and
`LS`-before-`JZ`, so it covers the orders where each notch is partnered behind its hole-maker, not the
adversarial case where a notch is drawn first; it is a four-piece edge, not the per-piece carrier
`hstep`. The every-order interleaving against the drain — and the richer all-7 carrier that regenerates
the landing sites cross-step — remain the bag-phase closure #66 and #72 still demand.
`TetrisSolvableValid` is NOT proven. -/
theorem reservoirSpreadCarrier_flatFront_notchPairs_step {T : Bag} {b : Board} {c s base : ℕ}
    (hb : IsFlatFrontBandAt c s base b) (hs : 3 ≤ s)
    (hc0 : 0 < c) (hc5 : c + 5 < GameConfig.standard.cols)
    (hledger : base + s + ((((T.draw Piece.L).draw Piece.S).draw Piece.J).draw Piece.Z).card + 1
      ≤ GameConfig.standard.rows) :
    ∃ pl1 : Placement, pl1.piece = Piece.L ∧ pl1.Valid GameConfig.standard ∧
      ∃ pl2 : Placement, pl2.piece = Piece.S ∧ pl2.Valid GameConfig.standard ∧
        ∃ pl3 : Placement, pl3.piece = Piece.J ∧ pl3.Valid GameConfig.standard ∧
          ∃ pl4 : Placement, pl4.piece = Piece.Z ∧ pl4.Valid GameConfig.standard ∧
            reservoirSpreadCarrier ((((T.draw Piece.L).draw Piece.S).draw Piece.J).draw Piece.Z)
              (Placement.applyStep GameConfig.standard
                (Placement.applyStep GameConfig.standard
                  (Placement.applyStep GameConfig.standard
                    (Placement.applyStep GameConfig.standard b
                      { piece := Piece.L, rot := 0, col := c })
                    { piece := Piece.S, rot := 0, col := c })
                  { piece := Piece.J, rot := 0, col := c + 3 })
                { piece := Piece.Z, rot := 0, col := c + 3 }) := by
  refine ⟨{ piece := Piece.L, rot := 0, col := c }, rfl, Board.valid_L (by omega),
    { piece := Piece.S, rot := 0, col := c }, rfl, Board.valid_S (by omega),
    { piece := Piece.J, rot := 0, col := c + 3 }, rfl, Board.valid_J (by omega),
    { piece := Piece.Z, rot := 0, col := c + 3 }, rfl, Board.valid_Z (by omega), ?_⟩
  exact reservoirSpreadCarrier_of_isFlatFrontBandAt
    (isFlatFrontBandAt_LS_then_JZ hb hs hc0 hc5) hledger

/-- **The `L`-then-`S` front step survives at every intermediate placement** (iter558). The transient
survival face of `isFlatFrontBandAt_LS_step` (iter555): not just the completed pair's endpoint band,
but BOTH boards the adversary's clock passes through — the board after the `L` lands (an exposed
`S`-notch, columns `(c, c+1, c+2)` at `(base+1, base+1, base+2)`) and the board after the owed `S`
drops into it — keep every cell strictly under the `rows` ceiling, so the game is not lost at any step
of the pair. The post-`L` board is certified directly through the spread-band non-loss chain
(`isSpreadBoundedRWSkylineAt_applyStep_L_flat_at_notch` at level `f = base`, then
`not_isLost_of_isSpreadBoundedRWSkyline`), needing only `base + s ≤ rows` — which the band's own cap
`hcap` supplies — so it holds REGARDLESS of piece order; the post-`S` board is the endpoint band of
iter555, certified by `isFlatFrontBandAt_not_isLost` (iter484). This is the per-prefix height
obligation for the notch pair, the analogue of `isFlatFrontBandAt_nonSZ_fill_list_safe` (iter485) for
the strict-flat run: as the bag feeds its `L` then `S`, the surface never tops out in between. It is
order-INDEPENDENT (a pure height bound on the two boards), unlike the endpoint-invariant direction of
iter555 which assumes the `L`-before-`S` arrival; the every-order availability of a drain before the
limit, and the bag-level raise/drain balance, remain the open closure. Crux #66 and #72 stay open and
`TetrisSolvableValid` is NOT proven. -/
theorem isFlatFrontBandAt_LS_step_safe {c s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt c s base b) (hs : 3 ≤ s)
    (hc0 : 0 < c) (hc2 : c + 2 < GameConfig.standard.cols) :
    ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard b { piece := Piece.L, rot := 0, col := c }) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard b { piece := Piece.L, rot := 0, col := c })
          { piece := Piece.S, rot := 0, col := c }) := by
  obtain ⟨h, rfl, hw0, hband, hcap, hflat⟩ := hb
  have hc : c < GameConfig.standard.cols := by omega
  have hc1 : c + 1 < GameConfig.standard.cols := by omega
  have ecc : h c = base := hflat c (le_refl c) hc
  have ec1 : h (c + 1) = base := hflat (c + 1) (by omega) hc1
  have ec2 : h (c + 2) = base := hflat (c + 2) (by omega) hc2
  refine ⟨?_, ?_⟩
  · have hL := (Board.isSpreadBoundedRWSkylineAt_applyStep_L_flat_at_notch (w := 0) hc hc1 hc2
      (by decide) (by omega) (by omega) (by omega) hw0 ecc ec1 ec2 hband
      (le_refl base) (by omega) hcap).1
    exact Board.not_isLost_of_isSpreadBoundedRWSkyline
      (Board.isSpreadBoundedRWSkyline_of_isSpreadBoundedRWSkylineAt hL)
  · exact isFlatFrontBandAt_not_isLost
      (isFlatFrontBandAt_LS_step ⟨h, rfl, hw0, hband, hcap, hflat⟩ hs hc0 hc2)

/-- **The `J`-then-`Z` front step survives at every intermediate placement** (iter559). The mirror of
`isFlatFrontBandAt_LS_step_safe` (iter558) and the transient survival face of
`isFlatFrontBandAt_JZ_step` (iter556): both boards the adversary's clock passes through — the board
after the `J` lands (an exposed `Z`-notch, columns `(c, c+1, c+2)` at `(base+2, base+1, base+1)`) and
the board after the owed `Z` drops into it — keep every cell strictly under the `rows` ceiling, so the
game is not lost at any step of the pair. The post-`J` board is certified directly through the
spread-band non-loss chain (`isSpreadBoundedRWSkylineAt_applyStep_J_flat_at_notch` at level `f = base`,
then `not_isLost_of_isSpreadBoundedRWSkyline`), needing only `base + s ≤ rows` from the band's own cap,
so it holds REGARDLESS of piece order; the post-`Z` board is the endpoint band of iter556, certified by
`isFlatFrontBandAt_not_isLost` (iter484). Together with iter558 this certifies the per-prefix height
obligation for BOTH notch pairs of a bag, the order-independent transient half of the closure. The
every-order drain availability before the limit and the bag-level raise/drain balance remain open. Crux
#66 and #72 stay open and `TetrisSolvableValid` is NOT proven. -/
theorem isFlatFrontBandAt_JZ_step_safe {c s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt c s base b) (hs : 3 ≤ s)
    (hc0 : 0 < c) (hc2 : c + 2 < GameConfig.standard.cols) :
    ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard b { piece := Piece.J, rot := 0, col := c }) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard b { piece := Piece.J, rot := 0, col := c })
          { piece := Piece.Z, rot := 0, col := c }) := by
  obtain ⟨h, rfl, hw0, hband, hcap, hflat⟩ := hb
  have hc : c < GameConfig.standard.cols := by omega
  have hc1 : c + 1 < GameConfig.standard.cols := by omega
  have ecc : h c = base := hflat c (le_refl c) hc
  have ec1 : h (c + 1) = base := hflat (c + 1) (by omega) hc1
  have ec2 : h (c + 2) = base := hflat (c + 2) (by omega) hc2
  refine ⟨?_, ?_⟩
  · have hJ := (Board.isSpreadBoundedRWSkylineAt_applyStep_J_flat_at_notch (w := 0) hc hc1 hc2
      (by decide) (by omega) (by omega) (by omega) hw0 ecc ec1 ec2 hband
      (le_refl base) (by omega) hcap).1
    exact Board.not_isLost_of_isSpreadBoundedRWSkyline
      (Board.isSpreadBoundedRWSkyline_of_isSpreadBoundedRWSkylineAt hJ)
  · exact isFlatFrontBandAt_not_isLost
      (isFlatFrontBandAt_JZ_step ⟨h, rfl, hw0, hband, hcap, hflat⟩ hs hc0 hc2)

/-- **The four-piece notch block survives at every intermediate placement** (iter564). The per-prefix
transient-survival certificate for the both-notch-pairs front step
`isFlatFrontBandAt_LS_then_JZ` (iter557) / `reservoirSpreadCarrier_flatFront_notchPairs_step`
(iter563): all FOUR boards the adversary's clock passes through as the bag feeds its `L`, `S`, `J`, `Z`
into the working front — after the `L` digs the `S`-notch, after the owed `S` drops in, after the `J`
digs the `Z`-notch at the advanced front `c + 3`, and after the owed `Z` drops in — keep every cell
strictly under the `rows` ceiling, so the game is not lost at any of the four steps. It is the clean
composition of the two pair-survival certificates: `isFlatFrontBandAt_LS_step_safe` (iter558) certifies
the first two boards directly from the band cap, then `isFlatFrontBandAt_LS_step` (iter555) carries the
band forward to front `c + 3`, on which `isFlatFrontBandAt_JZ_step_safe` (iter559) certifies the last
two. Like its two halves, the not-lost bounds are order-INDEPENDENT pure height facts (each board's
top stays under `base + s ≤ rows`); the LS-before-JZ, partner-before-notch arrangement is the
placement SCHEDULE the band shape uses, not a constraint on the adversary's height safety. Paired with
iter563's carrier re-entry this delivers both faces a per-bag survival schedule consumes at the
four-piece notch block: the destination carrier AND the transient safety of every drop in between.
What stays open is the every-order availability of a drain before the limit and the bag-level
raise/drain balance — crux #66 and #72 remain open and `TetrisSolvableValid` is NOT proven. -/
theorem isFlatFrontBandAt_LS_then_JZ_safe {c s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt c s base b) (hs : 3 ≤ s)
    (hc0 : 0 < c) (hc5 : c + 5 < GameConfig.standard.cols) :
    ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard b { piece := Piece.L, rot := 0, col := c }) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard b { piece := Piece.L, rot := 0, col := c })
          { piece := Piece.S, rot := 0, col := c }) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard
            (Placement.applyStep GameConfig.standard b { piece := Piece.L, rot := 0, col := c })
            { piece := Piece.S, rot := 0, col := c })
          { piece := Piece.J, rot := 0, col := c + 3 }) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard
            (Placement.applyStep GameConfig.standard
              (Placement.applyStep GameConfig.standard b { piece := Piece.L, rot := 0, col := c })
              { piece := Piece.S, rot := 0, col := c })
            { piece := Piece.J, rot := 0, col := c + 3 })
          { piece := Piece.Z, rot := 0, col := c + 3 }) := by
  obtain ⟨hL, hLS⟩ := isFlatFrontBandAt_LS_step_safe hb hs hc0 (by omega)
  have hb2 := isFlatFrontBandAt_LS_step hb hs hc0 (by omega)
  obtain ⟨hJ, hJZ⟩ := isFlatFrontBandAt_JZ_step_safe hb2 hs (by omega) (by omega)
  exact ⟨hL, hLS, hJ, hJZ⟩

/-- **The reversed four-piece notch block survives at every intermediate placement** (iter578). The
per-prefix transient-survival certificate for the reversed-order notch block
`isFlatFrontBandAt_JZ_then_LS` (iter576), the reversed mirror of `isFlatFrontBandAt_LS_then_JZ_safe`
(iter564): all FOUR boards the adversary's clock passes through as the bag feeds its `J`, `Z`, `L`, `S`
into the working front — after the `J` digs the `Z`-notch, after the owed `Z` drops in, after the `L`
digs the `S`-notch at the advanced front `c + 3`, and after the owed `S` drops in — keep every cell
strictly under the `rows` ceiling, so the game is not lost at any of the four steps. It is the same
composition as iter564 with the pair order swapped: `isFlatFrontBandAt_JZ_step_safe` (iter559) certifies
the first two boards directly from the band cap, then `isFlatFrontBandAt_JZ_step` (iter556) carries the
band forward to front `c + 3`, on which `isFlatFrontBandAt_LS_step_safe` (iter558) certifies the last
two. As in the favorable order, the not-lost bounds are order-INDEPENDENT pure height facts (each
board's top stays under `base + s ≤ rows`); the pair order is the placement SCHEDULE the band shape
uses, not a constraint on the adversary's height safety. With iter564 this delivers the per-prefix
survival schedule for BOTH notch-pair orders, so the transient half of the closure no longer assumes
which notch pair the adversary draws first. What stays open is the within-pair reversal, the every-order
availability of a drain before the limit, and the bag-level raise/drain balance — crux #66 and #72
remain open and `TetrisSolvableValid` is NOT proven. -/
theorem isFlatFrontBandAt_JZ_then_LS_safe {c s base : ℕ} {b : Board}
    (hb : IsFlatFrontBandAt c s base b) (hs : 3 ≤ s)
    (hc0 : 0 < c) (hc5 : c + 5 < GameConfig.standard.cols) :
    ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard b { piece := Piece.J, rot := 0, col := c }) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard b { piece := Piece.J, rot := 0, col := c })
          { piece := Piece.Z, rot := 0, col := c }) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard
            (Placement.applyStep GameConfig.standard b { piece := Piece.J, rot := 0, col := c })
            { piece := Piece.Z, rot := 0, col := c })
          { piece := Piece.L, rot := 0, col := c + 3 }) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard
          (Placement.applyStep GameConfig.standard
            (Placement.applyStep GameConfig.standard
              (Placement.applyStep GameConfig.standard b { piece := Piece.J, rot := 0, col := c })
              { piece := Piece.Z, rot := 0, col := c })
            { piece := Piece.L, rot := 0, col := c + 3 })
          { piece := Piece.S, rot := 0, col := c + 3 }) := by
  obtain ⟨hJ, hJZ⟩ := isFlatFrontBandAt_JZ_step_safe hb hs hc0 (by omega)
  have hb2 := isFlatFrontBandAt_JZ_step hb hs hc0 (by omega)
  obtain ⟨hL, hLS⟩ := isFlatFrontBandAt_LS_step_safe hb2 hs (by omega) (by omega)
  exact ⟨hJ, hJZ, hL, hLS⟩

/-- **The fully-certified four-piece notch block** (iter565). The single edge a per-bag survival
schedule consumes at the favorable-order notch block: it fuses the carrier re-entry of
`reservoirSpreadCarrier_flatFront_notchPairs_step` (iter563) with the per-prefix transient safety of
`isFlatFrontBandAt_LS_then_JZ_safe` (iter564) into one statement. From a flat-front band at front `c`,
scheduling the bag's `L`, `S`, `J`, `Z` into the working front — `L@c` digs the `S`-notch, the owed
`S` drops in, `J@(c+3)` digs the `Z`-notch, the owed `Z` drops in — yields four valid placements, each
of whose intermediate boards is certified NOT lost, and whose final board re-enters
`reservoirSpreadCarrier` under the four-times-drawn bag. So the caller gets, in one move, the
destination carrier AND the safety of every drop in between, with no per-piece re-derivation. The
carrier face is delivered by `reservoirSpreadCarrier_of_isFlatFrontBandAt` (iter420) on the endpoint
band `isFlatFrontBandAt_LS_then_JZ` (iter557); the four safety faces are exactly iter564's tuple. As in
its two halves, this bakes in the LS-before-JZ, partner-before-notch placement SCHEDULE the flat-front
band uses; it is the favorable-order notch block, not the adversarial every-order closure. What stays
open is the every-order availability of a drain before the limit and the per-bag raise/drain balance —
crux #66 and #72 remain open and `TetrisSolvableValid` is NOT proven. -/
theorem reservoirSpreadCarrier_flatFront_notchPairs_step_safe {T : Bag} {b : Board} {c s base : ℕ}
    (hb : IsFlatFrontBandAt c s base b) (hs : 3 ≤ s)
    (hc0 : 0 < c) (hc5 : c + 5 < GameConfig.standard.cols)
    (hledger : base + s + ((((T.draw Piece.L).draw Piece.S).draw Piece.J).draw Piece.Z).card + 1
      ≤ GameConfig.standard.rows) :
    ∃ pl1 : Placement, pl1.piece = Piece.L ∧ pl1.Valid GameConfig.standard ∧
      ¬ Board.isLost GameConfig.standard (Placement.applyStep GameConfig.standard b pl1) ∧
      ∃ pl2 : Placement, pl2.piece = Piece.S ∧ pl2.Valid GameConfig.standard ∧
        ¬ Board.isLost GameConfig.standard
          (Placement.applyStep GameConfig.standard
            (Placement.applyStep GameConfig.standard b pl1) pl2) ∧
        ∃ pl3 : Placement, pl3.piece = Piece.J ∧ pl3.Valid GameConfig.standard ∧
          ¬ Board.isLost GameConfig.standard
            (Placement.applyStep GameConfig.standard
              (Placement.applyStep GameConfig.standard
                (Placement.applyStep GameConfig.standard b pl1) pl2) pl3) ∧
          ∃ pl4 : Placement, pl4.piece = Piece.Z ∧ pl4.Valid GameConfig.standard ∧
            ¬ Board.isLost GameConfig.standard
              (Placement.applyStep GameConfig.standard
                (Placement.applyStep GameConfig.standard
                  (Placement.applyStep GameConfig.standard
                    (Placement.applyStep GameConfig.standard b pl1) pl2) pl3) pl4) ∧
            reservoirSpreadCarrier ((((T.draw Piece.L).draw Piece.S).draw Piece.J).draw Piece.Z)
              (Placement.applyStep GameConfig.standard
                (Placement.applyStep GameConfig.standard
                  (Placement.applyStep GameConfig.standard
                    (Placement.applyStep GameConfig.standard b pl1) pl2) pl3) pl4) := by
  obtain ⟨hL, hLS, hJ, hJZ⟩ := isFlatFrontBandAt_LS_then_JZ_safe hb hs hc0 hc5
  refine ⟨{ piece := Piece.L, rot := 0, col := c }, rfl, Board.valid_L (by omega), hL,
    { piece := Piece.S, rot := 0, col := c }, rfl, Board.valid_S (by omega), hLS,
    { piece := Piece.J, rot := 0, col := c + 3 }, rfl, Board.valid_J (by omega), hJ,
    { piece := Piece.Z, rot := 0, col := c + 3 }, rfl, Board.valid_Z (by omega), hJZ, ?_⟩
  exact reservoirSpreadCarrier_of_isFlatFrontBandAt
    (isFlatFrontBandAt_LS_then_JZ hb hs hc0 hc5) hledger

/-- **Both notch pairs, then the regulator drain, net a four-row descent** (iter566). The notch-side
companion of the flat-filler fill-then-drain half-cycle `isFlatFrontBandAt_flatFiller_fill_list_drain`
(iter514). Where that lemma marched a run of strictly-flat fillers (`O`, `T`, `L`, `J`) across one
layer and then drained, this one absorbs the two adversarially-owed notch pieces `S` and `Z` via
their manufactured-valley pairings — spend the bag's `L` to re-dig the single-step `S`-notch and seat
the owed `S` (front `c → c+3`), then spend the bag's `J` for the `Z`-notch and seat the owed `Z`
(front `c+3 → c+6`), the surface staying a flat-front band at floor `base` throughout
(`isFlatFrontBandAt_LS_then_JZ`, iter557) — and then, since the floor has built to at least four
(`4 ≤ base`), drops the once-per-bag vertical `I` into the reserved well at column `0`, clearing the
