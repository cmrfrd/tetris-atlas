  rw [applyStep_L_skyline_noclear hc hc1 hc2 heq1 heq2 hw hwc hwc1 hwc2 hw0]
  refine ⟨Function.update (Function.update (Function.update h c (h c + 1))
      (c + 1) (h c + 1)) (c + 2) (h c + 2), floor, w, rfl, hw, ?_, ?_, ?_⟩
