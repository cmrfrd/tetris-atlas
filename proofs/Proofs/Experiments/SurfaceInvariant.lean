  · exact isSpreadBoundedRWSkylineAt_J_pocket_of_isLevelPocketBandAt hb

/-- **Floor-notch S fill arc.** Unlike the five flat pieces, the S cannot flush-fill a *level*
width-four pocket: `applyStep_S_skyline_noclear` demands a unit staircase step
(`h c = h (c+1)`, `h (c+2) = h c + 1`), which a level shelf (all columns equal) does not provide.
This lemma is the S analogue of the flat fill arcs, hypothesising the notch explicitly: given a
spread-2 reserved-well skyline whose columns `c, c+1` rest at the band floor and whose column `c+2`
sits one above it (the floor-level S-notch), the S placement is valid, survives, and lands in
`IsSpreadBoundedRWSkyline standard 2`. The S writes `+1, +2, +2` into `c, c+1, c+2`, lifting them
to `floor+1, floor+2, floor+2`, all inside the spread-2 band. It is a *conditional* arc — the notch
is supplied by hypothesis, not guaranteed by an arbitrary band member — so it is the brick a
notch-builder (or a phase-split dispatcher) consumes, not a standalone closure. -/
theorem isSpreadBoundedRWSkyline_S_floorNotch_of_skyline {floor w c : ℕ} {h : ℕ → ℕ}
    (hw : w < GameConfig.standard.cols) (hw0 : h w = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ w → floor ≤ h j ∧ h j ≤ floor + 2)
    (hcap : floor + 2 ≤ GameConfig.standard.rows)
    (hc2 : c + 2 < GameConfig.standard.cols)
    (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2)
    (hpc : h c = floor) (hpc1 : h (c + 1) = floor) (hpc2 : h (c + 2) = floor + 1) :
    ∃ pl : Placement, pl.piece = Piece.S ∧ pl.Valid GameConfig.standard ∧
      IsSpreadBoundedRWSkyline GameConfig.standard 2
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard h) pl) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard h) pl) := by
  have hS : Placement.applyStep GameConfig.standard
      (skyline GameConfig.standard h) { piece := Piece.S, rot := 0, col := c }
      = skyline GameConfig.standard
        (Function.update (Function.update (Function.update h c (h c + 1))
          (c + 1) (h c + 2)) (c + 2) (h c + 2)) :=
    applyStep_S_skyline_noclear (by omega) (by omega) hc2
      (by rw [hpc, hpc1]) (by rw [hpc2, hpc]) hw hwc hwc1 hwc2 hw0
  have hsb : IsSpreadBoundedRWSkyline GameConfig.standard 2
      (Placement.applyStep GameConfig.standard
        (skyline GameConfig.standard h) { piece := Piece.S, rot := 0, col := c }) := by
    rw [hS]
    refine isSpreadBoundedRWSkyline_skyline (floor := floor) (w := w) hw ?_ ?_ hcap
    · rw [Function.update_of_ne hwc2, Function.update_of_ne hwc1,
        Function.update_of_ne hwc]; exact hw0
    · intro j hj hjw
      rcases eq_or_ne j (c + 2) with rfl | hj2
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hj2]
        rcases eq_or_ne j (c + 1) with rfl | hj1
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hj1]
          rcases eq_or_ne j c with rfl | hj0
          · rw [Function.update_self]; omega
          · rw [Function.update_of_ne hj0]; exact hband j hj hjw
  exact ⟨{ piece := Piece.S, rot := 0, col := c }, rfl, valid_S (by omega), hsb,
    not_isLost_of_isSpreadBoundedRWSkyline hsb⟩

/-- **Floor-tracked S floor-notch fill arc.** The floor-pinned re-pin of
`isSpreadBoundedRWSkyline_S_floorNotch_of_skyline`: given the S unit-step floor notch
(`h c = floor`, `h (c+1) = floor`, `h (c+2) = floor + 1`), the S placement lands in
`IsSpreadBoundedRWSkylineAt standard 2 floor` (the same input floor: measured from the floor the S
writes `+1, +2, +2` into `c, c+1, c+2`, all inside the spread-2 band, and every off-well column
stays `≥ floor`). This is the conditional-notch S re-pin that a notch-builder dispatcher consumes,
landing floor-tracked so it feeds the reservoir ledger `reservoirCarrier_fill_step`. -/
theorem isSpreadBoundedRWSkylineAt_S_floorNotch_of_skyline {floor w c : ℕ} {h : ℕ → ℕ}
    (hw : w < GameConfig.standard.cols) (hw0 : h w = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ w → floor ≤ h j ∧ h j ≤ floor + 2)
    (hcap : floor + 2 ≤ GameConfig.standard.rows)
    (hc2 : c + 2 < GameConfig.standard.cols)
    (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2)
    (hpc : h c = floor) (hpc1 : h (c + 1) = floor) (hpc2 : h (c + 2) = floor + 1) :
    ∃ pl : Placement, pl.piece = Piece.S ∧ pl.Valid GameConfig.standard ∧
      IsSpreadBoundedRWSkylineAt GameConfig.standard 2 floor
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard h) pl) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard h) pl) := by
  have hS : Placement.applyStep GameConfig.standard
      (skyline GameConfig.standard h) { piece := Piece.S, rot := 0, col := c }
      = skyline GameConfig.standard
        (Function.update (Function.update (Function.update h c (h c + 1))
          (c + 1) (h c + 2)) (c + 2) (h c + 2)) :=
    applyStep_S_skyline_noclear (by omega) (by omega) hc2
      (by rw [hpc, hpc1]) (by rw [hpc2, hpc]) hw hwc hwc1 hwc2 hw0
  have hsb : IsSpreadBoundedRWSkylineAt GameConfig.standard 2 floor
      (Placement.applyStep GameConfig.standard
        (skyline GameConfig.standard h) { piece := Piece.S, rot := 0, col := c }) := by
    rw [hS]
    refine isSpreadBoundedRWSkylineAt_skyline (floor := floor) (w := w) hw ?_ ?_ hcap
    · rw [Function.update_of_ne hwc2, Function.update_of_ne hwc1,
        Function.update_of_ne hwc]; exact hw0
    · intro j hj hjw
      rcases eq_or_ne j (c + 2) with rfl | hj2
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hj2]
        rcases eq_or_ne j (c + 1) with rfl | hj1
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hj1]
          rcases eq_or_ne j c with rfl | hj0
          · rw [Function.update_self]; omega
          · rw [Function.update_of_ne hj0]; exact hband j hj hjw
  exact ⟨{ piece := Piece.S, rot := 0, col := c }, rfl, valid_S (by omega), hsb,
    not_isLost_of_isSpreadBoundedRWSkyline
      (isSpreadBoundedRWSkyline_of_isSpreadBoundedRWSkylineAt hsb)⟩

/-- **Floor-notch Z fill arc.** The mirror of `isSpreadBoundedRWSkyline_S_floorNotch_of_skyline`.
The Z also cannot flush-fill a *level* width-four pocket: `applyStep_Z_skyline_noclear` demands the
mirror unit staircase step (`h (c+1) = h (c+2)`, `h c = h (c+1) + 1`), absent from a level shelf
where every column is equal. Hypothesising that mirror notch explicitly — column `c` sits one above
the band floor while columns `c+1, c+2` rest at the floor (the floor-level Z notch) — the Z
placement is valid, survives, and lands in `IsSpreadBoundedRWSkyline standard 2`. Measured from the
floor the Z writes `+2, +2, +1` into `c, c+1, c+2`, lifting them to `floor+2, floor+2, floor+1`, all
inside the spread-2 band. Like the S arc it is a *conditional* brick — the notch is supplied by
hypothesis, not guaranteed by an arbitrary band member — so it is what a notch-builder or phase-split
dispatcher consumes. With this the per-piece fill table is complete for all seven tetrominoes (the
five flat pieces flush-fill the level pocket; S and Z each need their unit-step notch). -/
theorem isSpreadBoundedRWSkyline_Z_floorNotch_of_skyline {floor w c : ℕ} {h : ℕ → ℕ}
    (hw : w < GameConfig.standard.cols) (hw0 : h w = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ w → floor ≤ h j ∧ h j ≤ floor + 2)
    (hcap : floor + 2 ≤ GameConfig.standard.rows)
    (hc2 : c + 2 < GameConfig.standard.cols)
    (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2)
    (hpc : h c = floor + 1) (hpc1 : h (c + 1) = floor) (hpc2 : h (c + 2) = floor) :
    ∃ pl : Placement, pl.piece = Piece.Z ∧ pl.Valid GameConfig.standard ∧
      IsSpreadBoundedRWSkyline GameConfig.standard 2
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard h) pl) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard h) pl) := by
  have hZ : Placement.applyStep GameConfig.standard
      (skyline GameConfig.standard h) { piece := Piece.Z, rot := 0, col := c }
      = skyline GameConfig.standard
        (Function.update (Function.update (Function.update h c (h (c + 1) + 2))
          (c + 1) (h (c + 1) + 2)) (c + 2) (h (c + 1) + 1)) :=
    applyStep_Z_skyline_noclear (by omega) (by omega) hc2
      (by rw [hpc1, hpc2]) (by rw [hpc, hpc1]) hw hwc hwc1 hwc2 hw0
  have hsb : IsSpreadBoundedRWSkyline GameConfig.standard 2
      (Placement.applyStep GameConfig.standard
        (skyline GameConfig.standard h) { piece := Piece.Z, rot := 0, col := c }) := by
    rw [hZ]
    refine isSpreadBoundedRWSkyline_skyline (floor := floor) (w := w) hw ?_ ?_ hcap
    · rw [Function.update_of_ne hwc2, Function.update_of_ne hwc1,
        Function.update_of_ne hwc]; exact hw0
    · intro j hj hjw
      rcases eq_or_ne j (c + 2) with rfl | hj2
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hj2]
        rcases eq_or_ne j (c + 1) with rfl | hj1
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hj1]
          rcases eq_or_ne j c with rfl | hj0
          · rw [Function.update_self]; omega
          · rw [Function.update_of_ne hj0]; exact hband j hj hjw
  exact ⟨{ piece := Piece.Z, rot := 0, col := c }, rfl, valid_Z (by omega), hsb,
    not_isLost_of_isSpreadBoundedRWSkyline hsb⟩

/-- **Floor-tracked Z floor-notch fill arc.** The floor-pinned re-pin of
`isSpreadBoundedRWSkyline_Z_floorNotch_of_skyline`: given the mirror Z unit-step floor notch
(`h c = floor + 1`, `h (c+1) = floor`, `h (c+2) = floor`), the Z placement lands in
`IsSpreadBoundedRWSkylineAt standard 2 floor` (the same input floor: measured from the floor the Z
writes `+2, +2, +1` into `c, c+1, c+2`, all inside the spread-2 band, and every off-well column
stays `≥ floor`). With the floor-tracked S arc this completes the all-seven floor-pinned fill menu
(five flats flush-fill the level pocket; S and Z each consume their unit-step notch), every arc now
landing in `IsSpreadBoundedRWSkylineAt standard 2 floor` to feed `reservoirCarrier_fill_step`. -/
theorem isSpreadBoundedRWSkylineAt_Z_floorNotch_of_skyline {floor w c : ℕ} {h : ℕ → ℕ}
    (hw : w < GameConfig.standard.cols) (hw0 : h w = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ w → floor ≤ h j ∧ h j ≤ floor + 2)
    (hcap : floor + 2 ≤ GameConfig.standard.rows)
    (hc2 : c + 2 < GameConfig.standard.cols)
    (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2)
    (hpc : h c = floor + 1) (hpc1 : h (c + 1) = floor) (hpc2 : h (c + 2) = floor) :
    ∃ pl : Placement, pl.piece = Piece.Z ∧ pl.Valid GameConfig.standard ∧
      IsSpreadBoundedRWSkylineAt GameConfig.standard 2 floor
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard h) pl) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard h) pl) := by
  have hZ : Placement.applyStep GameConfig.standard
      (skyline GameConfig.standard h) { piece := Piece.Z, rot := 0, col := c }
      = skyline GameConfig.standard
        (Function.update (Function.update (Function.update h c (h (c + 1) + 2))
          (c + 1) (h (c + 1) + 2)) (c + 2) (h (c + 1) + 1)) :=
    applyStep_Z_skyline_noclear (by omega) (by omega) hc2
      (by rw [hpc1, hpc2]) (by rw [hpc, hpc1]) hw hwc hwc1 hwc2 hw0
  have hsb : IsSpreadBoundedRWSkylineAt GameConfig.standard 2 floor
      (Placement.applyStep GameConfig.standard
        (skyline GameConfig.standard h) { piece := Piece.Z, rot := 0, col := c }) := by
    rw [hZ]
    refine isSpreadBoundedRWSkylineAt_skyline (floor := floor) (w := w) hw ?_ ?_ hcap
    · rw [Function.update_of_ne hwc2, Function.update_of_ne hwc1,
        Function.update_of_ne hwc]; exact hw0
    · intro j hj hjw
      rcases eq_or_ne j (c + 2) with rfl | hj2
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hj2]
        rcases eq_or_ne j (c + 1) with rfl | hj1
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hj1]
          rcases eq_or_ne j c with rfl | hj0
          · rw [Function.update_self]; omega
          · rw [Function.update_of_ne hj0]; exact hband j hj hjw
  exact ⟨{ piece := Piece.Z, rot := 0, col := c }, rfl, valid_Z (by omega), hsb,
    not_isLost_of_isSpreadBoundedRWSkyline
      (isSpreadBoundedRWSkyline_of_isSpreadBoundedRWSkylineAt hsb)⟩

/-- **Spread monotonicity for the floor-exposing band.** Widening the allowed spread keeps a
level-pocket band a level-pocket band: every off-well column already sits in
`[floor, floor + spread]`, so it also sits in the wider `[floor, floor + spread']`, and the pocket
columns stay pinned at the exact floor. Only the ceiling cap must be re-checked at the wider spread
(`hcap`). This lets bands discovered at different tight spreads — the flat shelf at spread 2, the
S and Z notch inputs at spread 1 — be lifted to a common spread so they can inhabit a single
disjunctive carrier. -/
theorem isLevelPocketBandAt_mono_spread {cfg : GameConfig} {spread spread' floor : ℕ} {b : Board}
    (hb : IsLevelPocketBandAt cfg spread floor b) (hss : spread ≤ spread')
    (hcap : floor + spread' ≤ cfg.rows) :
    IsLevelPocketBandAt cfg spread' floor b := by
  obtain ⟨h, w, c, hbsky, hw, hw0, hband, hcapold, hc3, hwc, hwc1, hwc2, hwc3,
    hpc, hpc1, hpc2, hpc3⟩ := hb
  exact ⟨h, w, c, hbsky, hw, hw0, fun j hj hjw =>
    ⟨(hband j hj hjw).1, le_trans (hband j hj hjw).2 (by omega)⟩,
    hcap, hc3, hwc, hwc1, hwc2, hwc3, hpc, hpc1, hpc2, hpc3⟩

/-- **Carrier survival face.** Any floor-exposing pocket-band board is not a lost board.
This packages the standing 3-lemma chain (`not_isLost_of_isSpreadBoundedRWSkyline` after
`isSpreadBoundedRWSkyline_of_isLevelPocketBand` after `isLevelPocketBand_of_isLevelPocketBandAt`)
into the single survival brick that any `hP_valid` obligation on an `IsLevelPocketBandAt`
carrier reduces to. The `floor + spread ≤ rows` cap is carried inside the band itself, so no
extra hypothesis is needed. -/
theorem isLevelPocketBandAt_not_isLost {cfg : GameConfig} {spread floor : ℕ} {b : Board}
    (hb : IsLevelPocketBandAt cfg spread floor b) :
    ¬ Board.isLost cfg b :=
  not_isLost_of_isSpreadBoundedRWSkyline
    (isSpreadBoundedRWSkyline_of_isLevelPocketBand
      (isLevelPocketBand_of_isLevelPocketBandAt hb))

/-- **Carrier well-formedness face.** Any floor-exposing pocket-band board satisfies
`Board.WF`. The structural companion to `isLevelPocketBandAt_not_isLost`: a band forgets
to a reserved-well skyline (`isReservedWellSkyline_of_isSpreadBoundedRWSkyline` after
`isSpreadBoundedRWSkyline_of_isLevelPocketBand` after `isLevelPocketBand_of_isLevelPocketBandAt`),
every filled cell of which sits in a real column (`wf_of_isReservedWellSkyline`). This is the
well-formedness side-condition any pocket-band carrier reduction owes whenever it folds a valid
placement onto a carrier board (`Placement.applyStep_wf` and `foldl_applyStep_wf` require a `WF`
premise), the band analogue of `bagPhaseCarrier_wf`. -/
theorem wf_of_isLevelPocketBandAt {cfg : GameConfig} {spread floor : ℕ} {b : Board}
    (hb : IsLevelPocketBandAt cfg spread floor b) :
    Board.WF cfg b :=
  wf_of_isReservedWellSkyline
    (isReservedWellSkyline_of_isSpreadBoundedRWSkyline
      (isSpreadBoundedRWSkyline_of_isLevelPocketBand
        (isLevelPocketBand_of_isLevelPocketBandAt hb)))

/-- **Closed floor-descent for the floor-exposing band.** When the exposed floor satisfies
`4 ≤ floor`, dropping a vertical I into the well column clears 4 full rows and drops every
off-well column by 4, yielding a floor-exposing band at `floor - 4` with the SAME well and
pocket columns. This is the regulator that an unbounded bag phase can invoke to keep the
floor from drifting up indefinitely. -/
theorem isLevelPocketBandAt_vertI_descends {cfg : GameConfig} {spread floor : ℕ} {b : Board}
    (hb : IsLevelPocketBandAt cfg spread floor b) (hfloor4 : 4 ≤ floor) :
    ∃ pl : Placement, pl.piece = Piece.I ∧ pl.Valid cfg ∧
      IsLevelPocketBandAt cfg spread (floor - 4) (Placement.applyStep cfg b pl) := by
  obtain ⟨h, w, c, rfl, hw, hw0, hband, hcap, hc3, hwc, hwc1, hwc2, hwc3,
    hpc, hpc1, hpc2, hpc3⟩ := hb
  have hothers : ∀ j, j < cfg.cols → j ≠ w → 4 ≤ h j :=
    fun j hj hjw => le_trans hfloor4 (hband j hj hjw).1
  refine ⟨{ piece := Piece.I, rot := 1, col := w }, rfl, ?_, ?_⟩
  · intro cell hcell
    have h0 : ∀ d ∈ Piece.I.shapeUp 1, d.1 = 0 := by decide
    have hcz := h0 cell hcell
    show w + cell.1 < cfg.cols
    omega
  · rw [applyStep_vertI_well hw hw0 hothers]
    refine ⟨fun j => if j = w then 0 else h j - 4, w, c, rfl, hw, ?_, ?_, ?_,
      hc3, hwc, hwc1, hwc2, hwc3, ?_, ?_, ?_, ?_⟩
    · show (if w = w then 0 else h w - 4) = 0
      rw [if_pos rfl]
    · intro j hj hjw
      obtain ⟨hlo, hhi⟩ := hband j hj hjw
      simp only [if_neg hjw]
      omega
    · omega
    · show (if c = w then 0 else h c - 4) = floor - 4
      rw [if_neg (Ne.symm hwc), hpc]
    · show (if c + 1 = w then 0 else h (c + 1) - 4) = floor - 4
      rw [if_neg (Ne.symm hwc1), hpc1]
    · show (if c + 2 = w then 0 else h (c + 2) - 4) = floor - 4
      rw [if_neg (Ne.symm hwc2), hpc2]
    · show (if c + 3 = w then 0 else h (c + 3) - 4) = floor - 4
      rw [if_neg (Ne.symm hwc3), hpc3]

/-- **Descend-and-survive: the I regulator step bundled with its non-loss certificate.**
The bare `isLevelPocketBandAt_vertI_descends` gives the floor-`floor - 4` band; composing
its output through the forget-projection and the spread-bounded survival certificate shows
the intermediate board is never a top-out. This is the exact triple
(`pl.piece = I`, `pl.Valid`, invariant-preserved, not-lost) that a strategy-invariant step
obligation consumes, now stated directly on the floor-exposing carrier. -/
theorem isLevelPocketBandAt_vertI_descends_safe {cfg : GameConfig} {spread floor : ℕ}
    {b : Board} (hb : IsLevelPocketBandAt cfg spread floor b) (hfloor4 : 4 ≤ floor) :
    ∃ pl : Placement, pl.piece = Piece.I ∧ pl.Valid cfg ∧
      IsLevelPocketBandAt cfg spread (floor - 4) (Placement.applyStep cfg b pl) ∧
      ¬ Board.isLost cfg (Placement.applyStep cfg b pl) := by
  obtain ⟨pl, hpiece, hvalid, hband⟩ := isLevelPocketBandAt_vertI_descends hb hfloor4
  exact ⟨pl, hpiece, hvalid, hband,
    not_isLost_of_isSpreadBoundedRWSkyline
      (isSpreadBoundedRWSkyline_of_isLevelPocketBand
        (isLevelPocketBand_of_isLevelPocketBandAt hband))⟩

/-- **The empty board is a floor-zero pocket band (`hI_init` for the floor-exposing
carrier).** The all-zero profile with well `w = 0` and pocket origin `c = 1` is the empty
board; every vacuously non-well column sits in the degenerate band `[0, 0]`, so taking the
exposed floor to be `0` discharges the initial-state obligation. This is the canonical base
of any descent chain: the floor cannot drop below zero, and an unbounded bag phase that lifts
the floor by regen and lowers it by the I-regulator pivots around exactly this floor-zero
anchor. Floor-exposing analogue of `isLevelPocketBand_empty`. -/
theorem isLevelPocketBandAt_empty (cfg : GameConfig) {spread : ℕ}
    (hs : spread ≤ cfg.rows) (hcols : 4 < cfg.cols) :
    IsLevelPocketBandAt cfg spread 0 Board.empty := by
  refine ⟨fun _ => 0, 0, 1, (skyline_zero_eq_empty cfg).symm, cfg.cols_pos, rfl,
    ?_, ?_, ?_, ?_, ?_, ?_, ?_, rfl, rfl, rfl, rfl⟩
  · intro j hj hjw; simp
  · simpa using hs
  · omega
  · omega
  · omega
  · omega
  · omega

/-- **Tight per-column height cap for the floor-exposing band (`hI_height`, sharp).**
Every column of an `IsLevelPocketBandAt cfg spread floor` board has height at most
`floor + spread`: off-well columns sit in the band `[floor, floor + spread]` and the
reserved well is empty (`0 ≤ floor + spread`). This is strictly sharper than the forgetful
`colHeight_le_of_isLevelPocketBand` bound `≤ cfg.rows` — it reads back the EXPOSED floor,
which is the whole point of the floor-indexed predicate, and lets a regulator argue about
how much headroom `cfg.rows - (floor + spread)` remains before a clear is forced. -/
theorem colHeight_le_of_isLevelPocketBandAt {cfg : GameConfig} {spread floor : ℕ} {b : Board}
    (hb : IsLevelPocketBandAt cfg spread floor b) (j : ℕ) :
    colHeight b j ≤ floor + spread := by
  obtain ⟨h, w, c, rfl, hw, hw0, hband, hcap, hc3, hwc, hwc1, hwc2, hwc3,
    hpc, hpc1, hpc2, hpc3⟩ := hb
  by_cases hj : j < cfg.cols
  · rw [colHeight_skyline hj]
    rcases eq_or_ne j w with rfl | hjw
    · rw [hw0]; exact Nat.zero_le _
    · exact (hband j hj hjw).2
  · rw [colHeight_skyline_eq_zero (Nat.le_of_not_lt hj)]; exact Nat.zero_le _

/-- **Floor-pinned per-column top cap.** Every column of a floor-pinned spread band sits at
height at most `floor + spread`: the reserved well reads `0` (well below the cap) and every
off-well column is banded into `[floor, floor + spread]` by definition. This is the
floor-exposing, pocket-less companion to `colHeight_le_of_isLevelPocketBandAt`, obtained by the
same skyline readback but without the pocket structure — exactly the shape a pocket fill lands
in, so this is the per-column cap that survives a non-`I` fill. -/
theorem colHeight_le_of_isSpreadBoundedRWSkylineAt {cfg : GameConfig} {spread floor : ℕ}
    {b : Board} (hb : IsSpreadBoundedRWSkylineAt cfg spread floor b) (j : ℕ) :
    colHeight b j ≤ floor + spread := by
  obtain ⟨h, w, rfl, hw, hw0, hband, hcap⟩ := hb
  by_cases hj : j < cfg.cols
  · rw [colHeight_skyline hj]
    rcases eq_or_ne j w with rfl | hjw
    · rw [hw0]; exact Nat.zero_le _
    · exact (hband j hj hjw).2
  · rw [colHeight_skyline_eq_zero (Nat.le_of_not_lt hj)]; exact Nat.zero_le _

/-- **Floor-pinned band-top scalar cap.** The whole skyline of a floor-pinned spread band sits at
height at most `floor + spread` — the band TOP, the quantity a reservoir must keep under the
ceiling. It is the sup of the per-column cap `colHeight_le_of_isSpreadBoundedRWSkylineAt` over all
columns. Crucially this is the quantity a non-`I` pocket fill PRESERVES: the floor-tracked fill
arcs (`isSpreadBoundedRWSkylineAt_flat_pocket_of_isLevelPocketBandAt` and the S and Z notch arcs)
land the post-fill board in `IsSpreadBoundedRWSkylineAt 2 floor` at the SAME floor, so the band
top stays `floor + 2` across the fill even though the floor-minimum rises as the pocket is
consumed. Tracking this top rather than the floor-minimum is what dissolves the lossy per-piece
floor-plus-one ledger growth that obstructs the spread-2 reservoir closure. -/
theorem maxColHeight_le_of_isSpreadBoundedRWSkylineAt {cfg : GameConfig} {spread floor : ℕ}
    {b : Board} (hb : IsSpreadBoundedRWSkylineAt cfg spread floor b) :
    maxColHeight cfg b ≤ floor + spread := by
  unfold maxColHeight
  apply Finset.sup_le
  intro j _
  exact colHeight_le_of_isSpreadBoundedRWSkylineAt hb j

/-- **Floor-exposed band-top cap for the level pocket band.** The whole skyline of an
`IsLevelPocketBandAt cfg spread floor` board sits at height at most `floor + spread` — the band
TOP read directly off the pocket band, not merely the per-column cap. It composes the pocket-less
band-top cap `maxColHeight_le_of_isSpreadBoundedRWSkylineAt` with the forgetful edge
`isSpreadBoundedRWSkylineAt_of_isLevelPocketBandAt` (a pocket band forgets its width-four pocket to
a floor-pinned spread band at the same floor). This is the top quantity for an actual reservoir
band member, the input a top-tracking fill argument reads to certify that a non-`I` fill keeps the
band top pinned at `floor + spread` while the floor-minimum rises as the pocket is consumed. -/
theorem maxColHeight_le_of_isLevelPocketBandAt {cfg : GameConfig} {spread floor : ℕ}
    {b : Board} (hb : IsLevelPocketBandAt cfg spread floor b) :
    maxColHeight cfg b ≤ floor + spread :=
  maxColHeight_le_of_isSpreadBoundedRWSkylineAt
    (isSpreadBoundedRWSkylineAt_of_isLevelPocketBandAt hb)

/-- **Top-preservation face of a flat pocket fill.** Dropping any one of the five flat pieces
(O, horizontal-`I`, `T`, `L`, `J`) on the guaranteed width-four floor pocket of an arbitrary
`IsLevelPocketBandAt standard 2 floor` member is a valid, surviving placement whose post-fill
board keeps its band TOP pinned at `floor + 2`: `maxColHeight standard b' ≤ floor + 2`. This is
the formal statement that a non-`I` fill is top-PRESERVING — the floor-minimum rises as the pocket
is consumed, but the ceiling does not, because the piece (height at most two) lands flush into the
floor pocket while the off-pocket columns are untouched. It packages the floor-tracked flat
dispatcher `isSpreadBoundedRWSkylineAt_flat_pocket_of_isLevelPocketBandAt` (landing in
`IsSpreadBoundedRWSkylineAt standard 2 floor`) through the band-top cap
`maxColHeight_le_of_isSpreadBoundedRWSkylineAt`. Tracking this preserved top, rather than the
rising floor-minimum, is what dissolves the lossy per-piece floor-plus-one ledger growth that
obstructs the spread-2 reservoir closure. -/
theorem maxColHeight_le_flatFill_of_isLevelPocketBandAt {floor : ℕ} {b : Board}
    {p : Piece} (hp : p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J)
    (hb : IsLevelPocketBandAt GameConfig.standard 2 floor b) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard b pl) ∧
      maxColHeight GameConfig.standard
        (Placement.applyStep GameConfig.standard b pl) ≤ floor + 2 := by
  obtain ⟨pl, hpiece, hvalid, hband', hnotlost⟩ :=
    isSpreadBoundedRWSkylineAt_flat_pocket_of_isLevelPocketBandAt hp hb
  exact ⟨pl, hpiece, hvalid, hnotlost, maxColHeight_le_of_isSpreadBoundedRWSkylineAt hband'⟩

/-- **Top-preservation face of the S floor-notch fill.** Given the S unit-step floor notch on a
spread-2 reserved-well skyline (columns `c, c+1` rest at the band floor, `c+2` sits one above), the
S placement is valid, survives, and keeps the band TOP at `floor + 2`:
`maxColHeight standard b' ≤ floor + 2`. It packages the floor-tracked S arc
`isSpreadBoundedRWSkylineAt_S_floorNotch_of_skyline` through the band-top cap
`maxColHeight_le_of_isSpreadBoundedRWSkylineAt`. Unlike the five flat pieces (whose pocket is
guaranteed by any band member), the S notch must be supplied by hypothesis, so this is the
conditional brick the S phase of a phase-indexed carrier consumes. With the Z companion it
completes the all-seven top-preserving fill menu. -/
theorem maxColHeight_le_S_floorNotch_of_skyline {floor w c : ℕ} {h : ℕ → ℕ}
    (hw : w < GameConfig.standard.cols) (hw0 : h w = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ w → floor ≤ h j ∧ h j ≤ floor + 2)
    (hcap : floor + 2 ≤ GameConfig.standard.rows)
    (hc2 : c + 2 < GameConfig.standard.cols)
    (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2)
    (hpc : h c = floor) (hpc1 : h (c + 1) = floor) (hpc2 : h (c + 2) = floor + 1) :
    ∃ pl : Placement, pl.piece = Piece.S ∧ pl.Valid GameConfig.standard ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard h) pl) ∧
      maxColHeight GameConfig.standard
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard h) pl) ≤ floor + 2 := by
  obtain ⟨pl, hpiece, hvalid, hband', hnotlost⟩ :=
    isSpreadBoundedRWSkylineAt_S_floorNotch_of_skyline hw hw0 hband hcap hc2 hwc hwc1 hwc2
      hpc hpc1 hpc2
  exact ⟨pl, hpiece, hvalid, hnotlost, maxColHeight_le_of_isSpreadBoundedRWSkylineAt hband'⟩

/-- **Top-preservation face of the Z floor-notch fill.** The mirror of
`maxColHeight_le_S_floorNotch_of_skyline`: given the mirror Z unit-step floor notch on a spread-2
reserved-well skyline (column `c` sits one above the band floor, `c+1, c+2` rest at the floor), the
Z placement is valid, survives, and keeps the band TOP at `floor + 2`:
`maxColHeight standard b' ≤ floor + 2`. It packages the floor-tracked Z arc
`isSpreadBoundedRWSkylineAt_Z_floorNotch_of_skyline` through the band-top cap
`maxColHeight_le_of_isSpreadBoundedRWSkylineAt`. With the S companion this completes the
all-seven top-preserving fill menu: every tetromino, given the landing room its phase supplies,
absorbs into the spread-2 band without raising the ceiling above `floor + 2`. -/
theorem maxColHeight_le_Z_floorNotch_of_skyline {floor w c : ℕ} {h : ℕ → ℕ}
    (hw : w < GameConfig.standard.cols) (hw0 : h w = 0)
    (hband : ∀ j < GameConfig.standard.cols, j ≠ w → floor ≤ h j ∧ h j ≤ floor + 2)
    (hcap : floor + 2 ≤ GameConfig.standard.rows)
    (hc2 : c + 2 < GameConfig.standard.cols)
    (hwc : w ≠ c) (hwc1 : w ≠ c + 1) (hwc2 : w ≠ c + 2)
    (hpc : h c = floor + 1) (hpc1 : h (c + 1) = floor) (hpc2 : h (c + 2) = floor) :
    ∃ pl : Placement, pl.piece = Piece.Z ∧ pl.Valid GameConfig.standard ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard h) pl) ∧
      maxColHeight GameConfig.standard
        (Placement.applyStep GameConfig.standard (skyline GameConfig.standard h) pl) ≤ floor + 2 := by
  obtain ⟨pl, hpiece, hvalid, hband', hnotlost⟩ :=
    isSpreadBoundedRWSkylineAt_Z_floorNotch_of_skyline hw hw0 hband hcap hc2 hwc hwc1 hwc2
      hpc hpc1 hpc2
  exact ⟨pl, hpiece, hvalid, hnotlost, maxColHeight_le_of_isSpreadBoundedRWSkylineAt hband'⟩

/-- **The pocket-band carrier.** A standard-config board is admissible exactly when it is a
floor-exposing level pocket band for *some* spread and floor. This is the disjunction-of-shapes
carrier the atlas crux needs: rather than pinning one fixed surface (which the column-budget
obstruction forbids — a single board cannot host the pocket, well, S-notch and Z-notch landing
sites at once, `1 + 4 + 3 + 3 = 11 > 10` columns), membership ranges over the whole band family,
so a closure step may move between band shapes (different floor/spread) as the bag phase demands.
The four standalone band faces (`isLevelPocketBandAt_empty`, `colHeight_le_of_isLevelPocketBandAt`,
`isLevelPocketBandAt_not_isLost`, `wf_of_isLevelPocketBandAt`) discharge the four cheap carrier
obligations directly; only the per-piece transition (`hP_step`) remains open. -/
def IsPocketBandCarrier (b : Board) : Prop :=
  ∃ spread floor : ℕ, IsLevelPocketBandAt GameConfig.standard spread floor b

/-- **`init` lands in the pocket-band carrier** (the `hinit` obligation). The empty board is a
degenerate floor-`0` spread-`0` pocket band (`isLevelPocketBandAt_empty`, needing only the trivial
`0 ≤ rows` and `4 < cols` for the standard config), so it is carrier-admissible. This is the base
of the carrier's reachability induction — the band analogue of `bagPhaseCarrier_init`. -/
theorem isPocketBandCarrier_empty : IsPocketBandCarrier Board.empty :=
  ⟨0, 0, isLevelPocketBandAt_empty GameConfig.standard (by decide) (by decide)⟩

/-- **The pocket-band carrier is height-capped** (the `hheight` obligation). Every column of a
carrier board has height at most `rows`: the board is *some* level pocket band
(`IsPocketBandCarrier`), which forgets to a spread-bounded reserved-well skyline whose ceiling is
`rows` (`colHeight_le_of_isLevelPocketBand` after `isLevelPocketBand_of_isLevelPocketBandAt`). This is
the carrier-vocabulary lift of the standalone band cap — the band analogue of `bagPhaseCarrier_height`
— and the obligation that, fed to `tetrisSolvableValid_of_strategy_bagInvariant`, rules out top-out
for every reachable carrier board for free. -/
theorem isPocketBandCarrier_height {b : Board} (hb : IsPocketBandCarrier b) (j : ℕ) :
    colHeight b j ≤ GameConfig.standard.rows := by
  obtain ⟨spread, floor, hband⟩ := hb
  exact colHeight_le_of_isLevelPocketBand (isLevelPocketBand_of_isLevelPocketBandAt hband) j

/-- **The pocket-band carrier certifies non-loss** (the survival obligation). No carrier board is
a lost board: the board is *some* level pocket band (`IsPocketBandCarrier`), and every such band is
not lost (`isLevelPocketBandAt_not_isLost`, which carries the `floor + spread ≤ rows` cap internally).
This is the carrier-vocabulary lift of the survival face — the band analogue of
`bagPhaseCarrier_not_isLost` — restating the height budget as the actual top-out-free property the
affirmative atlas claim is about. -/
theorem isPocketBandCarrier_not_isLost {b : Board} (hb : IsPocketBandCarrier b) :
    ¬ Board.isLost GameConfig.standard b := by
  obtain ⟨spread, floor, hband⟩ := hb
  exact isLevelPocketBandAt_not_isLost hband

/-- **The pocket-band carrier is well-formed** (the `WF` side-condition). Every carrier board
satisfies `Board.WF`: it is *some* level pocket band (`IsPocketBandCarrier`), each of which forgets to
a reserved-well skyline with every filled cell in a real column (`wf_of_isLevelPocketBandAt`). This is
the carrier-vocabulary lift of the structural face — the band analogue of `bagPhaseCarrier_wf` — and the
well-formedness premise any carrier closure owes when folding a valid placement onto a carrier board
(`Placement.applyStep_wf`, `foldl_applyStep_wf`). With this, all four cheap carrier obligations
(init/height/not_isLost/wf) are discharged on `IsPocketBandCarrier`. -/
theorem isPocketBandCarrier_wf {b : Board} (hb : IsPocketBandCarrier b) :
    Board.WF GameConfig.standard b := by
  obtain ⟨spread, floor, hband⟩ := hb
  exact wf_of_isLevelPocketBandAt hband

/-- **The spread-bounded pocket-band carrier.** A standard-config board is `spread`-admissible
exactly when it is a floor-exposing level pocket band of *that* spread for some floor — the
spread-pinned refinement of `IsPocketBandCarrier` (which forgets the spread entirely with a second
existential). Pinning the spread turns the carrier into a budget: `spread` is the headroom the band
may occupy above its exposed floor, so a single piece (which lifts a column by at most `4`) can be
absorbed only while `spread` is wide enough, and a well-clear drain restores the flat `spread = 0`
shape at a bag boundary. This is the growth-tolerant invariant the per-piece `hstep` crux (#66)
needs: a bag-indexed carrier will read `spread` off the bag phase, widening it as pieces are spent
and forcing a drain when it saturates. The init face below is the base of that ledger. -/
def IsBoundedPocketBandCarrier (spread : ℕ) (b : Board) : Prop :=
  ∃ floor : ℕ, IsLevelPocketBandAt GameConfig.standard spread floor b

/-- **`init` lands in the spread-bounded carrier** (the `hinit` obligation, any spread within the
ceiling). The empty board is a floor-`0` level pocket band at *every* spread up to `rows`
(`isLevelPocketBandAt_empty`, needing only `spread ≤ rows` and `4 < cols` for the standard config),
so it inhabits `IsBoundedPocketBandCarrier spread` for each such `spread`. This is the band analogue
of `isPocketBandCarrier_empty` carrying the explicit spread budget — the base of the spread ledger a
bag-indexed carrier threads through play. -/
theorem isBoundedPocketBandCarrier_empty {spread : ℕ}
    (hs : spread ≤ GameConfig.standard.rows) :
    IsBoundedPocketBandCarrier spread Board.empty :=
  ⟨0, isLevelPocketBandAt_empty GameConfig.standard hs (by decide)⟩

/-- **The spread-bounded carrier is height-capped** (the `hheight` obligation). Every column of an
`IsBoundedPocketBandCarrier spread` board has height at most `rows`: the board is a level pocket band
at the pinned spread for some floor, which forgets to a spread-bounded reserved-well skyline whose
ceiling is `rows` (`colHeight_le_of_isLevelPocketBand` after `isLevelPocketBand_of_isLevelPocketBandAt`).
The exact mirror of `isPocketBandCarrier_height` carrying the explicit spread budget — the obligation
that, fed to the bag-indexed strategy reduction, rules out top-out for every reachable bounded-carrier
board for free. -/
theorem isBoundedPocketBandCarrier_height {spread : ℕ} {b : Board}
    (hb : IsBoundedPocketBandCarrier spread b) (j : ℕ) :
    colHeight b j ≤ GameConfig.standard.rows := by
  obtain ⟨floor, hband⟩ := hb
  exact colHeight_le_of_isLevelPocketBand (isLevelPocketBand_of_isLevelPocketBandAt hband) j

/-- **The spread-bounded carrier's scalar-potential ceiling.** The `maxColHeight` face of
`isBoundedPocketBandCarrier_height`: every budgeted-carrier board has surface potential at most
`rows`. The per-column height bound (`isBoundedPocketBandCarrier_height`, each `colHeight ≤ rows`)
caps the supremum over the real columns directly (`Finset.sup_le`), so the whole `maxColHeight`
sits under `rows`. Where the per-column face serves field-level reasoning, this serves the
potential route: an `hstep` discharge can read the budgeted carrier's height headroom off a single
scalar and feed it straight into `not_isLost_of_maxColHeight_le`, with no per-column unfolding. The
budgeted-vocabulary mirror of `bagPhaseCarrier_maxColHeight_le`. -/
theorem isBoundedPocketBandCarrier_maxColHeight_le {spread : ℕ} {b : Board}
    (hb : IsBoundedPocketBandCarrier spread b) :
    maxColHeight GameConfig.standard b ≤ GameConfig.standard.rows := by
  unfold maxColHeight
  apply Finset.sup_le
  intro j _
  exact isBoundedPocketBandCarrier_height hb j

/-- **The spread-bounded carrier refines the bare carrier** (forget edge). Pinning the spread to a
fixed budget only strengthens membership, so a `IsBoundedPocketBandCarrier spread` board is a fortiori
an `IsPocketBandCarrier` board: re-introduce the forgotten spread as the outer existential witness
(`⟨spread, hb⟩`). This is the structural inclusion `IsPocketBandCarrier b = ∃ spread,
IsBoundedPocketBandCarrier spread b` made explicit — the bridge that lets any fact proven against the
budgeted carrier (and any strategy maintaining it) discharge the iter187 front door
`tetrisSolvableValid_of_pocketBandCarrier_strategy`, which is stated over the bare carrier. -/
theorem isPocketBandCarrier_of_isBoundedPocketBandCarrier {spread : ℕ} {b : Board}
    (hb : IsBoundedPocketBandCarrier spread b) : IsPocketBandCarrier b :=
  ⟨spread, hb⟩

/-- **The spread-bounded carrier certifies non-loss** (the survival obligation). No budgeted-carrier
board is a lost board: forget the pinned spread (`isPocketBandCarrier_of_isBoundedPocketBandCarrier`)
and invoke the bare carrier's survival face (`isPocketBandCarrier_not_isLost`). This is the
spread-budgeted lift of the survival certificate — the actual top-out-free property the affirmative
atlas claim is about — completing, alongside init and height, the cheap-face trio a bag-indexed
reduction over the budgeted carrier reads off membership directly. -/
theorem isBoundedPocketBandCarrier_not_isLost {spread : ℕ} {b : Board}
    (hb : IsBoundedPocketBandCarrier spread b) :
    ¬ Board.isLost GameConfig.standard b :=
  isPocketBandCarrier_not_isLost (isPocketBandCarrier_of_isBoundedPocketBandCarrier hb)

/-- **The spread-bounded carrier is well-formed** (the structural obligation, last of the cheap
faces). Every budgeted-carrier board satisfies `Board.WF` for the standard config: forget the pinned
spread (`isPocketBandCarrier_of_isBoundedPocketBandCarrier`) and invoke the bare carrier's
well-formedness face (`isPocketBandCarrier_wf`). With this the budgeted carrier now discharges all
four cheap obligations a bag-indexed reduction needs — init, height, not_isLost, wf — so the only
remaining content is the genuine bag-boundary re-flatten step, not any membership bookkeeping. -/
theorem isBoundedPocketBandCarrier_wf {spread : ℕ} {b : Board}
    (hb : IsBoundedPocketBandCarrier spread b) :
    Board.WF GameConfig.standard b :=
  isPocketBandCarrier_wf (isPocketBandCarrier_of_isBoundedPocketBandCarrier hb)

/-- **The carrier's flat-piece fill edge** (carrier-input form of the iter239 dispatcher). From any
spread-2 bounded pocket-band carrier board, dropping any one of the five flat pieces (O, horizontal-I,
T, L, J) on its guaranteed width-four floor pocket is a valid placement landing in
`IsSpreadBoundedRWSkyline standard 2` (hence not lost). It is the iter239 flat dispatcher with the
input restated in carrier vocabulary: `IsBoundedPocketBandCarrier 2` unfolds to *some* floor-exposing
level pocket band, which the dispatcher consumes directly. Note the landing is the bare spread band,
strictly wider than the carrier (the carrier additionally guarantees a pocket); regenerating the
pocket from this spread band is the open re-entry step the closed transition graph still owes. -/
theorem isSpreadBoundedRWSkyline_flat_fill_of_isBoundedPocketBandCarrier {b : Board} {p : Piece}
    (hp : p = Piece.O ∨ p = Piece.I ∨ p = Piece.T ∨ p = Piece.L ∨ p = Piece.J)
    (hb : IsBoundedPocketBandCarrier 2 b) :
    ∃ pl : Placement, pl.piece = p ∧ pl.Valid GameConfig.standard ∧
      IsSpreadBoundedRWSkyline GameConfig.standard 2
        (Placement.applyStep GameConfig.standard b pl) ∧
      ¬ Board.isLost GameConfig.standard
        (Placement.applyStep GameConfig.standard b pl) := by
  obtain ⟨floor, hband⟩ := hb
  exact isSpreadBoundedRWSkyline_flat_pocket_of_isLevelPocketBandAt hp hband

/-- **The bounded carrier is itself a spread band (subsumption inclusion).** Every
`IsBoundedPocketBandCarrier spread` board forgets — by dropping its pocket witness — to an
`IsSpreadBoundedRWSkyline standard spread` board, via the standing chain
`isSpreadBoundedRWSkyline_of_isLevelPocketBand` after `isLevelPocketBand_of_isLevelPocketBandAt`. This
makes the redundancy explicit: a level pocket band is a *special case* of the bare spread band (it adds
a guaranteed four-wide level basin), so a disjunctive carrier "pocket band or spread band" collapses to
the spread band alone. The strategic consequence is that the pocket guarantee is load-bearing only on
the *input* side of the fill edge (to land a flat piece predictably); the carrier cannot simply be
widened to the spread band, because the spread band is not closed under the flat pieces without a
pocket to aim at. Reusable wherever a carrier board must be handed to bare-spread-band machinery
(height cap, non-loss, card ledger). -/
theorem isSpreadBoundedRWSkyline_of_isBoundedPocketBandCarrier {spread : ℕ} {b : Board}
    (hb : IsBoundedPocketBandCarrier spread b) :
    IsSpreadBoundedRWSkyline GameConfig.standard spread b := by
  obtain ⟨floor, hband⟩ := hb
  exact isSpreadBoundedRWSkyline_of_isLevelPocketBand
    (isLevelPocketBand_of_isLevelPocketBandAt hband)

/-- **The spread-bounded carrier's card/area ceiling.** Every budgeted-carrier board holds at most
`(cols - 1) * rows` filled cells. The board is a level pocket band at the pinned spread for some
floor, which forgets along the standing chain to a reserved-well skyline
(`isReservedWellSkyline_of_isSpreadBoundedRWSkyline` after `isSpreadBoundedRWSkyline_of_isLevelPocketBand`
after `isLevelPocketBand_of_isLevelPocketBandAt`); the reserved well contributes `0` to the count, so
the other `cols - 1` columns each capped at `rows` give the ceiling (`isReservedWellSkyline_card_le`).
This is the static area budget the per-bag card ledger drifts beneath — the budgeted-vocabulary mirror
of `bagPhaseCarrier_card_le`, and the conserved potential the eventual drain-forcing accounting (a
saturated bag must clear) reads off carrier membership. Banks the reserved well, so strictly sharper
than the trivial whole-grid bound `cols * rows`. -/
theorem isBoundedPocketBandCarrier_card_le {spread : ℕ} {b : Board}
    (hb : IsBoundedPocketBandCarrier spread b) :
    b.card ≤ (GameConfig.standard.cols - 1) * GameConfig.standard.rows := by
  obtain ⟨floor, hband⟩ := hb
  exact isReservedWellSkyline_card_le
    (isReservedWellSkyline_of_isSpreadBoundedRWSkyline
      (isSpreadBoundedRWSkyline_of_isLevelPocketBand
        (isLevelPocketBand_of_isLevelPocketBandAt hband)))

/-- **The spread-bounded carrier's live area ceiling.** The M-parameterized refinement of
`isBoundedPocketBandCarrier_card_le`: given any ceiling `M` with `maxColHeight ≤ M`, the budgeted
carrier holds at most `(cols - 1) * M` filled cells. Same forgetful bridge chain to a reserved-well
skyline (`isReservedWellSkyline_of_isSpreadBoundedRWSkyline` after `isSpreadBoundedRWSkyline_of_
isLevelPocketBand` after `isLevelPocketBand_of_isLevelPocketBandAt`), but the count is then read off
by the live-potential ledger `isReservedWellSkyline_card_le_of_maxColHeight_le` instead of the static
`isReservedWellSkyline_card_le` — the reserved well still contributes `0`, and each of the other
`cols - 1` columns is capped at the live `M` rather than the full board height `rows`. On a post-drain
endpoint where the scalar reset family pins `maxColHeight ≤ 5` (the `..._maxColHeight` drain faces),
this collapses to `card ≤ (10 - 1) * 5 = 45`: the conserved area potential that a drain-forcing
pigeonhole (a saturated bag must clear a row) consumes. Banks the well AND tracks the live ceiling, so
strictly sharper than both `isBoundedPocketBandCarrier_card_le` (`(cols-1)*rows`) and the generic
`card_le_mul_maxColHeight` (`cols*M`). -/
theorem isBoundedPocketBandCarrier_card_le_of_maxColHeight_le {spread M : ℕ} {b : Board}
    (hb : IsBoundedPocketBandCarrier spread b)
    (hM : maxColHeight GameConfig.standard b ≤ M) :
    b.card ≤ (GameConfig.standard.cols - 1) * M := by
  obtain ⟨floor, hband⟩ := hb
  exact isReservedWellSkyline_card_le_of_maxColHeight_le
    (isReservedWellSkyline_of_isSpreadBoundedRWSkyline
      (isSpreadBoundedRWSkyline_of_isLevelPocketBand
        (isLevelPocketBand_of_isLevelPocketBandAt hband)))
    hM

/-- **Budget-preserving I-drain edge into the spread-bounded carrier.** The spread-pinned
refinement of `isPocketBandCarrier_of_vertI_descends`: draining a floor-exposing level pocket band of
spread `spread` and floor at least `4` with one valid vertical `I` in the reserved well lands in
`IsBoundedPocketBandCarrier spread` — the SAME spread budget, not the spread-forgetting bare carrier.
The drained board is the floor `(floor - 4)` band of `isLevelPocketBandAt_vertI_descends`, repackaged
by forgetting only the floor into the budgeted carrier's existential; the survival face reads
`¬ isLost` straight off that band via `isLevelPocketBandAt_vertI_descends_safe`. This is the
"collapse on the bag's I" edge the phase-indexed carrier needs in budgeted vocabulary: whatever floor
the fill phase reached, one well `I` lowers it by four while holding the spread headroom fixed, so the
budget the bag phase tracks is preserved exactly across the drain. -/
theorem isBoundedPocketBandCarrier_of_vertI_descends {spread floor : ℕ} {b : Board}
    (hb : IsLevelPocketBandAt GameConfig.standard spread floor b) (hfloor : 4 ≤ floor) :
    ∃ pl : Placement, pl.piece = Piece.I ∧ pl.Valid GameConfig.standard ∧
      IsBoundedPocketBandCarrier spread (Placement.applyStep GameConfig.standard b pl) ∧
      ¬ Board.isLost GameConfig.standard (Placement.applyStep GameConfig.standard b pl) := by
  obtain ⟨pl, hpiece, hvalid, hband, hsafe⟩ := isLevelPocketBandAt_vertI_descends_safe hb hfloor
  exact ⟨pl, hpiece, hvalid, ⟨floor - 4, hband⟩, hsafe⟩

/-- **The I-regulator drives the floor down by `4·n` over `n` valid I-placements.**
Iterating the single-step `isLevelPocketBandAt_vertI_descends` `n` times: from a floor-`floor`
band with `4·n ≤ floor`, there is a length-`n` list of placements, every one a valid `I`,
whose left-fold lands in a floor-`(floor - 4·n)` band. This is the first arbitrary-horizon
certificate on the floor-exposing carrier — the regulator provably controls the floor across
any number of clears, not just one — and exercises the `List.foldl` play machinery the full
bag cycle will reuse. -/
theorem isLevelPocketBandAt_vertI_iter {cfg : GameConfig} {spread : ℕ} (n : ℕ) :
    ∀ {floor : ℕ} {b : Board}, IsLevelPocketBandAt cfg spread floor b → 4 * n ≤ floor →
      ∃ ps : List Placement, ps.length = n ∧
        (∀ pl ∈ ps, pl.piece = Piece.I ∧ pl.Valid cfg) ∧
        IsLevelPocketBandAt cfg spread (floor - 4 * n)
          (List.foldl (Placement.applyStep cfg) b ps) := by
  induction n with
  | zero =>
    intro floor b hb _
    refine ⟨[], rfl, ?_, ?_⟩
    · intro pl hpl; simp at hpl
    · simpa using hb
  | succ n ih =>
    intro floor b hb hn
    have hfloor4 : 4 ≤ floor := by omega
    obtain ⟨pl, hpiece, hvalid, hband'⟩ := isLevelPocketBandAt_vertI_descends hb hfloor4
    have hn' : 4 * n ≤ floor - 4 := by omega
    obtain ⟨ps, hlen, hall, hband''⟩ := ih hband' hn'
    refine ⟨pl :: ps, ?_, ?_, ?_⟩
    · simp [hlen]
    · intro q hq
      rcases List.mem_cons.mp hq with rfl | hq'
      · exact ⟨hpiece, hvalid⟩
      · exact hall q hq'
    · have hidx : floor - 4 - 4 * n = floor - 4 * (n + 1) := by omega
      rw [hidx] at hband''
      simpa [List.foldl_cons] using hband''

/-- **Transient (every-prefix) survival of the I-regulator drain.** Strengthens
`isLevelPocketBandAt_vertI_iter` from the ENDPOINT band to a per-prefix non-loss certificate:
the same list `ps` of valid `I`-placements that drains a floor-`floor` band down to
floor-`(floor - 4·n)` is now certified so that EVERY prefix `ps.take k`, folded onto the start
board, is not a top-out. Survival is transient — a strategy must dodge a loss at each
intermediate well clear, not merely at the final one — and the crude additive engine
`not_isLost_foldl_take_applyStep_skyline` is useless here because the descent CLEARS rows (its
`B + 4·length` budget would falsely forbid a long drain). Instead the proof rides the band
structure: at each step the head placement lands a fresh floor-exposing band
(`isLevelPocketBandAt_vertI_descends`), whose own survival certificate (forget floor, forget
pocket, ceiling cap) discharges the prefix, and the induction hypothesis covers the tail. This
is the loss-freedom companion the bag-phase descent schedule consumes on the floor-exposing
carrier. -/
theorem isLevelPocketBandAt_vertI_iter_safe {cfg : GameConfig} {spread : ℕ} (n : ℕ) :
    ∀ {floor : ℕ} {b : Board}, IsLevelPocketBandAt cfg spread floor b → 4 * n ≤ floor →
      ∃ ps : List Placement, ps.length = n ∧
        (∀ pl ∈ ps, pl.piece = Piece.I ∧ pl.Valid cfg) ∧
        IsLevelPocketBandAt cfg spread (floor - 4 * n)
          (List.foldl (Placement.applyStep cfg) b ps) ∧
        (∀ k, ¬ Board.isLost cfg
          (List.foldl (Placement.applyStep cfg) b (ps.take k))) := by
  induction n with
  | zero =>
    intro floor b hb _
    refine ⟨[], rfl, ?_, ?_, ?_⟩
    · intro pl hpl; simp at hpl
    · simpa using hb
    · intro k
      simp only [List.take_nil, List.foldl_nil]
      exact not_isLost_of_isSpreadBoundedRWSkyline
        (isSpreadBoundedRWSkyline_of_isLevelPocketBand
          (isLevelPocketBand_of_isLevelPocketBandAt hb))
  | succ n ih =>
    intro floor b hb hn
    have hfloor4 : 4 ≤ floor := by omega
    obtain ⟨pl, hpiece, hvalid, hband'⟩ := isLevelPocketBandAt_vertI_descends hb hfloor4
    have hn' : 4 * n ≤ floor - 4 := by omega
    obtain ⟨ps, hlen, hall, hband'', hsafe⟩ := ih hband' hn'
    refine ⟨pl :: ps, ?_, ?_, ?_, ?_⟩
    · simp [hlen]
    · intro q hq
      rcases List.mem_cons.mp hq with rfl | hq'
      · exact ⟨hpiece, hvalid⟩
      · exact hall q hq'
    · have hidx : floor - 4 - 4 * n = floor - 4 * (n + 1) := by omega
      rw [hidx] at hband''
      simpa [List.foldl_cons] using hband''
    · intro k
      cases k with
      | zero =>
        simp only [List.take_zero, List.foldl_nil]
        exact not_isLost_of_isSpreadBoundedRWSkyline
          (isSpreadBoundedRWSkyline_of_isLevelPocketBand
            (isLevelPocketBand_of_isLevelPocketBandAt hb))
      | succ m =>
        simp only [List.take_succ_cons, List.foldl_cons]
        exact hsafe m

/-- **Maximal drain: the I-regulator empties any band down to its floor-residue `floor % 4`.**
Instantiating `isLevelPocketBandAt_vertI_iter` at `n := floor / 4` (legal since
`4 · (floor / 4) ≤ floor`) leaves a band whose exposed floor is
`floor - 4 · (floor / 4) = floor % 4 < 4`, reached by a list of valid `I`-placements. This is
the "drop the stack as far as the regulator can" operation — the descent side bottoms out
below height 4, where no further well-clear is available, exactly the regime the floor-zero
init anchors. -/
theorem isLevelPocketBandAt_vertI_drain {cfg : GameConfig} {spread floor : ℕ} {b : Board}
    (hb : IsLevelPocketBandAt cfg spread floor b) :
    ∃ ps : List Placement, (∀ pl ∈ ps, pl.piece = Piece.I ∧ pl.Valid cfg) ∧
      IsLevelPocketBandAt cfg spread (floor % 4)
        (List.foldl (Placement.applyStep cfg) b ps) := by
  obtain ⟨ps, _, hall, hband⟩ := isLevelPocketBandAt_vertI_iter (floor / 4) hb (by omega)
  have hres : floor - 4 * (floor / 4) = floor % 4 := by omega
  rw [hres] at hband
  exact ⟨ps, hall, hband⟩

/-- **Transient-survival maximal drain: the I-regulator empties any band to its floor-residue
without ever topping out.** The every-prefix survival face of `isLevelPocketBandAt_vertI_drain`,
got by composing the transient `isLevelPocketBandAt_vertI_iter_safe` at `n := floor / 4`: the
same length-`(floor / 4)` list of valid `I`-placements both drains the band to exposed floor
`floor % 4 < 4` AND keeps every prefix un-lost. This is the fully-certified "drop the stack as
far as the regulator can" operation — a strategy may run the entire drain blind to the
intermediate boards and the certificate guarantees no top-out at any clear — exactly the
loss-freedom obligation a per-bag descent schedule discharges on the floor-exposing carrier. -/
theorem isLevelPocketBandAt_vertI_drain_safe {cfg : GameConfig} {spread floor : ℕ} {b : Board}
    (hb : IsLevelPocketBandAt cfg spread floor b) :
    ∃ ps : List Placement, (∀ pl ∈ ps, pl.piece = Piece.I ∧ pl.Valid cfg) ∧
      IsLevelPocketBandAt cfg spread (floor % 4)
        (List.foldl (Placement.applyStep cfg) b ps) ∧
      (∀ k, ¬ Board.isLost cfg
        (List.foldl (Placement.applyStep cfg) b (ps.take k))) := by
  obtain ⟨ps, _, hall, hband, hsafe⟩ :=
    isLevelPocketBandAt_vertI_iter_safe (floor / 4) hb (by omega)
  have hres : floor - 4 * (floor / 4) = floor % 4 := by omega
  rw [hres] at hband
  exact ⟨ps, hall, hband, hsafe⟩

/-- **Carrier-vocabulary maximal I-drain: the reset-between-bags regulator on the budgeted band.**
The spread-pinned, arbitrary-member lift of `isLevelPocketBandAt_vertI_drain_safe` into the
`IsBoundedPocketBandCarrier` vocabulary. Unlike the single-step
`isBoundedPocketBandCarrier_of_vertI_descends` (which needs `4 ≤ floor` and lowers the floor by
exactly four), this edge starts from ANY budgeted-carrier board — whatever hidden floor it carries —
and runs the maximal well-drain: a list of valid `I`-placements that empties the stack down to its
floor-residue `floor % 4 < 4` while holding the spread budget fixed and keeping every prefix un-lost.
Forgetting only the residue floor `floor % 4` repackages the drained band into
`IsBoundedPocketBandCarrier spread`; the transient survival certificate passes straight through. This
is the spread-preserving "reset" companion to the ascent edge: the ascent spends one unit of spread to
raise the floor, the drain spends none and returns the surface to the lowest residue a fresh bag can
re-flatten from, so the budget a bag-indexed strategy threads is exactly conserved across the inter-bag
collapse. -/
theorem isBoundedPocketBandCarrier_of_vertI_drain {spread : ℕ} {b : Board}
    (hb : IsBoundedPocketBandCarrier spread b) :
    ∃ ps : List Placement, (∀ pl ∈ ps, pl.piece = Piece.I ∧ pl.Valid GameConfig.standard) ∧
      IsBoundedPocketBandCarrier spread
        (List.foldl (Placement.applyStep GameConfig.standard) b ps) ∧
      (∀ k, ¬ Board.isLost GameConfig.standard
        (List.foldl (Placement.applyStep GameConfig.standard) b (ps.take k))) := by
  obtain ⟨floor, hband⟩ := hb
  obtain ⟨ps, hall, hdrain, hsafe⟩ := isLevelPocketBandAt_vertI_drain_safe hband
  exact ⟨ps, hall, ⟨floor % 4, hdrain⟩, hsafe⟩

/-- **Constant-ceiling arbitrary-member drain: any spread-2 carrier surface returns below height 5.**
The fixed-ceiling strengthening of `isBoundedPocketBandCarrier_of_vertI_drain`, and the
arbitrary-member analogue of `isBoundedPocketBandCarrier_fill_then_drain_bounded` (which pins the
input to a canonical surface). From ANY `IsBoundedPocketBandCarrier 2` board — whatever hidden floor,
however tall it grew — the maximal well-drain produces a list of valid `I`-placements landing in
`IsBoundedPocketBandCarrier 2` with EVERY column height bounded by the absolute constant `5`, and every
prefix un-lost. The drained band sits at floor `floor % 4 < 4` and spread `2`, so
`colHeight_le_of_isLevelPocketBandAt` reads `colHeight ≤ floor % 4 + 2 ≤ 5` independent of the input
height. Where `isBoundedPocketBandCarrier_height` only certifies the generic `≤ rows` ceiling, this
edge certifies a CONSTANT gap of `15` beneath the 20-row top-out after the regulator runs — the
fixed-ceiling reset property the bag cycle needs from an arbitrary surface, not merely from a canonical
input: no matter how the six non-regulating pieces of a bag pile up a spread-2 surface, the single
well-`I` drain collapses it back below height `5`. -/
theorem isBoundedPocketBandCarrier_of_vertI_drain_bounded {b : Board}
    (hb : IsBoundedPocketBandCarrier 2 b) :
    ∃ ps : List Placement, (∀ pl ∈ ps, pl.piece = Piece.I ∧ pl.Valid GameConfig.standard) ∧
      IsBoundedPocketBandCarrier 2
        (List.foldl (Placement.applyStep GameConfig.standard) b ps) ∧
      (∀ j, colHeight
        (List.foldl (Placement.applyStep GameConfig.standard) b ps) j ≤ 5) ∧
      (∀ k, ¬ Board.isLost GameConfig.standard
        (List.foldl (Placement.applyStep GameConfig.standard) b (ps.take k))) := by
  obtain ⟨floor, hband⟩ := hb
  obtain ⟨ps, hall, hdrain, hsafe⟩ := isLevelPocketBandAt_vertI_drain_safe hband
  refine ⟨ps, hall, ⟨floor % 4, hdrain⟩, ?_, hsafe⟩
  intro j
  have h4 : floor % 4 < 4 := Nat.mod_lt _ (by norm_num)
  have hj := colHeight_le_of_isLevelPocketBandAt hdrain j
  omega

/-- **Scalar-potential constant-ceiling reset of the arbitrary-member drain.** The single-scalar
companion to `isBoundedPocketBandCarrier_of_vertI_drain_bounded`: from ANY `IsBoundedPocketBandCarrier 2`
board the maximal well-drain lands in `IsBoundedPocketBandCarrier 2` with the *scalar potential*
`maxColHeight ≤ 5`, every placement a valid `I`, and every prefix un-lost. Where the `_bounded` face
states the post-regulator ceiling per column (`∀ j, colHeight ≤ 5`), this collapses the family of
column bounds into the one supremum the potential route reads (`Finset.sup_le` over the per-column
`≤ 5`), so a step can feed it straight into `not_isLost_of_maxColHeight_le` with a tight constant gap
of `15` beneath the 20-row top-out — no per-column unfolding. It is strictly sharper than the generic
`isBoundedPocketBandCarrier_maxColHeight_le` (which only certifies the `≤ rows = 20` ceiling on an
arbitrary member): after the regulator runs, the scalar potential sits at the absolute `≤ 5`,
independent of how tall the input surface grew. This is the scalar fixed-ceiling reset the bag cycle's
height accounting consumes — whatever the six non-regulating pieces pile up, the one well-`I` drain
returns the surface potential below `5`. -/
theorem isBoundedPocketBandCarrier_of_vertI_drain_maxColHeight {b : Board}
    (hb : IsBoundedPocketBandCarrier 2 b) :
    ∃ ps : List Placement, (∀ pl ∈ ps, pl.piece = Piece.I ∧ pl.Valid GameConfig.standard) ∧
      IsBoundedPocketBandCarrier 2
        (List.foldl (Placement.applyStep GameConfig.standard) b ps) ∧
      maxColHeight GameConfig.standard
        (List.foldl (Placement.applyStep GameConfig.standard) b ps) ≤ 5 ∧
      (∀ k, ¬ Board.isLost GameConfig.standard
        (List.foldl (Placement.applyStep GameConfig.standard) b (ps.take k))) := by
  obtain ⟨ps, hall, hdrain, hcap, hsafe⟩ := isBoundedPocketBandCarrier_of_vertI_drain_bounded hb
  refine ⟨ps, hall, hdrain, ?_, hsafe⟩
  unfold maxColHeight
  apply Finset.sup_le
  intro j _
  exact hcap j

/-- **Guaranteed flat landing basin on any budgeted-carrier surface.** The carrier-vocabulary lift of
`isLevelPocketBandAt_pocket_window` (the band pocket-window primitive), bundled with the per-column
spread cap `colHeight_le_of_isLevelPocketBandAt`. Every `IsBoundedPocketBandCarrier spread` board — no
matter how its off-pocket columns vary within the band — exposes four consecutive in-bounds columns
`c, c + 1, c + 2, c + 3` whose `colHeight` is *exactly* a common floor value, AND every column of the
board sits at most `spread` above that floor. The basin sits at the band's lowest level (the exposed
floor), so a piece dropped to span it rests predictably at `floor` regardless of the neighbouring
bumps, while the `colHeight ≤ floor + spread` bound caps how far the rest of the surface towers over
the basin. This is the geometric precondition the arbitrary-member fill edge consumes: it turns the
existentially-hidden band profile into a concrete usable landing window plus a uniform height envelope,
the two facts a player needs to place a drawn piece on an otherwise uncontrolled carrier member and
predict the resulting band. -/
theorem isBoundedPocketBandCarrier_pocket_window {spread : ℕ} {b : Board}
    (hb : IsBoundedPocketBandCarrier spread b) :
    ∃ (c floor : ℕ), c + 3 < GameConfig.standard.cols ∧
      Board.colHeight b c = floor ∧ Board.colHeight b (c + 1) = floor ∧
      Board.colHeight b (c + 2) = floor ∧ Board.colHeight b (c + 3) = floor ∧
      (∀ j, Board.colHeight b j ≤ floor + spread) := by
  obtain ⟨floor, hband⟩ := hb
  obtain ⟨c, hc3, hc, hc1, hc2, hc3'⟩ := isLevelPocketBandAt_pocket_window hband
  exact ⟨c, floor, hc3, hc, hc1, hc2, hc3',
    fun j => colHeight_le_of_isLevelPocketBandAt hband j⟩

/-- **Floor-exposing flat band: a flat profile carries a level pocket at its known floor.**
The floor-exposing analogue of `isLevelPocketBand_flat`. On a flat surface whose every
non-well column sits at the common height `base` and whose well `w` is empty, the board is
a `IsLevelPocketBandAt cfg spread base` band: the exposed floor is exactly `base`. This is
the bridge that lets a re-flattened surface (after a well clear via `applyStep_vertI_well`)
re-enter the floor-exposing carrier at a STATICALLY KNOWN floor, rather than the
existentially hidden floor of `IsLevelPocketBand`. The window picker chooses `c = 4` when
`w < 4` and `c = 0` otherwise, guaranteeing four consecutive non-well anchor columns. -/
theorem isLevelPocketBandAt_flat {cfg : GameConfig} {spread base w : ℕ}
    (hw : w < cfg.cols) (h8 : 8 ≤ cfg.cols) (hcap : base + spread ≤ cfg.rows) :
    IsLevelPocketBandAt cfg spread base
      (skyline cfg (fun j => if j = w then 0 else base)) := by
  obtain ⟨c, hc3, hwc, hwc1, hwc2, hwc3⟩ :
      ∃ c, c + 3 < cfg.cols ∧ w ≠ c ∧ w ≠ c + 1 ∧ w ≠ c + 2 ∧ w ≠ c + 3 := by
    rcases Nat.lt_or_ge w 4 with hlt | hge
    · exact ⟨4, by omega, by omega, by omega, by omega, by omega⟩
    · exact ⟨0, by omega, by omega, by omega, by omega, by omega⟩
  refine ⟨fun j => if j = w then 0 else base, w, c, rfl, hw, ?_, ?_, hcap, hc3,
    hwc, hwc1, hwc2, hwc3, ?_, ?_, ?_, ?_⟩
  · simp
  · intro j hj hjw; simp only [if_neg hjw]; omega
  · simp only [if_neg (Ne.symm hwc)]
  · simp only [if_neg (Ne.symm hwc1)]
  · simp only [if_neg (Ne.symm hwc2)]
  · simp only [if_neg (Ne.symm hwc3)]

/-- **The flat-shelf canonical input surface is itself a pocket band at floor `base`.**
The canonical input surface used by the per-bag dispatcher for the flat-landing pieces
(O, I, T, L, J) is the flat shelf `fun j => if j = 0 then 0 else base`: every column sits at
common height `base` except the reserved well at column 0. This is exactly the `w := 0`
instance of `isLevelPocketBandAt_flat`, so the dispatcher's INPUT surface already satisfies
the carrier predicate `IsLevelPocketBandAt std 2 base` before any piece is placed. This is the
re-entry hook: it certifies that the surface a fresh bag begins on is a genuine band member,
closing the gap between the existential dispatcher inputs and the structural carrier. -/
theorem isLevelPocketBandAt_flatShelf_input {base : ℕ}
    (hcap : base + 2 ≤ GameConfig.standard.rows) :
    IsLevelPocketBandAt GameConfig.standard 2 base
      (skyline GameConfig.standard (fun j => if j = 0 then 0 else base)) :=
  isLevelPocketBandAt_flat (w := 0) (by decide) (by decide) hcap

/-- **The S-notch canonical input surface is itself a pocket band at floor `base`.**
The canonical input surface used by the per-bag dispatcher for the `S` piece is the notched
shelf `fun j => if j = 0 then 0 else if j = 3 then base + 1 else base`: every column sits at
common height `base` except the reserved well at column 0 (height 0) and the unit landing bump
at column 3 (height `base + 1`). Reading column 0 as the well, columns 4 through 7 as the level
pocket, and the single bump as a spread 1 excursion shows this surface already satisfies
`IsLevelPocketBandAt std 1 base` before the `S` piece lands. This is the S-phase analogue of
`isLevelPocketBandAt_flatShelf_input`, extending the re-entry hook (canonical dispatcher inputs
are genuine band members) from the flat-landing pieces to the staircase `S` phase. -/
theorem isLevelPocketBandAt_Snotch_input {base : ℕ}
    (hcap : base + 1 ≤ GameConfig.standard.rows) :
    IsLevelPocketBandAt GameConfig.standard 1 base
      (skyline GameConfig.standard
        (fun j => if j = 0 then 0 else if j = 3 then base + 1 else base)) := by
  refine ⟨fun j => if j = 0 then 0 else if j = 3 then base + 1 else base, 0, 4, rfl,
    by decide, ?_, ?_, hcap, by decide, by decide, by decide, by decide, by decide,
    ?_, ?_, ?_, ?_⟩
  · simp
  · intro j hj hjw
    rcases eq_or_ne j 3 with rfl | hj3
    · simp
    · simp only [if_neg hjw, if_neg hj3]; omega
  · simp
  · simp
  · simp
  · simp

/-- **The Z-notch canonical input surface is itself a pocket band at floor `base`.**
The mirror of `isLevelPocketBandAt_Snotch_input`. The canonical input surface used by the
per-bag dispatcher for the `Z` piece is the notched shelf
`fun j => if j = 0 then 0 else if j = 1 then base + 1 else base`: common height `base` except
the reserved well at column 0 (height 0) and the unit landing bump at column 1 (height
`base + 1`). Reading column 0 as the well, columns 4 through 7 as the level pocket, and the
single bump as a spread 1 excursion shows this surface already satisfies
`IsLevelPocketBandAt std 1 base` before the `Z` piece lands. With this the trio of canonical
dispatcher inputs — flat shelf, S-notch, Z-notch — are all certified band members, completing
the re-entry-input layer of the multi-shape carrier. -/
theorem isLevelPocketBandAt_Znotch_input {base : ℕ}
    (hcap : base + 1 ≤ GameConfig.standard.rows) :
    IsLevelPocketBandAt GameConfig.standard 1 base
      (skyline GameConfig.standard
        (fun j => if j = 0 then 0 else if j = 1 then base + 1 else base)) := by
  refine ⟨fun j => if j = 0 then 0 else if j = 1 then base + 1 else base, 0, 4, rfl,
    by decide, ?_, ?_, hcap, by decide, by decide, by decide, by decide, by decide,
    ?_, ?_, ?_, ?_⟩
  · simp
  · intro j hj hjw
    rcases eq_or_ne j 1 with rfl | hj1
    · simp
    · simp only [if_neg hjw, if_neg hj1]; omega
  · simp
  · simp
  · simp
  · simp

/-- **Floor-exposing well clear from a flat profile lands at the lowered floor.**
The floor-exposing analogue of `isLevelPocketBand_vertI_well_of_flat`. On a flat profile
at common height `base ≥ 4` with empty well `w`, dropping a vertical `I` into the well
completes and clears four full rows, dropping every non-well column to `base - 4`; the
re-flattened surface is then a floor-exposing band at the STATICALLY KNOWN floor `base - 4`
(via `isLevelPocketBandAt_flat`). This is the composite that closes the re-flatten then
regenerate cycle on the floor-exposing carrier: it pairs with the floor-down regulator
`isLevelPocketBandAt_vertI_iter` to track the exact floor across the once-per-bag well
clear, rather than the existentially hidden floor of the `IsLevelPocketBand` version. -/
theorem isLevelPocketBandAt_vertI_well_of_flat {cfg : GameConfig} {spread base w : ℕ}
    (hw : w < cfg.cols) (h8 : 8 ≤ cfg.cols) (hbase4 : 4 ≤ base)
    (hcap : base - 4 + spread ≤ cfg.rows) :
    IsLevelPocketBandAt cfg spread (base - 4)
      (Placement.applyStep cfg
        (skyline cfg (fun j => if j = w then 0 else base))
        { piece := Piece.I, rot := 1, col := w }) := by
  have hwell : (fun j => if j = w then 0 else base) w = 0 := by
    show (if w = w then 0 else base) = 0; rw [if_pos rfl]
  have hothers : ∀ j, j < cfg.cols → j ≠ w →
      4 ≤ (fun j => if j = w then 0 else base) j := by
    intro j hj hjw; show 4 ≤ (if j = w then 0 else base); rw [if_neg hjw]; exact hbase4
  rw [applyStep_vertI_well hw hwell hothers]
  have hprofile : (fun j => if j = w then 0 else (fun j => if j = w then 0 else base) j - 4)
      = (fun j => if j = w then 0 else base - 4) := by
    funext j; by_cases hjw : j = w
    · simp [hjw]
    · simp [hjw]
  rw [hprofile]
  exact isLevelPocketBandAt_flat hw h8 hcap

/-- **The inverse of the well-clear: a single vert-I fill raises one column and grows the
spread while pinning the exposed floor.** Where `isLevelPocketBandAt_vertI_well_of_flat` drains a
flat shelf (lowering the floor by `4`), this *fills*: dropping a vertical `I` into a non-well,
non-pocket column `c ≥ 5` of the canonical flat shelf (well at `0`, every other column at `base`)
raises exactly column `c` to `base + 4` and completes no row, so the surface remains a level pocket
band at the *same* exposed floor `base` — now with spread `4` (pocket fixed at columns `1..4`, which
`c ≥ 5` cannot disturb). This is the floor-residue re-entry atom: the deliberate spread-RAISING fill
the spread-2 absorption bricks never perform, the per-column step a fill phase iterates to lift every
non-well column toward `≥ 4` so the terminal well-`I` (`isLevelPocketBandAt_vertI_well_of_flat`) can
re-fire from a residue floor. Floor is tracked exactly, so the fill/drain ledger stays closed. -/
theorem isLevelPocketBandAt_flatShelf_vertI_fill {base c : ℕ}
    (hc5 : 5 ≤ c) (hc : c < GameConfig.standard.cols)
    (hcap : base + 4 ≤ GameConfig.standard.rows) :
    IsLevelPocketBandAt GameConfig.standard 4 base
      (Placement.applyStep GameConfig.standard
        (skyline GameConfig.standard (fun j => if j = 0 then 0 else base))
        { piece := Piece.I, rot := 1, col := c }) := by
  have hbc : (if c = 0 then (0:ℕ) else base) = base := if_neg (by omega)
  rw [applyStep_vertI_skyline_noclear (w := 0) hc (by decide) (by omega) (by simp), hbc]
  refine ⟨Function.update (fun j => if j = 0 then 0 else base) c (base + 4), 0, 1, rfl,
    by decide, ?_, ?_, hcap, by decide, by decide, by decide, by decide, by decide,
    ?_, ?_, ?_, ?_⟩
  · simp [Function.update_of_ne (show (0:ℕ) ≠ c by omega)]
  · intro j hj hj0
    rcases eq_or_ne j c with rfl | hjc
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjc]; simp only [if_neg hj0]; omega
  · rw [Function.update_of_ne (show (1:ℕ) ≠ c by omega)]; simp
  · rw [Function.update_of_ne (show (2:ℕ) ≠ c by omega)]; simp
  · rw [Function.update_of_ne (show (3:ℕ) ≠ c by omega)]; simp
  · rw [Function.update_of_ne (show (4:ℕ) ≠ c by omega)]; simp

/-- **The vert-I fill survives (every fill step is non-lost).** The survival certificate paired
with `isLevelPocketBandAt_flatShelf_vertI_fill`: the board after the fill is a level pocket band, so
it is a spread-bounded reserved-well skyline, so it is not a top-out. This is the fill analogue of
`isLevelPocketBandAt_vertI_descends_safe` (the drain's survival cert), and it is load-bearing rather
than decorative — the bag-indexed step obligation `hP_step` of `tetrisSolvableValid_of_strategy_bagInvariant`
demands `¬ isLost` at *every* placement the strategy makes, so a fill phase that iterates this atom needs
each intermediate fill certified safe. -/
theorem isLevelPocketBandAt_flatShelf_vertI_fill_safe {base c : ℕ}
    (hc5 : 5 ≤ c) (hc : c < GameConfig.standard.cols)
    (hcap : base + 4 ≤ GameConfig.standard.rows) :
    ¬ Board.isLost GameConfig.standard
      (Placement.applyStep GameConfig.standard
        (skyline GameConfig.standard (fun j => if j = 0 then 0 else base))
        { piece := Piece.I, rot := 1, col := c }) :=
  not_isLost_of_isSpreadBoundedRWSkyline
    (isSpreadBoundedRWSkyline_of_isLevelPocketBand
      (isLevelPocketBand_of_isLevelPocketBandAt
        (isLevelPocketBandAt_flatShelf_vertI_fill hc5 hc hcap)))

/-- **Board-shape core of the repack raise: the seven-piece repack fold lands the flat shelf at
floor `base` exactly on the flat shelf at floor `base + 4`.** This is the raw computational identity
underlying `isLevelPocketBandAt_flatShelf_repack_raise` — factored out as a standalone reusable
brick because every downstream raise composite (the raise then well-drain cycle, the per-prefix
survival certificates) needs to know the post-repack *board*, not merely that it is a band. Three
`O` pairs on the disjoint pairs `(1,2)`, `(3,4)`, `(5,6)` (two `O`s each raise their pair by `4`)
then three vertical `I`s on the tail columns `7`, `8`, `9` (`q = 1`, each raises its column by `4`)
move all nine non-well columns `1..9` uniformly from `base` to `base + 4` while column `0` stays at
height `0`. Recipe: `foldl_append_skyline_compose` splits the fold at the O and vertical-I boundary,
the width-6 O shape lemma lands the leading fold on the six-fold update profile, the width-3
vertical-I shape lemma lifts the tail, and `skyline_congr` collapses the nested-update endpoint to
the literal flat profile (the two spellings agree on every in-field column `j < 10`, differing only
on the irrelevant out-of-field columns). -/
theorem foldl_repack_raise_eq_flatShelf {base : ℕ} :
    List.foldl (Placement.applyStep GameConfig.standard)
        (skyline GameConfig.standard (fun j => if j = 0 then 0 else base))
        ((List.replicate 2 { piece := Piece.O, rot := 0, col := 1 } ++
          List.replicate 2 { piece := Piece.O, rot := 0, col := 3 } ++
          List.replicate 2 { piece := Piece.O, rot := 0, col := 5 }) ++
         (List.replicate 1 { piece := Piece.I, rot := 1, col := 7 } ++
          List.replicate 1 { piece := Piece.I, rot := 1, col := 8 } ++
          List.replicate 1 { piece := Piece.I, rot := 1, col := 9 }))
      = skyline GameConfig.standard (fun j => if j = 0 then 0 else base + 4) := by
  rw [foldl_append_skyline_compose
      (applyStep_O_replicate_three_disjoint_skyline_noclear
        (h := fun j => if j = 0 then 0 else base) (c := 1) (w := 0) (m := 2)
        (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp)
        (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
        (by simp))
      (applyStep_vertI_replicate_three_disjoint_skyline_noclear
        (c := 7) (w := 0) (m := 1)
        (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
        (by simp only [Function.update_apply]; split_ifs <;> omega))]
  exact skyline_congr (by
    intro j hj
    simp only [GameConfig.standard_cols] at hj
    interval_cases j <;> simp [Function.update_apply])

/-- **Uniform repack raise: the flat shelf at floor `base` is lifted by exactly 4 to the flat
shelf at floor `base + 4`.** This is the floor-residue re-entry brick (the genuine `#66` content):
a single vertical-I dropped in the well only clears when *every* non-well column is already `≥ 4`,
so to re-enable draining from a residue floor the whole shelf must first be raised by a full unit.
The repack tile does it in one fold of seven pieces over the reserved well at column 0 — three
`O` pairs on the disjoint pairs `(1,2)`, `(3,4)`, `(5,6)` (two `O`s each, `p = 2`, raising each
column by `2p = 4`) followed by three vertical `I`s on the tail columns `7`, `8`, `9` (`q = 1`,
raising each by `4q = 4`). Nothing clears (the well stays empty), so all nine non-well columns
`1..9` move uniformly from `base` to `base + 4` while column 0 stays at height 0: exactly the flat
shelf `fun j => if j = 0 then 0 else base + 4`. Composition recipe: `foldl_append_skyline_compose`
splits the fold at the O and vertical-I boundary, the width-6 O shape lemma lands the leading fold
on the six-fold profile, the width-3 vertical-I shape lemma lifts the tail, and `skyline_congr`
collapses the nested-update endpoint to the literal flat profile (the two spellings agree on every
in-field column `j < 10`, differing only on the irrelevant out-of-field columns). The result reads
off `isLevelPocketBandAt_flatShelf_input` at the new floor. With this raise in hand,
`isLevelPocketBandAt_vertI_well_of_flat` can drain from *any* residue floor: raise to a multiple of
4, then drain — closing the floor-residue re-entry loop that blocks `isLevelPocketBandAt_vertI_descends`
at non-multiple floors. -/
theorem isLevelPocketBandAt_flatShelf_repack_raise {base : ℕ}
    (hcap : base + 6 ≤ GameConfig.standard.rows) :
    IsLevelPocketBandAt GameConfig.standard 2 (base + 4)
      (List.foldl (Placement.applyStep GameConfig.standard)
        (skyline GameConfig.standard (fun j => if j = 0 then 0 else base))
        ((List.replicate 2 { piece := Piece.O, rot := 0, col := 1 } ++
          List.replicate 2 { piece := Piece.O, rot := 0, col := 3 } ++
          List.replicate 2 { piece := Piece.O, rot := 0, col := 5 }) ++
         (List.replicate 1 { piece := Piece.I, rot := 1, col := 7 } ++
          List.replicate 1 { piece := Piece.I, rot := 1, col := 8 } ++
          List.replicate 1 { piece := Piece.I, rot := 1, col := 9 }))) := by
  rw [foldl_repack_raise_eq_flatShelf]
  exact isLevelPocketBandAt_flatShelf_input (by omega)

/-- **The raise then well-drain closed cycle: the flat shelf returns to its own floor while
clearing four full rows.** Composes the seven-piece repack raise with one terminal vertical `I`
dropped into the reserved well. The raise lifts every non-well column `1..9` from `base` to
`base + 4` (`foldl_repack_raise_eq_flatShelf`); the well column `0` is then full-height-4 short of
all nine neighbours, so the terminal well `I` completes four full rows and clears them
(`isLevelPocketBandAt_vertI_well_of_flat`), dropping every column back by `4`: the surface lands
back on the flat shelf at the original floor `base`. The net surface change is zero, yet four lines
were cleared — a genuine line-clearing half-cycle that, crucially, works from *any* floor including a
residue floor `base` that is not a multiple of `4` (the raise manufactures the multiple-of-4 fill the
bare `isLevelPocketBandAt_vertI_descends` cannot reach). This is the re-entry hinge of the
floor-residue obstruction: rather than draining a residue directly (impossible — a well `I` clears
only when every neighbour is already `≥ 4`), raise first, then drain. The floor arithmetic
`base + 4 - 4 = base` closes by `Nat.add_sub_cancel`. -/
theorem isLevelPocketBandAt_flatShelf_repack_raise_drain {base : ℕ}
    (hcap : base + 6 ≤ GameConfig.standard.rows) :
    IsLevelPocketBandAt GameConfig.standard 2 base
      (Placement.applyStep GameConfig.standard
        (List.foldl (Placement.applyStep GameConfig.standard)
          (skyline GameConfig.standard (fun j => if j = 0 then 0 else base))
          ((List.replicate 2 { piece := Piece.O, rot := 0, col := 1 } ++
            List.replicate 2 { piece := Piece.O, rot := 0, col := 3 } ++
            List.replicate 2 { piece := Piece.O, rot := 0, col := 5 }) ++
           (List.replicate 1 { piece := Piece.I, rot := 1, col := 7 } ++
            List.replicate 1 { piece := Piece.I, rot := 1, col := 8 } ++
            List.replicate 1 { piece := Piece.I, rot := 1, col := 9 })))
        { piece := Piece.I, rot := 1, col := 0 }) := by
  rw [foldl_repack_raise_eq_flatShelf]
  have hdrain := isLevelPocketBandAt_vertI_well_of_flat
    (cfg := GameConfig.standard) (spread := 2) (base := base + 4) (w := 0)
    (by decide) (by decide) (by omega) (by omega)
  rw [Nat.add_sub_cancel] at hdrain
  exact hdrain

/-- **Every transient prefix of the repack-raise peaks at most at `base + 4`.** Specializes the
well-empty per-prefix surface bound `maxColHeight_foldl_take_le_foldl_of_well_empty` to the concrete
seven-piece repack-raise fold over the reserved well at column 0. The full fold lands the flat shelf
at floor `base` exactly on the flat shelf at floor `base + 4` (`foldl_repack_raise_eq_flatShelf`),
whose surface potential is exactly `base + 4`. Since every repack placement dodges the well (all nine
sit at columns `1..9`) and the well starts empty, nothing clears mid-fold, so every prefix board
embeds height-wise into that endpoint. Hence no matter where the adversary's bag boundary falls
inside the raise, the transient skyline never exceeds `base + 4` — the tight every-step ceiling the
cycle's per-prefix not-lost obligation needs (paired with a slack `base + 4 ≤ rows` it yields
`¬ isLost` at each placement, feeding `hP_step`). No `rows` hypothesis is required: the bound reads
straight off the profile, independent of clamping. -/
theorem maxColHeight_foldl_take_repack_raise_le {base : ℕ} (n : ℕ) :
    maxColHeight GameConfig.standard
      (((List.replicate 2 { piece := Piece.O, rot := 0, col := 1 } ++
         List.replicate 2 { piece := Piece.O, rot := 0, col := 3 } ++
         List.replicate 2 { piece := Piece.O, rot := 0, col := 5 }) ++
        (List.replicate 1 { piece := Piece.I, rot := 1, col := 7 } ++
         List.replicate 1 { piece := Piece.I, rot := 1, col := 8 } ++
         List.replicate 1 { piece := Piece.I, rot := 1, col := 9 }) : List Placement).take n
        |>.foldl (Placement.applyStep GameConfig.standard)
          (skyline GameConfig.standard (fun j => if j = 0 then 0 else base)))
      ≤ base + 4 := by
  have hprefix := maxColHeight_foldl_take_le_foldl_of_well_empty
    (cfg := GameConfig.standard) (h := fun j => if j = 0 then 0 else base) (w := 0)
    (by decide) (by simp)
    ((List.replicate 2 { piece := Piece.O, rot := 0, col := 1 } ++
      List.replicate 2 { piece := Piece.O, rot := 0, col := 3 } ++
      List.replicate 2 { piece := Piece.O, rot := 0, col := 5 }) ++
     (List.replicate 1 { piece := Piece.I, rot := 1, col := 7 } ++
      List.replicate 1 { piece := Piece.I, rot := 1, col := 8 } ++
      List.replicate 1 { piece := Piece.I, rot := 1, col := 9 }) : List Placement)
    (by decide) n
  have hend : maxColHeight GameConfig.standard
      (((List.replicate 2 { piece := Piece.O, rot := 0, col := 1 } ++
         List.replicate 2 { piece := Piece.O, rot := 0, col := 3 } ++
         List.replicate 2 { piece := Piece.O, rot := 0, col := 5 }) ++
        (List.replicate 1 { piece := Piece.I, rot := 1, col := 7 } ++
         List.replicate 1 { piece := Piece.I, rot := 1, col := 8 } ++
         List.replicate 1 { piece := Piece.I, rot := 1, col := 9 }) : List Placement).foldl
          (Placement.applyStep GameConfig.standard)
          (skyline GameConfig.standard (fun j => if j = 0 then 0 else base)))
      ≤ base + 4 := by
    rw [foldl_repack_raise_eq_flatShelf]
    exact maxColHeight_skyline_le_of_forall (by intro j _; split_ifs <;> omega)
  exact le_trans hprefix hend

/-- **Tight per-prefix non-loss certificate for the repack-raise.** Every prefix of the
seven-piece repack-raise schedule over the empty well at column 0, dropped on the flat shelf at
floor `base`, stays un-lost under the tight headroom `base + 4 ≤ rows`. This is the survival
companion to the prefix-peak bound `maxColHeight_foldl_take_repack_raise_le`: feed that
`maxColHeight ≤ base + 4` ceiling through the scalar non-loss bridge `not_isLost_of_maxColHeight_le`
(whose well-formedness obligation discharges by `foldl_applyStep_wf` over the skyline base, valid
placements by `decide`), then slack the ceiling to `rows` via `hcap`. Strictly sharper than the
generic `not_isLost_take_applyStep_O_vertI_repack_skyline`, which charges the lossy
`base + 12 p + 12 q` (here `base + 36`) because it bounds each drop by four with no well-clear
credit. The empty-well argument behind the iter202 bound recovers the entire `+32`: nothing
clears mid-fold yet every prefix still embeds height-wise into the `base + 4` endpoint, so the
every-step survival obligation that feeds `hP_step` needs only one well of headroom, not nine. -/
theorem not_isLost_foldl_take_repack_raise {base : ℕ} (n : ℕ)
    (hcap : base + 4 ≤ GameConfig.standard.rows) :
    ¬ Board.isLost GameConfig.standard
        (((List.replicate 2 { piece := Piece.O, rot := 0, col := 1 } ++
           List.replicate 2 { piece := Piece.O, rot := 0, col := 3 } ++
           List.replicate 2 { piece := Piece.O, rot := 0, col := 5 }) ++
          (List.replicate 1 { piece := Piece.I, rot := 1, col := 7 } ++
           List.replicate 1 { piece := Piece.I, rot := 1, col := 8 } ++
           List.replicate 1 { piece := Piece.I, rot := 1, col := 9 }) : List Placement).take n
            |>.foldl (Placement.applyStep GameConfig.standard)
              (skyline GameConfig.standard (fun j => if j = 0 then 0 else base))) := by
  have hvalid : ∀ pl ∈ ((List.replicate 2 { piece := Piece.O, rot := 0, col := 1 } ++
      List.replicate 2 { piece := Piece.O, rot := 0, col := 3 } ++
      List.replicate 2 { piece := Piece.O, rot := 0, col := 5 }) ++
     (List.replicate 1 { piece := Piece.I, rot := 1, col := 7 } ++
      List.replicate 1 { piece := Piece.I, rot := 1, col := 8 } ++
      List.replicate 1 { piece := Piece.I, rot := 1, col := 9 }) : List Placement),
      pl.Valid GameConfig.standard := by decide
  refine not_isLost_of_maxColHeight_le
    (foldl_applyStep_wf _ (fun p hp => ((mem_skyline' _ _ p).mp hp).1)
      (fun pl hpl => hvalid pl (List.take_subset n _ hpl)))
    (le_trans (maxColHeight_foldl_take_repack_raise_le n) hcap)

/-- **Every step of one full raise then drain cycle stays un-lost.** The unified per-prefix
survival certificate for the closed cycle `flatShelf@base → (9-piece repack raise) → flatShelf@(base+4)
→ (1 vertical-I well-clear) → flatShelf@base`, presented as one ten-placement schedule
`REPACK ++ [vertI@well]`. For any prefix length `n`: if `n ≤ 9` the prefix never reaches the drain, so
the board is a raise prefix and `not_isLost_foldl_take_repack_raise` certifies it (the empty-well
embedding pins the transient peak at `base + 4`); if `n ≥ 10` the prefix is the whole cycle, whose
endpoint is the post-drain flat shelf back at floor `base` — a level pocket band by
`isLevelPocketBandAt_flatShelf_repack_raise_drain`, hence un-lost by `isLevelPocketBandAt_not_isLost`.
The two faces meet with no gap (`n ≤ 9` and `10 ≤ n` partition `ℕ`), so the strategy that plays this
cycle on repeat keeps the board un-lost at *every* placement it makes — exactly the every-step
obligation `hP_step` of `tetrisSolvableValid_of_strategy_bagInvariant` demands of the flat-shelf bag
phase, now discharged across a genuine line-clearing cycle rather than a single noclear bag. The
headroom is `base + 6 ≤ rows` (the raise reaches `base + 4`, the drain's intermediate fill the band cap
`base + 2` over the spread-2 endpoint). -/
theorem not_isLost_foldl_take_repack_raise_drain {base : ℕ} (n : ℕ)
    (hcap : base + 6 ≤ GameConfig.standard.rows) :
    ¬ Board.isLost GameConfig.standard
        ((((List.replicate 2 { piece := Piece.O, rot := 0, col := 1 } ++
            List.replicate 2 { piece := Piece.O, rot := 0, col := 3 } ++
            List.replicate 2 { piece := Piece.O, rot := 0, col := 5 }) ++
           (List.replicate 1 { piece := Piece.I, rot := 1, col := 7 } ++
            List.replicate 1 { piece := Piece.I, rot := 1, col := 8 } ++
            List.replicate 1 { piece := Piece.I, rot := 1, col := 9 })) ++
          [{ piece := Piece.I, rot := 1, col := 0 }] : List Placement).take n
            |>.foldl (Placement.applyStep GameConfig.standard)
              (skyline GameConfig.standard (fun j => if j = 0 then 0 else base))) := by
  rcases Nat.lt_or_ge n 10 with hn | hn
  · rw [List.take_append_of_le_length
        (by simp only [List.length_append, List.length_replicate]; omega)]
    exact not_isLost_foldl_take_repack_raise n (by omega)
  · rw [List.take_of_length_le
        (by simp only [List.length_append, List.length_replicate, List.length_cons,
          List.length_nil]; omega),
      List.foldl_append, List.foldl_cons, List.foldl_nil]
    exact isLevelPocketBandAt_not_isLost (isLevelPocketBandAt_flatShelf_repack_raise_drain hcap)

/-- **Net-zero board identity of one full raise∘drain cycle.** Folding the entire ten-placement
cycle `REPACK ++ [vertI@well]` over the flat shelf at floor `base` returns *literally* the flat
shelf at floor `base` — board-level equality, not merely a level-pocket-band predicate. The raise
half lifts every non-well column `1..9` from `base` to `base + 4` while the well stays empty
(`foldl_repack_raise_eq_flatShelf`, a board identity); the terminal vertical `I` then fills the
empty well, completing rows `0..3` across the whole field (all nine neighbours sit at
`base + 4 ≥ 4`), so `applyStep_vertI_well` clears those four rows and drops every neighbour by `4`,
landing the well-empty profile `if j = 0 then 0 else (base + 4) - 4 = base` — exactly the starting
flat shelf. No `rows` hypothesis is needed: the identity is purely about *where* material lands, not
about loss. This is the fixed-point fact the unbounded iterate rides on: a strategy that plays this
cycle on repeat returns to the same board after every pass, so `not_isLost_foldl_take_repack_raise_drain`
(every-step survival of one pass) lifts by induction on the pass count to every-step survival of
arbitrarily many passes — the form `hP_step` of `tetrisSolvableValid_of_strategy_bagInvariant`
consumes over an infinite horizon. -/
theorem foldl_cycle_eq_flatShelf {base : ℕ} :
    List.foldl (Placement.applyStep GameConfig.standard)
        (skyline GameConfig.standard (fun j => if j = 0 then 0 else base))
        ((((List.replicate 2 { piece := Piece.O, rot := 0, col := 1 } ++
            List.replicate 2 { piece := Piece.O, rot := 0, col := 3 } ++
            List.replicate 2 { piece := Piece.O, rot := 0, col := 5 }) ++
           (List.replicate 1 { piece := Piece.I, rot := 1, col := 7 } ++
            List.replicate 1 { piece := Piece.I, rot := 1, col := 8 } ++
            List.replicate 1 { piece := Piece.I, rot := 1, col := 9 })) ++
          [{ piece := Piece.I, rot := 1, col := 0 }] : List Placement))
      = skyline GameConfig.standard (fun j => if j = 0 then 0 else base) := by
  rw [List.foldl_append, foldl_repack_raise_eq_flatShelf, List.foldl_cons, List.foldl_nil,
    applyStep_vertI_well (h := fun j => if j = 0 then 0 else base + 4) (w := 0)
      (by decide) (by simp) (fun j hj hjw => by simp only [if_neg hjw]; omega)]
  congr 1
  funext j
  by_cases hj0 : j = 0
  · subst hj0; simp
  · simp only [if_neg hj0]; omega

/-- **Every-step survival of an iterated fixed-point cycle (generic combinator).** Let `cyc` be any
placement schedule that, folded over a board `b0`, returns to `b0` (a *fixed point*, `hfix`), is
itself not a lost board (`hb0`), and whose every prefix folded from `b0` stays un-lost (`hcyc`).
Then *every* prefix of the `k`-fold repetition `(List.replicate k cyc).flatten` — the schedule that
plays `cyc` over and over `k` times — folded from `b0` stays un-lost, for all `k` and all prefix
lengths `n`. This is the pure list-combinatorics core of lifting a single-pass every-step survival
certificate to an arbitrary-horizon one: induct on `k`; the base `k = 0` is the empty schedule
landing on `b0` (`hb0`); the step splits `(cyc ++ cycᵏ).take n` with `List.take_append`. If
`n < cyc.length` the tail `take (n - cyc.length)` is empty (`Nat.sub_eq_zero_of_le`), collapsing to
a single-cycle prefix (`hcyc n`); if `n ≥ cyc.length` the head `cyc.take n` is all of `cyc`
(`List.take_of_length_le`), whose fold returns to `b0` (`hfix`), reducing the remainder to the
induction hypothesis at `n - cyc.length`. No tetris content is used — only that `cyc` is a fixed
point with per-prefix survival — so this combinator discharges the infinite-horizon `hP_step`
obligation for any line-clearing cycle once its one-pass facts are in hand. -/
theorem not_isLost_foldl_take_flatten_replicate {cfg : GameConfig} {b0 : Board}
    {cyc : List Placement}
    (hb0 : ¬ Board.isLost cfg b0)
    (hfix : List.foldl (Placement.applyStep cfg) b0 cyc = b0)
    (hcyc : ∀ n, ¬ Board.isLost cfg
      (List.foldl (Placement.applyStep cfg) b0 (cyc.take n)))
    (k n : ℕ) :
    ¬ Board.isLost cfg
      (List.foldl (Placement.applyStep cfg) b0 ((List.replicate k cyc).flatten.take n)) := by
  induction k generalizing n with
  | zero =>
    simp only [List.replicate_zero, List.flatten_nil, List.take_nil, List.foldl_nil]
    exact hb0
  | succ k ih =>
    rw [List.replicate_succ, List.flatten_cons, List.take_append, List.foldl_append]
    rcases Nat.lt_or_ge n cyc.length with hn | hn
    · rw [Nat.sub_eq_zero_of_le hn.le, List.take_zero, List.foldl_nil]
      exact hcyc n
    · rw [List.take_of_length_le hn, hfix]
      exact ih (n - cyc.length)

/-- **Every step of the unbounded raise∘drain iterate stays un-lost.** The infinite-horizon lift of
`not_isLost_foldl_take_repack_raise_drain`: for *every* number of cycles `k` and *every* prefix
length `n`, folding the first `n` placements of the `k`-fold repeated cycle
`(List.replicate k CYCLE).flatten` (where `CYCLE = REPACK ++ [vertI@well]`) from the flat shelf at
floor `base` never tops out. So the strategy that plays the line-clearing raise∘drain cycle forever
keeps the board un-lost at every single placement, for arbitrarily many bags. Discharged in one shot
by the generic fixed-point combinator `not_isLost_foldl_take_flatten_replicate`, fed the three
one-pass facts already in hand: the flat shelf is not lost (`isLevelPocketBandAt_flatShelf_input` via
`isLevelPocketBandAt_not_isLost`), the full cycle is a board fixed point (`foldl_cycle_eq_flatShelf`,
iter205), and every prefix of one cycle survives (`not_isLost_foldl_take_repack_raise_drain`,
iter204). The headroom is the same `base + 6 ≤ rows` the single cycle needs — because every pass
returns to floor `base`, the height never accumulates across cycles, so one well of slack suffices
forever. This is the every-step, all-horizons survival certificate the `hP_step` obligation of
`tetrisSolvableValid_of_strategy_bagInvariant` demands of the flat-shelf bag phase. -/
theorem not_isLost_foldl_take_cycle_iterate {base : ℕ} (k n : ℕ)
    (hcap : base + 6 ≤ GameConfig.standard.rows) :
    ¬ Board.isLost GameConfig.standard
        ((List.replicate k (((List.replicate 2 { piece := Piece.O, rot := 0, col := 1 } ++
            List.replicate 2 { piece := Piece.O, rot := 0, col := 3 } ++
            List.replicate 2 { piece := Piece.O, rot := 0, col := 5 }) ++
           (List.replicate 1 { piece := Piece.I, rot := 1, col := 7 } ++
            List.replicate 1 { piece := Piece.I, rot := 1, col := 8 } ++
            List.replicate 1 { piece := Piece.I, rot := 1, col := 9 })) ++
          [{ piece := Piece.I, rot := 1, col := 0 }] : List Placement)).flatten.take n
            |>.foldl (Placement.applyStep GameConfig.standard)
              (skyline GameConfig.standard (fun j => if j = 0 then 0 else base))) :=
  not_isLost_foldl_take_flatten_replicate
    (isLevelPocketBandAt_not_isLost (isLevelPocketBandAt_flatShelf_input (by omega)))
    foldl_cycle_eq_flatShelf
    (fun n => not_isLost_foldl_take_repack_raise_drain n hcap)
    k n

/-- **Iterating a fixed-point cycle returns to the start exactly (generic combinator).** If folding
the placement schedule `cyc` over a board `b0` lands back on `b0` (a fixed point, `hfix`), then
folding `k` back-to-back copies of `cyc` — the flattened `List.replicate k cyc` — also lands on
`b0`, for every `k`. The endpoint companion to `not_isLost_foldl_take_flatten_replicate`: that lemma
certifies every prefix of the infinite repeat stays un-lost, this one pins the endpoint after each
whole number of cycles to the literal starting board, so the repeated play is genuinely periodic — a
closed loop in board space — not merely bounded. Induction on `k`: the base `k = 0` is the empty fold
landing on `b0`; the successor splits `(cyc ++ cycᵏ)` with `List.foldl_append`, collapses the leading
`cyc` via `hfix`, and finishes with the induction hypothesis. No tetris content is used. -/
theorem foldl_flatten_replicate_eq_of_fix {cfg : GameConfig} {b0 : Board}
    {cyc : List Placement}
    (hfix : List.foldl (Placement.applyStep cfg) b0 cyc = b0)
    (k : ℕ) :
    List.foldl (Placement.applyStep cfg) b0 (List.replicate k cyc).flatten = b0 := by
  induction k with
  | zero => simp only [List.replicate_zero, List.flatten_nil, List.foldl_nil]
  | succ k ih =>
    rw [List.replicate_succ, List.flatten_cons, List.foldl_append, hfix]
    exact ih

/-- **The raise and drain CYCLE is a closed loop on the flat shelf.** Specialising
`foldl_flatten_replicate_eq_of_fix` to the canonical net-zero CYCLE — the nine-piece repack-raise
followed by the well-clearing vertical `I`, whose one-pass fixed point is `foldl_cycle_eq_flatShelf`:
folding `k` whole copies of the cycle over `flat@base` returns *literally* `flat@base`, for every `k`.
Paired with `not_isLost_foldl_take_cycle_iterate` (every prefix of the infinite repeat is un-lost)
this exhibits an honest period-ten closed cycle in board space anchored at `flat@base` — the surface
regulator a flat-shelf bag phase rides indefinitely, the closed-loop face of the infinite-horizon
survival the carrier route is assembling. -/
theorem foldl_flatten_replicate_cycle_eq_flatShelf {base : ℕ} (k : ℕ) :
    List.foldl (Placement.applyStep GameConfig.standard)
        (skyline GameConfig.standard (fun j => if j = 0 then 0 else base))
        ((List.replicate k (((List.replicate 2 { piece := Piece.O, rot := 0, col := 1 } ++
            List.replicate 2 { piece := Piece.O, rot := 0, col := 3 } ++
            List.replicate 2 { piece := Piece.O, rot := 0, col := 5 }) ++
           (List.replicate 1 { piece := Piece.I, rot := 1, col := 7 } ++
            List.replicate 1 { piece := Piece.I, rot := 1, col := 8 } ++
            List.replicate 1 { piece := Piece.I, rot := 1, col := 9 })) ++
          [{ piece := Piece.I, rot := 1, col := 0 }] : List Placement)).flatten)
      = skyline GameConfig.standard (fun j => if j = 0 then 0 else base) :=
  foldl_flatten_replicate_eq_of_fix foldl_cycle_eq_flatShelf k

/-- **First true closure brick for the band carrier: an O placement on a flat-top
takes it into a spread-2 band.** Dropping the O square onto two adjacent non-well
columns `c, c+1` of a flat top (`base` everywhere off the well) raises exactly those
two columns to `base + 2` while leaving the rest at `base`, so the resulting surface
sits in the band `[base, base+2]` — a genuine roughening that the flat-top carrier
could not absorb but the spread carrier can. This is the placement analogue of
`isReservedWellSkyline_applyStep_O`, landing in `IsSpreadBoundedRWSkyline cfg 2`
rather than collapsing back to a flat top. -/
theorem isSpreadBoundedRWSkyline_O_of_isFlatTop {cfg : GameConfig} {base w c : ℕ}
    (hc : c < cfg.cols) (hc1 : c + 1 < cfg.cols)
    (hw : w < cfg.cols) (hwc : w ≠ c) (hwc1 : w ≠ c + 1)
    (hslack : base + 2 ≤ cfg.rows) :
    IsSpreadBoundedRWSkyline cfg 2
      (Placement.applyStep cfg (skyline cfg (fun j => if j = w then 0 else base))
        { piece := Piece.O, rot := 0, col := c }) := by
  set h : ℕ → ℕ := fun j => if j = w then 0 else base with hh
  have hbase : h c = base := by rw [hh]; simp only [if_neg (Ne.symm hwc)]
  have hbase1 : h (c + 1) = base := by rw [hh]; simp only [if_neg (Ne.symm hwc1)]
  have heq : h c = h (c + 1) := by rw [hbase, hbase1]
  have hw0 : h w = 0 := by rw [hh]; simp
  rw [applyStep_O_skyline_noclear hc hc1 heq hw hwc hwc1 hw0]
  refine ⟨Function.update (Function.update h c (h c + 2)) (c + 1) (h c + 2), base, w,
    rfl, hw, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne hwc1, Function.update_of_ne hwc]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (c + 1) with rfl | hjc1'
    · rw [Function.update_self, hbase]; omega
    · rw [Function.update_of_ne hjc1']
      rcases eq_or_ne j c with rfl | hjc'
      · rw [Function.update_self, hbase]; omega
      · rw [Function.update_of_ne hjc']
        have hjb : h j = base := by rw [hh]; simp only [if_neg hjw]
        rw [hjb]; omega
  · exact hslack

/-- **Pocket regeneration (O on a standard flat top).** On the standard 10-wide flat top
with the reserved well at column 0 and every other column at height `base`, dropping an O
at column 1 raises columns 1 and 2 to `base + 2` while leaving columns 3 through 9 at
`base`. The result is a `IsLevelPocketBand` with floor `base`, well `0`, and a width-4
floor pocket at columns 3, 4, 5, 6. This is the first concrete fill that REGENERATES a
level pocket band rather than collapsing it to a bare spread band, supplying the
fill and back-to-pocket direction the σ-driven reachability carrier needs. -/
theorem isLevelPocketBand_O_flatTop_standard {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) :
    IsLevelPocketBand GameConfig.standard 2
      (Placement.applyStep GameConfig.standard
        (skyline GameConfig.standard (fun j => if j = 0 then 0 else base))
        { piece := Piece.O, rot := 0, col := 1 }) := by
  set h : ℕ → ℕ := fun j => if j = 0 then 0 else base with hh
  have hbase : h 1 = base := by rw [hh]; simp
  have hbase1 : h (1 + 1) = base := by rw [hh]; simp
  have heq : h 1 = h (1 + 1) := by rw [hbase, hbase1]
  have hw0 : h 0 = 0 := by rw [hh]; simp
  rw [applyStep_O_skyline_noclear (c := 1) (w := 0) (by decide) (by decide) heq
      (by decide) (by decide) (by decide) hw0, hbase]
  refine ⟨Function.update (Function.update h 1 (base + 2)) (1 + 1) (base + 2), base, 0, 3,
    rfl, by decide, ?_, ?_, ?_, by decide, by decide, by decide, by decide, by decide,
    ?_, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne (show (0:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (0:ℕ) ≠ 1 by decide)]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (1 + 1) with rfl | hjc1'
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjc1']
      rcases eq_or_ne j 1 with rfl | hjc'
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hjc']
        have hjb : h j = base := by rw [hh]; simp only [if_neg hjw]
        rw [hjb]; omega
  · exact hslack
  · rw [Function.update_of_ne (show (3:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (3:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (4:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (4:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (5:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (5:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (6:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (6:ℕ) ≠ 1 by decide), hh]; simp

/-- **Floor-exposing O fill on a standard flat top.** The floor-exposing analogue of
`isLevelPocketBand_O_flatTop_standard`. Dropping the O square onto columns `1, 2` of the
standard flat top (well at column 0, every other column at `base`) raises those two columns
to `base + 2` and leaves the rest at `base`, landing in a `IsLevelPocketBandAt standard 2 base`
band at the STATICALLY KNOWN floor `base`, with the width-4 pocket at columns `3, 4, 5, 6`.
The proof is identical to the hidden-floor version with the `base` floor witness dropped
(the floor-exposing predicate makes floor an explicit parameter). This is the first
per-piece roughening fill on the floor-exposing carrier — the up-side counterpart of the
floor-down regulator `isLevelPocketBandAt_vertI_iter`. -/
theorem isLevelPocketBandAt_O_flatTop_standard {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) :
    IsLevelPocketBandAt GameConfig.standard 2 base
      (Placement.applyStep GameConfig.standard
        (skyline GameConfig.standard (fun j => if j = 0 then 0 else base))
        { piece := Piece.O, rot := 0, col := 1 }) := by
  set h : ℕ → ℕ := fun j => if j = 0 then 0 else base with hh
  have hbase : h 1 = base := by rw [hh]; simp
  have hbase1 : h (1 + 1) = base := by rw [hh]; simp
  have heq : h 1 = h (1 + 1) := by rw [hbase, hbase1]
  have hw0 : h 0 = 0 := by rw [hh]; simp
  rw [applyStep_O_skyline_noclear (c := 1) (w := 0) (by decide) (by decide) heq
      (by decide) (by decide) (by decide) hw0, hbase]
  refine ⟨Function.update (Function.update h 1 (base + 2)) (1 + 1) (base + 2), 0, 3,
    rfl, by decide, ?_, ?_, ?_, by decide, by decide, by decide, by decide, by decide,
    ?_, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne (show (0:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (0:ℕ) ≠ 1 by decide)]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (1 + 1) with rfl | hjc1'
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjc1']
      rcases eq_or_ne j 1 with rfl | hjc'
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hjc']
        have hjb : h j = base := by rw [hh]; simp only [if_neg hjw]
        rw [hjb]; omega
  · exact hslack
  · rw [Function.update_of_ne (show (3:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (3:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (4:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (4:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (5:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (5:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (6:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (6:ℕ) ≠ 1 by decide), hh]; simp

/-- **Parametric-column O pocket regeneration on a standard flat top.** The column-flexible
generalisation of `isLevelPocketBandAt_O_flatTop_standard`: on the standard flat shelf (well at
column `0`, every other column at `base`), an `O` dropped at any column `oc` in the right block
(`5 ≤ oc`, `oc + 1 < cols`) raises columns `oc, oc+1` to `base + 2` while leaving columns
`1, 2, 3, 4` untouched at `base`, landing in `IsLevelPocketBandAt standard 2 base` with the
regenerated width-4 floor pocket fixed at columns `1, 2, 3, 4`. Where the hard-coded version
seats the `O` at column `1` and relocates the pocket to `3..6`, this seats the `O` anywhere in the
right block and reads the fresh pocket off the fixed left block — the column freedom a strategy
needs to place each flat piece away from the pocket it must preserve. -/
theorem isLevelPocketBandAt_O_flatTop_standard_at {base oc : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (hoc : 5 ≤ oc)
    (hoc1 : oc + 1 < GameConfig.standard.cols) :
    IsLevelPocketBandAt GameConfig.standard 2 base
      (Placement.applyStep GameConfig.standard
        (skyline GameConfig.standard (fun j => if j = 0 then 0 else base))
        { piece := Piece.O, rot := 0, col := oc }) := by
  set h : ℕ → ℕ := fun j => if j = 0 then 0 else base with hh
  have hoc0 : oc ≠ 0 := by omega
  have hbc : h oc = base := by rw [hh]; simp only [if_neg hoc0]
  have hbc1 : h (oc + 1) = base := by
    rw [hh]; simp only [if_neg (show ¬ (oc + 1 = 0) by omega)]
  have heq : h oc = h (oc + 1) := by rw [hbc, hbc1]
  have hw0 : h 0 = 0 := by rw [hh]; simp
  have hoclt : oc < GameConfig.standard.cols := by omega
  rw [applyStep_O_skyline_noclear (c := oc) (w := 0) hoclt hoc1 heq
      (by decide) (by omega) (by omega) hw0, hbc]
  refine ⟨Function.update (Function.update h oc (base + 2)) (oc + 1) (base + 2), 0, 1,
    rfl, by decide, ?_, ?_, ?_, by decide, by decide, by decide, by decide, by decide,
    ?_, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne (show (0:ℕ) ≠ oc + 1 by omega),
        Function.update_of_ne (show (0:ℕ) ≠ oc by omega)]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (oc + 1) with rfl | hjc1'
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjc1']
      rcases eq_or_ne j oc with rfl | hjc'
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hjc']
        have hjb : h j = base := by rw [hh]; simp only [if_neg hjw]
        rw [hjb]; omega
  · exact hslack
  · rw [Function.update_of_ne (show (1:ℕ) ≠ oc + 1 by omega),
        Function.update_of_ne (show (1:ℕ) ≠ oc by omega), hh]; simp
  · rw [Function.update_of_ne (show (1 + 1:ℕ) ≠ oc + 1 by omega),
        Function.update_of_ne (show (1 + 1:ℕ) ≠ oc by omega), hh]; simp
  · rw [Function.update_of_ne (show (1 + 2:ℕ) ≠ oc + 1 by omega),
        Function.update_of_ne (show (1 + 2:ℕ) ≠ oc by omega), hh]; simp
  · rw [Function.update_of_ne (show (1 + 3:ℕ) ≠ oc + 1 by omega),
        Function.update_of_ne (show (1 + 3:ℕ) ≠ oc by omega), hh]; simp

/-- **Parametric-column T pocket regeneration on a standard flat top.** The column-flexible
generalisation of `isLevelPocketBandAt_T_flatTop_standard`: on the standard flat shelf (well at
column `0`, every other column at `base`), a `T` (rotation `2`, flat base up) dropped at any
column `oc` in the right block (`5 ≤ oc`, `oc + 2 < cols`) raises columns `oc, oc+1, oc+2` to
`base + 1, base + 2, base + 1` while leaving columns `1, 2, 3, 4` untouched at `base`, landing in
`IsLevelPocketBandAt standard 2 base` with the regenerated width-4 floor pocket fixed at columns
`1, 2, 3, 4`. The T sibling of `isLevelPocketBandAt_O_flatTop_standard_at`: the column freedom a
strategy needs to seat the T away from the pocket it must preserve, reading the fresh pocket off
the fixed left block. -/
theorem isLevelPocketBandAt_T_flatTop_standard_at {base oc : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) (hoc : 5 ≤ oc)
    (hoc2 : oc + 2 < GameConfig.standard.cols) :
    IsLevelPocketBandAt GameConfig.standard 2 base
      (Placement.applyStep GameConfig.standard
        (skyline GameConfig.standard (fun j => if j = 0 then 0 else base))
        { piece := Piece.T, rot := 2, col := oc }) := by
  set h : ℕ → ℕ := fun j => if j = 0 then 0 else base with hh
  have hoc0 : oc ≠ 0 := by omega
  have hbc : h oc = base := by rw [hh]; simp only [if_neg hoc0]
  have hbc1 : h (oc + 1) = base := by
    rw [hh]; simp only [if_neg (show ¬ (oc + 1 = 0) by omega)]
  have hbc2 : h (oc + 2) = base := by
    rw [hh]; simp only [if_neg (show ¬ (oc + 2 = 0) by omega)]
  have heq1 : h (oc + 1) = h oc := by rw [hbc1, hbc]
  have heq2 : h (oc + 2) = h oc := by rw [hbc2, hbc]
  have hw0 : h 0 = 0 := by rw [hh]; simp
  have hoclt : oc < GameConfig.standard.cols := by omega
  have hoc1lt : oc + 1 < GameConfig.standard.cols := by omega
  rw [applyStep_T_skyline_noclear (c := oc) (w := 0) hoclt hoc1lt hoc2 heq1 heq2
      (by decide) (by omega) (by omega) (by omega) hw0, hbc]
  refine ⟨Function.update (Function.update (Function.update h oc (base + 1))
      (oc + 1) (base + 2)) (oc + 2) (base + 1), 0, 1,
    rfl, by decide, ?_, ?_, ?_, by decide, by decide, by decide, by decide, by decide,
    ?_, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne (show (0:ℕ) ≠ oc + 2 by omega),
        Function.update_of_ne (show (0:ℕ) ≠ oc + 1 by omega),
        Function.update_of_ne (show (0:ℕ) ≠ oc by omega)]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (oc + 2) with rfl | hjc2'
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjc2']
      rcases eq_or_ne j (oc + 1) with rfl | hjc1'
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hjc1']
        rcases eq_or_ne j oc with rfl | hjc'
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hjc']
          have hjb : h j = base := by rw [hh]; simp only [if_neg hjw]
          rw [hjb]; omega
  · exact hslack
  · rw [Function.update_of_ne (show (1:ℕ) ≠ oc + 2 by omega),
        Function.update_of_ne (show (1:ℕ) ≠ oc + 1 by omega),
        Function.update_of_ne (show (1:ℕ) ≠ oc by omega), hh]; simp
  · rw [Function.update_of_ne (show (1 + 1:ℕ) ≠ oc + 2 by omega),
        Function.update_of_ne (show (1 + 1:ℕ) ≠ oc + 1 by omega),
        Function.update_of_ne (show (1 + 1:ℕ) ≠ oc by omega), hh]; simp
  · rw [Function.update_of_ne (show (1 + 2:ℕ) ≠ oc + 2 by omega),
        Function.update_of_ne (show (1 + 2:ℕ) ≠ oc + 1 by omega),
        Function.update_of_ne (show (1 + 2:ℕ) ≠ oc by omega), hh]; simp
  · rw [Function.update_of_ne (show (1 + 3:ℕ) ≠ oc + 2 by omega),
        Function.update_of_ne (show (1 + 3:ℕ) ≠ oc + 1 by omega),
        Function.update_of_ne (show (1 + 3:ℕ) ≠ oc by omega), hh]; simp

/-- **Pocket regeneration (horizontal I on a standard flat top).** The horizontal-I
sibling of `isLevelPocketBand_O_flatTop_standard`: on the standard flat top with the
reserved well at column 0 and every other column at `base`, dropping a horizontal I at
column 1 raises columns 1, 2, 3, 4 to `base + 1` while leaving columns 5 through 9 at
`base`. The result is a `IsLevelPocketBand` of spread 2 with floor `base`, well `0`, and a
width-4 floor pocket at columns 5, 6, 7, 8 — a second per-piece fill that regenerates the
pocket rather than collapsing the band, extending the σ-move menu the reachability carrier
needs. -/
theorem isLevelPocketBand_horizI_flatTop_standard {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) :
    IsLevelPocketBand GameConfig.standard 2
      (Placement.applyStep GameConfig.standard
        (skyline GameConfig.standard (fun j => if j = 0 then 0 else base))
        { piece := Piece.I, rot := 0, col := 1 }) := by
  set h : ℕ → ℕ := fun j => if j = 0 then 0 else base with hh
  have hb1 : h 1 = base := by rw [hh]; simp
  have hb2 : h (1 + 1) = base := by rw [hh]; simp
  have hb3 : h (1 + 2) = base := by rw [hh]; simp
  have hb4 : h (1 + 3) = base := by rw [hh]; simp
  have hw0 : h 0 = 0 := by rw [hh]; simp
  have heq1 : h (1 + 1) = h 1 := by rw [hb2, hb1]
  have heq2 : h (1 + 2) = h 1 := by rw [hb3, hb1]
  have heq3 : h (1 + 3) = h 1 := by rw [hb4, hb1]
  rw [applyStep_horizI_skyline_noclear (c := 1) (w := 0) (by decide) (by decide) (by decide)
      (by decide) heq1 heq2 heq3 (by decide) (by decide) (by decide) (by decide) (by decide)
      hw0, hb1]
  refine ⟨Function.update (Function.update (Function.update
      (Function.update h 1 (base + 1)) (1 + 1) (base + 1)) (1 + 2) (base + 1))
      (1 + 3) (base + 1), base, 0, 5, rfl, by decide, ?_, ?_, ?_, by decide, by decide,
    by decide, by decide, by decide, ?_, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne (show (0:ℕ) ≠ 1 + 3 by decide),
        Function.update_of_ne (show (0:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (0:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (0:ℕ) ≠ 1 by decide)]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (1 + 3) with rfl | hj3
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hj3]
      rcases eq_or_ne j (1 + 2) with rfl | hj2
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hj2]
        rcases eq_or_ne j (1 + 1) with rfl | hj1
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hj1]
          rcases eq_or_ne j 1 with rfl | hj0
          · rw [Function.update_self]; omega
          · rw [Function.update_of_ne hj0]
            have hjb : h j = base := by rw [hh]; simp only [if_neg hjw]
            rw [hjb]; omega
  · exact hslack
  · rw [Function.update_of_ne (show (5:ℕ) ≠ 1 + 3 by decide),
        Function.update_of_ne (show (5:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (5:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (5:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (6:ℕ) ≠ 1 + 3 by decide),
        Function.update_of_ne (show (6:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (6:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (6:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (7:ℕ) ≠ 1 + 3 by decide),
        Function.update_of_ne (show (7:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (7:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (7:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (8:ℕ) ≠ 1 + 3 by decide),
        Function.update_of_ne (show (8:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (8:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (8:ℕ) ≠ 1 by decide), hh]; simp

/-- **Floor-exposing horizontal I fill on a standard flat top.** The floor-exposing
analogue of `isLevelPocketBand_horizI_flatTop_standard`. Dropping a horizontal I at columns
`1, 2, 3, 4` of the standard flat top (well at column 0, every other column at `base`) raises
those four columns to `base + 1` while leaving columns `5` through `9` at `base`, landing in a
`IsLevelPocketBandAt standard 2 base` band at the STATICALLY KNOWN floor `base`, with a
width-4 floor pocket at columns `5, 6, 7, 8`. The proof is identical to the hidden-floor
version with the `base` floor witness dropped. The horizontal-I sibling of
`isLevelPocketBandAt_O_flatTop_standard`: a second per-piece regeneration fill on the
floor-exposing carrier that keeps the floor explicit across the move. -/
theorem isLevelPocketBandAt_horizI_flatTop_standard {base : ℕ}
    (hslack : base + 2 ≤ GameConfig.standard.rows) :
    IsLevelPocketBandAt GameConfig.standard 2 base
      (Placement.applyStep GameConfig.standard
        (skyline GameConfig.standard (fun j => if j = 0 then 0 else base))
        { piece := Piece.I, rot := 0, col := 1 }) := by
  set h : ℕ → ℕ := fun j => if j = 0 then 0 else base with hh
  have hb1 : h 1 = base := by rw [hh]; simp
  have hb2 : h (1 + 1) = base := by rw [hh]; simp
  have hb3 : h (1 + 2) = base := by rw [hh]; simp
  have hb4 : h (1 + 3) = base := by rw [hh]; simp
  have hw0 : h 0 = 0 := by rw [hh]; simp
  have heq1 : h (1 + 1) = h 1 := by rw [hb2, hb1]
  have heq2 : h (1 + 2) = h 1 := by rw [hb3, hb1]
  have heq3 : h (1 + 3) = h 1 := by rw [hb4, hb1]
  rw [applyStep_horizI_skyline_noclear (c := 1) (w := 0) (by decide) (by decide) (by decide)
      (by decide) heq1 heq2 heq3 (by decide) (by decide) (by decide) (by decide) (by decide)
      hw0, hb1]
  refine ⟨Function.update (Function.update (Function.update
      (Function.update h 1 (base + 1)) (1 + 1) (base + 1)) (1 + 2) (base + 1))
      (1 + 3) (base + 1), 0, 5, rfl, by decide, ?_, ?_, ?_, by decide, by decide,
    by decide, by decide, by decide, ?_, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne (show (0:ℕ) ≠ 1 + 3 by decide),
        Function.update_of_ne (show (0:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (0:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (0:ℕ) ≠ 1 by decide)]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (1 + 3) with rfl | hj3
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hj3]
      rcases eq_or_ne j (1 + 2) with rfl | hj2
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hj2]
        rcases eq_or_ne j (1 + 1) with rfl | hj1
        · rw [Function.update_self]; omega
        · rw [Function.update_of_ne hj1]
          rcases eq_or_ne j 1 with rfl | hj0
          · rw [Function.update_self]; omega
          · rw [Function.update_of_ne hj0]
            have hjb : h j = base := by rw [hh]; simp only [if_neg hjw]
            rw [hjb]; omega
  · exact hslack
  · rw [Function.update_of_ne (show (5:ℕ) ≠ 1 + 3 by decide),
        Function.update_of_ne (show (5:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (5:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (5:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (6:ℕ) ≠ 1 + 3 by decide),
        Function.update_of_ne (show (6:ℕ) ≠ 1 + 2 by decide),
        Function.update_of_ne (show (6:ℕ) ≠ 1 + 1 by decide),
        Function.update_of_ne (show (6:ℕ) ≠ 1 by decide), hh]; simp
  · rw [Function.update_of_ne (show (7:ℕ) ≠ 1 + 3 by decide),
        Function.update_of_ne (show (7:ℕ) ≠ 1 + 2 by decide),
