  · show (if w = w then 0 else if w = m then base + 1 else base) = 0
    rw [if_pos rfl]
  · intro j hj
    show (if j = w then 0 else if j = m then base + 1 else base) ≤ cfg.rows
    split
    · exact Nat.zero_le _
    · split
      · omega
      · omega
  · show (if c = w then 0 else if c = m then base + 1 else base) + 2 ≤ cfg.rows
