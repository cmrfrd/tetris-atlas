        Function.update_of_ne hwc]; exact hw0
  · intro j hj hjw
    rcases eq_or_ne j (c + 2) with rfl | hjc2'
    · rw [Function.update_self]; omega
    · rw [Function.update_of_ne hjc2']
      rcases eq_or_ne j (c + 1) with rfl | hjc1'
      · rw [Function.update_self]; omega
      · rw [Function.update_of_ne hjc1']
