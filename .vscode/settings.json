{
    // Simple Rust configuration - everything is implicit
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports": "explicit",
        "source.fixAll.clippy": "explicit"
    },
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit",
            "source.fixAll.clippy": "explicit"
        }
    },
    // Use the analyzer installed with the repository's pinned Rust toolchain.
    "rust-analyzer.server.path": "rust-analyzer",
    // Run Clippy diagnostics; save actions above apply explicitly requested fixes.
    "rust-analyzer.checkOnSave": true,
    "rust-analyzer.check.command": "clippy",
    "rust-analyzer.imports.granularity.group": "module",
    "rust-analyzer.imports.prefix": "crate"
}
