# project files
# Ignore Rust and build artifacts
target/
build/
trace/
traces/
junk/

# vendored dependencies
vendor/
!vendor/.gitkeep

# runtime artifacts (checkpoints, logs, data, output, databases)
artifacts/
!artifacts/.gitkeep

# archived playground experiments
crates/tetris-playground/archive/*
!crates/tetris-playground/archive/.gitkeep

# generated protobuf bindings are checked in so clean builds skip the
# prost-build toolchain (regenerate with `--features regen-protos`)

# generated local outputs
*.bin
*.csv
*.tsv
*.png
data/

# local scripts
scripts/*.py
!scripts/tetris_piecewise_linear.py
